let poll_demo_options = [
    { label: "Quillo", value: "quillo", votes: 42 }, { label: "Rust", value: "rust", votes: 31 },
    { label: "TypeScript", value: "ts", votes: 18 }, { label: "Python", value: "py", votes: 9 },
]

component PollDemoLive() {
    state vote = null
    <div.demo-stack>
        <Poll id="poll-demo-live" question="Which language do you write most?" options={poll_demo_options} change={true}
              on_vote={(v) => { vote = v }}/>
        <p.demo-note>{vote == null ? "No vote yet." : `on_vote got ${vote}.`}</p>
    </div>
}

view PollDemo() =
    <div.demo-stack>
        <PollDemoLive/>
        <Poll id="poll-demo-voted" question="Tabs or spaces?" voted="spaces" total_text="{n} people answered"
              options={[{ label: "Tabs", value: "tabs", votes: 12 }, { label: "Spaces", value: "spaces", votes: 28 }]}/>
        <Poll id="poll-demo-closed" question="Best season for a release? (closed)" results={true} options={["Spring", "Summer"]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "poll", name: "Poll", group: "Forms",
    summary: "Vote for one option with a tap and see the results as bars with each one's share; the vote also goes in a hidden input.",
    tags: ["forms", "button", "social", "feedback", "interactive"], demo: PollDemo })
