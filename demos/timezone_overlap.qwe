component TimezoneOverlapDemoLive() {
    state seen = null
    <div.demo-stack>
        <TimezoneOverlap id="timezone-overlap-demo" day="2026-11-03" cities={[
            { city: "Lisbon", zone: "Europe/Lisbon" }, { city: "New York", zone: "America/New_York" }, { city: "Mumbai", zone: "Asia/Kolkata", from: "10:00", to: "18:30" }]}
            on_change={(w) => { seen = w }}/>
        <p.demo-note>{seen == null ? "Move the window to see on_change." : `on_change: ${seen.start} to ${seen.end}; ${seen.cities[1].city} ${seen.cities[1].local}, ${seen.cities[1].state}.`}</p>
    </div>
}

view TimezoneOverlapDemo() =
    <div.demo-stack>
        <TimezoneOverlapDemoLive/>
        <TimezoneOverlap id="timezone-overlap-demo-band" title="Two offices" name="offices" day="2026-11-03" minutes={45} cities={[
            { city: "Berlin", zone: "Europe/Berlin" }, { city: "Mumbai", zone: "Asia/Kolkata" }]}/>
        <TimezoneOverlap id="timezone-overlap-demo-dst" title="The day the clocks change" name="spring" day="2026-03-29" cities={[
            { city: "Paris", zone: "Europe/Paris" }, { city: "New York", zone: "America/New_York" }, { city: "Kathmandu", zone: "Asia/Kathmandu" }]}/>
        <TimezoneOverlap id="timezone-overlap-demo-none" title="No overlap" name="none" day="2026-11-03" minutes={30} cities={[
            { city: "Auckland", zone: "Pacific/Auckland" }, { city: "London", zone: "Europe/London" }, { city: "Night desk", zone: "UTC", from: "22:00", to: "06:00" },
            { city: "Nowhere", zone: "Mars/Base" }, { city: "Odd", zone: "UTC", from: "99:00" }]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "timezone_overlap", name: "TimezoneOverlap", group: "Scheduling",
    summary: "Cities in rows across a day with working hours marked: finds the overlap, lets you drag a meeting across it, and says what that hour means in each city, right on a clock-change day.",
    tags: ["smart", "interactive", "timezone", "meetings", "dst", "world"], needs: ["timezone_picker"], demo: TimezoneOverlapDemo })
