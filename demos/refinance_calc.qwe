component RefinanceCalcDemoLive() {
    state note = "Change something to see on_change."
    <div.demo-stack>
        <RefinanceCalc id="refinance-calc-demo-live" name="second" title="Longer term, costs rolled in" balance="180000" rate={7} months={240} new_rate={6} new_months={360} costs="4000" rolled={true}
                       stay={120} currency="EUR" on_change={(r) => { note = `on_change: saves ${r.monthly_saving} a month, month ${r.break_even}, ${r.worth ? "worth it" : "not worth it"}.` }}/>
        <p.demo-note>{note}</p>
    </div>
}

view RefinanceCalcDemo() =
    <div.demo-stack>
        <RefinanceCalc id="refinance-calc-demo" balance="250000" rate={6.5} months={300} new_rate={5.25} new_months={300} costs="5000" stay={84}/>
        <RefinanceCalcDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "refinance_calc", name: "RefinanceCalc", group: "Finance",
    summary: "Compares a loan with a new one month by month: payment, closing costs, break-even month, interest over the stay, and when it is not worth it.",
    tags: ["smart", "interactive", "finance", "loan", "mortgage", "refinance"], demo: RefinanceCalcDemo })
