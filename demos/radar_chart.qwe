let radar_chart_demo_grid = "display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 32px 40px"

view RadarChartDemo() =
    <div style={radar_chart_demo_grid}>
        <RadarChart label="Phone ratings" show_label={true} limit={10} levels={5}
                    axes={["Camera", "Battery", "Screen", "Speed", "Price", "Support"]}
                    series={[{ name: "Model A", values: [8.5, 6, 9, 7.5, 5, 7] },
                             { name: "Model B", values: [6.5, 9, 7, 8, 8.5, 6] },
                             { name: "Model C", values: [7, 7.5, 6, 6, 9.5, 8] }]}/>
        <RadarChart label="Skills this year" show_label={true} size={300} suffix=" pts"
                    axes={["Design", "Writing", "Code", "Data", "Speaking"]}
                    series={[{ name: "Skills", values: [72, 58, 91, 64, null] }]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "radar_chart", name: "RadarChart", group: "Charts",
    summary: "Series as shapes over axes around a circle, with rings for the scale, to compare profiles; hovering a shape or its legend picks it out.",
    tags: ["chart", "data", "no-js"],
    demo: RadarChartDemo })
