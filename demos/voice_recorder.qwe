component VoiceRecorderDemoLive() {
    state got = null
    state shown = true
    <div.demo-stack>
        {shown && <form.demo-stack method="post" action="/" enctype="multipart/form-data">
            <VoiceRecorder name="note" limit={3} hint="Three seconds in this example." on_change={(n) => { got = n }}/>
        </form>}
        <p.demo-note id="voice-recorder-demo-note">{got == null ? "No recording yet." : `Ready: ${got.name}, ${got.type}.`}</p>
        <Button size="lg" variant="ghost" tone="neutral" on_click={() => { shown = !shown }}>{shown ? "Leave the page" : "Come back"}</Button>
    </div>
}

view VoiceRecorderDemo() =
    <div.demo-stack>
        <VoiceRecorderDemoLive/>
        <p.demo-note>The bar moves with your voice. Nothing leaves the phone until the form is sent.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "voice_recorder", name: "VoiceRecorder", group: "Mobile",
    summary: "Records from the microphone with a live level, pause, playback and a limit, says so when refused, and leaves a real file in a form.",
    tags: ["mobile", "interactive", "audio", "voice", "upload", "forms"], needs: ["button"], demo: VoiceRecorderDemo })
