let auto_insights_demo_rows = [
    { region: "North", revenue: 1200, ad_spend: 130, rating: 4.1 }, { region: "South", revenue: 1100, ad_spend: 100, rating: 4.2 },
    { region: "East", revenue: 9400, ad_spend: 900, rating: 4.0 }, { region: "West", revenue: 1300, ad_spend: 150, rating: 4.3 },
    { region: "Central", revenue: 900, ad_spend: 70, rating: 4.1 }, { region: "Coast", revenue: 1250, ad_spend: 140, rating: 4.2 },
    { region: "Hills", revenue: 1050, ad_spend: 95, rating: 4.0 }, { region: "Lakes", revenue: 1150, ad_spend: 120, rating: 4.1 },
    { region: "Plains", revenue: 980, ad_spend: 85, rating: 4.3 }, { region: "Valley", revenue: 1020, ad_spend: 105, rating: 4.2 },
]

component AutoInsightsDemoLive() {
    state seen = "Change what it says to see on_change."
    <div.demo-stack>
        <AutoInsights id="auto-insights-demo-live" title="Signups by day" name="signups" min_strength={60}
                      rows={[{ day: "2026-03-01", signups: 100 }, { day: "2026-03-02", signups: 104 }, { day: "2026-03-03", signups: 98 }, { day: "2026-03-04", signups: 103 },
                             { day: "2026-03-05", signups: 310 }, { day: "2026-03-06", signups: 305 }, { day: "2026-03-07", signups: 312 }]}
                      on_change={(found) => { seen = `on_change: ${len(found)} said.` }}/>
        <p.demo-note>{seen}</p>
    </div>
}

view AutoInsightsDemo() =
    <div.demo-stack>
        <AutoInsights id="auto-insights-demo" title="Sales by region" rows={auto_insights_demo_rows}/>
        <AutoInsightsDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "auto_insights", name: "AutoInsights", group: "Dashboard",
    summary: "Reads rows and says in plain sentences what stands out, ranked by strength, and says nothing rather than something weak.",
    tags: ["smart", "interactive", "insights", "analysis", "statistics", "data"], demo: AutoInsightsDemo })
