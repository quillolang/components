let app_tab_bar_demo_css = css`
.ui-apptabs-demo { padding: 12px 16px; }
.ui-apptabs-demo p { margin: 0; padding: 12px 0; border-bottom: 1px solid var(--ui-border); }
.ui-apptabs-demo input { box-sizing: border-box; width: 100%; height: 44px; padding: 0 12px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius-sm); background: var(--ui-surface); color: var(--ui-fg); font: 16px var(--ui-font); }
`

component AppTabBarDemoCounter() {
    state n = 0
    <Button size="lg" variant="outline" on_click={() => { n += 1 }}>Counted {n}</Button>
}

view AppTabBarDemoScreen(tab: str, on_read) =
    <div.ui-apptabs-demo data-screen={tab}>
        <h3 style="margin: 0 0 8px">{tab}</h3>
        <input aria-label={`Search ${tab}`} placeholder={`Search ${tab}`}/>
        <div class="demo-row" style="margin: 12px 0"><AppTabBarDemoCounter/><Button size="lg" variant="soft" on_click={on_read}>Mark read</Button></div>
        {for i in range(1, 50) => <p key={i}>{tab} item {i}</p>}
    </div>

component AppTabBarDemoLive() {
    style global app_tab_bar_demo_css
    state unread = 3
    state retaps = 0
    state moves = ""
    state wanted = "nowhere"
    <div.demo-stack>
        <div.demo-tablet>
            <AppTabBar id="app-tab-demo" current={wanted}
                       tabs={[
                           { id: "home", label: "Home", icon: "M3 11 12 3l9 8M5 9.5V21h14V9.5" },
                           { id: "inbox", label: "Inbox", icon: "M4 4h16v16H4zM4 13h5l1.5 2h3L15 13h5", badge: unread },
                           { id: "map", label: "Map", icon: "M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11z", badge: 120 },
                           { id: "me", label: "Me", icon: "M16 19v-1a4 4 0 0 0-8 0v1M12 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6", badge: true },
                       ]}
                       panel={(id) => <AppTabBarDemoScreen tab={id} on_read={() => { unread = 0 }}/>}
                       on_change={(id) => { moves = moves + id + " " }} on_retap={(_id) => { retaps += 1 }}/>
        </div>
        <p class="demo-note">Moved to: {moves}; pressed again {retaps}</p>
        <Button size="lg" variant="outline" on_click={() => { wanted = "map" }}>Open the map</Button>
        <p class="demo-note">Bad rows are dropped: one tab is left of these four.</p>
        <div style="height: 180px; border: 1px solid var(--ui-border)">
            <AppTabBar id="app-tab-demo-bad" current="only" tabs={[null, { id: "only", label: "Only", icon: "*" }, { id: "only", label: "Twice", icon: "!" }, { label: "No id" }]}
                       panel={(id) => <p style="margin: 8px">Tab {id}</p>}/>
        </div>
    </div>
}

view AppTabBarDemo() = <AppTabBarDemoLive/>

ui_gallery = ui_gallery | push({ slug: "app_tab_bar", name: "AppTabBar", group: "Mobile",
    summary: "Bottom tabs for a phone app: badges, safe-area padding, a second press scrolls to the top, each tab keeps its place, gone while the keyboard is up; a rail on a tablet.",
    tags: ["mobile", "interactive", "tablet", "navigation", "tabs", "keyboard"],
    demo: AppTabBarDemo })
