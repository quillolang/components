// The paper's own ad for the demo, drawn here: no network, no one else's brand.
let ad_slot_demo_house = "data:image/svg+xml," + url_encode(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 300 250"><rect width="300" height="250" fill="#14213d"/><circle cx="250" cy="40" r="70" fill="#fca311" opacity=".9"/><text x="24" y="120" fill="#fff" font-family="Georgia, serif" font-size="30" font-weight="700">The Ledger</text><text x="24" y="152" fill="#e5e5e5" font-family="Arial, sans-serif" font-size="15">Every story, every morning.</text><rect x="24" y="182" width="150" height="38" rx="19" fill="#fca311"/><text x="99" y="206" fill="#14213d" font-family="Arial, sans-serif" font-size="15" font-weight="700" text-anchor="middle">$1 a week</text></svg>`)

view AdSlotDemo() =
    <div.demo-stack style="gap: 28px">
        <AdSlot id="ad-slot-demo-top" size="leaderboard" mobile="mobile_banner" slot="home-top"/>
        <div style="display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 24px; align-items: start">
            <div style="display: grid; gap: 12px">
                <p class="demo-note" style="font-size: 15px">The story runs here, in the wider column. The rectangle beside it is sticky:
                    beside a story taller than itself, it stays in view as the page scrolls.</p>
                <AdSlot id="ad-slot-demo-blank" size="mobile_large" placeholder={false} label="" align="start" slot="in-article-2"/>
                <p class="demo-note">An empty slot without a placeholder above still keeps its 320 by 100 pixels, and has no label.</p>
            </div>
            <AdSlot id="ad-slot-demo-rail" size="rectangle" sticky={true} slot="article-rail">
                <a href="#subscribe"><img src={ad_slot_demo_house} alt="The Ledger: every story, every morning. $1 a week." width="300" height="250"/></a>
            </AdSlot>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "ad_slot", name: "AdSlot", group: "News",
    summary: "An advertisement's place kept at its size so the story never jumps: standard sizes by name, another on phones, a clear label, a placeholder, sticky in a rail.",
    tags: ["news", "layout", "ads", "media", "no-js"], demo: AdSlotDemo })
