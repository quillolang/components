view AbbrDemo() =
    <div.demo-stack>
        <p.demo-note style="color: var(--ui-fg); font-size: 15px">
            The <Abbr title="HyperText Markup Language" id="abbr-demo-html">HTML</Abbr> is sent first, the
            <Abbr title="Cascading Style Sheets">CSS</Abbr> with it, and the script only when a component is reached.
            Reply <Abbr title="as soon as possible" tooltip="native" id="abbr-demo-native">ASAP</Abbr>. Hover or Tab to one.
        </p>
    </div>

ui_gallery = ui_gallery | push({ slug: "abbr", name: "Abbr", group: "Typography",
    summary: "An abbreviation whose expansion shows in a bubble on hover or focus and is read out by screen readers.",
    tags: ["typography", "text", "accessibility", "no-js"],
    demo: AbbrDemo })
