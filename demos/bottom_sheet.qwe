let bottom_sheet_demo_places = [
    { name: "Harbour Coffee", kind: "Cafe", away: "120 m" }, { name: "Old Town Bakery", kind: "Bakery", away: "240 m" },
    { name: "Marine Museum", kind: "Museum", away: "310 m" }, { name: "Quay Books", kind: "Bookshop", away: "350 m" },
    { name: "Ferry Terminal", kind: "Transport", away: "420 m" }, { name: "Salt and Stone", kind: "Restaurant", away: "480 m" },
    { name: "Lighthouse Park", kind: "Park", away: "560 m" }, { name: "North Pier", kind: "Landmark", away: "610 m" },
    { name: "Fish Market", kind: "Market", away: "640 m" }, { name: "Dockside Gym", kind: "Gym", away: "700 m" },
    { name: "The Net Loft", kind: "Bar", away: "720 m" }, { name: "Ropewalk Gallery", kind: "Gallery", away: "780 m" },
    { name: "Tide Pharmacy", kind: "Pharmacy", away: "810 m" }, { name: "Sailors' Rest", kind: "Hotel", away: "860 m" },
    { name: "Customs House", kind: "Landmark", away: "900 m" }, { name: "Eastern Baths", kind: "Pool", away: "990 m" },
    { name: "Mill Lane Cinema", kind: "Cinema", away: "1.1 km" }, { name: "Chandlers' Yard", kind: "Market", away: "1.1 km" },
    { name: "St Anne's Church", kind: "Landmark", away: "1.2 km" }, { name: "Grove Library", kind: "Library", away: "1.2 km" },
    { name: "Bridge Street Deli", kind: "Deli", away: "1.3 km" }, { name: "The Tannery", kind: "Bar", away: "1.3 km" },
    { name: "Canal Boat Hire", kind: "Boats", away: "1.4 km" }, { name: "Weavers' Hall", kind: "Venue", away: "1.4 km" },
    { name: "Hilltop Observatory", kind: "Museum", away: "1.6 km" }, { name: "Orchard Road Station", kind: "Transport", away: "1.7 km" }]

let bottom_sheet_demo_css = css`
.ui-bottom-sheet-demo-list { margin: 16px 0 0; padding: 0; list-style: none; }
.ui-bottom-sheet-demo-list li { display: flex; justify-content: space-between; gap: 12px; padding: 14px 0; border-bottom: 1px solid var(--ui-border); }
.ui-bottom-sheet-demo-list span { color: var(--ui-muted); font-size: 14px; }
.ui-bottom-sheet-demo-field { box-sizing: border-box; display: block; width: 100%; height: 46px; margin-top: 6px; padding: 0 12px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius-sm); background: var(--ui-surface); color: var(--ui-fg); font: 16px var(--ui-font); }
`

component BottomSheetDemoLive() {
    style global bottom_sheet_demo_css
    state stop = "none yet"
    state closed = 0
    state note = ""
    state sheet_width = 640
    <div.demo-stack>
        <div.demo-row>
            <BottomSheet title="Places nearby" trigger="Show places" width={sheet_width} on_detent={(n) => { stop = n }}
                         on_close={() => { closed += 1 }}>
                <label.demo-note for="bottom-sheet-note">Add a note</label>
                <input.ui-bottom-sheet-demo-field id="bottom-sheet-note" bind:value={note} placeholder="Meet at the pier"/>
                <ul.ui-bottom-sheet-demo-list>
                    {for p in bottom_sheet_demo_places => <li key={p.name}><strong>{p.name}</strong> <span>{p.kind}, {p.away}</span></li>}
                </ul>
            </BottomSheet>
            <Button size="lg" variant="ghost" on_click={() => { sheet_width = sheet_width == 640 ? 560 : 640 }}>Change the width</Button>
            <BottomSheet title="Keep it open" trigger="No closing" detents={["peek", "full"]} start="peek" dismissable={false}>
                <p>This one stops at peek and full, and cannot be dragged away. Use the button or Escape.</p>
            </BottomSheet>
        </div>
        <p.demo-note>Last stop: <span class="bottom-sheet-demo-stop">{stop}</span>. Closed: <span class="bottom-sheet-demo-closed">{closed}</span>.</p>
    </div>
}

view BottomSheetDemo() = <BottomSheetDemoLive/>

ui_gallery = ui_gallery | push({ slug: "bottom_sheet", name: "BottomSheet", group: "Mobile",
    summary: "A sheet with peek, half and full stops, dragged by finger: it resists past its ends, snaps by speed, shares the finger with the list inside and rises above the keyboard.",
    tags: ["mobile", "interactive", "sheet", "overlay", "detents", "gesture"],
    needs: ["button"], demo: BottomSheetDemo })
