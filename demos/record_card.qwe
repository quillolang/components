view RecordCardDemo() =
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 14px">
        <RecordCard id="record-card-demo-customer" title="Northwind Traders" subtitle="Customer since 2019" avatar={true}
                    status="Active" status_tone="success" href="#northwind"
                    fields={[
                        { label: "Email", value: "buy@northwind.example", href: "mailto:buy@northwind.example" },
                        { label: "Phone", value: null },
                        { label: "Balance", value: 1240.5, format: "money" },
                        { label: "Renews", value: "2027-01-31", format: "date" },
                        { label: "Tax exempt", value: false, format: "bool" },
                        { label: "Customer id", value: "cus_8f2a91", mono: true },
                        { label: "Notes", value: "Prefers invoices by post, to the Hamburg office.", wide: true },
                    ]}>
            <Button size="sm" variant="ghost" href="#history">History</Button>
            <Button size="sm" variant="outline" href="#edit">Edit</Button>
        </RecordCard>
        <RecordCard id="record-card-demo-device" title="Office printer" subtitle="HP LaserJet M404" status="Offline" status_tone="danger"
                    columns={1} level={4}
                    fields={[
                        { label: "Serial", value: "PHB8K21734", mono: true },
                        { label: "Toner left", value: 0.18, format: "percent" },
                        { label: "Pages printed", value: 48210, format: "number" },
                    ]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "record_card", name: "RecordCard", group: "Data",
    summary: "A record's fields as labelled values in a card, with a title, status, formatted values and actions in a footer.",
    tags: ["data", "card", "record", "no-js"], demo: RecordCardDemo })
