let lollipop_chart_demo_grid = "display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 32px 40px"

view LollipopChartDemo() =
    <div.demo-stack>
        <LollipopChart label="Customer score by month" show_label={true} zero={false} value_labels={true}
                       labels={["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]}
                       values={[71, 73, 72, 76, 78, 77, 81, 83, 82, 85, 84, 88]}/>
        <div style={lollipop_chart_demo_grid}>
            <LollipopChart label="Price change this year" show_label={true} horizontal={true} sort="desc" suffix="%" value_labels={true}
                           labels={["Coffee", "Bread", "Milk", "Eggs", "Rice", "Olive oil"]} values={[12.5, 4, -2.5, 18, -6, 31]}/>
            <LollipopChart label="Pages per visit" show_label={true} height={160} decimals={1}
                           labels={["Search", "Direct", "Email", "Social", "Ads"]} values={[4.2, 3.6, 5.1, null, 2.4]}/>
        </div>
        <p.demo-note>Scores start the axis at 70 (zero=false); Social has no data.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "lollipop_chart", name: "LollipopChart", group: "Charts",
    summary: "Values as thin stems with a dot, up or across, sorted if asked, with each value on hover or beside its dot.",
    tags: ["chart", "data", "no-js"],
    demo: LollipopChartDemo })
