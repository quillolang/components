view UsageMeterDemo() =
    <div.demo-stack.demo-narrow>
        <UsageMeter id="usage-meter-demo" label="Storage" used={38.2} allowed={50} unit=" GB" hint="Files, backups and exports"/>
        <UsageMeter label="API calls" used={92000} allowed={100000} warn_at={85} hint="Resets on the 1st"/>
        <UsageMeter label="Team members" used={5} allowed={5}/>
        <UsageMeter label="Email sends" used={12400} allowed={10000} size="lg"/>
        <UsageMeter label="Projects" used={3} allowed={null} size="sm"/>
    </div>

ui_gallery = ui_gallery | push({ slug: "usage_meter", name: "UsageMeter", group: "Dashboard",
    summary: "Used of allowed as a bar with the numbers, amber near the limit, red at it, and plain when there is no limit.",
    tags: ["dashboard", "progress", "status", "data", "no-js"],
    demo: UsageMeterDemo })
