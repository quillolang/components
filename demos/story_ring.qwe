component StoryRingDemoLive() {
    state seen = []
    state added = 0
    let people = [{ name: "Ana Silva", src: "https://i.pravatar.cc/120?img=47", count: 3 }, { name: "Ben Okafor", src: "https://i.pravatar.cc/120?img=15" },
                  { name: "Lee Chen", count: 1 }, { name: "Mia Rossi", src: "https://i.pravatar.cc/120?img=32" }, { name: "Sam Patel" },
                  { name: "Zoe Park", src: "https://i.pravatar.cc/120?img=5" }]
        | map((p) => { ...p, seen: contains(seen, p.name) })
    <div.demo-stack>
        <div id="story-ring-demo-live">
            <StoryRing you={{ name: "You" }} people={people} on_open={(n) => { seen = unique(seen | push(n)) }} on_add={() => { added += 1 }}/>
        </div>
        <p.demo-note>{len(seen) == 0 ? "Open a story to mark it seen." : `Seen: ${join(seen, ", ")}.`}{added > 0 ? ` Add pressed ${added}.` : ""}</p>
    </div>
}

view StoryRingDemo() =
    <div.demo-stack>
        <StoryRingDemoLive/>
        <div id="story-ring-demo-links">
            <StoryRing size="sm" label="Team stories" you={{ name: "Ana Silva", src: "https://i.pravatar.cc/120?img=47", href: "#story_ring" }}
                       people={[{ name: "Ben Okafor", href: "#story_ring", seen: true }, { name: "Lee Chen", href: "#story_ring" }]}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "story_ring", name: "StoryRing", group: "Social",
    summary: "A row of avatars in rings, bright for stories not yet seen and grey once seen, with your own first to add one.",
    tags: ["social", "user", "media", "list", "no-js"], demo: StoryRingDemo })
