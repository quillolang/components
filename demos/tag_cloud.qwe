let tag_cloud_demo_topics = [
    { label: "quillo", weight: 64, href: "#quillo" }, { label: "css", weight: 21, href: "#css" },
    { label: "sqlite", weight: 9, href: "#sqlite" }, { label: "forms", weight: 30, href: "#forms" },
    { label: "accessibility", weight: 17, href: "#a11y" }, { label: "rust", weight: 4, href: "#rust" },
    { label: "deploy", weight: 12, href: "#deploy" }, { label: "testing", weight: 26, href: "#testing" },
    { label: "dark mode", weight: 6, href: "#dark" }, { label: "components", weight: 48, href: "#components" },
    { label: "http", weight: 2, href: "#http" },
]

view TagCloudDemo() =
    <div.demo-stack>
        <TagCloud id="tag-cloud-demo-topics" label="Topics" selected="forms" tags={tag_cloud_demo_topics}/>
        <TagCloud id="tag-cloud-demo-skills" label="Skills" order="weight" scale="log" counts={true} tone="neutral" tags={[
            { label: "SQL", weight: 340 }, { label: "Go", weight: 12 }, { label: "TypeScript", weight: 95 }, { label: "Elixir", weight: 3 }, { label: "Python", weight: 210 },
        ]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "tag_cloud", name: "TagCloud", group: "Data",
    summary: "Tags sized and shaded by how much each is used, as links or text, in name or weight order, on a linear or log scale.",
    tags: ["data", "link", "list", "no-js"], demo: TagCloudDemo })
