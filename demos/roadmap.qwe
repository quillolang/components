view RoadmapDemo() =
    <Roadmap id="roadmap-demo" label="Product roadmap" columns={[
        { title: "Now", text: "Being built", items: [
            { title: "Dark mode everywhere", text: "Every page and email follows the system.", status: "in-progress", tags: ["ui"], date: "Nov 2026", votes: 214 },
            { title: "Faster search", status: "blocked", text: "Waiting on the new index.", tags: ["search"] },
        ] },
        { title: "Next", text: "Planned for the quarter", items: [
            { title: "CSV export", status: "planned", date: "Q1 2027", href: "#roadmap", votes: 88 },
            { title: "Two-factor sign-in", status: "planned", tags: ["security"], date: "Q1 2027" },
        ] },
        { title: "Later", items: [{ title: "Plugins", status: "exploring", text: "Rules that run in the browser and the server." }, { title: "Offline mode", status: "someday" }] },
        { title: "Shipped", items: [] },
    ]}/>

ui_gallery = ui_gallery | push({ slug: "roadmap", name: "Roadmap", group: "Data",
    summary: "Columns (Now, Next, Later) of items with a status badge, tags, a target date and votes; side by side, stacked where narrow.",
    tags: ["list", "card", "progress", "no-js"],
    demo: RoadmapDemo })
