let widget_grid_demo_widgets = [
    { id: "steps", title: "Steps", size: "2x2", value: "8,412", note: "of 10,000", tone: "accent" },
    { id: "water", title: "Water", value: "1.2 L", tone: "info" },
    { id: "sleep", title: "Sleep", value: "7 h" },
    { id: "weight", title: "Weight", size: "2x1", value: "78.1 kg", note: "-0.4 this week", tone: "success" },
    { id: "week", title: "This week", size: "4x2", sizes: ["4x2", "2x2"], value: "Five workouts", note: "One to go" },
    { id: "heart", title: "Heart", value: "62", note: "resting", tone: "danger" },
]

component WidgetGridDemoLive() {
    state kept = []
    state told = "Nothing opened."
    state again = 0
    state stir = 0
    <div.demo-stack>
        <div id="widget-grid-main"><WidgetGrid key={again} widgets={widget_grid_demo_widgets | map((w) => w.id == "heart" ? { ...w, value: `${62 + stir}` } : w)} saved={kept} on_change={(l) => { kept = l }} on_open={(id) => { told = `opened ${id}` }}
            render={(w) => w.id == "sleep" ? <b.demo-widget-own>Own markup</b> : null}/></div>
        <p.demo-note id="widget-grid-told">{told}</p>
        <p.demo-note id="widget-grid-kept">{json.stringify(kept)}</p>
        <div.demo-row>
            <Button id="widget-grid-remake" size="lg" variant="soft" on_click={() => { again += 1 }}>Make it again from what was kept</Button>
            <Button id="widget-grid-stir" size="lg" variant="soft" on_click={() => { stir += 1 }}>A reading comes in</Button>
        </div>
        <div id="widget-grid-bad"><WidgetGrid label="Bad data" widgets={[null, 7, { id: "a" }, { id: "b", title: "Odd size", size: "9x9" }, { id: "b", title: "Twin" }, { title: "No id", size: "wide" }]} saved={[null, { id: "gone" }]}/></div>
    </div>
}

view WidgetGridDemo() = <WidgetGridDemoLive/>

ui_gallery = ui_gallery | push({ slug: "widget_grid", name: "WidgetGrid", group: "Mobile",
    summary: "A home screen of tiles of different sizes, rearranged by long press, with a keyboard and button route, and kept as a list of data.",
    tags: ["mobile", "interactive", "dashboard", "gesture", "drag", "tablet"],
    demo: WidgetGridDemo })
