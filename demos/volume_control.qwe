component VolumeControlDemoLive() {
    state level = 0.6
    <div.demo-row>
        <VolumeControl level={0.6} on_change={(v) => { level = v }}/>
        <p.demo-note id="volume-control-demo-note">Level: {round(level * 100)}%</p>
    </div>
}

view VolumeControlDemo() =
    <div.demo-stack>
        <VolumeControlDemoLive/>
        <div.demo-row id="volume-control-demo-others" style="align-items: flex-end">
            <VolumeControl name="alerts" label="Alert volume" level={1} size="sm"/>
            <VolumeControl level={0.3} muted={true}/>
            <VolumeControl level={0.8} vertical={true} label="Vertical"/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "volume_control", name: "VolumeControl", group: "Media",
    summary: "A mute button and a level slider with an icon that shows how loud it is; a real range, so forms and keyboards work.",
    tags: ["media", "audio", "input", "forms", "interactive"], demo: VolumeControlDemo })
