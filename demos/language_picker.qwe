component LanguagePickerDemoLive() {
    state code = "ja"
    <div.demo-stack>
        <LanguagePicker name="ui_lang" label="Show the site in" value={code} field="language-picker-demo-live"
                        only={["en", "fr", "de", "es", "pt", "ja", "zh", "ar"]} on_change={(c) => { code = c }}/>
        <p.demo-note>The site is shown in {language_picker_name(code)} ({code}).</p>
    </div>
}

view LanguagePickerDemo() =
    <div.demo-stack.demo-narrow>
        <LanguagePicker name="lang" label="Language" value="pt" field="language-picker-demo-all" favourites={["en", "pt"]}
                        hint="Each language is written in itself." required={true}/>
        <LanguagePickerDemoLive/>
        <div.demo-row>
            <LanguagePicker name="lang_en" label="With English names" size="sm" english={true} placeholder="Choose one"
                            field="language-picker-demo-english" only={["de", "ja", "ko", "en"]}/>
            <LanguagePicker name="locked" label="Disabled" size="sm" value="fr" only={["fr"]} disabled={true}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "language_picker", name: "LanguagePicker", group: "Forms",
    summary: "A drop-down of languages each written in its own name, sending the ISO 639-1 code with a form.",
    tags: ["forms", "select", "picker", "accessibility", "no-js"], demo: LanguagePickerDemo })
