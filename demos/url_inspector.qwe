component UrlInspectorDemoLive() {
    state seen = null
    <div.demo-stack>
        <UrlInspector id="url-inspector-demo-live" title="Relative, with on_change" name="link" url="../img/a b.png?v=2" base="https://example.com/blog/post/" on_change={(r) => { seen = r }}/>
        <p.demo-note>{seen == null ? "Change the URL to see on_change." : `on_change: ${seen.kind}, ${seen.tracking} tracking, ${seen.rebuilt}.`}</p>
    </div>
}

view UrlInspectorDemo() =
    <div.demo-stack>
        <UrlInspector id="url-inspector-demo" url="https://ada:s3cret@xn--mnchen-3ya.example:443/caf%C3%A9/a%2520b?utm_source=news&utm_medium=email&q=caf%C3%A9+au+lait&next=%252Fhome&flag&fbclid=abc123#top"/>
        <UrlInspectorDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "url_inspector", name: "UrlInspector", group: "Utilities",
    summary: "Splits a URL into parts with a query table to edit, encodes on rebuild, flags tracking and double encoding, and shows punycode.",
    tags: ["smart", "interactive", "url", "developer", "encoding", "tracking"], demo: UrlInspectorDemo })
