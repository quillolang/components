view TimelineDemo() =
    <div.demo-row style="align-items: flex-start; gap: 40px">
        <div.demo-narrow.demo-wide>
            <Timeline items={[
                { title: "Order placed", time: "Mar 3, 09:12", datetime: "2026-03-03T09:12", body: "3 items, $214.00" },
                { title: "Payment received", time: "Mar 3, 09:13", datetime: "2026-03-03T09:13", tone: "success" },
                { title: "Shipped", time: "Mar 4, 16:40", datetime: "2026-03-04T16:40", tone: "accent",
                  body: "UPS, tracking 1Z999AA10123456784" },
                { title: "Delivery attempt failed", time: "Mar 6, 11:05", datetime: "2026-03-06T11:05", tone: "warning",
                  body: "Nobody was home. They will try again tomorrow." },
                { title: "Delivered", time: "Mar 7, 10:20", datetime: "2026-03-07T10:20", tone: "success" },
            ]}/>
        </div>
        <div.demo-narrow.demo-wide>
            <Timeline items={[
                { title: "v0.9.0 released", time: "2 days ago", tone: "info" },
                { title: "Build failed on main", time: "5 days ago", tone: "danger", body: "tests/lang.rs: 1 failure" },
                { title: "Ada joined the project", time: "last week" },
            ]}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "timeline", name: "Timeline", group: "Data",
    summary: "What happened, in order, down a line of coloured dots, as an <ol> with <time> elements.",
    demo: TimelineDemo })
