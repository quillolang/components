let related_posts_demo_pic = (a: str, b: str) =>
    `data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 320 200'%3E%3Crect width='320' height='200' fill='${a}'/%3E%3Ccircle cx='90' cy='80' r='40' fill='${b}'/%3E%3Crect x='150' y='110' width='130' height='60' rx='8' fill='white' fill-opacity='.35'/%3E%3C/svg%3E`

let related_posts_demo_posts = [
    { title: "One file to deploy", href: "#related_posts-deploy", tags: ["Ops"], date: "2026-07-21", read_time: "6 min read",
      excerpt: "A binary and a program, copied to a server. What we learned running it for a year.",
      image: related_posts_demo_pic("%23a35200", "%23f3b54a") },
    { title: "Styles that travel with their components", href: "#related_posts-styles", tags: ["CSS", "Quillo"], date: "2026-09-02",
      read_time: "5 min read", excerpt: "How each component brings its own sheet, and why a page only gets what it shows.",
      image: related_posts_demo_pic("%235b4bdb", "%23b9a8ff"), image_alt: "Two shapes on purple" },
    { title: "Streaming the slow parts of a page", href: "#related_posts-defer", tags: ["Quillo", "Performance"], date: "2026-10-02",
      read_time: "7 min read", excerpt: "The page goes out at once; the reviews follow in the same answer.",
      image: related_posts_demo_pic("%2318794e", "%234cc38a") },
    { title: "Week notes: 43", href: "#related_posts-wn43", tags: ["Week notes"], date: "2026-10-24" },
]

view RelatedPostsDemo() =
    <div.demo-stack style="gap: 36px">
        <RelatedPosts id="related-posts-demo" tags={["quillo", "css"]} posts={related_posts_demo_posts}/>
        <div style="max-width: 460px">
            <RelatedPosts id="related-posts-demo-list" title="More from the blog" layout="list" limit={2}
                          posts={[related_posts_demo_posts[3], related_posts_demo_posts[2]]}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "related_posts", name: "RelatedPosts", group: "Blogging",
    summary: "Read next: other posts at the end of one, those sharing the most tags first, with picture, title, excerpt, date and the shared tags marked.",
    tags: ["blogging", "card", "list", "recommendations", "no-js"], demo: RelatedPostsDemo })
