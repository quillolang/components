let username_input_demo_taken = ["ana", "ana_nunez", "anunez", "bill", "cool", "Mike", "Ivan", "summer"]
let username_input_demo_reserved = ["admin", "root", "support", "help"]

component UsernameInputDemoLive() {
    state got = null
    <div.demo-stack>
        <UsernameInput id="username-demo-live" name="handle" label="Handle" taken={username_input_demo_taken} separators="-" max_length={12} suggestions={3}
                       on_change={(r) => { got = r }}/>
        <p.demo-note>{got == null ? "Type a name to see on_change." : `on_change: ${got.status} ${got.username}`}</p>
    </div>
}

view UsernameInputDemo() =
    <div class="demo-stack demo-narrow">
        <form>
            <UsernameInput id="username-demo" taken={username_input_demo_taken} reserved={username_input_demo_reserved} person="Ana Sofía Núñez" required={true}/>
        </form>
        <UsernameInputDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "username_input", name: "UsernameInput", group: "Forms",
    summary: "Ticks off each rule live, checks taken names in any case and for look-alikes such as l and 1 or O and 0, and offers free names made from the person's own.",
    tags: ["smart", "interactive", "username", "signup", "validation", "forms"], needs: ["slug_input"], demo: UsernameInputDemo })
