component ImageDemoLive() {
    state loaded = 0
    state broken = 0
    <div.demo-stack>
        <div.demo-row style="align-items: flex-start">
            <Image src="https://picsum.photos/seed/harbour/640/360" alt="Boats in a harbour" width="300px" color="#cfd9e6"
                   on_load={() => { loaded += 1 }}/>
            <Image src="data:image/png;base64,bm90IGEgcGljdHVyZQ==" alt="A missing photo" width="300px" on_error={() => { broken += 1 }}/>
        </div>
        <p.demo-note id="image-demo-note">{loaded} loaded, {broken} failed.</p>
    </div>
}

view ImageDemo() =
    <div.demo-stack>
        <ImageDemoLive/>
        <div.demo-row id="image-demo-shapes" style="align-items: flex-start">
            <Image src="https://picsum.photos/seed/forest/400/400" alt="A forest" ratio="1" width="160px"/>
            <Image src="https://picsum.photos/seed/lake/400/300" alt="A lake" ratio="4/3" width="160px" radius={false}/>
            <Image src="https://picsum.photos/seed/dunes/400/300" alt="Dunes" ratio="1" fit="contain" width="160px" color="#e8e2d6"/>
            <Image src="https://picsum.photos/seed/city/300/200" alt="A city" ratio={null} width="160px"/>
        </div>
        <p.demo-note>Each keeps its shape while it loads; the broken one says so and keeps its alt for screen readers.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "image", name: "Image", group: "Media",
    summary: "An image that keeps its shape while it loads, shimmering, and shows a fallback with its alt when it cannot.",
    tags: ["media", "image", "loading", "interactive"], demo: ImageDemo })
