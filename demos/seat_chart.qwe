view SeatChartDemo() =
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 32px; align-items: start">
        <SeatChart id="seat-chart-demo-house" title="House of Commons, 650 seats" parties={[
            { name: "Labour", short: "LAB", seats: 411, change: 211, color: "#d50000" },
            { name: "Liberal Democrats", short: "LD", seats: 72, change: 64, color: "#f5a000" },
            { name: "Others", short: "OTH", seats: 46, change: -31, color: "#8a8f98" },
            { name: "Conservative", short: "CON", seats: 121, change: -244, color: "#0087dc" },
        ]}/>
        <SeatChart id="seat-chart-demo-night" title="City council, results so far" total={51} parties={[
            { name: "Civic Alliance", seats: 19 },
            { name: "Greens", seats: 9 },
            { name: "People's Party", seats: 14 },
        ]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "seat_chart", name: "SeatChart", group: "News",
    summary: "A parliament as a half circle of seats coloured by party, undeclared seats in grey, the majority marked, and a legend with seats won and lost.",
    tags: ["news", "election", "chart", "svg", "no-js"], demo: SeatChartDemo })
