let grouped_list_demo_groups = [
    { title: "Account", footer: "Your name shows on orders and receipts.", rows: [
        { label: "Name", value: "Ada Lovelace", key: "name", icon: "M16 19v-1a4 4 0 0 0-8 0v1M12 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6" },
        { label: "Email", value: "ada@analytical.example", key: "email", icon: "M4 6h16v12H4zM4 7l8 6 8-6" },
        { label: "Plan", sub: "Renews on 1 December", badge: "Pro", key: "plan", icon: "★" }
    ] },
    { title: "Help", rows: [
        { label: "What's new", href: "#grouped-list-new", badge: 3 },
        { label: "Version", value: "4.2.1" },
        { label: "Old sync", value: "Removed", disabled: true, chevron: true }
    ] },
    { rows: [{ label: "Sign out", danger: true, key: "out" }] }
]

component GroupedListDemoLive() {
    state last = "none"
    <div.demo-stack>
        <GroupedList label="Your account" groups={grouped_list_demo_groups} on_select={(row) => { last = row.label }}/>
        <p.demo-note>Last tapped: <b data-last>{last}</b></p>
        <div.ui-dark data-dark>
            <GroupedList groups={[{ title: "Dark", rows: [{ label: "Always dark here", value: "On", key: "dark" }] }]}/>
        </div>
        <GroupedList groups={[null, { title: "Bad rows are left out", rows: [null, 3, { label: "" }, { label: "The one good row" }] }, { rows: "nonsense" }, { rows: [] }]}/>
    </div>
}

view GroupedListDemo() = <GroupedListDemoLive/>

ui_gallery = ui_gallery | push({ slug: "grouped_list", name: "GroupedList", group: "Mobile",
    summary: "iOS-style inset grouped rows with headers, footers and disclosure chevrons, full-row tap targets, and dark mode.",
    tags: ["mobile", "no-js", "tablet", "list", "settings", "ios"],
    demo: GroupedListDemo })
