let small_multiples_demo_weeks = for i in range(12) => `W${i + 1}`
// A store's weekly sales: a level, a trend and a wobble, the same on every run.
fn small_multiples_demo_sales(level: num, trend: num, wobble: num) -> list =
    for i in range(12) => round((level + trend * i + wobble * math.sin(i * 0.9 + level / 7)) * 1000)

view SmallMultiplesDemo() =
    <div.demo-stack>
        <SmallMultiples label="Weekly sales by store" show_label={true} labels={small_multiples_demo_weeks} kind="area"
                        prefix="$" columns={3}
                        groups={[{ name: "Lisbon", values: small_multiples_demo_sales(42, 1.5, 5) },
                                 { name: "Porto", values: small_multiples_demo_sales(30, 0.4, 4) },
                                 { name: "Madrid", values: small_multiples_demo_sales(55, -1.2, 6) },
                                 { name: "Seville", values: small_multiples_demo_sales(18, 0.9, 3) },
                                 { name: "Valencia", values: small_multiples_demo_sales(24, 0.1, 7) },
                                 { name: "Bilbao", values: small_multiples_demo_sales(15, -0.3, 2) }]}/>
        <SmallMultiples label="Sign-ups by month, each on its own scale" show_label={true} kind="bar" shared={false} color={3} height={70}
                        labels={["Jan", "Feb", "Mar", "Apr", "May", "Jun"]}
                        groups={[{ name: "Free", values: [1840, 2010, 2210, 2480, 2650, 3120] },
                                 { name: "Pro", values: [420, 455, 515, 590, 640, 810] },
                                 { name: "Team", values: [96, 104, 130, 151, 188, 245] },
                                 { name: "Enterprise", values: [4, 3, 6, null, 7, 9] }]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "small_multiples", name: "SmallMultiples", group: "Charts",
    summary: "The same small line, area or bar chart for each group in a grid, on one shared scale, with each value on hover.",
    tags: ["chart", "data", "grid", "dashboard", "no-js"],
    demo: SmallMultiplesDemo })
