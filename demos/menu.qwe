component MenuDemoLive() {
    state did = "nothing yet"
    <div.demo-stack>
        <Menu id="menu-demo-live" label="Actions" bordered={true} size="sm" items={[
            { label: "Rename", shortcut: "F2", icon: "M4 20h4L18.5 9.5a2.1 2.1 0 0 0-3-3L5 17z" },
            { label: "Duplicate", shortcut: "⌘D", icon: "M8 8h12v12H8zM4 16V4h12" },
            { label: "Archive", disabled: true },
            { divider: true },
            { label: "Delete", shortcut: "⌫", tone: "danger", icon: "M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13" }
        ]} on_select={(it) => { did = it.label }}/>
        <p.demo-note>Picked: {did}</p>
    </div>
}

view MenuDemo() =
    <div.demo-row style="align-items: flex-start; gap: 32px">
        <div style="width: 240px">
            <Menu id="menu-demo" label="Settings" active="#menu" items={[
                { section: "Account" },
                { label: "Profile", href: "#profile", icon: "M16 19v-1a4 4 0 0 0-8 0v1M12 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6" },
                { label: "Notifications", href: "#menu", icon: "M6 16V11a6 6 0 0 1 12 0v5l2 2H4zM10 21h4", badge: 3 },
                { label: "Billing", href: "#billing", icon: "M3 7h18v10H3zM3 11h18" },
                { section: "Workspace" },
                { label: "Members", href: "#members", icon: "👥", badge: 12 },
                { label: "Integrations", href: "#integrations", icon: "🔌", disabled: true },
                { divider: true },
                { label: "Sign out", href: "#signout", tone: "danger", icon: "M10 17l5-5-5-5M15 12H3M21 4v16" }
            ]}/>
        </div>
        <div style="width: 240px"><MenuDemoLive/></div>
    </div>

ui_gallery = ui_gallery | push({ slug: "menu", name: "Menu", group: "Navigation",
    summary: "A vertical list of links and actions in titled sections, with icons, shortcuts, counts, disabled items and the active one marked.",
    tags: ["navigation", "menu", "list", "link", "no-js"], demo: MenuDemo })
