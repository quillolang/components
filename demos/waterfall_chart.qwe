view WaterfallChartDemo() =
    <div.demo-stack>
        <WaterfallChart label="Cash this quarter" show_label={true} prefix="$" start={42000} start_label="Opening" end_label="Closing"
                        steps={[{ label: "Sales", value: 31500 }, { label: "Services", value: 8200 }, { label: "Refunds", value: -2400 },
                                { label: "Q subtotal", total: true }, { label: "Payroll", value: -38800 }, { label: "Rent", value: -6500 },
                                { label: "Tax refund", value: 3100 }]}/>
        <WaterfallChart label="Headcount" show_label={true} start={24} start_label="Jan 1" end_label="Dec 31" height={160}
                        steps={[{ label: "Hired", value: 11 }, { label: "Left", value: -4 }, { label: "Moved in", value: 2 },
                                { label: "Moved out", value: -3 }]}/>
        <p.demo-note>A step with total: true draws the running total as a subtotal.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "waterfall_chart", name: "WaterfallChart", group: "Charts",
    summary: "A start value, its rises and falls as floating bars joined by steps, subtotals and an end total, with the running total on hover.",
    tags: ["chart", "data", "dashboard", "no-js"],
    demo: WaterfallChartDemo })
