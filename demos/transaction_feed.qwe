component TransactionFeedDemoLive() {
    state log = "Nothing opened"
    <div.demo-stack>
        <div.demo-phone>
            <TransactionFeed items={transaction_feed_demo_items} today="2026-11-01" on_open={(the_id) => { log = `Opened ${the_id}` }}/>
        </div>
        <p.demo-note id="txfeed-log">{log}</p>
    </div>
}

view TransactionFeedDemo() = <div.demo-stack><TransactionFeedDemoLive/></div>

ui_gallery = ui_gallery | push({ slug: "transaction_feed", name: "TransactionFeed", group: "Mobile",
    summary: "Money in and out, grouped by day, pending first, searchable, a category on each row, and the details in a sheet.",
    tags: ["mobile", "interactive", "banking", "search", "sheet", "tablet"],
    needs: ["price"],
    demo: TransactionFeedDemo })
