component IconPickerDemoLive() {
    state icon = "heart"
    <div.demo-stack>
        <IconPicker id="icon-picker-demo-live" label="App icon" value={icon} search={false} size="sm"
                    only={["home", "star", "heart", "bell", "mail", "user", "settings", "globe"]}
                    on_change={(n) => { icon = n }}/>
        <p.demo-note>Picked {icon}.</p>
    </div>
}

view IconPickerDemo() =
    <div.demo-stack.demo-narrow>
        <IconPicker id="icon-picker-demo-all" name="icon" label="Category icon" value="star"
                    hint="Search by name or by what it means: bin, gear, person."/>
        <IconPickerDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "icon_picker", name: "IconPicker", group: "Forms",
    summary: "Pick an icon from a grid of 51, narrowed by a search over names and meanings; the arrow keys move and a form gets the name.",
    tags: ["forms", "picker", "icon", "search", "interactive"], demo: IconPickerDemo })
