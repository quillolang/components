component SignaturePadDemoLive() {
    state png = null
    <div.demo-stack>
        <SignaturePad name="sp-demo-initials" label="Initials" width={240} height={100} typed={false} line_width={3}
                      on_change={(v) => { png = v }}/>
        <p.demo-note>{png == null ? "Not signed." : `Signed: ${len(png)} characters of PNG.`}</p>
    </div>
}

view SignaturePadDemo() {
    <div.demo-stack>
        <SignaturePad name="sp-demo-sign" label="Sign here" required={true} hint="Draw with the mouse or a finger, or type your name."/>
        <SignaturePadDemoLive/>
        <SignaturePad name="sp-demo-off" label="Signed already" width={240} height={80} disabled={true}/>
    </div>
}

ui_gallery = ui_gallery | push({ slug: "signature_pad", name: "SignaturePad", group: "Forms",
    summary: "Draw a signature on a canvas (or type the name), with Clear, kept as a PNG data URL in a hidden input a form sends.",
    tags: ["forms", "input", "drag", "document", "interactive"], demo: SignaturePadDemo })
