view KbdDemo() =
    <div.demo-stack>
        <div.demo-row>
            <Kbd keys="Ctrl+Shift+P" id="kbd-demo-combo"/>
            <Kbd keys={["Cmd", "K"]} id="kbd-demo-cmdk"/>
            <Kbd keys="Alt+Enter"/>
            <Kbd keys="Shift+Tab"/>
            <Kbd keys="Ctrl+C" symbols={false} id="kbd-demo-plain"/>
        </div>
        <div.demo-row>
            <Kbd id="kbd-demo-one">Esc</Kbd>
            <Kbd keys="Up"/><Kbd keys="Down"/><Kbd keys="Left"/><Kbd keys="Right"/>
            <Kbd keys="Space"/>
            <Kbd keys="F5"/>
        </div>
        <div.demo-row>
            <Kbd size="sm" keys="Cmd+S"/>
            <Kbd keys="Cmd+S"/>
            <Kbd size="lg" keys="Cmd+S"/>
        </div>
        <p.demo-note>Press <Kbd keys="Cmd+K"/> to open the command palette, or <Kbd>?</Kbd> for the shortcuts.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "kbd", name: "Kbd", group: "Typography",
    summary: "A key or a key combination (⌘K, Ctrl+Shift+P) as <kbd> elements, with symbols for the modifiers.",
    tags: ["typography", "keyboard", "text", "no-js"],
    demo: KbdDemo })
