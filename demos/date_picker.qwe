component DatePickerDemoLive() {
    state d = null
    <div.demo-stack>
        <DatePicker name="dp-demo-birthday" label="Birthday" week_start={0} on_change={(v) => { d = v }}/>
        <p.demo-note>{d == null ? "No date yet." : `The form sends ${d}.`}</p>
    </div>
}

view DatePickerDemo() =
    <div.demo-stack>
        <div.demo-row>
            <DatePicker name="dp-demo-due" label="Due date" value="2026-11-02"
                        hint="Type it, or press ArrowDown for the calendar."/>
            <DatePickerDemoLive/>
        </div>
        <DatePicker name="dp-demo-checkin" label="Check-in" value="2026-12-22" min="2026-12-01" max="2027-01-31"
                    disabled_dates={["2026-12-25", "2026-12-26"]} disabled_weekdays={[0]} required={true}
                    hint="December or January; closed on Sundays and over Christmas."/>
        <DatePicker name="dp-demo-late" label="Shipped on" value="2026-10-01" size="sm" error="That is before the order date."/>
    </div>

ui_gallery = ui_gallery | push({ slug: "date_picker", name: "DatePicker", group: "Forms",
    summary: "A date typed as YYYY-MM-DD or picked in a calendar grid, with the keyboard, limits and days that cannot be chosen.",
    demo: DatePickerDemo })
