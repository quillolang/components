let interactive_line_chart_demo_days = for i in range(60) => date.format(date.add_days("2026-08-01", i), "MMM D")
// Daily visits: a weekly rhythm, a slow rise and a launch spike, the same on every run.
fn interactive_line_chart_demo_visits(level: num, rise: num, swing: num, spike: num) -> list =
    for i in range(60) => round(level + rise * i + swing * math.sin(i * 2 * math.pi / 7) + (i >= 38 && i < 44 ? spike * (44 - i) / 6 : 0))

component InteractiveLineChartDemoLive() {
    state range_note = "Aug 1 to Sep 29"
    <div.demo-stack>
        <InteractiveLineChart label="Daily visitors" show_label={true} labels={interactive_line_chart_demo_days}
                              on_zoom={(first, last) => { range_note = `${first} to ${last}` }}
                              series={[{ name: "Web", values: interactive_line_chart_demo_visits(1200, 9, 160, 900) },
                                       { name: "iOS", values: interactive_line_chart_demo_visits(640, 6, 90, 500) },
                                       { name: "Android", values: interactive_line_chart_demo_visits(480, 4, 70, 300) }]}/>
        <p.demo-note>Showing {range_note}. Drag across the plot to zoom; click a legend item to hide its line.</p>
    </div>
}

view InteractiveLineChartDemo() = <InteractiveLineChartDemoLive/>

ui_gallery = ui_gallery | push({ slug: "interactive_line_chart", name: "InteractiveLineChart", group: "Charts",
    summary: "Lines with a crosshair and tooltip that follow the pointer or the keyboard, legend items that hide series, and drag to zoom.",
    tags: ["chart", "data", "interactive", "keyboard"],
    demo: InteractiveLineChartDemo })
