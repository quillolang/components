let vertical_tabs_demo_tabs = [
    { label: "Profile", hint: "Name, photo, bio", icon: "M16 19v-1a4 4 0 0 0-8 0v1M12 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6" },
    { label: "Notifications", hint: "Email and push", icon: "M6 16V11a6 6 0 0 1 12 0v5l2 2H4zM10 21h4", badge: 2 },
    { label: "Security", hint: "Password, two-factor", icon: "M6 11h12v10H6zM8 11V7a4 4 0 0 1 8 0v4" },
    { label: "Billing", hint: "Plan and invoices", icon: "M3 7h18v10H3zM3 11h18" },
    { label: "Developer", hint: "API keys", icon: "M8 6 2 12l6 6M16 6l6 6-6 6", disabled: true }
]

component VerticalTabsDemoLive() {
    state tab = 0
    <VerticalTabs id="vertical-tabs-demo" label="Settings" tabs={vertical_tabs_demo_tabs} selected={tab} on_change={(i) => { tab = i }}>
        <h4 style="margin: 0 0 6px">{vertical_tabs_demo_tabs[tab].label}</h4>
        <p.demo-note>{vertical_tabs_demo_tabs[tab].hint}: the panel for tab {tab + 1} of 5, from state. The up and down arrows move between tabs.</p>
    </VerticalTabs>
}

view VerticalTabsDemo() =
    <div.demo-stack>
        <VerticalTabsDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "vertical_tabs", name: "VerticalTabs", group: "Navigation",
    summary: "Tabs down the left with icons and a line of detail, and the selected one's panel at the right; a row above it when narrow.",
    tags: ["navigation", "tabs", "settings", "interactive"], demo: VerticalTabsDemo })
