component KeyValueEditorDemoLive() {
    state headers = { Accept: "application/json", "X-Request-Id": "7f3a9c" }
    <div.demo-stack>
        <KeyValueEditor id="kv-headers" label="Request headers" key_label="Header" value={headers}
                        key_placeholder="Header-Name" on_change={(m) => { headers = m }}/>
        <p.demo-note>{len(keys(headers))} header{len(keys(headers)) == 1 ? "" : "s"}: {join(keys(headers), ", ")}</p>
    </div>
}

view KeyValueEditorDemo() =
    <div.demo-stack style="max-width: 560px">
        <KeyValueEditor id="kv-env" name="env" label="Environment variables" max={8}
                        value={{ PORT: "8080", LOG_LEVEL: "info", DATABASE_URL: "postgres://db/app" }}
                        key_placeholder="NAME" value_placeholder="value"
                        hint="Sent as one JSON object; up to 8 variables."/>
        <KeyValueEditorDemoLive/>
        <KeyValueEditor id="kv-labels" name="labels" format="fields" label="Labels" value={[]} add_label="Add label"/>
    </div>

ui_gallery = ui_gallery | push({ slug: "key_value_editor", name: "KeyValueEditor", group: "Forms",
    summary: "Rows of keys and values to add and remove, with duplicate keys pointed out; posts JSON or name[key] fields.",
    demo: KeyValueEditorDemo })
