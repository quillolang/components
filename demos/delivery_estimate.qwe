view DeliveryEstimateDemo() =
    <div.demo-stack>
        <div.demo-row style="gap: 28px">
            <DeliveryEstimate min_days={2} max_days={4}/>
            <DeliveryEstimate min_days={1} business_days={true} cutoff="Order by 2 pm"/>
            <DeliveryEstimate min_days={0} label="Collect" icon={false}/>
        </div>
        <div.demo-row style="gap: 28px">
            <DeliveryEstimate from="2026-11-02" min_days={2} max_days={4}/>
            <DeliveryEstimate from="2026-10-28" min_days={2} max_days={5}/>
            <DeliveryEstimate from="2026-11-05" min_days={1} max_days={3} business_days={true} size="sm"/>
        </div>
        <p.demo-note>The first row counts from today; the second from dates given, so it reads the same every day.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "delivery_estimate", name: "DeliveryEstimate", group: "Commerce",
    summary: "\"Arrives Tue 4 – Thu 6 Nov\", worked out from how many days delivery takes, working days if asked.",
    tags: ["commerce", "checkout", "time", "calendar", "no-js"], demo: DeliveryEstimateDemo })
