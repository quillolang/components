view WorldClockDemo() =
    <div.demo-stack>
        <div id="world-clock-demo-now">
            <WorldClock seconds={true} zones={[{ city: "Lisbon", zone: "Europe/Lisbon" }, { city: "New York", zone: "America/New_York" },
                                               { city: "Mumbai", zone: "Asia/Kolkata" }, { city: "Tokyo", zone: "Asia/Tokyo" }]}/>
        </div>
        <div.demo-narrow id="world-clock-demo-fixed">
            <WorldClock variant="list" hour12={true} at="2026-11-02T22:30:00Z" label="Team hours"
                        zones={[{ city: "London", zone: "Europe/London", note: "Ana, Ben" }, { city: "San Francisco", zone: "America/Los_Angeles" },
                                { city: "Sydney", zone: "Australia/Sydney", note: "Lee" }, { city: "Kathmandu", zone: "+05:45" }]}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "world_clock", name: "WorldClock", group: "Scheduling",
    summary: "The time now in several cities, ticking, with the day there and how far ahead or behind the first one each is.",
    tags: ["schedule", "time", "clock", "interactive"], demo: WorldClockDemo })
