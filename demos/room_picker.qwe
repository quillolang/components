component RoomPickerDemoLive() {
    state note = "Add a room: on_change gets the rates chosen."
    <div.demo-stack>
        <RoomPicker id="room-picker-demo" name="stay" nights={4} action="#reserve" on_change={(rs) => {
            note = `on_change: ${join(rs | map((r) => `${r.count} × ${r.room}/${r.rate} = ${r.total}`), "; ")}`
        }} rooms={[
            { id: "dbl", name: "Double room", size: "22 m²", beds: "1 double bed", sleeps: 2, left: 2, image: "https://picsum.photos/seed/double-room/400/300",
              features: ["City view", "Air conditioning", "Rain shower"],
              rates: [{ id: "nr", label: "Saver rate", price: 109.00m, old: 128.00m, refundable: false },
                      { id: "flex", label: "Flexible rate", price: 129.00m, refundable: true, breakfast: true, note: "Cancel free until 3 Nov, 23:59" }] },
            { id: "fam", name: "Family suite", size: "38 m²", beds: "1 king bed and 2 single beds", sleeps: 4, image: "https://picsum.photos/seed/family-suite/400/300",
              features: ["Balcony", "Kitchenette", "Bath"],
              rates: [{ id: "flex", label: "Flexible rate", price: 219.00m, refundable: true }] }]}/>
        <p.demo-note id="room-picker-demo-note">{note}</p>
    </div>
}

view RoomPickerDemo() =
    <div.demo-stack>
        <RoomPickerDemoLive/>
        <RoomPicker id="room-picker-demo-hostel" name="beds" currency="EUR" locale="de-DE" max_rooms={2} reserve_label="Book beds" rooms={[
            { id: "dorm", name: "Bed in a dorm", beds: "1 bunk bed", sleeps: 1, rates: [{ id: "std", label: "Standard rate", price: 24.50m, breakfast: true }] }]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "room_picker", name: "RoomPicker", group: "Travel",
    summary: "A hotel's rooms with their rates (non-refundable, free cancellation, breakfast) and a counter for each, rooms left, the stay's total, who it sleeps and Reserve.",
    tags: ["travel", "hotels", "forms", "commerce", "interactive"], demo: RoomPickerDemo })
