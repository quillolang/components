component RemittanceQuoteDemoLive() {
    state note = "Change the amount."
    <div.demo-stack>
        <RemittanceQuote name="uk" send_currency="GBP" receive_currency="INR" mid={106.42m} rate={105.10m} fee_percent={0.5m}
                         fee_deducted={true} amount={200} least={10} locale="en-GB" delivery="Within 2 working days" cta={null}
                         on_change={(q) => { note = `${q.send} GBP: fee ${q.fee}, they get ${q.receive} INR at ${q.rate} (${q.markup}% under the mid).` }}/>
        <p.demo-note id="remittance-quote-demo-note">{note}</p>
    </div>
}

view RemittanceQuoteDemo() =
    <div class="demo-row" style="align-items: start">
        <RemittanceQuote send_currency="USD" receive_currency="PHP" mid={58.12m} markup={1.2m} fee={2.99m} amount={500} most={2999}
                         methods={[{ id: "bank", label: "Bank deposit", delivery: "Within 1 hour", note: "Banco Lumina, Kalayaan Savings" },
                                   { id: "cash", label: "Cash pickup", fee: 4.99m, delivery: "In minutes", note: "4,200 partner outlets" },
                                   { id: "wallet", label: "Mobile wallet", fee: 0, markup: 1.5m, delivery: "In minutes" }]}/>
        <RemittanceQuoteDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "remittance_quote", name: "RemittanceQuote", group: "Finance",
    summary: "Sending money abroad: you send, the fee, the rate against the mid-market rate, what they get and when it arrives, worked out as the amount changes.",
    tags: ["finance", "forex", "banking", "calculator", "forms", "interactive"], demo: RemittanceQuoteDemo })
