component WaterTrackerDemoLive() {
    state day = { day: "2026-11-01", entries: [250, 500] }
    state told = "Nothing yet."
    state goals = 0
    <div.demo-stack>
        <div id="water-tracker-main"><WaterTracker today="2026-11-01" saved={day} check_seconds={1}
            on_change={(d) => { day = d }} on_goal={(t) => { goals += 1; told = `goal ${t}` }} on_reset={(old) => { told = `reset ${old.day} ${len(old.entries)}` }}/></div>
        <p.demo-note id="water-tracker-kept">{json.stringify(day)}</p>
        <p.demo-note id="water-tracker-told">{told} ({goals})</p>
    </div>
}

view WaterTrackerDemo() =
    <div.demo-stack>
        <WaterTrackerDemoLive/>
        <div id="water-tracker-oz"><WaterTracker goal={64} sizes={[8, 12, 16]} unit="oz" today="2026-11-01" store="demo-water-oz"/></div>
        <div id="water-tracker-bad"><WaterTracker goal={-5} sizes={["big", null]} saved={{ day: 7, entries: "lots" }}/></div>
    </div>

ui_gallery = ui_gallery | push({ slug: "water_tracker", name: "WaterTracker", group: "Mobile",
    summary: "Tap a glass to add what was drunk, with undo, a goal and a day that starts empty at the phone's own midnight.",
    tags: ["mobile", "interactive", "health", "tracker", "haptics", "tablet"],
    demo: WaterTrackerDemo })
