let draft_keeper_demo_fields = [
    { name: "title", label: "Title", required: true, placeholder: "A short title" },
    { name: "ref", label: "Staff code (never kept)", secret: true },
    { name: "body", label: "What happened", multiline: true, required: true, placeholder: "Keep typing, then reload the page" },
]

component DraftKeeperDemoLive() {
    state refuse = false
    state sent = "Nothing sent yet."
    state told = "Nothing reported yet."
    state hold = false
    // A pretend server, a moment away. Named, as js_new is not waited for in a function written
    // in the markup's prop.
    let send = (v) => {
        let pause = js("Promise.resolve", js_new("Promise", (done) => { js("AbortSignal.timeout", 80).addEventListener("abort", (_e) => { done(true) }) }))
        if refuse {
            return { ok: false, error: "The line dropped." }
        }
        sent = `Sent: ${v.title}: ${v.body}`
        pause
    }
    <div.demo-stack>
        <DraftKeeper id="dkeep-demo" fields={draft_keeper_demo_fields} on_send={send}/>
        <div.demo-row><Button size="lg" variant="outline" id="dkeep-refuse" on_click={() => { refuse = !refuse }}>{refuse ? "Let sends through" : "Make sends fail"}</Button></div>
        <p.demo-note id="dkeep-sent">{sent}</p>
        <DraftKeeper id="dkeep-kept" label="A note kept by the program" saved={{ v: 1, values: { text: "From the app's own database" } }}
                     on_save={(d) => { told = d == null ? "on_save: nothing to keep" : `on_save: ${d.values.text}`; !hold }} on_send={(_v) => { true }}/>
        <div.demo-row><Button size="lg" variant="outline" id="dkeep-hold" on_click={() => { hold = true }}>Make keeping fail</Button></div>
        <p.demo-note id="dkeep-told">{told}</p>
    </div>
}

view DraftKeeperDemo() = <DraftKeeperDemoLive/>

ui_gallery = ui_gallery | push({ slug: "draft_keeper", name: "DraftKeeper", group: "Mobile",
    summary: "Keeps what was typed on this device through a reload and a crash, offers it back, and clears on send.",
    tags: ["mobile", "interactive", "offline", "forms", "draft", "tablet"],
    demo: DraftKeeperDemo })
