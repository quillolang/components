component TagInputDemoLive() {
    state tags = ["design"]
    <div.demo-stack>
        <TagInput name="ti-labels" label="Labels" value={tags} max={4} on_change={(ts) => { tags = ts }}
                  hint="Up to 4."/>
        <p.demo-note>{len(tags)} label{len(tags) == 1 ? "" : "s"}: {join(tags, ", ")}</p>
    </div>
}

view TagInputDemo() =
    <div.demo-stack.demo-narrow>
        <TagInput name="topics" label="Topics" value={["rust", "web"]} hint="Enter or a comma adds a topic."
                  suggestions={["css", "databases", "html", "javascript", "performance", "rust", "security", "web"]}/>
        <TagInputDemoLive/>
        <TagInput name="ti-off" label="Disabled" value={["locked"]} disabled={true} size="sm"/>
    </div>

ui_gallery = ui_gallery | push({ slug: "tag_input", name: "TagInput", group: "Forms",
    summary: "Collects tags: Enter or a comma adds one, Backspace removes; a form gets them as a list.",
    demo: TagInputDemo })
