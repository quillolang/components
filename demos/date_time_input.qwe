component DateTimeInputDemoLive() {
    state at = null
    <div.demo-stack>
        <DateTimeInput name="dti-demo-call" label="Call" zone="Europe/Lisbon" step={15} on_change={(t) => { at = t }}/>
        <p.demo-note>{at == null ? "Pick a date and a time." : `The form sends ${at}.`}</p>
    </div>
}

view DateTimeInputDemo() {
    <div.demo-stack>
        <DateTimeInput name="dti-demo-starts" label="Starts" value="2026-11-02T09:00" earliest="2026-11-01" latest="2027-12-31"
                       hint="Local time, as written."/>
        <DateTimeInputDemoLive/>
        <DateTimeInput name="dti-demo-utc" label="Deploy at (UTC)" zone="UTC" value="2026-11-02T14:30:00+01:00"
                       required={true} error="That is in the past."/>
    </div>
}

ui_gallery = ui_gallery | push({ slug: "date_time_input", name: "DateTimeInput", group: "Forms",
    summary: "A date and a time side by side on the browser's own fields, giving one ISO value, in a time zone when given one.",
    tags: ["forms", "input", "calendar", "time", "interactive"], demo: DateTimeInputDemo })
