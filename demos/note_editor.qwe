let note_editor_demo_text = "# Lisbon\n\nPack **light**, and bring `cash`.\n\n## To do\n- [x] Book the flight\n- [ ] Find a room near the river\n- Ask Ana about trams\n\n> Back on the 12th."

component NoteEditorDemoLive() {
    state saves = 0
    state last = ""
    state refuse = false
    state changes = 0
    <div.demo-stack>
        <div.demo-phone id="note-editor-screen">
            <NoteEditor title="Trip" text={note_editor_demo_text} autosave_ms={200}
                        on_save={(text, title) => {
                            saves += 1
                            last = `${title}|${text}`
                            !refuse
                        }}
                        on_change={(_t, _h) => { changes += 1 }}/>
        </div>
        <p.demo-note id="note-editor-saves">{saves}</p>
        <pre id="note-editor-last" hidden="true">{last}</pre>
        <p.demo-note id="note-editor-changes">{changes}</p>
        <button id="note-editor-refuse" type="button" hidden="true" @click={() => { refuse = !refuse }}>Refuse</button>
    </div>
}

view NoteEditorDemo() = <div.demo-stack><NoteEditorDemoLive/></div>

ui_gallery = ui_gallery | push({ slug: "note_editor", name: "NoteEditor", group: "Mobile",
    summary: "A note with a toolbar on the keyboard, autosave, checklists and Markdown shortcuts.",
    tags: ["mobile", "interactive", "notes", "keyboard", "markdown", "tablet"],
    demo: NoteEditorDemo })
