component SloCalculatorDemoLive() {
    state burn = null
    <div.demo-stack>
        <SloCalculator id="slo-calculator-demo-live" title="Checkout, by events" name="checkout" target="99.95" measure="events" window_days={28}
                       elapsed_days={7} bad={1200} total={4000000} today="2026-11-01" on_change={(f) => { burn = f.burn }}/>
        <p.demo-note>{burn == null ? "Change a figure to see on_change." : `on_change: the burn rate is ${round(burn, 2, "half_up")}.`}</p>
    </div>
}

view SloCalculatorDemo() =
    <div.demo-stack>
        <SloCalculator id="slo-calculator-demo" target="99.9" window_days={30} elapsed_days={10} bad={20} today="2026-11-01"/>
        <SloCalculatorDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "slo_calculator", name: "SloCalculator", group: "Dashboard",
    summary: "From a target and a window, works out allowed downtime, the error budget left, the burn rate, when it runs out, and burn alert thresholds.",
    tags: ["smart", "interactive", "slo", "reliability", "calculator", "monitoring"], demo: SloCalculatorDemo })
