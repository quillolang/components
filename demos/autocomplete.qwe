let autocomplete_demo_cities = ["Amsterdam", "Athens", "Auckland", "Barcelona", "Berlin", "Bordeaux", "Dublin", "Kyoto", "Lisbon",
                                "London", "Los Angeles", "Lyon", "Madrid", "New York", "Porto", "Prague", "Rome", "Vienna"]

component AutocompleteDemoLive() {
    state picked = null
    state text = ""
    <div.demo-stack>
        <Autocomplete name="ac-demo-tag" label="Tag" mode="any" limit={4}
                      options={["design", "databases", "devops", "documentation", "testing", "type-systems", "web"]}
                      on_change={(t) => { text = t }} on_select={(t) => { picked = t }}/>
        <p.demo-note>{text == "" ? "Type a tag; any text is kept." : `Text: ${text}${picked != null ? ` · last picked: ${picked}` : ""}`}</p>
    </div>
}

view AutocompleteDemo() {
    <div.demo-stack.demo-narrow>
        <Autocomplete name="ac-demo-city" label="City" options={autocomplete_demo_cities} placeholder="Where to?"
                      hint="Pick one, or type a city that is not on the list."/>
        <AutocompleteDemoLive/>
        <Autocomplete name="ac-demo-sm" label="Small" size="sm" min_chars={2} options={autocomplete_demo_cities} error="Tell us a city."/>
    </div>
}

ui_gallery = ui_gallery | push({ slug: "autocomplete", name: "Autocomplete", group: "Forms",
    summary: "A free-text box that offers matches as one types, with the arrow keys and Enter; whatever is typed may stay.",
    tags: ["forms", "input", "search", "keyboard", "interactive"], demo: AutocompleteDemo })
