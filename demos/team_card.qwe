view TeamCardDemo() =
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 14px">
        <TeamCard id="team-card-demo-ada" name="Ada Lovelace" role="Founder" href="#team_card" bio="Programs before computers."
                  links={[{ kind: "email", href: "mailto:ada@example.com" }, { kind: "github", href: "https://github.com/ada" },
                          { kind: "linkedin", href: "https://linkedin.com/in/ada" }, { kind: "x", href: "https://x.com/ada" }]}/>
        <TeamCard name="Grace Hopper" role="Compilers" src="https://i.pravatar.cc/224?img=47"
                  links={[{ kind: "web", href: "https://example.com", label: "Grace's site" }, { kind: "email", href: "mailto:grace@example.com" }]}/>
        <TeamCard name="Alan Turing" role="Research" bio="Machines, and whether they think."
                  links={[{ kind: "phone", href: "tel:+441234567" }]}/>
        <TeamCard name="Hedy Lamarr" role="Radio" size="sm"/>
    </div>

ui_gallery = ui_gallery | push({ slug: "team_card", name: "TeamCard", group: "Data",
    summary: "A person in a team grid: square photo or initials, name, role, a line, and icon links to email, GitHub, LinkedIn, X or a site.",
    tags: ["card", "user", "profile", "grid", "no-js"],
    needs: ["avatar"],
    demo: TeamCardDemo })
