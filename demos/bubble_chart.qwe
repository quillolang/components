view BubbleChartDemo() =
    <div.demo-stack>
        <BubbleChart label="Countries in 2023" show_label={true} x_label="GDP per person" x_prefix="$" y_label="Life expectancy"
                     suffix=" years" size_label="Population" size_suffix="M" height={260}
                     groups={[
                         { name: "Europe", points: [{ x: 46300, y: 82.3, size: 68.2, label: "France" }, { x: 52700, y: 81.2, size: 84.5, label: "Germany" },
                                                    { x: 33300, y: 83.1, size: 48.4, label: "Spain" }, { x: 22100, y: 78.5, size: 36.7, label: "Poland" }] },
                         { name: "Americas", points: [{ x: 80400, y: 77.5, size: 334.9, label: "United States" }, { x: 10000, y: 75.8, size: 216.4, label: "Brazil" },
                                                      { x: 13900, y: 75.1, size: 128.5, label: "Mexico" }, { x: 53400, y: 81.6, size: 40.1, label: "Canada" }] },
                         { name: "Asia", points: [{ x: 12600, y: 78.6, size: 1410.7, label: "China" }, { x: 2500, y: 72, size: 1428.6, label: "India" },
                                                  { x: 33800, y: 84.7, size: 124.5, label: "Japan" }, { x: 4900, y: 68.3, size: 277.5, label: "Indonesia" }] }]}/>
        <BubbleChart label="Projects" show_label={true} x_label="Weeks late" y_label="Budget used" suffix="%" size_label="Team size"
                     zero={true} max_radius={20} height={180} points={[
            { x: 0, y: 64, size: 4, label: "Atlas" }, { x: 2, y: 91, size: 9, label: "Beacon" }, { x: 5, y: 118, size: 14, label: "Comet" },
            { x: 1, y: 48, size: 3, label: "Delta" }, { x: 3, y: 102, size: 6, label: "Ember" }]}/>
        <p.demo-note>A bubble's area, not its width, is in proportion to its size; the largest are drawn first.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "bubble_chart", name: "BubbleChart", group: "Charts",
    summary: "Points placed by two numbers and sized by a third, in coloured groups, labelled when big enough, with all three numbers on hover.",
    tags: ["chart", "data", "no-js"],
    demo: BubbleChartDemo })
