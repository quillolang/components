let book_spread_demo_lines = [
    "The ferry left at first light, as it had every morning since the bridge came down, and the river took it sideways before the engine found its breath.",
    "Marta kept her hand on the rail and counted the pilings as they went past, because her father had once told her that a person who counts is never truly lost.",
    "On the far bank the town was still asleep, its shutters closed against a mist that had come up in the night and now lay in the streets like something spilled.",
    "There was a letter in her coat. She had read it four times and could have said it aloud, but she took it out again and held it, as if the paper might have changed.",
    "The ferryman asked nothing. He had carried enough people across to know the ones who wanted talk from the ones who wanted the far side, and he kept his eyes on the current.",
    "When the keel touched the gravel she stepped out before he had the rope tied, and stood for a moment with the cold coming up through her boots, listening to a town wake.",
]

fn book_spread_demo_blocks() -> list {
    flatten(range(1, 9) | map((c) => {
        // Long paragraphs, as a book has: three lines of text cannot break across a page.
        let body = range(0, 12) | map((i) => { { text: `${book_spread_demo_lines[(c + i) % 6]} ${book_spread_demo_lines[(c + i + 2) % 6]} ${book_spread_demo_lines[(c + i + 4) % 6]} (${c}.${i + 1})` } })
        [{ text: `Chapter ${c}`, kind: "h" }] + body
    }))
}

component BookSpreadDemoLive() {
    state place = "Not turned yet."
    state quote = ""
    <div.demo-stack>
        <div.demo-tablet>
            <BookSpread blocks={book_spread_demo_blocks()} title="The Far Bank"
                        on_position={(p) => {
                            place = `${p.block}:${p.offset} ${p.percent}% ${p.page}/${p.pages}`
                            quote = p.quote
                        }}/>
        </div>
        <p.demo-note id="book-spread-place">{place}</p>
        <p.demo-note id="book-spread-quote">{quote}</p>
        <div id="book-spread-saved" style="height: 320px"><BookSpread label="Saved" blocks={book_spread_demo_blocks()} position={{ block: 0, offset: 500, quote: "(8.12)" }}/></div>
        <div id="book-spread-odd" style="height: 320px"><BookSpread label="Odd" blocks={["Nothing here.", null, { text: " " }, 4, { text: "Still nothing.", kind: "h" }]} position={{ block: 9, offset: -4 }}/></div>
        <div id="book-spread-empty" style="height: 320px"><BookSpread label="Empty" blocks="none" position="soon"/></div>
    </div>
}

view BookSpreadDemo() = <BookSpreadDemoLive/>

ui_gallery = ui_gallery | push({ slug: "book_spread", name: "BookSpread", group: "Mobile",
    summary: "Reader pages, one column upright and a two-page spread turned, by swipe or edge tap, the place kept by text and not page number.",
    tags: ["mobile", "tablet", "interactive", "reader", "gesture", "book"],
    demo: BookSpreadDemo })
