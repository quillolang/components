component SpotlightTourDemoLive() {
    state said = "Not taken yet."
    <div.demo-stack>
        <div.demo-row>
            <SpotlightTour id="tour-demo" trigger="Take the tour" steps={[
                { target: "tour-demo-search", title: "Search", text: "Find any order by its number or the customer's name." },
                { target: "tour-demo-new", title: "New order", text: "Start one here; drafts are kept for a week." },
                { target: "tour-demo-nowhere", title: "That's it", text: "Ask us anything from the help menu." },
            ]} on_finish={() => { said = "Finished." }} on_close={(i) => { said = `Ended at step ${i + 1}.` }}/>
            <span.demo-note>{said}</span>
        </div>
        <div.demo-row>
            <input id="tour-demo-search" type="search" placeholder="Search orders" aria-label="Search orders"
                   style="height: 36px; padding: 0 10px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius-sm); background: var(--ui-surface); color: var(--ui-fg)"/>
            <Button id="tour-demo-new">New order</Button>
        </div>
    </div>
}

view SpotlightTourDemo() = <SpotlightTourDemoLive/>

ui_gallery = ui_gallery | push({ slug: "spotlight_tour", name: "SpotlightTour", group: "Overlays",
    summary: "A guided tour that dims the page and lights one element at a time by id, with a card saying what it is.",
    tags: ["overlay", "dialog", "keyboard", "interactive"],
    demo: SpotlightTourDemo })
