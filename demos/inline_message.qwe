view InlineMessageDemo() =
    <div.demo-stack>
        <div.demo-row style="gap: 20px">
            <InlineMessage id="inline-message-demo-info">Changes are saved as you type</InlineMessage>
            <InlineMessage id="inline-message-demo-ok" tone="success">Username is available</InlineMessage>
            <InlineMessage id="inline-message-demo-warn" tone="warning">Your trial ends in 2 days</InlineMessage>
            <InlineMessage id="inline-message-demo-err" tone="error">That email is already in use</InlineMessage>
        </div>
        <div.demo-row style="gap: 20px">
            <InlineMessage tone="neutral" size="sm">Last synced 4 minutes ago</InlineMessage>
            <InlineMessage tone="success" size="sm" icon={false}>Copied</InlineMessage>
            <InlineMessage tone="info" size="sm">Read the <a href="#inline_message">export guide</a></InlineMessage>
        </div>
        <div.demo-narrow>
            <TextField name="handle" field="inline-message-demo-handle" label="Username" value="ada" hint="Letters, numbers and dashes."/>
            <div style="margin-top: 6px"><InlineMessage tone="success" size="sm">ada is available</InlineMessage></div>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "inline_message", name: "InlineMessage", group: "Feedback",
    summary: "A small one-line message with an icon for its tone (info, success, warning, error), to sit in a form or beside a control.",
    tags: ["feedback", "status", "forms", "text", "no-js"],
    demo: InlineMessageDemo })
