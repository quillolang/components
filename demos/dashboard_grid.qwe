view DashboardGridDemo() =
    <div.demo-stack>
        <DashboardGrid id="dashboard-grid-demo">
            <DashboardCell span={8}>
                <Widget title="Revenue" subtitle="Last 8 weeks">
                    <BarChart labels={["W1", "W2", "W3", "W4", "W5", "W6", "W7", "W8"]} values={[31, 34, 33, 38, 41, 40, 45, 48]} label="Revenue by week"/>
                </Widget>
            </DashboardCell>
            <DashboardCell span={4}>
                <Widget title="Orders"><Stat label="This week" value="312" delta={8.1} delta_suffix="%" card={false}/></Widget>
            </DashboardCell>
            <DashboardCell span={4} rows={2}>
                <Widget title="Activity">
                    <Timeline items={[{ title: "Order #1041 paid", time: "9:12" }, { title: "Refund #1033", time: "8:50", tone: "warning" }, { title: "New customer: Ada L.", time: "8:02", tone: "success" }]}/>
                </Widget>
            </DashboardCell>
            <DashboardCell span={4}>
                <Widget title="Visitors"><Stat label="Today" value="4,180" delta={-2.4} delta_suffix="%" card={false}/></Widget>
            </DashboardCell>
            <DashboardCell span={4}>
                <Widget title="Conversion"><Stat label="Today" value="3.1%" delta={0.3} delta_suffix=" pts" card={false}/></Widget>
            </DashboardCell>
            <DashboardCell span={12}>
                <Widget title="Recent orders" href="#dashboard_grid" padding="none">
                    <DataTable columns={[{ key: "id", label: "Order" }, { key: "who", label: "Customer" }, { key: "total", label: "Total", align: "right" }]}
                               rows={[{ id: "#1041", who: "Ada L.", total: "$120.00" }, { id: "#1040", who: "Grace H.", total: "$64.50" }]}/>
                </Widget>
            </DashboardCell>
        </DashboardGrid>
        <p.demo-note>Twelve columns: 8 + 4, then 4 + 4 + 4 (the tall one spans two rows), then 12. Narrow the window to see them stack.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "dashboard_grid", name: "DashboardGrid", group: "Dashboard",
    summary: "Widgets on a twelve-column grid, each spanning columns and rows (DashboardCell), stacking on a phone.",
    tags: ["dashboard", "layout", "grid", "no-js"],
    demo: DashboardGridDemo })
