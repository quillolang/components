view MetricTrendDemo() =
    <div.demo-stack>
        <div.demo-row style="gap: 28px">
            <MetricTrend id="metric-trend-demo-revenue" label="Revenue" value="$48,210" delta={12.5} suffix="%"/>
            <MetricTrend id="metric-trend-demo-latency" label="Latency" value="212 ms" delta={18} suffix=" ms" good="down"/>
            <MetricTrend id="metric-trend-demo-users" label="Active users" current={1284} previous={1310}/>
            <MetricTrend id="metric-trend-demo-flat" label="Open tickets" value="37" delta={0}/>
        </div>
        <div.demo-row style="gap: 28px">
            <MetricTrend id="metric-trend-demo-pill" label="Conversion" value="3.4%" delta={0.6} suffix=" pts" variant="pill" size="lg"/>
            <MetricTrend id="metric-trend-demo-cost" label="Cloud cost" value="$9,120" delta={-8.25} suffix="%" good="down" variant="pill"/>
            <MetricTrend label="Storage" value="1.2 TB" delta={4} suffix="%" good="none" size="sm"/>
            <span>Signups this week <MetricTrend id="metric-trend-demo-inline" delta={-3} suffix="%" size="sm"/></span>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "metric_trend", name: "MetricTrend", group: "Data",
    summary: "A value with an up or down arrow and its change, coloured by whether the move is good; it can work the percentage out.",
    tags: ["data", "dashboard", "no-js"], demo: MetricTrendDemo })
