component PublishPanelDemoLive() {
    state note = "Nothing sent yet."
    <div.demo-stack>
        <PublishPanel name="draft" slug="Islands, resumed" base_url="blog.example.com/" saved="Saved 2 minutes ago" timezone="Europe/Paris"
                      on_publish={(p) => { note = `${p.intent}: ${p.status}, ${p.visibility}, /${p.slug}${p.publish_at != null ? " at " + p.publish_at : ""}` }}
                      on_save={(p) => { note = `${p.intent}: ${p.status}, /${p.slug}` }}/>
        <p.demo-note id="publish-panel-demo-note">{note}</p>
    </div>
}

view PublishPanelDemo() =
    <div class="demo-row" style="align-items: start; gap: 24px">
        <PublishPanelDemoLive/>
        <PublishPanel name="live" status="published" visibility="members" slug="week-notes-43" action="#publish_panel"/>
    </div>

ui_gallery = ui_gallery | push({ slug: "publish_panel", name: "PublishPanel", group: "Blogging",
    summary: "The editor's panel that puts a post out: its status, who may read it, now or scheduled, its address, then Save draft and Publish or Schedule.",
    tags: ["blogging", "forms", "editor", "publishing", "interactive"], demo: PublishPanelDemo })
