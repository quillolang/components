component YouTubeEmbedDemoLive() {
    state loaded = false
    <div.demo-stack>
        <YouTubeEmbed video="aqz-KE-bpKQ" title="Big Buck Bunny" on_play={() => { loaded = true }}/>
        <p.demo-note id="youtube-embed-demo-note">{loaded ? "The player is loaded." : "Nothing loaded from YouTube yet: only the poster image."}</p>
    </div>
}

view YouTubeEmbedDemo() =
    <div.demo-stack>
        <YouTubeEmbedDemoLive/>
        <div style="max-width: 360px">
            <YouTubeEmbed video="aqz-KE-bpKQ" title="From the second minute" start={120} ratio="4/3"/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "youtube_embed", name: "YouTubeEmbed", group: "Media",
    summary: "A YouTube video that loads nothing but its poster until the play button is clicked, then starts at once.",
    tags: ["media", "video", "interactive"], demo: YouTubeEmbedDemo })
