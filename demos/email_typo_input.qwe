component EmailTypoInputDemoLive() {
    state got = null
    <div.demo-stack>
        <EmailTypoInput id="email-typo-demo-live" name="invite" label="Invite a colleague" domains={["acme-robotics.com"]}
                        on_change={(r) => { got = r }}/>
        <p.demo-note>{got == null ? "Type an address to see on_change." : `on_change: ${got.status} ${got.email}`}</p>
    </div>
}

view EmailTypoInputDemo() =
    <div class="demo-stack demo-narrow">
        <form>
            <EmailTypoInput id="email-typo-demo" label="Email" value="jane@gmial.com" required={true}
                            disposable={["mailinator.com", "guerrillamail.com", "10minutemail.com"]}/>
        </form>
        <EmailTypoInputDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "email_typo_input", name: "EmailTypoInput", group: "Forms",
    summary: "Checks an address's shape, offers did you mean gmail.com by edit distance with one click to fix, warns of throwaway domains, and stays quiet on a valid uncommon domain.",
    tags: ["smart", "interactive", "email", "validation", "typo", "forms"], demo: EmailTypoInputDemo })
