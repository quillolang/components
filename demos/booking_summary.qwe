view BookingSummaryDemo() =
    <div.demo-row style="align-items: flex-start">
        <div style="flex: 1 1 320px; max-width: 400px">
            <BookingSummary id="booking-summary-demo-stay" title="River flat with a terrace" place="Lisbon, Alfama"
                            image="https://picsum.photos/seed/flat/200/160" image_alt="A bright living room"
                            check_in="2026-11-05" check_out="2026-11-09" times={{ in: "15:00", out: "11:00" }}
                            guests="2 adults, 1 child" status="Confirmed" reference="QX-48213" edit_href="#booking_summary"
                            lines={[{ label: "4 nights × €95", amount: "€380.00" }, { label: "Cleaning", amount: "€40.00" },
                                    { label: "Weekly discount", amount: "−€38.00", tone: "success" },
                                    { label: "Tourist tax", amount: "€16.00", hint: "€2 a night for each adult" }]}
                            total="€398.00" note="Free cancellation until 1 November."/>
        </div>
        <div style="flex: 1 1 280px; max-width: 360px">
            <BookingSummary id="booking-summary-demo-class" title="Pottery course" check_in="2026-11-02" check_out="2026-11-03"
                            in_label="Starts" out_label="Ends" nights_label="session" guests={1} status="Awaiting payment"
                            status_tone="warning" lines={[{ label: "1 session", amount: "$45.00" }]} total="$45.00"/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "booking_summary", name: "BookingSummary", group: "Scheduling",
    summary: "What was booked: the place and picture, dates in and out with the nights counted, guests, price lines, total and status.",
    tags: ["schedule", "commerce", "price", "checkout", "card", "no-js"], demo: BookingSummaryDemo })
