component RegexTesterDemoLive() {
    state said = "Change the pattern to see on_change."
    <div.demo-stack>
        <RegexTester id="regex-tester-demo-live" title="Find an order number" pattern="ORD-\\d+" flags="i" sample="ord-12 and ORD-3456, then ord-"
                     on_change={(r) => { said = r.error != null ? `on_change: column ${r.error.at + 1} is wrong.` : `on_change: ${r.count} found with flags "${r.flags}".` }}/>
        <p.demo-note>{said}</p>
    </div>
}

view RegexTesterDemo() =
    <div.demo-stack>
        <RegexTester id="regex-tester-demo" pattern="(?<year>\\d{4})-(?<month>\\d{2})(-\\d{2})?" sample="Paid 2026-11-01, due 2027-01 or never" replacement="$<month>/$<year>"/>
        <RegexTesterDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "regex_tester", name: "RegexTester", group: "Forms",
    summary: "Tests a pattern live: matches marked, groups listed, a replace preview, the pattern explained, errors at their place, and a guard against patterns that hang.",
    tags: ["smart", "interactive", "regex", "pattern", "developer", "text"], demo: RegexTesterDemo })
