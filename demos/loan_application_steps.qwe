view LoanApplicationStepsDemo() {
    <div.demo-stack>
        <LoanApplicationSteps id="loan-application-steps-demo-docs" reference="APP-2026-04817" product="Personal loan" amount="$24,000"
                              current="documents" dates={{ submitted: "2026-10-20", documents: "2026-10-21" }}
                              expected={{ credit_check: "2026-10-30", approval: "2026-11-04", disbursement: "2026-11-06" }}
                              note="We need two more documents before we can run the credit check."
                              needed={[{ label: "Photo ID", done: true },
                                       { label: "Last two payslips", detail: "PDF or a photo, each page readable" },
                                       { label: "Proof of address", detail: "A utility bill from the last three months" }]}
                              action_href="#upload" action_label="Upload documents"/>
        <div.demo-row style="align-items: stretch">
            <div style="flex: 1 1 320px; max-width: 420px">
                <LoanApplicationSteps id="loan-application-steps-demo-declined" reference="APP-2026-03321" product="Car loan" amount="€15,000"
                                      current="approval" outcome="declined" locale="en-GB"
                                      dates={{ submitted: "2026-10-02", documents: "2026-10-03", credit_check: "2026-10-07", approval: "2026-10-09" }}
                                      note="Your monthly debts would be 52% of your income with this loan. A smaller amount or a longer term may be approved."
                                      action_href="#calculator" action_label="Try another amount"/>
            </div>
            <div style="flex: 1 1 320px; max-width: 420px">
                <LoanApplicationSteps id="loan-application-steps-demo-done" reference="APP-2026-02210" amount="$8,500" outcome="complete"
                                      dates={{ submitted: "2026-09-14", documents: "2026-09-15", credit_check: "2026-09-16", approval: "2026-09-18", disbursement: "2026-09-19" }}
                                      note="$8,500 was paid into your account ending 3390 on Sep 19."/>
            </div>
        </div>
    </div>
}

ui_gallery = ui_gallery | push({ slug: "loan_application_steps", name: "LoanApplicationSteps", group: "Finance",
    summary: "Where a loan application stands, from submitted to disbursed: the steps done with their dates, the current one, and what is needed next.",
    tags: ["finance", "loans", "steps", "status", "no-js"], demo: LoanApplicationStepsDemo })
