let pull_to_refresh_demo_rows = [
    { id: 1, who: "Ana Costa", text: "Sent the signed lease" }, { id: 2, who: "Ben Okafor", text: "Moved the viewing to Friday" },
    { id: 3, who: "Chloe Martin", text: "Paid the deposit" }, { id: 4, who: "Dev Patel", text: "Asked about parking" },
    { id: 5, who: "Elena Rossi", text: "Booked the movers" }, { id: 6, who: "Farid Haddad", text: "Reported a leaking tap" },
    { id: 7, who: "Grace Lin", text: "Renewed for a year" }, { id: 8, who: "Hugo Blanc", text: "Returned the keys" },
    { id: 9, who: "Ines Silva", text: "Sent the meter reading" }, { id: 10, who: "Jonas Weber", text: "Added a second tenant" },
    { id: 11, who: "Kira Novak", text: "Changed the bank details" }, { id: 12, who: "Liam Byrne", text: "Asked for a copy of the lease" },
] + (for i in range(13, 31) => { id: i, who: `Flat ${i}`, text: "Sent the meter reading" })

let pull_to_refresh_demo_css = css`
.demo-pull-row { display: block; padding: 12px 16px; border-bottom: 1px solid var(--ui-border); }
.demo-pull-row b { display: block; font-weight: 600; }
.demo-pull-row span { color: var(--ui-muted); font-size: 14px; }
`

component PullToRefreshDemoLive() {
    style global pull_to_refresh_demo_css
    state rows = pull_to_refresh_demo_rows
    state fail_next = false
    state finish = null     // the done of the refresh under way: a timer stands in for the network
    state added = 0
    state count = 0
    state tall = "100%"
    if finish != null {
        every(700, () => {
            let done = finish
            finish = null
            count += 1
            if !fail_next {
                added += 1
                rows = [{ id: 100 + added, who: "New message", text: `Arrived in refresh ${added}` }] + rows
            }
            done(!fail_next)
        })
    }
    <div.demo-stack>
        <div.demo-tablet>
            <PullToRefresh height={tall} label="Messages" on_refresh={(done) => { finish = done }}>
                {for r in rows => <div.demo-pull-row key={r.id}><b>{r.who}</b><span>{r.text}</span></div>}
            </PullToRefresh>
        </div>
        <label.demo-note style="display: flex; align-items: center; gap: 8px; min-height: 44px">
            <input type="checkbox" id="pull-demo-fail" bind:checked={fail_next}/> The next refresh fails
        </label>
        <p.demo-note id="pull-demo-count">Refreshes finished: {count}. Pull from the top of the list, or use the button.</p>
        // For the test: a prop changing in mid-pull, and each way a callback can answer.
        <div id="pull-demo-hooks" hidden="true">
            <button id="pull-demo-resize" type="button" @click={() => { tall = "99%" }}>Resize</button>
            <PullToRefresh height="80px" on_refresh={(_done) => js("Promise.resolve", true)}>A Promise of true</PullToRefresh>
            <PullToRefresh height="80px" on_refresh={(_done) => js("Promise.resolve", false)}>A Promise of false</PullToRefresh>
            <PullToRefresh height="80px" on_refresh={(_done) => js("Promise.resolve")}>A Promise of nothing</PullToRefresh>
            <PullToRefresh height="80px" on_refresh={(_done) => js("Promise.reject", "no")}>A Promise refused</PullToRefresh>
            <PullToRefresh height="80px" on_refresh={(_done) => true}>Plain true</PullToRefresh>
            <PullToRefresh height="80px" on_refresh={(_done) => false}>Plain false</PullToRefresh>
        </div>
    </div>
}

view PullToRefreshDemo() = <PullToRefreshDemoLive/>

ui_gallery = ui_gallery | push({ slug: "pull_to_refresh", name: "PullToRefresh", group: "Mobile",
    summary: "Pull a list down from its top to refresh, with resistance, a spinner, and success and failure states.",
    tags: ["mobile", "interactive", "gesture", "refresh", "scroll", "list"],
    demo: PullToRefreshDemo })
