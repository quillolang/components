component NumberInputDemoLive() {
    state qty = 2
    <div.demo-stack>
        <NumberInput name="qty" label="Tickets" value={qty} min={1} max={6}
                     hint="Six at most per order." on_change={(n) => { qty = n }}/>
        <p.demo-note>Total: ${qty != null ? qty * 18 : 0}</p>
    </div>
}

view NumberInputDemo() =
    <div.demo-stack>
        <NumberInputDemoLive/>
        <NumberInput name="guests" label="Guests" value={0} min={1} max={12} required={true}
                     error="At least one guest."/>
        <div.demo-row>
            <NumberInput name="weight" label="Weight (kg)" value={2.5} min={0} step={0.5}/>
            <NumberInput name="copies" label="Copies" size="sm" placeholder="1"/>
            <NumberInput name="locked" label="Seats" size="sm" value={4} disabled={true}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "number_input", name: "NumberInput", group: "Forms",
    summary: "A number box with − and + buttons that stop at its limits, and keeps what is typed between them.",
    tags: ["forms", "input", "interactive"],
    demo: NumberInputDemo })
