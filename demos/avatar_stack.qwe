let avatar_stack_demo_team = [
    { name: "Ada Lovelace", href: "#avatar_stack" },
    { name: "Grace Hopper", src: "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'%3E%3Crect width='40' height='40' fill='%23c9b8f5'/%3E%3Ccircle cx='20' cy='16' r='7' fill='%236e56cf'/%3E%3Cpath d='M6 40c2-9 8-13 14-13s12 4 14 13z' fill='%236e56cf'/%3E%3C/svg%3E" },
    { name: "Alan Turing" },
    { name: "Katherine Johnson" },
    { name: "Linus Torvalds" },
    { name: "Margaret Hamilton" },
    { name: "Dennis Ritchie" },
]

view AvatarStackDemo() =
    <div.demo-stack>
        <div.demo-row style="gap: 28px">
            <AvatarStack people={avatar_stack_demo_team} label="Project members"/>
            <AvatarStack people={take(avatar_stack_demo_team, 3)} size="sm" label="Reviewers"/>
            <AvatarStack people={take(avatar_stack_demo_team, 5)} max={3} total={128} size="xs" label="Viewing now"/>
        </div>
        <div.demo-row style="gap: 28px">
            <AvatarStack people={avatar_stack_demo_team} max={5} size="lg" shape="square" label="Owners"/>
            <AvatarStack people={drop(avatar_stack_demo_team, 2)} max={2} size="xl" tooltips={false}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "avatar_stack", name: "AvatarStack", group: "Data",
    summary: "Overlapping avatars with names in tooltips, links to each person, and a +N that names the rest.",
    tags: ["user", "image", "list", "no-js"],
    demo: AvatarStackDemo })
