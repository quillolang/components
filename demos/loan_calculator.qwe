component LoanCalculatorDemoLive() {
    state payment = 0m
    state total = 0m
    <div.demo-stack>
        <LoanCalculator id="loan-calculator-demo-home" name="home" label="Home loan" amount={320000} amount_least={50000} amount_most={1000000}
                        amount_step={5000} rate={5.9} rate_most={12} term={30} term_least={5} term_most={35} currency="EUR" locale="de-DE"
                        on_change={(q) => { payment = q.payment; total = q.total }}/>
        <p.demo-note id="loan-calculator-demo-note">{payment > 0 ? `on_change: ${payment} a month, ${total} in all.` : "Move a slider: on_change gets the new payment."}</p>
    </div>
}

view LoanCalculatorDemo() {
    <div.demo-stack>
        <LoanCalculator id="loan-calculator-demo-car" name="car" amount={25000} rate={6.5} term={5}/>
        <LoanCalculatorDemoLive/>
        <div.demo-narrow>
            <LoanCalculator id="loan-calculator-demo-months" name="bike" label="Bike finance" amount={4800} amount_least={500} amount_most={10000}
                            amount_step={100} rate={0} term={24} term_unit="months" term_least={6} term_most={48}/>
        </div>
    </div>
}

ui_gallery = ui_gallery | push({ slug: "loan_calculator", name: "LoanCalculator", group: "Finance",
    summary: "A loan's amount, rate and term as sliders and boxes, with the monthly payment, total interest and total paid following as they move.",
    tags: ["finance", "loans", "calculator", "forms", "interactive"], demo: LoanCalculatorDemo })
