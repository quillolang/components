component ExpandingRowDemoLive() {
    state log = []
    state boss = false
    let note = (name, on) => { log = log + [`${name}:${on ? "open" : "shut"}`] }
    <div.demo-stack>
        <div.demo-phone data-frame style="height: 420px">
            <div style="height: 100%; overflow: auto; background: var(--ui-subtle)" data-scroller>
                {for i in range(1, 9) => <ExpandingRow key={i} id={`exprow-a${i}`} title={`Alarm ${i}`} subtitle="Weekdays" meta={`0${i}:30`} group="demo-alarms"
                                                       on_toggle={(on) => { note(`a${i}`, on) }}>
                    <p>Ring for {i * 5} minutes, then snooze.</p>
                    <p><Button size="lg" variant="soft" href="#expanding-row-sound">Change the sound</Button></p>
                    <div style="height: 120px; background: var(--ui-accent-soft); border-radius: 8px"></div>
                </ExpandingRow>}
                <ExpandingRow id="exprow-tall" title="A very long note" group="demo-alarms">
                    <div style="height: 900px; background: var(--ui-accent-soft)">Taller than the screen.</div>
                </ExpandingRow>
                <div style="height: 40px"></div>
            </div>
        </div>
        <p.demo-note data-log>{join(log, " ")}</p>
        <Button id="exprow-boss" size="lg" variant="outline" on_click={() => { boss = !boss }}>Open from outside</Button>
        <div>
            <ExpandingRow id="exprow-b1" title="Free one" meta="Own" open={boss}>Stays open by itself.</ExpandingRow>
            <ExpandingRow id="exprow-b2" title="Free two">Also on its own.</ExpandingRow>
            <ExpandingRow id="exprow-b3" title="Open at the start" open={true}>Open from the server.</ExpandingRow>
        </div>
    </div>
}

view ExpandingRowDemo() = <ExpandingRowDemoLive/>

ui_gallery = ui_gallery | push({ slug: "expanding_row", name: "ExpandingRow", group: "Mobile",
    summary: "A row that opens in place with content pushed down smoothly, keeps only one open if asked, and scrolls itself into view.",
    tags: ["mobile", "interactive", "tablet", "list", "accordion", "disclosure"],
    demo: ExpandingRowDemo })
