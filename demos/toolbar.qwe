view ToolbarDemo() =
    <div.demo-stack>
        <Toolbar label="Formatting">
            <ToolbarGroup label="History">
                <Button variant="ghost" tone="neutral" size="sm">Undo</Button>
                <Button variant="ghost" tone="neutral" size="sm">Redo</Button>
            </ToolbarGroup>
            <ToolbarSeparator/>
            <select aria-label="Text size">
                <option>Paragraph</option><option>Heading 1</option><option>Heading 2</option>
            </select>
            <ToolbarSeparator/>
            <ToggleButtonGroup label="Style" multiple={true} icon_only={true} variant="ghost" size="sm" attached={false}
                               options={[{ label: "Bold", value: "b", icon: "B" }, { label: "Italic", value: "i", icon: "I" },
                                         { label: "Underline", value: "u", icon: "U" }]}/>
            <ToolbarSeparator/>
            <ToggleButtonGroup label="Alignment" value="left" variant="ghost" size="sm" attached={false}
                               options={[{ label: "Left", value: "left" }, { label: "Center", value: "center" },
                                         { label: "Right", value: "right" }]}/>
            <ToolbarSpacer/>
            <Button size="sm">Publish</Button>
        </Toolbar>
        <p.demo-note>Tab reaches the toolbar once; the arrow keys, Home and End move inside it. Narrow, it wraps:</p>
        <div style="width: min(300px, 100%)">
            <Toolbar label="Selected rows">
                <Button variant="ghost" tone="neutral" size="sm">Archive</Button>
                <Button variant="ghost" tone="neutral" size="sm">Move</Button>
                <Button variant="ghost" tone="neutral" size="sm">Label</Button>
                <ToolbarSeparator/>
                <Button variant="ghost" tone="danger" size="sm">Delete</Button>
                <Button variant="ghost" tone="neutral" size="sm" disabled={true}>Merge</Button>
            </Toolbar>
        </div>
        <Toolbar label="Drawing tools" vertical={true}>
            <ToggleButtonGroup label="Tool" value="select" variant="ghost" size="sm" attached={false}
                               options={["Select", "Pen", "Text"] | map((t) => { label: t, value: lower(t) })}/>
            <ToolbarSeparator/>
            <Button variant="ghost" tone="neutral" size="sm">Clear</Button>
        </Toolbar>
    </div>

ui_gallery = ui_gallery | push({ slug: "toolbar", name: "Toolbar", group: "Layout",
    summary: "A row of controls reached by Tab once and moved through with the arrow keys; it wraps when narrow.",
    demo: ToolbarDemo })
