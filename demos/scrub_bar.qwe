// Fourteen silent seconds, small enough to sit in the page.
let scrub_bar_demo_src = "data:audio/mp4;base64,"

component ScrubBarDemoLive() {
    state time = 754
    state seeks = 0
    state preview = "none"
    <div.demo-stack>
        <ScrubBar value={time} duration={3725} buffered={[[0, 1200], [2000, 2400]]} label="Episode position"
                  on_scrub={(t) => { preview = scrub_bar_clock(t) }}
                  on_seek={(t) => { time = t; seeks += 1 }}/>
        <p.demo-note id="scrub-demo-note">At {scrub_bar_clock(time)}, {seeks} seeks, last preview {preview}</p>
        <Button id="scrub-demo-tick" size="lg" variant="ghost" on_click={() => { time += 5 }}>Five seconds on</Button>
        <audio id="scrub-demo-audio" src={scrub_bar_demo_src} preload="auto"></audio>
        <div id="scrub-demo-media"><ScrubBar media="scrub-demo-audio" label="Silent track" step={2}/></div>
        <div id="scrub-demo-bad"><ScrubBar value="soon" duration={null} label="Nothing yet"/></div>
        <p.demo-note>Drag along the bar, then move your finger up: the higher it goes, the finer the movement.</p>
    </div>
}

view ScrubBarDemo() = <ScrubBarDemoLive/>

ui_gallery = ui_gallery | push({ slug: "scrub_bar", name: "ScrubBar", group: "Mobile",
    summary: "A seek bar with a large touch area, fine scrubbing by moving a finger away from it, and a time bubble.",
    tags: ["mobile", "interactive", "media", "seek", "audio", "video"],
    demo: ScrubBarDemo })
