component PatronageRefundCalcDemoLive() {
    state net = null
    <div.demo-stack>
        <PatronageRefundCalc id="patronage-refund-calc-demo-store" title="Consumer store refund" name="store" basis="purchases" share_capital={500}
                             dividend_rate={4} patronage="3250.40" refund_rate={3} tax_rate={10}
                             on_change={(f) => { net = f.net }}/>
        <p.demo-note>{net == null ? "Change a figure to see on_change." : `on_change: the net is ${net}.`}</p>
    </div>
}

view PatronageRefundCalcDemo() =
    <div.demo-stack>
        <PatronageRefundCalc id="patronage-refund-calc-demo" currency="PHP" share_capital={18000} dividend_rate={6.5}
                             patronage={24500} refund_rate={12}/>
        <PatronageRefundCalcDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "patronage_refund_calc", name: "PatronageRefundCalc", group: "Finance",
    summary: "Works out a co-op member's dividend on shares and patronage refund on interest paid or purchases, to the total, as they type.",
    tags: ["finance", "coop", "calculator", "forms", "interactive"], demo: PatronageRefundCalcDemo })
