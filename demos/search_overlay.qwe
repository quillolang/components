let search_overlay_demo_docs = [
    { title: "Getting started", text: "Install Quillo and run your first program.", href: "#search_overlay", group: "Guides" },
    { title: "Components", text: "Views and components, state and events.", group: "Guides" },
    { title: "Live data", text: "State that follows the server as it changes.", group: "Guides" },
    { title: "Button", text: "A button, or a link that looks like one.", group: "Components" },
    { title: "Modal", text: "A dialog over the page.", group: "Components" },
    { title: "Search overlay", text: "This one: a full-screen search.", group: "Components" },
    { title: "Ada Lovelace", text: "Engineering, London.", group: "People" },
    { title: "Grace Hopper", text: "Compilers, New York.", group: "People" },
]

// A search on the server, slowed a little so that "Searching…" shows.
server fn search_overlay_demo_find(text: str) -> list with time {
    sleep(200)
    search_overlay_filter(search_overlay_demo_docs, text)
}

component SearchOverlayDemoLive() {
    state picked = null
    <div.demo-row>
        <SearchOverlay id="search-demo" trigger="Search the docs" on_search={(t) => search_overlay_demo_find(t)}
                       on_select={(r) => { picked = r.title }}/>
        <span.demo-note>{picked == null ? "Nothing opened yet." : `Opened ${picked}.`}</span>
    </div>
}

view SearchOverlayDemo() =
    <div.demo-stack>
        <SearchOverlayDemoLive/>
        <div.demo-row>
            <SearchOverlay id="search-demo-local" trigger="Search people" shortcut={false} placeholder="Name or city"
                           items={search_overlay_demo_docs | filter((d) => d.group == "People")}/>
        </div>
        <p.demo-note>Press / anywhere on the page to open the first.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "search_overlay", name: "SearchOverlay", group: "Overlays",
    summary: "A full-screen search with results as one types, grouped and marked, from a list or a server, opened with /.",
    tags: ["search", "overlay", "dialog", "keyboard", "interactive"],
    demo: SearchOverlayDemo })
