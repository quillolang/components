view TreemapDemo() =
    <div.demo-stack>
        <Treemap label="Disk use" show_label={true} suffix=" GB" aspect={2.4}
                 items={[{ label: "Photos", value: 182 }, { label: "Videos", value: 121 }, { label: "Apps", value: 64 },
                         { label: "Music", value: 38 }, { label: "Documents", value: 21 }, { label: "Mail", value: 9 },
                         { label: "Downloads", value: 6 }, { label: "Other", value: 3 }]}/>
        <Treemap label="Sales by product" show_label={true} prefix="$" aspect={1.8}
                 items={[{ label: "Chairs", value: 18400, group: "Furniture" }, { label: "Desks", value: 14200, group: "Furniture" },
                         { label: "Shelves", value: 6900, group: "Furniture" }, { label: "Sofas", value: 4100, group: "Furniture" },
                         { label: "Laptops", value: 21800, group: "Electronics" }, { label: "Monitors", value: 9600, group: "Electronics" },
                         { label: "Keyboards", value: 3100, group: "Electronics" }, { label: "Cables", value: 900, group: "Electronics" },
                         { label: "Lamps", value: 6100, group: "Lighting" }, { label: "Bulbs", value: 1700, group: "Lighting" },
                         { label: "Paper", value: 2400, group: "Office" }, { label: "Pens", value: 800, group: "Office" },
                         { label: "Notebooks", value: 1500, group: "Office" }]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "treemap", name: "Treemap", group: "Charts",
    summary: "Parts of a whole as rectangles sized by value, squarified, optionally in groups of their own colour, with each value and share on hover.",
    tags: ["chart", "data", "no-js"],
    demo: TreemapDemo })
