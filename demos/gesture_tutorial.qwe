let gesture_tutorial_demo_kinds = ["swipe-left", "swipe-right", "swipe-up", "swipe-down", "tap", "double-tap", "long-press", "pinch"]

let gesture_tutorial_demo_css = css`
.demo-tut-spot { display: grid; place-items: center; height: 170px; border: 1px dashed var(--ui-border); border-radius: var(--ui-radius-sm); background: var(--ui-subtle); color: var(--ui-muted); touch-action: none; }
.demo-tut-picks { display: flex; flex-wrap: wrap; gap: 6px; }
.demo-tut-pick { min-height: 44px; min-width: 44px; padding: 0 10px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius-sm); background: var(--ui-surface); color: var(--ui-fg); font: 14px var(--ui-font); }
.demo-tut-pick[aria-pressed="true"] { border-color: var(--ui-accent); color: var(--ui-accent); }
.demo-tut-scroll { height: 170px; overflow-y: auto; border: 1px dashed var(--ui-border); border-radius: var(--ui-radius-sm); }
.demo-tut-scroll p { margin: 0; padding: 40px 16px; }
`

component GestureTutorialDemoLive() {
    style global gesture_tutorial_demo_css
    state kind = "swipe-left"
    state said = "Not done yet."
    state again = 0
    <div.demo-stack>
        <div.demo-tut-picks role="group" aria-label="Gesture">
            {for k in gesture_tutorial_demo_kinds => <button.demo-tut-pick key={k} type="button" aria-pressed={k == kind ? "true" : "false"} @click={() => { kind = k }}>{k}</button>}
        </div>
        {for k in [kind] => <GestureTutorial key={k} gesture={k} name={`demo-${k}`} replay={again} target=".demo-tut-spot"
                on_done={(how) => { said = `${k}: ${how}` }}>
            {k == "swipe-up" || k == "swipe-down"
                ? <div.demo-tut-scroll><div.demo-tut-spot style="touch-action: pan-y; height: 600px">A list that scrolls</div></div>
                : <div.demo-tut-spot>The real thing</div>}
            <p.demo-note id="gesture-tut-outside">Outside the spot.</p>
        </GestureTutorial>}
        <p.demo-note id="gesture-tut-said">{said}</p>
        <button.demo-tut-pick id="gesture-tut-again" type="button" @click={() => { again += 1 }}>Show it again</button>
        // Bad data, for the test to look at: nothing here should stop the page.
        <div id="gesture-tut-bad" hidden="true"><GestureTutorial gesture="wiggle" name="demo-wiggle">Real</GestureTutorial></div>
    </div>
}

view GestureTutorialDemo() = <GestureTutorialDemoLive/>

ui_gallery = ui_gallery | push({ slug: "gesture_tutorial", name: "GestureTutorial", group: "Mobile",
    summary: "Teaches a gesture with a looping hand over the real thing, checks it was done there, then does not come back.",
    tags: ["mobile", "interactive", "gesture", "onboarding", "tutorial"],
    demo: GestureTutorialDemo })
