let markup_overlay_demo_plan = "data:image/svg+xml," + url_encode(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 750"><rect width="1000" height="750" fill="#f4f1ea"/><rect x="120" y="120" width="760" height="510" fill="#fff" stroke="#55606e" stroke-width="10"/><path d="M120 400H520V120M520 400V630" fill="none" stroke="#55606e" stroke-width="6"/><text x="220" y="280" font-size="30" fill="#55606e">Kitchen</text><text x="620" y="280" font-size="30" fill="#55606e">Living room</text><text x="220" y="530" font-size="30" fill="#55606e">Bathroom</text></svg>`)

let markup_overlay_demo_marks = [
    { kind: "arrow", color: "#c62a2f", points: [[700, 80], [640, 240]] },
    { kind: "text", color: "#0b6bcb", points: [[560, 66]], text: "Move this socket" },
]

component MarkupOverlayDemoLive() {
    state note = "2 marks."
    <div.demo-stack>
        <div.demo-tablet>
            <MarkupOverlay src={markup_overlay_demo_plan} alt="A plan of a small flat" marks={markup_overlay_demo_marks} name="markup-demo" label="Flat plan"
                           on_change={(m) => { note = `${len(m)} marks.` }}/>
        </div>
        <p.demo-note id="markup-overlay-note">{note}</p>
        <div id="markup-overlay-bad" hidden="true"><MarkupOverlay name="markup-bad" page={true} marks={[null, { kind: "pen", points: [] }, { kind: "ghost", points: [[1, 2]] }, { kind: "arrow", points: [[1, 2]] }, { kind: "text", points: [[1, 2]], text: " " }, { kind: "pen", points: [[1, "x"]] }, { kind: "text", color: 3, points: [[10, 20]], text: "<b>ok</b>" }]}><p id="markup-overlay-page">A page of text.</p></MarkupOverlay></div>
    </div>
}

view MarkupOverlayDemo() = <MarkupOverlayDemoLive/>

ui_gallery = ui_gallery | push({ slug: "markup_overlay", name: "MarkupOverlay", group: "Mobile",
    summary: "Annotate an image or a page with pen, highlighter, text and arrows, with undo, kept as data apart from it.",
    tags: ["mobile", "tablet", "interactive", "pen", "annotate", "markup"],
    demo: MarkupOverlayDemo })
