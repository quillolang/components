component InvoiceBuilderDemoLive() {
    state note = "Save to see on_save."
    <div.demo-stack>
        <InvoiceBuilder id="invoice-builder-demo-live" name="next" today="2026-11-01" number="INV-0099" used={["INV-0100"]} bill_to="Northwind" title="Prices with tax" terms="eom"
                        currency="EUR" tax_inclusive={true} tax_rate={21} on_save={(i) => { note = `on_save: ${i.number}, ${len(i.lines)} lines, total ${i.total}, tax ${i.tax}, due ${i.due}.` }}
                        lines={[{ description: "Consulting", quantity: 2, unit_price: "121.00", tax_rate: 21 }]}/>
        <p.demo-note>{note}</p>
    </div>
}

view InvoiceBuilderDemo() =
    <div.demo-stack>
        <InvoiceBuilder id="invoice-builder-demo" today="2026-11-01" number="INV-0042" bill_to="Acme Ltd" discount="5%"
                        lines={[{ description: "Design work", quantity: 12.5, unit_price: "80.00", discount: "10%", tax_rate: 20 },
                                { description: "Hosting", quantity: 1, unit_price: "49.99", tax_rate: 20 },
                                { description: "Handbooks", quantity: 3, unit_price: "19.99", discount: "5.00", tax_rate: 5 }]}/>
        <InvoiceBuilderDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "invoice_builder", name: "InvoiceBuilder", group: "Finance",
    summary: "Builds an invoice with line and order discounts, inclusive or exclusive tax, due dates by terms, a tax summary by rate and totals that reconcile.",
    tags: ["smart", "interactive", "finance", "invoice", "tax", "billing"], demo: InvoiceBuilderDemo })
