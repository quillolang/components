view TextDemo() =
    <div.demo-stack>
        <div>
            <Text id="text-demo-plain">Quillo renders a page on the server and resumes its components in the browser, so it shows at once and reacts as soon as it is touched.</Text>
            <Text size="sm" tone="muted" id="text-demo-muted">Last edited 2 hours ago by Ada.</Text>
        </div>
        <div.demo-row>
            <Text tag="span" size="xs">Extra small</Text>
            <Text tag="span" size="sm">Small</Text>
            <Text tag="span">Medium</Text>
            <Text tag="span" size="lg">Large</Text>
            <Text tag="span" size="xl">Extra large</Text>
        </div>
        <div.demo-row>
            <Text tag="span" weight="normal">Normal</Text>
            <Text tag="span" weight="medium">Medium</Text>
            <Text tag="span" weight="semibold">Semibold</Text>
            <Text tag="span" weight="bold" id="text-demo-bold">Bold</Text>
            <Text tag="span" italic={true}>Italic</Text>
            <Text tag="span" mono={true} id="text-demo-mono">mono: 0x1F</Text>
        </div>
        <div.demo-row>
            <Text tag="span" tone="accent">Accent</Text>
            <Text tag="span" tone="success">Success</Text>
            <Text tag="span" tone="warning">Warning</Text>
            <Text tag="span" tone="danger" weight="semibold">3 failed</Text>
            <Text tag="span" tone="info">Info</Text>
        </div>
        <Text align="center" size="lg" tone="muted" id="text-demo-center">Nothing here yet.</Text>
    </div>

ui_gallery = ui_gallery | push({ slug: "text", name: "Text", group: "Typography",
    summary: "A paragraph or span in the kit's sizes, weights, tones and alignments, so prose matches the components.",
    tags: ["typography", "text", "no-js"],
    demo: TextDemo })
