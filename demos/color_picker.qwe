component ColorPickerDemoLive() {
    state c = "#12a594"
    <div.demo-stack>
        <ColorPicker name="cp-demo-accent" label="Accent" value="#12a594" on_change={(hex) => { c = hex }}/>
        <p.demo-note>Buttons will be <span style={`color: ${c}; font-weight: 600`}>{c}</span>.</p>
    </div>
}

view ColorPickerDemo() =
    <div.demo-stack>
        <div.demo-row>
            <ColorPicker name="cp-demo-brand" label="Brand colour" value="#5b4bdb" required={true}
                         hint="Hex, such as #1e90ff or #19f."/>
            <ColorPickerDemoLive/>
        </div>
        <div.demo-row>
            <ColorPicker name="cp-demo-label" label="Label colour" area={false} value="#e5484d" size="sm"
                         swatches={[{ label: "Red", value: "#e5484d" }, { label: "Orange", value: "#f76b15" },
                                    { label: "Green", value: "#46a758" }, { label: "Blue", value: "#0b6bcb" },
                                    { label: "Purple", value: "#8e4ec6" }, { label: "Grey", value: "#8d8d8d" }]}/>
            <ColorPicker name="cp-demo-bad" label="Text colour" value="#ffffff" size="sm"
                         error="White text on a white page cannot be read."/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "color_picker", name: "ColorPicker", group: "Forms",
    summary: "A colour as hex, or picked from a square, a hue slider and swatches; it says when hex is wrong.",
    tags: ["forms", "picker", "interactive"],
    demo: ColorPickerDemo })
