let how_it_works_demo_steps = [
    { title: "Install", text: "One binary for your machine; nothing else to set up." },
    { title: "Write a route", text: "A function that returns HTML. Views and components for the rest." },
    { title: "Run it", text: "quillo run app.qwe serves, watches and reloads." },
    { title: "Deploy", text: "Copy the binary and the file to a server. That is the pipeline." },
]

view HowItWorksDemo() =
    <div.demo-stack>
        <HowItWorks id="how-it-works-demo" title="How it works" text="From an empty folder to a page on the internet." steps={how_it_works_demo_steps}/>
        <HowItWorks direction="column" steps={[
            { title: "Pick a plan", text: "Free for one project; teams pay per seat.", icon: "💳" },
            { title: "Invite the team", text: "Everyone gets the same file; Git keeps the history.", icon: "👋" },
            { title: "Ship", text: "A green check and it is live.", icon: <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg> },
        ]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "how_it_works", name: "HowItWorks", group: "Marketing",
    summary: "Numbered steps with icons, titles and text, in a row joined by a line, or down a column.",
    tags: ["marketing", "section", "list", "progress", "no-js"],
    demo: HowItWorksDemo })
