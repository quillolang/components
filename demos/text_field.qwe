component TextFieldDemoLive() {
    state handle = "ada"
    <div.demo-stack>
        <TextField name="handle" label="Username" prefix="@" value={handle} maxlength={20}
                   on_input={(v) => { handle = v }}/>
        <p.demo-note>Your page will be quillolang.org/{handle != "" ? handle : "…"}</p>
    </div>
}

view TextFieldDemo() =
    <div.demo-stack.demo-narrow>
        <TextField name="email" label="Email" type="email" placeholder="you@example.com" required={true}
                   autocomplete="email" hint="We never share it."/>
        <TextField name="site" label="Website" type="url" prefix="https://" value="quillolang"
                   error="That is not a full address: add .org or .com."/>
        <TextFieldDemoLive/>
        <div.demo-row>
            <TextField name="weight" label="Weight" type="number" suffix="kg" min={0} max={500} size="sm"/>
            <TextField name="born" label="Born" type="date" size="sm"/>
        </div>
        <TextField name="plan" label="Plan" value="Team (12 seats)" disabled={true}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "text_field", name: "TextField", group: "Forms",
    summary: "A labelled input with help text, an error message and short text before or after it.",
    tags: ["forms", "input", "text", "no-js"],
    demo: TextFieldDemo })
