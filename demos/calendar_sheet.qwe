let calendar_sheet_demo_items = [
    { id: 1, date: "2026-11-04", time: "09:30", title: "Dentist", where: "Rua Augusta 12", tone: "danger" },
    { id: 2, date: "2026-11-04", title: "Ana's birthday", tone: "success" },
    { id: 3, date: "2026-11-04", time: "13:00", title: "Lunch with Ana" },
    { id: 4, date: "2026-11-06", time: "18:00", title: "Pick up keys", tone: "warning" },
    { id: 5, date: "2026-11-12", time: "07:15", title: "Flight to Lisbon", where: "Gate B22", tone: "info" },
    { id: 6, date: "2026-12-04", title: "Rent", tone: "warning" },
]

component CalendarSheetDemoLive() {
    state log = ""
    <div.demo-stack>
        <div.demo-phone id="calendar-sheet-screen">
            <CalendarSheet today="2026-11-04" items={calendar_sheet_demo_items}
                           on_pick={(d) => { log = `pick ${d}` }} on_open={(m) => { log = `open ${m.id}` }} on_fold={(f) => { log = `fold ${f}` }}/>
        </div>
        <p.demo-note id="calendar-sheet-log">{log}</p>
        // Sunday first, starting folded, and bad data, for the test to look at.
        <div id="calendar-sheet-more" hidden="true"><CalendarSheet today="2026-02-10" week_start={7} folded={true} items={[null, 7, { date: "2026-02-30", title: "No" }, { date: "2026-02-10" }, { date: "2026-02-10", title: "Yes", time: "25:99" }]}/><CalendarSheet today="what" items="none" week_start={0}/></div>
    </div>
}

view CalendarSheetDemo() = <div.demo-stack><CalendarSheetDemoLive/></div>

ui_gallery = ui_gallery | push({ slug: "calendar_sheet", name: "CalendarSheet", group: "Mobile",
    summary: "A month on a sheet that folds to a week by drag, with the day's agenda under it.",
    tags: ["mobile", "interactive", "gesture", "calendar", "agenda", "tablet"],
    demo: CalendarSheetDemo })
