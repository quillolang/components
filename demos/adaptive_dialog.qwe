let adaptive_dialog_demo_css = css`
.adaptive-dialog-demo-field { box-sizing: border-box; display: block; width: 100%; height: 46px; margin: 6px 0 12px; padding: 0 12px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius-sm); background: var(--ui-surface); color: var(--ui-fg); font: 16px var(--ui-font); }
`

component AdaptiveDialogDemoLive() {
    style global adaptive_dialog_demo_css
    state asking = false
    state saved = "Morning run"
    state draft = "Morning run"
    state closes = 0
    state dialog_width = 520
    <div.demo-stack>
        <div.demo-row>
            <Button size="lg" variant="outline" on_click={() => { asking = true; draft = saved }}>Rename the route</Button>
            <AdaptiveDialog title="About routes" trigger="Read more" width={dialog_width}>
                <p>A route keeps its distance, its climbs and every run you made on it.</p>
                <p>On a phone this is a sheet you can drag away. Turn a tablet or make the window wider and it becomes a dialog, keeping its place.</p>
            </AdaptiveDialog>
            <Button size="lg" variant="ghost" on_click={() => { dialog_width = dialog_width == 520 ? 460 : 520 }}>Change the width</Button>
        </div>
        <AdaptiveDialog title="Rename the route" open={asking} width={dialog_width}
                        footer={<div.demo-row>
                            <Button size="lg" variant="ghost" on_click={() => { asking = false }}>Cancel</Button>
                            <Button size="lg" on_click={() => { saved = draft; asking = false }}>Save</Button>
                        </div>}
                        on_close={() => { asking = false; closes += 1 }}>
            <label.demo-note for="adaptive-dialog-name">Name</label>
            <input.adaptive-dialog-demo-field id="adaptive-dialog-name" bind:value={draft}/>
            <p.demo-note>Everyone you share this route with sees the new name.</p>
        </AdaptiveDialog>
        <p.demo-note>Route: <span class="adaptive-dialog-demo-saved">{saved}</span>. Closed: <span class="adaptive-dialog-demo-closes">{closes}</span>.</p>
    </div>
}

view AdaptiveDialogDemo() = <AdaptiveDialogDemoLive/>

ui_gallery = ui_gallery | push({ slug: "adaptive_dialog", name: "AdaptiveDialog", group: "Mobile",
    summary: "A sheet on a phone and a centred dialog on a tablet or desktop: the same content, chosen by width, changing live on rotation.",
    tags: ["mobile", "interactive", "tablet", "dialog", "sheet", "responsive"],
    needs: ["button", "bottom_sheet"], demo: AdaptiveDialogDemo })
