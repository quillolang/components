component WheelPickerDemoLive() {
    state size = "M"
    state seat = "14c"
    <div.demo-stack>
        <div class="demo-row wheel-picker-demo-row">
            <WheelPicker label="Size" shown={true} value={size} field="wheel-picker-demo-size" options={["XXS", "XS", "S", "M", "L", "XL", "XXL", "3XL", "4XL"]}
                         on_change={(v) => { size = v }}/>
            <WheelPicker label="Seat" shown={true} rows={3} value={seat} field="wheel-picker-demo-seat"
                         options={[{ value: "14a", label: "14A window" }, { value: "14b", label: "14B taken", disabled: true },
                                   { value: "14c", label: "14C aisle" }, { value: "14d", label: "14D aisle" },
                                   { value: "14e", label: "14E taken", disabled: true }, { value: "14f", label: "14F window" }]}
                         on_change={(v) => { seat = v }}/>
        </div>
        <p.demo-note id="wheel-picker-demo-out">Size {size}, seat {seat}. Flick a wheel, tap a row, or Tab to one and use the arrow keys.</p>
        <div.demo-row>
            <Button size="lg" variant="outline" id="wheel-picker-demo-set" on_click={() => { size = "XL" }}>Make it XL</Button>
        </div>
    </div>
}

let wheel_picker_demo_css = css`
.wheel-picker-demo-row > * { flex: 1 1 140px; }
`

view WheelPickerDemo() =
    <div.demo-stack>
        <style>{wheel_picker_demo_css}</style>
        <WheelPickerDemoLive/>
        <form id="wheel-picker-demo-form" method="get" action="#" class="demo-narrow">
            <WheelPicker label="Delivery" name="slot" value="Tuesday" rows={3} options={["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"]}/>
        </form>
        <div class="demo-narrow" id="wheel-picker-demo-odd">
            <p.demo-note>Nothing to choose, a value that is not there, and a wheel that is off:</p>
            <WheelPicker label="Nothing" rows={3}/>
            <WheelPicker label="Lost" rows={3} value="Z" options={[{ value: "A", disabled: true }, "B", "C"]}/>
            <WheelPicker label="Off" rows={3} value="C" disabled={true} options={["A", "B", "C"]}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "wheel_picker", name: "WheelPicker", group: "Mobile",
    summary: "A drum wheel of options scrolled by finger, with the system's momentum, snapping on a row, and a real select underneath.",
    tags: ["mobile", "interactive", "picker", "wheel", "select", "forms"],
    demo: WheelPickerDemo })
