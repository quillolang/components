component ReactionsDemoLive() {
    state last = null
    <div.demo-stack>
        <Reactions id="reactions-demo-live" name="reactions"
                   reactions={[{ emoji: "👍", count: 12, mine: true, label: "thumbs up" }, { emoji: "❤️", count: 3, label: "heart" }, { emoji: "🎉", count: 1, label: "party" }]}
                   on_change={(emoji, on) => { last = `${emoji} ${on ? "on" : "off"}` }}/>
        <p.demo-note>{last == null ? "Press a chip, or add one." : `Last: ${last}.`}</p>
    </div>
}

view ReactionsDemo() =
    <div.demo-stack>
        <ReactionsDemoLive/>
        <div.demo-row>
            <Reactions id="reactions-demo-sm" size="sm" reactions={[{ emoji: "😂", count: 5 }, { emoji: "😮", count: 2 }]}/>
            <Reactions id="reactions-demo-empty" reactions={[]} choices={["🚀", "👀", "💯"]} add_label="React"/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "reactions", name: "Reactions", group: "Social",
    summary: "Emoji reaction chips with counts, yours marked, and an add button that opens a row of emoji to pick from.",
    tags: ["social", "button", "forms", "interactive"], demo: ReactionsDemo })
