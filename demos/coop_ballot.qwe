view CoopBallotDemo() =
    <CoopBallot id="coop-ballot-demo" action="#coop-ballot" title="Board of Directors" seats={3} hidden={{ election: "board-2026" }}
                closes="Voting closes March 14, 2026 at 5:00 PM, at the General Assembly."
                candidates={[
                    { id: "c-101", name: "Lourdes Villanueva", note: "Incumbent, Treasurer", statement: "Twelve years a member. I kept loan delinquency under 3% and want an online loan window for members abroad." },
                    { id: "c-102", name: "Ramon Esguerra", note: "Nominated by the Teachers' chapter", statement: "A public school teacher for 20 years. Salary deduction should be faster and cheaper for every school." },
                    { id: "c-103", name: "Grace Tan-Molina", statement: "Accountant. I will publish the monthly financial statements to every member, in plain words." },
                    { id: "c-104", name: "Benjie Dalisay", note: "Incumbent", statement: "Farmer and rice trader. More production loans at planting time, paid back at harvest." },
                    { id: "c-105", name: "Marites Abad", statement: "Runs the co-op store in Barangay San Isidro. Patronage refunds for store members too." },
                ]}/>

ui_gallery = ui_gallery | push({ slug: "coop_ballot", name: "CoopBallot", group: "Finance",
    summary: "A board election ballot: candidates as cards with a short statement, up to N ticked and no more, sent as a plain form post.",
    tags: ["finance", "coop", "forms", "vote", "interactive"], demo: CoopBallotDemo })
