component ClapButtonDemoLive() {
    state note = "No claps from you yet."
    <div.demo-row style="gap: 20px">
        <ClapButton count={1204} limit={5} on_change={(n) => { note = n == 0 ? "You took your claps back." : `You gave ${n} of 5.` }}/>
        <p.demo-note id="clap-button-demo-note">{note}</p>
    </div>
}

view ClapButtonDemo() =
    <div.demo-stack style="padding-top: 34px">
        <ClapButtonDemoLive/>
        <form id="clap-button-demo-form" class="demo-row" style="gap: 28px" action="#clap_button">
            <ClapButton count={48210} mine={50} name="claps" size="lg"/>
            <ClapButton count={7} mine={2} size="sm" undo={false}/>
            <ClapButton count={0} show_count={false} label="Applaud this post"/>
        </form>
    </div>

ui_gallery = ui_gallery | push({ slug: "clap_button", name: "ClapButton", group: "Blogging",
    summary: "Applause for a post: each press adds a clap up to a limit per reader, a +3 rises for presses in a row, and a small × takes them back.",
    tags: ["blogging", "social", "button", "reactions", "interactive"], demo: ClapButtonDemo })
