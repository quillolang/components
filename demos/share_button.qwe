component ShareButtonDemoLive() {
    state how = null
    <div.demo-row>
        <ShareButton url="https://quillolang.org/components/" title="Quillo UI" text="A UI kit for Quillo." on_share={(h) => { how = h }}/>
        <span.demo-note>{how == null ? "Not shared yet." : `Last: ${how}.`}</span>
    </div>
}

view ShareButtonDemo() =
    <div.demo-stack>
        <ShareButtonDemoLive/>
        <div.demo-row>
            <ShareButton label="Share this page" variant="soft" size="sm"/>
            <ShareButton label="Share" variant="solid" url="https://quillolang.org/"/>
            <ShareButton label="Share" variant="ghost" size="lg" url="https://quillolang.org/docs/"/>
        </div>
        <p.demo-note>On a phone or a Mac this opens the system's share sheet; elsewhere it copies the link.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "share_button", name: "ShareButton", group: "Actions",
    summary: "Shares a link through the system's share sheet, or copies it where the browser has none, and says which.",
    tags: ["button", "forms", "social", "interactive"],
    demo: ShareButtonDemo })
