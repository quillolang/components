let filter_chips_bar_demo_places = [
    { name: "Harbour Cafe", tags: ["open", "wifi", "outdoor"] },
    { name: "The Long Table", tags: ["open", "vegan", "booking"] },
    { name: "Noodle Bar", tags: ["open", "cheap"] },
    { name: "Fig and Olive", tags: ["vegan", "outdoor", "booking", "wifi"] },
    { name: "Station Diner", tags: ["open", "cheap", "dogs"] },
    { name: "Corner Bakery", tags: ["wifi", "cheap"] },
    { name: "Rooftop 12", tags: ["outdoor", "booking", "late"] },
    { name: "Night Owl", tags: ["open", "late", "dogs"] }
]

let filter_chips_bar_demo_chips = [
    { id: "open", label: "Open now" }, { id: "wifi", label: "Wi-Fi" }, { id: "outdoor", label: "Outdoor seating" },
    { id: "vegan", label: "Vegan" }, { id: "cheap", label: "Under 15" }, { id: "booking", label: "Takes bookings" },
    { id: "dogs", label: "Dogs welcome" }, { id: "late", label: "Open late" }, { id: "kids", label: "Kids' menu", n: 0 }
]

fn filter_chips_bar_demo_find(wanted: list) -> list =
    filter_chips_bar_demo_places | filter((p) => all(wanted, (w) => contains(p.tags, w)))

component FilterChipsBarDemoLive() {
    state wanted = []
    state picked = "All"
    state cleared = 0
    let found = filter_chips_bar_demo_find(wanted)
    <div.demo-stack>
        <div.demo-phone data-frame>
            <div style="height: 100%; overflow: auto" data-scroller>
                <header data-head style="position: sticky; top: 0; z-index: 6; height: 56px; display: flex; align-items: center; padding: 0 16px; background: var(--ui-bg); font-weight: 600">Places near you</header>
                <FilterChipsBar chips={filter_chips_bar_demo_chips} results={len(found)} noun="place" top="56px"
                                on_change={(ids) => { wanted = ids }} on_clear={() => { cleared += 1 }}/>
                {for p in found => <p key={p.name} data-place style="margin: 0; padding: 18px 16px; border-bottom: 1px solid var(--ui-border)">{p.name}</p>}
                <div style="height: 900px"></div>
            </div>
        </div>
        <p.demo-note>On: <b data-wanted>{join(wanted, ",")}</b>, cleared <b data-cleared>{cleared}</b> times</p>
        <FilterChipsBar id="filter-chips-one" multi={false} active={["Week"]} label="Period" chips={["Day", "Week", "Month", "Year"]}
                        on_change={(ids) => { picked = ids[0] ?? "All" }}/>
        <p.demo-note>Period: <b data-picked>{picked}</b></p>
        <FilterChipsBar id="filter-chips-bad" chips={[null, { label: "" }, "Plain", { id: 7, label: "Seven", n: 3 }, { id: 7, label: "Twin" }, { id: "x", label: "Off", disabled: true }]}
                        results="many" active={["gone", 7]}/>
    </div>
}

view FilterChipsBarDemo() = <FilterChipsBarDemoLive/>

ui_gallery = ui_gallery | push({ slug: "filter_chips_bar", name: "FilterChipsBar", group: "Mobile",
    summary: "A sideways scroller of filter chips staying under the header, the active chip kept in view, a count of results, and clear.",
    tags: ["mobile", "interactive", "tablet", "filter", "chips", "search"],
    demo: FilterChipsBarDemo })
