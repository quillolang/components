let fullscreen_picker_demo_cities = [
    { label: "Aarhus", value: "AAR", hint: "Denmark" }, { label: "Bogotá", value: "BOG", hint: "Colombia" }, { label: "Bordeaux", value: "BOD", hint: "France" },
    { label: "Cairo", value: "CAI", hint: "Egypt" }, { label: "Cape Town", value: "CPT", hint: "South Africa" }, { label: "Córdoba", value: "COR", hint: "Argentina" },
    { label: "Dublin", value: "DUB", hint: "Ireland" }, { label: "Gdańsk", value: "GDN", hint: "Poland" }, { label: "Hanoi", value: "HAN", hint: "Vietnam" },
    { label: "Istanbul", value: "IST", hint: "Türkiye" }, { label: "Kraków", value: "KRK", hint: "Poland" }, { label: "Kyoto", value: "UKY", hint: "Japan" },
    { label: "Lisbon", value: "LIS", hint: "Portugal" }, { label: "Lyon", value: "LYS", hint: "France" }, { label: "Málaga", value: "AGP", hint: "Spain" },
    { label: "Marrakesh", value: "RAK", hint: "Morocco" }, { label: "Montréal", value: "YUL", hint: "Canada" }, { label: "Munich", value: "MUC", hint: "Germany" },
    { label: "New Delhi", value: "DEL", hint: "India" }, { label: "New Orleans", value: "MSY", hint: "United States" }, { label: "New York", value: "JFK", hint: "United States" },
    { label: "Nairobi", value: "NBO", hint: "Kenya" }, { label: "Oslo", value: "OSL", hint: "Norway" }, { label: "Paris", value: "CDG", hint: "France" },
    { label: "Porto", value: "OPO", hint: "Portugal" }, { label: "Quito", value: "UIO", hint: "Ecuador" }, { label: "Reykjavík", value: "KEF", hint: "Iceland" },
    { label: "Rio de Janeiro", value: "GIG", hint: "Brazil" }, { label: "São Paulo", value: "GRU", hint: "Brazil" }, { label: "Seoul", value: "ICN", hint: "South Korea" },
    { label: "Sydney", value: "SYD", hint: "Australia" }, { label: "Tokyo", value: "HND", hint: "Japan" }, { label: "Toronto", value: "YYZ", hint: "Canada" },
    { label: "Vancouver", value: "YVR", hint: "Canada" }, { label: "Wellington", value: "WLG", hint: "New Zealand", disabled: true }, { label: "Zürich", value: "ZRH", hint: "Switzerland" }]

component FullscreenPickerDemoLive() {
    state city = "none"
    state stops = "none"
    state cancelled = 0
    state asking = false
    <div.demo-stack>
        <div.demo-row>
            <FullscreenPicker id="city" title="Fly to" trigger="Fly to" items={fullscreen_picker_demo_cities} value="LIS"
                              placeholder="City or country" on_done={(v) => { city = str(v) }} on_cancel={() => { cancelled += 1 }}/>
            <FullscreenPicker id="stops" title="Stop over in" trigger="Stop over" multiple={true} value={["OSL"]} items={fullscreen_picker_demo_cities}
                              on_done={(vs) => { stops = join(vs, ",") }}/>
            <Button size="lg" variant="ghost" on_click={() => { asking = true }}>From state</Button>
        </div>
        <FullscreenPicker id="sizes" title="Size" items={["Small", "Medium", "Large"]} open={asking} limit={2}
                          on_done={(_v) => { asking = false }} on_cancel={() => { asking = false }}/>
        <p.demo-note>Flying to <span class="fullscreen-picker-demo-city">{city}</span>, stopping in <span class="fullscreen-picker-demo-stops">{stops}</span>. Cancelled <span class="fullscreen-picker-demo-cancelled">{cancelled}</span> times.</p>
    </div>
}

view FullscreenPickerDemo() = <FullscreenPickerDemoLive/>

ui_gallery = ui_gallery | push({ slug: "fullscreen_picker", name: "FullscreenPicker", group: "Mobile",
    summary: "A full-screen list to pick from, with search and a header with Done, that stays clear of the on-screen keyboard; on a tablet, a card.",
    tags: ["mobile", "interactive", "tablet", "picker", "search", "select"],
    needs: ["button", "bottom_sheet"], demo: FullscreenPickerDemo })
