let pie_chart_demo_grid = "display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 32px 40px"

view PieChartDemo() =
    <div.demo-stack>
        <div style={pie_chart_demo_grid}>
            <PieChart label="Traffic by source" show_label={true} parts={[
                { label: "Search", value: 4210 }, { label: "Direct", value: 2380 }, { label: "Social", value: 1120 },
                { label: "Email", value: 640 }, { label: "Referral", value: 310 }, { label: "Ads", value: 120 },
                { label: "Print", value: 45 }]}/>
            <PieChart label="Browsers" show_label={true} size={160} other_below={5} parts={[
                { label: "Chrome", value: 64.7 }, { label: "Safari", value: 18.6 }, { label: "Edge", value: 5.3 },
                { label: "Firefox", value: 2.9 }, { label: "Samsung", value: 2.3 }, { label: "Opera", value: 2.1 },
                { label: "UC Browser", value: 4.1 }]} suffix="%"/>
        </div>
        <PieChart label="Spending this month" show_label={true} labels={false} legend={true} prefix="$" decimals={2} size={150} parts={[
            { label: "Rent", value: 1850 }, { label: "Food", value: 612.4 }, { label: "Travel", value: 248.9 }, { label: "Fun", value: 175 }]}/>
        <p.demo-note>Slices under 3% (5% for browsers) are gathered into Other; the last pie has a legend instead of labels.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "pie_chart", name: "PieChart", group: "Charts",
    summary: "A pie with each slice named and its share beside it, small slices gathered into Other, and the slice under the pointer pulled out.",
    tags: ["chart", "data", "no-js"],
    demo: PieChartDemo })
