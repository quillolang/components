let spaced_repetition_demo_cards = [
    { id: "lune", front: "la lune", back: "the moon", ease: 2.5, interval: 6, reps: 2, due: "2026-11-02" },
    { id: "soleil", front: "le soleil", back: "the sun", ease: 1.3, interval: 10, reps: 3, due: "2026-10-30" },
    { id: "ciel", front: "le ciel", back: "the sky", ease: 2.6, interval: 16, reps: 3, due: "2026-11-20" },
    { id: "mer", front: "la mer", back: "the sea" }, { id: "vent", front: "le vent", back: "the wind" }, { id: "neige", front: "la neige", back: "the snow" }]

component SpacedRepetitionDemoLive() {
    state seen = null
    <div.demo-stack>
        <SpacedRepetition id="spaced-repetition-demo" today="2026-11-02" new_limit={2} review_limit={5} cards={spaced_repetition_demo_cards}
                          on_review={(c) => { seen = c }}/>
        <p.demo-note>{seen == null ? "Grade a card to see on_review." : `on_review: ${seen.id}, grade ${seen.grade}, ease ${str(seen.ease)}, due ${seen.due}.`}</p>
    </div>
}

view SpacedRepetitionDemo() =
    <div.demo-stack>
        <SpacedRepetitionDemoLive/>
        <SpacedRepetition id="spaced-repetition-demo-bad" title="Awkward data" today="2026-11-02" name="odd" review_limit={1} new_limit={0}
                          cards={[{ id: "a", front: "   " }, "not a card", { id: "b", front: "b", ease: "soft" }, { id: "c", front: "c", due: "2026-02-30" },
                                  { id: "d", front: "d", interval: -1 }, { id: "e", front: "Only this is fine", ease: 0.5, due: "2026-11-01", interval: 3, reps: 3 },
                                  { id: "e", front: "twin" }, { id: "f", front: "held back", due: "2026-11-02", interval: 3, reps: 3 }, { id: "g", front: "new, held" }]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "spaced_repetition", name: "SpacedRepetition", group: "Scheduling",
    summary: "Flashcards scheduled by SM-2: grade each answer, see the next due date, keep ease and interval as data, with today's queue under new and review limits.",
    tags: ["smart", "interactive", "flashcards", "learning", "memory", "study"], demo: SpacedRepetitionDemo })
