view YearCalendarDemo() =
    <div.demo-stack>
        <YearCalendar id="year-calendar-demo" year={2026} today="2026-10-28" href="#year_calendar-{day}"
                      marks={[{ day: "2026-01-01", tone: "danger", label: "New Year's Day" }, { day: "2026-04-03", tone: "danger", label: "Good Friday" },
                              { day: "2026-04-25", tone: "danger", label: "Freedom Day" }, { day: "2026-12-25", tone: "danger", label: "Christmas" },
                              { day: "2026-08-03", to: "2026-08-14", tone: "success", label: "Summer leave" },
                              { day: "2026-03-16", to: "2026-03-18", tone: "info", label: "Conference" },
                              { day: "2026-11-20", tone: "warning", label: "Release" }]}
                      legend={[{ tone: "danger", label: "Public holiday" }, { tone: "success", label: "Leave" },
                               { tone: "info", label: "Travel" }, { tone: "warning", label: "Deadline" }]}/>
        <div id="year-calendar-demo-sunday" style="max-width: 240px">
            <YearCalendar year={2027} week_start={7} label="2027, weeks from Sunday"/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "year_calendar", name: "YearCalendar", group: "Scheduling",
    summary: "A year as twelve small months, with dates and runs of dates marked in colours, today ringed, and a key.",
    tags: ["schedule", "calendar", "data", "no-js"], demo: YearCalendarDemo })
