let whats_new_sheet_demo_entries = [
    { version: "2.9.0", title: "Offline maps", text: "Keep a region on your phone.", art: "M9 4 3 6v14l6-2 6 2 6-2V4l-6 2zM9 4v14M15 6v14" },
    { version: "2.10.0", title: "Voice memos", text: "Keep a recording with any note.", art: "🎙" },
    { version: "2.10.1", title: "Faster search", text: "It finds a note as you type." },
    { version: "2.11.0", title: "Shared pages", text: "Send a page to anyone with a link.", art: "M4 12v7a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-7M16 7l-4-4-4 4M12 3v12" },
    { version: "9.0.0", title: "From the future", text: "Not out yet, so not shown." },
    { version: "nonsense", title: "Unreadable", text: "Left out." },
]

component WhatsNewSheetDemoLive() {
    state run = 0
    state version = "2.11.0"
    state said = "Nothing seen yet."
    state now = false
    <div.demo-stack>
        <p.demo-note>This version: {version}. The sheet comes up by itself once per version.</p>
        <WhatsNewSheet key={run} current={version} remember="ui-demo-whats-new" entries={whats_new_sheet_demo_entries} more="#changelog" limit={3}
                       on_seen={(v) => { said = `Saw ${v}.` }}/>
        <div.demo-row>
            <Button size="lg" variant="outline" id="whats-new-sheet-demo-old" on_click={() => {
                welcome_carousel_keep("ui-demo-whats-new", "2.9.5")
                run = run + 1
            }}>Last saw 2.9.5</Button>
            <Button size="lg" variant="outline" id="whats-new-sheet-demo-start" on_click={() => { run = run + 1 }}>Start the app again</Button>
        </div>
        <WhatsNewSheet id="whats-new-sheet-all" current="2.11.0" remember={null} entries={whats_new_sheet_demo_entries} trigger="What's new"/>
        <Button size="lg" variant="ghost" id="whats-new-sheet-demo-now" on_click={() => { now = true }}>Open from state</Button>
        {now && <WhatsNewSheet id="whats-new-sheet-now" open={true} current="2.11.0" remember="ui-demo-whats-new-2" entries={whats_new_sheet_demo_entries}
                               on_close={() => { now = false }}/>}
        <p.demo-note id="whats-new-sheet-demo-said">{said}</p>
    </div>
}

view WhatsNewSheetDemo() = <WhatsNewSheetDemoLive/>

ui_gallery = ui_gallery | push({ slug: "whats_new_sheet", name: "WhatsNewSheet", group: "Mobile",
    summary: "New features since the version a person last saw, from a list, shown once per version.",
    tags: ["mobile", "interactive", "tablet", "update", "version", "onboarding"],
    needs: ["force_update", "welcome_carousel"],
    demo: WhatsNewSheetDemo })
