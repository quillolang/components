component BirthdayInputDemoLive() {
    state born = null
    <div.demo-stack>
        <BirthdayInput name="dob_live" label="When were you born?" field="birthday-input-demo-live" min_age={18} today="2026-10-28"
                       on_change={(d) => { born = d }}/>
        <p.demo-note>{born == null ? "No date yet." : `Born on ${born}.`}</p>
    </div>
}

view BirthdayInputDemo() =
    <div.demo-stack>
        <BirthdayInput name="dob" label="Date of birth" value="1990-12-10" field="birthday-input-demo-plain" today="2026-10-28"
                       hint="The days follow the month and year." required={true}/>
        <BirthdayInputDemoLive/>
        <div.demo-row>
            <BirthdayInput name="dob_us" label="US order" order="mdy" size="sm" field="birthday-input-demo-mdy" today="2026-10-28"
                           years={30} error="Enter your date of birth."/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "birthday_input", name: "BirthdayInput", group: "Forms",
    summary: "Day, month and year drop-downs that give one date in a hidden input, the days following the month and the years the age allowed.",
    tags: ["forms", "select", "picker", "calendar", "interactive"], demo: BirthdayInputDemo })
