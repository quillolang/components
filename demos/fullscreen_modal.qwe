component FullscreenModalDemoLive() {
    state editing = false
    state saved = 0
    <div.demo-row>
        <Button variant="soft" on_click={() => { editing = true }}>Edit profile (from state)</Button>
        <span.demo-note>{saved == 0 ? "Not saved yet." : `Saved ${saved} ${saved == 1 ? "time" : "times"}.`}</span>
        <FullscreenModal title="Edit profile" open={editing} done="Save" on_done={() => { saved += 1 }}
                         on_close={() => { editing = false }}>
            <div.demo-stack>
                <TextField label="Name" name="name" field="fullscreen-modal-demo-name" value="Ada Lovelace"/>
                <TextArea label="Bio" name="bio" field="fullscreen-modal-demo-bio" value="Engineer in London."/>
            </div>
        </FullscreenModal>
    </div>
}

view FullscreenModalDemo() =
    <div.demo-stack>
        <div.demo-row>
            <FullscreenModal title="Terms of service" trigger="Read the terms">
                {for i in range(1, 13) => <section>
                    <h3>{i}. Section {i}</h3>
                    <p>These terms say what you may do with the service and what we promise in return. The body scrolls under the bar, which stays.</p>
                </section>}
            </FullscreenModal>
            <FullscreenModalDemoLive/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "fullscreen_modal", name: "FullscreenModal", group: "Overlays",
    summary: "A dialog taking the whole window, with a bar holding close, its title and a main action, on the browser's <dialog>.",
    tags: ["dialog", "overlay", "mobile", "interactive"],
    demo: FullscreenModalDemo })
