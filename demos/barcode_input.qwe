component BarcodeInputDemoLive() {
    state got = null
    <div.demo-stack>
        <BarcodeInput id="barcode-demo-live" name="sku" label="Product code" on_change={(r) => { got = r }}/>
        <p.demo-note>{got == null ? "Type a code to see on_change." : `on_change: ${got.kind ?? "unknown"} ${got.valid ? "valid" : "not valid"} ${got.code}`}</p>
    </div>
}

view BarcodeInputDemo() =
    <div class="demo-stack demo-narrow">
        <form>
            <BarcodeInput id="barcode-demo" name="code" value="0-306-40615-2" hint="An EAN, a UPC or an ISBN, with hyphens or without."/>
        </form>
        <BarcodeInputDemoLive/>
        <BarcodeInput id="barcode-demo-books" name="isbn" label="ISBN only" kinds={["isbn10", "isbn13"]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "barcode_input", name: "BarcodeInput", group: "Forms",
    summary: "Tells EAN-13, EAN-8, UPC-A, ISBN-10 and ISBN-13 apart by shape, checks the check digit, says what the right one would be, and converts ISBN-10 to ISBN-13.",
    tags: ["smart", "interactive", "barcode", "isbn", "validation", "forms"], demo: BarcodeInputDemo })
