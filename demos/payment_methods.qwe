component PaymentMethodsDemoLive() {
    state way = "card"
    <div.demo-stack.demo-narrow>
        <PaymentMethods name="payment-demo-live" value={way} on_change={(v) => { way = v }}
                        options={[{ value: "card", brands: ["visa", "mastercard", "amex"] }, "paypal", "apple", "google"]}/>
        <p.demo-note>Paying with {way} (on_change).</p>
    </div>
}

view PaymentMethodsDemo() =
    <div.demo-row style="align-items: flex-start; gap: 32px">
        <PaymentMethodsDemoLive/>
        <div.demo-narrow>
            <PaymentMethods name="payment-demo-more" label="Other ways" required={true}
                            options={["bank", "later", { value: "invoice", label: "Pay by invoice", icon: "🧾", hint: "Business accounts only" },
                                      { value: "cash", disabled: true }]}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "payment_methods", name: "PaymentMethods", group: "Commerce",
    summary: "Ways to pay as radio cards with their marks: card (with the brands taken), PayPal, Apple Pay, Google Pay, bank, cash.",
    tags: ["commerce", "checkout", "forms", "select", "card", "no-js"], demo: PaymentMethodsDemo })
