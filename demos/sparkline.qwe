view SparklineDemo() =
    <div.demo-stack>
        <div.demo-row>
            <Sparkline values={[12, 18, 14, 22, 19, 26, 30]} label="Signups"/>
            <Sparkline values={[40, 38, 41, 35, 30, 32, 28, 24]} variant="area" tone="danger" label="Stock"/>
            <Sparkline values={[3, 7, 4, 9, 6, 11, 8, 12, 10, 14]} variant="area" tone="success" width={160}/>
            <Sparkline values={[4, 0, 7, 3, 5, 8, 2]} variant="bar" width={80} tone="info" label="Orders"/>
        </div>
        <p.demo-note>Revenue this week <Sparkline values={[5, 9, 7, 12, 10, 15]} width={64} height={18} dot={false}/> up 50%.</p>
        <div.demo-row>
            <Sparkline values={[]} label="Empty"/>
            <Sparkline values={[7]} label="One value"/>
            <Sparkline values={[5, 5, 5, 5]} tone="neutral" label="Flat"/>
            <Sparkline values={[-4, 2, -1, 5, -3]} variant="bar" tone="warning" width={80} label="Net"/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "sparkline", name: "Sparkline", group: "Data",
    summary: "A small inline chart of a list of numbers: a line, an area or bars, safe with no data or flat data.",
    demo: SparklineDemo })
