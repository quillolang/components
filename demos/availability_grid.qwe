component AvailabilityGridDemoLive() {
    state picked = ["Mon-10:00", "Mon-11:00", "Wed-14:00"]
    <div.demo-stack>
        <AvailabilityGrid name="slots" value={picked} on_change={(s) => { picked = s }} label="When can you meet?"/>
        <p.demo-note>{len(picked) == 0 ? "Nothing marked." : `Marked: ${join(picked, ", ")}.`}</p>
    </div>
}

view AvailabilityGridDemo() =
    <div.demo-stack>
        <AvailabilityGridDemoLive/>
        <p.demo-note>Click a slot, or press and drag to paint several; the arrow keys move, Space marks.</p>
        <div.demo-narrow id="availability-grid-demo-dates">
            <AvailabilityGrid days={["2026-11-02", "2026-11-03", "2026-11-04"]} from_hour={9} to_hour={12} step={30} legend={false}
                              value={["2026-11-02-09:30"]} disabled={true} label="Booked"/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "availability_grid", name: "AvailabilityGrid", group: "Scheduling",
    summary: "Days across and hours down: click or drag across the cells to mark when you are available; the slots go in a hidden input.",
    tags: ["schedule", "calendar", "forms", "picker", "drag", "interactive"], demo: AvailabilityGridDemo })
