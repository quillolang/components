// Stands in for a server: the number's end chooses what happens, and the right code is 123456.
fn phone_sign_in_demo_send(phone: str) {
    if ends_with(phone, "0000") { return { ok: false, reason: "rate", retry: 2 } }
    if ends_with(phone, "1111") { return { ok: false, reason: "blocked" } }
    if ends_with(phone, "2222") { return null }
    if ends_with(phone, "3333") { return js("Promise.resolve", js_new("Promise", (_done) => { })) }
    if ends_with(phone, "4444") { return { ok: false, reason: "rate", retry: "soon" } }
    { ok: true }
}

fn phone_sign_in_demo_verify(code: str) {
    if code == "123456" { return { ok: true, token: "abc" } }
    if code == "000000" { return { ok: false, reason: "expired" } }
    if code == "999999" { return { ok: false, reason: "locked", retry: 2 } }
    { ok: false, reason: "wrong", left: 2 }
}

// The same answer a moment later, as a `server fn` gives it: a Promise.
fn phone_sign_in_demo_late(answer) = js("Promise.resolve", js_new("Promise", (done) => { done(answer) }))

component PhoneSignInDemoLive() {
    state run = 0
    state sent = []
    state who = "Not signed in."
    state slow = false
    // A named `let` here and an inline function below: callbacks of both kinds.
    let check_code = (_p, c) => {
        let answer = phone_sign_in_demo_verify(c)
        slow ? phone_sign_in_demo_late(answer) : answer
    }
    <div.demo-stack>
        <PhoneSignIn key={run} country="PT" resend_after={3} max_sends={3} timeout={2} help="#help"
            on_send={(p) => {
                sent = sent + [p]
                let answer = phone_sign_in_demo_send(p)
                slow ? phone_sign_in_demo_late(answer) : answer
            }}
            on_verify={check_code}
            on_signed_in={(p, a) => { who = `${p} with ${a.ok}` }}/>
        <label><input type="checkbox" id="phone-sign-in-demo-slow" bind:checked={slow}/> Answers come as Promises</label>
        <Button size="lg" variant="ghost" id="phone-sign-in-demo-again" on_click={() => { run = run + 1; who = "Not signed in." }}>Start over</Button>
        <p.demo-note id="phone-sign-in-demo-who" data-sent={sent | join(",")}>{who} Numbers ending 0000 are limited, 1111 blocked, 2222 lost, 3333 never answer; the code is 123456.</p>
    </div>
}

view PhoneSignInDemo() = <PhoneSignInDemoLive/>

ui_gallery = ui_gallery | push({ slug: "phone_sign_in", name: "PhoneSignIn", group: "Mobile",
    summary: "Sign in with a phone number: country, formatting, a code with autofill, resend, and every failure a person can reach.",
    tags: ["mobile", "interactive", "tablet", "sign-in", "otp", "forms"],
    needs: ["phone_input"],
    demo: PhoneSignInDemo })
