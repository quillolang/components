view SunburstChartDemo() =
    <div.demo-stack>
        <SunburstChart label="Budget by department and team" show_label={true} prefix="$" suffix="k"
                       items={[{ label: "Engineering", children: [
                                    { label: "Platform", children: [{ label: "Infra", value: 260 }, { label: "Data", value: 160 }] },
                                    { label: "Apps", children: [{ label: "Web", value: 210 }, { label: "Mobile", value: 170 }] },
                                    { label: "Security", value: 120 }] },
                               { label: "Sales", children: [{ label: "EMEA", value: 180 }, { label: "Americas", value: 230 }, { label: "APAC", value: 90 }] },
                               { label: "Marketing", children: [{ label: "Brand", value: 110 }, { label: "Growth", value: 150 }] },
                               { label: "Operations", value: 140 }, { label: "Legal", value: 45 }]}/>
        <SunburstChart label="Disk use" show_label={true} suffix=" GB" size={220} total_label="Used"
                       items={[{ label: "Media", children: [{ label: "Photos", value: 182 }, { label: "Videos", value: 121 }] },
                               { label: "Apps", value: 64 }, { label: "Documents", value: 21 }]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "sunburst_chart", name: "SunburstChart", group: "Charts",
    summary: "A hierarchy as rings of arcs sized by value, shaded by level, with the hovered part's share in the middle.",
    tags: ["chart", "data", "no-js"],
    demo: SunburstChartDemo })
