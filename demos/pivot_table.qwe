let pivot_table_demo_sales = [
    { region: "North", quarter: "Q1", amount: 12400, rep: "Ada" }, { region: "North", quarter: "Q2", amount: 15100, rep: "Ada" },
    { region: "North", quarter: "Q2", amount: 2200, rep: "Mika" }, { region: "North", quarter: "Q3", amount: 9800, rep: "Mika" },
    { region: "South", quarter: "Q1", amount: 8300.5, rep: "Sol" }, { region: "South", quarter: "Q3", amount: 11250, rep: "Sol" },
    { region: "South", quarter: "Q4", amount: 14000, rep: "Ada" },
    { region: "West", quarter: "Q1", amount: 5600, rep: "Mika" }, { region: "West", quarter: "Q4", amount: 7700, rep: "Sol" },
]

let pivot_table_demo_tickets = [
    { assignee: "Ada", status: "Open" }, { assignee: "Ada", status: "Open" }, { assignee: "Ada", status: "Done" },
    { assignee: "Mika", status: "Open" }, { assignee: "Mika", status: "Blocked" }, { assignee: "Sol", status: "Done" },
    { assignee: "Sol", status: "Done" }, { assignee: "Sol", status: "Done" },
]

view PivotTableDemo() =
    <div.demo-stack>
        <PivotTable id="pivot-table-demo-sales" label="Sales by region and quarter" rows={pivot_table_demo_sales}
                    rows_by="region" cols_by="quarter" value="amount" format="money" totals={true} corner="Region"/>
        <PivotTable id="pivot-table-demo-tickets" label="Tickets by assignee and status" rows={pivot_table_demo_tickets}
                    rows_by="assignee" cols_by="status" agg="count" col_order={["Open", "Blocked", "Done"]} totals={true}/>
        <PivotTable id="pivot-table-demo-avg" label="Average sale by rep and quarter" rows={pivot_table_demo_sales}
                    rows_by="rep" cols_by="quarter" value="amount" agg="avg" empty="–"/>
        <p.demo-note>The same flat records, pivoted three ways: sums of money with totals, counts in a given column order, and averages.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "pivot_table", name: "PivotTable", group: "Data",
    summary: "Flat records turned sideways: rows by one field, columns by another, each cell the sum, count or average of a third, with totals.",
    tags: ["data", "table", "no-js"], demo: PivotTableDemo })
