component OfflineQueueDemoLive() {
    state todo = []
    state text = "Book room 4"
    state off = false
    state strict = true
    state took = []
    state kept = "Nothing reported yet."
    let n = len(todo) + 1
    // A pretend server, a moment away: a word in the title makes it refuse, or not answer.
    let send = (a) => {
        let pause = js("Promise.resolve", js_new("Promise", (done) => { js("AbortSignal.timeout", 90).addEventListener("abort", (_e) => { done(true) }) }))
        if contains(a.title, "refuse") { return { ok: false, error: "That room has just been taken." } }
        if contains(a.title, "lost") { return err("not reached") }
        if contains(a.title, "hang") { return js("Promise.resolve", js_new("Promise", (_done) => { null })) }
        if contains(a.title, "throw") { return js("JSON.parse", "{") }
        took = took | push(a.title)
        { ok: pause }
    }
    <div.demo-stack>
        <div.demo-row>
            <input id="offq-demo-text" aria-label="What to do" style="flex: 1 1 180px; min-width: 0; min-height: 46px; padding: 0 10px; font-size: 16px" value={text} @input={(e) => { text = e.value }}/>
            <Button size="lg" id="offq-demo-add" on_click={() => { todo = todo | push({ id: `demo-${n}`, title: text, detail: `Made as action ${n}` }) }}>Do it</Button>
            <Button size="lg" variant="outline" id="offq-demo-off" on_click={() => { off = !off }}>{off ? "Back online" : "Pretend to go offline"}</Button>
            <Button size="lg" variant="outline" id="offq-demo-strict" on_click={() => { strict = !strict }}>{strict ? "Let the rest go past a failure" : "Hold the rest after a failure"}</Button>
        </div>
        <OfflineQueue id="offq-demo" actions={todo} online={off ? false : null} wait_ms={500} keep_order={strict}
                      send={send}/>
        <p.demo-note id="offq-demo-took">{len(took) == 0 ? "The server has taken nothing yet." : `The server took: ${join(took, ", ")}.`}</p>
        <OfflineQueue id="offq-demo-kept" title="Kept by the program" saved={[{ id: "k1", title: "Pay deposit", status: "failed", why: "Card declined." }, { id: "k2", title: "Send note", status: "sending" }, { id: "k3", title: "Old one", status: "sent" }]}
                      on_change={(list) => { kept = `Would keep: ${join(list | map((a) => `${a.id} ${a.status}`), ", ")}.` }}/>
        <p.demo-note id="offq-demo-kept-said">{kept}</p>
    </div>
}

view OfflineQueueDemo() = <OfflineQueueDemoLive/>

ui_gallery = ui_gallery | push({ slug: "offline_queue", name: "OfflineQueue", group: "Mobile",
    summary: "Holds actions made offline, shows them as pending, sends them in order on return, with failure and retry for each.",
    tags: ["mobile", "interactive", "offline", "queue", "sync", "tablet"],
    demo: OfflineQueueDemo })
