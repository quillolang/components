let agenda_list_demo_events = [
    { id: 3, date: "2026-11-06", start: "16:00", end: "17:00", title: "Release", place: "Online", href: "#agenda_list", tone: "success" },
    { id: 1, date: "2026-11-04", start: "09:00", end: "09:15", title: "Stand-up" },
    { id: 2, date: "2026-11-04", title: "Ana out", tone: "neutral" },
    { id: 4, date: "2026-11-04", start: "14:00", end: "15:30", title: "Design review", place: "Room 2", tone: "warning" },
    { id: 5, date: "2026-11-05", start: "11:00", title: "Dentist", place: "Rua Augusta 10", tone: "danger" },
]

component AgendaListDemoLive() {
    state opened = null
    <div.demo-stack>
        <AgendaList today="2026-11-04" days={["2026-11-07"]} events={agenda_list_demo_events} on_open={(id) => { opened = id }}/>
        <p.demo-note>{opened == null ? "Press an event." : `Opened event ${opened}.`}</p>
    </div>
}

view AgendaListDemo() =
    <div.demo-stack>
        <AgendaListDemoLive/>
        <div id="agenda-list-demo-empty"><AgendaList events={[]} empty="No events this week."/></div>
    </div>

ui_gallery = ui_gallery | push({ slug: "agenda_list", name: "AgendaList", group: "Scheduling",
    summary: "Events grouped by day with the date at the left, each with its time, title and place; today and tomorrow named.",
    tags: ["schedule", "calendar", "list", "time", "no-js"], demo: AgendaListDemo })
