let haptic_button_demo_css = css`
.ui-hapbtn-demo { display: grid; grid-template-columns: repeat(auto-fill, minmax(124px, 1fr)); gap: 10px; }
`

component HapticButtonDemoLive() {
    style global haptic_button_demo_css
    state presses = 0
    state last = "nothing yet"
    state quiet = true
    let note = (how) => { last = how }
    <div.demo-stack>
        <div.ui-hapbtn-demo>
            {for n in ["selection", "light", "medium", "heavy", "soft", "rigid"] => <HapticButton key={n} pattern={n} variant="soft" full={true} say={false}
                on_click={() => { presses += 1 }} on_feel={note}>{upper(slice(n, 0, 1)) + slice(n, 1, len(n))}</HapticButton>}
        </div>
        <div.ui-hapbtn-demo>
            <HapticButton pattern="success" full={true} on_click={() => { presses += 1 }} on_feel={note}>Success</HapticButton>
            <HapticButton pattern="warning" variant="outline" full={true} on_click={() => { presses += 1 }} on_feel={note}>Warning</HapticButton>
            <HapticButton pattern="error" tone="danger" full={true} on_click={() => { presses += 1 }} on_feel={note}>Error</HapticButton>
        </div>
        <div.demo-row>
            <HapticButton pattern="thud" variant="outline" say={true} on_click={() => { presses += 1 }} on_feel={note}>A name it does not know</HapticButton>
            <HapticButton muted={quiet} variant="ghost" say={true} on_click={() => { presses += 1 }} on_feel={note}>Muted</HapticButton>
            <HapticButton disabled={true} on_click={() => { presses += 1 }}>Disabled</HapticButton>
            <Button size="lg" variant="ghost" id="haptic-button-demo-quiet" on_click={() => { quiet = !quiet }}>{quiet ? "Unmute" : "Mute"}</Button>
        </div>
        <p.demo-note id="haptic-button-demo-note">Pressed {presses} times; the last was felt: {last}.</p>
    </div>
}

view HapticButtonDemo() = <HapticButtonDemoLive/>

ui_gallery = ui_gallery | push({ slug: "haptic_button", name: "HapticButton", group: "Mobile",
    summary: "A button with the phone's own feel, falling back to vibrate and then to nothing, with nine named patterns.",
    tags: ["mobile", "interactive", "haptics", "vibrate", "button"],
    needs: ["button"],
    demo: HapticButtonDemo })
