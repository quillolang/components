view SkeletonTextDemo() =
    <div.demo-stack>
        <SkeletonText id="skeleton-text-demo-plain"/>
        <SkeletonText id="skeleton-text-demo-article" lines={4} heading={true} label="Loading the article"/>
        <div.demo-row style="align-items: flex-start; gap: 32px">
            <div style="flex: 1; min-width: 200px"><SkeletonText id="skeleton-text-demo-small" paragraphs={2} lines={3} size="sm"/></div>
            <div style="flex: 1; min-width: 200px"><SkeletonText lines={2} size="lg" last={40}/></div>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "skeleton_text", name: "SkeletonText", group: "Feedback",
    summary: "Grey lines in the shape of a paragraph, with a heading and several paragraphs if asked, while text loads.",
    tags: ["feedback", "loading", "text", "no-js"],
    demo: SkeletonTextDemo })
