let swipe_deck_demo_cards = [
    { id: "lis", title: "Lisbon", subtitle: "Portugal, three nights", color: "linear-gradient(135deg, #f6b26b, #e06666)" },
    { id: "osl", title: "Oslo", subtitle: "Norway, a long weekend", color: "linear-gradient(135deg, #6fa8dc, #3d5a98)" },
    { id: "kyo", title: "Kyoto", subtitle: "Japan, a week", color: "linear-gradient(135deg, #b6d7a8, #38761d)" },
    { id: "lim", title: "Lima", subtitle: "Peru, ten days", color: "linear-gradient(135deg, #ffd966, #bf9000)" },
    { id: "cpt", title: "Cape Town", subtitle: "South Africa, two weeks", color: "linear-gradient(135deg, #b4a7d6, #674ea7)" },
]

component SwipeDeckDemoLive() {
    state log = "Nothing chosen yet."
    state over = false
    state cards = swipe_deck_demo_cards
    <div.demo-stack>
        <SwipeDeck cards={cards} left_label="Skip" right_label="Keep" height={340} label="Trips"
                   on_swipe={(id, way) => { log = `${way}: ${id}` }}
                   on_undo={(id) => { log = `undo: ${id}`; over = false }}
                   on_empty={() => { over = true }}/>
        <p.demo-note id="swipe-deck-log">{log}{over ? " All done." : ""}</p>
        // For the test, as live data does in mid-drag: the cards changing, and one arriving at the front.
        <button id="swipe-deck-again" type="button" hidden="true" @click={() => { cards = cards | map((c) => { ...c, subtitle: `${c.subtitle}, updated` }) }}>Again</button>
        <button id="swipe-deck-front" type="button" hidden="true" @click={() => { cards = [{ id: "new", title: "Reykjavik", subtitle: "Iceland, a week", color: "linear-gradient(135deg, #a2c4c9, #134f5c)" }] + cards }}>Front</button>
        // Bad data, for the test to look at: nothing here should stop the page.
        <div id="swipe-deck-bad" hidden="true"><SwipeDeck cards={[null, "x", { id: 7 }, { id: 2, title: "One" }, { id: 2, title: "Again" }, { title: "No id" }]}/><SwipeDeck cards="none"/></div>
    </div>
}

view SwipeDeckDemo() = <SwipeDeckDemoLive/>

ui_gallery = ui_gallery | push({ slug: "swipe_deck", name: "SwipeDeck", group: "Mobile",
    summary: "A stack of cards flung left or right with a turn of the wrist, undo, and buttons that do the same.",
    tags: ["mobile", "interactive", "gesture", "swipe", "cards", "tablet"],
    demo: SwipeDeckDemo })
