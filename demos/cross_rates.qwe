view CrossRatesDemo() =
    <div.demo-stack>
        <CrossRates id="cross-rates-demo" rates={{ USD: 1, EUR: 0.9224m, GBP: 0.7841m, JPY: 156.24m, CHF: 0.8812m, CAD: 1.3746m }}
                    updated="mid-market, 14:05 UTC"/>
        <div style="max-width: 560px">
            <CrossRates id="cross-rates-demo-cee" label="Central Europe" base="EUR" highlight="PLN" decimals={4}
                        rates={{ EUR: 1, PLN: 4.3125m, CZK: 25.214m, HUF: 395.80m }}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "cross_rates", name: "CrossRates", group: "Finance",
    summary: "A matrix of cross rates among a few currencies, each worked out from their rates against one base, the diagonal left blank.",
    tags: ["finance", "forex", "table", "data", "no-js"], demo: CrossRatesDemo })
