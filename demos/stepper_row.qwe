component StepperRowDemoLive() {
    state adults = 2
    state dose = 0.5
    state calls = 0
    <div.demo-stack>
        <StepperRow label="Adults" hint="Age 13 and up" value={adults} least={1} most={9} name="adults" field="stepper-row-demo-adults"
                    on_change={(n) => { adults = n; calls += 1 }}/>
        <StepperRow label="Dose" hint="Up to 2.5 ml a day" unit="ml" value={dose} least={0} most={2.5} step={0.25} field="stepper-row-demo-dose"
                    on_change={(n) => { dose = n }}/>
        <StepperRow label="Steps today" value={100} least={0} step={10} field="stepper-row-demo-long" typed={false}/>
        <p.demo-note id="stepper-row-demo-out">Adults {adults}, dose {dose}, {calls} changes.</p>
    </div>
}

view StepperRowDemo() = <StepperRowDemoLive/>

ui_gallery = ui_gallery | push({ slug: "stepper_row", name: "StepperRow", group: "Mobile",
    summary: "Minus and plus in a row, a hold to repeat and accelerate, typed values, limits, min and max stated to screen readers.",
    tags: ["mobile", "interactive", "stepper", "number", "input", "forms"],
    demo: StepperRowDemo })
