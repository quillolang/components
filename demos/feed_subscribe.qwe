view FeedSubscribeDemo() =
    <FeedSubscribe id="feed-subscribe-demo" text="New posts every week or two, in your feed reader or your inbox."
                   feeds={[{ label: "All posts", href: "https://blog.example.com/feed.xml" },
                           { label: "Only the Quillo posts", href: "https://blog.example.com/tags/quillo/feed.xml", kind: "atom" },
                           { label: "Week notes", href: "https://blog.example.com/week-notes/feed.json", kind: "json" }]}
                   email_action="#feed_subscribe"/>

ui_gallery = ui_gallery | push({ slug: "feed_subscribe", name: "FeedSubscribe", group: "Blogging",
    summary: "Follow this blog: its RSS, Atom or JSON feeds with their addresses to copy, links into feed readers, what a feed is, and an email box.",
    tags: ["blogging", "feeds", "subscribe", "forms", "interactive"], demo: FeedSubscribeDemo })
