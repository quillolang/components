component QrPayCardDemoLive() {
    state paid = "waiting"
    state log = "Nothing yet"
    state renews = 0
    state refuse = false
    <div.demo-stack>
        <QrPayCard payee="Cafe Luz" to="cafe@luz" amount={12.50m} reference="R-1042" seconds={300} status={paid}
                   on_share={(s) => { log = `Shared: ${s.text}` }} on_cancel={() => { log = "Cancelled" }}
                   on_renew={() => {
                       renews += 1
                       `R-${1042 + renews}`
                   }}/>
        <div.demo-row>
            <Button id="qrpay-pay" size="lg" variant="outline" on_click={() => { paid = "paid" }}>Mark paid</Button>
            <Button id="qrpay-fail" size="lg" variant="outline" on_click={() => { paid = "failed" }}>Mark failed</Button>
        </div>
        <p.demo-note id="qrpay-log">{log}</p>
    </div>
}

component QrPayCardDemoShort() {
    state refuse = true
    <div id="qrpay-short">
        <QrPayCard payee="Ann & Bo" to="ann bo" amount="bad" seconds={2} reference="S 1" scheme="pay"
                   on_renew={() => {
                       if refuse {
                           refuse = false
                           return false
                       }
                       js("Promise.resolve", "S-2")
                   }}/>
    </div>
}

view QrPayCardDemo() =
    <div.demo-stack>
        <QrPayCardDemoLive/>
        <QrPayCardDemoShort/>
        <div id="qrpay-same"><QrCode text="pay:cafe@luz?amount=12.50&cur=USD&ref=R-1042" size={80}/></div>
        <div id="qrpay-link"><QrPayCard to="x" link="https://pay.example/r" amount={5} currency="EUR" reference="L1" seconds={0}/></div>
    </div>

ui_gallery = ui_gallery | push({ slug: "qr_pay_card", name: "QrPayCard", group: "Mobile",
    summary: "A code to be paid, with the amount, a timer, a way to share it, and what became of it.",
    tags: ["mobile", "interactive", "banking", "qr", "share", "tablet"],
    needs: ["qr_code", "price", "button"],
    demo: QrPayCardDemo })
