component ShakeDetectorDemoLive() {
    state shown = true
    state total = 0
    state how = "nothing yet"
    state paused = false
    <div.demo-stack>
        {shown && <ShakeDetector label="Undo" enabled={!paused} on_shake={(h) => { total += 1; how = h }}/>}
        <p.demo-note id="shake-detector-demo-note">Undone {total} times; the last by {how}.</p>
        <div.demo-row>
            <Button size="lg" variant="ghost" id="shake-detector-demo-show" on_click={() => { shown = !shown }}>{shown ? "Remove it" : "Put it back"}</Button>
            <Button size="lg" variant="ghost" id="shake-detector-demo-pause" on_click={() => { paused = !paused }}>{paused ? "Listen" : "Pause"}</Button>
        </div>
    </div>
}

view ShakeDetectorDemo() = <ShakeDetectorDemoLive/>

ui_gallery = ui_gallery | push({ slug: "shake_detector", name: "ShakeDetector", group: "Mobile",
    summary: "Detects a shake from motion with a threshold, the iOS permission and a debounce, with a button as its equal.",
    tags: ["mobile", "interactive", "shake", "motion", "sensor"],
    needs: ["button"],
    demo: ShakeDetectorDemo })
