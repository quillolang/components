component DocumentCaptureDemoLive() {
    state got = []
    state shown = true
    <div.demo-stack>
        {shown && <form.demo-stack method="post" action="/" enctype="multipart/form-data">
            <DocumentCapture name="pages" limit={3} max_side={600} on_change={(list) => { got = list }}/>
        </form>}
        <p.demo-note id="document-capture-demo-note">{len(got) == 0 ? "No pages yet." : join(got | map((p) => `${p.name} ${p.width}x${p.height}`), ", ")}</p>
        <Button size="lg" variant="ghost" tone="neutral" on_click={() => { shown = !shown }}>{shown ? "Leave the page" : "Come back"}</Button>
    </div>
}

view DocumentCaptureDemo() =
    <div.demo-stack>
        <DocumentCaptureDemoLive/>
        <p.demo-note>Up to three pages in this example. A page shot at an angle comes out flat once its four corners are set.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "document_capture", name: "DocumentCapture", group: "Mobile",
    summary: "Photographs pages one by one, with reorder, drop, and a crop by four corners by finger that flattens the page, kept as a list of images.",
    tags: ["mobile", "interactive", "camera", "document", "scanner", "upload"], needs: ["button"], demo: DocumentCaptureDemo })
