let bar_chart_demo_grid = "display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 32px 40px"

view BarChartDemo() =
    <div.demo-stack>
        <div style={bar_chart_demo_grid}>
            <BarChart label="Orders this week" show_label={true} labels={["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]}
                      values={[132, 158, 141, 187, 224, 96, 78]} value_labels={true} height={200}/>
            <BarChart label="Signups by plan" show_label={true} labels={["Q1", "Q2", "Q3", "Q4"]} height={200}
                      series={[{ name: "Free", values: [1840, 2210, 2650, 3120] },
                               { name: "Pro", values: [420, 515, 640, 810] },
                               { name: "Team", values: [96, 130, 188, 245] }]}/>
            <BarChart label="Revenue by channel" show_label={true} labels={["Jan", "Feb", "Mar", "Apr", "May", "Jun"]} prefix="$" stacked={true}
                      value_labels={true} height={200}
                      series={[{ name: "Online", values: [42100, 45800, 51200, 49900, 56300, 61750] },
                               { name: "Stores", values: [30500, 29800, 31200, 28700, 27900, 30100] }]}/>
            <BarChart label="Net cash flow" show_label={true} labels={["Jan", "Feb", "Mar", "Apr", "May", "Jun"]} prefix="$" height={200}
                      values={[12400, -3800, 8100, -1250, 15600, 9900]}/>
        </div>
        <BarChart label="Top pages, views" show_label={true} horizontal={true} value_labels={true}
                  labels={["/pricing", "/docs/getting-started", "/blog/quillo-1-0", "/components", "/about"]}
                  values={[18420, 12960, 9875, 6210, 2340]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "bar_chart", name: "BarChart", group: "Data",
    summary: "Bars up or across, one series or several grouped or stacked, on round ticks, with values on hover and a table for screen readers.",
    demo: BarChartDemo })
