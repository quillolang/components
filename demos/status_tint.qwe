let status_tint_demo_css = css`
.status-tint-demo-keys { display: flex; flex-wrap: wrap; gap: 8px; }
.status-tint-demo-field { display: grid; gap: 4px; max-width: 320px; color: var(--ui-muted); font: 13px/1.4 var(--ui-font); }
.status-tint-demo-field input { box-sizing: border-box; min-height: 46px; padding: 0 12px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius-sm); background: var(--ui-surface); color: var(--ui-fg); font: 16px var(--ui-font); }
`

component StatusTintDemoLive() {
    style global status_tint_demo_css
    state page = "home"
    state typed = ""
    state over = false
    state base = true
    state said = ""
    state changes = 0
    let color = match page {
        "alerts" => "#c62a2f"
        "typed" => typed
        _ => null
    }
    <div.demo-stack>
        {base && <StatusTint color={color} dark={page == "alerts" ? "#3a1618" : null} note={true}
                             on_change={(c) => { said = c; changes += 1 }}/>}
        {over && <StatusTint color="#0b6bcb" background={true}/>}
        <div.status-tint-demo-keys>
            <Button size="lg" id="status-tint-demo-home" variant={page == "home" ? "solid" : "outline"} on_click={() => { page = "home" }}>Home</Button>
            <Button size="lg" id="status-tint-demo-alerts" variant={page == "alerts" ? "solid" : "outline"} on_click={() => { page = "alerts" }}>Alerts</Button>
            <Button size="lg" id="status-tint-demo-over" variant="soft" on_click={() => { over = !over }}>{over ? "Close the sheet" : "Open a sheet"}</Button>
            <Button size="lg" id="status-tint-demo-leave" variant="ghost" on_click={() => { base = !base }}>{base ? "Leave this page" : "Come back"}</Button>
        </div>
        <label.status-tint-demo-field>Any colour
            <input id="status-tint-demo-color" value={typed} placeholder="hsl(160 80% 25%)"
                   @input={(e) => { typed = e.value; page = "typed" }}/>
        </label>
        <p.demo-note id="status-tint-demo-out" data-changes={changes}>On change: {said}</p>
    </div>
}

view StatusTintDemo() = <div><StatusTintDemoLive/></div>

ui_gallery = ui_gallery | push({ slug: "status_tint", name: "StatusTint", group: "Mobile",
    summary: "Sets theme-color for the browser's bar by the page and theme, restored on leaving.",
    tags: ["mobile", "interactive", "theme", "status-bar", "browser"],
    demo: StatusTintDemo })
