component FollowButtonDemoLive() {
    state on = false
    <div.demo-row>
        <FollowButton on_change={(v) => { on = v }}/>
        <span.demo-note>{on ? "Following Ada." : "Not following Ada."}</span>
    </div>
}

view FollowButtonDemo() =
    <div.demo-stack>
        <FollowButtonDemoLive/>
        <div.demo-row>
            <FollowButton following={true} name="follow"/>
            <FollowButton size="sm"/>
            <FollowButton size="lg" follow="Subscribe" followed="Subscribed" unfollow="Unsubscribe"/>
            <FollowButton disabled={true}/>
        </div>
        <p.demo-note>Rest the pointer on a Following button: it says Unfollow.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "follow_button", name: "FollowButton", group: "Actions",
    summary: "Follow becomes Following once pressed, and says Unfollow on hover, as the social sites do.",
    tags: ["button", "social", "user", "forms", "interactive"],
    demo: FollowButtonDemo })
