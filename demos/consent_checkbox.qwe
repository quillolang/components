component ConsentCheckboxDemoLive() {
    state agreed = false
    <div.demo-stack>
        <ConsentCheckbox name="rules" field="consent-checkbox-demo-live" required={false} checked={agreed}
                         on_change={(c) => { agreed = c }}>
            I have read the <a href="https://quillolang.org/docs/" target="_blank" rel="noopener">community rules</a>
        </ConsentCheckbox>
        <p.demo-note>{agreed ? "Rules accepted." : "Rules not accepted yet."}</p>
    </div>
}

view ConsentCheckboxDemo() =
    <div.demo-stack>
        <ConsentCheckbox name="terms" terms_href="https://quillolang.org/terms" privacy_href="https://quillolang.org/privacy"
                         field="consent-checkbox-demo-terms" hint="Both open in a new tab."/>
        <ConsentCheckbox name="marketing" required={false} field="consent-checkbox-demo-marketing">
            Email me about new releases, at most one a month
        </ConsentCheckbox>
        <ConsentCheckbox name="age" terms_href="https://quillolang.org/terms" terms_label="age policy"
                         field="consent-checkbox-demo-error" error="You must accept this to sign up."/>
        <ConsentCheckboxDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "consent_checkbox", name: "ConsentCheckbox", group: "Forms",
    summary: "A required checkbox beside legal text with links to the terms and the privacy policy, posted as a real checkbox.",
    tags: ["forms", "input", "security", "no-js"], demo: ConsentCheckboxDemo })
