component UtmBuilderDemoLive() {
    state seen = null
    <div.demo-stack>
        <UtmBuilder id="utm-builder-demo-live" title="With on_change" name="ad" url="shop.example/shoes" source="google" medium="cpc" campaign="shoes"
                    on_change={(r) => { seen = r }}/>
        <p.demo-note>{seen == null ? "Change a field to see on_change." : `on_change: ok ${seen.ok}, ${seen.warnings} warnings, ${seen.link}.`}</p>
    </div>
}

view UtmBuilderDemo() =
    <div.demo-stack>
        <UtmBuilder id="utm-builder-demo" url="https://example.com/sale?ref=7#buy" source="Newsletter" medium="email" campaign="Spring Sale 2026"
                    recent={{ source: ["newsletter", "partner-blog"], medium: ["email", "cpc"], campaign: ["spring_sale_2026"] }} remember="utm-builder-demo"/>
        <UtmBuilderDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "utm_builder", name: "UtmBuilder", group: "Marketing",
    summary: "Builds a campaign link with consistent case, warns on spaces and mixed conventions, keeps the query and fragment, and remembers recent values.",
    tags: ["smart", "interactive", "marketing", "campaign", "url", "analytics"], demo: UtmBuilderDemo })
