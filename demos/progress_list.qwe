view ProgressListDemo() =
    <div.demo-row style="align-items: flex-start; gap: 32px">
        <div style="flex: 1 1 280px; max-width: 380px">
            <ProgressList id="progress-list-demo-budget" label="Budget by category" items={[
                { label: "Travel", value: 1840, limit: 2500, note: "$1,840 of $2,500" },
                { label: "Software", value: 2900, limit: 2500, note: "$2,900 of $2,500", description: "Annual licences renewed in March" },
                { label: "Hardware", value: 600, limit: 4000, note: "$600 of $4,000", tone: "success" },
                { label: "Training", value: 0, limit: 1000, note: "Not started", tone: "neutral" },
            ]}/>
        </div>
        <div style="flex: 1 1 240px; max-width: 320px">
            <ProgressList id="progress-list-demo-poll" label="Would you recommend us?" show="percent" order="desc" size="sm" items={[
                { label: "Maybe", value: 21 }, { label: "Yes", value: 64, tone: "success" }, { label: "No", value: 15, tone: "warning" },
            ]}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "progress_list", name: "ProgressList", group: "Data",
    summary: "Items each with a label, a bar and its value or percentage, marked in red when one goes over its limit.",
    tags: ["data", "progress", "list", "dashboard", "no-js"], demo: ProgressListDemo })
