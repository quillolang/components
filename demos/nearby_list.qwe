let nearby_list_demo_week = [1, 2, 3, 4, 5]

// Rossio to Belem along the river, near enough for a walk and far enough to need a tram.
let nearby_list_demo_places = [
    { id: "a", name: "Pasteis de Belem", kind: "Bakery", lat: 38.6975, lng: -9.2032,
      hours: nearby_list_demo_week | map((d) => { day: d, open: "08:00", close: "20:00" }) },
    { id: "b", name: "Time Out Market", kind: "Food hall", lat: 38.7070, lng: -9.1458,
      hours: nearby_list_demo_week | map((d) => { day: d, open: "10:00", close: "14:20" }) },
    { id: "c", name: "A Brasileira", kind: "Cafe", lat: 38.7106, lng: -9.1415,
      hours: nearby_list_demo_week | map((d) => { day: d, open: "18:00", close: "02:00" }) },
    { id: "d", name: "Museu do Oriente", kind: "Museum", lat: 38.7036, lng: -9.1741 },
    { id: "e", name: "Pharmacy on the corner", kind: "Pharmacy", lat: 38.7139, lng: -9.1383,
      hours: nearby_list_demo_week | map((d) => { day: d, open: "00:00", close: "00:00" }) },
    { id: "f", name: "The kiosk nobody mapped", kind: "Kiosk" },
]

let nearby_list_demo_stops = [{ name: "Rossio", at: [38.7139, -9.1394] }, { name: "Cais do Sodre", at: [38.7061, -9.1444] }, { name: "Belem", at: [38.6967, -9.2060] }]

component NearbyListDemoLive() {
    state stop = 0
    state picked = "nothing yet"
    state unit = "km"
    state time = "2026-11-03T14:05:00+00:00"
    state lost = false
    <div.demo-stack>
        <NearbyList label="Near you in Lisbon" places={nearby_list_demo_places} position={lost ? [999, "x"] : nearby_list_demo_stops[stop].at} now={time} tick={1}
                    on_pick={(p) => { picked = p.name }} on_units={(u) => { unit = u }}/>
        <NearbyList class="nearby-list-demo-own" label="By the phone's own clock" position={[38.7139, -9.1394]}
                    places={[{ id: "x", name: "Open every hour", lat: 38.7106, lng: -9.1415, hours: [1, 2, 3, 4, 5, 6, 7] | map((d) => { day: d, open: "00:00", close: "00:00" }) }]}/>
        <div.demo-row>
            <button.nearby-list-demo-next type="button" style="min-height: 44px" @click={() => { stop = (stop + 1) % 3 }}>Walk to the next stop</button>
            <button.nearby-list-demo-late type="button" style="min-height: 44px" @click={() => { time = "2026-11-03T21:30:00+00:00" }}>Make it evening</button>
            <button.nearby-list-demo-lost type="button" style="min-height: 44px" @click={() => { lost = !lost }}>Lose the position</button>
        </div>
        <p.demo-note>At <span class="nearby-list-demo-at">{nearby_list_demo_stops[stop].name}</span>. Picked: <span class="nearby-list-demo-picked">{picked}</span>. Units: <span class="nearby-list-demo-unit">{unit}</span>.</p>
    </div>
}

view NearbyListDemo() = <NearbyListDemoLive/>

ui_gallery = ui_gallery | push({ slug: "nearby_list", name: "NearbyList", group: "Mobile",
    summary: "Places by real distance from a position, in km or miles, with walking time, sorted live as the position moves, and open now from their hours.",
    tags: ["mobile", "interactive", "tablet", "location", "map", "list"],
    needs: ["opening_hours"], demo: NearbyListDemo })
