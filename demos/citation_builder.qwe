let citation_builder_demo_book = { authors: "Le Guin, Ursula K.", title: "The Dispossessed", year: "1974", publisher: "Harper & Row", place: "New York", edition: "2" }
let citation_builder_demo_article = { authors: "Watson, James D.; Crick, Francis", title: "Molecular structure of nucleic acids", journal: "Nature", year: "1953", volume: "171", issue: "4356", pages: "737-738",
                                      doi: "https://doi.org/10.1038/171737a0" }

component CitationBuilderDemoLive() {
    state apa = null
    <div.demo-stack>
        <CitationBuilder id="citation-builder-demo-live" name="cite" kind="web" today="2026-11-01" fields={{ title: "Drinking-water", authors: "{World Health Organization}" }} on_change={(c) => { apa = c.apa_text }}/>
        <p.demo-note>{apa == null ? "Change a field to see on_change." : `on_change: ${apa}`}</p>
    </div>
}

view CitationBuilderDemo() =
    <div.demo-stack>
        <CitationBuilder id="citation-builder-demo" fields={citation_builder_demo_book} today="2026-11-01"/>
        <CitationBuilder id="citation-builder-demo-article" kind="article" fields={citation_builder_demo_article} today="2026-11-01"/>
        <CitationBuilderDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "citation_builder", name: "CitationBuilder", group: "Typography",
    summary: "Builds APA, MLA, Chicago and BibTeX citations for a book, article or web page, reading author names however they are written and flagging what is missing.",
    tags: ["smart", "interactive", "citation", "bibliography", "writing", "reference"], needs: ["copy_button"], demo: CitationBuilderDemo })
