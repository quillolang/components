let infinite_feed_demo_words = ["The harbour wall was finished before the storm came in.", "A short note.", "Three people asked about the old bridge on the same day, and nobody knew who had built it or why it stopped halfway across the river.", "Tickets go on sale on Friday.", "The bakery on Quay Street has started opening at six, and the queue goes round the corner by half past.", "Rain later."]

// A page of the story list. A page's text varies in length, so rows vary in height.
fn infinite_feed_demo_page(page: int, size: int) -> list =
    range((page - 1) * size, page * size) | map((i) => { id: i + 1, title: `Story ${i + 1}`, text: infinite_feed_demo_words[i % 6], meta: `${(i % 9) + 1} min read` })

// A pause, as there is no sleep in the browser: a timer the page's own AbortSignal has.
fn infinite_feed_demo_after(ms: int, value) = js("Promise.resolve", js_new("Promise", (res, rej) => {
    js("AbortSignal.timeout", ms).addEventListener("abort", () => { res(value) })
}))

component InfiniteFeedDemoLive() {
    state reading = null
    state calls = []
    state failed_yet = false
    state tries = 0
    let shown_calls = join(calls, ",")
    <div.demo-stack>
        <div.demo-phone style="height: 560px" data-frame>
            {reading == null
                ? <InfiniteFeed id="infeed-demo" height="100%" first={infinite_feed_demo_page(1, 12)} page_size={12} label="Stories" over={4}
                                load={(page) => {
                                    calls = calls + [page]
                                    if page == 3 && !failed_yet {
                                        failed_yet = true
                                        return infinite_feed_demo_after(120, err("no signal"))
                                    }
                                    infinite_feed_demo_after(120, page < 9 ? infinite_feed_demo_page(page, 12) : take(infinite_feed_demo_page(page, 12), 5))
                                }}
                                on_open={(it) => { reading = it }}/>
                : <div style="padding: 16px">
                    <h3 data-reading>{reading.title}</h3>
                    <p>{reading.text}</p>
                    <Button size="lg" id="infeed-back" on_click={() => { reading = null }}>Back to the feed</Button>
                  </div>}
        </div>
        <p.demo-note>Pages asked for: <b data-calls>{shown_calls}</b></p>
        <div.demo-tablet style="height: 300px" data-wide>
            <InfiniteFeed id="infeed-wide" keep={0} height="100%" first={infinite_feed_demo_page(1, 12)} page_size={12} over={4}
                          load={(page) => { page < 4 ? infinite_feed_demo_page(page, 12) : [] }}/>
        </div>
        <InfiniteFeed id="infeed-broken" keep={0} height="240px" first={[{ id: 1, title: "One" }, null, { id: 1, title: "One twice" }]} failed_text="Broken"
                      load={(page) => {
                          tries = tries + 1
                          if tries == 1 { return "nonsense" }
                          if tries == 2 { return unwrap(err("thrown")) }
                          if tries == 3 { return { items: "not a list" } }
                          { items: [{ id: 1, title: "One again" }, { id: 2, title: "Two" }, null, { id: 2, title: "Two again" }, { id: 2, title: "Two" }, { title: "No id" }], more: false }
                      }}/>
        <InfiniteFeed id="infeed-own" keep={0} height="160px" first={[{ id: 1, title: "Mine" }]} row={(it) => <p data-own>{it.title}, drawn by you</p>}/>
        <InfiniteFeed id="infeed-none" keep={0} height="120px" empty="No stories yet" load={(page) => []}/>
        <InfiniteFeed id="infeed-still" keep={0} height="240px" first={["Plain text", { id: 2, title: "A map", meta: "Static" }]} end_text="Only these"/>
    </div>
}

view InfiniteFeedDemo() = <InfiniteFeedDemoLive/>

ui_gallery = ui_gallery | push({ slug: "infinite_feed", name: "InfiniteFeed", group: "Mobile",
    summary: "A long feed that loads pages as you near the end: loading, retry on failure, end of list, keeps its place on return, and stays light by windowing.",
    tags: ["mobile", "interactive", "tablet", "feed", "list", "virtual"],
    demo: InfiniteFeedDemo })
