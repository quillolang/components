let language_switcher_demo_langs = [
    { code: "en", label: "English", href: "#language_switcher", flag: "🇬🇧" },
    { code: "pt", label: "Português", href: "#pt", flag: "🇵🇹" },
    { code: "es", label: "Español", href: "#es", flag: "🇪🇸" },
    { code: "de", label: "Deutsch", href: "#de", flag: "🇩🇪" },
    { code: "ja", label: "日本語", href: "#ja", flag: "🇯🇵" }
]

component LanguageSwitcherDemoLive() {
    state code = "fr"
    <div.demo-row>
        <LanguageSwitcher id="language-switcher-demo-live" current={code} short={true} variant="outline" languages={[
            { code: "fr", label: "Français" }, { code: "it", label: "Italiano" }, { code: "nl", label: "Nederlands" }
        ]} on_select={(c) => { code = c }}/>
        <span.demo-note>Picked: {code}</span>
    </div>
}

view LanguageSwitcherDemo() =
    <div.demo-stack>
        <div.demo-row>
            <LanguageSwitcher id="language-switcher-demo" current="en" languages={language_switcher_demo_langs}/>
            <LanguageSwitcher id="language-switcher-demo-end" current="ja" align="end" variant="soft" size="md"
                              languages={language_switcher_demo_langs}/>
        </div>
        <LanguageSwitcherDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "language_switcher", name: "LanguageSwitcher", group: "Navigation",
    summary: "A button showing the page's language that opens the others, each in its own name, as links to the same page in it.",
    tags: ["navigation", "menu", "select", "popover", "no-js"], demo: LanguageSwitcherDemo })
