view FxRateTableDemo() =
    <div.demo-stack>
        <FxRateTable id="fx-rate-table-demo" updated="Indicative, 14:05 UTC" rows={[
            { pair: "EUR/USD", name: "Euro / US dollar", bid: 1.08421m, ask: 1.08429m, open: 1.08190m },
            { pair: "GBP/USD", name: "Pound / US dollar", bid: 1.27532m, ask: 1.27546m, open: 1.27810m },
            { pair: "USD/JPY", name: "US dollar / Yen", bid: 156.238m, ask: 156.251m, open: 156.902m },
            { pair: "USD/CHF", name: "US dollar / Swiss franc", bid: 0.88114m, ask: 0.88131m, open: 0.881225m },
            { pair: "USD/PHP", name: "US dollar / Philippine peso", bid: 58.105m, ask: 58.140m, open: 57.990m },
            { pair: "AUD/USD", name: "Aussie / US dollar", bid: 0.66412m, ask: 0.66420m },
        ]}/>
        <div style="max-width: 560px">
            <FxRateTable label="Branch board" flags={false} compact={true} rows={[
                { pair: "EUR/GBP", bid: 0.85011m, ask: 0.85026m, open: 0.84960m },
                { pair: "EUR/JPY", bid: 169.402m, ask: 169.431m, open: 169.744m },
            ]}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "fx_rate_table", name: "FxRateTable", group: "Finance",
    summary: "A board of exchange rates: each pair with its flags, bid, ask, the spread in pips and the day's change from the open, coloured.",
    tags: ["finance", "forex", "table", "data", "no-js"], demo: FxRateTableDemo })
