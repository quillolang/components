component IconGridDemoLive() {
    state name = null
    <div.demo-stack>
        <IconGrid id="icon-grid-demo" on_pick={(n) => { name = n }}/>
        <p.demo-note>{name == null ? "Click an icon to see its name." : `<Icon name="${name}"/>`}</p>
    </div>
}

view IconGridDemo() = <IconGridDemoLive/>

ui_gallery = ui_gallery | push({ slug: "icon_grid", name: "IconGrid", group: "Media",
    summary: "Every icon of the kit with its name in a grid, narrowed as you type, each one a click away from its name.",
    tags: ["icon", "media", "search", "interactive"],
    needs: ["icon"], demo: IconGridDemo })
