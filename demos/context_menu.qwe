let context_menu_demo_css = css`
.ctx-demo-card { display: flex; align-items: center; gap: 14px; padding: 18px; border: 1px dashed var(--ui-strong);
  border-radius: var(--ui-radius-sm); background: var(--ui-subtle); color: var(--ui-muted); user-select: none; }
.ctx-demo-card b { display: block; color: var(--ui-fg); }
.ctx-demo-card svg { flex: none; width: 34px; height: 34px; color: var(--ui-accent); }
`

let context_menu_demo_items = [
    { label: "Open", shortcut: "Enter" },
    { label: "Rename", shortcut: "F2" },
    { label: "Duplicate", shortcut: "Ctrl D" },
    { label: "Share…", disabled: true },
    { divider: true },
    { label: "Copy link", shortcut: "Ctrl Shift C" },
    { label: "Download", shortcut: "Ctrl S" },
    { divider: true },
    { label: "Delete", shortcut: "Del", tone: "danger" },
]

fn context_menu_demo_card(title: str, text: str) =
    <div.ctx-demo-card>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"
             aria-hidden="true"><path d="M6 2.5h8l4.5 4.5v14.5H6z"/><path d="M14 2.5V7h4.5M9 12h6M9 15.5h6"/></svg>
        <span><b>{title}</b>{text}</span>
    </div>

component ContextMenuDemoLive() {
    state last = null
    <div.demo-stack>
        <ContextMenu id="ctx-file" label="Actions on Roadmap.pdf" items={context_menu_demo_items}
                     on_select={(it) => { last = it.label }}>
            {context_menu_demo_card("Roadmap.pdf", "Right-click here, press and hold, or focus it and press Shift+F10.")}
        </ContextMenu>
        <p.demo-note>{last == null ? "No action yet." : `Chose “${last}”.`}</p>
    </div>
}

view ContextMenuDemo() =
    <div.demo-stack>
        <style>{context_menu_demo_css}</style>
        <ContextMenuDemoLive/>
        <ContextMenu id="ctx-links" label="Go to" items={[
            { label: "Context menu", href: "#context_menu" },
            { label: "Dropdown menu", href: "#dropdown_menu" },
            { divider: true },
            { label: "Back to the top", href: "#", shortcut: "Home" },
        ]}>
            {context_menu_demo_card("Links", "Placed straight in the page: its items are links.")}
        </ContextMenu>
    </div>

ui_gallery = ui_gallery | push({ slug: "context_menu", name: "ContextMenu", group: "Navigation",
    summary: "A menu where an area is right-clicked, held or Shift+F10 is pressed, with shortcuts, separators and the arrow keys.",
    tags: ["menu", "overlay", "interactive"],
    demo: ContextMenuDemo })
