component BillSplitterDemoLive() {
    state note = "Change something to see on_change."
    <div.demo-stack>
        <BillSplitter id="bill-splitter-demo-items" name="dinner" mode="items" currency="EUR" title="Dinner by items" tax={10} tip="5.00" tip_as="amount"
                      people={["Ana", "Ben"]} on_change={(r) => { note = `on_change: ${len(r.parts)} parts of ${r.total}, ${r.parts[0].name} pays ${r.parts[0].amount}.` }}
                      items={[{ name: "Pizza", price: "18.50", shared_by: ["Ana", "Ben"] }, { name: "Wine", price: 24, shared_by: ["Ben"] }]}/>
        <p.demo-note>{note}</p>
    </div>
}

view BillSplitterDemo() =
    <div.demo-stack>
        <BillSplitter id="bill-splitter-demo" subtotal="86.40" tax={8.25} tip={18} people={["Ana", "Ben", "Cy"]}/>
        <BillSplitterDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "bill_splitter", name: "BillSplitter", group: "Finance",
    summary: "Splits a bill with tax and tip equally, by shares or by items, cents shared out by largest remainder so the parts add up exactly.",
    tags: ["smart", "interactive", "finance", "bill", "split", "tip"], demo: BillSplitterDemo })
