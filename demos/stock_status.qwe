view StockStatusDemo() =
    <div.demo-stack>
        <div.demo-row style="gap: 24px">
            <StockStatus count={24}/>
            <StockStatus count={3}/>
            <StockStatus count={0}/>
            <StockStatus status="preorder" ships="2026-12-01"/>
            <StockStatus status="backorder" ships="2026-11-15" locale="en-GB"/>
        </div>
        <div.demo-row style="gap: 24px">
            <StockStatus count={120} show_count={true}/>
            <StockStatus count={8} low_at={10} size="sm"/>
            <StockStatus status="in" text="Ships today" size="sm"/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "stock_status", name: "StockStatus", group: "Commerce",
    summary: "In stock, only a few left, out of stock, pre-order or back-order, with a coloured dot and the count.",
    tags: ["commerce", "status", "feedback", "no-js"], demo: StockStatusDemo })
