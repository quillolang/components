view KpiCardDemo() =
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px">
        <KpiCard id="kpi-card-demo-mrr" label="Monthly recurring revenue" value="$128,400" change={8.2} change_suffix="%" period="vs last month"
                 trend={[91, 96, 102, 99, 110, 118, 128]} href="#mrr"/>
        <KpiCard id="kpi-card-demo-churn" label="Churn" value="2.1%" change={-0.4} change_suffix=" pts" period="vs last month" good="down"
                 trend={[3.1, 2.9, 3.0, 2.6, 2.5, 2.4, 2.1]} trend_kind="bars"/>
        <KpiCard id="kpi-card-demo-signups" label="Signups" value="1,284" change={0} period="vs yesterday" tone="info"
                 trend={[1210, 1250, 1190, 1284, 1284]} note="Updated 5 min ago"/>
        <KpiCard id="kpi-card-demo-errors" label="Errors, 24 h" value="312" change={41} change_suffix="%" good="down" tone="danger"
                 trend={[120, 140, 110, 180, 260, 312]} trend_kind="bars" href="#errors" link_label="See the log"/>
    </div>

ui_gallery = ui_gallery | push({ slug: "kpi_card", name: "KpiCard", group: "Data",
    summary: "A number with its label, the change since last period coloured by whether that is good, and a small trend as a line or bars.",
    tags: ["data", "dashboard", "card", "chart", "no-js"], demo: KpiCardDemo })
