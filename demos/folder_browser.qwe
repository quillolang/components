let folder_browser_demo_items = [
    { id: "docs", name: "Documents", kind: "folder" },
    { id: "pics", name: "Photos", kind: "folder" },
    { id: "empty", name: "Archive", kind: "folder" },
    { id: "notes", name: "notes.txt", size: 2300 },
    { id: "taxes", name: "Taxes", parent: "docs", kind: "folder" },
    { id: "lease", name: "Lease.pdf", parent: "docs", size: 1887436 },
    { id: "y26", name: "2026", parent: "taxes", kind: "folder" },
    { id: "receipt", name: "receipt.final.jpg", parent: "y26", size: 512, note: "From the scanner" },
    { id: "beach", name: "Beach.jpg", parent: "pics", size: 3355443 },
    { id: "lease2", name: "lease.pdf", parent: "pics", size: 1000 },
]

component FolderBrowserDemoLive() {
    state log = ""
    state refuse = false
    <div.demo-stack>
        <div.demo-phone id="folder-browser-screen">
            <FolderBrowser items={folder_browser_demo_items} root_name="My files"
                           on_open={(f) => { log = `open ${f.id}` }} on_folder={(id) => { log = `folder ${id}` }}
                           on_rename={(id, name) => { log = `rename ${id} ${name}`; !refuse }}
                           on_move={(id, to) => { log = `move ${id} ${to}`; !refuse }}/>
        </div>
        <p.demo-note id="folder-browser-log">{log}</p>
        <button id="folder-browser-refuse" type="button" hidden="true" @click={() => { refuse = !refuse }}>Refuse</button>
        <div id="folder-browser-bad" hidden="true"><FolderBrowser items={[null, 5, { id: 1 }, { id: "a", name: "Loop A", parent: "b" }, { id: "b", name: "Loop B", parent: "a" }, { id: "s", name: "Self", parent: "s" }, { id: "s", name: "Twice" }, { id: "u", name: "Unknown parent", parent: "nowhere", size: "big" }]}/><FolderBrowser items="none" start="nope"/></div>
    </div>
}

view FolderBrowserDemo() = <div.demo-stack><FolderBrowserDemoLive/></div>

ui_gallery = ui_gallery | push({ slug: "folder_browser", name: "FolderBrowser", group: "Mobile",
    summary: "Folders with breadcrumbs, a Back, and move and rename in sheets.",
    tags: ["mobile", "interactive", "files", "navigation", "tablet"],
    demo: FolderBrowserDemo })
