view HashtagDemo() =
    <div.demo-stack>
        <p.demo-note id="hashtag-demo-line" style="margin: 0; color: var(--ui-fg); font-size: 14px">
            Shipped the new tables today <Hashtag tag="quillo"/> <Hashtag tag="SQLite" count={310}/> <Hashtag tag="release notes" tone="neutral" size="sm"/>
        </p>
        <div.demo-narrow>
            <HashtagList title="Trending" base="#hashtag-" tags={[
                { tag: "quillo", count: 2400, trend: "up" }, { tag: "sqlite", count: 1200000 },
                { tag: "rust", count: 980, trend: "down" }, { tag: "postgres", count: 310, href: "#hashtag" }]}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "hashtag", name: "Hashtag", group: "Social",
    summary: "A #tag that links to its page, with an optional count, and HashtagList, the trending tags ranked with their post counts.",
    tags: ["social", "link", "list", "no-js"], demo: HashtagDemo })
