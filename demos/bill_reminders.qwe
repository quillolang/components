let bill_reminders_demo_bills = [
    { id: "card", name: "Credit card", amount: "120.40", day: 31, due: "2026-11-30" },
    { id: "water", name: "Water", amount: 41.17m, day: 28, due: "2026-10-28" },
    { id: "rent", name: "Rent", amount: 950m, day: 1, due: "2026-11-01" },
    { id: "tax", name: "Car tax", amount: 88m, due: "2026-11-03", once: true },
    { id: "power", name: "Electricity", amount: 63.05m, day: 2 },
    { id: "gym", name: "Gym", amount: 30m, day: 15 },
    { id: "bad", name: "Broken bill", amount: "abc", day: 99 },
    { id: "odd", name: "Odd one", amount: 5m, due: "not a date", day: 5 },
]

component BillRemindersDemoLive() {
    state log = "Nothing yet"
    state refuse = true
    <div.demo-stack>
        <BillReminders bills={bill_reminders_demo_bills} today="2026-11-01"
                       on_snooze={(b, until) => { log = `Snoozed ${b.id} to ${until}` }}
                       on_pay={(b) => {
                           if refuse {
                               refuse = false
                               return false
                           }
                           log = `Paid ${b.id} due ${b.due}`
                           js("Promise.resolve", true)
                       }}/>
        <p.demo-note id="billrem-log">{log}</p>
    </div>
}

view BillRemindersDemo() =
    <div.demo-stack>
        <BillRemindersDemoLive/>
        <div id="billrem-leap"><BillReminders today="2028-01-31" bills={[{ id: "a", name: "Leap", amount: 1m, day: 31 }]}/></div>
        <div id="billrem-none"><BillReminders today="2026-11-01"/></div>
        <div id="billrem-noday"><BillReminders today="nonsense" bills={[{ id: "a", name: "Lost", amount: 1m, day: 3 }]}/></div>
    </div>

ui_gallery = ui_gallery | push({ slug: "bill_reminders", name: "BillReminders", group: "Mobile",
    summary: "Upcoming bills in order, marked when close, to pay or snooze, with the ends of months handled.",
    tags: ["mobile", "interactive", "banking", "bills", "swipe", "tablet"],
    needs: ["price", "button"],
    demo: BillRemindersDemo })
