let editable_table_demo_stock = [
    { sku: "KB-01", name: "Mechanical keyboard", qty: 14, size: "Full", active: true, restock: "2026-11-20" },
    { sku: "MS-02", name: "Wireless mouse", qty: 0, size: null, active: true, restock: "2026-11-04" },
    { sku: "CB-USB", name: "USB-C cable", qty: 120, size: "1 m", active: true, restock: null },
    { sku: "ST-09", name: "Monitor stand", qty: 6, size: null, active: false, restock: null },
]

let editable_table_demo_columns = [
    { key: "sku", label: "SKU", required: true, sortable: true, width: "110px" },
    { key: "name", label: "Product", required: true, sortable: true },
    { key: "qty", label: "Qty", type: "number", min: 0, max: 9999, sortable: true, width: "90px" },
    { key: "size", label: "Size", type: "select", options: ["1 m", "2 m", "Compact", "Full"], width: "110px" },
    { key: "active", label: "Active", type: "checkbox", width: "80px" },
    { key: "restock", label: "Restock on", type: "date", min: "2026-01-01", sortable: true, width: "150px" },
]

component EditableTableDemoLive() {
    state log = []
    state total = 0
    <div.demo-stack>
        <EditableTable id="et-budget" label="Budget" can_add={true}
                       new_row={{ item: "", owner: "Ada", amount: 0, approved: false }}
                       rows={[
                           { item: "Laptops", owner: "Grace", amount: 7200, approved: true },
                           { item: "Conference", owner: "Ada", amount: 1850.5, approved: false },
                       ]}
                       columns={[
                           { key: "item", label: "Item", required: true },
                           { key: "owner", label: "Owner", type: "select", options: ["Ada", "Grace", "Linus"], required: true },
                           { key: "amount", label: "Amount", type: "number", min: 0 },
                           { key: "approved", label: "Approved", type: "checkbox" },
                           { key: "code", label: "Code", readonly: true },
                       ]}
                       on_cell={(i, k, v) => { log = take(push(log, `row ${i + 1}: ${k} = ${v}`) | reverse, 3) | reverse }}
                       on_change={(rows) => { total = sum(rows | map((r) => r.amount ?? 0)) }}/>
        <p.demo-note>{len(log) == 0 ? "Edit a cell." : join(log, " · ")} {total > 0 ? `Total: ${total}` : ""}</p>
    </div>
}

view EditableTableDemo() =
    <div.demo-stack>
        <EditableTable id="et-stock" label="Stock" name="stock" can_add={true} can_delete={true}
                       rows={editable_table_demo_stock} columns={editable_table_demo_columns}/>
        <EditableTableDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "editable_table", name: "EditableTable", group: "Data",
    summary: "A grid edited in place: text, number, select, checkbox and date cells, checked, sorted, with rows added and deleted.",
    demo: EditableTableDemo })
