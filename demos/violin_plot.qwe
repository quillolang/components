// n numbers from a seeded generator (the same on every run), each the mean of two
// draws, around `mid` and `spread` either side.
fn violin_plot_demo_values(seed: int, n: int, mid: num, spread: num) -> list {
    let s = seed
    let out = []
    while len(out) < n {
        let total = 0
        for k in range(2) {
            s = (s * 1103515245 + 12345) % 2147483648
            total += s / 2147483648
        }
        out = push(out, round(mid + (total - 1) * spread))
    }
    out
}

view ViolinPlotDemo() =
    <div.demo-stack>
        <ViolinPlot label="Session length by device" show_label={true} suffix=" min" zero={true}
                    groups={[{ name: "Mobile", values: violin_plot_demo_values(5, 120, 6, 5) },
                             { name: "Tablet", values: violin_plot_demo_values(9, 80, 11, 8) },
                             { name: "Desktop", values: violin_plot_demo_values(13, 70, 9, 6) + violin_plot_demo_values(17, 50, 26, 6) }]}/>
        <ViolinPlot label="Exam scores by class" show_label={true} box={false} bandwidth={4} height={200}
                    groups={[{ name: "Class A", values: [62, 71, 74, 78, 80, 81, 83, 85, 88, 90, 94] },
                             { name: "Class B", values: [45, 58, 61, 64, 66, 70, 72, 73, 75, 79, 82, 99] },
                             { name: "New class", values: [77] }]}/>
        <p.demo-note>Desktop has two kinds of visit, short and long, so its violin has two bulges; the new class has one score, a dot.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "violin_plot", name: "ViolinPlot", group: "Charts",
    summary: "The shape of each group's values as a mirrored kernel density, with quartiles and median inside and the numbers on hover.",
    tags: ["chart", "data", "no-js"],
    demo: ViolinPlotDemo })
