view InsetDemoBox(label: str, class: str, size = "md", axis: str = "both") =
    <div style="border: 1px dashed var(--ui-strong); border-radius: var(--ui-radius-sm)">
        <Inset size={size} axis={axis} class={class}>
            <div style="padding: 10px; background: var(--ui-accent-soft); color: var(--ui-accent); border-radius: var(--ui-radius-sm); font-size: 13px; text-align: center">{label}</div>
        </Inset>
    </div>

view InsetDemo() =
    <Grid columns={2}>
        <InsetDemoBox label="md: 16px all round" class="inset-demo-md"/>
        <InsetDemoBox label="xl: 40px all round" class="inset-demo-xl" size="xl"/>
        <InsetDemoBox label="lg, axis x: 24px at the sides only" class="inset-demo-x" size="lg" axis="x"/>
        <InsetDemoBox label="top sm, bottom xl" class="inset-demo-map" size={{ top: "sm", bottom: "xl" }}/>
    </Grid>

ui_gallery = ui_gallery | push({ slug: "inset", name: "Inset", group: "Layout",
    summary: "Room around what it holds, in the kit's sizes or pixels, on every side or only across or down.",
    tags: ["layout", "utility", "no-js"], demo: InsetDemo })
