component RetryBannerDemoLive() {
    state failed = []
    state mended = []
    state tries = 0
    state log = ""
    state cleared = 0
    state busy = false
    state gave_up = "Has not given up."
    // A pretend server, a moment away. Named, as js_new is not waited for in a function written
    // in the markup's prop.
    let load = (l) => {
        tries += 1
        log = `${log}${l.id} `
        let pause = js("Promise.resolve", js_new("Promise", (done) => { js("AbortSignal.timeout", 30).addEventListener("abort", (_e) => { done(true) }) }))
        if busy { return { retry_after: 3 } }
        pause && contains(mended, l.id)
    }
    <div.demo-stack>
        <RetryBanner id="rtry-demo" loads={failed} base_ms={1000} limit_ms={4000} jitter={0} on_retry={load} on_clear={() => {
            cleared += 1
            failed = []
        }}/>
        <div.demo-row>
            <Button size="lg" variant="outline" id="rtry-fail" on_click={() => { failed = [{ id: "prices", label: "Prices" }, "Stock"]; mended = [] }}>Fail two loads</Button>
            <Button size="lg" variant="outline" id="rtry-mend-a" on_click={() => { mended = mended | push("prices") }}>Mend prices</Button>
            <Button size="lg" variant="outline" id="rtry-mend-b" on_click={() => { mended = mended | push("Stock") }}>Mend stock</Button>
            <Button size="lg" variant="outline" id="rtry-busy" on_click={() => { busy = !busy }}>{busy ? "Server is back" : "Server says wait"}</Button>
            <Button size="lg" variant="outline" id="rtry-none" on_click={() => { failed = [] }}>The page drops them</Button>
        </div>
        <p.demo-note id="rtry-tries">{`Tries: ${tries}.`}</p>
        <p.demo-note id="rtry-log">{log}</p>
        <p.demo-note id="rtry-cleared">{`Cleared: ${cleared}.`}</p>
        <RetryBanner id="rtry-stops" loads={["Photos"]} base_ms={300} factor={1} jitter={0} max_tries={2} on_retry={(_l) => { false }} on_give_up={(ls) => { gave_up = `Gave up on ${len(ls)}.` }}/>
        <p.demo-note id="rtry-gave">{gave_up}</p>
    </div>
}

view RetryBannerDemo() = <RetryBannerDemoLive/>

ui_gallery = ui_gallery | push({ slug: "retry_banner", name: "RetryBanner", group: "Mobile",
    summary: "Failed loads with a back-off shown as a countdown, a Try now, cleared on success.",
    tags: ["mobile", "interactive", "offline", "retry", "feedback", "tablet"],
    demo: RetryBannerDemo })
