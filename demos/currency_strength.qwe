view CurrencyStrengthDemo() =
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 12px; align-items: start">
        <CurrencyStrength id="currency-strength-demo" period="Today" pairs={[
            { pair: "EUR/USD", change: 0.22m }, { pair: "GBP/USD", change: -0.21m }, { pair: "USD/JPY", change: -0.42m },
            { pair: "USD/CHF", change: 0m }, { pair: "AUD/USD", change: 0.35m }, { pair: "USD/CAD", change: -0.12m },
            { pair: "EUR/GBP", change: 0.08m }, { pair: "EUR/JPY", change: 0.18m }, { pair: "GBP/JPY", change: -0.05m },
            { pair: "AUD/JPY", change: 0.40m },
        ]}/>
        <CurrencyStrength id="currency-strength-demo-score" label="Strength score, 0 to 10" period="Past week" decimals={1}
                          values={{ USD: 6.8m, EUR: 5.1m, GBP: 5.6m, JPY: 3.4m, CHF: 7.2m }}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "currency_strength", name: "CurrencyStrength", group: "Finance",
    summary: "The relative strength of the major currencies as bars, strongest first, given or worked out from pairs' changes.",
    tags: ["finance", "forex", "chart", "dashboard", "no-js"], demo: CurrencyStrengthDemo })
