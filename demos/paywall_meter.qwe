view PaywallMeterDemo() =
    <div.demo-stack style="gap: 20px">
        <PaywallMeter id="paywall-meter-demo-bar" used={2} limit={5} subscribe_href="#subscribe" signin_href="#login"/>
        <PaywallMeter id="paywall-meter-demo-last" used={5} limit={5} subscribe_href="#subscribe"/>
        <div style="padding-top: 70px">
            <PaywallMeter id="paywall-meter-demo-gate" used={6} limit={5} price={1.00m} price_period="week"
                          benefits={["Unlimited articles on any device", "The daily crossword and the archive since 1921", "Cancel anytime"]}
                          resets="Your free articles come back on Nov 1." subscribe_href="#subscribe?offer=intro" signin_href="#login"/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "paywall_meter", name: "PaywallMeter", group: "News",
    summary: "A metered paywall: a slim bar counting the free articles read, a warning on the last, then the gate with the offer, its price, benefits and sign-in.",
    tags: ["news", "subscription", "commerce", "banner", "no-js"], demo: PaywallMeterDemo })
