component AlphabetIndexDemoLive() {
    state at = "C"
    <div.demo-stack>
        <AlphabetIndex id="alphabet-index-demo-live" present={["A", "B", "C", "E", "G", "L", "M", "P", "S", "T", "W"]} current={at}
                       hash={false} on_select={(l) => { at = l }}/>
        <p.demo-note>Showing names starting with {at}.</p>
    </div>
}

view AlphabetIndexDemo() =
    <div.demo-stack style="gap: 20px">
        <AlphabetIndex id="alphabet-index-demo" present={["a", "b", "d", "f", "h", "k", "m", "n", "r", "s", "#"]} href="#alpha-{letter}"/>
        <AlphabetIndexDemoLive/>
        <AlphabetIndex label="Greek" letters="ΑΒΓΔΕΖΗΘΙΚΛΜΝΞΟΠΡΣΤΥΦΧΨΩ" hash={false} href="#greek-{letter}"/>
    </div>

ui_gallery = ui_gallery | push({ slug: "alphabet_index", name: "AlphabetIndex", group: "Navigation",
    summary: "A to Z links into a list sorted by name; letters with nothing under them stay in place, disabled.",
    tags: ["navigation", "link", "list", "no-js"], demo: AlphabetIndexDemo })
