component MobileNavDemoLive() {
    state shown = false
    <div.demo-row>
        <MobileNav id="mobile-nav-demo" brand="Acme" wide={true} current="#mobile_nav" on_toggle={(o) => { shown = o }} items={[
            { label: "Home", href: "#home", icon: "M3 11 12 3l9 8M5 9.5V21h14V9.5" },
            { label: "Products", icon: "M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z", items: [
                { label: "Editor", href: "#editor" }, { label: "Components", href: "#mobile_nav" }, { label: "Hosting", href: "#hosting" }
            ] },
            { label: "Resources", icon: "📚", items: [{ label: "Docs", href: "#docs" }, { label: "Blog", href: "#blog" }] },
            { label: "Pricing", href: "#pricing", icon: "🏷" },
            { label: "Inbox", href: "#inbox", icon: "✉", badge: 4 }
        ]}>
            <Button full={true} variant="outline" href="#mobile_nav">Sign in</Button>
            <Button full={true} href="#mobile_nav">Start free</Button>
        </MobileNav>
        <span.demo-note>{shown ? "The menu is open over the page." : "Click the menu button: the navigation covers the screen."}</span>
    </div>
}

view MobileNavDemo() =
    <div.demo-stack>
        <MobileNavDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "mobile_nav", name: "MobileNav", group: "Navigation",
    summary: "A menu button that opens the site's navigation over the whole screen, as a dialog: groups, the current page, actions at the bottom.",
    tags: ["navigation", "mobile", "menu", "dialog", "interactive"], demo: MobileNavDemo })
