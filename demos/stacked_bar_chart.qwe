let stacked_bar_chart_demo_grid = "display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 32px 40px"

view StackedBarChartDemo() =
    <div style={stacked_bar_chart_demo_grid}>
        <StackedBarChart label="Revenue by channel" show_label={true} prefix="$" value_labels={true} height={200}
                         labels={["Jan", "Feb", "Mar", "Apr", "May", "Jun"]}
                         series={[{ name: "Online", values: [42100, 45800, 51200, 49900, 56300, 61750] },
                                  { name: "Stores", values: [30500, 29800, 31200, 28700, 27900, 30100] },
                                  { name: "Partners", values: [8200, 9100, 7600, 10400, 11800, 12500] }]}/>
        <StackedBarChart label="Tickets by kind" show_label={true} percent={true} height={200}
                         labels={["Support", "Billing", "Sales", "Ops"]}
                         series={[{ name: "Question", values: [120, 45, 80, 12] },
                                  { name: "Bug", values: [64, 8, 3, 40] },
                                  { name: "Request", values: [30, 22, 41, 18] }]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "stacked_bar_chart", name: "StackedBarChart", group: "Charts",
    summary: "Bars of parts piled up to a total, or each scaled to 100% to compare shares, with the parts and total on hover.",
    tags: ["chart", "data", "dashboard", "no-js"],
    demo: StackedBarChartDemo })
