component BudgetPlannerDemoLive() {
    state note = "Change something to see on_change."
    <div.demo-stack>
        <BudgetPlanner id="budget-planner-demo-live" name="trip" title="A 60/25/15 month" currency="EUR" income="2000" rule={[60, 25, 15]}
                       on_change={(b) => { note = `on_change: ${b.left_to_assign} left to assign of ${b.income}, ${len(b.envelopes)} envelopes.` }}
                       envelopes={[{ name: "Rent", kind: "needs", assigned: 1200, spent: 1200 }, { name: "Pension", kind: "savings", assigned: 200 }]}/>
        <p.demo-note>{note}</p>
    </div>
}

view BudgetPlannerDemo() =
    <div.demo-stack>
        <BudgetPlanner id="budget-planner-demo" income="5000"
                       envelopes={[{ name: "Rent", kind: "needs", assigned: 1500, spent: 1500 }, { name: "Groceries", kind: "needs", assigned: 600, spent: 640 },
                                   { name: "Transport", kind: "needs", assigned: 300, spent: 120 }, { name: "Dining", kind: "wants", assigned: 300, spent: 340 },
                                   { name: "Fun", kind: "wants", assigned: 400, spent: 150 }, { name: "Savings", kind: "savings", assigned: 800, spent: 800 }]}/>
        <BudgetPlannerDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "budget_planner", name: "BudgetPlanner", group: "Finance",
    summary: "Plans a month in envelopes with the 50/30/20 check, what is left to assign, overspending warnings and exact moves between envelopes.",
    tags: ["smart", "interactive", "finance", "budget", "envelopes", "planning"], demo: BudgetPlannerDemo })
