// The same answer a moment later, as a `server fn` gives it: a Promise.
fn rate_prompt_demo_late(answer) = js("Promise.resolve", js_new("Promise", (done) => { done(answer) }))

component RatePromptDemoLive() {
    state run = 0
    state moment = 0
    state days = 0
    state why = "Press Finish a task."
    state sent = ""
    state fail = false
    state busy = false
    state stars = 0
    state slow = false
    let now = 1793000000000 + days * 86400000
    <div.demo-stack>
        <div.demo-phone id="rate-prompt-demo-frame">
            <div style="padding: 20px; display: grid; gap: 12px">
                <p class="demo-note">The app. Day {days}. Asks after 7 days, 5 starts and 3 good moments.</p>
                <Button size="lg" id="rate-prompt-demo-task" on_click={() => { moment = moment + 1 }}>Finish a task</Button>
                <Button size="lg" variant="outline" id="rate-prompt-demo-start" on_click={() => { days = days + 1; run = run + 1 }}>Start again a day later</Button>
                <Button size="lg" variant="outline" id="rate-prompt-demo-week" on_click={() => { days = days + 100; run = run + 1 }}>Start again 100 days later</Button>
                <label><input type="checkbox" id="rate-prompt-demo-busy" bind:checked={busy}/> In the middle of something</label>
                <label><input type="checkbox" id="rate-prompt-demo-fail" bind:checked={fail}/> Sending fails</label>
                <label><input type="checkbox" id="rate-prompt-demo-slow" bind:checked={slow}/> Answers come as Promises</label>
            </div>
            <RatePrompt key={run} app_name="Fieldbook" remember="ui-demo-rate" moment={moment} version="2.3.0" now={now} ready={!busy}
                ios="https://apps.apple.com/app/id1234567890?action=write-review"
                android="https://play.google.com/store/apps/details?id=org.quillolang.fieldbook"
                web="https://quillolang.org/rate"
                on_problem={(t, s) => {
                    if !fail { sent = `${s}: ${t}` }
                    slow ? rate_prompt_demo_late(!fail) : !fail
                }}
                on_rated={(s) => { stars = s }}
                on_check={(w) => { why = w == "" ? "It asked." : `Not yet: ${w}.` }}/>
        </div>
        <p.demo-note id="rate-prompt-demo-why" data-sent={sent} data-stars={stars}>{why}</p>
    </div>
}

view RatePromptDemo() = <RatePromptDemoLive/>

ui_gallery = ui_gallery | push({ slug: "rate_prompt", name: "RatePrompt", group: "Mobile",
    summary: "Asks for a rating only after real use, with limits on how often, and a route to send a problem instead.",
    tags: ["mobile", "interactive", "tablet", "rating", "feedback", "store"],
    needs: ["force_update", "welcome_carousel"],
    demo: RatePromptDemo })
