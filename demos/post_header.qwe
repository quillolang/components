let post_header_demo_cover =
    `data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 800 400'%3E%3Crect width='800' height='400' fill='%23264a6e'/%3E%3Ccircle cx='620' cy='110' r='54' fill='%23f3b54a'/%3E%3Cpath d='M0 300 Q120 250 240 290 T480 280 T800 270 V400 H0z' fill='%2318794e'/%3E%3Cpath d='M0 340 Q160 310 320 340 T800 330 V400 H0z' fill='%230f5133'/%3E%3C/svg%3E`

view PostHeaderDemo() =
    <div.demo-stack style="gap: 40px">
        <PostHeader id="post-header-demo" title="Islands, resumed: how a page wakes up where the server left it"
                    subtitle="The browser takes the server's elements as its own instead of drawing them again. Here is what that means for forms, scrolling and images."
                    category="Engineering" category_href="#post_header-engineering"
                    authors={[{ name: "Ada Lovelace", href: "#post_header-ada" }, { name: "Grace Hopper" }, { name: "Margaret Hamilton", href: "#post_header-margaret" }]}
                    date="2026-10-14" updated="2026-10-20T08:15:00Z" words={1850} tags={["Quillo", "Browsers", "Deep dive"]}
                    tag_href="#post_header-tag-" image={post_header_demo_cover} image_alt="A sun over green hills"
                    caption="Illustration: the islands of a page, by Lin Wu."/>
        <PostHeader id="post-header-demo-short" title="Week notes: 43" author="Ben Okafor" date="2026-10-24" updated="2026-10-24"
                    read_time="2 min read" align="center" level={2} tags={["Week notes"]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "post_header", name: "PostHeader", group: "Blogging",
    summary: "The top of a post: category, title and standfirst, the authors with their pictures, published and updated dates, reading time, tags and a cover.",
    tags: ["blogging", "article", "typography", "header", "no-js"], demo: PostHeaderDemo })
