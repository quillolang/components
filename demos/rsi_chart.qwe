// Prices from a seeded random walk (Park–Miller), the same on every render: `count`
// candles from the day `from` on, skipping weekends, daily or hourly (10:00 to 16:00),
// rounded to `places` decimals.
fn rsi_chart_demo_walk(seed: int, count: int, start: num, from: str, hourly: bool = false, places: int = 2) -> list {
    let s = seed
    let rnd = () => {
        s = s * 16807 % 2147483647
        s / 2147483647
    }
    let scale = pow(10, places)
    let cut = (v) => round(v * scale) / scale
    let p = start
    let day = from
    let hour = 10
    let out = []
    while len(out) < count {
        if date.weekday(day) <= 5 {
            let open = cut(p * (1 + (rnd() - 0.5) * 0.006))
            let close = cut(open * (1 + (rnd() - 0.485) * (hourly ? 0.012 : 0.035)))
            let high = cut(max([open, close]) * (1 + rnd() * 0.01))
            let low = cut(min([open, close]) * (1 - rnd() * 0.01))
            let volume = round((hourly ? 90000 : 900000) * (1 + rnd() * 1.5 + abs(close - open) * 30 / open))
            out = out | push({ time: hourly ? `${day}T${hour < 10 ? "0" : ""}${hour}:00:00Z` : day, open, high, low, close, volume })
            p = close
        }
        if hourly && hour < 16 && date.weekday(day) <= 5 {
            hour += 1
        } else {
            hour = 10
            day = date.add_days(day, 1)
        }
    }
    out
}

let rsi_chart_demo_daily = rsi_chart_demo_walk(29, 120, 142.8, "2026-04-01")

view RsiChartDemo() =
    <div.demo-stack>
        <div id="rsi_chart-demo-price">
            <RsiChart label="Stark Industries, RSI 14" show_label={true} candles={rsi_chart_demo_daily} prefix="$"/>
        </div>
        <div id="rsi_chart-demo-alone">
            <RsiChart label="RSI 5, 80 and 20 lines, on its own" show_label={true} candles={rsi_chart_demo_daily}
                      period={5} overbought={80} oversold={20} price={false}/>
        </div>
        <p.demo-note>The RSI line turns red when overbought and green when oversold; hover for the close and RSI.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "rsi_chart", name: "RsiChart", group: "Charts",
    summary: "The relative strength index of closing prices with overbought and oversold lines, under a price chart or on its own.",
    tags: ["chart", "data", "trading", "no-js"],
    demo: RsiChartDemo })
