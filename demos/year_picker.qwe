component YearPickerDemoLive() {
    state year = null
    <div.demo-stack>
        <YearPicker name="yp-demo-grad" label="Graduated" inline={true} today={2026} latest={2030} on_change={(y) => { year = y }}/>
        <p.demo-note>{year == null ? "No year picked." : `Class of ${year}.`}</p>
    </div>
}

view YearPickerDemo() {
    <div.demo-stack>
        <div.demo-row>
            <YearPicker name="yp-demo-model" label="Model year" value={2019} earliest={1990} latest={2027} today={2026}/>
            <YearPicker name="yp-demo-sm" label="Year" size="sm" today={2026} error="Choose a year."/>
        </div>
        <YearPickerDemoLive/>
    </div>
}

ui_gallery = ui_gallery | push({ slug: "year_picker", name: "YearPicker", group: "Forms",
    summary: "A year picked from a grid of a decade, turned ten years at a time, from a button or in the page.",
    tags: ["forms", "picker", "calendar", "keyboard", "interactive"], demo: YearPickerDemo })
