// Three silent seconds each, 90 by 160: small enough to sit in the page.
let short_video_feed_demo_v1 = "data:video/mp4;base64,"
let short_video_feed_demo_v2 = "data:video/mp4;base64,"
let short_video_feed_demo_v3 = "data:video/mp4;base64,"
let short_video_feed_demo_v4 = "data:video/mp4;base64,"

fn short_video_feed_demo_poster(fill: str) =
    "data:image/svg+xml," + url_encode(`<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 90 160'><rect width='90' height='160' fill='${fill}'/></svg>`)

let short_video_feed_demo_clips = [
    { id: "c1", src: short_video_feed_demo_v1, poster: short_video_feed_demo_poster("#3d5a80"), title: "Bread in one minute", author: "Ada Reyes", likes: 950 },
    { id: "c2", src: short_video_feed_demo_v2, poster: short_video_feed_demo_poster("#ee6c4d"), title: "The knot that holds", author: "Sea Area", likes: 1249 },
    { id: "c3", src: short_video_feed_demo_v3, poster: short_video_feed_demo_poster("#6d8f71"), title: "Repotting a fern", author: "Tomas Lind", likes: 3412000 },
    { id: "c4", src: short_video_feed_demo_v4, poster: short_video_feed_demo_poster("#7a5195"), title: "Tuning a bike chain", author: "Noor Haddad" },
    { id: "c5", src: short_video_feed_demo_v1, poster: short_video_feed_demo_poster("#293241"), title: "A broken clip", author: "Nobody" },
    { id: "c6", src: short_video_feed_demo_v2, poster: short_video_feed_demo_poster("#98c1d9"), title: "Folding a map", author: "Ada Reyes" },
]

component ShortVideoFeedDemoLive() {
    state seen = "none"
    state likes = 0
    state turn = 0
    state clips = short_video_feed_demo_clips
    <div.demo-stack>
        <div.demo-phone style="--ui-svfeed-height: 100%">
            <ShortVideoFeed key={turn} clips={clips} on_change={(i) => { seen = `${i}` }} on_like={(c, on) => { likes += on ? 1 : -1 }}/>
        </div>
        <p.demo-note id="svfeed-demo-note">Settled on {seen}; {likes} likes</p>
        <div.demo-row>
            <Button id="svfeed-demo-again" size="lg" variant="ghost" on_click={() => { turn += 1 }}>Make it again</Button>
            <Button id="svfeed-demo-bad" size="lg" variant="ghost" on_click={() => {
                clips = clips | map((c) => c.id == "c2" ? set(c, "src", "data:video/mp4;base64,AAAA") : c)
                turn += 1
            }}>Break the second clip</Button>
        </div>
        <div id="svfeed-demo-none" style="--ui-svfeed-height: 120px"><ShortVideoFeed clips={[{ title: "no src" }, 5]}/></div>
    </div>
}

view ShortVideoFeedDemo() = <ShortVideoFeedDemoLive/>

ui_gallery = ui_gallery | push({ slug: "short_video_feed", name: "ShortVideoFeed", group: "Mobile",
    summary: "Vertical swipes of clips: one plays at a time, the next loads ahead, sound behaves, and a refused autoplay shows a button.",
    tags: ["mobile", "interactive", "media", "video", "feed", "tablet"],
    demo: ShortVideoFeedDemo })
