view BannerDemo() =
    <div.demo-stack>
        <Banner href="#banner" link="See what's new">Quillo 1.0 is out: live queries, typed records and a debugger.</Banner>
        <Banner tone="warning" title="Maintenance" remember="demo-maintenance">Sunday 02:00–03:00 UTC: the dashboard will be read-only.</Banner>
        <Banner tone="success" variant="soft" href="#banner" link="Read the report">Your data export is ready.</Banner>
        <Banner tone="danger" dismissable={false}>Payments are delayed by up to an hour. We're on it.</Banner>
        <Banner tone="neutral" variant="soft" title="Heads up">This is a preview environment; data resets every night.</Banner>
    </div>

ui_gallery = ui_gallery | push({ slug: "banner", name: "Banner", group: "Feedback",
    summary: "An announcement across the top of the page in six tones, with a link, closed for the session once dismissed.",
    tags: ["feedback", "notification", "page", "no-js"],
    demo: BannerDemo })
