view PostUpdatesDemo() =
    <div.demo-stack style="max-width: 680px">
        <PostUpdates id="post-updates-demo" published="2026-10-14" updates={[
            { date: "2026-10-20", kind: "addition", text: "Added a section on [prefetching](#post_updates-prefetch), after questions from readers." },
            { date: "2026-10-28T09:30:00Z", kind: "correction", text: "The runtime is **11 KB** gzipped, not 15 KB as first written." },
            { date: "2026-10-16", text: "Fixed the example's `every` call, which took its arguments the wrong way round." },
        ]}/>
        <PostUpdates id="post-updates-demo-plain" published="2026-09-02"
                     updates={[{ date: "2026-09-05", text: "Linked the talk this post was based on." }]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "post_updates", name: "PostUpdates", group: "Blogging",
    summary: "The note that a post changed since it came out: Updated Oct 28, how many changes, and each one newest first, with corrections marked.",
    tags: ["blogging", "history", "status", "article", "no-js"], demo: PostUpdatesDemo })
