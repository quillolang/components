view FlightResultDemo() =
    <div.demo-stack>
        <FlightResult id="flight-result-demo-stop" airline="TAP Air Portugal" flight="TP 1351 · TP 207" depart={{ code: "LHR", time: "07:45", city: "London" }}
                      arrive={{ code: "JFK", time: "13:10", city: "New York" }} minutes={745}
                      stops={[{ code: "LIS", city: "Lisbon", minutes: 110 }]} price={412.00m} old={468.00m} cabin="Economy" fare="Classic"
                      bags={{ cabin: true, checked: 1 }} tag="Best" href="#book-tp1351"/>
        <FlightResult id="flight-result-demo-night" airline="Quillo Air" flight="QA 88" depart={{ code: "OPO", time: "22:30", city: "Porto" }}
                      arrive={{ code: "FRA", time: "02:05", city: "Frankfurt", days: 1 }} minutes={155} price={89.99m} currency="EUR" locale="de-DE"
                      cabin="Economy" fare="Light" bags={{ cabin: false, checked: 0 }} tag="Cheapest" tag_tone="success" seats_left={3} action="#select"/>
        <FlightResult id="flight-result-demo-two" airline="Nordic Wings" depart={{ code: "CPH", time: "06:10", city: "Copenhagen" }}
                      arrive={{ code: "SIN", time: "07:55", city: "Singapore", days: 1 }} minutes={1125} price={1240} per="2 travellers"
                      stops={[{ code: "HEL", city: "Helsinki", minutes: 85 }, { code: "DXB", city: "Dubai" }]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "flight_result", name: "FlightResult", group: "Travel",
    summary: "A flight in search results: departure and arrival times, the time in the air, stops and layovers, cabin and bags, and the fare with Select.",
    tags: ["travel", "flights", "card", "commerce", "no-js"], demo: FlightResultDemo })
