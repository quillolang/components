component SeoPreviewDemoLive() {
    state got = "Not changed yet."
    <div.demo-stack>
        <SeoPreview name="post" slug="2026/islands-resumed" site="Quillo blog" base_url="https://blog.example.com/"
                    fallback="Islands, resumed: how a page wakes up where the server left it"
                    description="The browser takes the server's elements as its own instead of drawing them again."
                    on_change={(m) => { got = `${len(m.title)} + ${len(m.description)} characters` }}/>
        <p.demo-note id="seo-preview-demo-note">{got}</p>
    </div>
}

view SeoPreviewDemo() = <SeoPreviewDemoLive/>

ui_gallery = ui_gallery | push({ slug: "seo_preview", name: "SeoPreview", group: "Blogging",
    summary: "A post's title and description for search and sharing, with counts that say short, good or too long, and a live search result and link card.",
    tags: ["blogging", "forms", "editor", "seo", "interactive"], demo: SeoPreviewDemo })
