let kanban_board_demo_columns = [
    { id: "backlog", title: "Backlog", cards: [
        { id: "c1", title: "Export invoices as CSV", tags: ["billing"] },
        { id: "c2", title: "Dark mode for the dashboard", note: "Follow the system setting.", tags: ["ui"] },
        { id: "c3", title: "Rate-limit the login form", tags: ["security"] },
    ] },
    { id: "doing", title: "In progress", limit: 2, cards: [
        { id: "c4", title: "Search across projects", note: "Ada", tags: ["search"] },
        { id: "c5", title: "Upgrade to Postgres 17", note: "Grace", tags: ["ops"] },
    ] },
    { id: "review", title: "Review", cards: [
        { id: "c6", title: "Keyboard shortcuts help", tags: ["ui", "a11y"] },
    ] },
    { id: "done", title: "Done", cards: [] },
]

component KanbanBoardDemoLive() {
    state cols = kanban_board_demo_columns
    <div.demo-stack>
        <KanbanBoard id="kb-sprint" label="Sprint 14" columns={cols} on_change={(next) => { cols = next }}/>
        <p.demo-note>{join(cols | map((c) => `${c.title}: ${len(c.cards)}`), " · ")}</p>
    </div>
}

view KanbanBoardDemo() = <KanbanBoardDemoLive/>

ui_gallery = ui_gallery | push({ slug: "kanban_board", name: "KanbanBoard", group: "Data",
    summary: "Columns of cards moved by dragging, by keyboard (Space, the arrows, Space) or with each card's arrows.",
    tags: ["data", "drag", "list", "interactive"],
    demo: KanbanBoardDemo })
