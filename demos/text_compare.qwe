let text_compare_demo_before = "The quick brown fox jumps over the lazy dog. It was a sunny day, and nobody minded."
let text_compare_demo_after = "The quick red fox leaps over the lazy dog. It was a rainy day, and nobody minded at all."

component TextCompareDemoLive() {
    state similar = null
    <div.demo-stack>
        <TextCompare id="text-compare-demo-live" before="Draft one of the note." after="Draft two of the note." before_label="First draft" after_label="Second draft" before_name="first" after_name="second" rows={2} mode="side"
                     on_change={(r) => { similar = r.similarity }}/>
        <p.demo-note>{similar == null ? "Change a draft to see on_change." : `on_change: ${similar}% similar.`}</p>
    </div>
}

view TextCompareDemo() =
    <div.demo-stack>
        <TextCompare id="text-compare-demo" before={text_compare_demo_before} after={text_compare_demo_after}/>
        <TextCompareDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "text_compare", name: "TextCompare", group: "Typography",
    summary: "Compares two texts word by word with its own LCS diff: insertions and deletions marked, similarity and counts, ignoring case or spacing, inline or side by side.",
    tags: ["smart", "interactive", "diff", "compare", "text", "revision"], needs: ["readability_meter"], demo: TextCompareDemo })
