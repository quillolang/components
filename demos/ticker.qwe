let ticker_demo_news = [
    { text: "Quillo 0.5 ships with live data over one WebSocket", href: "https://quillolang.org/blog/0.5" },
    "Rain expected along the coast tonight",
    { text: "Final: Benfica 2 – 1 Porto", href: "https://example.com/match" },
    "Metro line B closed this weekend for works",
    "Markets open higher after a quiet night",
]

view TickerDemo() =
    <div.demo-stack>
        <Ticker label="Breaking" items={ticker_demo_news} speed={28}/>
        <Ticker label="Live" tone="danger" speed={40} items={["Vote count at 62%", "Turnout 71%", "Results at 22:00"]}/>
        <Ticker label="Status" tone="success" items={["All systems normal", "Last incident 41 days ago"]} name="Service status"/>
    </div>

ui_gallery = ui_gallery | push({ slug: "ticker", name: "Ticker", group: "Media",
    summary: "A news ticker: a labelled strip of headlines sliding past, each a link when it has one, in CSS alone.",
    tags: ["animation", "news", "media", "no-js"], demo: TickerDemo })
