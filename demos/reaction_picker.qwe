component ReactionPickerDemoLive() {
    state last = null
    <div.demo-stack>
        <ReactionPicker id="react-demo" name="reaction" reactions={[
            { emoji: "👍", label: "Thumbs up", count: 12, mine: true },
            { emoji: "❤️", label: "Heart", count: 4 },
            { emoji: "🎉", label: "Party", count: 1, mine: true },
        ]} choices={[{ emoji: "👍", label: "Thumbs up" }, { emoji: "❤️", label: "Heart" }, { emoji: "🎉", label: "Party" },
                    { emoji: "😄", label: "Laugh" }, { emoji: "🤔", label: "Thinking" }, { emoji: "🚀", label: "Rocket" }]}
            on_change={(e, on) => { last = `${on ? "Added" : "Removed"} ${e}` }}/>
        <p.demo-note>{last ?? "Tap one to react."}</p>
    </div>
}

view ReactionPickerDemo() =
    <div.demo-stack>
        <ReactionPickerDemoLive/>
        <ReactionPicker id="react-demo-one" single={true} size="sm" reactions={[
            { emoji: "👍", label: "Agree", count: 8, mine: true }, { emoji: "👎", label: "Disagree", count: 2 }, { emoji: "🤷", label: "Not sure", count: 1 },
        ]}/>
        <p.demo-note>The second is single: picking one moves your reaction.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "reaction_picker", name: "ReactionPicker", group: "Actions",
    summary: "A row of emoji reactions with counts, one tap to react or take it back, and a menu to add another.",
    tags: ["button", "social", "comment", "interactive"],
    demo: ReactionPickerDemo })
