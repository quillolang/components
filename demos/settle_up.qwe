component SettleUpDemoLive() {
    state note = "Change something to see on_change."
    <div.demo-stack>
        <SettleUp id="settle-up-demo-few" name="few" title="Five friends" people={["Ana", "Ben", "Cy", "Dee", "Eli"]}
                  on_change={(r) => { note = `on_change: ${len(r.transfers)} transfers, the first ${r.transfers[0].from} to ${r.transfers[0].to}, ${r.transfers[0].amount}.` }}
                  expenses={[{ what: "Lunch", amount: 5, paid_by: "Ana", shared_by: ["Cy"] }, { what: "Parking", amount: 3, paid_by: "Ana", shared_by: ["Dee"] },
                             { what: "Tickets", amount: 7, paid_by: "Ben", shared_by: ["Eli"] }]}/>
        <p.demo-note>{note}</p>
    </div>
}

view SettleUpDemo() =
    <div.demo-stack>
        <SettleUp id="settle-up-demo" title="Weekend away" people={["Ana", "Ben", "Cy", "Dee"]}
                  expenses={[{ what: "Hotel", amount: "300.00", paid_by: "Ana" }, { what: "Dinner", amount: "100.00", paid_by: "Ben" },
                             { what: "Taxi", amount: "20.00", paid_by: "Cy", shared_by: ["Cy", "Dee"] }]}/>
        <SettleUpDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "settle_up", name: "SettleUp", group: "Finance",
    summary: "Works out each person's balance from shared expenses and the fewest transfers that settle the group, exact to the cent.",
    tags: ["smart", "interactive", "finance", "expenses", "split", "group"], demo: SettleUpDemo })
