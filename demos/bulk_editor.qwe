let bulk_editor_demo_rows = [
    { id: 1, sku: "A-1", name: "Steel bolt", price: 0.10m, stock: 120, status: "active" },
    { id: 2, sku: "A-2", name: "STEEL nut", price: 0.07m, stock: 340, status: "active" },
    { id: 3, sku: "B-1", name: "Brass hinge", price: 2.35m, stock: 12, status: "draft" },
    { id: 4, sku: "B-2", name: "Brass hook", price: "1.20", stock: null, status: "draft" },
    { id: 5, sku: "C-1", name: "Saw", price: 19.99m, stock: 3, status: "active" },
    { id: 6, sku: "C-2", name: "Hammer", price: "ask", stock: 0, status: "retired" },
]

component BulkEditorDemoLive() {
    state log = null
    <div.demo-stack>
        <BulkEditor id="bulk-editor-demo-live" title="Live" rows={[{ id: "x", qty: 4 }, { id: "y", qty: 5 }]} columns={["qty"]}
                    on_apply={(c) => { log = c }}/>
        <p.demo-note>{log == null ? "Apply to see on_apply." : `on_apply: ${len(log)} change${len(log) == 1 ? "" : "s"}, ${log[0].id} from ${log[0].before} to ${log[0].after}.`}</p>
    </div>
}

view BulkEditorDemo() =
    <div.demo-stack>
        <BulkEditor id="bulk-editor-demo" rows={bulk_editor_demo_rows} name="products"
                    columns={[{ key: "sku", label: "SKU", editable: false }, { key: "name", label: "Name" }, { key: "price", label: "Price", type: "number" },
                              { key: "stock", label: "Stock", type: "number" }, { key: "status", label: "Status" }]}/>
        <BulkEditor id="bulk-editor-demo-empty" title="Nothing here" rows={["not a record"]}/>
        <BulkEditorDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "bulk_editor", name: "BulkEditor", group: "Data",
    summary: "Picks rows by checkbox or filter, then sets, replaces, prefixes, suffixes or adjusts a column, with a before and after preview, apply, undo and redo.",
    tags: ["smart", "interactive", "bulk", "edit", "undo", "table"], demo: BulkEditorDemo })
