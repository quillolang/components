view FormActionsDemo() =
    <div.demo-stack>
        <FormActions class="form-actions-demo-end">
            <Button variant="ghost" tone="neutral" type="button">Cancel</Button>
            <Button type="submit">Save changes</Button>
        </FormActions>
        <FormActions align="between" divider={true} class="form-actions-demo-between">
            <Button variant="outline" tone="neutral" type="button">Back</Button>
            <Button variant="ghost" tone="neutral" type="button">Save draft</Button>
            <Button type="submit">Next</Button>
        </FormActions>
        <FormActions align="start" note="Saved 2 minutes ago" class="form-actions-demo-start">
            <Button type="submit">Publish</Button>
            <Button variant="soft" tone="danger" type="button">Delete</Button>
        </FormActions>
        <FormActions align="center" class="form-actions-demo-center">
            <Button size="lg" type="submit">Continue</Button>
        </FormActions>
    </div>

ui_gallery = ui_gallery | push({ slug: "form_actions", name: "FormActions", group: "Forms",
    summary: "The row of submit and cancel buttons at the end of a form, aligned at the end, start, centre or both sides.",
    tags: ["forms", "button", "layout", "no-js"], demo: FormActionsDemo })
