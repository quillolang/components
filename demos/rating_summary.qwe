component RatingSummaryDemoLive() {
    state only = null
    <div.demo-stack>
        <RatingSummary id="rating-summary-demo-live" counts={{ "5": 61, "4": 22, "3": 9, "2": 3, "1": 5 }} picked={only} on_pick={(s) => { only = s }}/>
        <p.demo-note>{only == null ? "Showing all reviews." : `Showing ${only}-star reviews.`}</p>
    </div>
}

view RatingSummaryDemo() =
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 28px; align-items: start">
        <RatingSummary id="rating-summary-demo-plain" label="Kettle" counts={{ "5": 120, "4": 40, "3": 10, "2": 4, "1": 6 }}
                       hrefs={{ "5": "#rating_summary", "4": "#rating_summary" }}/>
        <RatingSummaryDemoLive/>
        <RatingSummary id="rating-summary-demo-compact" compact={true} average={4.8} counts={{ "5": 9, "4": 1 }}/>
        <RatingSummary id="rating-summary-demo-none" counts={{}}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "rating_summary", name: "RatingSummary", group: "Data",
    summary: "The average rating out of 5, how many ratings, and a bar per star count, each a filter button or link if you like.",
    tags: ["chart", "commerce", "social", "data", "no-js"],
    demo: RatingSummaryDemo })
