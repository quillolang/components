view TestimonialCardDemo() =
    <div.demo-stack>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px">
            <TestimonialCard id="testimonial-card-demo-ada" quote="Quillo cut our build time in half, and the components came with their keyboard and screen reader work done."
                             name="Ada Lovelace" title="CTO" company="Analytical Engines" rating={5}/>
            <TestimonialCard quote="We shipped the whole admin in a week. Forms that post without JavaScript are a relief."
                             name="Grace Hopper" title="Head of engineering" company="Navy Labs" src="https://i.pravatar.cc/80?img=47"
                             logo="https://dummyimage.com/220x56/5b4bdb/ffffff.png&text=NAVY+LABS"/>
        </div>
        <TestimonialCard variant="large" quote="The first framework where the server-rendered page and the live one are the same page."
                         name="Alan Turing" title="Researcher" company="Bletchley" rating={4}/>
        <TestimonialCard variant="plain" quote="Short, and to the point." name="Plato"/>
    </div>

ui_gallery = ui_gallery | push({ slug: "testimonial_card", name: "TestimonialCard", group: "Data",
    summary: "A customer's quote with their picture, name, title and company or logo, and stars if they gave some.",
    tags: ["card", "marketing", "social", "user", "no-js"],
    needs: ["avatar"],
    demo: TestimonialCardDemo })
