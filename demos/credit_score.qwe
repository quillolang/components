view CreditScoreDemo() {
    <div.demo-stack>
        <CreditScore id="credit-score-demo-good" score={712} change={14} period="since last month" updated="2026-10-01" source="ClearView Credit"
                     factors={[
                         { label: "Payment history", value: "100% on time", effect: "good", impact: "high" },
                         { label: "Credit card use", value: "38% of limits", effect: "bad", impact: "high", note: "Keeping it under 30% helps." },
                         { label: "Age of credit", value: "6 yrs 4 mos", effect: "neutral", impact: "medium" },
                         { label: "Hard inquiries", value: "2 this year", effect: "bad", impact: "low", note: "Each one counts for two years." },
                         { label: "Total accounts", value: "9", effect: "good", impact: "low" },
                     ]}/>
        <div.demo-row style="align-items: stretch">
            <div style="flex: 1 1 300px; max-width: 420px">
                <CreditScore id="credit-score-demo-poor" score={548} change={-23} period="since last quarter" label="Your credit score"/>
            </div>
            <div style="flex: 1 1 300px; max-width: 420px">
                <CreditScore id="credit-score-demo-scale" score={961} low={0} high={999} change={0} source="Meridian Bureau" updated="2026-09-12" locale="en-GB"
                             bands={[{ label: "Poor", from: 0 }, { label: "Fair", from: 439 }, { label: "Good", from: 721 }, { label: "Excellent", from: 961 }]}/>
            </div>
        </div>
    </div>
}

ui_gallery = ui_gallery | push({ slug: "credit_score", name: "CreditScore", group: "Finance",
    summary: "A credit score on a gauge of its bands from poor to excellent, the band it falls in, the change since the last report and the factors that move it.",
    tags: ["finance", "loans", "chart", "dashboard", "no-js"], demo: CreditScoreDemo })
