view StepsDemo() =
    <div.demo-stack style="gap: 32px">
        <Steps steps={["Account", "Shipping", "Payment", "Review"]} current={2}/>
        <div.demo-row>
            <Steps vertical={true} current={2} steps={[{ label: "Order placed", hint: "May 2, 09:14" },
                   { label: "Shipped", hint: "May 3, from Lisbon" }, { label: "Out for delivery", hint: "Today" },
                   { label: "Delivered" }]}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "steps", name: "Steps", group: "Navigation",
    summary: "How far along a process is: steps done with a check mark, this one, and those to come; across or down.",
    demo: StepsDemo })
