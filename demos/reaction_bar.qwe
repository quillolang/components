component ReactionBarDemoLive() {
    state note = "No change yet."
    <div.demo-stack id="reaction-bar-demo">
        <ReactionBar id="reaction-bar-first" reactions={[{ emoji: "👍", label: "Like", count: 3 }, { emoji: "❤️", label: "Love", count: 1 }]}
                     on_change={(e, rows) => { note = `${e ?? "none"}: ${join(rows | map((r) => `${r.label} ${r.count}`), ", ")}` }}>
            <MessageBubble name="Ana Silva" time="09:41">The crane is booked for Monday at eight.</MessageBubble>
        </ReactionBar>
        <ReactionBar id="reaction-bar-mine" mine="😂" reactions={[{ emoji: "😂", label: "Funny", count: 2 }, { emoji: "🦆", label: "Duck", count: 4 }]}>
            <MessageBubble mine={true} time="09:42">And I will bring the ducks.</MessageBubble>
        </ReactionBar>
        <p.demo-note id="reaction-bar-note" role="status">{note}</p>
    </div>
}

view ReactionBarDemo() = <ReactionBarDemoLive/>

ui_gallery = ui_gallery | push({ slug: "reaction_bar", name: "ReactionBar", group: "Mobile",
    summary: "A long press raises a bar of reactions to slide along and pick from, one for each person, with counts, and a route for keys.",
    tags: ["mobile", "interactive", "chat", "reactions", "gesture", "emoji"], demo: ReactionBarDemo })
