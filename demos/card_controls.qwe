component CardControlsDemoLive() {
    state said = ""
    <div.demo-stack>
        <CardControls id="card-controls-demo" brand="Visa" kind="Debit" holder="Dana Whitfield" number="4000 1234 5678 4821" expiry="08/29"
                      spend_limit={1500} cash_limit={300} abroad={false}
                      on_change={(s) => { said = `frozen ${s.frozen}, online ${s.online}, atm ${s.atm}, abroad ${s.abroad}, spend ${s.spend_limit}, cash ${s.cash_limit}` }}/>
        <p.demo-note>{said == "" ? "Change something." : `on_change: ${said}`}</p>
    </div>
}

view CardControlsDemo() =
    <div.demo-stack>
        <CardControlsDemoLive/>
        <CardControls id="card-controls-demo-credit" brand="Mastercard" kind="Credit" holder="Dana Whitfield" number="1937" expiry="02/28"
                      face="dark" frozen={true} currency="EUR" locale="de-DE" spend_limit={2000} spend_max={8000} cash_limit={0} cash_max={500}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "card_controls", name: "CardControls", group: "Finance",
    summary: "A card's controls beside its masked face: freeze it, set daily spending and cash limits, and allow online, ATM, contactless and abroad use.",
    tags: ["finance", "banking", "forms", "settings", "card", "interactive"], demo: CardControlsDemo })
