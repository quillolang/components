let file_preview_demo_text = "# Release notes\n\n- Components bring their own CSS\n- QrCode and Barcode, drawn in Quillo\n- ReviewList sorts and filters\n\nThanks to everyone who tried the betas.\nLine 8\nLine 9\nLine 10\nLine 11\nLine 12\nLine 13: not shown\nLine 14: not shown"

view FilePreviewDemo() =
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 14px">
        <FilePreview id="file-preview-demo-image" name="Team offsite.jpg" src="https://picsum.photos/seed/offsite/600/400" size={3912004} meta="Sep 18"/>
        <FilePreview id="file-preview-demo-pdf" name="Sample.pdf" src="data:application/pdf;base64,JVBERi0xLjEKMSAwIG9iajw8L1R5cGUvQ2F0YWxvZy9QYWdlcyAyIDAgUj4+ZW5kb2JqCjIgMCBvYmo8PC9UeXBlL1BhZ2VzL0tpZHNbMyAwIFJdL0NvdW50IDE+PmVuZG9iagozIDAgb2JqPDwvVHlwZS9QYWdlL1BhcmVudCAyIDAgUi9NZWRpYUJveFswIDAgMzAwIDE0NF0+PmVuZG9iagp0cmFpbGVyPDwvUm9vdCAxIDAgUj4+Cg==" size={2483112}/>
        <FilePreview id="file-preview-demo-text" name="NOTES.md" text={file_preview_demo_text} size={812} href="#file_preview"/>
        <FilePreview id="file-preview-demo-zip" name="Brand assets.zip" size={18440230} href="#file_preview" meta="3 folders"/>
        <FilePreview id="file-preview-demo-audio" name="Interview.mp3" src="data:audio/wav;base64,UklGRiQAAABXQVZFZm10IBAAAAABAAEAQB8AAEAfAAABAAgAZGF0YQAAAAA=" size={4200}/>
        <FilePreview id="file-preview-demo-plain" name="LICENSE" height={120}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "file_preview", name: "FilePreview", group: "Data",
    summary: "A look at a file before opening it: an image, a PDF in an object, the start of a text file, a player, or an icon, with name, size and a download link.",
    tags: ["file", "media", "card", "document", "no-js"],
    demo: FilePreviewDemo })
