component SeatMapDemoLive() {
    state note = "Pick seats: on_change gets them and the total."
    <div.demo-stack>
        <SeatMap id="seat-map-demo" name="seat" rows={16} skip_rows={[13]} layout="ABC DEF" passengers={["Ada Lovelace", "Charles Babbage"]}
                 taken={["1A", "1B", "1E", "2C", "2D", "3A", "4F", "5B", "5C", "6E", "8A", "8D", "9C", "11B", "12F", "14A", "15D", "16C"]}
                 exit_rows={[11, 12]} extra_rows={[1]} price={12.00m} extra_price={35.00m}
                 on_change={(seats, total) => { note = `on_change: ${join(seats | map((s) => s ?? "none"), ", ")}; ${total} in all.` }}/>
        <p.demo-note id="seat-map-demo-note">{note}</p>
    </div>
}

view SeatMapDemo() =
    <div class="demo-row" style="align-items: start; gap: 32px">
        <SeatMapDemoLive/>
        <SeatMap id="seat-map-demo-small" name="hop" rows={6} layout="AC DF" taken={["2A", "4D"]} price={0} front_rows={2} front_price={9}
                 currency="EUR" locale="de-DE" value={["3F"]} label="Seats, ATR 72"/>
    </div>

ui_gallery = ui_gallery | push({ slug: "seat_map", name: "SeatMap", group: "Travel",
    summary: "A plane's cabin to pick a seat for each passenger: aisles, window and aisle seats, taken seats, exit and extra legroom rows, a price per seat and the total.",
    tags: ["travel", "flights", "forms", "picker", "interactive"], demo: SeatMapDemo })
