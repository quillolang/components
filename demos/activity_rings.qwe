let activity_rings_demo_day = [
    { label: "Move", value: 420, goal: 600, unit: "kcal" },
    { label: "Exercise", value: 45, goal: 30, unit: "min", tone: "success" },
    { label: "Stand", value: 12, goal: 12, unit: "h", tone: "info" },
]

component ActivityRingsDemoLive() {
    state move = 590
    <div.demo-stack>
        <div id="activity-rings-live">
            <ActivityRings title="A value that changes" size={160} rings={[{ label: "Move", value: move, goal: 600, unit: "kcal", tone: "danger" }]}/>
        </div>
        <div.demo-row><Button id="activity-rings-add" size="lg" variant="soft" on_click={() => { move += 20 }}>Add 20 kcal</Button></div>
    </div>
}

view ActivityRingsDemo() =
    <div.demo-stack>
        <div id="activity-rings-day"><ActivityRings title="Friday" center="Fri" rings={activity_rings_demo_day}/></div>
        <div id="activity-rings-far"><ActivityRings title="Round again" rings={[
            { label: "Steps", value: 25000, goal: 10000, unit: "steps", tone: "warning" },
            { label: "Water", value: 4, goal: 2, unit: "L" },
        ]} size={140}/></div>
        <div id="activity-rings-bad"><ActivityRings rings={[null, "x", { value: 3 }, { label: "No goal", value: 5, goal: 0 },
            { label: "Text", value: "many", goal: 10 }, { label: "Below", value: -4, goal: 10 }]} size={120}/></div>
        <ActivityRingsDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "activity_rings", name: "ActivityRings", group: "Mobile",
    summary: "Progress rings inside each other that go round again past 100%, drawn once, with a legend and a sentence each for screen readers.",
    tags: ["mobile", "no-js", "health", "progress", "rings", "tablet"],
    demo: ActivityRingsDemo })
