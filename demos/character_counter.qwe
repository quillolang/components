component CharacterCounterDemoLive() {
    state text = "Ship it"
    <div.demo-stack>
        <CharacterCounter name="post" label="Post" limit={40} rows={3} hard={false} value={text} field="character-counter-demo-soft"
                          hint="Over the limit it will not send." on_input={(t) => { text = t }}/>
        <p.demo-note>{len(text)} characters typed.</p>
    </div>
}

view CharacterCounterDemo() =
    <div.demo-stack.demo-narrow>
        <CharacterCounter name="headline" label="Headline" limit={20} value="Quillo UI 2.0 is out" field="character-counter-demo-hard"
                          placeholder="Short and sharp" required={true}/>
        <CharacterCounterDemoLive/>
        <CharacterCounter name="tag" label="Small" size="sm" limit={12} value="eleven char" field="character-counter-demo-small"/>
    </div>

ui_gallery = ui_gallery | push({ slug: "character_counter", name: "CharacterCounter", group: "Forms",
    summary: "A text box or textarea with a live 120 / 280 count that warns near the limit, as a hard stop or a soft one that blocks sending.",
    tags: ["forms", "input", "text", "interactive"], demo: CharacterCounterDemo })
