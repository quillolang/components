// A picture 800 by 500 pixels drawn in SVG, so the demo needs no image files and its size is known.
let image_crop_demo_pic = `data:image/svg+xml,${url_encode(
    `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="800" height="500">`
    + `<rect width="800" height="500" fill="#9fd8c8"/><circle cx="560" cy="160" r="70" fill="#ffe9a0"/>`
    + `<path d="M0 360 Q 200 240 420 340 T 800 300 V 500 H 0 Z" fill="#1f6f68"/>`
    + `<circle cx="250" cy="250" r="60" fill="#f3b5c8"/><circle cx="230" cy="235" r="8" fill="#333"/><circle cx="270" cy="235" r="8" fill="#333"/></svg>`)}`

component ImageCropDemoLive() {
    state got = null
    <div.demo-stack>
        <ImageCrop name="avatar" src={image_crop_demo_pic} alt="A drawing of a face on a hill" ratio={1}
                   on_change={(c) => { got = c }}/>
        <p.demo-note id="image-crop-demo-note">{got == null ? "Drag the box or its corners." : `Crop ${got.w} × ${got.h} at ${got.x}, ${got.y}.`}</p>
    </div>
}

view ImageCropDemo() =
    <div.demo-stack>
        <div style="max-width: 480px"><ImageCropDemoLive/></div>
        <div style="max-width: 320px">
            <ImageCrop name="banner" src={image_crop_demo_pic} alt="The same drawing, any shape" crop={{ x: 100, y: 50, w: 400, h: 200 }}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "image_crop", name: "ImageCrop", group: "Media",
    summary: "A crop box over a picture, dragged and resized by its corners or the keys, with the crop in hidden inputs a form sends.",
    tags: ["media", "image", "forms", "drag", "interactive"], demo: ImageCropDemo })
