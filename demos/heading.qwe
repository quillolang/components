view HeadingDemo() =
    <div.demo-stack>
        <Heading level={1} id="heading-demo-h1">Settings</Heading>
        <Heading level={2} id="heading-demo-billing" anchor={true} subtitle="Cards, invoices and the plan you are on.">Billing</Heading>
        <Heading level={3}>Payment methods</Heading>
        <Heading level={4}>Cards on file</Heading>
        <Heading level={5}>Expiring soon</Heading>
        <Heading level={6}>Archived</Heading>
        <Heading level={3} size={5} id="heading-demo-small">A level-3 heading that looks like a level 5</Heading>
        <Heading level={2} align="center" tone="muted" id="heading-demo-center">Centred and muted</Heading>
    </div>

ui_gallery = ui_gallery | push({ slug: "heading", name: "Heading", group: "Typography",
    summary: "A title from <h1> to <h6> in the kit's sizes, with a subtitle and a link to itself shown on hover.",
    tags: ["typography", "text", "page", "no-js"],
    demo: HeadingDemo })
