// The clock in the demo: 12:00 UTC on 1 November 2026, and alerts counted back from it.
let alert_inbox_demo_now = 1793534400000

let alert_inbox_demo_alerts = [
    { id: "a1", severity: "info", title: "Backup finished", body: "All 42 volumes.", at: alert_inbox_demo_now - 3 * 60000 },
    { id: "a2", severity: "critical", title: "Disk almost full", source: "db-2", body: "97% used, growing 1% an hour.", at: alert_inbox_demo_now - 8 * 60000, snooze: false },
    { id: "a3", severity: "warning", title: "Certificate expires soon", body: "api.example.com, in 9 days.", at: alert_inbox_demo_now - 2 * 3600000 },
    { id: "a4", severity: "critical", title: "Payments failing", source: "checkout", body: "12% of attempts since 11:40.", at: alert_inbox_demo_now - 20000 },
    { id: "a5", severity: "medium", title: "Slow queries", at: alert_inbox_demo_now - 50 * 60000 },
]

component AlertInboxDemoLive() {
    state kept = null
    state told = "Nothing yet."
    state badge = -1
    state list = alert_inbox_demo_alerts
    state stir = 0
    <div.demo-stack>
        <div.demo-row>
            <p.demo-note id="alert-inbox-badge">Badge {badge}</p>
            <Button id="alert-inbox-new" size="lg" variant="soft" on_click={() => { list = list + [{ id: `n${len(list)}`, severity: "critical", title: "A new alert" }] }}>A new alert comes in</Button>
        </div>
        <div id="alert-inbox-main"><AlertInbox alerts={list | map((a) => a.id == "a1" ? { ...a, body: `All 42 volumes, run ${stir}.` } : a)} now_ms={alert_inbox_demo_now} check_seconds={1} on_change={(s) => { kept = s }} on_badge={(n) => { badge = n }}
            on_ack={(id) => { told = `ack ${id}` }} on_snooze={(id, until) => { told = `snooze ${id} ${until}` }} on_reopen={(id) => { told = `reopen ${id}` }}/></div>
        <p.demo-note id="alert-inbox-told">{told}</p>
        <div.demo-row><Button id="alert-inbox-stir" size="lg" variant="soft" on_click={() => { stir += 1 }}>An alert is updated</Button></div>
        <p.demo-note id="alert-inbox-kept">{json.stringify(kept)}</p>
        <div id="alert-inbox-bad"><AlertInbox label="Bad data" alerts={[null, 4, { id: 1 }, { id: 2, title: "Twin", severity: 7, at: "soon" }, { id: 2, title: "Twin again" }]} saved={{ acks: "all", snoozed: [null, { id: 2 }] }} snooze_options="never"/></div>
    </div>
}

view AlertInboxDemo() = <AlertInboxDemoLive/>

ui_gallery = ui_gallery | push({ slug: "alert_inbox", name: "AlertInbox", group: "Mobile",
    summary: "Alerts by severity, swiped to acknowledge or snooze, with buttons and keys to the same, and a badge that stays right as snoozes run out.",
    tags: ["mobile", "interactive", "alerts", "gesture", "swipe", "tablet"],
    demo: AlertInboxDemo })
