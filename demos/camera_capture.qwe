component CameraCaptureDemoLive() {
    state size = 0
    <div.demo-stack>
        <CameraCapture name="badge" label="Badge photo" width={320} on_capture={(url) => { size = url == null ? 0 : len(url) }}/>
        <p.demo-note id="camera-capture-demo-note">{size == 0 ? "No photo yet." : `A photo of ${round(size / 1024)} KB, as a data URL.`}</p>
    </div>
}

view CameraCaptureDemo() =
    <div.demo-stack>
        <CameraCaptureDemoLive/>
        <p.demo-note>The browser asks first. Without a camera (or on a page not served over https), it says so.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "camera_capture", name: "CameraCapture", group: "Media",
    summary: "Takes a photo with the camera into a hidden input as a data URL, with retake, and says so when there is no camera.",
    tags: ["media", "image", "forms", "upload", "interactive"], demo: CameraCaptureDemo })
