component CountryPickerDemoLive() {
    state code = "JP"
    <div.demo-stack>
        <CountryPicker name="ship_to" label="Ship to" value={code} field="country-picker-demo-live"
                       only={["US", "CA", "GB", "DE", "FR", "JP", "AU", "BR"]} codes={false}
                       on_change={(c) => { code = c }}/>
        <p.demo-note>Shipping to {country_picker_name(code)} ({code}).</p>
    </div>
}

view CountryPickerDemo() =
    <div.demo-stack.demo-narrow>
        <CountryPicker name="country" label="Country" value="PT" field="country-picker-demo-all"
                       favourites={["PT", "ES", "GB", "US"]} hint="The flag is the browser's emoji." required={true}/>
        <CountryPickerDemoLive/>
        <div.demo-row>
            <CountryPicker name="market" label="Market" size="sm" placeholder="Choose a market" field="country-picker-demo-small"
                           only={["DE", "FR", "ES", "IT"]} flags={false}/>
            <CountryPicker name="locked" label="Disabled" size="sm" value="CH" only={["CH"]} disabled={true}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "country_picker", name: "CountryPicker", group: "Forms",
    summary: "A drop-down of every country with its flag and ISO code, favourites first, sending the two-letter code with a form.",
    tags: ["forms", "select", "picker", "no-js"], demo: CountryPickerDemo })
