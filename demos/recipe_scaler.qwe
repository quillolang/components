let recipe_scaler_demo_text = "1 1/2 cups flour\n½ tsp salt\n3 tsp baking powder\n2 tbsp butter\n250 g sugar\n700 g chicken thighs\n2-3 cloves garlic\n2 eggs\n1 onion, diced\na pinch of nutmeg\nblack pepper to taste"

component RecipeScalerDemoLive() {
    state seen = null
    <div.demo-stack>
        <RecipeScaler id="recipe-scaler-demo-metric" title="In metric" name="soup" serves={2} servings={4} system="metric"
                      ingredients={"1 cup stock\n1 lb potatoes\n1 tbsp oil"} on_change={(r) => { seen = r }}/>
        <p.demo-note>{seen == null ? "Change it to see on_change." : `on_change: by ${str(seen.factor)}, first line ${first(seen.lines)}.`}</p>
    </div>
}

view RecipeScalerDemo() =
    <div.demo-stack>
        <RecipeScaler id="recipe-scaler-demo" serves={4} servings={6} ingredients={recipe_scaler_demo_text}/>
        <RecipeScalerDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "recipe_scaler", name: "RecipeScaler", group: "Utilities",
    summary: "Scales a recipe to any number of servings: reads fractions and ranges, moves to the next unit, and rounds to what a kitchen can measure, in metric or US.",
    tags: ["smart", "interactive", "recipe", "cooking", "calculator", "units"], demo: RecipeScalerDemo })
