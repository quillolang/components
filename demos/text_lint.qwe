let text_lint_demo_text = "The report was written by the team. It is really very clear, and the the results  speak for themselves.\nAt the end of the day, we met in order to think outside the box. Basically, the plan is simple."

component TextLintDemoLive() {
    state left = null
    <div.demo-stack>
        <TextLint id="text-lint-demo-live" label="Your note" name="note" rows={3} rules={["filler", "repeated"]} value="Just a very short note." on_change={(r) => { left = len(r.issues) }}/>
        <p.demo-note>{left == null ? "Change the note to see on_change." : `on_change: ${left} left.`}</p>
    </div>
}

view TextLintDemo() =
    <div.demo-stack>
        <TextLint id="text-lint-demo" value={text_lint_demo_text} name="body" rows={5} long_sentence={18}/>
        <TextLintDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "text_lint", name: "TextLint", group: "Blogging",
    summary: "Marks passive voice, filler, repeated words, double spaces, long sentences and cliches as you type, each with its place and a one-click fix where there is one.",
    tags: ["smart", "interactive", "lint", "writing", "style", "grammar"], needs: ["readability_meter"], demo: TextLintDemo })
