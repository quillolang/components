view GaugeChartDemo() =
    <div.demo-row style="gap: 32px 48px; align-items: flex-start">
        <GaugeChart label="CPU load" value={72} suffix="%"/>
        <GaugeChart label="Response time" value={340} high={1000} suffix=" ms" size={220} bands={[
            { to: 300, tone: "good", name: "Fast" }, { to: 700, tone: "warning", name: "Slow" }, { to: 1000, tone: "bad", name: "Too slow" }]}/>
        <GaugeChart label="Customer score" value={8.6} low={0} high={10} decimals={1} size={200} bands={[
            { to: 6, tone: "bad", name: "Detractor" }, { to: 8, tone: "neutral", name: "Passive" }, { to: 10, tone: "good", name: "Promoter" }]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "gauge_chart", name: "GaugeChart", group: "Charts",
    summary: "A half-circle dial of good, warning and bad bands with a needle at the value, and the value and its band's name under it.",
    tags: ["chart", "data", "dashboard", "no-js"],
    demo: GaugeChartDemo })
