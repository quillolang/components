view AccountCardDemo() =
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 12px">
        <AccountCard id="account-card-demo-everyday" kind="Checking" name="Everyday" number="0012 0048 21" balance={2450.18m}
                     available={2310.18m} href="#everyday" transfer_href="#transfer" pay_href="#pay" statements_href="#statements"
                     note="Updated 2 min ago"/>
        <AccountCard id="account-card-demo-savings" kind="Savings" name="Rainy day" number="DE44 5001 0517 5407 3249 31"
                     balance={12500} currency="EUR" locale="de-DE" tone="success" transfer_href="#transfer" statements_href="#statements"/>
        <AccountCard id="account-card-demo-joint" kind="Joint checking" name="House" number="7730091266" balance={-84.5m}
                     available={415.5m} currency="GBP" locale="en-GB" tone="warning" pay_href="#pay"
                     note="Overdraft limit £500.00"/>
    </div>

ui_gallery = ui_gallery | push({ slug: "account_card", name: "AccountCard", group: "Finance",
    summary: "A bank account at a glance: type, nickname, masked number, current and available balance, what is on hold, and quick actions.",
    tags: ["finance", "banking", "card", "dashboard", "no-js"], demo: AccountCardDemo })
