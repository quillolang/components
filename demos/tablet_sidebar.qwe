let tablet_sidebar_demo_css = css`
.demo-side-page { padding: 16px 20px; font: 15px/1.6 var(--ui-font); }
.demo-side-page h4 { margin: 0 0 8px; font-size: 20px; }
.demo-side-out { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
`

let tablet_sidebar_demo_sections = [
    { title: "Work", items: [
        { id: "jobs", label: "Jobs", icon: "M4 8h16v11H4zM9 8V5h6v3", badge: 3 },
        { id: "map", label: "Map", icon: "M12 21s7-6.5 7-12a7 7 0 1 0-14 0c0 5.5 7 12 7 12zM12 11a2 2 0 1 0 0-4 2 2 0 0 0 0 4" },
        { id: "chat", label: "Messages", icon: "M4 5h16v11H9l-5 4z", badge: 240 },
        { id: "docs", label: "Documents", icon: "M6 3h9l4 4v14H6zM14 3v5h5", badge: 0 },
    ] },
    { title: "Crew", items: [
        { id: "rota", label: "Rota", icon: "M4 6h16v14H4zM4 10h16M9 3v4M15 3v4" },
        { id: "time", label: "Timesheets", icon: "M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM12 7v5l3 2", badge: "soon" },
    ] },
    { items: [
        { id: "help", label: "Help", icon: "?" },
    ] },
]

component TabletSidebarDemoLive() {
    style global tablet_sidebar_demo_css
    state page = "jobs"
    state pin = "not changed"
    <div.demo-stack>
        <div.demo-tablet>
            <TabletSidebar id="demo-field" title="Field" current="jobs" sections={tablet_sidebar_demo_sections}
                           on_select={(it) => { page = it.label }} on_pin={(p) => { pin = p ? "pinned" : "unpinned" }}>
                <div.demo-side-page>
                    <h4 id="side-demo-page">{page}</h4>
                    <p>Turn the tablet, or take it into Split View. The sidebar decides by the room it has, not the screen.</p>
                    <Button id="side-demo-behind" size="lg" variant="outline">Something on the page</Button>
                </div>
            </TabletSidebar>
        </div>
        <p.demo-note id="side-demo-pin">The pin: {pin}</p>
    </div>
}

view TabletSidebarDemo() = <TabletSidebarDemoLive/>

ui_gallery = ui_gallery | push({ slug: "tablet_sidebar", name: "TabletSidebar", group: "Mobile",
    summary: "A sidebar that folds to icons, then to an overlay, by width class, with sections, badges and a pin kept per device.",
    tags: ["mobile", "tablet", "interactive", "navigation", "sidebar", "layout"],
    demo: TabletSidebarDemo })
