let page_dots_demo_css = css`
.ui-pagedots-demo-track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior-x: contain; scrollbar-width: none; border-radius: var(--ui-radius); }
.ui-pagedots-demo-track::-webkit-scrollbar { display: none; }
.ui-pagedots-demo-card { display: grid; flex: 0 0 100%; place-items: center; box-sizing: border-box; height: 180px; scroll-snap-align: start; scroll-snap-stop: always; background: var(--ui-accent-soft); color: var(--ui-accent); font: 600 22px var(--ui-font); }
`

component PageDotsDemoLive() {
    style global page_dots_demo_css
    state step = 0
    <div.demo-stack style="grid-template-columns: minmax(0, 1fr); padding: 8px">
        <div>
            <div.ui-pagedots-demo-track id="page-dots-demo" tabindex="0" aria-label="Photos">
                {for i in range(1, 13) => <div.ui-pagedots-demo-card key={i}>Photo {i}</div>}
            </div>
            <PageDots count={12} target="page-dots-demo" label="Photo"/>
        </div>
        <div>
            <p class="demo-note">Step {step + 1} of 3, set by your own state</p>
            <PageDots count={3} at={step} label="Step" on_change={(i) => { step = i }}/>
            <Button size="lg" variant="outline" on_click={() => { step = (step + 1) % 3 }}>Next step</Button>
        </div>
        <PageDots count={4} at={1.5} label="Slide"/>
    </div>
}

view PageDotsDemo() = <div.demo-tablet><PageDotsDemoLive/></div>

ui_gallery = ui_gallery | push({ slug: "page_dots", name: "PageDots", group: "Mobile",
    summary: "Page dots that follow a swipe or a scroller, shrinking the distant ones when there are many, and told to screen readers.",
    tags: ["mobile", "interactive", "tablet", "pagination", "indicator", "swipe"],
    demo: PageDotsDemo })
