let rate_alerts_demo_rates = { "EUR/USD": 1.08425m, "GBP/USD": 1.27539m, "USD/JPY": 156.2445m, "USD/PHP": 58.1225m }

component RateAlertsDemoLive() {
    state note = "No change yet."
    <div.demo-stack>
        <RateAlerts rates={rate_alerts_demo_rates}
                    alerts={[{ id: "a1", pair: "EUR/USD", direction: "above", rate: 1.09m },
                             { id: "a2", pair: "USD/JPY", direction: "below", rate: 157.5m }]}
                    on_add={(a) => { note = `Added ${a.id}: ${a.pair} ${a.direction} ${a.rate}` }}
                    on_remove={(a) => { note = `Removed ${a.id}` }}/>
        <p.demo-note id="rate-alerts-demo-note">{note}</p>
    </div>
}

view RateAlertsDemo() =
    <div.demo-stack>
        <RateAlertsDemoLive/>
        <RateAlerts name="desk" label="Branch alerts" pairs={["USD/PHP", "EUR/PHP"]} action="#alerts" most={3}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "rate_alerts", name: "RateAlerts", group: "Finance",
    summary: "Set an alert on an exchange rate, a pair above or below a rate, and see the alerts set, how far each is, and remove them.",
    tags: ["finance", "forex", "forms", "list", "interactive"], demo: RateAlertsDemo })
