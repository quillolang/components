view EmailPreviewDemo() =
    <div.demo-stack>
        <EmailPreview id="email-preview-demo-q3" subject="Q3 report, with the numbers" date="2026-10-27T14:30:00Z" labels={["Work", "Finance"]}
                      starred={true} unread={true} me="ada@example.com"
                      from={{ name: "Grace Hopper", email: "grace@example.com", src: "https://i.pravatar.cc/80?img=47" }}
                      to={["ada@example.com", { name: "Alan Turing", email: "alan@example.com" }]} cc={[{ name: "Finance", email: "finance@example.com" }]}
                      body="Hi Ada,\n\nThe Q3 report is attached, with the spreadsheet behind it.\nPage 4 has the one question I still have.\n\nThanks,\nGrace"
                      attachments={[{ name: "Q3 report.pdf", size: 2483112, href: "#email_preview" }, { name: "Q3 numbers.xlsx", size: 84211, href: "#email_preview" },
                                    { name: "chart.png", size: 312000 }]}/>
        <EmailPreview id="email-preview-demo-html" subject="Welcome to Quillo" from={{ email: "hello@quillolang.org" }} date="2026-10-01">
            <p>Thanks for signing up. <a href="#email_preview">Start with the tour</a>, or read <strong>the guide</strong>.</p>
        </EmailPreview>
    </div>

ui_gallery = ui_gallery | push({ slug: "email_preview", name: "EmailPreview", group: "Data",
    summary: "An email as a client shows it: subject, labels and star, sender with picture, to and cc, the date, the message and attachments to download.",
    tags: ["document", "card", "user", "file", "no-js"],
    needs: ["avatar"],
    demo: EmailPreviewDemo })
