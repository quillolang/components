let master_detail_demo_mail = [
    { id: "m1", title: "Quarterly numbers", subtitle: "Ana Silva", meta: "09:41", icon: "A" },
    { id: "m2", title: "Lunch on Thursday?", subtitle: "Ben Okafor", meta: "08:12", icon: "B" },
    { id: "m3", title: "Your invoice for March", subtitle: "Billing", meta: "Mon", icon: "€" },
    { id: "m4", title: "Welcome to the team", subtitle: "Chen Wei", meta: "Sun", icon: "C" }
]

view MasterDetailDemoPanes() =
    [
        <MasterDetailPane id="m1" open={true}><h4 style="margin: 0 0 6px">Quarterly numbers</h4><p style="margin: 0">Hi all, the report is attached. Revenue is up 12% on last quarter, mostly from the new plans.</p></MasterDetailPane>,
        <MasterDetailPane id="m2"><h4 style="margin: 0 0 6px">Lunch on Thursday?</h4><p style="margin: 0">The place by the river at one. Say if you are in.</p></MasterDetailPane>,
        <MasterDetailPane id="m3"><h4 style="margin: 0 0 6px">Your invoice for March</h4><p style="margin: 0">€240.00, paid by card ending 4242. Thank you.</p></MasterDetailPane>,
        <MasterDetailPane id="m4"><h4 style="margin: 0 0 6px">Welcome to the team</h4><p style="margin: 0">Your first week's plan is in the wiki. Ask me anything.</p></MasterDetailPane>
    ]

let master_detail_demo_people = [
    { id: 1, title: "Ada Lovelace", subtitle: "Analyst", meta: "London" },
    { id: 2, title: "Grace Hopper", subtitle: "Rear admiral", meta: "Arlington" },
    { id: 3, title: "Linus Torvalds", subtitle: "Kernel", meta: "Portland" }
]

component MasterDetailDemoLive() {
    state who = 1
    let p = find(master_detail_demo_people, (x) => x.id == who)
    <div.demo-stack>
        <MasterDetail id="master-detail-demo-people" label="People" items={master_detail_demo_people} selected={1} height="220px"
                      width="240px" on_select={(id) => { who = id }}>
            {p != null && <div>
                <h4 style="margin: 0 0 6px">{p.title}</h4>
                <p style="margin: 0; color: var(--ui-muted)">{p.subtitle}, {p.meta}.</p>
            </div>}
        </MasterDetail>
        <p.demo-note>{p == null ? "Nobody picked." : `Showing ${p.title}.`}</p>
    </div>
}

view MasterDetailDemo() =
    <div.demo-stack>
        <MasterDetail id="master-detail-demo-mail" label="Messages" items={master_detail_demo_mail} selected="m1" height="300px">
            <MasterDetailDemoPanes/>
        </MasterDetail>
        <MasterDetailDemoLive/>
        <p.demo-note>In a 380px-wide box it shows one side at a time, with a Back button:</p>
        <div style="width: 380px; max-width: 100%">
            <MasterDetail id="master-detail-demo-narrow" label="Messages" items={master_detail_demo_mail} selected="m2" height="260px">
                <MasterDetailDemoPanes/>
            </MasterDetail>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "master_detail", name: "MasterDetail", group: "Layout",
    summary: "A list on the left and the item picked in detail on the right; one at a time with a Back button when narrow.",
    tags: ["layout", "list", "navigation", "mobile", "keyboard", "interactive"], demo: MasterDetailDemo })
