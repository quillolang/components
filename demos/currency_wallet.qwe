view CurrencyWalletDemo() =
    <div.demo-stack>
        <CurrencyWallet id="currency-wallet-demo" base="USD" updated="14:05 UTC"
                        rates={{ USD: 1, EUR: 0.9224m, GBP: 0.7841m, JPY: 156.24m, PHP: 58.12m }}
                        convert_href="#convert?from={currency}" send_href="#send?currency={currency}" balances={[
            { currency: "PHP", amount: 52300m, account: "•••• 7310" },
            { currency: "EUR", amount: 3250m, account: "•••• 2046" },
            { currency: "USD", amount: 12480.55m, account: "•••• 4821" },
            { currency: "JPY", amount: 185000 },
            { currency: "GBP", amount: 840.20m },
            { currency: "KES", amount: 15000m },
        ]}/>
        <div.demo-narrow>
            <CurrencyWallet id="currency-wallet-demo-eur" label="Travel card" base="EUR" rates={{ EUR: 1, CHF: 0.9553m }}
                            convert_href="#convert?from={currency}" send_href={null} keep_order={true}
                            balances={[{ currency: "CHF", amount: 420m }, { currency: "EUR", amount: 185.40m }]}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "currency_wallet", name: "CurrencyWallet", group: "Finance",
    summary: "Balances in several currencies with the total in a base currency, each with its rate, its worth and share, and convert and send actions.",
    tags: ["finance", "forex", "banking", "card", "no-js"], demo: CurrencyWalletDemo })
