component PropertyGridDemoLive() {
    state last = "nothing yet"
    state width = 120
    <div.demo-stack.demo-narrow style="max-width: 420px">
        <PropertyGrid id="property-grid-demo" label="Button properties" name="props"
                      on_change={(field, v) => { last = `${field} = ${json.stringify(v)}` }}
                      on_values={(vs) => { width = vs.width ?? 0 }}
                      groups={[
                          { label: "Layout", items: [
                              { field: "width", label: "Width", type: "number", value: 120, unit: "px" },
                              { field: "align", label: "Align", type: "select", value: "left", options: ["left", "center", "right"] },
                              { field: "padding", label: "Padding", type: "number", value: 8, unit: "px", hint: "Inside the border" },
                          ] },
                          { label: "Look", items: [
                              { field: "color", label: "Colour", type: "color", value: "#5b4bdb" },
                              { field: "rounded", label: "Rounded", type: "bool", value: true },
                              { field: "text", label: "Text", value: "Save" },
                          ] },
                          { label: "Meta", open: false, items: [
                              { field: "id", label: "Id", value: "btn-7", readonly: true },
                              { field: "created", label: "Created", type: "date", value: "2026-10-28" },
                          ] },
                      ]}/>
        <p.demo-note>on_change: {last}. on_values: width is {width}.</p>
    </div>
}

view PropertyGridDemo() = <PropertyGridDemoLive/>

ui_gallery = ui_gallery | push({ slug: "property_grid", name: "PropertyGrid", group: "Data",
    summary: "Grouped name and value rows that fold, each value edited by the control its type asks for, with changes marked and undone.",
    tags: ["data", "forms", "input", "settings", "interactive"], demo: PropertyGridDemo })
