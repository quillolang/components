component CronBuilderDemoLive() {
    state said = "Change it to see on_change."
    <div.demo-stack>
        <CronBuilder id="cron-builder-demo-live" title="Backup" value="30 2 * * 0" now="2026-11-01T12:00:00Z" zone="Europe/Paris" name="backup_cron"
                     on_change={(c) => { said = c.error != null ? `on_change: ${c.error}` : `on_change: ${c.expression}, next ${c.next[0]}` }}/>
        <p.demo-note data-said="true">{said}</p>
    </div>
}

view CronBuilderDemo() =
    <div.demo-stack>
        <CronBuilder id="cron-builder-demo" value="0 9 * * 1-5" now="2026-11-01T12:00:00Z" zone="UTC"/>
        <CronBuilder id="cron-builder-demo-zone" title="A zone this server does not list" value="0 9 * * *" now="2026-11-01T12:00:00Z" zone="Mars/Base"/>
        <CronBuilderDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "cron_builder", name: "CronBuilder", group: "Forms",
    summary: "Builds a five-field cron line from dropdowns or reads one typed, says it in English, lists the next runs in a time zone, and rejects a day that never comes.",
    tags: ["smart", "interactive", "cron", "schedule", "time", "developer"], demo: CronBuilderDemo })
