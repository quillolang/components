component CoachmarkDemoLive() {
    state tour = 0
    <div.demo-stack>
        <div.demo-row style="gap: 24px">
            <Button id="coachmark-demo-export" variant="outline">Export</Button>
            <Button id="coachmark-demo-filters" variant="outline">Filters</Button>
            <Button id="coachmark-demo-share" variant="outline">Share</Button>
        </div>
        <Coachmark target="coachmark-demo-export" title="Export is here now" step="1 of 2" done="Next" open={tour == 0}
                   on_done={() => { tour = 1 }}>Download any report as CSV or PDF.</Coachmark>
        <Coachmark target="coachmark-demo-filters" title="Filter the list" placement="right" step="2 of 2" open={tour == 1}
                   on_done={() => { tour = 2 }}>Narrow it by date, owner or status.</Coachmark>
        <p.demo-note>{tour < 2 ? `Tour step ${tour + 1} of 2.` : "Tour done."}</p>
    </div>
}

view CoachmarkDemo() =
    <div.demo-stack>
        <CoachmarkDemoLive/>
        <Coachmark target="coachmark-demo-share" placement="top" remember="demo-share">Share a link to this view with your team.</Coachmark>
        <p.demo-note>The one on Share is remembered once dismissed (localStorage), and stays away on the next load.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "coachmark", name: "Coachmark", group: "Feedback",
    summary: "A small callout pointing at an element by id, explaining it once, dismissed with Got it; several make a tour.",
    tags: ["feedback", "popover", "notification", "interactive"],
    demo: CoachmarkDemo })
