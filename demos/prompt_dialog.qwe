component PromptDialogDemoLive() {
    state name = "notes.txt"
    state asking = false
    state said = "Nothing yet."
    <div.demo-stack>
        <div.demo-row>
            <PromptDialog id="prompt-demo-name" title="Rename file" label="New name" value={name} trigger="Rename" hint="Keep the ending."
                          on_submit={(t) => { name = t; said = `Renamed to ${t}.` }} on_cancel={() => { said = "Rename cancelled." }}/>
            <Button variant="soft" on_click={() => { asking = true }}>Reject (from state)</Button>
            <PromptDialog id="prompt-demo-reason" title="Reject this request" label="Reason" placeholder="Tell them why" open={asking}
                          on_submit={(t) => { asking = false; said = `Rejected: ${t}` }} on_cancel={() => { asking = false; said = "Not rejected." }}>
                <p>The reason goes to the person who asked.</p>
            </PromptDialog>
        </div>
        <p.demo-note>File: {name}. {said}</p>
    </div>
}

view PromptDialogDemo() = <PromptDialogDemoLive/>

ui_gallery = ui_gallery | push({ slug: "prompt_dialog", name: "PromptDialog", group: "Overlays",
    summary: "A modal asking for one text value with OK and Cancel, on the browser's own <dialog>; Enter submits, Escape cancels.",
    tags: ["dialog", "overlay", "input", "forms", "interactive"],
    demo: PromptDialogDemo })
