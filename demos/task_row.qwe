let task_row_demo_tasks = [
    { id: 1, title: "Pay the electricity bill", due: "2026-10-30", priority: "high", list: "Home" },
    { id: 2, title: "Book the dentist", due: "2026-11-01", list: "Health" },
    { id: 3, title: "Pack for Lisbon", due: "2026-11-04", priority: "medium", list: "Travel",
      subtasks: [{ id: "a", title: "Passport", done: true }, { id: "b", title: "Chargers" }, { id: "c", title: "Rain jacket" }, { id: "d", title: "Tickets", done: true }] },
    { id: 4, title: "Read the lease", due: "2026-12-10", priority: "low" },
    { id: 5, title: "Water the plants", done: true },
]

component TaskRowDemoLive() {
    state log = ""
    let note = (s: str) => { log = s }
    <div.demo-stack>
        <TaskRowList tasks={task_row_demo_tasks} today="2026-11-01" undo_seconds={2}
                     on_toggle={(id, done) => { note(`toggle ${id} ${done}`) }} on_due={(id, due) => { note(`due ${id} ${due}`) }}
                     on_delete={(id) => { note(`delete ${id}`) }} on_subtask={(id, sid, done) => { note(`sub ${id} ${sid} ${done}`) }}
                     on_restore={(id) => { note(`restore ${id}`) }}/>
        <p.demo-note id="task-row-log">{log}</p>
        // Bad data, for the test to look at: nothing here should stop the page.
        <div id="task-row-bad" hidden="true"><TaskRowList tasks={[null, 5, { id: 1, title: "One", due: "2026-02-30", priority: "huge", subtasks: "none" }, { id: 1, title: "Again" }]} today="not a day"/><TaskRowList tasks="none"/><TaskRow task={null}/></div>
    </div>
}

view TaskRowDemo() = <div.demo-stack><TaskRowDemoLive/></div>

ui_gallery = ui_gallery | push({ slug: "task_row", name: "TaskRow", group: "Mobile",
    summary: "A task with a round check, swipes for its due day and delete, subtasks, and a smooth move when finished.",
    tags: ["mobile", "interactive", "gesture", "swipe", "tasks", "tablet"],
    demo: TaskRowDemo })
