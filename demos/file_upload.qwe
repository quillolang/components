component FileUploadDemoLive() {
    state chosen = []
    state progress = null
    let uploading = progress != null && progress < 100
    if uploading { every(80, () => { progress = min([100, progress + 7]) }) }
    <div.demo-stack>
        <FileUpload name="fu-docs" label="Documents" accept=".pdf,.docx,.txt,.csv" max_size={2097152}
                    progress={progress} on_change={(fs) => {
                        chosen = fs
                        progress = null
                    }}/>
        <div.demo-row>
            <Button size="sm" disabled={len(chosen) == 0 || uploading} on_click={() => { progress = 0 }}>Upload</Button>
            <span.demo-note>{len(chosen) == 0 ? "Nothing chosen yet." : `${len(chosen)} ready, ${file_upload_size(sum(chosen | map((f) => f.size)))} in all.`}</span>
        </div>
    </div>
}

view FileUploadDemo() =
    <div.demo-stack.demo-narrow>
        <FileUpload name="fu-receipts" label="Receipts" accept="image/*,.pdf" max_size={5242880} max_files={4}
                    hint="Photos or scans of each receipt." required={true}/>
        <FileUploadDemoLive/>
        <FileUpload name="fu-avatar" label="Profile photo" accept="image/*" multiple={false}
                    text="Drop a photo or" button="choose one"/>
    </div>

ui_gallery = ui_gallery | push({ slug: "file_upload", name: "FileUpload", group: "Forms",
    summary: "Drop or choose files: kinds, sizes and thumbnails listed, limits checked per file, removable, with upload progress.",
    tags: ["forms", "upload", "file", "progress", "interactive"],
    demo: FileUploadDemo })
