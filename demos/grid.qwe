view GridDemoCell(label: str) =
    <div style="padding: 18px 12px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius-sm); background: var(--ui-subtle); text-align: center; font-size: 13px">{label}</div>

view GridDemo() =
    <div.demo-stack>
        <p.demo-note>A 160px minimum: as many columns as fit.</p>
        <Grid min={160} gap="sm">{for i in range(1, 7) => <GridDemoCell label={`Item ${i}`}/>}</Grid>
        <p.demo-note>Three columns: two under 900px, one under 560px.</p>
        <Grid columns={3}>{for i in range(1, 4) => <GridDemoCell label={`Column ${i}`}/>}</Grid>
    </div>

ui_gallery = ui_gallery | push({ slug: "grid", name: "Grid", group: "Layout",
    summary: "Columns that fit the screen: as many as fit a minimum width, or a fixed number that folds on phones.",
    demo: GridDemo })
