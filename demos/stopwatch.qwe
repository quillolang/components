component StopwatchDemoLive() {
    state log = []
    <div.demo-stack.demo-narrow>
        <Stopwatch label="Run" on_start={() => { log = log | push("start") }} on_stop={(ms) => { log = log | push(`stop ${ms >= 0 ? "ok" : "?"}`) }}
                   on_lap={(n, ms) => { log = log | push(`lap ${n}`) }} on_reset={() => { log = log | push("reset") }}/>
        <p.demo-note>{len(log) == 0 ? "Press Start, or focus it and press Space; L takes a lap." : join(log, " · ")}</p>
    </div>
}

view StopwatchDemo() =
    <div.demo-row style="align-items: flex-start">
        <div style="flex: 1 1 300px"><StopwatchDemoLive/></div>
        <div id="stopwatch-demo-sm" style="flex: 0 1 220px"><Stopwatch label="Plank" size="sm" laps={false}/></div>
    </div>

ui_gallery = ui_gallery | push({ slug: "stopwatch", name: "Stopwatch", group: "Scheduling",
    summary: "A stopwatch to the hundredth: Start, Lap, Stop and Reset, with the laps listed and the fastest and slowest marked.",
    tags: ["schedule", "time", "clock", "keyboard", "interactive"], demo: StopwatchDemo })
