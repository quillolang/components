let bundle_builder_demo_groups = [
    { id: "tops", label: "Tops", least: 1, most: 2, items: [
        { id: "tee", name: "Organic tee", price: "19.99" },
        { id: "hoodie", name: "Hoodie", price: "49.00" },
        { id: "polo", name: "Polo", price: "29.50" }] },
    { id: "socks", label: "Socks", most: 2, items: [
        { id: "ankle", name: "Ankle socks", price: "4.99" },
        { id: "crew", name: "Crew socks", price: "6.49" }] },
    { id: "caps", label: "Caps", least: 1, most: 1, items: [
        { id: "cap", name: "Cap", price: "9.99" },
        { id: "beanie", name: "Beanie", price: "12.00" },
        { id: "sticker", name: "Free sticker", price: "0" }] }]

component BundleBuilderDemoLive() {
    state seen = null
    <div.demo-stack>
        <BundleBuilder id="bundle-builder-demo-live" title="Coffee box" name="box" currency="JPY" selected={["a", "b"]}
                       groups={[{ id: "beans", label: "Beans", most: 3, items: [
                           { id: "a", name: "Ethiopia", price: "1200" }, { id: "b", name: "Colombia", price: "1100" }, { id: "c", name: "Brazil", price: "1001" }] }]}
                       tiers={[{ count: 2, off: 500 }, { count: 3, percent: 5 }, { count: 9, percent: 50 }]}
                       on_change={(q) => { seen = q }}/>
        <p.demo-note>{seen == null ? "Change a choice to see on_change." : `on_change: ${seen.count} items, ${seen.total}, net ${seen.lines | map((l) => str(l.net)) | join(" + ")}.`}</p>
    </div>
}

view BundleBuilderDemo() =
    <div.demo-stack>
        <BundleBuilder id="bundle-builder-demo" selected={["tee", "ankle"]} groups={bundle_builder_demo_groups}
                       tiers={[{ count: 3, percent: 5 }, { count: 4, percent: 10 }, { count: 5, off: 20 }]}/>
        <BundleBuilderDemoLive/>
        <BundleBuilder id="bundle-builder-demo-bad" title="A bundle with mistakes" currency="XXZ"
                       groups={[{ id: "g", label: "Things", least: 2, most: 1, items: [
                           { id: "x", name: "Thing", price: "soon" }, { id: "y", name: "Other", price: "5" }, { id: "y", name: "Again", price: "5" }] }, 7]}
                       tiers={[{ count: 0, percent: 5 }, { count: 2, percent: 150 }, "none"]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "bundle_builder", name: "BundleBuilder", group: "Commerce",
    summary: "Picks a bundle from groups with minimums and maximums: tiered discount, the cheapest way to the next tier, the saving over buying alone, and totals exact to the cent.",
    tags: ["smart", "interactive", "commerce", "bundle", "discount", "pricing"], demo: BundleBuilderDemo })
