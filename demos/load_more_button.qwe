// A load from the server, slowed a little so that the spinner shows.
server fn load_more_button_demo_wait() with time = sleep(400)

component LoadMoreButtonDemoLive() {
    state shown = 5
    state busy = false
    let total = 17
    <div.demo-stack>
        <ul style="margin: 0; padding-left: 20px; columns: 2">
            {for i in range(1, shown + 1) => <li key={i}>Item {i}</li>}
        </ul>
        <LoadMoreButton id="load-more-demo-live" remaining={total - shown} batch={6} loading={busy}
                        on_click={() => {
                            busy = true
                            load_more_button_demo_wait()
                            shown = min([total, shown + 6])
                            busy = false
                        }}/>
    </div>
}

view LoadMoreButtonDemo() =
    <div.demo-stack>
        <LoadMoreButtonDemoLive/>
        <div.demo-row>
            <LoadMoreButton id="load-more-demo-link" remaining={24} href="#load_more_button"/>
            <LoadMoreButton loading={true} variant="soft"/>
            <LoadMoreButton label="Show older" variant="ghost" size="sm"/>
            <LoadMoreButton remaining={0}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "load_more_button", name: "LoadMoreButton", group: "Actions",
    summary: "The button at the end of a list that says how many are left, spins while loading, and says when there are none.",
    tags: ["button", "list", "loading", "no-js"],
    demo: LoadMoreButtonDemo })
