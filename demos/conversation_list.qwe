let conversation_list_demo_now = "2026-11-01T12:00:00Z"

let conversation_list_demo_chats = [
    { id: 1, name: "Design team", last: "Lena: the new icons are in", at: "2026-11-01T11:58:00Z", unread: 3 },
    { id: 2, name: "Ada Lovelace", last: "See you at the engine", at: "2026-11-01T09:00:00Z", pinned: true },
    { id: 3, name: "Grace Hopper", last: "Found the moth", at: "2026-11-01T11:59:40Z", typing: true },
    { id: 4, name: "Book club", last: "Next month: Dune", at: "2026-10-31T20:15:00Z", unread: 128, muted: true },
    { id: 5, name: "Alan Turing", last: "The bombe is running", at: "2026-10-29T08:00:00Z", pinned: true, unread: 1 },
    { id: 6, name: "Family", last: "Dinner on Sunday?", at: "2026-10-28T18:00:00Z", typing: "Mum" },
    { id: 7, name: "Katherine Johnson", last: "Checked the numbers", at: "2026-10-12T10:00:00Z" },
    { id: 8, name: "Old project", last: "Archived soon", at: "2025-12-24T10:00:00Z", muted: true },
    { id: 9, name: "No time given", last: "Nothing to count from" },
    { id: 10, name: "Barbara Liskov", last: "Substitution, again", at: "2026-10-30T07:30:00Z" },
    { id: 11, name: "Donald Knuth", last: "A reward cheque", at: "2026-10-27T07:30:00Z" },
    { id: 12, name: "Edsger Dijkstra", last: "Shortest way to lunch", at: "2026-10-26T07:30:00Z" }
]

component ConversationListDemoLive() {
    state opened = "none"
    state log = "none"
    state arrived = 0
    let chats_now = conversation_list_demo_chats | map((c) => c.id == 1 ? { ...c, unread: 3 + arrived } : c)
    <div.demo-stack>
        <Button id="chats-arrive" size="lg" variant="soft" on_click={() => { arrived += 1 }}>A message arrives in Design team</Button>
        <div.demo-phone style="height: 600px">
            <ConversationList id="chats-demo" chats={chats_now} now={conversation_list_demo_now}
                              on_open={(i) => { opened = str(i) }}
                              on_archive={(i) => { log = `archive:${i}` }}
                              on_undo={(i) => { log = `undo:${i}` }}/>
        </div>
        <p.demo-note>Opened <b data-opened>{opened}</b>; last <b data-log>{log}</b></p>
        <div.demo-tablet style="height: 360px" data-wide>
            <ConversationList id="chats-wide" chats={take(conversation_list_demo_chats, 3)} now={conversation_list_demo_now} selected={2}/>
        </div>
        <div.demo-tablet style="height: 300px">
            <ConversationList id="chats-pane" chats={take(conversation_list_demo_chats, 2)} now={conversation_list_demo_now} pane={true}><p data-own-pane>Your own chat view</p></ConversationList>
        </div>
        <div style="height: 120px"><ConversationList id="chats-bad" chats={[null, 2, { name: "no id" }, { id: 5, name: "Bad numbers", unread: "many", at: "nonsense" }, { id: 5, name: "Bad numbers", unread: "many", at: "nonsense" }]} now="garbage"/></div>
        <div style="height: 120px"><ConversationList id="chats-none" empty="Nothing yet"/></div>
    </div>
}

view ConversationListDemo() = <ConversationListDemoLive/>

ui_gallery = ui_gallery | push({ slug: "conversation_list", name: "ConversationList", group: "Mobile",
    summary: "Chats with unread counts, a muted state, pinned at the top, typing indicator, swipe to archive, and relative times from a prop.",
    tags: ["mobile", "interactive", "tablet", "chat", "gesture", "swipe"], needs: ["avatar"],
    demo: ConversationListDemo })
