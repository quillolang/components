component RoundRobinDemoLive() {
    state seen = null
    <div.demo-stack>
        <RoundRobin id="round-robin-demo-five" title="Five-a-side, with a bye" name="league" win={2} teams={["Ada", "Bo", "Cy", "Di", "Ed"]}
                    on_change={(r) => { seen = r }}/>
        <p.demo-note>{seen == null ? "Enter a score to see on_change." : `on_change: ${seen.played} of ${seen.matches} played, ${seen.table[0].team} first.`}</p>
    </div>
}

view RoundRobinDemo() =
    <div.demo-stack>
        <RoundRobin id="round-robin-demo" title="Summer league" teams={["Ada", "Bo", "Cy", "Di"]}/>
        <RoundRobinDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "round_robin", name: "RoundRobin", group: "Scheduling",
    summary: "Fair fixtures by the circle method, with home and away balanced, a bye for an odd number and double rounds, and standings with stated tiebreaks from scores entered.",
    tags: ["smart", "interactive", "fixtures", "league", "standings", "games"], demo: RoundRobinDemo })
