// A one-page PDF written by hand, so the demo needs no files.
let pdf_viewer_demo_src = "data:application/pdf;base64," + ""

view PdfViewerDemo() =
    <div.demo-stack>
        <PdfViewer src={pdf_viewer_demo_src} title="Hello.pdf" height="360px" download="hello.pdf"/>
        <PdfViewer src={pdf_viewer_demo_src} title="Without the bar" bar={false} height="160px"/>
        <p.demo-note>The browser's own viewer draws the PDF; where it cannot, the links remain.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "pdf_viewer", name: "PdfViewer", group: "Media",
    summary: "A PDF in the page with the browser's own viewer, a bar with its name, open and download links, and a fallback.",
    tags: ["document", "media", "file", "no-js"], demo: PdfViewerDemo })
