let rule_form_demo_fields = [
    { name: "kind", label: "Booking for", type: "radio", options: [{ label: "Myself", value: "person" }, { label: "A company", value: "company" }], required: true, value: "person" },
    { name: "company", label: "Company name", show_if: { field: "kind", is: "company" }, required: true },
    { name: "country", label: "Country", type: "select", options: [{ label: "Portugal", value: "PT" }, { label: "Spain", value: "ES" }, { label: "Canada", value: "CA" }], required: true },
    { name: "vat", label: "VAT number", show_if: { field: "kind", is: "company" }, required_if: { field: "country", in: ["PT", "ES"] },
      rules: [{ pattern: "^[A-Z0-9]{8,12}$", message: "A VAT number is 8 to 12 capitals and digits." }], hint: "Needed inside the EU." },
    { name: "guests", label: "Guests", type: "integer", required: true, rules: [{ min: 1, max: 20 }] },
    { name: "seat", label: "Child seats", type: "integer", show_if: { field: "guests", gte: 2 }, rules: [{ max: 4 }] },
    { name: "seat_kind", label: "Kind of seat", type: "select", options: ["Baby", "Booster"], show_if: { field: "seat", gt: 0 }, required: true },
    { name: "from", label: "From", type: "date", required: true },
    { name: "to", label: "To", type: "date", required: true },
    { name: "email", label: "Email", type: "email", required: true },
    { name: "agree", label: "I accept the terms", type: "checkbox", required: true },
]

let rule_form_demo_checks = [
    { rule: { field: "to", gte_field: "from" }, fields: ["to"], message: "To comes on or after From." },
    { rule: { field: "seat", lte_field: "guests" }, message: "There are more child seats than guests." },
]

let rule_form_demo_broken = [
    { name: "a", label: "A", show_if: { field: "b", filled: true } },
    { name: "b", label: "B", show_if: { field: "c", filled: true } },
    { name: "c", label: "C", show_if: { field: "a", filled: true } },
    { name: "d", label: "D", required_if: { field: "e", filled: true } },
    { name: "e", label: "E", required_if: { field: "d", filled: true } },
    { name: "f", label: "F", show_if: { field: "ghost", is: 1 } },
    { name: "f", label: "F again" },
    { name: "g", label: "G", type: "colour", rules: [{ pattern: "(" }] },
    { label: "No name" },
    "not a field",
    { name: "h", label: "H", type: "select" },
]

component RuleFormDemoLive() {
    state sent = "Fill it in and send it to see on_submit."
    <div.demo-stack>
        <RuleForm id="rule-form-demo" fields={rule_form_demo_fields} checks={rule_form_demo_checks} submit="Book"
                  on_submit={(v) => { sent = `on_submit: ${json.stringify(v)}` }}/>
        <p.demo-note data-sent="true">{sent}</p>
    </div>
}

view RuleFormDemo() =
    <div.demo-stack>
        <RuleFormDemoLive/>
        <RuleForm id="rule-form-demo-broken" fields={rule_form_demo_broken} submit="Send"/>
    </div>

ui_gallery = ui_gallery | push({ slug: "rule_form", name: "RuleForm", group: "Forms",
    summary: "A form from a data description: fields shown and required by rules, validation and cross-field checks, cycles reported, hidden fields left out of what is sent.",
    tags: ["smart", "interactive", "form", "validation", "rules", "conditional"], needs: ["regex_tester"], demo: RuleFormDemo })
