view EmbedFrameDemo() =
    <div.demo-stack>
        <EmbedFrame src="https://www.openstreetmap.org/export/embed.html?bbox=-9.1700,38.7000,-9.1200,38.7300&layer=mapnik"
                    title="Map of central Lisbon" ratio="21/9" fullscreen={true} allow="fullscreen"/>
        <div.demo-row style="align-items: flex-start">
            <EmbedFrame src="/?only=button" title="The Button component, in a frame" ratio="4/3" width="320px"/>
            <EmbedFrame src="/?only=badge&theme=dark" title="The Badge component, dark" height="200px" width="320px"
                        sandbox="allow-scripts allow-same-origin"/>
        </div>
        <p.demo-note>A frame keeps its ratio as the page narrows; the last one has a fixed height instead.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "embed_frame", name: "EmbedFrame", group: "Media",
    summary: "Another page in a frame that keeps its shape and fills its width, with a title, permissions and a sandbox.",
    tags: ["media", "layout", "video", "no-js"], demo: EmbedFrameDemo })
