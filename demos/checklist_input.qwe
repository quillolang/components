component ChecklistInputDemoLive() {
    state done = []
    <div.demo-stack>
        <ChecklistInput name="launch" label="Launch checklist" field="checklist-input-demo-live"
                        items={["Write the announcement", "Tag the release", "Deploy to production"]}
                        on_change={(vs) => { done = vs }}/>
        <p.demo-note>{len(done) == 0 ? "Nothing ticked." : `Ticked: ${join(done, ", ")}`}</p>
    </div>
}

view ChecklistInputDemo() =
    <div.demo-stack.demo-narrow>
        <ChecklistInput name="setup" label="Getting started" field="checklist-input-demo-setup"
                        hint="Tick each step as you go." values={["project"]}
                        items={[{ label: "Create a project", value: "project" },
                                { label: "Invite the team", value: "invite", checked: true, hint: "They get an email." },
                                { label: "Connect a domain", value: "domain" },
                                { label: "Add a payment method", value: "billing" },
                                { label: "Deploy", value: "deploy", disabled: true }]}/>
        <ChecklistInputDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "checklist_input", name: "ChecklistInput", group: "Forms",
    summary: "Checkboxes under a progress line that says how many are done and fills as they are ticked; each posts with a form.",
    tags: ["forms", "input", "progress", "list", "interactive"], demo: ChecklistInputDemo })
