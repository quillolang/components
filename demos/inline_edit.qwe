component InlineEditDemoLive() {
    state log = "Nothing saved yet."
    <div.demo-stack>
        <InlineEdit name="ie-demo-title" label="Board title" value="Launch plan" size="lg" required={true}
                    on_change={(v) => { log = `Saved “${v}”.` }}/>
        <p.demo-note>{log}</p>
    </div>
}

view InlineEditDemo() =
    <div.demo-stack.demo-narrow>
        <InlineEditDemoLive/>
        <InlineEdit name="ie-demo-owner" label="Owner" value="Grace Hopper" show_label={true}
                    hint="Click the name, or Tab to it and press Enter."/>
        <InlineEdit name="ie-demo-note" label="Note" placeholder="Add a note" size="sm" maxlength={80} buttons={false}/>
        <InlineEdit name="ie-demo-locked" label="Plan" value="Team" disabled={true} size="sm"/>
    </div>

ui_gallery = ui_gallery | push({ slug: "inline_edit", name: "InlineEdit", group: "Forms",
    summary: "Text that turns into a box to change it in place: Enter saves, Escape puts it back.",
    demo: InlineEditDemo })
