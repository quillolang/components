let jump_links_demo_items = [
    { id: "jump-demo-overview", label: "Overview" }, { id: "jump-demo-specs", label: "Specs" },
    { id: "jump-demo-reviews", label: "Reviews", badge: 128 }, { id: "jump-demo-qa", label: "Questions", badge: 12 },
    { id: "jump-demo-similar", label: "Similar items" }, { href: "#jump_links", label: "Back to top" }
]

view JumpLinksDemo() =
    <div.demo-stack style="gap: 20px">
        <JumpLinks id="jump-links-demo" title="Jump to" items={jump_links_demo_items} current="jump-demo-specs"/>
        <div style="display: grid; gap: 8px">
            {for it in jump_links_demo_items | filter((it) => get(it, "id") != null) =>
                <p.demo-note id={it.id} style="margin: 0">{it.label}: the section the link goes to.</p>}
        </div>
        <JumpLinks id="jump-links-demo-underline" variant="underline" items={jump_links_demo_items} current="jump-demo-reviews"/>
        <div style="width: 320px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius); padding: 0 8px">
            <JumpLinks id="jump-links-demo-narrow" items={jump_links_demo_items}/>
        </div>
        <p.demo-note>Narrow, the row scrolls sideways.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "jump_links", name: "JumpLinks", group: "Navigation",
    summary: "A row of links to the sections of the page, scrolling sideways when narrow and sticking to the top if asked.",
    tags: ["navigation", "link", "page", "no-js"], demo: JumpLinksDemo })
