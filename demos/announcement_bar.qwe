component AnnouncementBarDemoLive() {
    state closed = false
    <div.demo-stack>
        <AnnouncementBar badge="New" tone="neutral" href="#announcement_bar" link="See pricing" on_dismiss={() => { closed = true }}>
            Teams now get usage-based pricing.
        </AnnouncementBar>
        <p.demo-note>{closed ? "Dismissed: on_dismiss was called." : "Close it to call on_dismiss."}</p>
    </div>
}

view AnnouncementBarDemo() =
    <div.demo-stack>
        <AnnouncementBar href="#announcement_bar" link="Read the post" remember="demo-v2">Quillo 2.0 is out: live queries, typed records and a debugger.</AnnouncementBar>
        <AnnouncementBarDemoLive/>
        <AnnouncementBar tone="warning" dismissable={false}>Maintenance Sunday 02:00–03:00 UTC.</AnnouncementBar>
        <AnnouncementBar tone="success" href="#announcement_bar">Your export is ready.</AnnouncementBar>
    </div>

ui_gallery = ui_gallery | push({ slug: "announcement_bar", name: "AnnouncementBar", group: "Marketing",
    summary: "A slim bar at the top with one message, a badge and a link, closed for good once dismissed.",
    tags: ["marketing", "notification", "feedback", "page", "interactive"],
    demo: AnnouncementBarDemo })
