let price_ticker_demo_quotes = [
    { symbol: "ACME", price: 182.4, change: 1.25, href: "#price_ticker" }, { symbol: "GLBX", price: 48.61, change: -0.82 },
    { symbol: "INIT", price: 114.74, change: 0.31 }, { symbol: "UMBR", price: 57.72, change: -2.4 },
    { symbol: "STRK", price: 123.52, change: 3.06 }, { symbol: "WAYN", price: 359.62, change: 0 },
    { symbol: "HOOL", price: 88.1, change: -0.12 }, { symbol: "SOYL", price: 96.03, change: 0.77 },
]

view PriceTickerDemo() =
    <div.demo-stack>
        <div id="price_ticker-demo-stocks"><PriceTicker items={price_ticker_demo_quotes} prefix="$" label="Stocks"/></div>
        <div id="price_ticker-demo-crypto">
            <PriceTicker label="Crypto" speed={18} decimals={0} items={[
                { symbol: "BTC", price: 61250, change: 2.14 }, { symbol: "ETH", price: 2410, change: -1.03 },
                { symbol: "SOL", price: 152, change: 5.6 }, { symbol: "ADA", price: 1, change: null }]}/>
        </div>
        <p.demo-note>It stops while the pointer is on it; with reduced motion it stands still and scrolls by hand.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "price_ticker", name: "PriceTicker", group: "Charts",
    summary: "A strip of symbols, prices and changes that scrolls by itself with CSS, stops on hover and stands still for reduced motion.",
    tags: ["data", "trading", "animation", "no-js"],
    demo: PriceTickerDemo })
