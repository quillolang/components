// From `used`: yes goes to the score, no to why not, which ends it soon.
let branching_survey_demo_questions = [
    { id: "used", text: "Have you used the new booking page?", options: ["Yes", "No"], jumps: [{ when: "No", to: "why_not" }, { when: "Yes", to: "score" }] },
    { id: "score", text: "How easy was it?", type: "scale", min: 1, max: 5, help: "1 is very hard, 5 is very easy.", jumps: [{ lte: 2, to: "problem" }] },
    { id: "liked", text: "What did you like?", type: "multi", options: ["Speed", "Prices", "Calendar"], required: false, jumps: [{ when: "Calendar", to: "calendar" }], next: "contact" },
    { id: "calendar", text: "Which calendar do you use?", options: ["Google", "Apple", "Other"], next: "contact" },
    { id: "problem", text: "What went wrong?", type: "text" },
    { id: "bookings", text: "How many bookings a year do you make?", type: "number", min: 0, required: false },
    { id: "contact", text: "May we contact you?", options: ["Yes", "No"], required: false, next: "end" },
    { id: "why_not", text: "What kept you away?", type: "text", required: false, next: "contact" },
]

let branching_survey_demo_broken = [
    { id: "a", text: "A", options: ["x", "y"], jumps: [{ when: "x", to: "b" }, { when: "z", to: "ghost" }] },
    { id: "b", text: "B", type: "text", next: "c" },
    { id: "c", text: "C", type: "text", next: "a" },
    { id: "lost", text: "Lost", type: "text", next: "end" },
    { id: "a", text: "A again", type: "text" },
    { text: "No id" },
]

component BranchingSurveyDemoLive() {
    state said = "Finish it to see on_finish."
    <div.demo-stack>
        <BranchingSurvey id="branching-survey-demo" questions={branching_survey_demo_questions} on_finish={(a) => { said = `on_finish: ${json.stringify(a)}` }}/>
        <p.demo-note data-said="true">{said}</p>
    </div>
}

view BranchingSurveyDemo() =
    <div.demo-stack>
        <BranchingSurveyDemoLive/>
        <BranchingSurvey id="branching-survey-demo-broken" questions={branching_survey_demo_broken}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "branching_survey", name: "BranchingSurvey", group: "Forms",
    summary: "One question at a time with jumps by answer: back keeps answers, progress is counted from the longest path left, and unreachable or looping questions are reported.",
    tags: ["smart", "interactive", "survey", "branching", "questions", "wizard"], demo: BranchingSurveyDemo })
