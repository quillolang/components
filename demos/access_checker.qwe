let access_checker_demo_roles = { viewer: [], editor: ["viewer"], finance: ["viewer"], admin: ["editor", "finance"] }
let access_checker_demo_users = { ada: ["admin"], ben: ["editor"], cleo: ["finance"], dev: [] }
let access_checker_demo_rules = [
    { effect: "allow", role: "viewer", action: "read", resource: "docs/*" },
    { effect: "allow", role: "editor", action: "write", resource: "docs/*" },
    { effect: "allow", role: "finance", action: "read", resource: "billing/*" },
    { effect: "allow", role: "admin", action: "*", resource: "*" },
    { effect: "deny", role: "editor", action: "write", resource: "docs/published", note: "frozen after review" },
    { effect: "deny", user: "cleo", action: "read", resource: "billing/payroll" },
]

component AccessCheckerDemoLive() {
    state last = null
    <div.demo-stack>
        <AccessChecker id="access-checker-demo-live" title="With on_decide" editable={false} roles={{ reader: [] }} users={{ sam: ["reader"] }}
                       rules={[{ effect: "allow", role: "reader", action: "read", resource: "*" }]} actions={["read", "write"]}
                       resources={["wiki"]} on_decide={(d) => { last = d }}/>
        <p.demo-note>{last == null ? "Pick a cell to see on_decide." : `on_decide: ${last.who} ${last.action} ${last.resource} is ${last.allowed ? "allowed" : "denied"} by rule ${last.rule}.`}</p>
    </div>
}

view AccessCheckerDemo() =
    <div.demo-stack>
        <AccessChecker id="access-checker-demo" roles={access_checker_demo_roles} users={access_checker_demo_users} rules={access_checker_demo_rules}
                       resources={["docs/plan", "docs/published", "billing/payroll", "billing/invoices"]} actions={["read", "write"]}
                       who="user:ben" action="write" resource="docs/published"/>
        <AccessCheckerDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "access_checker", name: "AccessChecker", group: "Dashboard",
    summary: "Works out allow or deny from roles, grants and denies given as data, names the rule that decided, and shows a matrix of everything.",
    tags: ["smart", "interactive", "security", "permissions", "roles", "policy"], demo: AccessCheckerDemo })
