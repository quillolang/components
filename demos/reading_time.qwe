let reading_time_demo_text = repeat("The quick brown fox jumps over the lazy dog and keeps running through the long afternoon. ", 50)

view ReadingTimeDemo() =
    <div.demo-stack>
        <div.demo-row style="gap: 24px">
            <ReadingTime id="reading-time-demo-text" text={reading_time_demo_text}/>
            <ReadingTime id="reading-time-demo-words" words={1850} wpm={250} icon={false}/>
            <ReadingTime id="reading-time-demo-short" text="Just a note." less="Under a minute" size="sm"/>
            <ReadingTime id="reading-time-demo-format" words={2400} format="{n} minutes to read"/>
        </div>
        <p.demo-note>The first is a text of {reading_time_words(reading_time_demo_text)} words at 200 a minute.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "reading_time", name: "ReadingTime", group: "Utilities",
    summary: "\"4 min read\", worked out from a text or a word count, with the wording and the reading speed yours to set.",
    tags: ["utility", "text", "time", "typography", "no-js"],
    demo: ReadingTimeDemo })
