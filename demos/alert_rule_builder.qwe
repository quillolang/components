// Three days of CPU at 5 minute steps, the same on every load: a daily wave, a little
// noise from a fixed generator, and two bad spells.
fn alert_rule_builder_demo_series() -> list {
    let seed = 12345
    let out = []
    for i in 0..864 {
        seed = (seed * 1103515 + 12345) % 2147483648
        let noise = (seed % 1000) / 100
        let wave = 45 + 18 * math.sin(i * 2 * math.pi / 288)
        let spike = (i >= 300 && i < 340) || (i >= 610 && i < 622) ? 34 : 0
        out = push(out, round(wave + noise + spike, 1))
    }
    out
}

component AlertRuleBuilderDemoLive() {
    state seen = null
    <div.demo-stack>
        <AlertRuleBuilder id="alert-rule-builder-demo-live" title="A short sample, with on_change" metric="Errors" threshold={90} for_minutes={0} cooldown_minutes={0}
                          start="2026-10-01T00:00:00Z" step_minutes={5} series={[10, 95, 10, 96, 10, 97, 10, 98, 99, 100, 10, 10]}
                          on_change={(r) => { seen = r }}/>
        <p.demo-note>{seen == null ? "Change the rule to see on_change." : `on_change: ${seen.firings} firings, ${seen.per_day} a day, flapping ${seen.flapping}, never ${seen.never}.`}</p>
    </div>
}

view AlertRuleBuilderDemo() =
    <div.demo-stack>
        <AlertRuleBuilder id="alert-rule-builder-demo" metric="CPU" unit="%" threshold={85} comparison=">" for_minutes={10} cooldown_minutes={30}
                          start="2026-10-01T00:00:00Z" step_minutes={5} series={alert_rule_builder_demo_series()}/>
        <AlertRuleBuilderDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "alert_rule_builder", name: "AlertRuleBuilder", group: "Dashboard",
    summary: "Backtests an alert rule on a sample series, drawing each firing and warning of a rule that flaps or never fires.",
    tags: ["smart", "interactive", "alerts", "monitoring", "backtest", "chart"], demo: AlertRuleBuilderDemo })
