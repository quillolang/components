component ConfettiDemoLive() {
    state bursts = 0
    <div.demo-stack>
        <div.demo-row>
            <Confetti trigger="🎉 Celebrate" on_done={() => { bursts += 1 }}/>
            <Confetti from="sides" count={160}/>
            <Button id="confetti-demo-fire" variant="outline" on_click={() => { confetti_fire() }}>Fire from both sides too</Button>
        </div>
        <p.demo-note>{bursts == 0 ? "Press Celebrate." : `Bursts over: ${bursts}.`}</p>
    </div>
}

view ConfettiDemo() =
    <div.demo-stack>
        <ConfettiDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "confetti", name: "Confetti", group: "Utilities",
    summary: "A burst of confetti over the page on a canvas, fired by a button, on mount, or by confetti_fire().",
    tags: ["utility", "animation", "button", "interactive"],
    demo: ConfettiDemo })
