component PrintButtonDemoLive() {
    state prints = 0
    <div.demo-row>
        <PrintButton target="print-demo-receipt" label="Print the receipt" variant="solid" on_print={() => { prints += 1 }}/>
        <span.demo-note>{prints == 0 ? "Not printed yet." : `Printed ${prints} ${prints == 1 ? "time" : "times"}.`}</span>
    </div>
}

view PrintButtonDemo() =
    <div.demo-stack>
        <div id="print-demo-receipt" style="max-width: 320px; padding: 16px 18px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius)">
            <strong>Receipt #1042</strong>
            <p style="margin: 6px 0 0">2 × Coffee, 1 × Croissant — 9.40</p>
        </div>
        <div.demo-row>
            <PrintButtonDemoLive/>
            <PrintButton/>
            <PrintButton label="Print" variant="ghost" size="sm"/>
        </div>
        <p.demo-note>The first prints only the receipt above; the others, the whole page.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "print_button", name: "PrintButton", group: "Actions",
    summary: "Prints the page, or only one element of it by id, hiding the rest while the print dialog is open.",
    tags: ["button", "print", "document", "interactive"],
    demo: PrintButtonDemo })
