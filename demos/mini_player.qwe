// Fourteen silent seconds, small enough to sit in the page.
let mini_player_demo_src = "data:audio/mp4;base64,"

fn mini_player_demo_art(fill: str, word: str) =
    "data:image/svg+xml," + url_encode(`<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 300 300'><rect width='300' height='300' fill='${fill}'/><circle cx='150' cy='150' r='96' fill='#ffffff33'/><text x='150' y='162' font-size='34' text-anchor='middle' fill='#fff' font-family='sans-serif'>${word}</text></svg>`)

let mini_player_demo_tracks = [
    { id: 1, title: "Harbour Lights", artist: "The Low Tides", art: mini_player_demo_art("#3d5a80", "Salt"), src: mini_player_demo_src },
    { id: 2, title: "Night Ferry", artist: "The Low Tides", art: mini_player_demo_art("#ee6c4d", "Ferry"), src: mini_player_demo_src },
]

let mini_player_demo_tabs = [
    { label: "Listen", icon: "M3 18v-6a9 9 0 0 1 18 0v6" },
    { label: "Search", icon: "M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16zM21 21l-4.3-4.3" },
    { label: "Library", icon: "M4 19V5M9 19V5M14 19 18 5" },
]

component MiniPlayerDemoLive() {
    state now = mini_player_demo_tracks[0]
    state changes = 0
    state big = false
    state own = false
    <div.demo-phone>
        <div style="display: grid; gap: 12px; padding: 16px">
            <p.demo-note id="mini-demo-note">Opened or closed {changes} times; is {big ? "open" : "closed"}.</p>
            <p.demo-note>The tracks are silent, to keep the page small. Swipe the bar up.</p>
            <div.demo-row>
                <Button id="mini-demo-open" size="lg" variant="outline" on_click={() => { big = true }}>Open from the page</Button>
                <Button id="mini-demo-own" size="lg" variant="ghost" on_click={() => { own = !own }}>Change the player</Button>
            </div>
        </div>
        {own
            ? <MiniPlayer above={65} src={mini_player_demo_src} id="mini-demo-own-audio" title="Episode 12: Views first" artist="The Quillo Podcast"/>
            : <MiniPlayer above={65} media="mini-demo" title={now.title} artist={now.artist} art={now.art} full_player={true} open={big}
                          on_toggle={(o) => { big = o; changes += 1 }}>
                  <NowPlaying id="mini-demo" queue={mini_player_demo_tracks} on_change={(s) => { now = s.track }}/>
              </MiniPlayer>}
        <BottomNav wide={true} items={mini_player_demo_tabs} current="Listen"/>
    </div>
}

view MiniPlayerDemo() = <MiniPlayerDemoLive/>

ui_gallery = ui_gallery | push({ slug: "mini_player", name: "MiniPlayer", group: "Mobile",
    summary: "A bar above the tabs with progress and play, expanding to the full player by a swipe up.",
    tags: ["mobile", "interactive", "media", "player", "audio", "tablet"],
    needs: ["scrub_bar", "now_playing", "sleep_timer_sheet", "bottom_nav"],
    demo: MiniPlayerDemo })
