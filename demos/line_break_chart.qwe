// Prices from a seeded random walk (Park–Miller), the same on every render: `count`
// candles from the day `from` on, skipping weekends, daily or hourly (10:00 to 16:00),
// rounded to `places` decimals.
fn line_break_chart_demo_walk(seed: int, count: int, start: num, from: str, hourly: bool = false, places: int = 2) -> list {
    let s = seed
    let rnd = () => {
        s = s * 16807 % 2147483647
        s / 2147483647
    }
    let scale = pow(10, places)
    let cut = (v) => round(v * scale) / scale
    let p = start
    let day = from
    let hour = 10
    let out = []
    while len(out) < count {
        if date.weekday(day) <= 5 {
            let open = cut(p * (1 + (rnd() - 0.5) * 0.006))
            let close = cut(open * (1 + (rnd() - 0.485) * (hourly ? 0.012 : 0.035)))
            let high = cut(max([open, close]) * (1 + rnd() * 0.01))
            let low = cut(min([open, close]) * (1 - rnd() * 0.01))
            let volume = round((hourly ? 90000 : 900000) * (1 + rnd() * 1.5 + abs(close - open) * 30 / open))
            out = out | push({ time: hourly ? `${day}T${hour < 10 ? "0" : ""}${hour}:00:00Z` : day, open, high, low, close, volume })
            p = close
        }
        if hourly && hour < 16 && date.weekday(day) <= 5 {
            hour += 1
        } else {
            hour = 10
            day = date.add_days(day, 1)
        }
    }
    out
}

let line_break_chart_demo_daily = line_break_chart_demo_walk(19, 140, 64.3, "2026-04-01")

view LineBreakChartDemo() =
    <div.demo-stack>
        <div id="line_break_chart-demo-three">
            <LineBreakChart label="Umbrella Corp., three-line break" show_label={true} candles={line_break_chart_demo_daily} prefix="$"/>
        </div>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 32px 40px">
            <div id="line_break_chart-demo-two">
                <LineBreakChart label="Two-line break" show_label={true} candles={line_break_chart_demo_daily} lines={2}
                                prefix="$" height={200}/>
            </div>
            <div id="line_break_chart-demo-closes">
                <LineBreakChart label="Closes alone" show_label={true} height={200}
                                closes={[10, 11, 12, 13, 12.5, 11.5, 10.8, 13.4, 9.5, 9]}/>
            </div>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "line_break_chart", name: "LineBreakChart", group: "Charts",
    summary: "A three-line break chart from closing prices: lines go on while the close makes new ends, and turn only past the last three lines.",
    tags: ["chart", "data", "trading", "no-js"],
    demo: LineBreakChartDemo })
