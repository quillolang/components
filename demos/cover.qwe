view CoverDemo() =
    <div.demo-stack>
        <Cover id="cover-demo-hero" height="360px" tone="subtle" text={true}
               top={<div style="display: flex; justify-content: space-between; align-items: center"><b>Acme</b><Button size="sm" variant="outline">Sign in</Button></div>}
               bottom={<p style="margin: 0; text-align: center; color: var(--ui-muted); font-size: 13px">Scroll for more ↓</p>}>
            <h2 style="margin: 0 0 8px; font-size: 32px; letter-spacing: -.02em">Ship on Friday.</h2>
            <p style="margin: 0 0 16px; color: var(--ui-muted)">Everything a small team needs to get a release out, in one place.</p>
            <Button>Start free</Button>
        </Cover>
        <p.demo-note>The middle has as much room above it as below, whatever the top and bottom hold. Without them, it is simply centred.</p>
        <Cover id="cover-demo-plain" height="200px" pad={16} text={true}>
            <p style="margin: 0">Just the middle, in a 200px-tall block.</p>
        </Cover>
    </div>

ui_gallery = ui_gallery | push({ slug: "cover", name: "Cover", group: "Layout",
    summary: "A block as tall as the screen with one thing in its middle, and something at its top and bottom if given.",
    tags: ["layout", "page", "marketing", "no-js"], demo: CoverDemo })
