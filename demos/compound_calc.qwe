component CompoundCalcDemoLive() {
    state note = "Change something to see on_change."
    <div.demo-stack>
        <CompoundCalc id="compound-calc-demo-live" name="pension" title="Yearly deposits, daily interest" start="5000" contribution="1000" contribute_per_year={1} timing="start"
                      rate={5.5} compound_per_year={365} years={30} inflation={2.5} target="500000" currency="EUR"
                      on_change={(r) => { note = `on_change: balance ${r.balance}, interest ${r.interest}, needed ${r.needed_rate}.` }}/>
        <p.demo-note>{note}</p>
    </div>
}

view CompoundCalcDemo() =
    <div.demo-stack>
        <CompoundCalc id="compound-calc-demo" start="10000" contribution="200" rate={7} years={20}/>
        <CompoundCalcDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "compound_calc", name: "CompoundCalc", group: "Finance",
    summary: "Grows a balance year by year with contributions and interest apart, after inflation, and finds the rate needed to reach a target.",
    tags: ["smart", "interactive", "finance", "savings", "interest", "calculator"], demo: CompoundCalcDemo })
