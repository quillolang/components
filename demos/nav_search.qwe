component NavSearchDemoLive() {
    state q = ""
    state sent = null
    <div.demo-stack>
        <div style="display: flex; align-items: center; gap: 16px; height: 56px; padding: 0 16px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius)">
            <b>Acme</b>
            <span style="flex: 1"></span>
            <NavSearch id="nav-search-demo" placeholder="Search docs" on_input={(t) => { q = t }} on_submit={(t) => { sent = t }}/>
        </div>
        <p.demo-note>{sent != null ? `Searched for "${sent}".` : q != "" ? `Typing: ${q}` : "Press / anywhere to search; the box grows when focused."}</p>
    </div>
}

view NavSearchDemo() =
    <div.demo-stack>
        <NavSearchDemoLive/>
        <div.demo-row>
            <NavSearch id="nav-search-demo-plain" action="#nav_search" shortcut={false} width={140} wide={240} value="quillo"/>
            <span.demo-note>A plain one: Enter sends q to its action.</span>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "nav_search", name: "NavSearch", group: "Navigation",
    summary: "A search box for a navbar that grows when focused, with / to reach it and Escape to clear; a real form sends it.",
    tags: ["navigation", "search", "input", "forms", "keyboard", "interactive"], demo: NavSearchDemo })
