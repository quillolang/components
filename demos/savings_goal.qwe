view SavingsGoalDemo() =
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 12px">
        <SavingsGoal id="savings-goal-demo" title="New roof" target={60000} saved={32450.75} by="2027-06-30" today="2026-10-29"
                     currency="PHP" account="Goal savings •••• 4821" href="#deposit"
                     deposits={[
                         { date: "2026-10-15", amount: 3500, note: "Salary deduction" },
                         { date: "2026-09-30", amount: 3500, note: "Salary deduction" },
                         { date: "2026-09-12", amount: 1200.75, note: "Cash, Poblacion branch" },
                         { date: "2026-08-31", amount: 3500, note: "Salary deduction" },
                         { date: "2026-07-31", amount: 3500, note: "Salary deduction" },
                         { date: "2026-06-30", amount: 3500, note: "Salary deduction" },
                     ]}/>
        <SavingsGoal id="savings-goal-demo-school" title="School fees, second semester" target={8000} saved={6500} by="2026-11-15"
                     today="2026-10-29" currency="PHP" deposits={[{ date: "2026-10-01", amount: 1500 }]}/>
        <SavingsGoal id="savings-goal-demo-done" title="Emergency fund" target={1500} saved={1620} by="2026-12-31" today="2026-10-29"
                     account="Share savings •••• 0377" href="#deposit"/>
        <SavingsGoal id="savings-goal-demo-late" title="Tricycle down payment" target={20000} saved={18200} by="2026-09-30" today="2026-10-29"
                     currency="PHP"/>
    </div>

ui_gallery = ui_gallery | push({ slug: "savings_goal", name: "SavingsGoal", group: "Finance",
    summary: "A savings goal: target and saved so far, the progress, the deposit needed each month to reach it by the date, and the last deposits.",
    tags: ["finance", "coop", "banking", "card", "calculator", "no-js"], demo: SavingsGoalDemo })
