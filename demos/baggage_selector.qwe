component BaggageSelectorDemoLive() {
    state note = "Add a bag: on_change gets the counts and the total."
    <div.demo-stack>
        <BaggageSelector id="baggage-selector-demo" name="bags" passengers={["Ada Lovelace", "Charles Babbage", "Grace Hopper"]}
                         value={[1, 0, 0]} prices={[35.00m, 45.00m, 70.00m]} weight="23 kg" size="158 cm in all"
                         cabin="1 cabin bag up to 8 kg and 1 personal item" airport_price={70.00m}
                         on_change={(counts, total) => { note = `on_change: ${join(counts, ", ")}; ${total} in all.` }}/>
        <p.demo-note id="baggage-selector-demo-note">{note}</p>
    </div>
}

view BaggageSelectorDemo() =
    <div class="demo-row" style="align-items: start">
        <BaggageSelectorDemoLive/>
        <BaggageSelector id="baggage-selector-demo-eur" name="rail_bags" label="Extra luggage" passengers={["Grace Hopper"]} included={1}
                         prices={[50]} weight="32 kg" currency="EUR" locale="de-DE"/>
    </div>

ui_gallery = ui_gallery | push({ slug: "baggage_selector", name: "BaggageSelector", group: "Travel",
    summary: "Checked bags for each passenger with counters, what the first, second and third bag cost, the cabin allowance, the total and the saving against the airport.",
    tags: ["travel", "flights", "forms", "commerce", "interactive"], demo: BaggageSelectorDemo })
