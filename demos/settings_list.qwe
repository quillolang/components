let settings_list_demo_groups = [
    { title: "Connections", footer: "Mobile data is used when Wi-Fi is off.", rows: [
        { key: "wifi", label: "Wi-Fi", type: "toggle", value: true, keywords: ["internet", "network"] },
        { key: "wifi_ask", label: "Ask to join networks", type: "toggle", value: false, requires: "wifi" },
        { key: "bluetooth", label: "Bluetooth", type: "toggle", value: false, detail: "Headphones and watches" },
        { key: "roaming", label: "Data roaming", type: "value", value: "ask", options: [{ value: "off", label: "Off" }, { value: "ask", label: "Ask first" }, { value: "on", label: "Always" }], keywords: "abroad travel" }
    ] },
    { title: "Sound", rows: [
        { key: "tone", label: "Ringtone", type: "value", value: "bell", options: ["bell", "chime", "marimba"] },
        { key: "volume", label: "Alert volume", type: "value", value: 50, options: [0, 25, 50, 75, 100] },
        { key: "vibrate", label: "Vibrate on silent", type: "toggle", value: true },
        { key: "guide", label: "Sound guide", type: "link", href: "#settings-sound-guide" }
    ] },
    { title: "Café mode", footer: "For loud rooms.", rows: [
        { key: "cafe", label: "Résumé when back", type: "toggle", value: false }
    ] },
    { title: "About", rows: [
        { key: "version", label: "Version", value: "4.2.1" },
        { key: "legal", label: "Legal notices", type: "link" },
        { key: "old", label: "Old sync", type: "toggle", value: false, disabled: true }
    ] }
]

component SettingsListDemoLive() {
    state log = "none"
    state opened = "none"
    <div.demo-stack>
        <div.demo-phone style="height: 560px">
            <SettingsList id="settings-demo" groups={settings_list_demo_groups} values={{ bluetooth: true }}
                          on_change={(k, v) => { log = `${k}=${type_of(v)}:${v}` }} on_open={(k) => { opened = k }}/>
        </div>
        <p.demo-note>Changed: <b data-log>{log}</b>, opened <b data-opened>{opened}</b></p>
        <div.demo-tablet style="height: 420px" data-wide>
            <SettingsList id="settings-wide" groups={settings_list_demo_groups}/>
        </div>
        <SettingsList id="settings-bad" search={false} groups={[null, { title: "Bad rows", rows: [null, { label: "No key", type: "toggle" }, { type: "link" }, { key: "fine", label: "A fine row", type: "value", value: "gone", options: ["here"] }, { key: "constructor", label: "Odd key", type: "toggle" }] }, { rows: "nope" }]}/>
    </div>
}

view SettingsListDemo() = <SettingsListDemoLive/>

ui_gallery = ui_gallery | push({ slug: "settings_list", name: "SettingsList", group: "Mobile",
    summary: "Rows of toggles, values and links from data, with a search across them, and on_change(key, value).",
    tags: ["mobile", "interactive", "tablet", "settings", "search", "form"],
    demo: SettingsListDemo })
