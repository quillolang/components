let peek_sheet_demo_stops = ["Harbour Gate", "Museum Quarter", "University", "Old Town", "Central Station", "Riverside", "Market Square", "Hospital", "Stadium", "North Park", "Lakeside", "Airport Road", "Foundry Lane", "Tram Depot", "City Hall", "Botanic Garden", "Library", "Ferry Pier", "West End", "Hill Street", "Clock Tower", "Bus Station", "Canal Basin", "Theatre Row", "South Gate", "Old Mill", "Fair Green", "Mint Yard"]

let peek_sheet_demo_css = css`
.peek-sheet-demo-map { position: absolute; inset: 0; padding: 12px; background: repeating-linear-gradient(0deg, transparent 0 46px, var(--ui-border) 46px 47px), repeating-linear-gradient(90deg, transparent 0 46px, var(--ui-border) 46px 47px), var(--ui-subtle); }
.peek-sheet-demo-rows { margin: 0; padding: 0; list-style: none; }
.peek-sheet-demo-rows li { padding: 13px 0; border-bottom: 1px solid var(--ui-border); }
.peek-sheet-demo-search { box-sizing: border-box; display: block; width: 100%; height: 46px; margin-bottom: 8px; padding: 0 12px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius-sm); background: var(--ui-surface); color: var(--ui-fg); font: 16px var(--ui-font); }
`

component PeekSheetDemoLive() {
    style global peek_sheet_demo_css
    state stop = "peek"
    state pins = 0
    state q = ""
    state peek_at = 112
    <div.demo-stack>
        <div.demo-tablet>
            <div.peek-sheet-demo-map>
                <div.demo-row>
                    <Button size="lg" on_click={() => { pins += 1 }}>Drop a pin</Button>
                    <Button size="lg" variant="soft" on_click={() => { peek_at = peek_at == 112 ? 160 : 112 }}>Change the peek</Button>
                </div>
            </div>
            <PeekSheet title="28 stops nearby" peek={peek_at} on_detent={(n) => { stop = n }}>
                <input.peek-sheet-demo-search type="search" placeholder="Filter stops" aria-label="Filter stops" bind:value={q}/>
                <ul.peek-sheet-demo-rows>
                    {for s in peek_sheet_demo_stops => <li key={s}>{s}</li>}
                </ul>
            </PeekSheet>
        </div>
        <p.demo-note>Stop: <span class="peek-sheet-demo-stop">{stop}</span>. Pins dropped: <span class="peek-sheet-demo-pins">{pins}</span>.</p>
    </div>
}

view PeekSheetDemo() = <PeekSheetDemoLive/>

ui_gallery = ui_gallery | push({ slug: "peek_sheet", name: "PeekSheet", group: "Mobile",
    summary: "A sheet that stays over a map or page and grows with a drag, with what is behind it still in use; on a tablet, a card down the side.",
    tags: ["mobile", "interactive", "tablet", "sheet", "map", "gesture"],
    needs: ["bottom_sheet"], demo: PeekSheetDemo })
