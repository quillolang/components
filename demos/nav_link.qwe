view NavLinkDemo() =
    <div.demo-stack>
        <div.demo-row id="nav-link-demo-page">
            <NavLink href="/" exact={true}>Home</NavLink>
            <NavLink href="/docs">Docs</NavLink>
            <NavLink href="/blog">Blog</NavLink>
        </div>
        <p.demo-note>With no `current`, the page's own path is compared: this gallery is at /.</p>
        <div.demo-row id="nav-link-demo-pill">
            <NavLink href="/inbox" current="/inbox/42" variant="pill" icon="M4 4h16v16H4zM4 13h5l1.5 2h3L15 13h5" badge={3}>Inbox</NavLink>
            <NavLink href="/sent" current="/inbox/42" variant="pill" icon="M3 12 21 3l-4 18-5-7zM12 14l9-11">Sent</NavLink>
            <NavLink href="/drafts" current="/inbox/42" variant="pill" icon="✎">Drafts</NavLink>
        </div>
        <div.demo-row id="nav-link-demo-underline" style="gap: 20px">
            <NavLink href="/settings" current="/settings" exact={true} variant="underline">General</NavLink>
            <NavLink href="/settings/team" current="/settings" variant="underline">Team</NavLink>
            <NavLink href="/settings/billing" current="/settings" variant="underline">Billing</NavLink>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "nav_link", name: "NavLink", group: "Navigation",
    summary: "A link marked current when the page's URL is where it goes, or under it; as text, a pill or underlined.",
    tags: ["navigation", "link", "no-js"], demo: NavLinkDemo })
