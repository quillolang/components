view LeadDemo() =
    <div.demo-stack>
        <div>
            <Lead id="lead-demo-first">Quillo is a language for web applications: the pages, the components and the data in one file, run by one binary.</Lead>
            <p id="lead-demo-body" style="margin: 12px 0 0; max-width: 60ch; font: 15px/1.5 var(--ui-font)">The paragraphs that follow are set in the body size, so the lede stands out as the summary of what is to come.</p>
        </div>
        <Lead size="lg" align="center" tone="fg" id="lead-demo-large">Everything you need, nothing you don't.</Lead>
    </div>

ui_gallery = ui_gallery | push({ slug: "lead", name: "Lead", group: "Typography",
    summary: "A lede paragraph, larger and lighter than the body text, in two sizes and three alignments.",
    tags: ["typography", "text", "document", "no-js"],
    demo: LeadDemo })
