// Fourteen silent seconds, small enough to sit in the page.
let synced_lyrics_demo_src = "data:audio/mp4;base64,"

let synced_lyrics_demo_lrc = `[ti:Harbour Lights]
[ar:The Low Tides]
[offset:+500]
[00:00.50]Harbour lights across the water
[00:02.50]Every boat is coming in
[00:04.50]I can hear the evening falling
[00:06.50]On the salt upon my skin
[00:08.50]
[00:09.50]Hold the rope and hold the morning
[00:11.50][00:12.50]Hold it steady, hold it long
[00:13.50]Harbour lights, and then the song
[00:15.50]We were never really gone
[00:17.50]Tide comes in and tide goes out
[00:19.50]That is what the sea is about
[00:21.50]Harbour lights across the water
[00:23.50]Every boat is home`

component SyncedLyricsDemoLive() {
    state position = 3
    state sought = "none"
    <div.demo-stack>
        <audio id="lyrics-demo-audio" src={synced_lyrics_demo_src} preload="auto"></audio>
        <div.demo-phone style="--ui-lyrics-height: 100%">
            <SyncedLyrics media="lyrics-demo-audio" lyrics={synced_lyrics_demo_lrc} rest={2} on_seek={(t) => { sought = `${t}` }}/>
        </div>
        <p.demo-note id="lyrics-demo-note">Last tap went to {sought}</p>
        <div id="lyrics-demo-own" style="--ui-lyrics-height: 240px">
            <SyncedLyrics time={position} offset={-1} rest={0} title="Own clock" lyrics={[{ at: 6, text: "Six" }, { at: 2, text: "Two" }, { at: "x", text: "Bad" }, { at: 4 }, null]}/>
        </div>
        <div.demo-row>
            <Button id="lyrics-demo-later" size="lg" variant="ghost" on_click={() => { position += 2 }}>Two seconds on</Button>
        </div>
        <div id="lyrics-demo-plain" style="--ui-lyrics-height: 120px"><SyncedLyrics lyrics={"Words with no times\nstay plain."}/></div>
        <div id="lyrics-demo-none" style="--ui-lyrics-height: 80px"><SyncedLyrics lyrics={null}/></div>
    </div>
}

view SyncedLyricsDemo() = <SyncedLyricsDemoLive/>

ui_gallery = ui_gallery | push({ slug: "synced_lyrics", name: "SyncedLyrics", group: "Mobile",
    summary: "Lines lit by time, a tap to seek, and the lit line kept centred without jumps.",
    tags: ["mobile", "interactive", "media", "lyrics", "music", "tablet"],
    demo: SyncedLyricsDemo })
