view TourCardDemo() =
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 12px; align-items: start">
        <TourCard id="tour-card-demo-sintra" title="Sintra and Cascais day trip with Pena Palace" category="Day trip"
                  image="https://picsum.photos/seed/sintra/480/360" minutes={540} rating={4.8} reviews={3120} price={69.00m} old={85.00m}
                  badge="Likely to sell out" badge_tone="warning" features={["Free cancellation", "Hotel pickup"]}
                  languages={["English", "Spanish", "French"]} next="Tomorrow, 08:30" href="#sintra" save_href="#save-sintra"/>
        <TourCard id="tour-card-demo-food" title="Porto food and wine walk" category="Food & drink" image="https://picsum.photos/seed/porto-food/480/360"
                  minutes={210} rating={4.95} reviews={1} price={58.50m} currency="EUR" locale="de-DE" features={["Skip the line"]}
                  languages={["English"]} save_href="#saved" saved={true} href="#food"/>
        <TourCard id="tour-card-demo-boat" title="Private sunset sailing" duration="2 to 3 hours" price={240} per="per group of up to 6" from={false}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "tour_card", name: "TourCard", group: "Travel",
    summary: "A tour or activity: photo, badge and save heart, duration, stars and reviews, free cancellation and pickup, languages, the next start and the price from per person.",
    tags: ["travel", "activities", "card", "commerce", "no-js"], demo: TourCardDemo })
