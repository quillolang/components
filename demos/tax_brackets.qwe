component TaxBracketsDemoLive() {
    state note = "Change something to see on_change."
    <div.demo-stack>
        <TaxBrackets id="tax-brackets-demo-live" name="net" title="Credits paid out" income="30000" credits="4000" raise="4%" refundable={true} currency="EUR"
                     brackets={[{ upto: 12500, rate: 0 }, { upto: 50000, rate: 20 }, { upto: 125000, rate: 40 }, { upto: null, rate: 45 }]}
                     on_change={(t) => { note = `on_change: tax ${t.tax}, ${t.effective}% effective, ${t.marginal}% marginal, take-home ${t.take_home}, keeps ${t.raise_kept}.` }}/>
        <p.demo-note>{note}</p>
    </div>
}

view TaxBracketsDemo() =
    <div.demo-stack>
        <TaxBrackets id="tax-brackets-demo" income="62000" deductions="12000" credits="500" raise="5000"
                     brackets={[{ upto: 10000, rate: 10 }, { upto: 40000, rate: 20 }, { upto: null, rate: 30 }]}/>
        <TaxBracketsDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "tax_brackets", name: "TaxBrackets", group: "Finance",
    summary: "Works out progressive tax from brackets as data: tax by bracket, effective and marginal rate, take-home, credits, and what a raise really adds.",
    tags: ["smart", "interactive", "finance", "tax", "income", "salary"], demo: TaxBracketsDemo })
