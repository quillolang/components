let polar_area_chart_demo_grid = "display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 32px 40px"

view PolarAreaChartDemo() =
    <div style={polar_area_chart_demo_grid}>
        <PolarAreaChart label="Orders by weekday" show_label={true} parts={[
            { label: "Mon", value: 132 }, { label: "Tue", value: 158 }, { label: "Wed", value: 141 }, { label: "Thu", value: 187 },
            { label: "Fri", value: 224 }, { label: "Sat", value: 96 }, { label: "Sun", value: 78 }]}/>
        <PolarAreaChart label="Incidents by kind" show_label={true} labels={false} legend={true} size={220} parts={[
            { label: "Outage", value: 4 }, { label: "Slow", value: 11 }, { label: "Data", value: 6 },
            { label: "Security", value: 2 }, { label: "Billing", value: 8 }]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "polar_area_chart", name: "PolarAreaChart", group: "Charts",
    summary: "Slices of equal angle whose length shows each value on rings of round ticks; hovering a slice or its legend picks it out.",
    tags: ["chart", "data", "no-js"],
    demo: PolarAreaChartDemo })
