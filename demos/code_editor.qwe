component CodeEditorDemoLive() {
    state code = "select id, name\nfrom users\nwhere active"
    <div.demo-stack>
        <CodeEditor name="ce-demo-query" label="Query" language="sql" tab_size={2} rows={4} value={code} on_change={(c) => { code = c }}/>
        <p.demo-note>{len(split(code, "\n"))} lines, {len(code)} characters.</p>
    </div>
}

view CodeEditorDemo() {
    <div.demo-stack>
        <CodeEditor name="ce-demo-source" label="Program" language="quillo" rows={8}
                    value={"fn greet(name: str) {\n    `Hello, ${name}`\n}\n\nroute GET / = greet(\"world\")"}
                    hint="Tab indents, Shift+Tab outdents, Enter keeps the indent."/>
        <CodeEditorDemoLive/>
    </div>
}

ui_gallery = ui_gallery | push({ slug: "code_editor", name: "CodeEditor", group: "Forms",
    summary: "A code textarea with line numbers, where Tab puts spaces in, Shift+Tab takes them out and Enter keeps the indent.",
    tags: ["forms", "input", "code", "keyboard", "interactive"], demo: CodeEditorDemo })
