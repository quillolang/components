view FieldsetDemo() =
    <form.demo-stack method="post" action="#fieldset">
        <Fieldset id="fieldset-demo-name" legend="Your name" description="As it should appear on the invoice." layout="grid" required={true}>
            <TextField name="first" label="First name" autocomplete="given-name"/>
            <TextField name="last" label="Last name" autocomplete="family-name"/>
        </Fieldset>
        <Fieldset id="fieldset-demo-notify" legend="Notify me by" layout="inline">
            <Checkbox name="by_email" label="Email" checked={true}/>
            <Checkbox name="by_sms" label="Text message"/>
            <Checkbox name="by_push" label="Push"/>
        </Fieldset>
        <Fieldset id="fieldset-demo-card" legend="Card on file" description="Locked while the plan is paid by invoice." bordered={true} disabled={true}>
            <TextField name="card" label="Card number" value="•••• •••• •••• 4242"/>
            <TextField name="expiry" label="Expires" value="08 / 28" size="sm"/>
        </Fieldset>
    </form>

ui_gallery = ui_gallery | push({ slug: "fieldset", name: "Fieldset", group: "Layout",
    summary: "A <fieldset> with a legend and a line about it, its fields stacked, in a row or in a grid; disabled as one.",
    tags: ["layout", "forms", "input", "accessibility", "no-js"], demo: FieldsetDemo })
