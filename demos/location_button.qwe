component LocationButtonDemoLive() {
    state got = null
    state seen = "idle"
    <div.demo-stack>
        <LocationButton name="place" timeout={3} on_locate={(p) => { got = p }} on_state={(s) => { seen = s }}/>
        <p.demo-note id="location-button-demo-seen">State: {seen}. {got == null ? "No place yet." : `on_locate gave ${got.lat}, ${got.lon} from the ${got.from}.`}</p>
    </div>
}

view LocationButtonDemo() = <LocationButtonDemoLive/>

ui_gallery = ui_gallery | push({ slug: "location_button", name: "LocationButton", group: "Mobile",
    summary: "Asks for a place from the phone or the web, shows how close it is, and handles asking, refused, off and timed out, with a way to Settings.",
    tags: ["mobile", "interactive", "location", "gps", "permission"],
    needs: ["button"],
    demo: LocationButtonDemo })
