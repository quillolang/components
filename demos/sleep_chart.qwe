// The night the clocks go back in Los Angeles: 23:10 to 06:40 by the clock is 8 h 30 min in truth,
// and 15 minutes went unrecorded from 01:50 on summer time to 01:05 on winter time.
let sleep_chart_demo_night = [
    { stage: "awake", start: "2026-10-31T23:10:00-07:00", end: "2026-10-31T23:25:00-07:00" },
    { stage: "light", start: "2026-10-31T23:25:00-07:00", end: "2026-11-01T00:10:00-07:00" },
    { stage: "deep", start: "2026-11-01T00:10:00-07:00", end: "2026-11-01T01:15:00-07:00" },
    { stage: "rem", start: "2026-11-01T01:15:00-07:00", end: "2026-11-01T01:40:00-07:00" },
    { stage: "awake", start: "2026-11-01T01:40:00-07:00", end: "2026-11-01T01:50:00-07:00" },
    { stage: "light", start: "2026-11-01T01:05:00-08:00", end: "2026-11-01T03:00:00-08:00" },
    { stage: "deep", start: "2026-11-01T03:00:00-08:00", end: "2026-11-01T03:40:00-08:00" },
    { stage: "rem", start: "2026-11-01T03:40:00-08:00", end: "2026-11-01T04:30:00-08:00" },
    { stage: "Core", start: "2026-11-01T04:30:00-08:00", end: "2026-11-01T06:20:00-08:00" },
    { stage: "awake", start: "2026-11-01T06:20:00-08:00", end: "2026-11-01T06:40:00-08:00" },
]

let sleep_chart_demo_clock = [
    { stage: "light", start: "22:30", end: "23:50" }, { stage: "deep", start: "23:50", end: "00:40" }, { stage: "rem", start: "00:40" },
    { stage: "light", start: "01:15", end: "05:30" }, { stage: "awake", start: "05:30", end: "06:00" },
]

component SleepChartDemoLive() {
    state said = "Nothing chosen."
    state stir = 0
    <div.demo-stack>
        <div id="sleep-chart-main"><SleepChart title="Saturday night, the clocks go back" segments={sleep_chart_demo_night | map((s) => { ...s, stir })}
            on_select={(i) => { said = i == null ? "Cleared." : `${i.clock} ${i.stage} ${i.minutes}` }}/></div>
        <p.demo-note id="sleep-chart-said">{said}</p>
        <div.demo-row><Button id="sleep-chart-stir" size="lg" variant="soft" on_click={() => { stir += 1 }}>New data arrives</Button></div>
    </div>
}

view SleepChartDemo() =
    <div.demo-stack>
        <SleepChartDemoLive/>
        <div id="sleep-chart-clock"><SleepChart title="By clock times" segments={sleep_chart_demo_clock}/></div>
        <div id="sleep-chart-empty"><SleepChart title="Bad data" segments={[null, { stage: "dreaming", start: "22:00", end: "23:00" }, { stage: "deep", start: "soon", end: "late" }]}/></div>
    </div>

ui_gallery = ui_gallery | push({ slug: "sleep_chart", name: "SleepChart", group: "Mobile",
    summary: "Stages through a night as a chart read by finger, with totals, right across midnight and a change of the clocks.",
    tags: ["mobile", "interactive", "health", "chart", "gesture", "tablet"],
    demo: SleepChartDemo })
