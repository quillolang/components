fn snap_carousel_demo_pic(fill: str, word: str) =
    "data:image/svg+xml," + url_encode(`<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 400 400'><rect width='400' height='400' fill='${fill}'/><circle cx='200' cy='190' r='110' fill='#ffffff55'/><text x='200' y='205' font-size='42' text-anchor='middle' fill='#fff' font-family='sans-serif'>${word}</text></svg>`)

let snap_carousel_demo_pics = [
    { src: snap_carousel_demo_pic("#3d5a80", "Front"), alt: "The boots from the front" },
    { src: snap_carousel_demo_pic("#98c1d9", "Side"), alt: "The boots from the side" },
    { src: snap_carousel_demo_pic("#ee6c4d", "Sole"), alt: "The sole" },
    { src: snap_carousel_demo_pic("#293241", "Lace"), alt: "The laces" },
    { src: snap_carousel_demo_pic("#6d8f71", "Heel"), alt: "The heel" },
]

component SnapCarouselDemoLive() {
    state turn = 0
    state on_pic = 0
    <div.demo-stack>
        <SnapCarousel key={turn} id="snap-demo" label="Pictures of the boots" images={snap_carousel_demo_pics} on_change={(i) => { on_pic = i }}/>
        <div.demo-row>
            <p.demo-note id="snap-demo-pic">On picture {on_pic + 1}</p>
            <Button id="snap-demo-back" variant="ghost" size="lg" on_click={() => { turn += 1 }}>Leave and come back</Button>
        </div>
    </div>
}

view SnapCarouselDemo() = <SnapCarouselDemoLive/>

ui_gallery = ui_gallery | push({ slug: "snap_carousel", name: "SnapCarousel", group: "Mobile",
    summary: "Product pictures snapped by CSS with dots and a count, a tap opening a viewer to zoom, keeping its place, working without script.",
    tags: ["mobile", "interactive", "commerce", "carousel", "zoom", "tablet"],
    demo: SnapCarouselDemo })
