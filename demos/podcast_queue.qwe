// Fourteen silent seconds, small enough to sit in the page, standing in for each episode.
let podcast_queue_demo_src = "data:audio/mp4;base64,"

let podcast_queue_demo_eps = [
    { id: "e12", title: "Views first", show: "The Quillo Podcast", src: podcast_queue_demo_src, duration: 14, position: 6, size: 41000000, notes: "Why a component with nothing to remember stays a view." },
    { id: "e11", title: "Signals, not a virtual DOM", show: "The Quillo Podcast", src: podcast_queue_demo_src, duration: 14, size: 38000000, downloaded: true, notes: "How a page updates only what changed." },
    { id: "m3", title: "Salt roads", show: "Slow History", src: podcast_queue_demo_src, duration: 2700, size: 62000000, notes: "Who carried it, and who paid." },
    { id: "m2", title: "The longest canal", show: "Slow History", duration: 3600, position: 1800, size: 70000000 },
    { id: "w9", title: "Weather for sailors", show: "Sea Area", duration: 600, played: true, size: 9000000 },
    { id: "w8", title: "Reading the swell", show: "Sea Area", duration: 900, size: 12000000 },
    { id: "w7", title: "Fog", show: "Sea Area", duration: 1200, size: 15000000 },
    { id: "w6", title: "Tides at the bar", show: "Sea Area", duration: 1500, size: 18000000 },
    { id: "w5", title: "Anchoring", show: "Sea Area", duration: 1800, size: 21000000 },
    { id: "w4", title: "Night watches", show: "Sea Area", duration: 2100, size: 24000000 },
]

component PodcastQueueDemoLive() {
    state order = "none"
    state where = "none"
    state took = "none"
    state fetching = {}
    state rate = 1
    state started = "none"
    state eps = podcast_queue_demo_eps
    <div.demo-stack>
        <div.demo-phone style="--ui-podq-height: 100%">
            <PodcastQueue id="podq-demo" episodes={eps} speed={rate} progress={fetching}
                          on_change={(list) => { order = join(list | map((e) => e.id), " ") }}
                          on_position={(id, s) => { where = `${id} ${round(s)}` }}
                          on_play={(e) => { started = e.id }}
                          on_remove={(e) => { took = e.id }}
                          on_download={(e) => { fetching = set(fetching, e.id, 0.4) }}/>
        </div>
        <p.demo-note id="podq-demo-note">Order {order}; place {where}; removed {took}; started {started}</p>
        <div.demo-row>
            <Button id="podq-demo-speed" size="lg" variant="ghost" on_click={() => { rate = rate == 1 ? 1.5 : 1 }}>Change speed</Button>
            <Button id="podq-demo-finish" size="lg" variant="ghost" on_click={() => { fetching = set(fetching, "e12", 1) }}>Finish the download</Button>
            <Button id="podq-demo-empty" size="lg" variant="ghost" on_click={() => { eps = [] }}>Empty it</Button>
        </div>
    </div>
}

view PodcastQueueDemo() = <PodcastQueueDemoLive/>

ui_gallery = ui_gallery | push({ slug: "podcast_queue", name: "PodcastQueue", group: "Mobile",
    summary: "Episodes reordered by a grip, with played state, resume position, downloads and the time remaining.",
    tags: ["mobile", "interactive", "media", "podcast", "reorder", "tablet"],
    demo: PodcastQueueDemo })
