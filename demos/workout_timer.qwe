component WorkoutTimerDemoLive() {
    state kept = null
    state again = 0
    state said = "Nothing yet."
    state finished = "Not finished."
    state finishes = 0
    <div.demo-stack>
        <div.demo-phone id="workout-timer-frame">
            <WorkoutTimer key={again} title="Hill sprints" warmup={5} work={30} rest={15} rounds={3} saved={kept}
                on_change={(run) => { kept = run }}
                on_phase={(s, i) => { said = `${i}: ${s.kind} ${s.name} ${s.ms}` }}
                on_finish={(s) => {
                    finished = `${s.ms} ${s.rounds} ${s.skipped}`
                    finishes += 1
                }}/>
        </div>
        <p.demo-note id="workout-timer-said">{said}</p>
        <p.demo-note id="workout-timer-finished">{finished}</p>
        <p.demo-note id="workout-timer-finishes">{finishes}</p>
        <div.demo-row><Button id="workout-timer-remake" size="lg" variant="soft" on_click={() => { again += 1 }}>Make it again from what was kept</Button></div>
        <div id="workout-timer-bad"><WorkoutTimer key="bad" title="Bad plan" plan={[null, "x", { seconds: "many" }, { kind: "work", seconds: -3 }]} saved={{ at: "soon" }}/></div>
    </div>
}

view WorkoutTimerDemo() = <WorkoutTimerDemoLive/>

ui_gallery = ui_gallery | push({ slug: "workout_timer", name: "WorkoutTimer", group: "Mobile",
    summary: "Intervals of work and rest with a large countdown, felt as well as seen, the screen kept on, and time that stays right when the screen sleeps.",
    tags: ["mobile", "interactive", "timer", "health", "haptics", "tablet"],
    demo: WorkoutTimerDemo })
