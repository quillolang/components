let send_money_flow_demo_payees = [
    { id: "ana", name: "Ana Reyes", account: "•• 4021" },
    { id: "joe", name: "Joe Park", account: "•• 7730" },
    { id: "mia", name: "Mia Lindqvist", account: "•• 1188" },
    { id: "rent", name: "Harbour Lettings", account: "•• 9050" },
]

component SendMoneyFlowDemoLive() {
    state log = "Nothing sent"
    state refuse = true
    state keys = ""
    <div.demo-stack>
        <div.demo-phone>
            <SendMoneyFlow payees={send_money_flow_demo_payees} balance={2481.07m} fee={1.50m} now_at="2026-11-01T09:42:00Z"
                           limits={{ minimum: 1m, per_transfer: 1000m, daily_left: 750m, monthly_left: 4000m }}
                           on_send={(p) => {
                               keys = keys + (keys == "" ? "" : ",") + slice(p.key, 0, 8)
                               if refuse {
                                   refuse = false
                                   return { ok: false, message: "Your bank declined this." }
                               }
                               log = `Sent ${str(p.amount)}+${str(p.fee)}=${str(p.total)} ${p.currency} to ${p.payee.name} (${p.payee.account}): ${p.note}`
                               js("Promise.resolve", { ref: "TX-20261101-0042", at: "2026-11-01T09:43:00Z" })
                           }}
                           on_done={() => { log = "Done" }}/>
        </div>
        <p.demo-note id="sendflow-log">{log}</p>
        <p.demo-note id="sendflow-keys">{keys}</p>
    </div>
}

view SendMoneyFlowDemo() = <div.demo-stack><SendMoneyFlowDemoLive/></div>

ui_gallery = ui_gallery | push({ slug: "send_money_flow", name: "SendMoneyFlow", group: "Mobile",
    summary: "Payee, amount, note and a last look, keeping what was typed on back, with every limit stated and a receipt.",
    tags: ["mobile", "interactive", "banking", "transfer", "form", "tablet"],
    needs: ["price", "button"],
    demo: SendMoneyFlowDemo })
