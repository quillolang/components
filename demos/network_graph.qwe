let network_graph_demo_people = [
    { id: "ana", label: "Ana", group: "Design" }, { id: "rui", label: "Rui", group: "Design" },
    { id: "eva", label: "Eva", group: "Design" }, { id: "joe", label: "Joe", group: "Engineering" },
    { id: "kim", label: "Kim", group: "Engineering" }, { id: "lea", label: "Lea", group: "Engineering" },
    { id: "max", label: "Max", group: "Engineering" }, { id: "noa", label: "Noa", group: "Engineering" },
    { id: "ola", label: "Ola", group: "Sales" }, { id: "pia", label: "Pia", group: "Sales" },
    { id: "quinn", label: "Quinn", group: "Sales" }, { id: "sam", label: "Sam", group: "Support" },
    { id: "tia", label: "Tia", group: "Support" }, { id: "uma", label: "Uma", group: "Support" },
]
let network_graph_demo_links = [
    { from: "ana", to: "rui", value: 3 }, { from: "ana", to: "eva", value: 2 }, { from: "rui", to: "eva" },
    { from: "ana", to: "joe", value: 2 }, { from: "rui", to: "kim" }, { from: "joe", to: "kim", value: 3 },
    { from: "joe", to: "lea", value: 2 }, { from: "kim", to: "max" }, { from: "lea", to: "max", value: 3 },
    { from: "max", to: "noa", value: 2 }, { from: "noa", to: "lea" }, { from: "kim", to: "noa" },
    { from: "ola", to: "pia", value: 3 }, { from: "pia", to: "quinn", value: 2 }, { from: "ola", to: "quinn" },
    { from: "ola", to: "ana" }, { from: "quinn", to: "sam" }, { from: "sam", to: "tia", value: 3 },
    { from: "tia", to: "uma", value: 2 }, { from: "uma", to: "sam" }, { from: "uma", to: "noa", value: 2 },
]

view NetworkGraphDemo() =
    <div.demo-stack>
        <NetworkGraph label="Who works with whom" show_label={true} nodes={network_graph_demo_people} links={network_graph_demo_links}/>
        <div style="max-width: 420px">
            <NetworkGraph label="Service calls" show_label={true} aspect={1.3} labels={false}
                          nodes={[{ id: "web" }, { id: "api" }, { id: "auth" }, { id: "db" }, { id: "cache" }, { id: "mail" }]}
                          links={[{ from: "web", to: "api", value: 5 }, { from: "api", to: "auth", value: 2 }, { from: "api", to: "db", value: 4 },
                                  { from: "api", to: "cache", value: 3 }, { from: "auth", to: "db" }, { from: "api", to: "mail" }]}/>
        </div>
        <p.demo-note>The second hides its labels until a node is hovered.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "network_graph", name: "NetworkGraph", group: "Charts",
    summary: "Nodes and links laid out by a force simulation run on the server, coloured by group and sized by their links.",
    tags: ["chart", "data", "no-js"],
    demo: NetworkGraphDemo })
