let large_title_bar_demo_rows = ["Airplane mode", "Wi-Fi", "Bluetooth", "Mobile data", "Personal hotspot", "Notifications", "Sounds and haptics",
                                 "Focus", "Screen time", "General", "Control centre", "Display", "Wallpaper", "Battery", "Privacy", "Passwords", "Language", "Storage"]

component LargeTitleBarDemoLive() {
    state backs = 0
    state edits = 0
    <div.demo-stack>
        <div.demo-tablet>
            <LargeTitleBar title="Settings" back_text="Home" back_label="Back to Home" on_back={() => { backs += 1 }}
                           actions={<button type="button" @click={() => { edits += 1 }}>Edit</button>}>
                {for r in range(0, 3) => <div key={r}>
                    {for n in large_title_bar_demo_rows => <p key={n} style="margin: 0; padding: 14px 16px; border-bottom: 1px solid var(--ui-border)">{n}</p>}
                </div>}
            </LargeTitleBar>
        </div>
        <p class="demo-note">Back pressed {backs}, Edit pressed {edits}</p>
    </div>
}

view LargeTitleBarDemo() = <LargeTitleBarDemoLive/>

ui_gallery = ui_gallery | push({ slug: "large_title_bar", name: "LargeTitleBar", group: "Mobile",
    summary: "An iOS large title that shrinks into the bar as content scrolls, with back and action slots, tied to the scroller without jank.",
    tags: ["mobile", "interactive", "tablet", "navigation", "header", "scroll"],
    demo: LargeTitleBarDemo })
