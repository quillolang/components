let chart_advisor_demo_rows = [
    { month: "2026-01-01", revenue: 120 }, { month: "2026-02-01", revenue: 140 }, { month: "2026-03-01", revenue: 135 },
    { month: "2026-04-01", revenue: 180 }, { month: "2026-05-01", revenue: 210 }, { month: "2026-06-01", revenue: 205 },
]

component ChartAdvisorDemoLive() {
    state seen = "Switch the chart to see on_change."
    <div.demo-stack>
        <ChartAdvisor id="chart-advisor-demo-live" title="Sales by shop" name="shops"
                      rows={[{ shop: "Lisbon", sales: 340, staff: 6 }, { shop: "Porto", sales: 280, staff: 5 }, { shop: "Faro", sales: 120, staff: 2 }, { shop: "Braga", sales: 150, staff: 3 }]}
                      on_change={(c) => { seen = c == null ? "on_change: nothing to chart." : `on_change: ${c.kind} of ${c.y ?? "rows"} by ${c.x}, advised ${c.advised}.` }}/>
        <p.demo-note>{seen}</p>
    </div>
}

view ChartAdvisorDemo() =
    <div.demo-stack>
        <ChartAdvisor id="chart-advisor-demo" title="Revenue this year" rows={chart_advisor_demo_rows}/>
        <ChartAdvisorDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "chart_advisor", name: "ChartAdvisor", group: "Charts",
    summary: "Looks at rows, picks a chart by the shape of the data, says why, lets the reader switch, and draws it as SVG.",
    tags: ["smart", "interactive", "chart", "visualisation", "svg", "data"], demo: ChartAdvisorDemo })
