let pick_list_demo_picks = [
    { id: "a", code: "4006381333931", name: "Marker pen, black", qty: 1, location: "A-12-3" },
    { id: "b", code: "5901234123457", name: "Notebook, A5", qty: 2, location: "A-03-1" },
    { id: "c", code: "96385074", name: "Packing tape", qty: 1, location: "B-07-2" },
    { id: "d", code: "SKU-204", name: "Label rolls", qty: 4, location: "B-20-1" },
    { id: "e", code: "SKU-301", name: "Work gloves, large", qty: 1, location: "C-01-1" },
    { id: "f", code: "0012345678905", name: "Sticky notes", qty: 1, location: "A-03-2" },
    { id: "g", code: "SKU-999", name: "Pallet wrap, from the dock", qty: 1 },
]

component PickListDemoLive() {
    state said = "Nothing sent yet."
    <div.demo-stack>
        <PickList title="Order 7719" picks={pick_list_demo_picks} store="demo"
                  on_finish={(r) => { said = `Sent ${r.units} of ${r.wanted}, ${r.shorts} short` }}/>
        <p.demo-note id="picklist-demo-said">{said}</p>
    </div>
}

view PickListDemo() = <PickListDemoLive/>

ui_gallery = ui_gallery | push({ slug: "pick_list", name: "PickList", group: "Mobile",
    summary: "Lines in walking order, confirmed by a scan or a tap, shorts recorded with a reason, progress, and big targets for gloves.",
    tags: ["mobile", "interactive", "barcode", "warehouse", "gloves", "tablet"],
    needs: ["scan_count"],
    demo: PickListDemo })
