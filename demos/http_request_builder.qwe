component HttpRequestBuilderDemoLive() {
    state seen = null
    <div.demo-stack>
        <HttpRequestBuilder id="http-request-builder-demo-live" title="With on_change" name="probe" url="https://api.example.com/health" tool="httpie"
                            on_change={(r) => { seen = r }}/>
        <p.demo-note>{seen == null ? "Change the request to see on_change." : `on_change: ok ${seen.ok}, ${seen.warnings} warnings: ${seen.httpie}`}</p>
    </div>
}

view HttpRequestBuilderDemo() =
    <div.demo-stack>
        <HttpRequestBuilder id="http-request-builder-demo" method="POST" url="https://api.example.com/v1/orders"
                            headers={[{ name: "Content-Type", value: "application/json" }, { name: "Authorization", value: "Bearer sk_live_abc123" }]}
                            query={[{ name: "expand", value: "items,customer" }, { name: "note", value: "it's a test" }]}
                            body={`{"sku": "A-7", "note": "it's $5 & more"}`}/>
        <HttpRequestBuilderDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "http_request_builder", name: "HttpRequestBuilder", group: "Utilities",
    summary: "Builds an HTTP request as curl, fetch and HTTPie with correct shell escaping, warns on a body on GET and a missing content type, and hides secrets until asked.",
    tags: ["smart", "interactive", "http", "developer", "curl", "api"], demo: HttpRequestBuilderDemo })
