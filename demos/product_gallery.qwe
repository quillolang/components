let product_gallery_demo_shots = [
    { src: "https://picsum.photos/seed/shoe1/600/600", alt: "From the side" },
    { src: "https://picsum.photos/seed/shoe2/600/600", alt: "From above" },
    { src: "https://picsum.photos/seed/shoe3/600/600", alt: "The sole" },
    { src: "https://picsum.photos/seed/shoe4/600/600", alt: "Worn on a trail" },
    { src: "https://picsum.photos/seed/shoe5/600/600", alt: "In the box" },
]

component ProductGalleryDemoLive() {
    state at = 0
    <div.demo-stack>
        <div style="width: 320px">
            <ProductGallery label="Trail runner" images={product_gallery_demo_shots} on_change={(i) => { at = i }}/>
        </div>
        <p.demo-note>Showing picture {at + 1}: {product_gallery_demo_shots[at].alt}. Click a thumbnail, press the arrow keys, or swipe the picture.</p>
    </div>
}

view ProductGalleryDemo() =
    <div.demo-row style="align-items: flex-start; gap: 40px">
        <ProductGalleryDemoLive/>
        <div style="width: 360px">
            <ProductGallery label="Day pack" thumbs="left" ratio="4/3" selected={1} arrows={false} images={[
                { src: "https://picsum.photos/seed/pack1/800/600", alt: "The pack, front" },
                { src: "https://picsum.photos/seed/pack2/800/600", alt: "The pack, open" },
                { src: "https://picsum.photos/seed/pack3/800/600", alt: "The pack, worn" },
            ]}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "product_gallery", name: "ProductGallery", group: "Commerce",
    summary: "A product's pictures: one large, the rest as thumbnails that switch it, with the arrow keys, swipes and a counter.",
    tags: ["commerce", "image", "media", "tabs", "interactive"], demo: ProductGalleryDemo })
