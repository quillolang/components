component JsonFormatterDemoLive() {
    state seen = null
    <div.demo-stack>
        <JsonFormatter id="json-formatter-demo-live" title="With on_change" name="config" value={`{'name': 'it\\'s', "tags": ["a", "b",],}`}
                       on_change={(r) => { seen = r }}/>
        <p.demo-note>{seen == null ? "Change the text to see on_change." : (seen.valid ? `on_change: valid, ${len(seen.output)} characters.` : `on_change: not valid, at line ${seen.error == null ? "?" : seen.error.line}.`)}</p>
    </div>
}

view JsonFormatterDemo() =
    <div.demo-stack>
        <JsonFormatter id="json-formatter-demo" value={`{"price": 1.10, "id": 12345678901234567890, "big": 1e400, "name": "caf\\u00e9", "items": [], "meta": {"z": -0, "a": true}}`}/>
        <JsonFormatterDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "json_formatter", name: "JsonFormatter", group: "Utilities",
    summary: "Formats, minifies and sorts JSON, keeps numbers exactly, names the line and column of an error, and repairs trailing commas and single quotes.",
    tags: ["smart", "interactive", "json", "developer", "formatter", "validate"], demo: JsonFormatterDemo })
