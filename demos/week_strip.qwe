let week_strip_demo_marks = [
    { date: "2026-11-02", title: "Standup", tone: "info" },
    { date: "2026-11-04", title: "Dentist", tone: "danger" }, { date: "2026-11-04", title: "Lunch with Ana", tone: "success" },
    { date: "2026-11-06", title: "Rent", tone: "warning" }, { date: "2026-11-06", title: "Call the bank" }, { date: "2026-11-06", title: "Pick up keys" }, { date: "2026-11-06", title: "Pay the school", tone: "danger" }, { date: "2026-11-06", title: "Book review" },
    { date: "2026-11-12", title: "Flight to Lisbon", tone: "info" },
]

component WeekStripDemoLive() {
    state log = ""
    state weeks = ""
    <div.demo-stack>
        <WeekStrip today="2026-11-04" marks={week_strip_demo_marks} label="This week"
                   on_pick={(d) => { log = d }} on_week={(w) => { weeks = w }}/>
        <p.demo-note id="week-strip-log">{log}</p>
        <p.demo-note id="week-strip-week">{weeks}</p>
        // Sunday first, and bad data, for the test to look at: neither should stop the page.
        <div id="week-strip-sunday"><WeekStrip today="2026-12-30" week_start={7} marks={[null, 5, { date: "not a day" }, { date: "2026-02-30" }, { date: "2026-12-30", tone: "loud" }]}/></div>
        <div id="week-strip-bad" hidden="true"><WeekStrip today="nonsense" week_start={99} marks="none"/></div>
    </div>
}

view WeekStripDemo() = <div.demo-stack><WeekStripDemoLive/></div>

ui_gallery = ui_gallery | push({ slug: "week_strip", name: "WeekStrip", group: "Mobile",
    summary: "Days in a swiped strip with dots for what is on them, today, and a jump to any day.",
    tags: ["mobile", "interactive", "gesture", "calendar", "swipe", "tablet"],
    demo: WeekStripDemo })
