view ScrollAreaDemo() =
    <div.demo-stack>
        <ScrollArea id="scroll-area-demo-notes" height="220px" label="Release notes" pad={4}>
            {for v in range(1, 19) => <p style="margin: 0 0 10px"><b>0.{19 - v}</b> — fixes and small improvements, release {v} of the list; the box fades at the edge where there is more.</p>}
        </ScrollArea>
        <ScrollArea id="scroll-area-demo-steps" axis="x" height={null} label="Steps">
            <div style="display: flex; gap: 12px; width: max-content; padding: 4px 0">
                {for i in range(1, 13) => <div style="width: 160px; padding: 14px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius-sm); background: var(--ui-subtle); font-size: 13px">Step {i}</div>}
            </div>
        </ScrollArea>
        <p.demo-note>Each box takes focus, so the arrow keys scroll it; screen readers hear its name.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "scroll_area", name: "ScrollArea", group: "Layout",
    summary: "A box with its own scrollbars and a height limit, fading at the edges where there is more to see.",
    tags: ["layout", "utility", "accessibility", "no-js"], demo: ScrollAreaDemo })
