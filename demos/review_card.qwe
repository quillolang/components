component ReviewCardDemoLive() {
    state votes = 12
    state voted = false
    <div.demo-stack>
        <ReviewCard id="rc-live" rating={4.5} title="Great for a small team" name="Marta R." date="2026-09-14" verified={true}
                    text="Set up in an afternoon. The only thing missing is a dark mode for the invoices." helpful={votes} voted={voted}
                    on_helpful={() => { votes = voted ? votes - 1 : votes + 1; voted = !voted }}/>
        <p.demo-note>{voted ? "You found this helpful." : "Not voted."}</p>
    </div>
}

view ReviewCardDemo() =
    <div.demo-stack>
        <form method="post" action="/reviews/helpful" id="review-card-demo-form">
            <ReviewCard id="rc-1" rating={5} title="Exactly as described" name="Ola N." date="2026-10-02" verified={true} helpful={3}
                        text="Arrived in two days, well packed.\nWould buy again."
                        images={["https://picsum.photos/seed/box1/128", "https://picsum.photos/seed/box2/128"]}/>
            <ReviewCard id="rc-2" rating={2} title="Smaller than it looks" name="Jun K." date="2026-08-21" helpful={0}
                        text="The photos make it look twice the size."
                        response={{ name: "The shop", date: "2026-08-22", text: "Sorry about that: the dimensions are now on the page. We have sent a return label." }}/>
            <ReviewCard id="rc-3" rating={3.5} name="Anonymous" date="2026-07-30" text="Fine."/>
        </form>
        <ReviewCardDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "review_card", name: "ReviewCard", group: "Data",
    summary: "One review: stars (halves too), title, text, reviewer and date, a Verified mark, images, the seller's reply and a Helpful vote.",
    tags: ["card", "social", "comment", "commerce", "no-js"],
    needs: ["avatar"],
    demo: ReviewCardDemo })
