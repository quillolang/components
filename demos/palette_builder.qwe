component PaletteBuilderDemoLive() {
    state said = "Change the base to see on_change."
    <div.demo-stack>
        <PaletteBuilder id="palette-builder-demo-live" title="Forest theme" base="hsl(160, 60%, 35%)" prefix="forest" format="json"
                        on_change={(p) => { said = p == null ? "on_change: not a colour." : `on_change: the 500 step is ${p.scale[5].hex}.` }}/>
        <p.demo-note>{said}</p>
    </div>
}

view PaletteBuilderDemo() =
    <div.demo-stack>
        <PaletteBuilder id="palette-builder-demo" base="#5b4bdb" prefix="brand"/>
        <PaletteBuilderDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "palette_builder", name: "PaletteBuilder", group: "Forms",
    summary: "Builds a 50 to 950 scale and a semantic set from one colour, shows which pairs pass contrast, and exports CSS variables or JSON.",
    tags: ["smart", "interactive", "colour", "theme", "accessibility", "design"], needs: ["color_contrast"], demo: PaletteBuilderDemo })
