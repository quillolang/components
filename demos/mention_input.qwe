let mention_input_demo_people = [
    { handle: "ana", name: "Ana Lopes" }, { handle: "andrei", name: "Andrei Popescu" }, { handle: "ben", name: "Ben Oduya" },
    { handle: "chloe", name: "Chloé Martin" }, { handle: "dev.team", name: "Developers" },
]

component MentionInputDemoLive() {
    state who = []
    <div.demo-stack>
        <MentionInput name="mn-demo-comment" label="Comment" people={mention_input_demo_people} placeholder="Type @ to mention someone"
                      on_change={(t, m) => { who = m }}/>
        <p.demo-note>{len(who) == 0 ? "Nobody mentioned." : `Will notify ${join(who, ", ")}.`}</p>
    </div>
}

view MentionInputDemo() {
    <div.demo-stack.demo-narrow>
        <MentionInputDemoLive/>
        <MentionInput name="mn-demo-reply" label="Reply" value="Thanks @ben, looks good." rows={2} people={mention_input_demo_people}
                      error="Say a little more."/>
    </div>
}

ui_gallery = ui_gallery | push({ slug: "mention_input", name: "MentionInput", group: "Forms",
    summary: "A textarea that offers people when @ is typed, puts @handle in, and sends the handles mentioned beside the text.",
    tags: ["forms", "input", "comment", "social", "interactive"], demo: MentionInputDemo })
