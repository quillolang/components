let dependent_select_demo_regions = [
    { label: "Canada", value: "CA", options: [{ label: "British Columbia", value: "BC" }, { label: "Ontario", value: "ON" }, { label: "Quebec", value: "QC" }] },
    { label: "Spain", value: "ES", options: ["Andalusia", "Catalonia", "Madrid"] },
    { label: "Japan", value: "JP", options: ["Hokkaido", "Kyoto", "Tokyo"] },
]

component DependentSelectDemoLive() {
    state picked = ["bikes", "gravel"]
    <div.demo-stack>
        <DependentSelect name="category" child_name="product" label="Category" child_label="Product" value="bikes" child_value="gravel"
                         field="dependent-select-demo-live" size="sm"
                         options={[{ label: "Bikes", value: "bikes", options: [{ label: "Road", value: "road" }, { label: "Gravel", value: "gravel" }] },
                                   { label: "Helmets", value: "helmets", options: ["Commuter", "Race"] }]}
                         on_change={(a, b) => { picked = [a, b] }}/>
        <p.demo-note>Category {picked[0] ?? "none"}, product {picked[1] ?? "none"}.</p>
    </div>
}

view DependentSelectDemo() =
    <div.demo-stack>
        <DependentSelect name="country" child_name="region" label="Country" child_label="Region" legend="Where you live"
                         field="dependent-select-demo-plain" options={dependent_select_demo_regions} required={true}
                         hint="Changing the country empties the region."/>
        <DependentSelectDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "dependent_select", name: "DependentSelect", group: "Forms",
    summary: "Two drop-downs where the second's options depend on the first, both real selects a form sends.",
    tags: ["forms", "select", "input", "interactive"], demo: DependentSelectDemo })
