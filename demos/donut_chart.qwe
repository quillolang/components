view DonutChartDemo() =
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 32px 40px">
        <DonutChart label="Traffic by source" parts={[
            { label: "Search", value: 4210 }, { label: "Direct", value: 2380 }, { label: "Social", value: 1120 },
            { label: "Email", value: 640 }, { label: "Referral", value: 310 }]}/>
        <DonutChart label="Budget this month" show_label={true} prefix="$" decimals={2} total_label="Spent" size={150} thickness={12} parts={[
            { label: "Payroll", value: 48200 }, { label: "Hosting", value: 6350.5 }, { label: "Marketing", value: 9100 },
            { label: "Tools", value: 2275 }]}/>
        <DonutChart label="Plan mix" show_label={true} pie={true} size={140} parts={[
            { label: "Free", value: 6120 }, { label: "Pro", value: 1840 }, { label: "Team", value: 410 }]}/>
        <DonutChart label="Storage" suffix=" GB" center="82%" size={150} parts={[
            { label: "Photos", value: 41.2 }, { label: "Videos", value: 28.7 }, { label: "Documents", value: 6.4 },
            { label: "Mail", value: 3.1 }, { label: "Backups", value: 1.8 }, { label: "Apps", value: 0.9 },
            { label: "Music", value: 0.6 }, { label: "Notes", value: 0.2 }, { label: "Other files", value: 0.4 }]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "donut_chart", name: "DonutChart", group: "Data",
    summary: "The parts of a whole as a ring or a pie, the total in the middle, and a legend with values and shares; hovering picks a part out.",
    demo: DonutChartDemo })
