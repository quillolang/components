let swipe_reply_demo_rows = [
    { id: "m1", from: "Ana Silva", text: "Are we still on for the site visit at nine?" },
    { id: "m2", from: "You", mine: true, text: "Yes, I will bring the drawings and the second key." },
    { id: "m3", from: "Ana Silva", text: "Good. The gate code changed on Friday, ask me when you get there." }
]

component SwipeReplyDemoLive() {
    state quote = null
    state note = "Drag a message sideways, or use its menu."
    state tint = "plain"
    <div.demo-stack id="swipe-reply-demo">
        {for m in swipe_reply_demo_rows =>
            <SwipeReply key={m.id} message_id={m.id} from={m.from} text={m.text} mine={m.mine ?? false}
                        class={`demo-${tint}`} actions={[{ id: "copy", label: "Copy text" }, { id: "forward", label: "Forward" }]}
                        on_reply={(q) => { quote = q }} on_action={(id, q) => { quote = null; note = `${id}: ${q.text}` }}>
                <MessageBubble mine={m.mine ?? false} name={m.mine ? null : m.from}>{m.text}</MessageBubble>
            </SwipeReply>}
        <Button size="lg" variant="outline" id="swipe-reply-tint" on_click={() => { tint = tint == "plain" ? "other" : "plain" }}>Change a prop of each message</Button>
        <p.demo-note id="swipe-reply-note" role="status">
            {quote != null ? `Replying to ${quote.from} (${quote.id}): ${quote.text}` : note}
        </p>
    </div>
}

view SwipeReplyDemo() = <SwipeReplyDemoLive/>

ui_gallery = ui_gallery | push({ slug: "swipe_reply", name: "SwipeReply", group: "Mobile",
    summary: "Drag a message sideways to quote it in the reply, with a tap felt at the threshold, and a menu that does the same.",
    tags: ["mobile", "interactive", "chat", "swipe", "reply", "gesture"], demo: SwipeReplyDemo })
