let swipe_row_demo_mail = [
    { id: 1, from: "Northwind Bank", subject: "Your statement is ready" }, { id: 2, from: "Maya Chen", subject: "Lunch on Thursday?" },
    { id: 3, from: "Parcel Tracking", subject: "Out for delivery" }, { id: 4, from: "City Library", subject: "Two books due soon" },
    { id: 5, from: "Tom Reyes", subject: "Photos from the hike" },
]

let swipe_row_demo_css = css`
.demo-swipe-from { display: block; font-weight: 600; }
.demo-swipe-sub { display: block; color: var(--ui-muted); font-size: 14px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
`

component SwipeRowDemoLive() {
    style global swipe_row_demo_css
    state rows = swipe_row_demo_mail
    state said = "Nothing done yet."
    let act = (m, id: str) => {
        said = `${id}: ${m.from}`
        if id == "delete" { rows = rows | filter((r) => r.id != m.id) }
    }
    <div.demo-stack>
        <div role="list" aria-label="Inbox" style="border-top: 1px solid var(--ui-border)">
            {for m in rows => <SwipeRow key={m.id} label={m.from} group="demo-inbox"
                    leading={[{ id: "read", label: "Read", tone: "accent" }]}
                    trailing={[{ id: "archive", label: "Archive", tone: "success", full: true }, { id: "delete", label: "Delete", tone: "danger" }]}
                    on_action={(id) => { act(m, id) }}>
                <span.demo-swipe-from>{m.from}</span>
                <span.demo-swipe-sub>{m.subject}</span>
            </SwipeRow>}
        </div>
        <p.demo-note id="swipe-row-said" role="status">{said}</p>
        // Bad data, for the test to look at: nothing here should stop the page.
        <div id="swipe-row-bad" hidden="true"><SwipeRow leading={[null, "x", { id: "no-label" }]} trailing="none" action_width={2}>Nothing to do</SwipeRow></div>
    </div>
}

view SwipeRowDemo() = <SwipeRowDemoLive/>

ui_gallery = ui_gallery | push({ slug: "swipe_row", name: "SwipeRow", group: "Mobile",
    summary: "A list row with actions behind it each way, a full swipe to run one, and a More button and keys to the same actions.",
    tags: ["mobile", "interactive", "gesture", "swipe", "list", "tablet"],
    demo: SwipeRowDemo })
