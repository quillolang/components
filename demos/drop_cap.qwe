let drop_cap_demo_text = "Once upon a time, in a server far away, a page rendered at once and its components woke only when someone reached for them. Nobody waited for a script to arrive, nobody saw a blank page, and the form kept what had been typed in it. The people who wrote it went home early, which is the point of this story."

view DropCapDemo() =
    <div.demo-stack.demo-narrow>
        <DropCap id="drop-cap-demo-three" text={drop_cap_demo_text}/>
        <DropCap id="drop-cap-demo-two" lines={2} tone="accent" serif={true}>{drop_cap_demo_text}</DropCap>
        <DropCap id="drop-cap-demo-four" lines={4} text={drop_cap_demo_text}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "drop_cap", name: "DropCap", group: "Typography",
    summary: "A paragraph whose first letter is set large and dropped into the first two, three or four lines.",
    tags: ["typography", "text", "document", "no-js"],
    demo: DropCapDemo })
