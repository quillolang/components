let dirty_form_guard_demo_fields = [
    { name: "name", label: "Name", value: "Ana Silva" },
    { name: "plan", label: "Plan", type: "select", value: "team", options: [{ label: "Free", value: "free" }, { label: "Team", value: "team" }] },
    { name: "limit", label: "Monthly limit", type: "number", value: "10.00" },
    { name: "note", label: "Note", type: "textarea", value: "" },
    { name: "news", label: "Send me news", type: "checkbox", value: true },
    { name: "days", label: "Work days", type: "multi", value: ["mon", "tue"], options: [{ label: "Monday", value: "mon" }, { label: "Tuesday", value: "tue" }, { label: "Friday", value: "fri" }] },
    { name: "pin", label: "PIN", type: "password", value: "1234" },
]

component DirtyFormGuardDemoLive() {
    state said = "Change something to see on_change."
    state saved = "Save to see on_submit."
    <div.demo-stack>
        <DirtyFormGuard id="dirty-form-guard-demo" fields={dirty_form_guard_demo_fields}
                        on_change={(c) => { said = `on_change: ${json.stringify(c | map((x) => x.name))}` }}
                        on_submit={(v) => { saved = `on_submit: ${v.name}` }}/>
        <a href="/?only=button" data-away="true">A link to another page</a>
        <p.demo-note data-said="true">{said}</p>
        <p.demo-note data-saved="true">{saved}</p>
    </div>
}

view DirtyFormGuardDemo() = <DirtyFormGuardDemoLive/>

ui_gallery = ui_gallery | push({ slug: "dirty_form_guard", name: "DirtyFormGuard", group: "Forms",
    summary: "Compares a form with its first values: lists what changed, reverts per field or all, warns before leaving, and tells a change put back from a real one.",
    tags: ["smart", "interactive", "form", "unsaved", "changes", "guard"], demo: DirtyFormGuardDemo })
