let three_column_view_demo_css = css`
.demo-three-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
.demo-three-frame { width: 100%; height: 100%; margin: 0 auto; }
`

let three_column_view_demo_folders = [
    { id: "inbox", label: "Inbox", count: 4 },
    { id: "work", label: "Work", count: 2 },
    { id: "2026", label: "Receipts 2026" },
    { id: "void", label: "Quiet" },
]

let three_column_view_demo_items = [
    { id: 1, folder: "inbox", title: "Keys for the north gate", from: "Priya Nair", time: "09:12", unread: true, preview: "They are with the caretaker", body: "They are with the caretaker until Friday. Ring the side door." },
    { id: 2, folder: "inbox", title: "Survey dates", from: "Tom Okafor", time: "08:40", preview: "Does the 14th still work?", body: "Does the 14th still work? The crew can start at seven." },
    { id: 3, folder: "inbox", title: "Invoice 2291", from: "Hollis Ltd", time: "Mon", preview: "Attached, due in thirty days", body: "Attached, due in thirty days. Thanks for your business." },
    { id: 4, folder: "inbox", title: "No sender on this one", time: "Sun" },
    { id: 5, folder: "work", title: "Crew rota", from: "Dana Wu", time: "Fri", preview: "Week 46 is ready", body: "Week 46 is ready. Two swaps are marked in yellow." },
    { id: 6, folder: "work", title: "Fuel card", from: "Finance", time: "Thu", preview: "New limit from Monday", body: "The new limit starts on Monday." },
    { id: 7, folder: "2026", title: "Hire of the van", from: "Northpeak", time: "2 Jan", preview: "Paid", body: "Paid in full." },
]

component ThreeColumnViewDemoLive() {
    style global three_column_view_demo_css
    state items = three_column_view_demo_items
    state said = "Nothing opened yet"
    <div.demo-stack>
        <div.demo-tablet>
            <ThreeColumnView folders={three_column_view_demo_folders} items={items} open={2}
                             on_open={(m) => { said = `Opened ${m.title}` }} on_folder={(f) => { said = `In ${f.label}` }}/>
        </div>
        <div.demo-three-bar>
            <Button id="three-demo-remove" size="lg" variant="outline" on_click={() => { items = items | filter((m) => m.id != 2) }}>Delete Survey dates</Button>
            <Button id="three-demo-add" size="lg" variant="outline" on_click={() => {
                items = items + [{ id: 100 + len(items), folder: "inbox", title: "A new one", from: "Sam", time: "now", preview: "Just in" }]
            }}>A new message comes in</Button>
            <span.demo-note id="three-demo-said">{said}</span>
        </div>
    </div>
}

view ThreeColumnViewDemo() = <ThreeColumnViewDemoLive/>

ui_gallery = ui_gallery | push({ slug: "three_column_view", name: "ThreeColumnView", group: "Mobile",
    summary: "Mail's sidebar, list and detail: columns hide in order as width shrinks, a Back appears when they do, and the open item survives every change.",
    tags: ["mobile", "tablet", "interactive", "layout", "mail", "columns"],
    demo: ThreeColumnViewDemo })
