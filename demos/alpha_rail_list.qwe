let alpha_rail_list_demo_names = ["Abba", "AC/DC", "Adele", "Aretha Franklin", "Arcade Fire", "Bach", "Beck", "Björk", "Blur", "Bob Dylan", "Bowie", "Cat Power", "Chic", "Coldplay", "Cream", "Daft Punk", "David Byrne", "Debussy", "Depeche Mode", "Dolly Parton",
    "Eagles", "Elbow", "Ella Fitzgerald", "Eno", "Erykah Badu", "Fela Kuti", "Fleetwood Mac", "Fugazi", "Gang of Four", "Genesis", "Gorillaz", "Grimes", "Hendrix", "Herbie Hancock", "Hole", "Hot Chip", "Iggy Pop", "Imogen Heap", "Interpol", "Iron Maiden",
    "Jay-Z", "Joni Mitchell", "Joy Division", "Kate Bush", "Kendrick Lamar", "Kraftwerk", "Kings of Leon", "LCD Soundsystem", "Led Zeppelin", "Leonard Cohen", "Lorde", "Madonna", "Massive Attack", "Miles Davis", "Muse", "Nas", "Neil Young", "New Order", "Nina Simone", "Nirvana",
    "Oasis", "OutKast", "Patti Smith", "Pink Floyd", "Pixies", "Portishead", "Prince", "Radiohead", "R.E.M.", "Rihanna", "Roxy Music", "Sade", "Sigur Rós", "Solange", "Sonic Youth", "Stevie Wonder", "Talking Heads", "Television", "The Cure", "Tom Waits",
    "U2", "Ultravox", "Underworld", "Vampire Weekend", "Velvet Underground", "Vivaldi", "Weezer", "Wilco", "Wu-Tang Clan", "Yeah Yeah Yeahs", "Yes", "Yo La Tengo", "Zappa", "ZZ Top", "1975", "2Pac", "808 State", "Ænima Tribute"]

component AlphaRailListDemoLive() {
    state picked = "none"
    state went = "none"
    <div.demo-stack>
        <div.demo-phone style="height: 600px" data-frame>
            <AlphaRailList id="alrail-demo" items={alpha_rail_list_demo_names} height="100%" label="Artists"
                           on_select={(a) => { picked = a }} on_letter={(l) => { went = l }}/>
        </div>
        <p.demo-note>Picked <b data-picked>{picked}</b>; went to <b data-went>{went}</b></p>
        <div.demo-phone style="height: 260px">
            <AlphaRailList id="alrail-short" height="100%" haptics={false} items={[{ id: 1, name: "Ada", sub: "Maths" }, { id: 2, name: "Zed", sub: "Last" }, { id: 3, name: "Zed", sub: "Twin" }, null, { name: "" }, 4]}/>
        </div>
        <AlphaRailList id="alrail-none" height="120px" empty="No artists yet"/>
    </div>
}

view AlphaRailListDemo() = <AlphaRailListDemoLive/>

ui_gallery = ui_gallery | push({ slug: "alpha_rail_list", name: "AlphaRailList", group: "Mobile",
    summary: "A long list with sticky letter headers and an A to Z rail scrubbed by finger, with a bubble showing the letter and a haptic per step.",
    tags: ["mobile", "interactive", "tablet", "list", "gesture", "haptic"],
    demo: AlphaRailListDemo })
