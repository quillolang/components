let transit_board_demo_first = [
    { id: "a", line: "15E", to: "Alges", at: "2026-11-03T14:09:00+00:00", delay: 3, platform: "2", colour: "#c0392b" },
    { id: "b", line: "15E", to: "Praca da Figueira", at: "2026-11-03T14:05:30+00:00", platform: "1", colour: "#c0392b", step_free: true },
    { id: "c", line: "714", to: "Outurela", at: "2026-11-03T14:11:00+00:00", platform: "4", was_platform: "3", colour: "#2980b9" },
    { id: "d", line: "Cascais", to: "Cascais", at: "2026-11-03T14:20:00+00:00", cancelled: true, platform: "6", colour: "#16a085" },
    { id: "e", line: "Cascais", to: "Oeiras", at: "2026-11-03T15:12:00+00:00", platform: "5", colour: "#fc0" },
    { id: "f", line: "714", to: "Lost its time", at: "soon", platform: "4" },
    { id: "g", line: "15E", to: "Long gone", at: "2026-11-03T14:01:00+00:00", platform: "1", colour: "#c0392b" },
]

component TransitBoardDemoLive() {
    state time = "2026-11-03T14:05:00+00:00"
    state data = transit_board_demo_first
    state updated = "2026-11-03T14:04:30+00:00"
    state refreshed = 0
    <div.demo-stack>
        <TransitBoard stop="Cais do Sodre" departures={data} now={time} updated={updated} tick={1} on_refresh={() => {
            refreshed += 1
            updated = time
        }}/>
        <div.demo-row>
            <button.transit-board-demo-later type="button" style="min-height: 44px" @click={() => { time = "2026-11-03T14:10:40+00:00" }}>Jump to 14:10:40</button>
            <button.transit-board-demo-delay type="button" style="min-height: 44px" @click={() => {
                data = data | map((d) => d.id == "c" ? { ...d, expected: "2026-11-03T14:31:00+00:00" } : d)
            }}>Delay the 714</button>
        </div>
        <TransitBoard class="transit-board-demo-clockless" stop="By the phone's own clock" departures={[{ id: "z", line: "28E", to: "Martim Moniz", at: "2030-06-01T09:30:00+01:00", platform: "1" }]}/>
        <p.demo-note>Refreshed <span class="transit-board-demo-refreshed">{refreshed}</span> times.</p>
    </div>
}

view TransitBoardDemo() = <TransitBoardDemoLive/>

ui_gallery = ui_gallery | push({ slug: "transit_board", name: "TransitBoard", group: "Mobile",
    summary: "Departures from a stop as a live list from data: minutes away, delays, platforms, cancelled services, and a warning when the data has gone stale.",
    tags: ["mobile", "interactive", "tablet", "transit", "travel", "live"], demo: TransitBoardDemo })
