component ResumeRefreshDemoLive() {
    state rows = range(60) | map((i) => { id: `r${i}`, title: `Item ${i}` })
    state n = 0
    state calls = 0
    state fail_next = 0
    state add = 3
    // A pretend load, a moment long. Named, as js_new is not waited for in a function written
    // in the markup's prop.
    let reload = () => {
        calls += 1
        let pause = js("Promise.resolve", js_new("Promise", (done) => { js("AbortSignal.timeout", 50).addEventListener("abort", (_e) => { done(true) }) }))
        if fail_next > 0 {
            fail_next -= 1
            return err("not reached")
        }
        let fresh = range(add) | map((i) => { id: `new${n}-${i}`, title: `New item ${n}-${i}` })
        n += 1
        rows = fresh + rows
        { ok: pause, added: add }
    }
    <div.demo-stack>
        <div.demo-row>
            <Button size="lg" variant="outline" id="rsmr-fail" on_click={() => { fail_next = 1 }}>Fail the next load</Button>
            <Button size="lg" variant="outline" id="rsmr-fail2" on_click={() => { fail_next = 2 }}>Fail two</Button>
            <Button size="lg" variant="outline" id="rsmr-one" on_click={() => { add = 1 }}>One new item</Button>
            <Button size="lg" variant="outline" id="rsmr-none" on_click={() => { add = 0 }}>No new items</Button>
        </div>
        <p.demo-note id="rsmr-calls">{`Loads: ${calls}.`}</p>
        <div.demo-phone>
            <div id="rsmr-scroll" style="height: 100%; overflow-y: auto; overflow-anchor: none">
                <ResumeRefresh id="rsmr-demo" after_ms={1200} notice_ms={700} on_refresh={reload}>
                    {for r in rows => <div key={r.id} data-key={r.id} style="display: flex; align-items: center; gap: 8px; box-sizing: border-box; height: 56px; padding: 0 14px; border-bottom: 1px solid var(--ui-border)">
                        <span style="flex: 1">{r.title}</span>
                        <input aria-label={`Note on ${r.title}`} style="width: 110px; min-height: 44px; font-size: 16px"/>
                    </div>}
                </ResumeRefresh>
            </div>
        </div>
    </div>
}

view ResumeRefreshDemo() = <ResumeRefreshDemoLive/>

ui_gallery = ui_gallery | push({ slug: "resume_refresh", name: "ResumeRefresh", group: "Mobile",
    summary: "Refreshes data on coming back after a time, skipped if recent, keeps the place, and shows a small notice.",
    tags: ["mobile", "interactive", "offline", "refresh", "resume", "tablet"],
    demo: ResumeRefreshDemo })
