let payee_list_demo_payees = [
    { id: "p-ana", name: "Ana Okafor", bank: "Harbor Bank", number: "88120345", last_amount: 120m, last_date: "2026-10-03" },
    { id: "p-power", name: "City Power & Light", bank: "Fernway Credit Union", number: "40029917", reference: "CPL-0049-2217",
      last_amount: 88.15m, last_date: "2026-10-28" },
    { id: "p-rent", name: "Linden Court Lettings", bank: "Fernway Credit Union", number: "40031204", last_amount: 1450m, last_date: "2026-10-01" },
    { id: "p-tomas", name: "Tomás Reyes", bank: "Pinecrest Savings", number: "7712 0061 93" },
]

component PayeeListDemoLive() {
    state paying = ""
    <div.demo-stack>
        <PayeeList id="payee-list-demo" payees={payee_list_demo_payees} add_href="#add-payee" on_pay={(id) => { paying = id }}/>
        <p.demo-note>{paying == "" ? "Press Pay on one." : `on_pay: ${paying}`}</p>
    </div>
}

view PayeeListDemo() = <div style="max-width: 520px"><PayeeListDemoLive/></div>

ui_gallery = ui_gallery | push({ slug: "payee_list", name: "PayeeList", group: "Finance",
    summary: "Saved payees with bank, masked account and what was last paid when, a Pay button each, and a search.",
    tags: ["finance", "banking", "list", "search", "interactive"], demo: PayeeListDemo })
