view ContainerDemo() =
    <div.demo-stack>
        {for s in ["sm", "md", "lg"] =>
            <div style="background: var(--ui-subtle); border-radius: var(--ui-radius-sm)">
                <Container size={s}>
                    <div style="padding: 10px 0; border-inline: 1px dashed var(--ui-strong); text-align: center; font-size: 13px; color: var(--ui-muted)">
                        size="{s}"
                    </div>
                </Container>
            </div>}
        <p.demo-note>Each is centred at its width, at most; the dashed lines are the container's padding edge.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "container", name: "Container", group: "Layout",
    summary: "Keeps content at a readable width, centred, with room at the sides on small screens.",
    tags: ["layout", "no-js"],
    demo: ContainerDemo })
