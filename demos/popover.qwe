view PopoverDemo() =
    <div.demo-row>
        <Popover id="popover-demo-share" trigger="Share" title="Share this page">
            <p>Anyone with the link can view it.</p>
            <Button size="sm" full={true}>Copy link</Button>
        </Popover>
        <Popover id="popover-demo-top" trigger="Above" placement="top" width={220}>
            <p>Opens above the button, or below it when there is no room.</p>
        </Popover>
        <Popover id="popover-demo-right" trigger="To the right" placement="right" variant="ghost" width={220}>
            <p>Any content: Escape or a click elsewhere closes it.</p>
        </Popover>
    </div>

ui_gallery = ui_gallery | push({ slug: "popover", name: "Popover", group: "Overlays",
    summary: "A small panel of anything beside a button, on the browser's popover: Escape and clicks outside close it.",
    demo: PopoverDemo })
