component LoadingOverlayDemoLive() {
    state busy = false
    state saved = 0
    <div.demo-stack>
        <LoadingOverlay id="loading-overlay-demo-form" busy={busy} label="Saving your changes">
            <div.demo-stack style="padding: 16px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius)">
                <TextField name="title" label="Title" value="Quarterly report"/>
                <div.demo-row>
                    <Button id="loading-overlay-demo-save" on_click={() => { busy = true }}>Save</Button>
                    <Button variant="outline">Cancel</Button>
                </div>
            </div>
        </LoadingOverlay>
        <div.demo-row>
            <Button id="loading-overlay-demo-done" variant="outline" size="sm" disabled={!busy}
                    on_click={() => { busy = false; saved += 1 }}>Pretend it saved</Button>
            <span.demo-note>Saved {saved} {saved == 1 ? "time" : "times"}.</span>
        </div>
    </div>
}

view LoadingOverlayDemo() =
    <div.demo-stack>
        <LoadingOverlayDemoLive/>
        <div.demo-row>
            <LoadingOverlay id="loading-overlay-demo-empty" label="Loading invoices" min_height="140px" class="demo-wide"/>
        </div>
        <LoadingOverlay id="loading-overlay-demo-quiet" show_label={false} blur={false} label="Loading the chart">
            <div style="height: 100px; display: grid; place-items: center; border: 1px dashed var(--ui-border); border-radius: var(--ui-radius)">
                A chart that is on its way
            </div>
        </LoadingOverlay>
    </div>

ui_gallery = ui_gallery | push({ slug: "loading_overlay", name: "LoadingOverlay", group: "Feedback",
    summary: "Covers its content with a spinner and a message while something is busy, keeping the content in place but out of reach.",
    tags: ["feedback", "loading", "status", "overlay", "no-js"],
    demo: LoadingOverlayDemo })
