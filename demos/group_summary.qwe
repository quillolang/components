let group_summary_demo_rows = [
    { region: "EU", city: "Lisbon", product: "Bolt", qty: 3, price: 0.10, sold: "2026-01-02" },
    { region: "EU", city: "Lisbon", product: "Nut", qty: 12, price: 0.07, sold: "2026-01-09" },
    { region: "EU", city: "Paris", product: "Bolt", qty: 5, price: 0.20, sold: "2026-02-11" },
    { region: "US", city: "Austin", product: "Saw", qty: 1, price: 19.99m, sold: "2026-03-01" },
    { region: "US", city: "Austin", product: "Saw", qty: 2, price: "19.99", sold: "2026-03-04" },
    { region: "US", city: "Boston", product: "Nut", qty: "n/a", price: 0.07, sold: "2026-03-09" },
    { region: null, city: "", product: "Bolt", qty: 4, price: 0.10, sold: "2025-12-30" },
]

component GroupSummaryDemoLive() {
    state seen = null
    <div.demo-stack>
        <GroupSummary id="group-summary-demo-live" title="Live" rows={group_summary_demo_rows} groups={["product"]}
                      measures={[{ key: "price", fn: "sum" }]} on_change={(r) => { seen = r }}/>
        <p.demo-note>{seen == null ? "Change the groups to see on_change." : `on_change: ${len(seen.lines)} lines, grouped by ${join(seen.groups, ", ")}.`}</p>
    </div>
}

view GroupSummaryDemo() =
    <div.demo-stack>
        <GroupSummary id="group-summary-demo" rows={group_summary_demo_rows} groups={["region", "city"]} name="csv" filename="sales"
                      columns={[{ key: "region", label: "Region" }, { key: "city", label: "City" }, { key: "product", label: "Product" }, { key: "qty", label: "Qty" }, { key: "price", label: "Price" }, { key: "sold", label: "Sold" }]}
                      measures={[{ key: "qty", fn: "sum" }, { key: "price", fn: "sum" }, { key: "price", fn: "avg" }]}/>
        <GroupSummary id="group-summary-demo-slash" title="Awkward values" groups={["a", "b"]} measures={[{ key: "n", fn: "sum" }]}
                      rows={[{ a: "x", b: "1", n: 1 }, { a: "x/y", b: "2", n: "1,000.50" }, { a: "x", b: 1.0, n: 2 }, "not a record", { a: 2, b: "😀", n: 1e30 }, { a: 10, b: "é", n: 79228162514264337593543950335m }]}/>
        <GroupSummary id="group-summary-demo-empty" title="No rows" rows={[]}/>
        <GroupSummaryDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "group_summary", name: "GroupSummary", group: "Data",
    summary: "Groups rows by chosen columns with sum, average, minimum, maximum, count and distinct: nested subtotals, a grand total, folding groups and CSV, all exact.",
    tags: ["smart", "interactive", "aggregate", "subtotals", "report", "csv"], demo: GroupSummaryDemo })
