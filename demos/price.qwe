view PriceDemo() =
    <div.demo-stack>
        <div.demo-row style="gap: 28px">
            <Price amount={19.99}/>
            <Price amount={29.99} old={39.99}/>
            <Price amount={1234.5} old={1499} currency="EUR" locale="de-DE"/>
            <Price amount={1250} currency="JPY" locale="ja-JP"/>
            <Price amount={0}/>
        </div>
        <div.demo-row style="gap: 28px">
            <Price amount="£12.50" old="£20.00" size="sm"/>
            <Price amount={49} old={79} size="lg" tone="danger"/>
            <Price amount={249} size="xl" tone="accent"/>
            <Price amount={9.5} old={12} discount={false}/>
        </div>
        <p.demo-note>Numbers are written for their currency and locale; text is shown as it is. The old price is struck through and the discount worked out.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "price", name: "Price", group: "Commerce",
    summary: "An amount written in its currency, with the old price struck through and the discount worked out.",
    tags: ["commerce", "price", "no-js", "typography"], demo: PriceDemo })
