let funnel_analyzer_demo_steps = [{ name: "Visited", count: 10000 }, { name: "Viewed a product", count: 6000 }, { name: "Added to cart", count: 1800 },
    { name: "Checkout", count: 900 }, { name: "Paid", count: 630 }]

component FunnelAnalyzerDemoLive() {
    state seen = "Change a figure to see on_change."
    <div.demo-stack>
        <FunnelAnalyzer id="funnel-analyzer-demo-live" title="Sign-up" name="signup" steps={[{ name: "Landed", count: 800 }, { name: "Started", count: 300 }, { name: "Confirmed", count: 240 }]}
                        on_change={(f) => { seen = f == null ? "on_change: a count is wrong." : `on_change: ${f.end} at the end, ${round(f.overall, 1, "half_up")}%, leak ${join(f.leak, " and ")}, what-if ${f.what_if ?? "none"}.` }}/>
        <p.demo-note>{seen}</p>
    </div>
}

view FunnelAnalyzerDemo() =
    <div.demo-stack>
        <FunnelAnalyzer id="funnel-analyzer-demo" title="Store checkout" steps={funnel_analyzer_demo_steps}/>
        <FunnelAnalyzerDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "funnel_analyzer", name: "FunnelAnalyzer", group: "Marketing",
    summary: "Step counts to drop-off, conversion and the biggest leak, with a what-if on any step carried through to the end, and a warning when a step grows.",
    tags: ["smart", "interactive", "funnel", "conversion", "analytics", "marketing"], demo: FunnelAnalyzerDemo })
