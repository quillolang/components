component SegmentedControlDemoLive() {
    state plan = "y"
    <div.demo-stack>
        <SegmentedControl name="sc-plan" label="Billing period" value={plan} on_change={(v) => { plan = v }}
                          options={[{ label: "Monthly", value: "m" }, { label: "Yearly", value: "y" }]}/>
        <p.demo-note>{plan == "y" ? "€96 a year: two months free." : "€10 a month."}</p>
    </div>
}

view SegmentedControlDemo() =
    <div.demo-stack>
        <div.demo-row>
            <SegmentedControl name="sc-view" label="View" options={["Day", "Week", "Month"]} value="Week"/>
            <SegmentedControl name="sc-align" label="Align" size="sm" options={["Left", "Center", "Right"]}/>
            <SegmentedControl name="sc-off" label="Disabled" options={["On", "Off"]} disabled={true}/>
        </div>
        <div.demo-narrow>
            <SegmentedControl name="sc-full" label="Sort" full={true} options={["Newest", "Popular", "Oldest"]}/>
        </div>
        <SegmentedControlDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "segmented_control", name: "SegmentedControl", group: "Navigation",
    summary: "One choice of a few, as a pill with the picked one raised: real radio buttons that a form sends.",
    tags: ["forms", "select", "tabs", "no-js"],
    demo: SegmentedControlDemo })
