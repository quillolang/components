view ResultPageDemo() =
    <div.demo-stack>
        <ResultPage id="result-page-demo-ok" title="Order placed" code="Order #4821"
                    actions={[<Button href="#result_page">See the order</Button>, <Button variant="outline" href="#result_page">Keep shopping</Button>]}
                    extra={<DescriptionList items={[{ term: "Delivery", detail: "Thu 6 – Fri 7 Nov" }, { term: "Paid", detail: "€84.00 by card" }]}/>}>
            We emailed a receipt to ada@example.com.
        </ResultPage>
        <div.demo-row style="align-items: stretch">
            <div style="flex: 1; min-width: 260px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius)">
                <ResultPage id="result-page-demo-err" status="error" title="Payment failed"
                            actions={<Button tone="danger" href="#result_page">Try another card</Button>}>
                    The card was declined. Nothing was charged.
                </ResultPage>
            </div>
            <div style="flex: 1; min-width: 260px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius)">
                <ResultPage status="info" title="Check your inbox">We sent a sign-in link to ada@example.com. It works for 15 minutes.</ResultPage>
            </div>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "result_page", name: "ResultPage", group: "Feedback",
    summary: "A whole page that says how something ended: an icon for the outcome, a title, text and what to do next.",
    tags: ["feedback", "page", "status", "section", "no-js"],
    demo: ResultPageDemo })
