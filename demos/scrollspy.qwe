let scrollspy_demo_items = [
    { id: "scrollspy-demo-intro", label: "Introduction" }, { id: "scrollspy-demo-setup", label: "Setup" },
    { id: "scrollspy-demo-usage", label: "Usage" }, { id: "scrollspy-demo-api", label: "API" },
    { id: "scrollspy-demo-faq", label: "FAQ" }
]

component ScrollspyDemoLive() {
    state at = "scrollspy-demo-intro"
    <div.demo-stack>
        <div style="display: flex; gap: 20px; align-items: flex-start">
            <div style="flex: none; width: 150px">
                <Scrollspy id="scrollspy-demo" items={scrollspy_demo_items} scroller="scrollspy-demo-article" offset={8}
                           on_change={(id) => { at = id }}/>
            </div>
            <div id="scrollspy-demo-article" tabindex="0" aria-label="The guide"
                 style="flex: 1; min-width: 0; height: 300px; overflow: auto; padding: 0 16px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius)">
                {for it in scrollspy_demo_items => [
                    <h3 id={it.id} style="font-size: 16px; margin: 16px 0 6px">{it.label}</h3>,
                    <p style="margin: 0 0 10px">{it.label}: a few paragraphs go here, long enough that the box scrolls and the
                        list beside it follows the section in view.</p>,
                    <p style="margin: 0 0 10px; color: var(--ui-muted)">More about {lower(it.label)}, with examples and notes.</p>
                ]}
                <div style="height: 140px"></div>
            </div>
        </div>
        <p.demo-note>In view: {find(scrollspy_demo_items, (it) => it.id == at).label}</p>
    </div>
}

view ScrollspyDemo() =
    <div.demo-stack style="gap: 24px">
        <ScrollspyDemoLive/>
        <div style="border: 1px solid var(--ui-border); border-radius: var(--ui-radius); overflow: hidden">
            <Scrollspy id="scrollspy-demo-row" horizontal={true} scroller="scrollspy-demo-article" items={scrollspy_demo_items} label="Sections, across"/>
            <p.demo-note style="padding: 10px 14px">The same sections in a row, following the same box.</p>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "scrollspy", name: "Scrollspy", group: "Navigation",
    summary: "Links to the sections of a page that mark the one in view as it scrolls, down the side or in a row.",
    tags: ["navigation", "link", "page", "interactive"], demo: ScrollspyDemo })
