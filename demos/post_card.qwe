component PostCardDemoLive() {
    state liked = false
    state likes = 1199
    state events = []
    <div.demo-stack>
        <PostCard id="post-card-demo-live" name="Ben Okafor" handle="@ben" time="4 h" datetime="2026-10-28T07:00:00Z"
                  text="Anyone up for a run along the river on Saturday?" likes={likes} comments={3} liked={liked}
                  on_like={(on) => { liked = on; likes = on ? likes + 1 : likes - 1 }}
                  on_comment={() => { events = events | push("comment") }}
                  on_share={() => { events = events | push("share") }}/>
        <p.demo-note>{liked ? "Liked." : "Not liked."} {len(events) == 0 ? "" : `Pressed: ${join(events, ", ")}.`}</p>
    </div>
}

view PostCardDemo() =
    <div.demo-stack.demo-narrow style="max-width: 520px">
        <PostCard id="post-card-demo-first" name="Ana Silva" handle="@ana" verified={true} avatar="https://i.pravatar.cc/80?img=47"
                  time="2 h" datetime="2026-10-28T09:12:00Z" href="#post_card"
                  text="Shipped the new tables today 🚀
Sorting, filtering and 100,000 rows without a hiccup."
                  image="https://picsum.photos/seed/tables/900/420" image_alt="A table of orders on a laptop screen"
                  likes={128} comments={12} shares={2500} comment_href="#post_card"/>
        <PostCardDemoLive/>
        <PostCard id="post-card-demo-quiet" name="Release bot" text="v2.4.0 is out." time="Yesterday" actions={false}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "post_card", name: "PostCard", group: "Social",
    summary: "A post in a feed: author, time, text, picture, like, comment and share counts, and the three buttons.",
    tags: ["social", "card", "user", "no-js"], demo: PostCardDemo })
