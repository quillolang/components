let swipe_dismiss_list_demo_alerts = [
    { id: 1, title: "Build finished", subtitle: "main, 4 minutes ago" }, { id: 2, title: "Ana replied", subtitle: "On the quarterly report" },
    { id: 3, title: "Card ending 4242", subtitle: "Expires next month" }, { id: 4, title: "Backup complete", subtitle: "12.4 GB, last night" },
    { id: 5, title: "Parcel delivered", subtitle: "Left with a neighbour" }, { id: 6, title: "Storm warning", subtitle: "Until 9 pm" },
]

component SwipeDismissListDemoLive() {
    state log = "Nothing final yet."
    state undone = ""
    <div.demo-stack>
        <SwipeDismissList items={swipe_dismiss_list_demo_alerts} undo_seconds={5} batch_ms={1000} clear_label="Clear all" label="Alerts" empty_text="All clear."
                          on_dismiss={(ids) => { log = `${log == "Nothing final yet." ? "" : log + "; "}${join(ids, " ")}` }}
                          on_undo={(ids) => { undone = join(ids, " ") }}/>
        <p.demo-note id="swipe-dismiss-log">{log}</p>
        <p.demo-note id="swipe-dismiss-undone">{undone}</p>
        // Bad data, for the test to look at: nothing here should stop the page.
        <div id="swipe-dismiss-bad" hidden="true"><SwipeDismissList items={[null, { id: 1 }, { id: 2, title: "Two" }, { id: 2, title: "Again" }, { title: "No id" }]}/><SwipeDismissList items="none"/></div>
    </div>
}

view SwipeDismissListDemo() = <SwipeDismissListDemoLive/>

ui_gallery = ui_gallery | push({ slug: "swipe_dismiss_list", name: "SwipeDismissList", group: "Mobile",
    summary: "Swipe rows away, the rest closing up, with undo in batches that come back in order.",
    tags: ["mobile", "interactive", "gesture", "swipe", "undo", "tablet"],
    demo: SwipeDismissListDemo })
