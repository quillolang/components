component NaturalDateInputDemoLive() {
    state picked = ""
    <div.demo-stack>
        <NaturalDateInput id="natural-date-demo-live" label="Follow up" today="2026-11-04" now="09:30" locale="en-GB" time={false}
                          on_change={(v) => { picked = v }}/>
        <p.demo-note>{picked == "" ? "Type a date to see on_change." : `on_change: ${picked}`}</p>
    </div>
}

view NaturalDateInputDemo() =
    <div class="demo-stack demo-narrow">
        <form>
            <NaturalDateInput id="natural-date-demo" name="due" label="Due" today="2026-11-04" now="09:30" locale="en-US"
                              value="next friday 5pm" hint="Words work: tomorrow noon, in 3 days, end of month."/>
        </form>
        <NaturalDateInputDemoLive/>
        <NaturalDateInput id="natural-date-demo-limited" name="trip" label="Trip starts" today="2026-11-04" now="09:30" time={false}
                          earliest="2026-11-04" latest="2026-12-31"/>
        <NaturalDateInput id="natural-date-demo-past" label="Started on" today="2026-11-04" now="09:30" time={false} prefer="past"/>
        <NaturalDateInput id="natural-date-demo-clock" name="clock" label="On the browser's clock" time={false}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "natural_date_input", name: "NaturalDateInput", group: "Forms",
    summary: "Understands next friday 5pm, in 3 days, end of month and 12/3 in the locale's order, says what it took, and offers the other readings when words mean two things.",
    tags: ["smart", "interactive", "date", "natural", "parser", "forms"], demo: NaturalDateInputDemo })
