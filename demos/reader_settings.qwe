view ReaderSettingsDemo() =
    <ReaderSettings id="reader-settings-demo" store="reader-settings-demo">
        <h2 style="margin-top: 0">The case for small websites</h2>
        <p>A small website loads before you have finished deciding to visit it. It has one author, who answers email, and an archive
            that goes back further than any platform has lasted. Nobody optimises it for engagement, so it is free to be odd.</p>
        <p>Most of mine is text. The rest is a <a href="#reader_settings">list of other people's small websites</a>, which is the
            oldest way of finding things on the web and still the best one.</p>
    </ReaderSettings>

ui_gallery = ui_gallery | push({ slug: "reader_settings", name: "ReaderSettings", group: "Blogging",
    summary: "A post's text the way each reader likes it: size, serif or sans, line length, line spacing and light or dark, kept for their next visit.",
    tags: ["blogging", "settings", "typography", "accessibility", "interactive"], demo: ReaderSettingsDemo })
