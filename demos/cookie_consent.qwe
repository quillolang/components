component CookieConsentDemoLive() {
    state choice = null
    <div.demo-stack>
        <CookieConsent name="demo-live" position="inline" policy="#cookie_consent"
                       on_change={(c) => { choice = c }}/>
        <p.demo-note>{choice == null ? "No choice made yet." : `Analytics ${choice.analytics ? "on" : "off"}, marketing ${choice.marketing ? "on" : "off"}.`}</p>
    </div>
}

view CookieConsentDemo() =
    <div.demo-stack>
        <CookieConsentDemoLive/>
        <CookieConsent name="demo-short" position="inline" title={null} accept="OK" reject="No thanks" settings="Choose"
                       text="This site uses a few cookies to work, and one to count visits."
                       categories={[{ key: "necessary", label: "Necessary", required: true }, { key: "stats", label: "Statistics", text: "Page views, counted anonymously." }]}/>
        <p.demo-note>Positioned across the bottom of the window by default; inline here so you can see it. The choice is kept in localStorage: these two forget it when the page loads, so they show again.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "cookie_consent", name: "CookieConsent", group: "Feedback",
    summary: "A cookie banner with accept, reject and settings by category, remembering the choice in localStorage.",
    tags: ["feedback", "notification", "settings", "security", "interactive"],
    demo: CookieConsentDemo })
