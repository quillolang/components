let opening_hours_demo_week = [
    { day: 1, open: "09:00", close: "13:00" }, { day: 1, open: "14:00", close: "18:00" },
    { day: 2, open: "09:00", close: "18:00" }, { day: 3, open: "09:00", close: "18:00" },
    { day: 4, open: "09:00", close: "20:00" }, { day: 5, open: "09:00", close: "18:00" },
    { day: 6, open: "10:00", close: "02:00" },
]

view OpeningHoursDemo() =
    <div.demo-row style="align-items: flex-start; gap: 28px">
        <div style="flex: 1 1 280px; max-width: 340px">
            <OpeningHours id="opening-hours-demo-now" zone="Europe/Lisbon" hours={opening_hours_demo_week} notes={{ "7": "Bank holidays too" }}/>
        </div>
        <div.demo-stack style="flex: 1 1 240px">
            <OpeningHours id="opening-hours-demo-lunch" compact={true} title={null} hours={opening_hours_demo_week} at="2026-11-02T13:20"/>
            <OpeningHours id="opening-hours-demo-soon" compact={true} title={null} hours={opening_hours_demo_week} at="2026-11-05T19:45"/>
            <OpeningHours id="opening-hours-demo-late" compact={true} title={null} hours={opening_hours_demo_week} at="2026-11-08T01:15"/>
            <OpeningHours id="opening-hours-demo-sunday" compact={true} title={null} hours={opening_hours_demo_week} at="2026-11-08T12:00" closed_label="Shut"/>
            <OpeningHours id="opening-hours-demo-friday" compact={true} title={null} hours={opening_hours_demo_week} at="2026-11-06T19:00"/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "opening_hours", name: "OpeningHours", group: "Scheduling",
    summary: "A week's opening hours with today marked and whether it is open now, closing soon, or when it opens next.",
    tags: ["schedule", "time", "status", "table", "no-js"], demo: OpeningHoursDemo })
