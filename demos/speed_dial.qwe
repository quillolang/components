component SpeedDialDemoLive() {
    state did = "nothing yet"
    <div.demo-stack>
        <div style="position: relative; height: 260px; border: 1px dashed var(--ui-border); border-radius: var(--ui-radius)">
            <SpeedDial id="sd-demo-create" label="Create" inline={true} items={[
                { label: "New document", icon: "edit", href: "#speed_dial" },
                { label: "Send a message", icon: "message" },
                { label: "Upload", icon: "up", disabled: true },
                { label: "Call", icon: "phone" },
            ]} on_select={(it) => { did = it.label }}/>
            <SpeedDial id="sd-demo-top" label="Quick actions" icon="search" tone="neutral" corner="top-left" inline={true} items={[
                { label: "Find people", icon: "search" },
                { label: "Email", icon: "mail" },
            ]} on_select={(it) => { did = it.label }}/>
        </div>
        <p.demo-note>Did: {did}</p>
    </div>
}

view SpeedDialDemo() = <SpeedDialDemoLive/>

ui_gallery = ui_gallery | push({ slug: "speed_dial", name: "SpeedDial", group: "Actions",
    summary: "A floating action button that opens a column of smaller labelled actions, with the keyboard and a click elsewhere handled.",
    tags: ["button", "menu", "mobile", "interactive"],
    needs: ["fab"],
    demo: SpeedDialDemo })
