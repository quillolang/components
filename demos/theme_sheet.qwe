component ThemeSheetDemoLive(saved = null, start_open: bool = false) {
    state showing = start_open
    state said = ""
    state closes = 0
    <div.demo-stack>
        <ThemeSheet id="theme-sheet-demo" saved={saved} open={showing} on_close={() => { showing = false; closes += 1 }}
                    on_change={(t) => { said = t.value }}/>
        <div>
            <Button size="lg" id="theme-sheet-demo-open" on_click={() => { showing = true }}>Appearance</Button>
        </div>
        <p.demo-note id="theme-sheet-demo-out">{said}, closed {closes}.</p>
    </div>
}

// A view cannot read `request`; a server fn can, and a route's own page would just use it.
server fn theme_sheet_demo_saved() = get(request.cookies, "ui-theme")
server fn theme_sheet_demo_open() = get(request.query, "sheet") == "open"

view ThemeSheetDemo() {
    let saved = theme_sheet_demo_saved()
    <div.demo-stack>
        <ThemeSheetStyle saved={saved}/>
        <ThemeSheetDemoLive saved={saved} start_open={theme_sheet_demo_open()}/>
        <ThemeSheet id="theme-sheet-demo-own" trigger="With its own button" saved={saved} remember={null}/>
    </div>
}

ui_gallery = ui_gallery | push({ slug: "theme_sheet", name: "ThemeSheet", group: "Mobile",
    summary: "Light, dark, system and accent in a sheet, with a live preview, kept, and no flash next time.",
    tags: ["mobile", "interactive", "tablet", "theme", "settings", "dark-mode"],
    demo: ThemeSheetDemo })
