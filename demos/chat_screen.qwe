let chat_screen_demo_people = { ana: "Ana Silva", ben: "Ben Oduya" }

fn chat_screen_demo_msg(id, from: str, at: str, text: str) =
    { id, from, name: from == "me" ? "You" : get(chat_screen_demo_people, from, from), mine: from == "me", at, text, status: from == "me" ? "read" : null }

let chat_screen_demo_start = [
    chat_screen_demo_msg(10, "ana", "2026-10-29T17:02:00", "Is the crane booked for Monday?"),
    chat_screen_demo_msg(11, "me", "2026-10-29T17:05:00", "Booked, from eight."),
    chat_screen_demo_msg(12, "ben", "2026-10-31T08:15:00", "I can take the early shift."),
    chat_screen_demo_msg(13, "ben", "2026-10-31T08:16:00", "If someone opens the gate."),
    chat_screen_demo_msg(14, "ben", "2026-10-31T08:40:00", "Scratch that, I have the key."),
    chat_screen_demo_msg(15, "ana", "2026-10-31T09:00:00", "Thanks, Ben."),
    chat_screen_demo_msg(16, "me", "2026-11-01T07:58:00", "Everyone set for tomorrow?"),
    chat_screen_demo_msg(17, "ana", "2026-11-01T08:01:00", "Yes. I will bring the drawings and the permits for the north side."),
    chat_screen_demo_msg(18, "ben", "2026-11-01T08:03:00", "Same here."),
    chat_screen_demo_msg(19, "ana", "2026-11-01T08:04:00", "One thing: the road is closed past the bridge, so come in by the mill."),
    chat_screen_demo_msg(20, "me", "2026-11-01T08:05:00", "Noted. The delivery was told the same on Friday."),
    chat_screen_demo_msg(21, "ana", "2026-11-01T08:06:00", "Good."),
    chat_screen_demo_msg(22, "me", "2026-11-01T08:07:00", "See you all at eight.")
]

let chat_screen_demo_older = [
    chat_screen_demo_msg(1, "ana", "2025-12-31T23:50:00", "Happy new year, everyone."),
    chat_screen_demo_msg(2, "ben", "2026-10-02T10:00:00", "The site opens in a month."),
    chat_screen_demo_msg(3, "ana", "2026-10-02T10:01:00", "Who has the plans?"),
    chat_screen_demo_msg(4, "me", "2026-10-02T10:04:00", "I do. I will send them tonight."),
    chat_screen_demo_msg(5, "ben", "2026-10-29T16:00:00", "Plans look fine to me."),
    chat_screen_demo_msg(6, "ana", "2026-10-29T16:02:00", "And to me. Only the crane is left."),
    chat_screen_demo_msg(7, "ana", "2026-10-29T16:03:00", "Can you book it?"),
    chat_screen_demo_msg(8, "me", "2026-10-29T16:30:00", "On it."),
    chat_screen_demo_msg(9, "ben", "2026-10-29T16:58:00", "Ask for the long jib.")
]

component ChatScreenDemoLive() {
    state msgs = chat_screen_demo_start
    state older = chat_screen_demo_older
    state loading = false
    state next = 100
    state open = "site"
    if loading { every(150, () => {
        // A batch at a time, from the newest of what is left.
        let cut = max([len(older) - 5, 0])
        msgs = slice(older, cut, len(older)) + msgs
        older = slice(older, 0, cut)
        loading = false
    }) }
    <div.demo-stack>
        <div.demo-phone id="chat-screen-demo" style="height: 560px">
            <ChatScreen title="Mill Road site" subtitle="Ana, Ben and you" today="2026-11-01" messages={msgs} has_more={len(older) > 0} loading={loading}
                        threads={[{ id: "site", name: "Mill Road site", preview: "See you all at eight." }, { id: "ben", name: "Ben Oduya", preview: "Key is with me", unread: 2 }]}
                        current={open} on_thread={(t) => { open = t }} on_load_older={() => { loading = true }}>
                <ComposerBar id="chat-screen-composer" keyboard={false} attach={false} voice={false} on_send={(m) => {
                    msgs = msgs + [chat_screen_demo_msg(next, "me", "2026-11-01T08:30:00", m.text)]
                    next += 1
                }}/>
            </ChatScreen>
        </div>
        <div.demo-row>
            <Button size="lg" id="chat-screen-arrives" on_click={() => {
                msgs = msgs + [chat_screen_demo_msg(next, "ben", "2026-11-01T08:31:00", `Message ${next} from Ben.`)]
                next += 1
            }}>A message arrives</Button>
            <span.demo-note id="chat-screen-open">Open: {open}</span>
        </div>
    </div>
}

view ChatScreenDemo() =
    <div.demo-stack>
        <ChatScreenDemoLive/>
        <div.demo-phone id="chat-screen-fill-demo" style="height: 240px">
            <ChatScreen fill={true} title="As a whole screen" today="2026-11-01" typing="Ana" messages={[
                { id: "a", from: "ana", name: "Ana", at: "2026-11-01T08:00:00", text: "With fill it follows the window." },
                { id: "constructor", from: "ben", name: "Ben", at: "not a time", text: "A time that cannot be read is no trouble." },
                { id: "a", from: "ana", name: "Ana", at: "2026-11-01T08:00:00", text: "A repeated id is shown once." },
                { from: "ana", text: "Nor is a message with no id: it has no place to keep." }
            ]}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "chat_screen", name: "ChatScreen", group: "Mobile",
    summary: "Messages grouped by sender and day, keeping your place while older ones load, at the bottom as new ones come, and clear of the keyboard.",
    tags: ["mobile", "interactive", "chat", "messages", "keyboard", "tablet"], needs: ["message_bubble", "composer_bar"], demo: ChatScreenDemo })
