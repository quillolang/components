let formula_grid_demo_cells = {
    A1: "Item", B1: "Qty", C1: "Price", D1: "Total",
    A2: "Bolts", B2: "3", C2: "0.10", D2: "=B2*C2",
    A3: "Nuts", B3: "12", C3: "0.07", D3: "=B3*C3",
    A4: "Washers", B4: "7", C4: "1.15", D4: "=B4*C4",
    A5: "Total", B5: "=SUM(B2:B4)", D5: "=SUM(D2:D4)",
    A6: "Average", D6: "=AVG(D2:D4)",
    A7: "Largest", D7: "=MAX(D2:D4)",
    A8: "Numbers", D8: "=COUNT(A1:D4)",
    A9: "Size", D9: "=IF(D5>5,\"big\",\"small\")",
}

component FormulaGridDemoLive() {
    state seen = null
    <div.demo-stack>
        <FormulaGrid id="formula-grid-demo-live" label="Live" cols={2} rows={3} cells={{ A1: "2", A2: "3", A3: "=A1*A2" }}
                     on_change={(s) => { seen = s }}/>
        <p.demo-note>{seen == null ? "Edit a cell to see on_change." : `on_change: ${seen.changed} changed, A3 is ${seen.values.A3}.`}</p>
    </div>
}

view FormulaGridDemo() =
    <div.demo-stack>
        <FormulaGrid id="formula-grid-demo" label="Order" cols={5} rows={10} name="sheet" cells={formula_grid_demo_cells}/>
        <FormulaGrid id="formula-grid-demo-errors" label="What goes wrong" cols={3} rows={8}
                     cells={{ A1: "=1/0", A2: "=Z99", A3: "=B3", B3: "=C3+1", C3: "=A3", A4: "=NOPE(1)", A5: "=A1+1", A6: "=\"a\"*2", A7: "=SUM(A1:A2", A8: "=SUM(A1:Z99)",
                              B1: "=hello", B2: "=99999999999999999999999999*99999999999999999999", B4: "=B4", B5: "=SUM(C5:C6)", C5: "note", C6: "2" }}/>
        <FormulaGridDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "formula_grid", name: "FormulaGrid", group: "Data",
    summary: "A small spreadsheet: formulas with ranges and SUM AVG MIN MAX COUNT IF, dependency-ordered recalculation, exact decimals, keyboard movement and errors in the cell.",
    tags: ["smart", "interactive", "spreadsheet", "formula", "grid", "calculator"], demo: FormulaGridDemo })
