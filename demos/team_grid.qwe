let team_grid_demo_people = [
    { name: "Ada Lovelace", role: "Founder", bio: "Wrote the first program, and the first notes on what programs could be.",
      links: [{ label: "X", href: "#team_grid" }, { label: "Site", href: "#team_grid" }] },
    { name: "Grace Hopper", role: "Compilers", bio: "Made code read like English, and found the first bug.",
      links: [{ label: "GitHub", href: "#team_grid" }] },
    { name: "Margaret Hamilton", role: "Flight software", bio: "Software that landed on the Moon and did not crash on the way." },
    { name: "Linus Benedict", role: "Kernels" },
]

view TeamGridDemo() =
    <div.demo-stack>
        <TeamGrid id="team-grid-demo" title="The team" text="Four people, one file." people={team_grid_demo_people}/>
        <TeamGrid columns={3} variant="cards" size="lg" people={take(team_grid_demo_people, 3)}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "team_grid", name: "TeamGrid", group: "Marketing",
    summary: "The team as a grid of people: picture or initials, name, role, a line about them and links.",
    tags: ["marketing", "section", "grid", "user", "profile", "no-js"],
    needs: ["avatar"],
    demo: TeamGridDemo })
