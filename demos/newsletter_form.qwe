component NewsletterFormDemoLive() {
    state sent = null
    <div.demo-stack>
        {sent == null
            ? <NewsletterForm action="#" id="newsletter-form-demo-live" title="Stay in the loop" text="One email a month, no more."
                              button="Join" on_submit={(email) => { sent = email }}/>
            : <NewsletterForm done={true} id="newsletter-form-demo-done" title="Stay in the loop"/>}
        <p.demo-note>{sent == null ? "Not sent yet." : `on_submit got ${sent}.`}</p>
    </div>
}

view NewsletterFormDemo() =
    <div.demo-stack>
        <NewsletterForm action="/subscribe" list="product" id="newsletter-form-demo-plain"/>
        <NewsletterFormDemoLive/>
        <NewsletterForm action="/subscribe" small={true} value="ada@example" id="newsletter-form-demo-error"
                        error="That does not look like an email address."/>
    </div>

ui_gallery = ui_gallery | push({ slug: "newsletter_form", name: "NewsletterForm", group: "Forms",
    summary: "An email box and a Subscribe button in one row, a plain form posting to your route, with a done state once it worked.",
    tags: ["forms", "input", "button", "marketing", "no-js"], demo: NewsletterFormDemo })
