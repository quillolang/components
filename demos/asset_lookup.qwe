let asset_lookup_demo_assets = [
    { tag: "PMP-1042", name: "Sump pump", kind: "Pump", status: "in_service", location: "Basement, bay 3", serial: "SP-88213", next_service: "2026-10-20", assigned: "Plant team",
      history: [{ on: "2026-04-20", what: "Serviced", who: "M. Roy" }, { on: "2026-08-02", what: "Seal replaced", who: "A. Diallo" }, { on: "2025-10-18", what: "Fitted" }] },
    { tag: "GEN-0007", name: "Generator, 20 kVA", kind: "Generator", status: "in_service", location: "Yard", next_service: "2026-11-10", expires: "2027-03-01", todo: ["Check the fuel level before use"] },
    { tag: "LFT-2208", name: "Scissor lift", kind: "Lift", status: "out_of_service", location: "Workshop", notes: "Hydraulic leak, part on order", next_service: "2027-02-01" },
    { tag: "DRL-5150", name: "Hammer drill", kind: "Hand tool", status: "in_service", location: "Van 12", next_service: "2027-06-01", assigned: "J. Tremblay" },
    { tag: "constructor", name: "A tag that is also a JavaScript word", status: "missing" },
]

component AssetLookupDemoLive() {
    state said = "Nothing yet."
    <div.demo-stack>
        <AssetLookup today="2026-11-02" assets={asset_lookup_demo_assets} actions={[{ id: "fault", label: "Report a fault" }, { id: "move", label: "Move it" }]}
                     on_found={(a) => { said = `found ${a.tag}` }}
                     on_action={(a, what) => { said = `${what.id} on ${a.tag}` }}
                     on_unknown={(t) => { said = `unknown ${t}` }}/>
        <p.demo-note id="assetl-demo-said">{said}</p>
    </div>
}

view AssetLookupDemo() = <AssetLookupDemoLive/>

ui_gallery = ui_gallery | push({ slug: "asset_lookup", name: "AssetLookup", group: "Mobile",
    summary: "Scan or type an asset tag to see its record, history and what to do, with near matches and a report for a tag nobody knows.",
    tags: ["mobile", "interactive", "barcode", "field", "offline", "tablet"],
    needs: ["scan_count"],
    demo: AssetLookupDemo })
