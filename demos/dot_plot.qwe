let dot_plot_demo_grid = "display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 32px 40px"

view DotPlotDemo() =
    <div.demo-stack>
        <DotPlot label="Reading score, 2024 and 2025" show_label={true} sort="change"
                 labels={["Northfield", "Riverside", "Oak Hill", "Lakeview", "Westbrook", "Harbor"]}
                 series={[{ name: "2024", values: [61, 72, 55, 80, 68, 49] },
                          { name: "2025", values: [70, 74, 66, 77, 75, 58] }]}/>
        <div style={dot_plot_demo_grid}>
            <DotPlot label="Hours to first reply" show_label={true} sort="asc" zero={true} suffix=" h"
                     labels={["Billing", "Sales", "Support", "Security"]} values={[3.5, 1.2, 6, 14]}/>
            <DotPlot label="Salary range by level" show_label={true} prefix="$"
                     labels={["Junior", "Mid", "Senior", "Staff"]}
                     series={[{ name: "Low", values: [52000, 74000, 98000, 131000] },
                              { name: "Median", values: [61000, 86000, 114000, 152000] },
                              { name: "High", values: [70000, 99000, 135000, null] }]}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "dot_plot", name: "DotPlot", group: "Charts",
    summary: "Values as dots along one axis per row; with two or more series joined as a dumbbell, sorted by change if asked, with the change on hover.",
    tags: ["chart", "data", "no-js"],
    demo: DotPlotDemo })
