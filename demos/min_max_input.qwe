component MinMaxInputDemoLive() {
    state range = [18, 65]
    <div.demo-stack>
        <MinMaxInput name="age" label="Age" low={18} high={65} lowest={0} highest={120} field="min-max-input-demo-live"
                     on_change={(lo, hi) => { range = [lo, hi] }}/>
        <p.demo-note>From {range[0] ?? "any"} to {range[1] ?? "any"}.</p>
    </div>
}

view MinMaxInputDemo() =
    <div.demo-stack>
        <MinMaxInput name="price" label="Price" low={10} high={200} lowest={0} highest={1000} step={5} unit="€"
                     field="min-max-input-demo-price" hint="Leaving a box puts the pair in order and inside 0 to 1000."/>
        <MinMaxInputDemoLive/>
        <div.demo-row>
            <MinMaxInput name="weight" label="Weight" size="sm" unit="kg" field="min-max-input-demo-small" required={true}
                         error="Give both weights."/>
            <MinMaxInput name="locked" label="Disabled" size="sm" low={1} high={5} disabled={true}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "min_max_input", name: "MinMaxInput", group: "Forms",
    summary: "Two number boxes, a minimum and a maximum, kept in order and inside their bounds, posted as name_min and name_max.",
    tags: ["forms", "input", "filter", "interactive"], demo: MinMaxInputDemo })
