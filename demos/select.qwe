component SelectDemoLive() {
    state picked = ["Rust"]
    <div.demo-stack>
        <Select name="langs" label="Languages you know" multiple={true} rows={4} value={picked}
                options={["Quillo", "Rust", "Python", "JavaScript", "Go"]}
                hint="Cmd- or Ctrl-click to choose several." on_change={(vs) => { picked = vs }}/>
        <p.demo-note>Chosen: {len(picked) > 0 ? join(picked, ", ") : "none"}</p>
    </div>
}

view SelectDemo() =
    <div.demo-stack.demo-narrow>
        <Select name="country" label="Country" placeholder="Choose a country" required={true}
                options={["France", "Japan", "Peru", "Kenya"]} hint="Where you pay tax."/>
        <Select name="plan" label="Plan" value="team" error="Team needs a card on file."
                options={[{ label: "Free", value: "free" }, { label: "Team, $8 a seat", value: "team" },
                          { label: "Enterprise (talk to us)", value: "ent", disabled: true }]}/>
        <div.demo-row>
            <Select name="tz" label="Time zone" size="sm" value="Tokyo"
                    groups={[{ label: "Europe", options: ["London", "Paris", "Rome"] },
                             { label: "Asia", options: ["Seoul", "Tokyo"] }]}/>
            <Select name="locked" label="Region" size="sm" options={["EU"]} disabled={true}/>
        </div>
        <SelectDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "select", name: "Select", group: "Forms",
    summary: "A drop-down on the browser's own select: options, groups, a placeholder, and a list box for several.",
    tags: ["forms", "select", "no-js"],
    demo: SelectDemo })
