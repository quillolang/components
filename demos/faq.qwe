let faq_demo_items = [
    { question: "What does it cost?", answer: "Nothing for one project and up to three people. Teams pay per seat, monthly or yearly.", open: true },
    { question: "Can I cancel at any time?", answer: "Yes, from Settings, Billing. You keep access until the end of the period you paid for." },
    { question: "Where is my data kept?", answer: "In the EU, on servers in Frankfurt, with nightly backups kept for 30 days." },
    { question: "Do you offer invoices for companies?", answer: "Yes: add a VAT number under Billing and every invoice carries it." },
    { question: "Is there a student discount?", answer: "Half price with a university email address; write to us from it." },
    { question: "How do I export everything?", answer: "Settings, Export makes a zip of your projects as JSON and files within a minute." },
]

view FaqDemo() =
    <div.demo-stack>
        <Faq id="faq-demo" items={faq_demo_items}/>
        <p.demo-note>Type "invoice" or "cancel" to filter. Below, no search and one open at a time.</p>
        <Faq id="faq-demo-short" search={false} exclusive={true} items={take(faq_demo_items, 3)}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "faq", name: "Faq", group: "Marketing",
    summary: "Questions that open to their answers on <details>, with a search box that keeps only the ones matching.",
    tags: ["marketing", "search", "filter", "list", "interactive"],
    demo: FaqDemo })
