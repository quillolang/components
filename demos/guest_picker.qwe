component GuestPickerDemoLive() {
    state who = { adults: 2, children: 0, infants: 0, pets: 0 }
    <div.demo-stack>
        <GuestPicker name="gp-demo" value={who} max_guests={4} on_change={(c) => { who = c }}/>
        <p.demo-note>{who.adults} adults, {who.children} children, {who.infants} infants, {who.pets} pets.</p>
    </div>
}

view GuestPickerDemo() =
    <div.demo-row>
        <GuestPickerDemoLive/>
        <GuestPicker name="gp-demo-room" label="People" pets={false} value={{ adults: 1 }} max_guests={2}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "guest_picker", name: "GuestPicker", group: "Forms",
    summary: "How many adults, children, infants and pets are coming, said in one line, with a most for guests.",
    tags: ["forms", "picker", "interactive"],
    demo: GuestPickerDemo })
