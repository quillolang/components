component StorageMeterDemoLive() {
    state photos = 52428800
    state refuse = false
    state told = "Nothing cleared yet."
    // A pretend clear, a moment long. Named, as js_new is not waited for in a function written
    // in the markup's prop.
    let wipe = (_k) => {
        let pause = js("Promise.resolve", js_new("Promise", (done) => { js("AbortSignal.timeout", 60).addEventListener("abort", (_e) => { done(true) }) }))
        pause && !refuse
    }
    <div.demo-stack>
        <StorageMeter id="stormeter-demo" kinds={[{ id: "photos", label: "Photos", bytes: photos, note: "Kept by the app, outside the browser's own storage.", warn: "They come back from the server when you are online." }]}
                      on_clear={wipe} on_cleared={(which, freed) => {
                          told = `Cleared ${which}, ${freed ?? "unknown"} bytes.`
                          if which == "photos" { photos = 0 }
                      }}/>
        <div.demo-row><Button size="lg" variant="outline" id="stormeter-refuse" on_click={() => { refuse = !refuse }}>{refuse ? "Let clears through" : "Make the program refuse"}</Button></div>
        <p.demo-note id="stormeter-told">{told}</p>
    </div>
}

view StorageMeterDemo() = <StorageMeterDemoLive/>

ui_gallery = ui_gallery | push({ slug: "storage_meter", name: "StorageMeter", group: "Mobile",
    summary: "Space used by the app from navigator.storage, by kind, and a clear with a confirm.",
    tags: ["mobile", "interactive", "offline", "storage", "settings", "tablet"],
    demo: StorageMeterDemo })
