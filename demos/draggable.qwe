component DraggableDemoLive() {
    state at = [24, 24]
    <div.demo-stack>
        <div id="draggable-demo-board" style="position: relative; height: 260px; border: 1px dashed var(--ui-strong); border-radius: var(--ui-radius); background: var(--ui-subtle)">
            <Draggable x={24} y={24} label="Sticky note" on_move={(x, y) => { at = [x, y] }}>
                <div style="width: 150px; padding: 14px; border-radius: var(--ui-radius-sm); background: var(--ui-warning-soft); border: 1px solid var(--ui-border)">Buy milk<br/>Call Ana</div>
            </Draggable>
            <Draggable x={260} y={120} handle={true} label="Panel">
                <div style="width: 180px; padding: 10px 14px; background: var(--ui-surface); border: 1px solid var(--ui-border); border-top: 0; border-radius: 0 0 var(--ui-radius-sm) var(--ui-radius-sm)">Drag me by the grip.</div>
            </Draggable>
        </div>
        <p.demo-note>The note is at {at[0]}, {at[1]}. Drag it, or Tab to it and use the arrow keys.</p>
    </div>
}

view DraggableDemo() =
    <div.demo-stack>
        <DraggableDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "draggable", name: "Draggable", group: "Utilities",
    summary: "A box dragged anywhere in its container with the pointer or the arrow keys, kept inside it, with on_move(x, y).",
    tags: ["utility", "drag", "keyboard", "interactive"],
    demo: DraggableDemo })
