let quick_settings_grid_demo_tiles = [
    { id: "wifi", label: "Wi-Fi", icon: "globe", on: true, detail: "Joins saved networks by itself.", options: ["Home", "Office", "Cafe"], value: "Home" },
    { id: "bt", label: "Bluetooth", icon: "share", on: true },
    { id: "dnd", label: "Do not disturb", icon: "moon", detail: "Calls and alerts stay silent.", options: ["For an hour", "Until tomorrow"] },
    { id: "torch", label: "Torch", icon: "sun" },
    { id: "lock", label: "Rotation lock", icon: "lock" },
    { id: "place", label: "Location", icon: "map-pin", on: true },
    { id: "roam", label: "Data roaming", icon: "phone", unavailable: "Needs a SIM card." },
    { id: "cast", label: "Cast", icon: "video" },
]

component QuickSettingsGridDemoLive() {
    state kept = []
    state told = "Nothing yet."
    state again = 0
    state stir = 0
    <div.demo-stack>
        <div id="quick-settings-main"><QuickSettingsGrid key={again} tiles={quick_settings_grid_demo_tiles | map((t) => t.id == "cast" ? { ...t, label: `Cast ${stir}` } : t)} saved={kept} on_change={(r) => { kept = r }}
            on_toggle={(id, on) => { told = `${id} ${on}` }} on_detail={(id, v) => { told = `${id}: ${v}` }}/></div>
        <p.demo-note id="quick-settings-told">{told}</p>
        <p.demo-note id="quick-settings-kept">{json.stringify(kept | map((r) => `${r.id}${r.on ? "+" : "-"}${r.value ?? ""}`))}</p>
        <div.demo-row>
            <Button id="quick-settings-remake" size="lg" variant="soft" on_click={() => { again += 1 }}>Make it again from what was kept</Button>
            <Button id="quick-settings-stir" size="lg" variant="soft" on_click={() => { stir += 1 }}>A label changes</Button>
        </div>
        <div id="quick-settings-stored"><QuickSettingsGrid label="Kept on this device" store="demo-qset" tiles={[{ id: "one", label: "One" }, { id: "two", label: "Two" }]}/></div>
        <div id="quick-settings-bad"><QuickSettingsGrid label="Bad data" tiles={[null, "x", { id: 1 }, { id: 2, label: "Twin" }, { id: 2, label: "Twin again" }, { label: "No id", options: "many" }]} saved={[null, { id: "gone", on: true }]}/></div>
    </div>
}

view QuickSettingsGridDemo() = <QuickSettingsGridDemoLive/>

ui_gallery = ui_gallery | push({ slug: "quick_settings_grid", name: "QuickSettingsGrid", group: "Mobile",
    summary: "Settings as big tiles: tap to turn, long press for details, kept as data, and a way to put them in another order.",
    tags: ["mobile", "interactive", "settings", "gesture", "toggle", "tablet"],
    needs: ["icon"],
    demo: QuickSettingsGridDemo })
