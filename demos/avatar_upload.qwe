let avatar_upload_demo_pic = `data:image/svg+xml,${url_encode(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><rect width="100" height="100" fill="#5b4bdb"/><circle cx="50" cy="38" r="16" fill="#fff"/><path d="M18 92c4-20 18-30 32-30s28 10 32 30z" fill="#fff"/></svg>`)}`

component AvatarUploadDemoLive() {
    state file = null
    <div.demo-stack>
        <AvatarUpload name="au-demo-logo" label="Logo" shape="square" size={80} initials="Q" max_size={200000}
                      hint="A PNG or SVG up to 200 KB." on_change={(f) => { file = f }}/>
        <p.demo-note>{file == null ? "No file picked." : `Picked ${file.name} (${file.type}).`}</p>
    </div>
}

view AvatarUploadDemo() {
    <div.demo-stack>
        <AvatarUpload name="au-demo-photo" src={avatar_upload_demo_pic} initials="AL" hint="JPEG or PNG, up to 2 MB." max_size={2097152}/>
        <AvatarUploadDemoLive/>
        <div.demo-row>
            <AvatarUpload name="au-demo-new" label="Photo" initials="MK" size={64} required={true} error="Add a photo to go on."/>
            <AvatarUpload name="au-demo-off" label="Photo" size={64} disabled={true}/>
        </div>
    </div>
}

ui_gallery = ui_gallery | push({ slug: "avatar_upload", name: "AvatarUpload", group: "Forms",
    summary: "A round picture with Change and Remove, showing the picture picked before it is sent, on a real file input.",
    tags: ["forms", "upload", "file", "image", "user", "interactive"], demo: AvatarUploadDemo })
