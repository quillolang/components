let app_shell_demo_nav = [{ label: "Overview", href: "/", icon: "◎" }, { label: "Projects", href: "#app_shell", icon: "▤" },
                          { label: "Team", href: "#team", icon: "☺" }, { label: "Billing", href: "#billing", icon: "▭" }]

view AppShellDemoPage() =
    <div>
        <h2 style="margin: 0 0 6px; font-size: 20px">Overview</h2>
        <p style="margin: 0; color: var(--ui-muted)">The page goes here. The sidebar stays put as it scrolls.</p>
        {for i in range(1, 6) => <p>Paragraph {i} of the page, to give it some length.</p>}
    </div>

view AppShellDemo() =
    <div.demo-stack>
        <div style="--ui-shell-height: 340px; height: 340px; overflow: auto; border: 1px solid var(--ui-border); border-radius: var(--ui-radius); transform: translateZ(0)">
            <AppShell id="app-shell-demo" brand="Acme" nav={app_shell_demo_nav} current="/"
                      header={[<b>Overview</b>, <Button size="sm" variant="outline">Invite</Button>]}>
                <AppShellDemoPage/>
            </AppShell>
        </div>
        <p.demo-note>When it is narrow, the sidebar becomes a drawer, opened by the menu button:</p>
        <div style="--ui-shell-height: 340px; width: min(380px, 100%); height: 340px; overflow: auto; border: 1px solid var(--ui-border); border-radius: var(--ui-radius); transform: translateZ(0)">
            <AppShell id="app-shell-demo-narrow" brand="Acme" nav={app_shell_demo_nav} current="/"
                      header={[<b>Overview</b>, <Button size="sm" variant="outline">Invite</Button>]}>
                <AppShellDemoPage/>
            </AppShell>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "app_shell", name: "AppShell", group: "Layout",
    summary: "An app's frame: a sidebar of links, a top bar and the page; the sidebar is a drawer on phones.",
    tags: ["layout", "page", "navigation", "no-js"],
    demo: AppShellDemo })
