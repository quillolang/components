let pull_down_menu_demo_css = css`
.pull-down-menu-demo-title { margin: 0; font-size: 19px; font-weight: 700; }
.pull-down-menu-demo-list { margin: 0; padding: 0 16px; list-style: none; }
.pull-down-menu-demo-list li { padding: 14px 0; border-bottom: 1px solid var(--ui-border); }
`

component PullDownMenuDemoLive() {
    style global pull_down_menu_demo_css
    state did = "nothing yet"
    state opens = 0
    state closes = 0
    <div.demo-stack>
        <div.demo-tablet>
            <PullDownMenu label="Inbox actions" on_pick={(v) => { did = v }} on_open={() => { opens += 1 }} on_close={() => { closes += 1 }}
                          items={[{ label: "New message", value: "new" }, { label: "Mark all as read", value: "read" },
                                  { label: "Filter by sender", value: "filter", disabled: true }, "Settings",
                                  { label: "Empty trash", value: "trash", destructive: true }]}>
                <p class="pull-down-menu-demo-title">Inbox</p>
            </PullDownMenu>
            <ul.pull-down-menu-demo-list>
                {for s in ["Ana Ruiz: lunch at one?", "Team review at three", "Your parcel is 3 stops away", "Invoice 2041 is paid", "Tom sent 4 photos"] => <li key={s}>{s}</li>}
            </ul>
        </div>
        <p.demo-note>Pull down on the header, slide to an item and let go. Chosen: <span class="pull-down-menu-demo-did">{did}</span>. Stayed open <span class="pull-down-menu-demo-opens">{opens}</span> times, closed <span class="pull-down-menu-demo-closes">{closes}</span> times.</p>
    </div>
}

view PullDownMenuDemo() = <PullDownMenuDemoLive/>

ui_gallery = ui_gallery | push({ slug: "pull_down_menu", name: "PullDownMenu", group: "Mobile",
    summary: "A menu pulled out of a header by a finger, chosen by sliding to an item and letting go, or by its button; on a tablet, a small menu at the end of the header.",
    tags: ["mobile", "interactive", "tablet", "menu", "gesture"],
    needs: ["action_sheet", "bottom_sheet"], demo: PullDownMenuDemo })
