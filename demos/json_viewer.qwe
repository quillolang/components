let json_viewer_demo_order = {
    id: "ord_8f2k1",
    status: "paid",
    total: 149.9,
    currency: "EUR",
    paid: true,
    coupon: null,
    customer: { name: "Ada Lovelace", email: "ada@example.com", "loyalty tier": "gold" },
    items: [
        { sku: "KB-01", name: "Mechanical keyboard", qty: 1, price: 119.9 },
        { sku: "CB-USB", name: "USB-C cable", qty: 2, price: 15 },
    ],
    tags: [],
    shipping: { method: "express", address: { city: "London", zip: "NW1 6XE", lines: ["12 Baker St", "Flat 2"] } },
}

view JsonViewerDemo() =
    <div.demo-stack>
        <JsonViewer id="jv-order" label="Order" value={json_viewer_demo_order} expanded={1} root="order"/>
        <JsonViewer id="jv-list" label="Feature flags" value={[{ flag: "new-editor", on: true, rollout: 0.25 }, { flag: "dark-mode", on: false, rollout: 0 }]}
                    expanded={2} max_height="220px"/>
    </div>

ui_gallery = ui_gallery | push({ slug: "json_viewer", name: "JsonViewer", group: "Data",
    summary: "A map or list as collapsible JSON, coloured by type, with sizes, expand all and the path of any value.",
    tags: ["data", "json", "tree", "developer", "interactive"], demo: JsonViewerDemo })
