let scan_count_demo_items = [
    { code: "4006381333931", name: "Marker pen, black", expected: 3 },
    { code: "5901234123457", name: "Notebook, A5", expected: 12 },
    { code: "0012345678905", name: "Sticky notes", expected: 2 },
    { code: "SKU-1042", name: "Packing tape, 50 m", expected: 1 },
    { code: "constructor", name: "A code that is also a JavaScript word", expected: 1 },
]

component ScanCountDemoLive() {
    state said = "Nothing sent yet."
    state refuse = false
    state blind_said = ""
    <div.demo-stack>
        <ScanCount title="Aisle 4, bay 12" items={scan_count_demo_items} store="demo"
                   on_finish={(c) => {
                       if refuse {
                           said = "The server refused."
                           return false
                       }
                       said = `Sent ${c.counted} counted, ${c.short} short, ${c.over} over, ${c.scans} scans.`
                       true
                   }}/>
        <button.demo-toggle type="button" id="scanct-demo-refuse" style="min-height:44px" @click={() => { refuse = !refuse }}>{refuse ? "The server refuses" : "The server takes it"}</button>
        <p.demo-note id="scanct-demo-said">{said}</p>
        <h4>A blind count on a device with its own scanner</h4>
        <ScanCount title="Cage 2" id="scanct-blind" blind={true} wedge={true} use_camera={false} items={[{ code: "ABC-1", name: "Drill", expected: 5 }]}
                   on_finish={(c) => { blind_said = `${c.lines[0].name}: ${c.lines[0].diff}` }}/>
        <p.demo-note id="scanct-demo-blind">{blind_said}</p>
    </div>
}

view ScanCountDemo() = <ScanCountDemoLive/>

ui_gallery = ui_gallery | push({ slug: "scan_count", name: "ScanCount", group: "Mobile",
    summary: "Count stock by scanning: expected against counted, overs and unders, undo, works with no connection, by camera, photo, keyboard or a device's own scanner.",
    tags: ["mobile", "interactive", "barcode", "stock", "offline", "tablet"],
    demo: ScanCountDemo })
