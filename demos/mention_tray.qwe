let mention_tray_demo_people = [
    { id: 1, name: "Ana Silva", handle: "ana" }, { id: 2, name: "Andrei Pop", handle: "andrei" }, { id: 3, name: "Joan Hart", handle: "joan" },
    { id: 4, name: "Ben Oduya", handle: "benny" }, { id: 5, name: "Cleo Marsh" }, { id: 6, name: "Hanna Lee", handle: "hl" },
    { id: "bad" }, { name: "No id" }, "not a person"
]

component MentionTrayDemoLive() {
    state seen = "Nothing yet."
    <div.demo-phone id="mention-tray-demo" style="height: 420px; display: flex; flex-direction: column; justify-content: flex-end; padding: 8px; box-sizing: border-box">
        <p.demo-note id="mention-tray-note" style="flex: 1">{seen}</p>
        <MentionTray id="mention-tray-live" label="Message the crew" placeholder="Type @ to mention someone" people={mention_tray_demo_people}
                     on_change={(t, ms) => { seen = `${t} | ${join(ms | map((m) => `${m.id}:${m.start}-${m.end}`), ",")}` }}/>
    </div>
}

view MentionTrayDemo() = <MentionTrayDemoLive/>

ui_gallery = ui_gallery | push({ slug: "mention_tray", name: "MentionTray", group: "Mobile",
    summary: "Typing @ opens a tray of people above the keyboard, fuzzy-ranked and placed at the cursor, and the name goes in as one thing.",
    tags: ["mobile", "interactive", "mention", "keyboard", "chat", "fuzzy"], needs: ["composer_bar", "fuzzy_select"], demo: MentionTrayDemo })
