let csv_table_demo_prices = "sku,name,price,stock,note
A-100,\"Bolt, M6 x 20\",0.12,\"12,400\",
A-101,Nut M6,0.08,9800,\"Sold in bags of 100\"
B-220,\"Washer \"\"wide\"\"\",0.05,15000,
C-310,Bracket,2.40,-3,\"Back-ordered;
ships in May\"
"

let csv_table_demo_tsv = for i in range(0, 14) => `${2013 + i}\t${["Lisbon", "Porto", "Braga"][i % 3]}\t${1200 + i * 37}`

view CsvTableDemo() =
    <div.demo-stack>
        <CsvTable id="csv-table-demo-prices" caption="Price list (prices.csv)" text={csv_table_demo_prices}/>
        <CsvTable id="csv-table-demo-tsv" label="Visitors by year" delimiter={"\t"} header={false} limit={5} zebra={true}
                  text={join(csv_table_demo_tsv, "\n")}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "csv_table", name: "CsvTable", group: "Data",
    summary: "A table made from CSV text, with quoted fields, a header row, numbers lined up on the right and a row limit.",
    tags: ["data", "table", "file", "no-js"], demo: CsvTableDemo })
