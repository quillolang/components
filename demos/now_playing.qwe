// Fourteen silent seconds, small enough to sit in the page.
let now_playing_demo_src = "data:audio/mp4;base64,"

fn now_playing_demo_art(fill: str, word: str) =
    "data:image/svg+xml," + url_encode(`<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 300 300'><rect width='300' height='300' fill='${fill}'/><circle cx='150' cy='150' r='96' fill='#ffffff33'/><text x='150' y='162' font-size='34' text-anchor='middle' fill='#fff' font-family='sans-serif'>${word}</text></svg>`)

let now_playing_demo_queue = [
    { id: 1, title: "Harbour Lights", artist: "The Low Tides", album: "Salt", art: now_playing_demo_art("#3d5a80", "Salt"), src: now_playing_demo_src },
    { id: 2, title: "Night Ferry", artist: "The Low Tides", album: "Salt", art: now_playing_demo_art("#ee6c4d", "Ferry"), src: now_playing_demo_src },
    { id: 3, title: "A Long Way Round", artist: "Ada Reyes", album: "Inland", src: now_playing_demo_src },
    { id: 4, title: "Static", artist: "Ada Reyes", album: "Inland", art: now_playing_demo_art("#293241", "Inland"), src: "data:audio/mp4;base64,AAAA" },
]

component NowPlayingDemoLive() {
    state turn = 0
    state info = "nothing yet"
    state ended = 0
    state closed = 0
    state tracks = now_playing_demo_queue
    <div.demo-stack>
        <div.demo-phone style="--ui-nowp-height: 100%">
            <NowPlaying key={turn} id="nowp-demo" queue={tracks}
                        on_change={(s) => { info = `${s.index} ${s.track.title} ${s.playing ? "playing" : "paused"} at ${s.speed}` }}
                        on_end={() => { ended += 1 }} on_close={() => { closed += 1 }}/>
        </div>
        <p.demo-note id="nowp-demo-note">{info}; ended {ended}; closed {closed}</p>
        <div.demo-row>
            <Button id="nowp-demo-again" variant="ghost" size="lg" on_click={() => { turn += 1 }}>Make it again</Button>
            <Button id="nowp-demo-swap" variant="ghost" size="lg" on_click={() => { tracks = [now_playing_demo_queue[1], now_playing_demo_queue[2]] }}>Other queue</Button>
        </div>
        <div id="nowp-demo-none" style="--ui-nowp-height: 420px"><NowPlaying id="nowp-demo-empty" queue={null} sleep={false} speeds={[1]}/></div>
    </div>
}

view NowPlayingDemo() = <NowPlayingDemoLive/>

ui_gallery = ui_gallery | push({ slug: "now_playing", name: "NowPlaying", group: "Mobile",
    summary: "A full player with art, scrub, queue, speed and a sleep timer, tied to the media session.",
    tags: ["mobile", "interactive", "media", "player", "audio", "tablet"],
    needs: ["scrub_bar", "sleep_timer_sheet"],
    demo: NowPlayingDemo })
