component ForceUpdateDemoLive() {
    state current = "1.9.9"
    state minimum = "1.10.0"
    state latest = "1.12.3"
    state run = 0
    state full = false
    state later = 0
    <div.demo-stack>
        <div.demo-phone style="height: 420px" id="force-update-demo-frame">
            <div style="padding: 24px"><p class="demo-note">The app itself, behind the screen. Later: {later}.</p></div>
            <ForceUpdate key={run} current={current} minimum={minimum} latest={latest} app_name="Fieldbook" modal={false} remember="ui-demo-update"
                ios="https://apps.apple.com/app/id1234567890" android="https://play.google.com/store/apps/details?id=org.quillolang.fieldbook"
                web="https://quillolang.org/download" notes={["Faster sync", "A crash on opening a photo is gone"]}
                on_later={() => { later = later + 1 }}/>
        </div>
        <div.demo-row>
            <label>You have <input id="force-update-demo-current" style="height: 44px; width: 100px; font: inherit" bind:value={current}/></label>
            <label>Least <input id="force-update-demo-minimum" style="height: 44px; width: 100px; font: inherit" bind:value={minimum}/></label>
            <label>Latest <input id="force-update-demo-latest" style="height: 44px; width: 100px; font: inherit" bind:value={latest}/></label>
        </div>
        <div.demo-row>
            <Button size="lg" variant="outline" id="force-update-demo-again" on_click={() => { run = run + 1 }}>Start the app again</Button>
            <Button size="lg" variant="ghost" id="force-update-demo-full" on_click={() => { full = true }}>Show it filling the window</Button>
        </div>
        {full && <ForceUpdate id="force-update-full" current="1.0" minimum="2.0" latest="2.0" app_name="Fieldbook"
                               ios="itms-apps://apps.apple.com/app/id1" android="market://details?id=org.quillolang.fieldbook"/>}
        <button hidden="hidden" id="force-update-demo-end" type="button" @click={() => { full = false }}>End</button>
    </div>
}

view ForceUpdateDemo() = <ForceUpdateDemoLive/>

ui_gallery = ui_gallery | push({ slug: "force_update", name: "ForceUpdate", group: "Mobile",
    summary: "Compares versions as numbers, shows a soft or a hard update screen, and the store's link by platform.",
    tags: ["mobile", "interactive", "tablet", "update", "version", "store"],
    needs: ["welcome_carousel"],
    demo: ForceUpdateDemo })
