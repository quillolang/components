let mega_menu_demo_items = [
    { label: "Products", columns: [
        { title: "Build", links: [
            { label: "Editor", href: "#editor", description: "Write, check and preview as you type.", icon: "M4 20h4L18.5 9.5a2.1 2.1 0 0 0-3-3L5 17z" },
            { label: "Components", href: "#mega_menu", description: "A kit of views and components.", icon: "M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z" },
            { label: "CLI", href: "#cli", description: "Run, check, test and deploy.", icon: "M4 17l6-5-6-5M12 19h8" }
        ] },
        { title: "Run", links: [
            { label: "Hosting", href: "#hosting", description: "One command to a URL." },
            { label: "Databases", href: "#db", description: "SQLite, Postgres, MySQL." },
            { label: "Live data", href: "#live", description: "Pages that follow the server." }
        ] }
    ], featured: { title: "What's new in 0.5", text: "Styles that travel with each component, and a faster check.", href: "#new", cta: "Read the notes →" } },
    { label: "Resources", columns: [
        { title: "Learn", links: [{ label: "Docs", href: "#docs" }, { label: "Guides", href: "#guides" }, { label: "Examples", href: "#examples" }] },
        { title: "Community", links: [{ label: "Forum", href: "#forum" }, { label: "Discord", href: "#discord" }] }
    ] },
    { label: "Pricing", href: "#pricing" },
    { label: "Blog", href: "#blog" }
]

view MegaMenuDemo() =
    <div.demo-stack>
        <div style="position: relative; height: 340px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius); overflow: hidden">
            <MegaMenu id="mega-menu-demo" brand="Acme" items={mega_menu_demo_items} current="#mega_menu">
                <Button size="sm" variant="ghost" href="#mega_menu">Sign in</Button>
                <Button size="sm" href="#mega_menu">Start free</Button>
            </MegaMenu>
            <p.demo-note style="padding: 16px 20px">Hover Products or Resources, or Tab to them: the panel opens under the whole bar.</p>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "mega_menu", name: "MegaMenu", group: "Navigation",
    summary: "A top bar whose items open wide panels of grouped links under the whole bar, on hover and from the keyboard, with no script.",
    tags: ["navigation", "menu", "link", "marketing", "no-js"], demo: MegaMenuDemo })
