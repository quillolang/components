let order_history_demo_orders = [
    { id: "10482", date: "2026-10-20", status: "shipped", total: 113, href: "#order_history", tracking_href: "#order_tracker",
      items: [{ name: "Trail runner", quantity: 1, price: 89, image: "https://picsum.photos/seed/runner/80/80", options: ["Size 42", "Black"] },
              { name: "Wool beanie", quantity: 1, price: 24, image: "https://picsum.photos/seed/beanie/80/80" }] },
    { id: "10477", date: "2026-10-12", status: "delivered", total: 97.5, href: "#order_history",
      items: [{ name: "Insulated bottle, 750 ml", quantity: 3, price: 32.5, image: "https://picsum.photos/seed/bottle/80/80" }] },
    { id: "10391", date: "2026-09-02", status: "refunded", total: 149, href: "#order_history", note: "Refunded to your card on 9 Sep.",
      items: [{ name: "Rain jacket", quantity: 1, price: 149 }] },
    { id: "10120", date: "2026-07-15", status: "cancelled", total: 2400, currency: "JPY",
      items: [{ name: "Merino socks, 3 pairs", quantity: 1, price: 2400 }] },
]

view OrderHistoryDemo() =
    <div.demo-stack>
        <OrderHistory orders={order_history_demo_orders} open={0}/>
        <OrderHistory orders={[]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "order_history", name: "OrderHistory", group: "Commerce",
    summary: "Past orders with number, date, status and total, each opening on <details> to show its items and links.",
    tags: ["commerce", "list", "record", "status", "no-js"],
    needs: ["price"], demo: OrderHistoryDemo })
