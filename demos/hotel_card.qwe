view HotelCardDemo() =
    <div.demo-stack>
        <HotelCard id="hotel-card-demo-alfama" name="Casa do Alfama" kind="Hotel" stars={4} score={8.7} reviews={1284} location="Alfama, Lisbon"
                   distance="0.8 km from the centre" image="https://picsum.photos/seed/alfama/480/360" badge="Deal" price={129.00m} old={152.00m}
                   nights={4} taxes={41.28m} amenities={["Free WiFi", "Breakfast included", "Air conditioning", "Rooftop terrace"]}
                   cancellation="Free cancellation until 3 Nov" prepay="No prepayment needed" rooms_left={2} href="#casa-do-alfama"/>
        <div class="demo-row" style="align-items: start">
            <HotelCard id="hotel-card-demo-flat" layout="column" name="Riverside flat" kind="Apartment" score={9.6} reviews={1}
                       location="Porto, Ribeira" image="https://picsum.photos/seed/ribeira/480/300" price={95} currency="EUR" locale="de-DE"
                       nights={3} price_note="Includes taxes and fees" amenities={["Kitchen", "Washing machine"]}/>
            <HotelCard id="hotel-card-demo-plain" layout="column" name="Harbour Inn" stars={2} score={6.4} score_label="Fair" price={74.50m}
                       location="Dover" price_note="+ $9.20 taxes and fees" rooms_left={8}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "hotel_card", name: "HotelCard", group: "Travel",
    summary: "A hotel in search results: photo, stars, the review score badge, location, amenities, cancellation terms and the price a night with the stay's total.",
    tags: ["travel", "hotels", "card", "commerce", "no-js"], demo: HotelCardDemo })
