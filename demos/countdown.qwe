component CountdownDemoLive() {
    state run = 0
    state done = 0
    <div.demo-row>
        {run > 0
            ? <Countdown key={run} seconds={3} variant="inline" label="Launching in" ended="Launched"
                         on_end={() => { done += 1 }}/>
            : <span.demo-note>A three-second countdown, inside a component.</span>}
        <button type="button" @click={() => { run += 1 }}>{run > 0 ? "Again" : "Start"}</button>
        {done > 0 && <span.demo-note>on_end called {done} {done == 1 ? "time" : "times"}</span>}
    </div>
}

view CountdownDemo() =
    <div.demo-stack>
        <Countdown to="2027-01-01T00:00:00Z" label="New Year (UTC) in"/>
        <div.demo-row style="gap: 28px">
            <Countdown seconds={5400} label="Sale ends in" size="sm"/>
            <Countdown seconds={600} variant="inline" label="Your seat is held for" ended="Seat released"/>
        </div>
        <Countdown to="2026-01-01T09:00:00+01:00" label="Early-bird tickets" ended="Early-bird sale has ended"/>
        <CountdownDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "countdown", name: "Countdown", group: "Feedback",
    summary: "Days, hours, minutes and seconds left until a date-time, ticking in the browser, then an ended message.",
    tags: ["time", "clock", "interactive"],
    demo: CountdownDemo })
