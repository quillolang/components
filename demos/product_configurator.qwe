let product_configurator_demo_groups = [
    { id: "cpu", label: "Processor", required: true, options: [
        { id: "i5", label: "Core i5" },
        { id: "i7", label: "Core i7", price: "300" },
        { id: "i9", label: "Core i9", price: "600" }] },
    { id: "memory", label: "Memory", required: true, options: [
        { id: "m8", label: "8 GB" },
        { id: "m16", label: "16 GB", price: "100" },
        { id: "m32", label: "32 GB", price: "299.99" }] },
    { id: "keyboard", label: "Keyboard", required: true, options: [
        { id: "uk", label: "UK" },
        { id: "us", label: "US" }] },
    { id: "gfx", label: "Graphics", options: [
        { id: "rtx", label: "Discrete graphics", price: "250.50", requires: [["i7", "i9"]], excludes: ["slim"] }] },
    { id: "extras", label: "Extras", multiple: true, most: 2, options: [
        { id: "slim", label: "Slim chassis", price: "120" },
        { id: "dock", label: "Graphics dock", price: "150", requires: ["rtx"] },
        { id: "care", label: "Care pack", price: "89.90" },
        { id: "lte", label: "4G modem", price: "110", requires: [["m16", "m32"]] }] }]

component ProductConfiguratorDemoLive() {
    state seen = null
    <div.demo-stack>
        <ProductConfigurator id="product-configurator-demo-live" title="Stand-up desk" name="desk" currency="EUR" base_price="349.00" selected={["small", "ghost"]}
                             groups={[{ id: "top", label: "Top", required: true, options: [
                                          { id: "small", label: "120 cm" }, { id: "big", label: "160 cm", price: "80" }] },
                                      { id: "legs", label: "Legs", multiple: true, least: 1, options: [
                                          { id: "steel", label: "Steel", excludes: ["oak"] }, { id: "oak", label: "Oak", price: "60.50" }] }]}
                             on_change={(f) => { seen = f }}/>
        <p.demo-note>{seen == null ? "Change a choice to see on_change." : `on_change: ${join(seen.selected, ", ")}, ${seen.total}, ${seen.valid ? "valid" : "not valid"}.`}</p>
    </div>
}

view ProductConfiguratorDemo() =
    <div.demo-stack>
        <ProductConfigurator id="product-configurator-demo" title="Build your laptop" base_price="999.00" selected={["rtx", "m16", "i7"]} groups={product_configurator_demo_groups}/>
        <ProductConfiguratorDemoLive/>
        <ProductConfigurator id="product-configurator-demo-bad" title="A catalogue with mistakes" base_price="soon" currency="XXZ" groups={[
            { id: "a", label: "Finish", options: [
                { id: "matt", label: "Matt", requires: ["gloss"] }, { id: "gloss", label: "Gloss", requires: ["matt"] },
                { id: "plain", label: "Plain", price: "free", excludes: ["nothing"] }, { id: "plain", label: "Plain again" },
                { id: "wax", label: "Wax", requires: ["nothing"] }] },
            { id: "b", label: "Trim", required: true, options: [{ id: "t", label: "Teak", requires: ["matt"] }] },
            "not a group"]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "product_configurator", name: "ProductConfigurator", group: "Commerce",
    summary: "Builds a product from option groups with requires and excludes rules: clashes disabled with the reason, what a change dropped explained, a live price and what is missing.",
    tags: ["smart", "interactive", "commerce", "configurator", "options", "pricing"], demo: ProductConfiguratorDemo })
