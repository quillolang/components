view GanttChartDemo() =
    <div.demo-stack>
        <GanttChart label="Website relaunch" show_label={true} today="2026-03-25"
                    tasks={[{ label: "Kick-off", start: "2026-03-02", milestone: true },
                            { label: "Research", start: "2026-03-02", end: "2026-03-11", progress: 100, group: "Design" },
                            { label: "Wireframes", start: "2026-03-09", end: "2026-03-20", progress: 100, group: "Design" },
                            { label: "Visual design", start: "2026-03-18", end: "2026-04-03", progress: 60, group: "Design" },
                            { label: "Front end", start: "2026-03-23", end: "2026-04-17", progress: 25, group: "Build" },
                            { label: "Back end", start: "2026-03-16", end: "2026-04-10", progress: 40, group: "Build" },
                            { label: "Testing", start: "2026-04-13", end: "2026-04-24", progress: 0, group: "Build" },
                            { label: "Launch", start: "2026-04-27", milestone: true, group: "Build" }]}/>
        <GanttChart label="Year plan" show_label={true} row={28}
                    tasks={[{ label: "Hiring", start: "2026-01-12", end: "2026-04-30", progress: 70 },
                            { label: "New office", start: "2026-03-01", end: "2026-06-15", progress: 20 },
                            { label: "Version 2", start: "2026-05-04", end: "2026-09-25" }]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "gantt_chart", name: "GanttChart", group: "Charts",
    summary: "Tasks as bars over dates, filled by progress, in groups with spanning bars, with milestones and a today line.",
    tags: ["chart", "data", "schedule", "calendar", "no-js"],
    demo: GanttChartDemo })
