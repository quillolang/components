view SkeletonDemo() =
    <div.demo-stack>
        <div.demo-row>
            <Skeleton shape="circle" width="48px"/>
            <div style="flex: 1; min-width: 200px"><Skeleton lines={3}/></div>
        </div>
        <div.demo-row>
            <Skeleton shape="rect" width="120px" height="80px"/>
            <Skeleton shape="rect" width="120px" height="80px"/>
            <Skeleton shape="text" width="160px"/>
        </div>
        <div.demo-narrow><SkeletonCard/></div>
    </div>

ui_gallery = ui_gallery | push({ slug: "skeleton", name: "Skeleton", group: "Feedback",
    summary: "Grey shapes where content will be while it loads: text lines, boxes, circles, and a card.",
    demo: SkeletonDemo })
