let line_chart_demo_days = for i in range(14) => `Oct ${i + 15}`

view LineChartDemo() =
    <div.demo-stack>
        <LineChart label="Visitors per day" labels={line_chart_demo_days} area={true}
                   values={[820, 932, 901, 1034, 1290, 1102, 980, 1130, 1245, 1198, 1402, 1530, 1288, 1615]}/>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 32px 40px">
            <LineChart label="Response time" show_label={true} labels={["00:00", "04:00", "08:00", "12:00", "16:00", "20:00"]}
                       suffix=" ms" points={true} height={180}
                       series={[{ name: "p50", values: [118, 112, 131, 146, 139, 124] },
                                { name: "p95", values: [310, 288, 362, 421, 398, 334] },
                                { name: "p99", values: [540, 502, 690, 812, 760, 610] }]}/>
            <LineChart label="Monthly revenue" show_label={true} labels={["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul"]} prefix="$"
                       zero={true} height={180}
                       series={[{ name: "2025", values: [41200, 39800, 44500, 47100, 46200, 50300, 52800] },
                                { name: "2026", values: [48900, 51200, 55800, null, 60400, 63100, 66900] }]}/>
        </div>
        <p.demo-note>April 2026 is missing, so its line has a gap.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "line_chart", name: "LineChart", group: "Charts",
    summary: "Lines for one or more series over the same labels, with an area fill or points, a hover crosshair with every value, and a legend.",
    tags: ["chart", "data", "no-js"],
    demo: LineChartDemo })
