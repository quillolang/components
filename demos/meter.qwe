view MeterDemo() =
    <div.demo-stack.demo-narrow>
        <Meter label="Disk used" value={72} unit=" GB" high={80} optimum={0}/>
        <Meter label="Disk used" value={91} unit=" GB" low={60} high={80} optimum={0}/>
        <Meter label="Battery" value={18} unit="%" low={20} high={60} optimum={100}/>
        <Meter label="Room temperature" value={21.5} unit=" °C" min={10} max={35} low={18} high={24} optimum={21}/>
        <Meter label="Password strength" value={3} max={4} segments={4} value_text="Good" low={2} optimum={4}/>
        <Meter label="Seats taken" value={7} max={10} value_text="7 of 10" tone="info" size="sm"/>
    </div>

ui_gallery = ui_gallery | push({ slug: "meter", name: "Meter", group: "Feedback",
    summary: "A measurement within a range, coloured green, amber or red by whether it is where it should be, as segments or one bar.",
    demo: MeterDemo })
