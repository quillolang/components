view SidebarLayoutDemoBox(label: str, tall: bool = false) =
    <div style={`padding: 16px; min-height: ${tall ? "180px" : "auto"}; border: 1px solid var(--ui-border); border-radius: var(--ui-radius-sm); background: var(--ui-subtle); font-size: 13px`}>{label}</div>

view SidebarLayoutDemo() =
    <div.demo-stack>
        <SidebarLayout class="sidebar-layout-demo-left" width="240px" sidebar={<SidebarLayoutDemoBox label="Filters (240px, left)"/>}>
            <SidebarLayoutDemoBox label="The content takes the rest." tall={true}/>
        </SidebarLayout>
        <SidebarLayout class="sidebar-layout-demo-right" side="right" width="200px" gap="lg"
                       sidebar={<SidebarLayoutDemoBox label="On this page (200px, right)"/>}>
            <SidebarLayoutDemoBox label="An article beside its table of contents." tall={true}/>
        </SidebarLayout>
        <p.demo-note>In a 400px-wide box, the sidebar goes under the content:</p>
        <div style="width: 400px; max-width: 100%">
            <SidebarLayout class="sidebar-layout-demo-narrow" sidebar={<SidebarLayoutDemoBox label="Sidebar, now below"/>}>
                <SidebarLayoutDemoBox label="Content first"/>
            </SidebarLayout>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "sidebar_layout", name: "SidebarLayout", group: "Layout",
    summary: "Content beside a sidebar, left or right, that goes under the content where its box is narrow.",
    tags: ["layout", "page", "navigation", "no-js"], demo: SidebarLayoutDemo })
