component CheckboxCardsDemoLive() {
    state picked = ["email"]
    <div.demo-stack>
        <CheckboxCards name="cc-demo-notify" label="Notify me by" values={picked} columns={3} size="sm"
                       options={[{ label: "Email", value: "email", icon: "✉️" }, { label: "Text message", value: "sms", icon: "💬" },
                                 { label: "Push", value: "push", icon: "🔔" }]}
                       on_change={(v, on) => { picked = on ? picked + [v] : picked | filter((x) => x != v) }}/>
        <p.demo-note>{len(picked) == 0 ? "No channel picked." : `Notifying by ${join(picked, ", ")}.`}</p>
    </div>
}

view CheckboxCardsDemo() =
    <div.demo-stack>
        <CheckboxCards name="cc-demo-addons" label="Add-ons" values={["backups"]} hint="Billed monthly with the plan."
                       options={[{ label: "Backups", value: "backups", description: "Daily, kept for 30 days.", meta: "$5" },
                                 { label: "Monitoring", value: "monitoring", description: "Alerts by email when a check fails.", meta: "$3" },
                                 { label: "Priority support", value: "support", description: "Sold out this month.", meta: "$20", disabled: true }]}/>
        <CheckboxCardsDemoLive/>
        <CheckboxCards name="cc-demo-days" label="Open on" columns={1} required={true} error="Pick at least one day."
                       options={["Saturday", "Sunday"]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "checkbox_cards", name: "CheckboxCards", group: "Forms",
    summary: "Any number of choices as cards with a title, a line of detail and a check, each a real checkbox a form sends.",
    tags: ["forms", "input", "card", "select", "no-js"], demo: CheckboxCardsDemo })
