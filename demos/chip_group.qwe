let chip_group_demo_recipes = [
    { name: "Shakshuka", tags: ["vegetarian", "quick"] },
    { name: "Lentil soup", tags: ["vegan", "vegetarian"] },
    { name: "Fish tacos", tags: ["quick"] },
    { name: "Mushroom risotto", tags: ["vegetarian"] },
    { name: "Chickpea curry", tags: ["vegan", "vegetarian", "quick"] }
]

component ChipGroupDemoLive() {
    state diets = []
    let shown = chip_group_demo_recipes | filter((r) => diets | all((d) => contains(r.tags, d)))
    <div.demo-stack>
        <ChipGroup name="chips-diet" label="Recipes that are" multiple={true} values={diets}
                   on_change={(v, on) => { diets = on ? diets | push(v) : diets | filter((d) => d != v) }}
                   options={[{ label: "Vegetarian", value: "vegetarian", count: 4 }, { label: "Vegan", value: "vegan", count: 2 },
                             { label: "Under 30 minutes", value: "quick", count: 3 }]}/>
        <p.demo-note>{len(shown)} {len(shown) == 1 ? "recipe" : "recipes"}: {join(shown | map((r) => r.name), ", ")}</p>
    </div>
}

view ChipGroupDemo() =
    <div.demo-stack>
        <ChipGroup name="chips-status" label="Status" value="open"
                   options={[{ label: "Open", value: "open", count: 12 }, { label: "In review", value: "review", count: 3 },
                             { label: "Closed", value: "closed", count: 40 }, { label: "Spam", value: "spam", count: 0, disabled: true }]}/>
        <ChipGroup name="chips-topic" label="Topics" multiple={true} values={["design", "frontend"]} size="sm"
                   options={["design", "frontend", "backend", "infrastructure", "docs", "accessibility"]}/>
        <ChipGroupDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "chip_group", name: "ChipGroup", group: "Forms",
    summary: "Chips to pick one or several of, like filters: real radios or checkboxes that a form sends, with counts.",
    demo: ChipGroupDemo })
