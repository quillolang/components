let data_saver_toggle_demo_full = "data:image/svg+xml," + url_encode("<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 160 90'><rect width='160' height='90' fill='#4b6cb7'/><circle cx='120' cy='30' r='14' fill='#ffd76a'/></svg>")
let data_saver_toggle_demo_lite = "data:image/svg+xml," + url_encode("<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 9'><rect width='16' height='9' fill='#9aa8c4'/></svg>")

component DataSaverToggleDemoLive() {
    state told = "Nothing reported yet."
    state more = 0
    <div.demo-stack>
        <DataSaverToggle id="dsave-demo" on_change={(on, mode) => { told = `on_change: ${on} ${mode}.` }}
                         changes={[{ label: "Pictures", off: "Full size", on: "Lighter versions" }, { label: "Video", off: "Plays by itself", on: "Waits for a press" }, { label: "Maps", off: "Loaded at once", on: "Loaded on a press" }]}/>
        <p.demo-note id="dsave-told">{told}</p>
        <div.demo-row>
            <img id="dsave-photo" src={data_saver_toggle_demo_full} srcset={`${data_saver_toggle_demo_full} 2x`} data-lite={data_saver_toggle_demo_lite} alt="The harbour at noon" width="160" height="90"/>
            {for i in range(more) => <img key={i} class="dsave-added" src={data_saver_toggle_demo_full} data-lite={data_saver_toggle_demo_lite} alt={`Added picture ${i}`} width="160" height="90"/>}
            <video id="dsave-clip" autoplay="true" muted="true" playsinline="true" width="160" height="90" aria-label="A clip"></video>
        </div>
        <div.demo-row><Button size="lg" variant="outline" id="dsave-more" on_click={() => { more += 1 }}>Add a picture</Button></div>
    </div>
}

view DataSaverToggleDemo() = <DataSaverToggleDemoLive/>

ui_gallery = ui_gallery | push({ slug: "data_saver_toggle", name: "DataSaverToggle", group: "Mobile",
    summary: "A setting to keep lighter images and off autoplay, following the phone's save-data, with what it changes.",
    tags: ["mobile", "interactive", "offline", "settings", "data", "tablet"],
    demo: DataSaverToggleDemo })
