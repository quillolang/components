view PagerDemo() =
    <div.demo-stack style="gap: 24px">
        <Pager prev={{ title: "Installing Quillo", href: "#pager-install", hint: "Chapter 1" }}
               next={{ title: "Your first program, with routes and views", href: "#pager-first", hint: "Chapter 3 · 12 min" }}/>
        <Pager next={{ title: "Getting started", href: "#pager-start" }} next_label="Start reading"/>
        <Pager prev={{ title: "Deploying", href: "#pager-deploy" }} prev_label="Back to"/>
    </div>

ui_gallery = ui_gallery | push({ slug: "pager", name: "Pager", group: "Navigation",
    summary: "Previous and next links with their titles, for the pages of an article, a book or docs.",
    tags: ["navigation", "link", "document", "no-js"], demo: PagerDemo })
