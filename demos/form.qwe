component FormDemoLive() {
    state sent = null
    <div.demo-stack>
        <Form id="form-demo-live" layout="inline" submit="Search" on_submit={(f) => { sent = f }}>
            <FormField label="Find" field="form-demo-live-q">
                <input id="form-demo-live-q" name="q" type="search" placeholder="A name"/>
            </FormField>
            <FormField label="In" field="form-demo-live-in">
                <select id="form-demo-live-in" name="in"><option>People</option><option>Projects</option></select>
            </FormField>
        </Form>
        <p.demo-note>{sent == null ? "Nothing sent yet." : `on_submit got ${json.stringify(sent)}.`}</p>
    </div>
}

view FormDemo() =
    <div.demo-stack>
        <Form id="form-demo-signup" action="/signup" submit="Create account" cancel_href="#form"
              errors={{ "form-demo-email": "Enter an email address such as ada@example.com.", "form-demo-terms": "Accept the terms to go on." }}>
            <FormField label="Name" field="form-demo-name">
                <input id="form-demo-name" name="name" type="text" autocomplete="name"/>
            </FormField>
            <FormField label="Email" field="form-demo-email" required={true} error="Enter an email address such as ada@example.com.">
                <input id="form-demo-email" name="email" type="email" value="ada@" aria-invalid="true" aria-describedby="form-demo-email-error"/>
            </FormField>
            <Checkbox name="terms" label="I accept the terms" field="form-demo-terms" error="Accept the terms to go on."/>
        </Form>
        <Form id="form-demo-grid" layout="grid" columns={2} action="/profile" submit="Save" actions_align="start"
              actions={<Button variant="ghost" tone="neutral" type="reset">Reset</Button>}>
            <TextField name="first" label="First name" field="form-demo-first"/>
            <TextField name="last" label="Last name" field="form-demo-last"/>
            <FormField label="Bio" field="form-demo-bio" full={true} optional={true}>
                <textarea id="form-demo-bio" name="bio" rows="3"></textarea>
            </FormField>
        </Form>
        <FormDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "form", name: "Form", group: "Forms",
    summary: "A plain <form method=\"post\"> laid out stacked, inline or in a grid, with a summary of what is wrong at the top and a submit row at the end.",
    tags: ["forms", "layout", "no-js"],
    needs: ["button"], demo: FormDemo })
