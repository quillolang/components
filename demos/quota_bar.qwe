let quota_bar_demo_items = [
    { label: "Storage", used: 38.2, allowed: 50, unit: " GB", note: "Files, backups and exports", href: "#quota_bar" },
    { label: "API calls", used: 92000, allowed: 100000, warn_at: 85, note: "Resets on the 1st" },
    { label: "Team members", used: 5, allowed: 5 },
    { label: "Email sends", used: 1200, allowed: 10000 },
    { label: "Projects", used: 3, allowed: null },
]

view QuotaBarDemo() =
    <div.demo-stack>
        <div.demo-narrow><QuotaBar id="quota-bar-demo" quotas={quota_bar_demo_items}/></div>
        <p.demo-note>Below, compact: one line each.</p>
        <QuotaBar compact={true} label="Plan limits" quotas={take(quota_bar_demo_items, 4)}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "quota_bar", name: "QuotaBar", group: "Dashboard",
    summary: "Several quotas in one list, each a bar with its numbers, amber near its limit and red at it.",
    tags: ["dashboard", "progress", "status", "list", "no-js"],
    demo: QuotaBarDemo })
