component DayViewDemoLive() {
    state opened = null
    <div.demo-stack>
        <DayView day="2026-11-04" now="14:20" on_open={(id) => { opened = id }} events={[
            { id: 1, title: "Stand-up", start: "09:00", end: "09:15" },
            { id: 2, title: "1:1 Ben", start: "10:00", end: "10:30", tone: "info" },
            { id: 3, title: "Planning", start: "10:00", end: "11:30", tone: "warning", place: "Room 2" },
            { id: 4, title: "Dentist", start: "11:00", end: "12:00", tone: "danger", place: "Rua Augusta 10" },
            { id: 5, title: "Design review", start: "2026-11-04T14:00", end: "2026-11-04T15:30", place: "Room 2", href: "#day_view" },
            { id: 6, title: "Gym", start: "17:30", tone: "success" },
            { id: 7, title: "Ana out", tone: "neutral" },
        ]}/>
        <p.demo-note>{opened == null ? "Press an event." : `Opened event ${opened}.`}</p>
    </div>
}

view DayViewDemo() =
    <div.demo-stack>
        <DayViewDemoLive/>
        <div.demo-narrow id="day-view-demo-empty">
            <DayView day="2026-11-07" from_hour={9} to_hour={12} hour_height={40} heading={false} label="Saturday" events={[]}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "day_view", name: "DayView", group: "Scheduling",
    summary: "One day as a column of hours with its events drawn at their times, side by side when they overlap, and all-day events above.",
    tags: ["schedule", "calendar", "time", "data", "no-js"], demo: DayViewDemo })
