component CoachOverlayDemoLive() {
    state run = 0
    state pressed = 0
    state said = "Not done yet."
    <div.demo-stack>
        <div.demo-phone id="coach-overlay-demo-frame">
            <div id="coach-overlay-demo-scroll" style="height: 100%; overflow: auto; padding: 16px; box-sizing: border-box">
                <div.demo-row style="justify-content: space-between">
                    <Button size="lg" id="coach-overlay-demo-add" on_click={() => { pressed = pressed + 1 }}>New note</Button>
                    <Button size="lg" variant="outline" id="coach-overlay-demo-search">Search</Button>
                </div>
                {for i in range(1, 17) => <p key={i} style="height: 90px; margin: 12px 0 0; padding: 12px; border: 1px solid var(--ui-border); border-radius: 10px">Note {i}</p>}
                <Button size="lg" variant="soft" id="coach-overlay-demo-far">Settings</Button>
                <p style="height: 200px"></p>
            </div>
            <CoachOverlay key={run} remember="ui-demo-coach" on_done={(h) => { said = `Done: ${h}.` }} steps={[
                { target: "coach-overlay-demo-add", title: "Start here", text: "Every note begins with this button." },
                { target: "coach-overlay-demo-missing", title: "Not on this screen", text: "Left out." },
                { target: "coach-overlay-demo-search", title: "Find anything", text: "Search looks through notes, photos and places." },
                { target: "coach-overlay-demo-far", title: "Your settings", text: "Far down the page, so it is brought into view." },
            ]}/>
        </div>
        <div.demo-row>
            <Button size="lg" variant="outline" id="coach-overlay-demo-open" on_click={() => { run = run + 1 }}>Open the app again</Button>
            <Button size="lg" variant="ghost" id="coach-overlay-demo-forget" on_click={() => {
                welcome_carousel_forget("ui-demo-coach")
                said = "Forgotten."
                run = run + 1
            }}>Show it again</Button>
        </div>
        <p.demo-note id="coach-overlay-demo-said" data-pressed={pressed}>{said}</p>
    </div>
}

view CoachOverlayDemo() = <CoachOverlayDemoLive/>

ui_gallery = ui_gallery | push({ slug: "coach_overlay", name: "CoachOverlay", group: "Mobile",
    summary: "A one-time spotlight of a real element, tracking it through scroll and rotation, advancing by tap, always skippable.",
    tags: ["mobile", "interactive", "tablet", "onboarding", "tour", "spotlight"],
    needs: ["welcome_carousel"],
    demo: CoachOverlayDemo })
