view AmortizationTableDemo() {
    <div.demo-stack>
        <AmortizationTable id="amortization-table-demo-home" amount={250000} rate={6.5} term={30} start="2026-12-01" open={2}/>
        <AmortizationTable id="amortization-table-demo-car" amount={18000} rate={7.9} term={48} term_unit="months" currency="EUR" locale="de-DE"
                           open={0} label="Car loan schedule"/>
    </div>
}

ui_gallery = ui_gallery | push({ slug: "amortization_table", name: "AmortizationTable", group: "Finance",
    summary: "A loan's payment schedule worked out from its amount, rate and term: each month's principal, interest and balance, grouped by year with the year's totals.",
    tags: ["finance", "loans", "table", "data", "no-js"], demo: AmortizationTableDemo })
