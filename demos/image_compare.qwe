// The same scene drawn twice in SVG, by day and by night, so the demo needs no image files.
fn image_compare_demo_scene(sky: str, sun: str, hill: str, lit: bool) -> str {
    let windows = lit ? `<rect x="540" y="330" width="24" height="24" fill="#ffd36b"/><rect x="590" y="330" width="24" height="24" fill="#ffd36b"/>` : ""
    let svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 675" width="1200" height="675">`
        + `<rect width="1200" height="675" fill="${sky}"/><circle cx="900" cy="170" r="70" fill="${sun}"/>`
        + `<path d="M0 470 Q 300 330 600 450 T 1200 420 V 675 H 0 Z" fill="${hill}"/>`
        + `<rect x="520" y="300" width="120" height="110" fill="#8a5a3c"/><path d="M505 305 L580 240 L655 305 Z" fill="#5b3a2a"/>${windows}</svg>`
    `data:image/svg+xml,${url_encode(svg)}`
}

component ImageCompareDemoLive() {
    state split = 50
    <div.demo-stack>
        <ImageCompare before={image_compare_demo_scene("#8fc8f2", "#ffd36b", "#4f8f4a", false)}
                      after={image_compare_demo_scene("#16203f", "#f5f0d0", "#1f3326", true)}
                      alt="A cottage on a hill" before_label="Day" after_label="Night"
                      on_change={(p) => { split = p }}/>
        <p.demo-note id="image-compare-demo-note">The divider is at {round(split)}%.</p>
    </div>
}

view ImageCompareDemo() =
    <div.demo-stack>
        <ImageCompareDemoLive/>
        <div style="max-width: 360px">
            <ImageCompare before={image_compare_demo_scene("#f3a46b", "#ff6b4a", "#7a5a3a", false)}
                          after={image_compare_demo_scene("#f3a46b", "#ff6b4a", "#3f7a3a", false)}
                          alt="The hill, before and after the rain" at={25} ratio="4/3" before_label={null} after_label={null}/>
        </div>
        <p.demo-note>Drag anywhere on a picture, or Tab to it and use the arrow keys.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "image_compare", name: "ImageCompare", group: "Media",
    summary: "Before and after pictures one over the other, with a divider to drag (or move with the keys) between them.",
    tags: ["media", "image", "drag", "interactive"], demo: ImageCompareDemo })
