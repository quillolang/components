component UnitPriceCompareDemoLive() {
    state seen = null
    <div.demo-stack>
        <UnitPriceCompare id="unit-price-compare-demo-live" title="Coffee, per 100 g" per="100g" currency="EUR" name="coffee"
                          packs={[{ name: "Beans", price: "7.50", size: 250, unit: "g" }, { name: "Same again, double", price: "15.00", size: "500 g" }, { name: "Ground", price: "4.00", size: "8 oz" }]}
                          on_change={(f) => { seen = f }}/>
        <p.demo-note>{seen == null ? "Change a figure to see on_change." : `on_change: first ${seen.weight[0].name}, ${len(seen.weight)} ranked.`}</p>
    </div>
}

view UnitPriceCompareDemo() =
    <div.demo-stack>
        <UnitPriceCompare id="unit-price-compare-demo" packs={[
            { name: "Own brand", price: "3.20", size: "500 g" },
            { name: "Family bag", price: "10.00", size: "2 kg" },
            { name: "Imported jar", price: "4.00", size: "12 oz" },
            { name: "Sack", price: "24.00", size: "10 lb" },
            { name: "Multipack", price: "5.40", size: "6 x 330 ml" },
            { name: "Bottle", price: "2.00", size: "1 L" }]}/>
        <UnitPriceCompareDemoLive/>
        <UnitPriceCompare id="unit-price-compare-demo-empty" title="Nothing yet"/>
    </div>

ui_gallery = ui_gallery | push({ slug: "unit_price_compare", name: "UnitPriceCompare", group: "Commerce",
    summary: "Packs in different sizes and units normalised to one, ranked by price per unit, with the best value and its saving marked and mixed weight and volume flagged.",
    tags: ["smart", "interactive", "commerce", "price", "compare", "units"], demo: UnitPriceCompareDemo })
