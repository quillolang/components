view FormRowDemo() =
    <div.demo-stack>
        <FormRow class="form-row-demo-names">
            <TextField name="first" label="First name" field="form-row-demo-first"/>
            <TextField name="last" label="Last name" field="form-row-demo-last"/>
        </FormRow>
        <FormRow columns={[3, 1]} class="form-row-demo-city">
            <TextField name="city" label="City" field="form-row-demo-city"/>
            <TextField name="zip" label="Postcode" field="form-row-demo-zip"/>
        </FormRow>
        <FormRow columns={["1fr", "auto"]} align="end" class="form-row-demo-search">
            <TextField name="q" label="Search" placeholder="A name or an email" field="form-row-demo-q"/>
            <Button type="button">Search</Button>
        </FormRow>
        <FormRow gap={20} class="form-row-demo-three">
            <TextField name="day" label="Day" field="form-row-demo-day"/>
            <TextField name="month" label="Month" field="form-row-demo-month"/>
            <TextField name="year" label="Year" field="form-row-demo-year"/>
        </FormRow>
    </div>

ui_gallery = ui_gallery | push({ slug: "form_row", name: "FormRow", group: "Forms",
    summary: "Fields side by side, equal or weighted, that stack one under another on a phone.",
    tags: ["forms", "layout", "grid", "no-js"], demo: FormRowDemo })
