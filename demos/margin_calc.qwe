component MarginCalcDemoLive() {
    state seen = null
    <div.demo-stack>
        <MarginCalc id="margin-calc-demo-live" title="Wholesale, in euros" currency="EUR" name="trade" cost="80" margin="25"
                    on_change={(f) => { seen = f }}/>
        <p.demo-note>{seen == null ? "Change a figure to see on_change." : `on_change: price ${seen.price}, profit ${seen.profit}.`}</p>
    </div>
}

view MarginCalcDemo() =
    <div.demo-stack>
        <MarginCalc id="margin-calc-demo" cost="12.40" price="19.99" target={45}/>
        <MarginCalcDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "margin_calc", name: "MarginCalc", group: "Commerce",
    summary: "Cost, price, margin and markup bound together: edit any and the rest follow from the two set last, with a price for a target margin and a warning under cost.",
    tags: ["smart", "interactive", "commerce", "calculator", "margin", "pricing"], demo: MarginCalcDemo })
