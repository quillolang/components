component ToastDemoLive() {
    state deleted = false
    state saves = 0
    <div.demo-stack>
        <div.demo-row>
            <Button id="toast-demo-save" variant="soft" on_click={() => {
                saves += 1
                toast_show(`Saved (${saves})`, { tone: "success", seconds: 3 })
            }}>Save</Button>
            <Button id="toast-demo-delete" variant="soft" tone="danger" on_click={() => {
                deleted = true
                toast_show("Message deleted", { action: "Undo", on_action: () => { deleted = false }, seconds: 8 })
            }}>Delete message</Button>
            <Button id="toast-demo-error" variant="outline" on_click={() => {
                toast_show("Could not reach the server.", { title: "Offline", tone: "danger", seconds: 0 })
            }}>Fail</Button>
            <Button id="toast-demo-info" variant="ghost" on_click={() => {
                toast_show("A new version is ready.", { title: "Update", tone: "info" })
            }}>Info</Button>
        </div>
        <p.demo-note>The message is {deleted ? "deleted" : "here"}.</p>
        <div style="position: relative; height: 200px; overflow: hidden; border: 1px dashed var(--ui-border); border-radius: var(--ui-radius)">
            <ToastHost inline={true} limit={3}/>
        </div>
    </div>
}

view ToastDemo() =
    <div.demo-stack>
        <ToastDemoLive/>
        <div.demo-stack.demo-narrow>
            <Toast title="Invoice sent" tone="success">Ana will get it in a minute.</Toast>
            <Toast tone="warning" action="Renew">Your plan ends in 3 days.</Toast>
        </div>
        <p.demo-note>Hover the stack to hold the timers. Without inline, the stack sits in the window's corner.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "toast", name: "Toast", group: "Overlays",
    summary: "A stack of toasts any component adds with toast_show(): tones, an action button, and timers that hold on hover.",
    tags: ["toast", "notification", "feedback", "interactive"],
    demo: ToastDemo })
