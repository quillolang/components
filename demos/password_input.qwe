component PasswordInputDemoLive() {
    state pw = ""
    <div.demo-stack>
        <PasswordInput name="pw-new" label="New password" new={true} meter={true}
                       hint="At least 12 characters, with upper and lower case and a digit." required={true}
                       on_input={(t) => { pw = t }}/>
        <p.demo-note>{len(pw)} characters typed.</p>
    </div>
}

view PasswordInputDemo() =
    <div.demo-stack.demo-narrow>
        <PasswordInput name="pw-current" placeholder="Your password"/>
        <PasswordInputDemoLive/>
        <PasswordInput name="pw-bad" label="Confirm password" value="hunter2" error="The passwords do not match." size="sm"/>
    </div>

ui_gallery = ui_gallery | push({ slug: "password_input", name: "PasswordInput", group: "Forms",
    summary: "A password field with a show/hide toggle and, for new passwords, a strength meter.",
    demo: PasswordInputDemo })
