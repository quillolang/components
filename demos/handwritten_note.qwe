let handwritten_note_demo_pages = [
    [{ color: "ink", points: [[140, 120, 3], [200, 96, 4], [260, 124, 3], [330, 100, 4], [400, 122, 3]] }],
    [{ color: "#0b6bcb", points: [[140, 208, 3], [240, 186, 3], [340, 210, 4]] }],
    [],
]

component HandwrittenNoteDemoLive() {
    state note = "Not changed yet."
    state out = ""
    state last = ""
    <div.demo-stack>
        <div.demo-tablet>
            <HandwrittenNote pages={handwritten_note_demo_pages} name="note-demo" label="Lecture notes"
                             on_change={(p) => { note = `${len(p)} pages, ${sum(p | map((x) => len(x)))} strokes.` }}
                             on_export={(n, png) => {
                                 out = `${out} ${n}:${len(png) > 1000 ? "png" : "empty"}`
                                 last = png
                             }}/>
        </div>
        <p.demo-note id="handwritten-note-state">{note}</p>
        <p.demo-note id="handwritten-note-out" data-png={last}>{out}</p>
        <div id="handwritten-note-plain" hidden="true"><HandwrittenNote pages="none" name="note-bad"/></div>
    </div>
}

view HandwrittenNoteDemo() = <HandwrittenNoteDemoLive/>

ui_gallery = ui_gallery | push({ slug: "handwritten_note", name: "HandwrittenNote", group: "Mobile",
    summary: "Ruled pages for a pen: a finger scrolls and swipes, the pen writes, and each page exports.",
    tags: ["mobile", "tablet", "interactive", "pen", "notes", "handwriting"],
    needs: ["stylus_canvas"],
    demo: HandwrittenNoteDemo })
