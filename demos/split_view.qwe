let split_view_demo_css = css`
.demo-split-head { position: sticky; top: 0; z-index: 1; margin: 0; padding: 12px 14px; border-bottom: 1px solid var(--ui-border); background: var(--ui-subtle); font: 600 14px/1.3 var(--ui-font); }
.demo-split-row { display: block; box-sizing: border-box; width: 100%; min-height: 56px; padding: 8px 14px; border: 0; border-bottom: 1px solid var(--ui-border); background: transparent; color: var(--ui-fg); font: 15px/1.3 var(--ui-font); text-align: left; cursor: pointer; }
.demo-split-row small { display: block; color: var(--ui-muted); font-size: 13px; }
.demo-split-row[aria-current="true"] { background: var(--ui-accent-soft); }
.demo-split-body { padding: 16px; font: 15px/1.6 var(--ui-font); }
.demo-split-body h4 { margin: 0 0 8px; font-size: 19px; }
.demo-split-body textarea { box-sizing: border-box; width: 100%; min-height: 96px; margin-top: 12px; padding: 8px 10px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius-sm); background: var(--ui-surface); color: var(--ui-fg); font: 16px/1.4 var(--ui-font); }
.demo-split-out { margin: 8px 0 0; }
`

let split_view_demo_lists = ["Inbox", "Sent", "Archive", "Drafts"]

let split_view_demo_notes = range(1, 31) | map((n) => {
    id: n,
    title: `Site visit ${n}`,
    who: n % 2 == 0 ? "Priya Nair" : "Tom Okafor",
    body: `Notes from visit ${n}: the north gate was open, and the keys are with the caretaker until Friday.`
})

component SplitViewDemoLive() {
    style global split_view_demo_css
    state pane = 1
    state folder = "Inbox"
    state open = 7
    state said = "Not resized yet"
    state tall = "100%"
    let note = find(split_view_demo_notes, (n) => n.id == open)
    <div.demo-stack>
        <div.demo-tablet>
            <SplitView titles={["Folders", "Notes", "Reader"]} sizes={[22, 33]} pane={pane} height={tall} label="Field notes" on_pane={(i) => { pane = i }}
                       on_resize={(s) => { said = `First ${s.first}, second ${s.second}, two-up ${s.medium}` }}>
                <SplitViewPane title="Folders">
                    <p.demo-split-head>Folders</p>
                    {for f in split_view_demo_lists =>
                        <button.demo-split-row key={f} type="button" data-folder={f} aria-current={f == folder ? "true" : null}
                                @click={() => { folder = f; pane = 1 }}>{f}</button>}
                </SplitViewPane>
                <SplitViewPane title="Notes">
                    <p.demo-split-head id="split-demo-folder">{folder}</p>
                    {for n in split_view_demo_notes =>
                        <button.demo-split-row key={n.id} type="button" data-note={n.id} aria-current={n.id == open ? "true" : null}
                                @click={() => { open = n.id; pane = 2 }}>{n.title}<small>{n.who}</small></button>}
                </SplitViewPane>
                <SplitViewPane title="Reader">
                    <div.demo-split-body>
                        <h4 id="split-demo-title">{note.title}</h4>
                        <p>{note.body}</p>
                        <label for="split-demo-reply">Reply</label>
                        <textarea id="split-demo-reply"></textarea>
                    </div>
                </SplitViewPane>
            </SplitView>
        </div>
        <div.demo-row>
            <Button id="split-demo-tall" size="lg" variant="outline" on_click={() => { tall = tall == "100%" ? "96%" : "100%" }}>Change the height</Button>
            <p.demo-note.demo-split-out id="split-demo-said">{said}</p>
        </div>
        <div.demo-tablet style="height: 360px">
            <SplitView titles={["Files", "Preview"]} sizes={[40]} folded="" label="Files">
                <SplitViewPane title="Files"><div.demo-split-body id="split-demo-two-a">Twelve files</div></SplitViewPane>
                <SplitViewPane title="Preview"><div.demo-split-body id="split-demo-two-b">Nothing chosen</div></SplitViewPane>
            </SplitView>
        </div>
    </div>
}

view SplitViewDemo() = <SplitViewDemoLive/>

ui_gallery = ui_gallery | push({ slug: "split_view", name: "SplitView", group: "Mobile",
    summary: "Two or three panes with a divider to drag, which give way by width, with the selection kept across a turn and a keyboard route for the divider.",
    tags: ["mobile", "tablet", "interactive", "layout", "panes", "resize"],
    demo: SplitViewDemo })
