view CurrencyPairCardDemo() =
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 12px">
        <CurrencyPairCard id="currency-pair-card-demo-eur" pair="EUR/USD" bid={1.08421m} ask={1.08429m} open={1.08190m}
                          high={1.08502m} low={1.08133m} href="#eurusd" updated="Indicative, 14:05 UTC"
                          values={[1.0819, 1.0815, 1.0824, 1.0831, 1.0827, 1.0836, 1.0849, 1.0838, 1.0842]}/>
        <CurrencyPairCard id="currency-pair-card-demo-jpy" pair="USD/JPY" bid={156.238m} ask={156.251m} open={156.902m}
                          high={157.115m} low={156.020m} values={[156.90, 157.05, 156.71, 156.62, 156.40, 156.31, 156.24]}/>
        <CurrencyPairCard id="currency-pair-card-demo-php" pair="USD/PHP" name="US dollar / Philippine peso" bid={58.105m} ask={58.140m}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "currency_pair_card", name: "CurrencyPairCard", group: "Finance",
    summary: "One currency pair: the bid and ask large with the pip digits biggest, the spread, the day's change, low and high, and a sparkline of the day.",
    tags: ["finance", "forex", "card", "chart", "no-js"], demo: CurrencyPairCardDemo })
