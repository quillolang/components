view SplashScreenDemoMark() =
    <svg viewBox="0 0 64 64" fill="none" aria-hidden="true"><rect x="6" y="6" width="52" height="52" rx="14" fill="var(--ui-accent)"/><path d="M20 44V20h14a8 8 0 0 1 0 16H20M34 36l10 8" stroke="var(--ui-accent-fg)" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/></svg>

component SplashScreenDemoLive() {
    state run = 0
    state ready = false
    state hold = 0
    state limit = 60000
    state said = "Held."
    let again = (r: bool, h: int, m: int) => {
        ready = r
        hold = h
        limit = m
        said = "Held."
        run = run + 1
    }
    <div.demo-stack>
        <div.demo-stack>
            <div.demo-phone.ui-light id="splash-screen-demo-light" style="height: 260px">
                <p style="padding: 16px">The app, light.</p>
                <SplashScreen key={run} name="Fieldbook" fixed={true} ready={ready} min_ms={hold} max_ms={limit} show_name={true}
                              on_gone={(w) => { said = `Gone: ${w}.` }}><SplashScreenDemoMark/></SplashScreen>
            </div>
            <div.demo-phone.ui-dark id="splash-screen-demo-dark" style="height: 260px">
                <p style="padding: 16px; color: var(--ui-fg)">The app, dark.</p>
                <SplashScreen key={run} name="Fieldbook" fixed={true} ready={ready} min_ms={hold} max_ms={limit}><SplashScreenDemoMark/></SplashScreen>
            </div>
        </div>
        <div.demo-row>
            <Button size="lg" id="splash-screen-demo-ready" on_click={() => { ready = true }}>The app is ready</Button>
            <Button size="lg" variant="outline" id="splash-screen-demo-again" on_click={() => { again(false, 0, 60000) }}>Hold it again</Button>
            <Button size="lg" variant="outline" id="splash-screen-demo-min" on_click={() => { again(true, 600, 60000) }}>Ready at once, holds 0.6 s</Button>
            <Button size="lg" variant="outline" id="splash-screen-demo-max" on_click={() => { again(false, 0, 500) }}>Never ready, gives up at 0.5 s</Button>
            <Button size="lg" variant="ghost" id="splash-screen-demo-odd" on_click={() => { again(false, 900, 300) }}>Least past the most</Button>
        </div>
        <p.demo-note id="splash-screen-demo-said">{said}</p>
    </div>
}

view SplashScreenDemo() = <SplashScreenDemoLive/>

ui_gallery = ui_gallery | push({ slug: "splash_screen", name: "SplashScreen", group: "Mobile",
    summary: "Holds the app's mark until ready, without a white flash, in both themes, and yields quickly.",
    tags: ["mobile", "interactive", "tablet", "splash", "startup", "theme"],
    demo: SplashScreenDemo })
