let tree_table_demo_accounts = [
    { id: "assets", name: "Assets", balance: 184250.75, kind: "Debit", expanded: true, children: [
        { id: "cash", name: "Cash", balance: 42100.5, kind: "Debit", children: [
            { id: "checking", name: "Checking", balance: 31000.5, kind: "Debit" },
            { id: "savings", name: "Savings", balance: 11100, kind: "Debit" },
        ] },
        { id: "receivable", name: "Accounts receivable", balance: 12150.25, kind: "Debit" },
        { id: "equipment", name: "Equipment", balance: 130000, kind: "Debit" },
    ] },
    { id: "liabilities", name: "Liabilities", balance: -56400, kind: "Credit", children: [
        { id: "payable", name: "Accounts payable", balance: -6400, kind: "Credit" },
        { id: "loan", name: "Bank loan", balance: -50000, kind: "Credit" },
    ] },
    { id: "equity", name: "Equity", balance: 127850.75, kind: "Credit" },
]

let tree_table_demo_parts = [
    { name: "Bicycle", qty: 1, unit: 420, children: [
        { name: "Frame", qty: 1, unit: 180 },
        { name: "Wheel", qty: 2, unit: 65, children: [{ name: "Rim", qty: 1, unit: 30 }, { name: "Spoke", qty: 32, unit: 0.5 }, { name: "Tyre", qty: 1, unit: 18 }] },
        { name: "Drivetrain", qty: 1, unit: 110, children: [{ name: "Chain", qty: 1, unit: 25 }, { name: "Cassette", qty: 1, unit: 45 }] },
    ] },
]

component TreeTableDemoLive() {
    state last = "nothing yet"
    <div.demo-stack>
        <TreeTable id="tree-table-demo-parts" label="Bill of materials" rows={tree_table_demo_parts} open_all={true} zebra={true}
                   on_toggle={(rid, open) => { last = `${open ? "opened" : "closed"} ${rid}` }}
                   columns={[{ key: "name", label: "Part" }, { key: "qty", label: "Qty", format: "number" }, { key: "unit", label: "Unit cost", format: "money" }]}/>
        <p.demo-note>Last toggle: {last}.</p>
    </div>
}

view TreeTableDemo() =
    <div.demo-stack>
        <TreeTable id="tree-table-demo-accounts" label="Chart of accounts" rows={tree_table_demo_accounts}
                   columns={[{ key: "name", label: "Account" }, { key: "kind", label: "Type" }, { key: "balance", label: "Balance", format: "money" }]}/>
        <TreeTableDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "tree_table", name: "TreeTable", group: "Data",
    summary: "Rows that open to show the rows under them, indented by depth, with the arrow keys as an ARIA treegrid.",
    tags: ["data", "table", "keyboard", "interactive"], demo: TreeTableDemo })
