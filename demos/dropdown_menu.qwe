component DropdownMenuDemoLive() {
    state picked = "nothing yet"
    <div.demo-row>
        <DropdownMenu id="dropdown-demo-sort" label="Sort by" variant="soft"
                      items={[{ label: "Newest" }, { label: "Oldest" }, { label: "Most liked" }]}
                      on_select={(it) => { picked = it.label }}/>
        <span.demo-note>Picked: {picked}</span>
    </div>
}

view DropdownMenuDemo() =
    <div.demo-stack>
        <div.demo-row>
            <DropdownMenu id="dropdown-demo-project" label="Project" items={[
                { label: "Settings", href: "#dropdown_menu" },
                { label: "Export", href: "#dropdown_menu" },
                { label: "Duplicate", disabled: true },
                { divider: true },
                { label: "Delete project", href: "#dropdown_menu", tone: "danger" }
            ]}/>
            <DropdownMenu id="dropdown-demo-account" label="Account" align="end" variant="ghost" items={[
                { label: "Profile", href: "#dropdown_menu" },
                { label: "Sign out", href: "#dropdown_menu" }
            ]}/>
        </div>
        <DropdownMenuDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "dropdown_menu", name: "DropdownMenu", group: "Actions",
    summary: "A button that opens a short list of links and actions; Escape or a click elsewhere closes it.",
    tags: ["menu", "button", "overlay", "no-js"],
    demo: DropdownMenuDemo })
