view CalloutDemo() =
    <div.demo-stack>
        <Callout id="callout-demo-note">Views are plain functions: they add nothing to the browser bundle unless a component uses them.</Callout>
        <Callout kind="tip" id="callout-demo-tip">Press <Kbd keys="Cmd+K"/> to open the command palette from anywhere.</Callout>
        <Callout kind="warning" title="Breaking change in 0.9" id="callout-demo-warning">
            <p>The old <code>on_select</code> callback is gone; use <code>on_change</code>, which is given the value.</p>
            <p>Programs that used it fail to load, naming the line.</p>
        </Callout>
        <Callout kind="important">A component placed straight in a page gets its props from the server, as data: no functions.</Callout>
        <Callout kind="caution" icon={false} id="callout-demo-noicon">Dropping a table cannot be undone, in a migration or anywhere else.</Callout>
    </div>

ui_gallery = ui_gallery | push({ slug: "callout", name: "Callout", group: "Typography",
    summary: "A highlighted aside with an icon and a title, as a note, tip, warning, important point or caution.",
    tags: ["typography", "document", "feedback", "no-js"],
    demo: CalloutDemo })
