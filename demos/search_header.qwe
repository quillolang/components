let search_header_demo_people = ["Ana Reyes", "Ben Okafor", "Carla Lim", "Dante Cruz", "Elena Marsh", "Farid Haddad", "Grace Tan", "Hugo Silva", "Ines Duarte", "Jun Park", "Kira Novak", "Luis Ortega"]

let search_header_demo_css = css`
.ui-searchhead-demo-list { margin: 0; padding: 0; list-style: none; }
.ui-searchhead-demo-list li { border-bottom: 1px solid var(--ui-border); }
.ui-searchhead-demo-list a { box-sizing: border-box; display: flex; align-items: center; min-height: 48px; padding: 0 16px; color: var(--ui-accent); font: 15px var(--ui-font); text-decoration: none; }
.ui-searchhead-demo-list button { box-sizing: border-box; width: 100%; min-height: 48px; padding: 0 16px; border: 0; background: transparent; color: var(--ui-fg); font: 15px var(--ui-font); text-align: start; cursor: pointer; }
`

view SearchHeaderDemoList(people: list, on_pick) =
    <ul.ui-searchhead-demo-list>
        {for p in people => <li key={p}><button type="button" @click={() => { on_pick(p) }}>{p}</button></li>}
        <li><a href="#search-header-import">Import contacts</a></li>
        <li><a href="#search-header-groups">Browse groups</a></li>
        <li><a href="#search-header-help">Help with search</a></li>
    </ul>

component SearchHeaderDemoLive() {
    style global search_header_demo_css
    state q = ""
    state picked = "nobody"
    state sent = ""
    state run = 0
    state wait_ms = 0
    state changed = 0
    let hits = search_header_demo_people | filter((p) => contains(lower(p), lower(trim(q))))
    <div.demo-stack>
        <div.demo-tablet>
            <SearchHeader key={run} id="search-header-demo" delay={wait_ms} title="Contacts" placeholder="Search contacts" recent={["Grace", "Ben", "grace", "Luis", 7, "  "]} storage="ui-search-header-demo" on_recent={(_list) => { changed += 1 }}
                          count={len(hits)} empty_text="Nobody by that name" on_search={(t) => { q = t }} on_submit={(t) => { sent = t }}
                          results={<SearchHeaderDemoList people={hits} on_pick={(p) => { picked = p }}/>}>
                <SearchHeaderDemoList people={search_header_demo_people} on_pick={(p) => { picked = p }}/>
            </SearchHeader>
        </div>
        <p class="demo-note" style="overflow-wrap: anywhere">Query: {q}; sent: {sent}; picked: {picked}; recents changed {changed}</p>
        <div.demo-row>
            <Button size="lg" variant="outline" on_click={() => { run += 1 }}>Build it again</Button>
            <Button size="lg" variant="outline" on_click={() => { wait_ms = 300 }}>Wait for a pause in typing</Button>
        </div>
    </div>
}

view SearchHeaderDemo() = <SearchHeaderDemoLive/>

ui_gallery = ui_gallery | push({ slug: "search_header", name: "SearchHeader", group: "Mobile",
    summary: "A header whose search field opens in place with Cancel, recent searches and your results; the keyboard stays up through them; a dropdown panel on a tablet.",
    tags: ["mobile", "interactive", "tablet", "search", "header", "keyboard"],
    demo: SearchHeaderDemo })
