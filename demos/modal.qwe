component ModalDemoLive() {
    state editing = false
    <div.demo-row>
        <Button variant="soft" on_click={() => { editing = true }}>Rename (from state)</Button>
        <Modal title="Rename project" open={editing} size="sm" on_close={() => { editing = false }}>
            <p>Opened by the component's own state; closing it sets the state back.</p>
        </Modal>
    </div>
}

view ModalDemo() =
    <div.demo-row>
        <Modal title="Invite people" trigger="Invite">
            <p>They get an email with a link that signs them in. Press Escape or click outside to close.</p>
        </Modal>
        <ModalDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "modal", name: "Modal", group: "Overlays",
    summary: "A dialog over the page, on the browser's own <dialog>: focus, Escape and screen readers handled.",
    demo: ModalDemo })
