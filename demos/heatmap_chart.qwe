let heatmap_chart_demo_days = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
let heatmap_chart_demo_hours = for h in range(12) => `${h * 2 < 10 ? "0" : ""}${h * 2}:00`
// Visits: busy on weekday afternoons, quiet at night and at the weekend.
let heatmap_chart_demo_visits = for d in range(7) => for h in range(12) =>
    round((d < 5 ? 1 : 0.45) * (h < 3 ? 12 + h * 4 : (h < 9 ? 60 + (h - 3) * 22 - (h > 6 ? (h - 6) * 30 : 0) : 70 - (h - 9) * 18)) + d * 3)
let heatmap_chart_demo_names = ["Price", "Ads", "Visits", "Signups", "Churn"]

view HeatmapChartDemo() =
    <div.demo-stack>
        <HeatmapChart label="Visits by weekday and hour" show_label={true}
                      rows={heatmap_chart_demo_days} cols={heatmap_chart_demo_hours} values={heatmap_chart_demo_visits}/>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 32px 40px">
            <HeatmapChart label="Correlation" show_label={true} diverging={true} low={-1} high={1} decimals={2}
                          cell_values={true} cell={40} rows={heatmap_chart_demo_names} cols={heatmap_chart_demo_names}
                          values={[[1, -0.62, -0.41, -0.55, 0.38], [-0.62, 1, 0.81, 0.66, -0.12],
                                   [-0.41, 0.81, 1, 0.74, -0.2], [-0.55, 0.66, 0.74, 1, -0.47], [0.38, -0.12, -0.2, -0.47, 1]]}/>
            <HeatmapChart label="Uptime by region" show_label={true} color={3} suffix="%" cell_values={true} cell={34}
                          rows={["EU", "US", "Asia"]} cols={["Jul", "Aug", "Sep", "Oct"]}
                          values={[[99.95, 99.99, 99.9, 100], [99.8, null, 99.97, 99.99], [99.5, 99.7, 99.92, 99.98]]}/>
        </div>
        <p.demo-note>US in August had no data, so its cell is hatched.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "heatmap_chart", name: "HeatmapChart", group: "Charts",
    summary: "A grid of cells coloured by value, in one colour or two either side of a middle, with a colour scale and each cell's value on hover.",
    tags: ["chart", "data", "grid", "no-js"],
    demo: HeatmapChartDemo })
