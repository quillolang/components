// n numbers around `mid`, `spread` either side, from a seeded generator (the same on
// every run): each the mean of two draws, so most fall near the middle.
fn box_plot_demo_values(seed: int, n: int, mid: num, spread: num) -> list {
    let s = seed
    let out = []
    while len(out) < n {
        let total = 0
        for k in range(2) {
            s = (s * 1103515245 + 12345) % 2147483648
            total += s / 2147483648
        }
        out = push(out, round(mid + (total / 2 - 0.5) * 2 * spread))
    }
    out
}

view BoxPlotDemo() =
    <div.demo-stack>
        <BoxPlot label="Response time by service" show_label={true} suffix=" ms"
                 groups={[{ name: "Auth", values: box_plot_demo_values(7, 60, 120, 80) + [330, 362] },
                          { name: "Search", values: box_plot_demo_values(11, 60, 220, 140) },
                          { name: "Checkout", values: box_plot_demo_values(23, 60, 170, 60) + [12, 405] },
                          { name: "Images", values: box_plot_demo_values(31, 60, 100, 70) },
                          { name: "Reports", values: box_plot_demo_values(43, 60, 270, 120) + [530] }]}/>
        <BoxPlot label="Exam scores by class" show_label={true} points={true} mean={true} zero={true} height={200}
                 groups={[{ name: "Class A", values: [62, 71, 74, 78, 80, 81, 83, 85, 88, 90, 94] },
                          { name: "Class B", values: [45, 58, 61, 64, 66, 70, 72, 73, 75, 79, 82, 99] },
                          { name: "Class C", values: [70, 72, 75, 77, 78, 80, 81, 82, 84, 86] }]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "box_plot", name: "BoxPlot", group: "Charts",
    summary: "Quartiles, median, whiskers and outliers for each group, worked out from the raw values, with the five numbers on hover.",
    tags: ["chart", "data", "no-js"],
    demo: BoxPlotDemo })
