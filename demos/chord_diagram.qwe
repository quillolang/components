view ChordDiagramDemo() =
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 32px 40px">
        <ChordDiagram label="People moving between regions, thousands" show_label={true} suffix="k"
                      names={["North", "South", "East", "West", "Abroad"]}
                      matrix={[[0, 42, 18, 25, 9], [31, 0, 22, 14, 12], [12, 28, 0, 35, 6], [20, 11, 30, 0, 15], [8, 19, 4, 11, 0]]}/>
        <ChordDiagram label="Customers switching phone brands" show_label={true} size={280}
                      names={["Apple", "Samsung", "Google", "Other"]}
                      matrix={[[620, 40, 25, 10], [85, 540, 60, 45], [30, 35, 180, 15], [20, 70, 18, 110]]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "chord_diagram", name: "ChordDiagram", group: "Charts",
    summary: "Flows between groups around a circle, an arc per group and a ribbon per pair, with a group's ribbons kept on hover.",
    tags: ["chart", "data", "no-js"],
    demo: ChordDiagramDemo })
