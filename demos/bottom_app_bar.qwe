let bottom_app_bar_demo_actions = [
    { id: "menu", label: "Menu", icon: "M4 6h16M4 12h16M4 18h16" },
    { id: "search", label: "Search", icon: "M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16zM21 21l-4.3-4.3" },
    { id: "inbox", label: "Inbox", icon: "M4 4h16v16H4zM4 13h5l1.5 2h3L15 13h5", badge: 4 },
]

component BottomAppBarDemoLive() {
    state did = "nothing yet"
    state notes = 12
    state middle = false
    <div.demo-stack>
        <div.demo-tablet>
            <BottomAppBar actions={bottom_app_bar_demo_actions} fab={{ label: "New note", icon: "M12 5v14M5 12h14" }} fab_at={middle ? "center" : "end"}
                          on_action={(id) => { did = id }} on_fab={() => { notes += 1; did = "new note" }}>
                <div style="padding: 8px 16px">
                    {for i in range(0, 40) => <p key={i} style="margin: 0; padding: 14px 0; border-bottom: 1px solid var(--ui-border)">Note {notes + 40 - i}</p>}
                </div>
            </BottomAppBar>
        </div>
        <p class="demo-note">Last: {did}</p>
        <Button size="lg" variant="outline" on_click={() => { middle = !middle }}>Move the button</Button>
    </div>
}

view BottomAppBarDemo() = <BottomAppBarDemoLive/>

ui_gallery = ui_gallery | push({ slug: "bottom_app_bar", name: "BottomAppBar", group: "Mobile",
    summary: "A bottom bar with actions and a notched floating button, hiding on scroll and standing clear of the safe area; a floating toolbar on a tablet.",
    tags: ["mobile", "interactive", "tablet", "navigation", "toolbar", "fab"],
    needs: ["top_app_bar"],
    demo: BottomAppBarDemo })
