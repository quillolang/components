component FontPickerDemoLive() {
    state font = "Georgia"
    <div.demo-stack>
        <FontPicker name="heading_font" label="Headings" value={font} field="font-picker-demo-live"
                    preview="The quick brown fox jumps over the lazy dog" on_change={(f) => { font = f }}/>
        <p.demo-note>Headings in {font}.</p>
    </div>
}

view FontPickerDemo() =
    <div.demo-stack.demo-narrow>
        <FontPicker name="font" label="Body font" value="Inter" field="font-picker-demo-all" preview=""
                    hint="Each option is drawn in its font where the browser allows." required={true}/>
        <FontPickerDemoLive/>
        <div.demo-row>
            <FontPicker name="code_font" label="Code" size="sm" placeholder="Choose a font" field="font-picker-demo-small"
                        fonts={[{ label: "JetBrains Mono", value: "jetbrains", stack: "'JetBrains Mono', monospace" }, "Menlo", "Courier New"]}/>
            <FontPicker name="locked" label="Disabled" size="sm" value="Arial" fonts={["Arial"]} disabled={true}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "font_picker", name: "FontPicker", group: "Forms",
    summary: "A drop-down of fonts, each option drawn in itself, with a preview line in the one chosen.",
    tags: ["forms", "select", "picker", "typography", "no-js"], demo: FontPickerDemo })
