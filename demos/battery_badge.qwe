let battery_badge_demo_css = css`
.ui-batbadge-demo-spin { width: 20px; height: 20px; border-radius: 50%; border: 3px solid var(--ui-accent); border-right-color: transparent; animation: ui-batbadge-demo-spin 1s linear infinite; }
html[data-go-easy] .ui-batbadge-demo-spin { animation: none; }
@keyframes ui-batbadge-demo-spin { to { transform: rotate(360deg); } }
.ui-batbadge-demo-range { width: 100%; height: 44px; margin: 0; accent-color: var(--ui-accent); }
`

component BatteryBadgeDemoLive() {
    style global battery_badge_demo_css
    state percent = 64
    state plugged = false
    state saving = false
    state asked = "No request yet."
    state count = 0
    <div.demo-stack>
        <div.demo-row>
            <BatteryBadge level={percent / 100} status={plugged ? "charging" : "unplugged"} low_power={saving}
                on_go_easy={(on, r) => { count += 1; asked = `${on ? "Go easy" : "Back to normal"} at ${round(r.level * 100)}%.` }}/>
            <span.ui-batbadge-demo-spin aria-hidden="true"></span>
        </div>
        <label for="battery-badge-demo-level">Level: {percent}%</label>
        <input.ui-batbadge-demo-range id="battery-badge-demo-level" type="range" min="0" max="100" value={percent}
               @input={(e) => { percent = int(e.value) }}/>
        <div.demo-row>
            <Button size="lg" variant={plugged ? "solid" : "outline"} id="battery-badge-demo-plug" on_click={() => { plugged = !plugged }}>Plugged in</Button>
            <Button size="lg" variant={saving ? "solid" : "outline"} id="battery-badge-demo-save" on_click={() => { saving = !saving }}>Saving power</Button>
        </div>
        <p.demo-note id="battery-badge-demo-asked">{asked} ({count})</p>
        <p.demo-note>This device, read live:</p>
        <div id="battery-badge-demo-real"><BatteryBadge seconds={5}/></div>
    </div>
}

view BatteryBadgeDemo() = <BatteryBadgeDemoLive/>

ui_gallery = ui_gallery | push({ slug: "battery_badge", name: "BatteryBadge", group: "Mobile",
    summary: "Shows the battery's level and low-power state from the app or the web, and asks the page to go easy when it is low.",
    tags: ["mobile", "interactive", "battery", "power", "badge"],
    needs: ["button"],
    demo: BatteryBadgeDemo })
