view StatusDotDemo() =
    <div.demo-stack>
        <div.demo-row style="gap: 20px">
            <StatusDot status="online"/>
            <StatusDot status="away"/>
            <StatusDot status="busy" label="In a meeting"/>
            <StatusDot status="offline"/>
        </div>
        <div.demo-row style="gap: 20px">
            <StatusDot status="ok" label="All systems operational"/>
            <StatusDot status="warning" label="Degraded performance" size="sm"/>
            <StatusDot status="error" label="API down" pulse={true}/>
            <StatusDot status="info" label="Maintenance scheduled" size="lg"/>
            <StatusDot status="unknown" label="No data"/>
        </div>
        <div.demo-row>
            <span>Ada Lovelace</span><StatusDot status="online" show_label={false} pulse={true}/>
            <span>Alan Turing</span><StatusDot status="busy" show_label={false}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "status_dot", name: "StatusDot", group: "Feedback",
    summary: "A coloured dot and a word for the state of a person or a service, with an optional pulse, said to screen readers.",
    tags: ["feedback", "status", "no-js"],
    demo: StatusDotDemo })
