component TextAreaDemoLive() {
    state words = 0
    <div.demo-stack>
        <TextArea name="note" label="Release note" autogrow={true} rows={2}
                  placeholder="It grows as you type…"
                  on_input={(v) => { words = len(re.split(trim(v), "\\s+") | filter((w) => w != "")) }}/>
        <p.demo-note>{words} {words == 1 ? "word" : "words"}</p>
    </div>
}

view TextAreaDemo() =
    <div.demo-stack.demo-narrow>
        <TextArea name="bio" label="Bio" rows={3} maxlength={160} value="Writes Quillo by day, bread by night."
                  hint="Shown on your profile."/>
        <TextArea name="reason" label="Why are you leaving?" required={true} rows={2}
                  error="Tell us in a few words, so we can do better."/>
        <TextAreaDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "text_area", name: "TextArea", group: "Forms",
    summary: "A box for several lines, with a live count against a limit and an option to grow with what is typed.",
    demo: TextAreaDemo })
