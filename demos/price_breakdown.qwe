view PriceBreakdownDemo() =
    <div.demo-row>
        <PriceBreakdown title="Your stay" total="€1,062.88" note="A demo: no money moves."
                        lines={[{ label: "9 nights", amount: "€960.00" },
                                { label: "Weekly stay discount (10%)", amount: "−€96.00", tone: "success" },
                                { label: "Cleaning", amount: "€35.00" },
                                { label: "Service fee", amount: "€107.88", hint: "12% of the nights and cleaning" },
                                { label: "Lisbon tourist tax", amount: "€56.00", hint: "2 guests × 7 nights" }]}
                        class="demo-narrow demo-wide"/>
        <PriceBreakdown total="￥76,840" total_label="Total (JPY)"
                        lines={[{ label: "3 nights", amount: "￥62,000" }, { label: "Cleaning", amount: "￥5,000" },
                                { label: "Service fee", amount: "￥8,040" }, { label: "Accommodation tax", amount: "￥1,800", tone: "muted" }]}
                        class="demo-narrow demo-wide"/>
    </div>

ui_gallery = ui_gallery | push({ slug: "price_breakdown", name: "PriceBreakdown", group: "Data",
    summary: "What a price is made of, a line each (a discount in green), and the total.",
    tags: ["commerce", "price", "data", "no-js"],
    demo: PriceBreakdownDemo })
