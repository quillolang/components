let translation_checker_demo_source = { greeting: "Hello, {name}!", cart: { items: "%d items in your %s", empty: "Your cart is empty", total: "<b>Total:</b> {{amount}}" }, nav: { home: "Home", help: "Help" }, footer: "Made with care. " }
let translation_checker_demo_fr = { greeting: "Bonjour, {nom} !", cart: { items: "%s contient %d articles", total: "<b>Total :</b> {{amount}}" }, nav: { home: "Home", help: "Aide" }, footer: "Fait avec soin.", legacy: "Ancien" }
let translation_checker_demo_de = { greeting: "Hallo, {name}!", cart: { items: "%d Artikel in Ihrem %s", empty: "Ihr Warenkorb ist derzeit noch vollkommen leer und enthält keine Artikel", total: "<b>Summe:</b {{amount}}" },
                                    nav: { home: "Startseite", help: "Hilfe" }, footer: "Mit Sorgfalt gemacht. " }

component TranslationCheckerDemoLive() {
    state done = null
    <div.demo-stack>
        <TranslationChecker id="translation-checker-demo-live" source_name="en_json" translations_name="all_json" rows={3} source={{ ok: "OK", save: "Save" }} translations={{ es: { ok: "OK" } }} keep={["OK"]}
                            on_change={(r) => { done = r.locales[0].percent }}/>
        <p.demo-note>{done == null ? "Change the JSON to see on_change." : `on_change: ${done}% translated.`}</p>
    </div>
}

view TranslationCheckerDemo() =
    <div.demo-stack>
        <TranslationChecker id="translation-checker-demo" source={translation_checker_demo_source} translations={{ fr: translation_checker_demo_fr, de: translation_checker_demo_de }}/>
        <TranslationCheckerDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "translation_checker", name: "TranslationChecker", group: "Utilities",
    summary: "Source and translated strings side by side: missing, unchanged and overlong strings, mismatched placeholders, HTML tags and spaces, and each language's completeness.",
    tags: ["smart", "interactive", "i18n", "translation", "localization", "check"], needs: ["readability_meter"], demo: TranslationCheckerDemo })
