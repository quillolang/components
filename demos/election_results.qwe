view ElectionResultsDemo() =
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 16px; align-items: start">
        <ElectionResults id="election-results-demo-ohio" race="Ohio · U.S. Senate" href="#ohio-senate" reporting={87.4} called="Maria Lopez"
                         updated="Updated 11:42 PM ET" candidates={[
                             { name: "John Becker", party: "REP", votes: 2101876, incumbent: true },
                             { name: "Maria Lopez", party: "DEM", votes: 2145332 },
                             { name: "Ann Wu", party: "LIB", votes: 61422 },
                         ]}/>
        <ElectionResults id="election-results-demo-mayor" race="Riverside · Mayor" reporting={41} show={3} candidates={[
                             { name: "Sam Ortiz", votes: 18204, color: "#0f8b8d" },
                             { name: "Priya Nair", party: "IND", votes: 17950 },
                             { name: "Dan Cole", party: "GRN", votes: 6011 },
                             { name: "Lee Park", votes: 1404 },
                             { name: "Ruth Ames", votes: 977 },
                         ]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "election_results", name: "ElectionResults", group: "News",
    summary: "One race's results: candidates in party colours with votes and share bars, the share of the vote counted, the margin, and the winner once it is called.",
    tags: ["news", "election", "chart", "table", "no-js"], demo: ElectionResultsDemo })
