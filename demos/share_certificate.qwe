view ShareCertificateDemo() =
    <div.demo-stack>
        <ShareCertificate id="share-certificate-demo" coop="Bayanihan Multi-Purpose Cooperative" registration="Registration No. 9520-03012345"
                          address="Rizal Avenue, Poblacion, San Isidro" number="SC-2026-00417" member="Lourdes Villanueva"
                          member_number="M-004217" shares={185} par={100} currency="PHP" issued="2026-03-31" place="San Isidro"
                          signers={[{ name: "Ma. Cristina Ocampo", role: "Secretary" }, { name: "Eduardo Lim", role: "Chairperson" }]}/>
        <ShareCertificate id="share-certificate-demo-pref" coop="Northfield Farmers Cooperative" number="P-00088" member="Okonkwo Family Farm LLC"
                          shares={2500} par={10} kind="preferred" issued="2026-01-15"
                          signers={[{ role: "Secretary" }, { role: "Treasurer" }, { role: "President" }]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "share_certificate", name: "ShareCertificate", group: "Finance",
    summary: "A printable share certificate: the co-op, the member, the shares in words and figures, par value and total, the date and signature lines.",
    tags: ["finance", "coop", "document", "print", "no-js"], demo: ShareCertificateDemo })
