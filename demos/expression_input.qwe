component ExpressionInputDemoLive() {
    state fee = null
    <div.demo-stack>
        <ExpressionInput id="expression-demo-live" name="fee" label="Fee" decimals={2} lowest={0} highest={10000} value="1200 + 15%"
                         on_change={(v) => { fee = v }}/>
        <p.demo-note>{fee == null ? "Change the sum to see on_change." : `on_change: ${fee}`}</p>
    </div>
}

view ExpressionInputDemo() =
    <div class="demo-stack demo-narrow">
        <form>
            <ExpressionInput id="expression-demo" name="qty" label="Quantity" value="12*3+4" hint="Sums work: 15% of 80, (1+2)/3."/>
        </form>
        <ExpressionInputDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "expression_input", name: "ExpressionInput", group: "Forms",
    summary: "A number field that works out 12*3+4, 15% of 80 and (1+2)/3 exactly with its own parser, shows the answer as typed, points at what it cannot read, and sends the answer.",
    tags: ["smart", "interactive", "calculator", "number", "parser", "forms"], demo: ExpressionInputDemo })
