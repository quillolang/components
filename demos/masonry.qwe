let masonry_demo_notes = [
    { title: "Grocery list", text: "Eggs, oat milk, lemons, basil, the good olive oil, bread for Saturday." },
    { title: "Idea", text: "A tiny app that turns a photo of a receipt into a shared bill." },
    { title: "Reading", text: "Finished the second chapter. The part about tides was the best so far, worth reading twice before the meeting on Thursday, where it will come up." },
    { title: "Call back", text: "Dentist, before noon." },
    { title: "Trip", text: "Trains from Lisbon leave on the hour. Book the 09:00 and the 17:00 back; a day pass is cheaper than two singles." },
    { title: "Quote", text: "“Make it work, make it right, make it fast.”" },
    { title: "Garden", text: "Move the tomatoes into the sun. Water the ferns on Monday and Thursday, and feed the lemon tree once this month." },
    { title: "Gift", text: "A record player for Ana's birthday, the green one." },
    { title: "Passwords", text: "Rotate the API keys on the first of the month." }
]

view MasonryDemo() =
    <div.demo-stack>
        <Masonry id="masonry-demo-notes" width={200}>
            {for n in masonry_demo_notes => <Card title={n.title} padding="sm"><p style="margin: 0; font-size: 14px">{n.text}</p></Card>}
        </Masonry>
        <p.demo-note>Nine cards of different heights in three columns, each filled from the top.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "masonry", name: "Masonry", group: "Layout",
    summary: "Cards of different heights packed into columns, each filled from the top, on CSS columns alone.",
    tags: ["layout", "grid", "card", "no-js"], demo: MasonryDemo })
