let cart_sheet_demo_items = [
    { id: "shirt", name: "Linen shirt", option: "M, Sand", price: "48.00", qty: 1, stock: 3 },
    { id: "tote", name: "Canvas tote", price: "19.99", qty: 2 },
    { id: "socks", name: "Wool socks", option: "Three pairs", price: "7.35", qty: 3 },
]

component CartSheetDemoLive() {
    state said = "Nothing sent to checkout yet."
    state lines = cart_sheet_demo_items
    <div.demo-stack>
        <div.demo-row>
            <CartSheet items={lines} free_over="150.00" shipping="6.95" tax_rate="0.08" on_change={(ls) => { lines = ls }}
                       on_checkout={(ls, t) => { said = `Checkout: ${len(ls)} lines, ${t.total}` }}/>
            <Button id="cart-sheet-more" variant="ghost" size="lg" on_click={() => { lines = lines + [{ id: "cap", name: "Sun cap", price: "12.00", qty: 1 }] }}>Add a cap</Button>
        </div>
        <p.demo-note id="cart-sheet-said">{said}</p>
    </div>
}

view CartSheetDemo() = <CartSheetDemoLive/>

ui_gallery = ui_gallery | push({ slug: "cart_sheet", name: "CartSheet", group: "Mobile",
    summary: "A cart in a sheet with quantities, swipe to remove with undo, live totals in decimals, a free-shipping note and a checkout button.",
    tags: ["mobile", "interactive", "commerce", "sheet", "swipe", "tablet"],
    demo: CartSheetDemo })
