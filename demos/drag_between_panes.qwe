let drag_between_panes_demo_panes = [{ id: "backlog", title: "Backlog" }, { id: "today", title: "Today", limit: 3 }, { id: "done", title: "Done" }]

let drag_between_panes_demo_items = [
    { id: 1, pane: "backlog", title: "Call the plumber", detail: "Before noon" }, { id: 2, pane: "backlog", title: "Order filters", detail: "Pack of 12" },
    { id: 3, pane: "backlog", title: "Renew insurance", detail: "Due Friday" }, { id: 4, pane: "backlog", title: "Book the van", detail: "Tuesday" },
    { id: 5, pane: "backlog", title: "Pay supplier", detail: "Invoice 2291" }, { id: 6, pane: "backlog", title: "Update prices", detail: "Spring list" },
    { id: 7, pane: "backlog", title: "Service the boiler", detail: "Annual" }, { id: 8, pane: "backlog", title: "Reply to Mira", detail: "About the quote" },
    { id: 9, pane: "backlog", title: "Clean the store", detail: "With the team" }, { id: 10, pane: "backlog", title: "Count stock", detail: "End of month" },
    { id: 11, pane: "backlog", title: "Print labels", detail: "Two rolls" }, { id: 12, pane: "backlog", title: "Fix the sign", detail: "Left bracket" },
    { id: 13, pane: "backlog", title: "Sort receipts", detail: "For the accountant" }, { id: 14, pane: "backlog", title: "Test the alarm", detail: "Monthly" },
    { id: 15, pane: "backlog", title: "Water the plants", detail: "Front window" }, { id: 16, pane: "backlog", title: "Check the lift", detail: "Engineer due" },
    { id: 17, pane: "backlog", title: "Sign the lease", detail: "Two copies" }, { id: 18, pane: "backlog", title: "Call the bank", detail: "New card" },
    { id: 19, pane: "backlog", title: "Tidy the desk", detail: "Before Friday" },
    { id: 20, pane: "today", title: "Open the shop", detail: "8:30" }, { id: 21, pane: "today", title: "Bank run", detail: "Before 15:00" },
    { id: 30, pane: "done", title: "Send the invoices", detail: "Yesterday" },
]

component DragBetweenPanesDemoLive() {
    state note = "Nothing moved yet."
    <div.demo-stack>
        <div.demo-tablet>
            <DragBetweenPanes panes={drag_between_panes_demo_panes} items={drag_between_panes_demo_items} label="Work board"
                              on_move={(id, from, to, index) => { note = `${id} from ${from} to ${to} at ${index}.` }}/>
        </div>
        <p.demo-note id="drag-between-panes-note">{note}</p>
        <div id="drag-between-panes-bad" hidden="true"><DragBetweenPanes label="Bad" panes={[null, { id: "a" }, { id: "b", title: "B" }, { id: "b", title: "Again" }]} items={[null, { id: 1, pane: "x", title: "No pane" }, { id: 2, pane: "b" }, { id: 3, pane: "b", title: "Kept" }, { id: 3, pane: "b", title: "Twice" }]}/><DragBetweenPanes label="Bad too" panes="none" items={3}/></div>
    </div>
}

view DragBetweenPanesDemo() = <DragBetweenPanesDemoLive/>

ui_gallery = ui_gallery | push({ slug: "drag_between_panes", name: "DragBetweenPanes", group: "Mobile",
    summary: "Drag an item from one pane to another by finger or pen, with a drop preview, a keyboard route and on_move.",
    tags: ["mobile", "tablet", "interactive", "gesture", "drag", "panes"],
    demo: DragBetweenPanesDemo })
