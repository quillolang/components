let faq_finder_demo_items = [
    { id: "ship", question: "How long does shipping take?", answer: "Orders leave our warehouse within two days and arrive in three to five working days.", category: "Delivery", popular: true },
    { id: "intl", question: "Do you deliver abroad?", answer: "We ship to 40 countries. International delivery takes up to two weeks, and customs duties are paid on arrival.", category: "Delivery" },
    { id: "track", question: "Where is my order?", answer: "Each parcel has a tracking link, sent by email when it leaves us.", category: "Delivery", popular: true, tags: ["tracking", "parcel"] },
    { id: "refund", question: "How do I get a refund?", answer: "Send the item back within 30 days. Refunds reach your card within five days of our receiving it.", category: "Returns", popular: true },
    { id: "return", question: "What is your returns policy?", answer: "Unused items can be returned within 30 days, with the receipt. Sale items can be exchanged only.", category: "Returns" },
    { id: "cancel", question: "Can I cancel an order?", answer: "An order can be cancelled until it is packed, from your account page.", category: "Orders" },
    { id: "pay", question: "Which payment methods do you take?", answer: "We take credit cards, debit cards and PayPal.", category: "Orders" },
    { id: "warranty", question: "What does the warranty cover?", answer: "Every product has a two-year warranty against faults. Accidental damage is not covered.", category: "Products" },
    { id: "password", question: "I forgot my password", answer: "Use the reset link on the sign-in page, and we will email you a new one.", category: "Account" },
]

let faq_finder_demo_synonyms = [["refund", "money back", "reimbursement"], ["ship", "post", "dispatch"], ["sign in", "log in", "login"], ["faulty", "broken", "damage"]]

component FaqFinderDemoLive() {
    state missed = []
    <div.demo-stack>
        <FaqFinder id="faq-finder-demo-live" title="Help centre" name="help" items={faq_finder_demo_items} limit={3} contact_url="#contact" contact_label="Ask us instead"
                   on_no_match={(q) => { missed = missed | push(q) }}/>
        <p.demo-note>{len(missed) == 0 ? "Search for something it lacks, and leave the box, to see on_no_match." : `on_no_match: ${join(missed, ", ")}.`}</p>
    </div>
}

view FaqFinderDemo() =
    <div.demo-stack>
        <FaqFinder id="faq-finder-demo" items={faq_finder_demo_items} synonyms={faq_finder_demo_synonyms} query="money back"/>
        <FaqFinderDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "faq_finder", name: "FaqFinder", group: "Marketing",
    summary: "Searches questions and answers by term weighting, tolerant of typos and word endings, with synonyms as data, shows why each answer was found, and helps when none was.",
    tags: ["smart", "interactive", "search", "faq", "support", "help"], demo: FaqFinderDemo })
