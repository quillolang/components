view CheckoutStepsDemo() =
    <div.demo-stack style="gap: 24px">
        <CheckoutSteps current={1}/>
        <CheckoutSteps current={2} steps={[{ label: "Cart", href: "#cart_item" }, { label: "Address", href: "#checkout_steps" }, "Payment", "Review"]}/>
        <CheckoutSteps current={4} numbers={false}/>
        <div.demo-narrow><CheckoutSteps current={0} steps={["Bag", "Pay", "Done"]}/></div>
    </div>

ui_gallery = ui_gallery | push({ slug: "checkout_steps", name: "CheckoutSteps", group: "Commerce",
    summary: "Cart → Details → Payment → Done: the steps of a checkout, those done as links back, the current one marked.",
    tags: ["commerce", "checkout", "navigation", "progress", "no-js"], demo: CheckoutStepsDemo })
