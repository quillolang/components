let funnel_chart_demo_grid = "display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 32px 40px"

view FunnelChartDemo() =
    <div style={funnel_chart_demo_grid}>
        <FunnelChart label="Checkout this month" show_label={true} stages={[
            { label: "Visited", value: 12400 }, { label: "Viewed a product", value: 7820 },
            { label: "Added to cart", value: 3100 }, { label: "Checked out", value: 1240 }, { label: "Paid", value: 980 }]}/>
        <FunnelChart label="Hiring" show_label={true} tapered={false} conversion={false} height={30} stages={[
            { label: "Applied", value: 420 }, { label: "Screened", value: 160 }, { label: "Interviewed", value: 48 },
            { label: "Offered", value: 9 }, { label: "Hired", value: 7 }]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "funnel_chart", name: "FunnelChart", group: "Charts",
    summary: "Stages of a process narrowing like a funnel, each with its count and share of the first, and the share that went on between them.",
    tags: ["chart", "data", "dashboard", "no-js"],
    demo: FunnelChartDemo })
