let checkout_sheet_demo_lines = [
    { id: "boots", name: "Trail boots", price: "129.00", qty: 1 },
    { id: "socks", name: "Wool socks", price: "7.35", qty: 3 },
]

let checkout_sheet_demo_ways = [
    { id: "std", label: "Standard", price: "4.95", days: 5 },
    { id: "fast", label: "Next day", price: "12.00", days: 1 },
]

component CheckoutSheetDemoLive() {
    state said = "Nothing paid yet."
    state pays = 0
    state again = 0
    state lines = checkout_sheet_demo_lines
    <div.demo-stack>
        <div.demo-row>
            <CheckoutSheet key={again} lines={lines} deliveries={checkout_sheet_demo_ways} tax_rate="0.08" today="2026-11-01" id="checkout-demo"
                           cards={[{ id: "visa", label: "Visa ending 4242" }]}
                           on_pay={(o) => {
                               pays += 1
                               said = `Paying ${o.totals.total} by ${o.payment.kind}, ${o.delivery.id}, to ${o.address.postcode}, call ${pays}`
                               // The next day's answer comes later, as a server fn's does, as a Promise; standard's at once.
                               let fine = o.address.name != "Dee Clined"
                               if o.address.name == "Quiet Answer" { return js("Promise.resolve", js_new("Promise", (done) => { done() })) }
                               o.delivery.id == "std" ? fine : js("Promise.resolve", js_new("Promise", (done) => { done(fine) }))
                           }}/>
            <Button id="checkout-demo-again" variant="ghost" size="lg" on_click={() => { again += 1; lines = checkout_sheet_demo_lines }}>New order</Button>
            <Button id="checkout-demo-empty" variant="ghost" size="lg" on_click={() => { lines = [] }}>Empty the cart</Button>
        </div>
        <p.demo-note id="checkout-demo-said">{said}</p>
    </div>
}

view CheckoutSheetDemo() = <CheckoutSheetDemoLive/>

ui_gallery = ui_gallery | push({ slug: "checkout_sheet", name: "CheckoutSheet", group: "Mobile",
    summary: "A one-screen checkout in a sheet with address, delivery, payment and a live total, every part validated, and a slide to pay.",
    tags: ["mobile", "interactive", "commerce", "sheet", "payment", "tablet"],
    needs: ["cart_sheet"],
    demo: CheckoutSheetDemo })
