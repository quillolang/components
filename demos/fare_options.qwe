let fare_options_demo_fares = [
    { id: "basic", name: "Basic", price: 89.00m, note: "Seat given at check-in", features: [
        { label: "Personal item", value: true }, { label: "Cabin bag", value: false }, { label: "Checked bag", value: "fee" },
        { label: "Seat choice", value: "fee" }, { label: "Changes", value: false }, { label: "Refund", value: false }] },
    { id: "classic", name: "Classic", price: 119.00m, badge: "Most chosen", features: [
        { label: "Personal item", value: true }, { label: "Cabin bag", value: "8 kg" }, { label: "Checked bag", value: "1 × 23 kg" },
        { label: "Seat choice", value: "Standard seats" }, { label: "Changes", value: "fee" }, { label: "Refund", value: false }] },
    { id: "flex", name: "Flex", price: 189.00m, features: [
        { label: "Personal item", value: true }, { label: "Cabin bag", value: "8 kg" }, { label: "Checked bag", value: "2 × 23 kg" },
        { label: "Seat choice", value: "Any seat, extra legroom too" }, { label: "Changes", value: "Free, up to 2 h before" },
        { label: "Refund", value: true }] },
]

component FareOptionsDemoLive() {
    state note = "Pick a fare: on_change gets it."
    <div.demo-stack>
        <FareOptions id="fare-options-demo" name="trip" passengers={2} value="classic" fares={fare_options_demo_fares}
                     on_change={(f) => { note = `on_change: ${f.id}, ${f.total} in all.` }}/>
        <p.demo-note id="fare-options-demo-note">{note}</p>
    </div>
}

view FareOptionsDemo() =
    <div.demo-stack>
        <FareOptionsDemoLive/>
        <FareOptions id="fare-options-demo-eur" name="rail" label="Lisbon to Porto, Alfa Pendular" passengers={3} currency="EUR" locale="de-DE" fares={[
            { id: "turistica", name: "Turística", price: 31.20m, features: [{ label: "Seat", value: "2nd class" }, { label: "Changes", value: "fee" }] },
            { id: "conforto", name: "Conforto", price: 44.30m, features: [{ label: "Seat", value: "1st class" }, { label: "Changes", value: true }] },
            { id: "promo", name: "Promo", price: 15.50m, disabled: true, note: "Sold out", features: [{ label: "Changes", value: false }] }]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "fare_options", name: "FareOptions", group: "Travel",
    summary: "Fare families side by side, Basic to Flex: the price a person and over the cheapest, what each includes, costs extra or leaves out, and the total for everyone.",
    tags: ["travel", "flights", "forms", "commerce", "interactive"], demo: FareOptionsDemo })
