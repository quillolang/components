view PageHeaderDemo() =
    <div.demo-stack style="gap: 32px">
        <PageHeader title="Orders" description="Everything bought this month, newest first."
                    breadcrumb={<Breadcrumbs items={[{ label: "Home", href: "#" }, { label: "Shop", href: "#" }, { label: "Orders" }]}/>}
                    actions={[<Button variant="outline" id="page-header-demo-export">Export</Button>, <Button>New order</Button>]}>
            <Tabs>
                <Tab group="page-header-demo-tabs" label="All" selected={true}></Tab>
                <Tab group="page-header-demo-tabs" label="Open"></Tab>
                <Tab group="page-header-demo-tabs" label="Shipped"></Tab>
            </Tabs>
        </PageHeader>
        <PageHeader title="Ada Lovelace" eyebrow="Customer" back="#page_header" back_label="All customers"
                    avatar={<Avatar name="Ada Lovelace" size="lg"/>}
                    meta={[<Badge tone="success">Active</Badge>, <span>Since March 2024</span>, <span>12 orders</span>]}
                    actions={<Button variant="outline" size="sm">Edit</Button>} divider={false}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "page_header", name: "PageHeader", group: "Layout",
    summary: "A page's top: breadcrumb, title, a line about it, small facts and the actions, with room under it for tabs.",
    tags: ["layout", "page", "navigation", "no-js"], demo: PageHeaderDemo })
