let leaderboard_demo_people = [
    { id: "u3", name: "Katherine Johnson", score: 1105, meta: "38 answers" },
    { id: "u1", name: "Ada Lovelace", score: 1280, meta: "42 answers", href: "#ada" },
    { id: "u5", name: "Hedy Lamarr", score: 720, meta: "19 answers" },
    { id: "u2", name: "Alan Turing", score: 1105, meta: "35 answers" },
    { id: "u4", name: "Margaret Hamilton", score: 940, meta: "27 answers" },
    { id: "u6", name: "Grace Hopper", score: 610, meta: "15 answers" },
    { id: "u7", name: "Linus Torvalds", score: 480, meta: "11 answers" },
]

view LeaderboardDemo() =
    <div.demo-row style="align-items: flex-start; gap: 24px">
        <div style="flex: 1 1 300px; max-width: 420px">
            <Leaderboard id="leaderboard-demo-week" label="Top answerers this week" unit="pts" limit={5} you="u7" items={leaderboard_demo_people}/>
        </div>
        <div style="flex: 1 1 240px; max-width: 320px">
            <Leaderboard id="leaderboard-demo-race" label="5 km, fastest first" order="asc" medals={false} unit="min" items={[
                { name: "Sol", score: 21.4 }, { name: "Mika", score: 19.75 }, { name: "Ade", score: 24.1 },
            ]}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "leaderboard", name: "Leaderboard", group: "Data",
    summary: "People ranked by score with medals for the top three, shared places for ties, and your own row kept in view.",
    tags: ["data", "list", "social", "user", "no-js"], demo: LeaderboardDemo })
