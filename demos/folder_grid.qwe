let folder_grid_demo_items = [
    { id: "f1", name: "Contracts", kind: "folder", count: 12 },
    { id: "f2", name: "Photos", kind: "folder", count: 1 },
    { id: "f3", name: "Archive", kind: "folder" },
    { id: "d1", name: "Q3 report.pdf", size: 2483112 },
    { id: "d2", name: "Budget 2027.xlsx", size: 84211 },
    { id: "d3", name: "Team offsite.jpg", size: 3912004 },
    { id: "d4", name: "Brand assets.zip", size: 18440230 },
    { id: "d5", name: "notes.md", size: 812 },
]

component FolderGridDemoLive() {
    state picked = ["d1"]
    state opened = "Nothing opened."
    <div.demo-stack>
        <FolderGrid id="fg-drive" name="picked" label="My drive" items={folder_grid_demo_items} selected={["d1"]}
                    on_select={(ids) => { picked = ids }} on_open={(it) => { opened = `Opened ${it.name}.` }}/>
        <p.demo-note>Picked: {len(picked) == 0 ? "none" : join(picked, ", ")}. {opened}</p>
    </div>
}

view FolderGridDemo() =
    <div.demo-stack>
        <FolderGridDemoLive/>
        <FolderGrid id="fg-single" label="Pick a cover" multiple={false} items={take(folder_grid_demo_items, 3)}/>
        <FolderGrid id="fg-empty" label="Trash" items={[]} empty="The trash is empty."/>
    </div>

ui_gallery = ui_gallery | push({ slug: "folder_grid", name: "FolderGrid", group: "Data",
    summary: "Folders and files as tiles picked like a file manager: click, Ctrl/⌘ and Shift, arrow keys by row, Space, Ctrl+A, Enter or double-click to open.",
    tags: ["file", "grid", "keyboard", "interactive"],
    demo: FolderGridDemo })
