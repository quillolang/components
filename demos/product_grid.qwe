let product_grid_demo_items = [
    { id: 1, name: "Trail runner", brand: "Northwind", price: 89, old: 120, image: "https://picsum.photos/seed/runner/400/300", rating: 4.5, reviews: 128, badge: "Sale", badge_tone: "danger" },
    { id: 2, name: "Wool beanie", brand: "Northwind", price: 24, image: "https://picsum.photos/seed/beanie/400/300", rating: 4, reviews: 37, stock: "low" },
    { id: 3, name: "Insulated bottle", price: 32.5, image: "https://picsum.photos/seed/bottle/400/300", rating: 3.8, reviews: 9, badge: "New" },
    { id: 4, name: "Rain jacket", price: 149, image: "https://picsum.photos/seed/jacket/400/300", stock: "out" },
    { id: 5, name: "Day pack, 22 l", price: 64, image: "https://picsum.photos/seed/pack/400/300", rating: 4.7, reviews: 211 },
    { id: 6, name: "Merino socks, 3 pairs", price: 29, old: 36, image: "https://picsum.photos/seed/socks/400/300", rating: 4.2, reviews: 54 },
]

component ProductGridDemoLive() {
    state last = null
    <div.demo-stack>
        <ProductGrid products={product_grid_demo_items} size={180} card_size="sm" on_add={(p) => { last = p.name }}/>
        <p.demo-note>{last == null ? "Click Add to cart on any card." : `Added "${last}" (on_add is given the product).`}</p>
    </div>
}

view ProductGridDemo() =
    <div.demo-stack>
        <ProductGridDemoLive/>
        <ProductGrid products={[]} />
    </div>

ui_gallery = ui_gallery | push({ slug: "product_grid", name: "ProductGrid", group: "Commerce",
    summary: "Products as ProductCards in a grid that fits as many across as there is room for, from a list of records.",
    tags: ["commerce", "grid", "card", "list", "price"],
    needs: ["price", "product_card"], demo: ProductGridDemo })
