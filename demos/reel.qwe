view ReelDemoCard(i: int) =
    <Card title={`Episode ${i}`} subtitle={`${18 + i * 3} min`} padding="sm">
        <div style={`height: 70px; border-radius: var(--ui-radius-sm); background: linear-gradient(135deg, var(--ui-accent-soft), var(--ui-${i % 2 == 0 ? "info" : "success"}-soft))`}></div>
    </Card>

view ReelDemo() =
    <div.demo-stack>
        <Reel id="reel-demo-episodes" label="Episodes" item_width="200px">
            {for i in range(1, 13) => <ReelDemoCard i={i}/>}
        </Reel>
        <Reel id="reel-demo-days" label="Days" gap="sm" snap="center" bar={false} pad={4}>
            {for d in ["Mon 3", "Tue 4", "Wed 5", "Thu 6", "Fri 7", "Sat 8", "Sun 9", "Mon 10", "Tue 11", "Wed 12", "Thu 13", "Fri 14", "Sat 15", "Sun 16", "Mon 17", "Tue 18"] =>
                <Button variant={d == "Wed 5" ? "soft" : "outline"} size="sm">{d}</Button>}
        </Reel>
        <p.demo-note>Swipe, scroll sideways, or focus a strip and use the arrow keys. The first snaps to each card's start, the second to each day's middle, with no scrollbar.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "reel", name: "Reel", group: "Layout",
    summary: "A strip that scrolls sideways and snaps to each item, with a slim scrollbar or none, and the keyboard.",
    tags: ["layout", "list", "mobile", "no-js"], demo: ReelDemo })
