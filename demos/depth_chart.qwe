// An order book from a seeded random walk (Park–Miller), the same on every render:
// `count` levels a side, `tick` apart, around `mid`, sizes growing away from it.
fn depth_chart_demo_book(seed: int, mid: num, tick: num, count: int, base: num) -> map {
    let s = seed
    let rnd = () => {
        s = s * 16807 % 2147483647
        s / 2147483647
    }
    let level = (k) => round(base * (0.3 + rnd() * 1.4) * (1 + k * 0.06) * 1000) / 1000
    let bids = for k in range(count) => { price: round((mid - tick / 2 - k * tick) * 100) / 100, size: level(k) }
    let asks = for k in range(count) => { price: round((mid + tick / 2 + k * tick) * 100) / 100, size: level(k) }
    { bids, asks }
}

let depth_chart_demo_btc = depth_chart_demo_book(5, 61250, 5, 40, 0.9)
let depth_chart_demo_acme = depth_chart_demo_book(12, 182.4, 0.05, 30, 400)

view DepthChartDemo() =
    <div.demo-stack>
        <div id="depth_chart-demo-btc">
            <DepthChart label="BTC-USD depth" show_label={true} bids={depth_chart_demo_btc.bids} asks={depth_chart_demo_btc.asks}
                        unit=" BTC" decimals={1}/>
        </div>
        <div id="depth_chart-demo-acme" class="demo-narrow" style="max-width: 520px">
            <DepthChart label="ACME, within 0.5% of the mid" show_label={true} bids={depth_chart_demo_acme.bids}
                        asks={depth_chart_demo_acme.asks} prefix="$" spread={0.5} height={180}/>
        </div>
        <p.demo-note>Hover the depth for the size waiting up to that price and what it is worth.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "depth_chart", name: "DepthChart", group: "Charts",
    summary: "An order book's bids and asks as stepped areas of the size waiting at each price or better, around the mid price, with the spread.",
    tags: ["chart", "data", "trading", "no-js"],
    demo: DepthChartDemo })
