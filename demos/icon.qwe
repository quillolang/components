view IconDemo() =
    <div.demo-stack>
        <div.demo-row id="icon-demo-sizes">
            <Icon name="search" size="xs"/>
            <Icon name="search" size="sm"/>
            <Icon name="search"/>
            <Icon name="search" size="lg"/>
            <Icon name="search" size="xl"/>
            <Icon name="search" px={48} stroke={1.5}/>
        </div>
        <div.demo-row id="icon-demo-text" style="gap: 18px">
            <span><Icon name="calendar"/> Tuesday 4 November</span>
            <span style="color: var(--ui-danger)"><Icon name="warning" label="Warning"/> Disk almost full</span>
            <span style="color: var(--ui-success)"><Icon name="check-circle"/> Saved</span>
            <a href="https://quillolang.org" style="color: var(--ui-accent)">Docs <Icon name="external" size="sm"/></a>
        </div>
        <div.demo-row id="icon-demo-all" style="gap: 10px; color: var(--ui-muted)">
            {for n in icon_names => <Icon name={n} label={n} size="lg"/>}
        </div>
        <div.demo-row>
            <span id="icon-demo-missing"><Icon name="no-such-icon"/></span>
            <p.demo-note>An unknown name draws the help icon.</p>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "icon", name: "Icon", group: "Media",
    summary: "Eighty common icons by name, drawn inline as SVG in the text's colour, in five sizes or any pixel size.",
    tags: ["icon", "media", "no-js"], demo: IconDemo })
