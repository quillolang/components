component ListGroupDemoLive() {
    state folder = "inbox"
    <div.demo-stack.demo-narrow>
        <ListGroup id="list-group-demo-folders" label="Folders" on_select={(v) => { folder = v }}
                   items={[
                       { label: "Inbox", value: "inbox", badge: 12, badge_tone: "accent", active: folder == "inbox" },
                       { label: "Starred", value: "starred", active: folder == "starred" },
                       { label: "Drafts", value: "drafts", description: "Not sent yet", badge: 2, badge_tone: "warning", active: folder == "drafts" },
                       { label: "Spam", value: "spam", disabled: true, meta: "Off" },
                   ]}/>
        <p.demo-note>Showing {folder}.</p>
    </div>
}

view ListGroupDemo() =
    <div.demo-stack>
        <div.demo-row style="align-items: flex-start; gap: 24px">
            <div style="flex: 1 1 260px; max-width: 340px">
                <ListGroup id="list-group-demo-links" label="Settings" items={[
                    { label: "Profile", href: "#profile", description: "Name, photo and bio", active: true },
                    { label: "Notifications", href: "#notifications", badge: "New", badge_tone: "success" },
                    { label: "Billing", href: "#billing", meta: "Pro plan" },
                    { label: "Danger zone", href: "#danger", badge: 1, badge_tone: "danger" },
                ]}/>
            </div>
            <div style="flex: 1 1 260px; max-width: 340px">
                <ListGroupDemoLive/>
            </div>
        </div>
        <div.demo-row style="align-items: flex-start; gap: 24px">
            <div style="flex: 1 1 260px; max-width: 340px">
                <ListGroup id="list-group-demo-steps" numbered={true} size="sm" label="Release steps" items={[
                    { label: "Tag the commit", meta: "done" }, { label: "Build the binaries", meta: "3 min" }, { label: "Publish the notes" },
                ]}/>
            </div>
            <div style="flex: 1 1 260px; max-width: 340px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius); padding: 0 12px">
                <ListGroup id="list-group-demo-flush" flush={true} label="Recent">
                    <ListGroupItem href="#q3" meta="2 h ago">Q3 <b>report</b>.pdf</ListGroupItem>
                    <ListGroupItem href="#logo" meta="Yesterday" badge="v2">logo.svg</ListGroupItem>
                    <ListGroupItem disabled={true}>archive.zip (deleted)</ListGroupItem>
                </ListGroup>
            </div>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "list_group", name: "ListGroup", group: "Data",
    summary: "A bordered list of items with descriptions, badges and notes, as links, buttons or text, one active and some disabled.",
    tags: ["data", "list", "navigation", "no-js"], demo: ListGroupDemo })
