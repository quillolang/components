// A drawing of a car in a colour, as a data: address, so the demo needs no network.
fn car_rental_card_demo_car(color: str) -> str =
    "data:image/svg+xml," + url_encode(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 90"><ellipse cx="100" cy="80" rx="90" ry="6" fill="#0002"/><path d="M14 62v-14l22-6 26-22h62l30 22 30 6v14z" fill="${color}"/><path d="M68 24h24v18H50zM98 24h24l22 18H98z" fill="#cfe3f5"/><circle cx="52" cy="66" r="14" fill="#222"/><circle cx="52" cy="66" r="6" fill="#bbb"/><circle cx="152" cy="66" r="14" fill="#222"/><circle cx="152" cy="66" r="6" fill="#bbb"/><rect x="176" y="50" width="10" height="5" rx="2" fill="#ffd27a"/></svg>`)

view CarRentalCardDemo() =
    <div.demo-stack>
        <CarRentalCard id="car-rental-card-demo-golf" category="Compact" model="Volkswagen Golf" image={car_rental_card_demo_car("#3d7bd9")}
                       seats={5} bags={1} small_bags={2} doors={5} transmission="manual" air_con={true} mileage="Unlimited mileage"
                       fuel_policy="Full to full" supplier="Rentway" supplier_score={8.4} pickup="Lisbon Airport, in the terminal"
                       pickup_note="Desk in arrivals, open 06:00 to 00:00" price={34.50m} days={7} deposit={900}
                       included={["Free cancellation", "Collision damage waiver", "Theft protection"]} badge="Great value" href="#rentway-golf"/>
        <CarRentalCard id="car-rental-card-demo-ev" category="Electric SUV" model="Tesla Model Y" similar={false} image={car_rental_card_demo_car("#c8323a")}
                       seats={5} bags={3} transmission="automatic" electric={true} range="455 km" mileage="1,500 km included" supplier="Volt Hire"
                       pickup="Porto, Avenida dos Aliados" pickup_note="Shuttle from the airport, 10 min" price={89} days={3} total={249.00m}
                       currency="EUR" locale="de-DE"/>
        <CarRentalCard id="car-rental-card-demo-min" category="Economy" model="Fiat Panda" price={21.90m}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "car_rental_card", name: "CarRentalCard", group: "Travel",
    summary: "A hire car offer: class and model or similar, seats, bags, gearbox and air conditioning, mileage and fuel policy, supplier rating, pick-up and the price a day and in all.",
    tags: ["travel", "cars", "card", "commerce", "no-js"], demo: CarRentalCardDemo })
