// A picture needs no file here: an SVG in the address, of one colour with a word on it.
fn story_viewer_demo_img(colour: str, word: str) =
    "data:image/svg+xml," + url_encode(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 90 160"><rect width="90" height="160" fill="${colour}"/><text x="45" y="84" fill="#fff" font-size="14" font-family="sans-serif" text-anchor="middle">${word}</text></svg>`)

// A sound stands in for a video here: a second of silence as WAV, which a <video> plays too.
let story_viewer_demo_video = "data:audio/wav;base64,UklGRp4LAABXQVZFZm10IBAAAAABAAEAuAsAALgLAAABAAgASlVOSwIAAAAAAGRhdGFwCwAA" + repeat("gICA", 1000)

let story_viewer_demo_stories = [
    { id: "ana", name: "Ana Silva", time: "2 h", items: [
        { src: story_viewer_demo_img("#2f6f9f", "Dawn"), alt: "The bridge at dawn" },
        { text: "Open on Monday", bg: "#5b4bdb" },
        { src: story_viewer_demo_img("#8a4b2d", "Noon"), alt: "The bridge at noon", text: "From the mill" } ] },
    { id: "gone", name: "Nothing to show", items: [] },
    { id: "ben", name: "Ben Oduya", time: "5 h", items: [
        { src: story_viewer_demo_img("#2d7a4f", "Lift"), alt: "The first lift", seconds: "soon" },
        { src: story_viewer_demo_video, type: "video", alt: "The crane at work" } ] },
    { id: "cleo", name: "Cleo", items: [{ text: "Last one", bg: "#a33" }] }
]

component StoryViewerDemoLive() {
    state seen = []
    state closed = 0
    state showing = false
    <div.demo-stack>
        <div.demo-phone id="story-viewer-demo" style="height: 560px; display: grid; place-items: center">
            <StoryViewer id="story-viewer-live" trigger="Watch the stories" seconds={1.5} modal={false} stories={story_viewer_demo_stories}
                         on_seen={(s, n) => { seen = seen + [`${s}${n}`] }} on_close={() => { closed += 1 }}/>
        </div>
        <p.demo-note id="story-viewer-note" data-closed={closed}>Seen: {join(seen, " ")}</p>
        <Button size="lg" id="story-viewer-state" on_click={() => { showing = true }}>Open from state, over the whole page</Button>
        <StoryViewer id="story-viewer-modal" open={showing} start={2} stories={story_viewer_demo_stories} on_close={() => { showing = false }}/>
    </div>
}

view StoryViewerDemo() =
    <div.demo-stack>
        <StoryViewerDemoLive/>
        <p.demo-note>Open from the start, with nothing to close it from outside:</p>
        <div.demo-phone id="story-viewer-start" style="height: 320px">
            <StoryViewer id="story-viewer-load" open={true} modal={false} seconds={600} stories={[{ id: "cleo", name: "Cleo", items: [{ text: "Open as the page loads", bg: "#2d7a4f" }] }]}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "story_viewer", name: "StoryViewer", group: "Mobile",
    summary: "Stories with segmented progress: hold to pause, tap to go on or back, swipe down to leave, with the next ones fetched ahead.",
    tags: ["mobile", "interactive", "stories", "gesture", "media", "tablet"], demo: StoryViewerDemo })
