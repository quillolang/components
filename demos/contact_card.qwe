view ContactCardDemo() =
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; align-items: start">
        <ContactCard id="contact-card-demo-grace" name="Grace Hopper" title="Rear admiral" company="US Navy"
                     email="grace@example.com" phone="+1 (555) 010-0100" website="https://example.com"
                     address="1 Navy Way, Arlington, VA 22202"/>
        <ContactCard name="Ada Lovelace" title="Analytical engineer" src="https://i.pravatar.cc/112?img=32"
                     email="ada@example.com" phone="+44 20 7946 0100" map={false} address="Ockham Park, Surrey">
            <Button size="sm" variant="soft">Message</Button>
        </ContactCard>
        <ContactCard id="contact-card-demo-plain" name="Plato" company="The Academy" email="plato@example.com" vcard={false}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "contact_card", name: "ContactCard", group: "Data",
    summary: "A person's contact details as tel:, mailto: and map links, with a vCard to download in one tap.",
    tags: ["card", "user", "profile", "record", "no-js"],
    needs: ["avatar"],
    demo: ContactCardDemo })
