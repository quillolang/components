component IconButtonDemoLive() {
    state starred = false
    <div.demo-row>
        <IconButton label="Star" pressed={starred} variant="outline" on_click={() => { starred = !starred }}>
            <svg viewBox="0 0 24 24" fill={starred ? "currentColor" : "none"} stroke="currentColor" stroke-width="2"
                 stroke-linejoin="round" aria-hidden="true"><path d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1Z"/></svg>
        </IconButton>
        <span.demo-note>{starred ? "Starred" : "Not starred"} (a toggle, with your own icon)</span>
    </div>
}

view IconButtonDemo() =
    <div.demo-stack>
        <div.demo-row>
            {for i in ["plus", "x", "check", "edit", "trash", "search", "copy", "more", "menu", "settings", "chevron-down"] =>
                <IconButton icon={i} label={i}/>}
        </div>
        <div.demo-row>
            <IconButton icon="plus" label="Add" variant="solid" tone="accent"/>
            <IconButton icon="edit" label="Edit" variant="soft" tone="accent"/>
            <IconButton icon="settings" label="Settings" variant="outline" href="#icon_button"/>
            <IconButton icon="trash" label="Delete" tone="danger"/>
            <IconButton icon="x" label="Close" size="sm" round={true}/>
            <IconButton icon="search" label="Search" size="lg" variant="outline" round={true}/>
            <IconButton icon="copy" label="Copy" disabled={true}/>
        </div>
        <IconButtonDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "icon_button", name: "IconButton", group: "Actions",
    summary: "A square button with an icon, labelled for screen readers and on hover; built-in icons or your own.",
    tags: ["forms", "button", "icon", "no-js"],
    demo: IconButtonDemo })
