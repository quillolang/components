let ranked_vote_demo_ballots = "42: Memphis > Nashville > Chattanooga > Knoxville\n26: Nashville > Chattanooga > Knoxville > Memphis\n15: Chattanooga > Knoxville > Nashville > Memphis\n17: Knoxville > Chattanooga > Nashville > Memphis"

component RankedVoteDemoLive() {
    state seen = null
    <div.demo-stack>
        <RankedVote id="ranked-vote-demo-club" title="Club chair" name="club" tie_rule="first" candidates={["Ada", "Bo", "Cy"]}
                    ballots={[{ ranking: ["Ada", "Bo"], count: 4 }, { ranking: ["Bo", "Ada"], count: 3 }, { ranking: ["Cy"], count: 2 }, ["Cy", "Bo"]]}
                    on_change={(r) => { seen = r }}/>
        <p.demo-note>{seen == null ? "Change it to see on_change." : `on_change: ${seen.winner ?? "no one"} in ${seen.rounds} rounds, ${seen.exhausted} exhausted.`}</p>
    </div>
}

view RankedVoteDemo() =
    <div.demo-stack>
        <RankedVote id="ranked-vote-demo" title="Where should the capital be?" ballots={ranked_vote_demo_ballots}/>
        <RankedVoteDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "ranked_vote", name: "RankedVote", group: "Social",
    summary: "Counts ranked ballots by instant runoff, round by round, showing each transfer and exhausted ballot, with a stated rule for breaking ties.",
    tags: ["smart", "interactive", "voting", "election", "ranked", "poll"], demo: RankedVoteDemo })
