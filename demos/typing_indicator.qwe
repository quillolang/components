component TypingIndicatorDemoLive() {
    state who = ["Ana Silva"]
    let all = ["Ana Silva", "Ben Okafor", "Lee Chen", "Mia Rossi"]
    <div.demo-stack>
        <div id="typing-indicator-demo-live"><TypingIndicator names={who} first_names={true}/></div>
        <div.demo-row>
            {for p in all => <label key={p} style="display: inline-flex; gap: 6px; align-items: center; font-size: 13px">
                <input type="checkbox" checked={contains(who, p)} value={p}
                       @change={(e) => { who = e.checked ? all | filter((x) => x == p || contains(who, x)) : who | filter((x) => x != p) }}/>
                {p}
            </label>}
        </div>
    </div>
}

view TypingIndicatorDemo() =
    <div.demo-stack>
        <TypingIndicatorDemoLive/>
        <div id="typing-indicator-demo-plain"><TypingIndicator names={["Ana Silva", "Ben Okafor", "Lee Chen"]}/></div>
        <div.demo-note id="typing-indicator-demo-inline">Support <TypingIndicator names={["Sam"]} dots={false} text="is looking into it…"/></div>
    </div>

ui_gallery = ui_gallery | push({ slug: "typing_indicator", name: "TypingIndicator", group: "Social",
    summary: "\"Ana is typing…\" with pulsing dots, naming one, two or more people, and nothing at all when nobody is.",
    tags: ["social", "chat", "status", "no-js"], demo: TypingIndicatorDemo })
