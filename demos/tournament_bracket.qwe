component TournamentBracketDemoLive() {
    state seen = null
    <div.demo-stack>
        <TournamentBracket id="tournament-bracket-demo-four" title="Club final four" name="club" entrants={["Rovers", "United", "City", "Town"]}
                           results={{ "0-0": 1 }} on_change={(b) => { seen = b }}/>
        <p.demo-note>{seen == null ? "Pick a winner to see on_change." : `on_change: ${seen.decided} of ${seen.matches} decided, champion ${filled(seen.champion) ?? "not yet known"}.`}</p>
    </div>
}

view TournamentBracketDemo() =
    <div.demo-stack>
        <TournamentBracket id="tournament-bracket-demo" title="Chess club knockout" entrants={["Ada", "Bo", "Cy", "Di", "Ed", "Flo"]}/>
        <TournamentBracketDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "tournament_bracket", name: "TournamentBracket", group: "Social",
    summary: "A single-elimination draw from seeds, with byes and correct pairing: clicking winners moves them on, and changing a result clears what rested on it.",
    tags: ["smart", "interactive", "bracket", "tournament", "seeds", "games"], demo: TournamentBracketDemo })
