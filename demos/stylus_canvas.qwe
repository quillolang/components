let stylus_canvas_demo_start = [
    { color: "ink", points: [[120, 620, 3], [260, 560, 5], [420, 600, 6], [560, 540, 5], [700, 590, 3]] },
    { color: "#0b6bcb", points: [[200, 300, 4], [300, 240, 7], [420, 260, 9], [520, 330, 6]] },
]

component StylusCanvasDemoLive() {
    state note = "2 strokes."
    state out = ""
    state last = ""
    <div.demo-stack>
        <div.demo-tablet>
            <StylusCanvas strokes={stylus_canvas_demo_start} name="stylus-demo" label="Sketch"
                          on_change={(s) => { note = `${len(s)} strokes.` }}
                          on_export={(kind, data) => {
                              out = `${kind}: ${slice(data, 0, 22)}`
                              last = data
                          }}/>
        </div>
        <p.demo-note id="stylus-canvas-note">{note}</p>
        <p.demo-note id="stylus-canvas-out" data-out={last}>{out}</p>
        <div id="stylus-canvas-bad" hidden="true"><StylusCanvas strokes={[null, 3, { points: "x" }, { points: [[1], "a"] }, { color: 9, points: [[1, 2, 3]] }]} name="stylus-bad"/></div>
    </div>
}

view StylusCanvasDemo() = <StylusCanvasDemoLive/>

ui_gallery = ui_gallery | push({ slug: "stylus_canvas", name: "StylusCanvas", group: "Mobile",
    summary: "Draw with a pen by pressure and tilt, palm rejected, with undo, eraser, zoom, and an image or strokes out.",
    tags: ["mobile", "tablet", "interactive", "pen", "drawing", "gesture"],
    demo: StylusCanvasDemo })
