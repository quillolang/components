fn swipe_viewer_demo_pic(fill: str, word: str) =
    "data:image/svg+xml," + url_encode(`<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 600 800'><rect width='600' height='800' fill='${fill}'/><circle cx='300' cy='380' r='190' fill='#ffffff33'/><text x='300' y='400' font-size='56' text-anchor='middle' fill='#fff' font-family='sans-serif'>${word}</text></svg>`)

let swipe_viewer_demo_photos = [
    { src: swipe_viewer_demo_pic("#3d5a80", "One"), alt: "The harbour", caption: "Oban, at low tide" },
    { src: swipe_viewer_demo_pic("#ee6c4d", "Two"), alt: "A red boat", caption: "The Mary Ann, home at last" },
    { src: swipe_viewer_demo_pic("#6d8f71", "Three"), alt: "The hill" },
    { src: swipe_viewer_demo_pic("#7a5195", "Four"), alt: "Evening" },
    { src: swipe_viewer_demo_pic("#293241", "Five"), alt: "The pier" },
    { src: swipe_viewer_demo_pic("#98c1d9", "Six"), alt: "Morning" },
    swipe_viewer_demo_pic("#bc5090", "Seven"),
    { src: "" },
]

component SwipeViewerDemoLive() {
    state viewing = false
    state from = 0
    state ended = "none"
    state seen = "none"
    state photos = swipe_viewer_demo_photos
    <div.demo-stack>
        <div.demo-row>
            {for [i, p] in enumerate(swipe_viewer_clean(photos)) => <button key={i} type="button" data-open={i} aria-label={`Open photo ${i + 1}`}
                    style="width: 56px; height: 56px; padding: 0; border: 0; border-radius: 8px; overflow: hidden; cursor: pointer"
                    @click={() => { from = i; viewing = true }}>
                <img src={p.src} alt="" style="display: block; width: 100%; height: 100%; object-fit: cover"/>
            </button>}
        </div>
        <SwipeViewer open={viewing} start={from} photos={photos} label="Holiday photos"
                     on_change={(i) => { seen = `${i}` }}
                     on_close={(i) => { viewing = false; from = i; ended = `${i}` }}/>
        <p.demo-note id="swipev-demo-note">Closed on {ended}; on {seen}</p>
        <div id="swipev-demo-none"><SwipeViewer photos={null} open={true}/></div>
        <Button id="swipev-demo-again" size="lg" variant="ghost" on_click={() => { viewing = true }}>Open again</Button>
        <Button id="swipev-demo-more" size="lg" variant="ghost" on_click={() => { photos = photos | push(swipe_viewer_demo_pic("#111111", "More")) }}>Load one more</Button>
    </div>
}

view SwipeViewerDemo() = <SwipeViewerDemoLive/>

ui_gallery = ui_gallery | push({ slug: "swipe_viewer", name: "SwipeViewer", group: "Mobile",
    summary: "Photos swiped sideways, pulled down to close and zoomed, the next ones loaded ahead and the place kept.",
    tags: ["mobile", "interactive", "photos", "viewer", "zoom", "tablet"],
    demo: SwipeViewerDemo })
