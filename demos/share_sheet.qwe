component ShareSheetDemoLive() {
    state sharing = false
    state how = null
    <div.demo-row>
        <Button variant="soft" on_click={() => { sharing = true }}>Invite (from state)</Button>
        <span.demo-note>{how == null ? "Not shared yet." : `Shared by ${how}.`}</span>
        <ShareSheet title="Invite to the project" url="https://quillolang.org/join/7f3a" text="Join my project on Quillo"
                    targets={["copy", "email", "whatsapp", "telegram"]} open={sharing}
                    on_share={(t) => { how = t }} on_close={() => { sharing = false }}/>
    </div>
}

view ShareSheetDemo() =
    <div.demo-row>
        <ShareSheet url="https://quillolang.org/components/" text="Quillo UI: components for Quillo" trigger="Share"/>
        <ShareSheetDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "share_sheet", name: "ShareSheet", group: "Overlays",
    summary: "A bottom sheet with the ways to share a link: copy it, email, X, LinkedIn, WhatsApp and more, and the system's own.",
    tags: ["social", "dialog", "overlay", "mobile", "interactive"],
    demo: ShareSheetDemo })
