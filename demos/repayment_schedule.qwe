let repayment_schedule_demo_loan = [
    { due: "2026-05-24", amount: 318.77, paid: 318.77, paid_on: "2026-05-22" },
    { due: "2026-06-24", amount: 318.77, paid: 318.77, paid_on: "2026-06-23" },
    { due: "2026-07-24", amount: 318.77, paid: 318.77, paid_on: "2026-07-24" },
    { due: "2026-08-24", amount: 318.77, paid: 318.77, paid_on: "2026-08-21" },
    { due: "2026-09-24", amount: 318.77, paid: 318.77, paid_on: "2026-09-29", note: "Paid 5 days late" },
    { due: "2026-10-24", amount: 318.77 },
    { due: "2026-11-24", amount: 318.77 },
    { due: "2026-12-24", amount: 318.77 },
    { due: "2027-01-24", amount: 318.77 },
]

view RepaymentScheduleDemo() {
    <div.demo-stack>
        <RepaymentSchedule id="repayment-schedule-demo-loan" installments={repayment_schedule_demo_loan} today="2026-10-29" past={3}
                           penalty_rate={0.05} penalty_fee={10} grace_days={3} pay_action="#pay"/>
        <RepaymentSchedule id="repayment-schedule-demo-small" label="Business loan installments" summary={false} currency="EUR" locale="de-DE"
                           today="2026-10-29" pay_action="#pay-business" pay_label="Zahlen"
                           installments={[{ n: 7, due: "2026-09-30", amount: 1250, paid: 1250, paid_on: "2026-09-30" },
                                          { n: 8, due: "2026-10-15", amount: 1250, paid: 400, paid_on: "2026-10-16", penalty: 12.5 },
                                          { n: 9, due: "2026-10-29", amount: 1250 }]}/>
    </div>
}

ui_gallery = ui_gallery | push({ slug: "repayment_schedule", name: "RepaymentSchedule", group: "Finance",
    summary: "A loan's installments, past and to come: paid, due or overdue with the days late and the penalty, and a pay button on the next one.",
    tags: ["finance", "loans", "table", "banking", "no-js"], demo: RepaymentScheduleDemo })
