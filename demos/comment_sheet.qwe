let comment_sheet_demo_rows = [
    { id: 1, name: "Ana Silva", text: "The north side looks finished from here.", at: "2026-10-30T09:00:00", time: "2 d", likes: 4 },
    { id: 2, parent: 1, name: "Ben Oduya", text: "Nearly. The fence goes up on Tuesday.", at: "2026-10-30T10:00:00", time: "2 d", likes: 1 },
    { id: 3, parent: 2, name: "Cleo Hart", text: "Tuesday morning?", at: "2026-10-30T11:00:00", time: "2 d" },
    { id: 4, parent: 1, name: "Rui Costa", text: "Good work, all.", mine: true, at: "2026-10-30T12:00:00", time: "2 d" },
    { id: 5, name: "Dee Marsh", text: "Who took the photo?", at: "2026-10-31T08:00:00", time: "1 d", likes: 9 },
    { id: 6, name: "Rui Costa", text: "Me, from the mill roof.", mine: true, at: "2026-11-01T07:00:00", time: "1 h" },
    { id: 7, parent: 99, name: "Eli Ross", text: "The comment this answered is gone.", at: "2026-10-29T07:00:00", time: "3 d", likes: 2 },
    { id: 8, parent: 9, name: "Ana Silva", text: "Parents in a loop are no trouble.", at: "2026-10-28T07:00:00", time: "4 d" },
    { id: 9, parent: 8, name: "Ben Oduya", text: "Nor is the other half of it.", at: "2026-10-28T08:00:00", time: "4 d" },
    { id: 1, name: "Ana Silva", text: "A repeated id is shown once." },
    { text: "Nor one with no id at all." }
]

component CommentSheetDemoLive() {
    state note = "Nothing yet."
    state seen = -1
    state showing = false
    state tint = "plain"
    <div.demo-stack>
        <div.demo-phone id="comment-sheet-demo" style="height: 620px; display: grid; place-items: center">
            <CommentSheet id="comment-sheet-live" trigger="Comments" modal={false} class={`demo-${tint}`} me="Rui Costa" total={40} comments={comment_sheet_demo_rows}
                          on_add={(c) => { note = `Added ${c.id} under ${c.parent ?? "none"}: ${c.text}` }}
                          on_remove={(ids) => { note = `Removed ${join(ids | map((i) => str(i)), ",")}` }}
                          on_like={(id, on) => { note = `Like ${id} ${on}` }}
                          on_count={(n) => { seen = n }}/>
        </div>
        <p.demo-note id="comment-sheet-note" data-count={seen}>{note}</p>
        <Button size="lg" variant="outline" id="comment-sheet-tint" on_click={() => { tint = tint == "plain" ? "other" : "plain" }}>Change a prop</Button>
        <Button size="lg" id="comment-sheet-state" on_click={() => { showing = true }}>Open from state, over the whole page</Button>
        <CommentSheet id="comment-sheet-modal" open={showing} sort="new" comments={[]} on_close={() => { showing = false }}/>
    </div>
}

view CommentSheetDemo() =
    <div.demo-stack>
        <CommentSheetDemoLive/>
        <p.demo-note>Open from the start, with nothing to close it from outside:</p>
        <div.demo-phone id="comment-sheet-start" style="height: 420px">
            <CommentSheet id="comment-sheet-load" open={true} modal={false} comments={[{ id: 1, name: "Ana", text: "Open as the page loads." }]}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "comment_sheet", name: "CommentSheet", group: "Mobile",
    summary: "Comments in a sheet: threads, a reply bar above the keyboard, sort, and a count that stays right. A column at the side on a tablet.",
    tags: ["mobile", "interactive", "comments", "sheet", "keyboard", "tablet"], needs: ["composer_bar"], demo: CommentSheetDemo })
