// Orders as an API sends them: ids, names (one with a comma and quotes, one with a
// pipe, one with an apostrophe), emails, amounts with cents, yes/no, dates,
// date-times with offsets, nulls, a nested address and a list of tags.
let json_export_table_demo_orders = [
    { id: 1001, customer: "Ada Lovelace", email: "ada@example.com", total: 129.99, paid: true, placed: "2026-10-02",
      shipped_at: "2026-10-03T09:15:00Z", coupon: null, ship_to: { city: "London", zip: "N1 9GU" }, tags: ["vip"] },
    { id: 1002, customer: "Grace \"Amazing\" Hopper, Rear Adm.", email: "grace@example.com", total: 45.5, paid: false, placed: "2026-10-04",
      shipped_at: null, coupon: "FALL10", ship_to: { city: "New York", zip: "10001" }, tags: [] },
    { id: 1003, customer: "Smith | Sons", email: "orders@smith-sons.example", total: 1200, paid: true, placed: "2026-09-28",
      shipped_at: "2026-09-29T17:40:00+02:00", coupon: null, ship_to: { city: "Paris", zip: "75011" }, tags: ["wholesale", "net-30"] },
    { id: 1004, customer: "Siobhán O'Brien", email: "siobhan@example.ie", total: 8.05, paid: true, placed: "2026-10-11",
      shipped_at: "2026-10-12T08:00:00Z", coupon: "WELCOME", ship_to: null, tags: [] },
    { id: 1005, customer: "Linus\tTorvalds", email: null, total: 310.4, paid: false, placed: "2026-10-15",
      shipped_at: null, coupon: null, ship_to: { city: "Portland", zip: "97201" }, tags: ["beta"] },
    { id: 1006, customer: "Margaret <Hamilton> & co", email: "mh@example.com", total: 75, paid: true, placed: "2026-10-01",
      shipped_at: "2026-10-01T23:05:00Z", coupon: null, ship_to: { city: "Boston", zip: "02110" }, tags: ["vip"] },
]

// A JSON answer with its list of records further down, and values that are not all one type.
let json_export_table_demo_api = `{
  "data": {
    "page": 1,
    "products": [
      { "sku": "BOLT-M6", "name": "Hex bolt M6", "price": "0.12", "stock": 1200, "weight_kg": 0.004, "active": "yes", "site": "https://example.com/p/bolt-m6" },
      { "sku": "NUT-M6", "name": "Nut M6\\nzinc plated", "price": "0.08", "stock": 5400, "weight_kg": 0.002, "active": "no", "site": "https://example.com/p/nut-m6" },
      { "sku": "WASH-6", "name": "Washer 6mm", "price": "0.03", "stock": "n/a", "weight_kg": 0.0011, "active": "yes", "site": null }
    ]
  }
}`

view JsonExportTableDemo() =
    <div.demo-stack>
        <JsonExportTable id="jxt-orders" label="Orders" rows={json_export_table_demo_orders} filename="orders" currency="USD" exclude={["tags"]}/>
        <p.demo-note>Each header shows its column's type: change it from the menu, sort by clicking the name, include or move columns under Columns, then export or copy.</p>
        <JsonExportTable id="jxt-products" label="Products" value={json.parse(json_export_table_demo_api)} path={["data", "products"]}
                         filename="products" format="sql" order_by="price" descending={true} height="260px"/>
    </div>

ui_gallery = ui_gallery | push({ slug: "json_export_table", name: "JsonExportTable", group: "Data",
    summary: "JSON records as a table with a type for each column (numbers, money, dates, yes/no, links, nested), sorted by type, exported as CSV, TSV, JSON, JSON Lines, Excel, Markdown, HTML, SQL or XML.",
    tags: ["data", "table", "json", "export", "interactive"],
    demo: JsonExportTableDemo })
