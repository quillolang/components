let dock_demo_items = [
    { label: "Home", href: "#dock", icon: "M3 11l9-8 9 8v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z" },
    { label: "Search", href: "#search", icon: "M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14zM20 20l-4-4" },
    { label: "Inbox", href: "#inbox", icon: "M4 4h16v16H4zM4 14h4l2 3h4l2-3h4", badge: 3 },
    { label: "You", href: "#me", icon: "M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM4 20a8 8 0 0 1 16 0" }
]

component DockDemoLive() {
    state tool = "pen"
    <div.demo-stack>
        <Dock id="dock-demo-tools" label="Tools" side="bottom" fixed={false} labels={false} current={tool}
              items={[{ label: "Pen", value: "pen", icon: "✎" }, { label: "Eraser", value: "eraser", icon: "◻" },
                      { label: "Text", value: "text", icon: "T" }, { label: "Shapes", value: "shapes", icon: "◯", disabled: true }]}
              on_select={(v) => { tool = v }}/>
        <p.demo-note>Tool: {tool}. Press one; the names are tooltips (labels={"{false}"}).</p>
    </div>
}

view DockDemo() =
    <div.demo-stack>
        <div id="dock-demo-phone" style="position: relative; height: 260px; overflow: hidden; border: 1px solid var(--ui-border); border-radius: var(--ui-radius); background: var(--ui-subtle); transform: translateZ(0)">
            <p style="margin: 0; padding: 16px; color: var(--ui-muted); font-size: 13px">A page (the box stands in for the window): the dock floats over its bottom.</p>
            <Dock id="dock-demo-main" items={dock_demo_items} current="#dock"/>
            <Dock id="dock-demo-side" label="Shortcuts" side="left" labels={false}
                  items={[{ label: "New", href: "#new", icon: "+" }, { label: "Star", href: "#star", icon: "★" }]}/>
        </div>
        <DockDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "dock", name: "Dock", group: "Layout",
    summary: "A floating bar of icon buttons fixed to the bottom or a side of the page, with badges and the current one marked.",
    tags: ["layout", "navigation", "mobile", "button", "no-js"], demo: DockDemo })
