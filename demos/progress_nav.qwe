let progress_nav_demo_steps = [
    { label: "Cart", href: "#pn-cart", hint: "3 items" },
    { label: "Delivery", href: "#pn-delivery", hint: "Lisbon" },
    { label: "Payment", href: "#pn-payment" },
    { label: "Review", href: "#pn-review" }
]

component ProgressNavDemoLive() {
    state at = 1
    <div.demo-stack>
        <ProgressNav id="progress-nav-demo-live" steps={progress_nav_demo_steps} current={at} ahead={true}
                     on_select={(i) => { at = i }}/>
        <p.demo-note>Step {at + 1} of 4: {progress_nav_demo_steps[at].label}. Every step is a link (ahead), and clicking one goes there.</p>
    </div>
}

view ProgressNavDemo() =
    <div.demo-stack style="gap: 28px">
        <ProgressNav id="progress-nav-demo" steps={progress_nav_demo_steps} current={2}/>
        <ProgressNavDemoLive/>
        <div style="max-width: 280px">
            <ProgressNav vertical={true} current={4} label="Setup" steps={[
                { label: "Create account", href: "#pn-1" }, { label: "Verify email", href: "#pn-2" },
                { label: "Pick a plan", href: "#pn-3" }, { label: "Invite the team", href: "#pn-4" }
            ]}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "progress_nav", name: "ProgressNav", group: "Navigation",
    summary: "Numbered steps as links: the ones done link back, this one is marked, and the ones to come wait their turn.",
    tags: ["navigation", "progress", "link", "checkout", "no-js"], demo: ProgressNavDemo })
