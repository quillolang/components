// The next trade of a seeded random walk (Park–Miller): the same on the server and in
// the browser. Trades come a second apart from 14:30:00 on 2026-10-28.
fn trade_feed_demo_trade(n: int) -> map {
    let s = (n * n * 7919 + n * 104729 + 1) % 2147483647
    let rnd = () => {
        s = s * 16807 % 2147483647
        s / 2147483647
    }
    rnd()
    let up = rnd()
    let size = round((rnd() < 0.08 ? 1.5 + rnd() * 3 : 0.01 + rnd() * 0.6) * 1000) / 1000
    { id: n, time: 1793197800000 + n * 1000, price: round((61250 + (up - 0.5) * 40 + math.sin(n / 6) * 25) * 10) / 10,
      size, side: up >= 0.5 ? "buy" : "sell" }
}

component TradeFeedDemoLive() {
    state trades = for n in range(14) => trade_feed_demo_trade(n)
    state live = true
    if live {
        every(600, () => { trades = trades + [trade_feed_demo_trade(len(trades))] })
    }
    <div.demo-stack id="trade_feed-demo-live">
        <TradeFeed trades={trades} limit={12} large={1.5} unit=" BTC" decimals={1} height={300} label="BTC-USD trades"/>
        <p.demo-note>
            A trade every 0.6 s ({len(trades)} so far); trades of 1.5 BTC or more stand out.
        </p>
        <div.demo-row>
            <Button size="sm" variant="outline" id="trade_feed-demo-toggle" on_click={() => { live = !live }}>{live ? "Stop the feed" : "Start the feed"}</Button>
        </div>
    </div>
}

view TradeFeedDemo() =
    <div.demo-stack>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px">
            <TradeFeedDemoLive/>
            <div id="trade_feed-demo-still">
                <TradeFeed label="ACME trades" prefix="$" limit={5} trades={[
                    { id: "a", time: "2026-10-28T15:59:56Z", price: 182.4, size: 300, side: "buy" },
                    { id: "b", time: "2026-10-28T15:59:57Z", price: 182.41, size: 1200, side: "buy" },
                    { id: "c", time: "2026-10-28T15:59:58Z", price: 182.39, size: 100, side: "sell" },
                    { id: "d", time: "2026-10-28T15:59:59Z", price: 182.39, size: 25000, side: "sell" }]} large={10000}/>
            </div>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "trade_feed", name: "TradeFeed", group: "Charts",
    summary: "Time and sales: trades as they happen, newest first, buys green and sells red, large ones picked out, capped at a number of rows.",
    tags: ["data", "trading", "table", "interactive"],
    demo: TradeFeedDemo })
