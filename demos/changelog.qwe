view ChangelogDemo() =
    <Changelog id="changelog-demo" level={4} releases={[
        { version: "1.8.0", title: "Autumn", date: "2026-10-28", tag: "Latest", summary: "Dark mode everywhere, and exports.", changes: {
            Fixed: ["The date picker skipped February in leap years"],
            Added: ["Dark mode, following the system", "CSV export of any table"],
            Changed: ["Buttons are 2px taller"],
        } },
        { version: "1.7.2", date: "2026-10-02", href: "#v1.7.2", tag: "Security", tag_tone: "danger", changes: [
            { kind: "Security", text: "File names in the upload log are escaped" },
            { kind: "Fixed", text: "Sessions survive a server restart" },
        ] },
        { version: "1.7.0", date: "2026-09-14", changes: {
            Deprecated: ["The old `theme` prop: use `tone`"], Removed: ["Internet Explorer support"], Docs: ["A page on forms"],
        } },
    ]}/>

ui_gallery = ui_gallery | push({ slug: "changelog", name: "Changelog", group: "Data",
    summary: "Releases with version, date and label, their changes grouped by kind: Added, Changed, Fixed, Security and the rest.",
    tags: ["data", "list", "document", "no-js"], demo: ChangelogDemo })
