// A small drawing of a hillside at sunset, in an SVG, so the demo needs no file.
let photo_editor_demo_pic = "data:image/svg+xml," + url_encode("<svg xmlns='http://www.w3.org/2000/svg' width='640' height='480'><rect width='640' height='480' fill='#f6c177'/><circle cx='460' cy='150' r='60' fill='#ea6f5a'/><path d='M0 330 L200 240 L380 320 L640 230 V480 H0Z' fill='#3f6f5f'/><path d='M0 400 L260 340 L640 410 V480 H0Z' fill='#27463c'/></svg>")

component PhotoEditorDemoLive() {
    state got = null
    <form.demo-stack method="post" action="/" enctype="multipart/form-data">
        <PhotoEditor name="photo" src={photo_editor_demo_pic} alt="A hillside at sunset" on_done={(p) => { got = p }}/>
        <p.demo-note id="photo-editor-demo-note">{got == null ? "Not saved yet." : `on_done got ${got.name}, ${got.width} by ${got.height}.`}</p>
    </form>
}

view PhotoEditorDemo() =
    <div.demo-stack>
        <PhotoEditorDemoLive/>
        <p.demo-note>Everything happens on the phone. Done leaves a real file in the form.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "photo_editor", name: "PhotoEditor", group: "Mobile",
    summary: "Rotates, crops with handles, changes the light and straightens by finger in a canvas, with undo, and gives back the image as a file.",
    tags: ["mobile", "interactive", "photo", "editor", "image", "forms"], needs: ["button"], demo: PhotoEditorDemo })
