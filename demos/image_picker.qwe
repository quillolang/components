// A picture as a data URL: a coloured square with a letter on it.
fn image_picker_demo_img(color: str, letter: str) -> str =
    `data:image/svg+xml,${url_encode(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><rect width="100" height="100" fill="${color}"/><text x="50" y="64" font-family="sans-serif" font-size="44" font-weight="700" fill="#fff" text-anchor="middle">${letter}</text></svg>`)}`

let image_picker_demo_avatars = [
    { value: "fox", src: image_picker_demo_img("#e5484d", "F"), label: "Fox" },
    { value: "owl", src: image_picker_demo_img("#5b4bdb", "O"), label: "Owl" },
    { value: "bear", src: image_picker_demo_img("#18794e", "B"), label: "Bear" },
    { value: "cat", src: image_picker_demo_img("#a35200", "C"), label: "Cat", disabled: true },
]

component ImagePickerDemoLive() {
    state theme = "dawn"
    <div.demo-stack>
        <ImagePicker name="ip-demo-theme" label="Theme" value={theme} shape="wide" size={140}
                     options={[{ value: "dawn", src: image_picker_demo_img("#f76b15", "Dawn"), label: "Dawn" },
                               { value: "sea", src: image_picker_demo_img("#0b6bcb", "Sea"), label: "Sea" },
                               { value: "night", src: image_picker_demo_img("#1c2024", "Night"), label: "Night" }]}
                     on_change={(v) => { theme = v }}/>
        <p.demo-note>The {theme} theme is on.</p>
    </div>
}

view ImagePickerDemo() =
    <div.demo-stack>
        <ImagePicker name="ip-demo-avatar" label="Avatar" value="owl" shape="circle" options={image_picker_demo_avatars}
                     hint="The arrow keys move the choice."/>
        <ImagePickerDemoLive/>
        <ImagePicker name="ip-demo-cover" label="Cover" columns={3} captions={false} required={true} error="Choose a cover."
                     options={[{ value: "a", src: image_picker_demo_img("#8e4ec6", "1"), label: "Purple" },
                               { value: "b", src: image_picker_demo_img("#12a594", "2"), label: "Teal" },
                               { value: "c", src: image_picker_demo_img("#d6409f", "3"), label: "Pink" }]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "image_picker", name: "ImagePicker", group: "Forms",
    summary: "One of several pictures chosen by its thumbnail: real radios under the pictures, so a form sends the choice and the arrow keys move it.",
    tags: ["forms", "input", "image", "picker", "no-js"], demo: ImagePickerDemo })
