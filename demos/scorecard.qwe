view ScorecardDemo() =
    <div.demo-stack>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 12px">
            <Scorecard id="scorecard-demo-perf" label="Performance" score={92} hint="Largest paint 1.1 s"/>
            <Scorecard id="scorecard-demo-seo" label="SEO" score={64} hint="3 pages lack a description"/>
            <Scorecard id="scorecard-demo-quiz" label="Quiz" score={4} limit={10} grade="Retry" verdict="Not yet" tone="accent"/>
        </div>
        <Scorecard id="scorecard-demo-a11y" label="Accessibility" score={71} size="lg" hint="5 issues to fix" items={[
            { label: "Contrast", score: 18, limit: 25 },
            { label: "Labels and names", score: 20, limit: 25 },
            { label: "Keyboard", score: 25, limit: 25 },
            { label: "Structure", score: 8, limit: 25 },
        ]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "scorecard", name: "Scorecard", group: "Data",
    summary: "A score out of a maximum as a filled ring, with a letter grade, a verdict and the parts it is made of.",
    tags: ["data", "dashboard", "chart", "progress", "no-js"], demo: ScorecardDemo })
