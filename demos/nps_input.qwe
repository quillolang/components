component NpsInputDemoLive() {
    state score = null
    <div.demo-stack>
        <NpsInput name="nps_live" label="How likely are you to recommend Quillo to a friend?" field="nps-input-demo-live" value={score}
                  on_change={(n) => { score = n }}/>
        <p.demo-note>{score == null ? "No score yet." : `Score ${score}: a ${nps_input_group(score)}.`}</p>
    </div>
}

view NpsInputDemo() =
    <div.demo-stack>
        <NpsInput name="nps" value={9} field="nps-input-demo-plain" hint="0 to 6 count against, 9 and 10 for." required={true}/>
        <NpsInputDemoLive/>
        <NpsInput name="nps_plain" label="Without the colours" tones={false} low="Never" high="Always"
                  field="nps-input-demo-neutral" error="Choose a score."/>
    </div>

ui_gallery = ui_gallery | push({ slug: "nps_input", name: "NpsInput", group: "Forms",
    summary: "The eleven scores 0 to 10 of a Net Promoter question in a row, with the words at the ends: real radios posted with a form.",
    tags: ["forms", "input", "feedback", "no-js"], demo: NpsInputDemo })
