let keyboard_bar_demo_css = css`
.keyboard-bar-demo-form { display: grid; gap: 12px; padding: 16px; height: 100%; box-sizing: border-box; overflow: auto; }
.keyboard-bar-demo-form label { display: grid; gap: 4px; font: 500 14px var(--ui-font); color: var(--ui-fg); }
.keyboard-bar-demo-form input, .keyboard-bar-demo-form select, .keyboard-bar-demo-form textarea {
  box-sizing: border-box; width: 100%; min-height: 46px; padding: 8px 10px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius-sm);
  background: var(--ui-surface); color: var(--ui-fg); font: 16px var(--ui-font);
}
`

component KeyboardBarDemoLive() {
    state done = 0
    <div.demo-stack>
        <div.demo-tablet id="keyboard-bar-demo-frame">
            <KeyboardBar class="keyboard-bar-demo-form" on_done={() => { done += 1 }}>
                <label for="keyboard-bar-demo-name">Name<input id="keyboard-bar-demo-name" name="name" autocomplete="name"/></label>
                <label for="keyboard-bar-demo-mail">Email<input id="keyboard-bar-demo-mail" name="email" type="email" autocomplete="email"/></label>
                <label for="keyboard-bar-demo-off">Member number (locked)<input id="keyboard-bar-demo-off" value="4471" disabled={true}/></label>
                <label for="keyboard-bar-demo-town">Town<select id="keyboard-bar-demo-town"><option>Cebu City</option><option>Davao</option></select></label>
                <div style="height: 300px"></div>
                <label for="keyboard-bar-demo-note">Note<textarea id="keyboard-bar-demo-note" rows={3}></textarea></label>
                <label for="keyboard-bar-demo-code">Promo code<input id="keyboard-bar-demo-code"/></label>
            </KeyboardBar>
        </div>
        <p.demo-note id="keyboard-bar-demo-out">Done pressed {done} times. Tap a field: on a phone the bar rides on the keyboard.</p>
    </div>
}

view KeyboardBarDemo() =
    <div>
        <style>{keyboard_bar_demo_css}</style>
        <KeyboardBarDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "keyboard_bar", name: "KeyboardBar", group: "Mobile",
    summary: "A bar that sits on top of the on-screen keyboard by visualViewport, with previous, next and done, moved with the keyboard on both systems.",
    tags: ["mobile", "interactive", "keyboard", "toolbar", "forms"],
    demo: KeyboardBarDemo })
