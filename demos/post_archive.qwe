let post_archive_demo_posts = [
    { title: "Islands, resumed: how a page wakes up", href: "#post_archive-islands", date: "2026-10-14" },
    { title: "Week notes: 43", href: "#post_archive-wn43", date: "2026-10-24T18:20:00Z" },
    { title: "Streaming the slow parts of a page", href: "#post_archive-defer", date: "2026-10-02" },
    { title: "Decimals, and why money needs them", href: "#post_archive-decimals", date: "2026-09-18" },
    { title: "One file to deploy", href: "#post_archive-deploy", date: "2026-07-21" },
    { title: "A year of Quillo", href: "#post_archive-year", date: "2025-12-30" },
    { title: "Hello, world", href: "#post_archive-hello", date: "2025-12-01" },
    { title: "Plugins in Rust", href: "#post_archive-rust", date: "2025-06-09" },
    { title: "A draft with no date yet", href: "#post_archive-draft" },
]

view PostArchiveDemo() =
    <div class="demo-row" style="align-items: start; gap: 40px">
        <div style="flex: 1 1 360px; max-width: 520px">
            <PostArchive id="post-archive-demo" title="Archive" posts={post_archive_demo_posts} year_href="#post_archive-{year}"/>
        </div>
        <div style="flex: 0 1 220px">
            <PostArchive id="post-archive-demo-compact" posts={post_archive_demo_posts} show_posts={false} open={[2026, "2025"]}
                         month_href="#post_archive-{year}-{month}" locale="fr-FR"/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "post_archive", name: "PostArchive", group: "Blogging",
    summary: "A blog's posts by year and month, newest first: each year a disclosure with its count, its months and their posts, or only the months as links.",
    tags: ["blogging", "navigation", "list", "archive", "no-js"], demo: PostArchiveDemo })
