// A made-up market: [symbol, name, sector, market value in billions, price, change in %].
let market_heatmap_demo_rows = [
    ["NOVA", "Nova Systems", "Technology", 2950, 412.3, 1.84], ["PIXL", "Pixel Labs", "Technology", 2410, 188.2, 0.62],
    ["CHIP", "Chipworks", "Technology", 1820, 121.6, 3.9], ["CLDX", "Cloudex", "Technology", 640, 302.1, -1.2],
    ["BYTE", "Bytewise", "Technology", 310, 72.4, -0.35], ["SOFT", "Softline", "Technology", 220, 54.9, 0.1],
    ["MEDI", "Medica", "Health", 820, 96.4, -0.8], ["CURE", "Curegen", "Health", 610, 151.2, -2.6],
    ["VITA", "Vitalis", "Health", 340, 44.8, 0.4], ["DOSE", "Dosewell", "Health", 120, 18.3, 5.2],
    ["BANK", "First Ledger", "Finance", 720, 211.5, 0.9], ["PAYX", "Payrails", "Finance", 530, 98.7, 1.3],
    ["CRED", "Credo", "Finance", 260, 33.1, -0.2], ["MALL", "Mallway", "Consumer", 1980, 186.4, -1.7],
    ["FIZZ", "Fizz Co.", "Consumer", 290, 61.2, 0.25], ["SHOE", "Stride", "Consumer", 150, 112.9, -3.4],
    ["OILX", "Petrox", "Energy", 470, 108.6, 2.2], ["SUNR", "Sunrise Power", "Energy", 95, 23.4, -4.1],
    ["GRID", "Gridline", "Utilities", 140, 71.8, 0],
]
let market_heatmap_demo_items = market_heatmap_demo_rows
    | map((r) => { symbol: r[0], name: r[1], sector: r[2], cap: r[3] * 1000000000, price: r[4], change: r[5] })

view MarketHeatmapDemo() =
    <div.demo-stack>
        <div id="market_heatmap-demo-market">
            <MarketHeatmap label="A market today, by sector" show_label={true} items={market_heatmap_demo_items} prefix="$"/>
        </div>
        <div id="market_heatmap-demo-crypto" style="max-width: 460px">
            <MarketHeatmap label="Coins, coloured to ±8%" show_label={true} ratio={1.6} limit={8} prefix="$"
                           items={[{ symbol: "BTC", cap: 1200, change: 2.1, price: 61250 }, { symbol: "ETH", cap: 290, change: -3.4, price: 2410 },
                                   { symbol: "SOL", cap: 70, change: 7.9, price: 152 }, { symbol: "BNB", cap: 85, change: 0.4, price: 580 },
                                   { symbol: "XRP", cap: 30, change: -9.5, price: 0.52 }, { symbol: "ADA", cap: 14, change: 1.1, price: 0.39 }]}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "market_heatmap", name: "MarketHeatmap", group: "Charts",
    summary: "A treemap of stocks sized by market value and coloured by their change, grouped by sector, with each one's details on hover.",
    tags: ["chart", "data", "trading", "dashboard", "no-js"],
    demo: MarketHeatmapDemo })
