let parallel_coordinates_demo_cars = [
    { name: "Civic", origin: "Japan", price: 24000, hp: 158, weight: 1280, mpg: 36 },
    { name: "Corolla", origin: "Japan", price: 22000, hp: 139, weight: 1310, mpg: 35 },
    { name: "Miata", origin: "Japan", price: 29000, hp: 181, weight: 1060, mpg: 30 },
    { name: "Golf", origin: "Europe", price: 27000, hp: 147, weight: 1340, mpg: 32 },
    { name: "3 Series", origin: "Europe", price: 45000, hp: 255, weight: 1570, mpg: 28 },
    { name: "911", origin: "Europe", price: 115000, hp: 379, weight: 1500, mpg: 20 },
    { name: "Model 3", origin: "USA", price: 42000, hp: 283, weight: 1760, mpg: null },
    { name: "Mustang", origin: "USA", price: 33000, hp: 315, weight: 1690, mpg: 22 },
    { name: "F-150", origin: "USA", price: 38000, hp: 290, weight: 2100, mpg: 20 },
]

view ParallelCoordinatesDemo() =
    <div.demo-stack>
        <ParallelCoordinates label="Cars compared" show_label={true} group_field="origin" records={parallel_coordinates_demo_cars}
                             axes={[{ field: "price", label: "Price", prefix: "$" }, { field: "hp", label: "Power", suffix: " hp" },
                                    { field: "weight", label: "Weight", suffix: " kg" }, { field: "mpg", label: "Economy", suffix: " mpg", zero: true }]}/>
        <p.demo-note>The Model 3 has no mpg, so its line stops at Weight.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "parallel_coordinates", name: "ParallelCoordinates", group: "Charts",
    summary: "Each record as a line across several upright axes, each with its own scale, coloured by group, picked out on hover.",
    tags: ["chart", "data", "no-js"],
    demo: ParallelCoordinatesDemo })
