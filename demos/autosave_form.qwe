let autosave_form_demo_fields = [
    { name: "title", label: "Title", required: true, placeholder: "Short and clear" },
    { name: "body", label: "Your story", type: "textarea", hint: "Kept as you type." },
    { name: "topic", label: "Topic", type: "select", options: ["Travel", "Food", "Work"] },
    { name: "public", label: "Show it to everyone", type: "checkbox" },
    { name: "code", label: "Access code", type: "password", hint: "Never kept in a draft." },
]

component AutosaveFormDemoLive() {
    state visit = 1
    state said = "Send it to see on_submit."
    state last = ""
    <div.demo-stack>
        <AutosaveForm key={visit} id="autosave-form-demo" store="demo-story" every_ms={100} fields={autosave_form_demo_fields}
                      on_submit={(v) => { said = `on_submit: ${v.title}` }} on_status={(s) => { last = s }}/>
        <div.demo-row>
            <button type="button" data-visit="true" @click={() => { visit += 1 }}>Come back later</button>
            <span.demo-note data-last="true">{`on_status: ${last}`}</span>
        </div>
        <p.demo-note data-said="true">{said}</p>
    </div>
}

view AutosaveFormDemo() = <AutosaveFormDemoLive/>

ui_gallery = ui_gallery | push({ slug: "autosave_form", name: "AutosaveForm", group: "Forms",
    summary: "Keeps a draft in the browser as it is typed, offers to restore or discard it, says when saving failed, and works with storage blocked.",
    tags: ["smart", "interactive", "form", "draft", "autosave", "storage"], demo: AutosaveFormDemo })
