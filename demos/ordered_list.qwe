view OrderedListDemo() =
    <div.demo-stack>
        <div.demo-row style="align-items: flex-start; gap: 40px">
            <OrderedList id="ordered-list-demo-numbers" items={["Install Quillo", "Run the gallery", "Copy a component into your program"]}/>
            <OrderedList id="ordered-list-demo-circles" variant="circles" tone="accent" items={["Create an account", "Verify your email", "Add a card"]}/>
            <OrderedList id="ordered-list-demo-letters" variant="letters" start={3} spacing="tight" items={["Third", "Fourth"]}/>
        </div>
        <div.demo-row style="align-items: flex-start; gap: 40px">
            <OrderedList id="ordered-list-demo-roman" variant="roman" size="sm" items={["Preface", "Introduction", "Chapter one"]}/>
            <OrderedList id="ordered-list-demo-plain" variant="plain" items={["The browser's own numbers", "In the kit's colour"]}/>
            <OrderedList id="ordered-list-demo-kids" tone="fg" spacing="loose">
                <li>Written <b>by hand</b></li>
                <li>With a nested list:
                    <OrderedList variant="letters" items={["one", "two"]}/>
                </li>
            </OrderedList>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "ordered_list", name: "OrderedList", group: "Typography",
    summary: "A numbered list with styled counters: numbers, circles, letters or roman numerals, from any start.",
    tags: ["typography", "list", "text", "no-js"],
    demo: OrderedListDemo })
