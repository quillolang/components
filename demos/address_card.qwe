component AddressCardDemoLive() {
    state did = null
    <div.demo-stack style="width: 300px">
        <AddressCard id="a2" name="Grace Hopper" street="1 Infinite Loop" city="Cupertino" region="CA" postcode="95014" country="United States"
                     email="grace@example.com" kind="Billing" on_edit={() => { did = "edit" }} on_remove={() => { did = "remove" }}/>
        <p.demo-note>{did == null ? "Edit and Remove call on_edit and on_remove." : `Clicked ${did}.`}</p>
    </div>
}

view AddressCardDemo() =
    <div.demo-row style="align-items: flex-start; gap: 20px">
        <div style="width: 300px">
            <AddressCard id="a1" name="Ada Lovelace" lines={["12 St James's Square", "London SW1Y 4JH", "United Kingdom"]}
                         phone="+44 20 7946 0000" kind="Shipping" default={true} action="/addresses" removable={false}/>
        </div>
        <AddressCardDemoLive/>
        <div style="width: 300px">
            <AddressCard name="Linus Torvalds" street="Kaivokatu 8" city="Helsinki" postcode="00100" country="Finland" selected={true} edit_href="#address_card"/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "address_card", name: "AddressCard", group: "Commerce",
    summary: "A saved address with a Default badge and Edit and Remove, as submit buttons in a plain form or callbacks.",
    tags: ["commerce", "checkout", "card", "record", "user", "no-js"], demo: AddressCardDemo })
