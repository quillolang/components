fn sticky_section_feed_demo_rows(tag: str, n: int) -> list =
    range(0, n) | map((i) => { id: `${tag}-${i}`, title: `${tag} item ${i + 1}`, text: i % 2 == 0 ? "Harbour Cafe" : "Station Diner", meta: `−${i + 3}.20` })

let sticky_section_feed_demo_sections = [
    { date: "2026-10-20", items: sticky_section_feed_demo_rows("Older", 6) },
    { date: "2026-10-27", items: sticky_section_feed_demo_rows("Tuesday", 7) },
    { date: "2026-10-30", items: sticky_section_feed_demo_rows("Friday", 5) },
    { date: "2026-10-31", items: sticky_section_feed_demo_rows("Yesterday", 6) },
    { date: "2026-11-01", items: sticky_section_feed_demo_rows("Today", 8) },
    { date: "2026-11-02", items: sticky_section_feed_demo_rows("Tomorrow", 5) },
    { date: "2026-11-20", items: sticky_section_feed_demo_rows("Later", 7) },
    { date: "2027-01-05", items: sticky_section_feed_demo_rows("Next year", 7) }
]

component StickySectionFeedDemoLive() {
    state picked = "none"
    state sec = "none"
    <div.demo-stack>
        <div.demo-phone style="height: 600px">
            <StickySectionFeed id="secfeed-demo" sections={sticky_section_feed_demo_sections} today="2026-11-01" height="100%" label="Activity"
                               on_select={(it) => { picked = it.title }} on_section={(n) => { sec = str(n) }}/>
        </div>
        <p.demo-note>Picked <b data-picked>{picked}</b>; section <b data-sec>{sec}</b></p>
        <div.demo-phone style="height: 300px">
            <StickySectionFeed id="secfeed-start" sections={sticky_section_feed_demo_sections} today="2026-11-01" height="100%" start_today={true}/>
        </div>
        <div.demo-phone style="height: 300px">
            <StickySectionFeed id="secfeed-near" today="2026-11-10" height="100%" today_text="Closest" sections={[
                { date: "2026-11-01", items: sticky_section_feed_demo_rows("Early", 6) },
                { date: "2026-11-08", items: sticky_section_feed_demo_rows("Near", 6) },
                { date: "2026-11-12", items: sticky_section_feed_demo_rows("Tie", 6) }]}/>
        </div>
        <StickySectionFeed id="secfeed-bad" height="170px" sections={[null, { date: "2026-13-40", items: [{ title: "Bad date" }] }, { title: "Own title", items: [null, { title: "Fine" }] }, { items: "x" }]}/>
        <StickySectionFeed id="secfeed-none" height="100px" empty="No activity"/>
    </div>
}

view StickySectionFeedDemo() = <StickySectionFeedDemoLive/>

ui_gallery = ui_gallery | push({ slug: "sticky_section_feed", name: "StickySectionFeed", group: "Mobile",
    summary: "Sections whose header sticks and is replaced by the next as you scroll, with a date-style floating label, and jump to today.",
    tags: ["mobile", "interactive", "tablet", "feed", "date", "list"],
    demo: StickySectionFeedDemo })
