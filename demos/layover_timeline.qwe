view LayoverTimelineDemo() =
    <div class="demo-row" style="align-items: start">
        <LayoverTimeline id="layover-timeline-demo-lis" legs={[
            { from: { code: "LHR", city: "London", name: "Heathrow", time: "07:45", date: "2026-11-05", terminal: "2" },
              to: { code: "LIS", city: "Lisbon", name: "Humberto Delgado", time: "10:20", date: "2026-11-05", terminal: "1" },
              airline: "TAP Air Portugal", flight: "TP 1351", minutes: 155, aircraft: "Airbus A320neo", cabin: "Economy", layover: 50 },
            { from: { code: "LIS", city: "Lisbon", time: "11:10", date: "2026-11-05", terminal: "1" },
              to: { code: "JFK", city: "New York", name: "John F. Kennedy", time: "14:20", date: "2026-11-05", terminal: "1" },
              airline: "TAP Air Portugal", flight: "TP 207", minutes: 490, aircraft: "Airbus A330-900", cabin: "Economy" }]}/>
        <LayoverTimeline id="layover-timeline-demo-asia" title="Copenhagen to Singapore" legs={[
            { from: { code: "CPH", city: "Copenhagen", time: "18:05", date: "2026-12-12", terminal: "3" },
              to: { code: "LHR", city: "London", time: "19:00", date: "2026-12-12", terminal: "2" },
              airline: "Nordic Wings", flight: "NW 512", minutes: 115, layover: 690, overnight: true },
            { from: { code: "LHR", city: "London", time: "07:30", date: "2026-12-13", terminal: "4" },
              to: { code: "DXB", city: "Dubai", time: "18:25", date: "2026-12-13", terminal: "3" },
              airline: "Desert Air", flight: "DA 4", minutes: 415, layover: 125, self_transfer: true },
            { from: { code: "DWC", city: "Dubai", name: "Al Maktoum", time: "20:30", date: "2026-12-13" },
              to: { code: "SIN", city: "Singapore", time: "08:05", date: "2026-12-14", terminal: "1" },
              airline: "Lion Wings", flight: "LW 33", minutes: 455 }]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "layover_timeline", name: "LayoverTimeline", group: "Travel",
    summary: "A journey's flights and the layovers between them, with times, terminals and flags for short connections, overnight waits and changes of terminal or airport.",
    tags: ["travel", "flights", "timeline", "schedule", "no-js"], demo: LayoverTimelineDemo })
