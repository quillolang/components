component OneTimeCodeDemoLive() {
    state result = "Nothing sent yet."
    state wrong = null
    state sends = 1
    <div.demo-stack>
        <form id="one-time-code-demo-form" method="post" action="#" @submit={(e) => {
            let code = e.form.code
            wrong = code == "424242" ? null : "That is not the code. Try again."
            result = code == "424242" ? `Verified ${code}.` : `Sent ${code}.`
        }}>
            <OneTimeCode label="Code from the text message" hint="Sent to the number ending 21." resend_after={2} error={wrong} field="one-time-code-demo-a"
                         on_resend={() => { sends += 1 }}/>
        </form>
        <p.demo-note id="one-time-code-demo-out">{result} Texts sent: {sends}.</p>
        <OneTimeCode name="key" label="Recovery key" length={4} digits={false} auto_submit={false} resend_after={0} web_otp={false} field="one-time-code-demo-b"
                     on_complete={(c) => { result = `Key ${c}.` }}/>
    </div>
}

view OneTimeCodeDemo() = <OneTimeCodeDemoLive/>

ui_gallery = ui_gallery | push({ slug: "one_time_code", name: "OneTimeCode", group: "Mobile",
    summary: "A code field using the system's autofill, pasted whole, in separate boxes with correct deletion, an auto-submit and a resend countdown.",
    tags: ["mobile", "interactive", "otp", "code", "sign-in", "forms"],
    demo: OneTimeCodeDemo })
