let unread_marker_demo_rows = [
    { id: 1, name: "Ana", text: "Morning all." }, { id: 2, name: "Ben", text: "Morning. Coffee is on." },
    { id: 3, name: "You", mine: true, text: "Be there in ten." }, { id: 4, name: "Ana", text: "The crane is here early." },
    { id: 5, name: "Ben", text: "Good, we can start on the north side." }, { id: 6, name: "Ana", text: "I will move the van." },
    { id: 7, name: "Ana", text: "Gate is open now." }, { id: 8, name: "Ben", text: "Who has the drawings?" },
    { id: 9, name: "You", mine: true, text: "They are in my bag." }, { id: 10, name: "Ana", text: "Found the second key." },
    { id: 11, name: "Ben", text: "The first lift is at nine." }, { id: 12, name: "Ana", text: "Inspector rang, he will come at eleven." },
    { id: 13, name: "Ben", text: "Then we should have the fence up by ten." }, { id: 14, name: "Ana", text: "Fence is on the next truck." },
    { id: 15, name: "You", mine: true, text: "I will ring the driver." }, { id: 16, name: "Ben", text: "Lunch is at the mill today." },
    { id: 17, name: "Ana", text: "Save me a seat." }, { id: 18, name: "Ben", text: "Second lift done." },
    { id: 19, name: "Ana", text: "Inspector is happy." }, { id: 20, name: "Ben", text: "Good work, everyone." }
]

component UnreadMarkerDemoLive() {
    state msgs = unread_marker_demo_rows
    state log = []
    state left = -1
    state next = 21
    <div.demo-stack>
        <div.demo-phone id="unread-marker-demo" style="height: 420px">
            <UnreadMarker messages={msgs} last_read={8} on_read={(ids, n) => { log = log + ids; left = n }}/>
        </div>
        <div.demo-row>
            <Button size="lg" id="unread-marker-arrives" on_click={() => {
                msgs = msgs + [{ id: next, name: "Ben", text: `Message ${next}.` }]
                next += 1
            }}>A message arrives</Button>
            <span.demo-note id="unread-marker-log" data-left={left}>Read: {join(log, ",")}</span>
        </div>
    </div>
}

component UnreadMarkerDemoQuiet() {
    state msgs = slice(unread_marker_demo_rows, 0, 14)
    <div.demo-stack>
        <div.demo-phone id="unread-marker-quiet" style="height: 200px">
            <UnreadMarker messages={msgs} last_read={14}/>
        </div>
        <Button size="lg" id="unread-marker-quiet-add" on_click={() => { msgs = msgs + [{ id: `q${len(msgs)}`, name: "Ana", text: "Something new." }] }}>Add to the one with nothing unread</Button>
    </div>
}

view UnreadMarkerDemo() =
    <div.demo-stack>
        <UnreadMarkerDemoLive/>
        <UnreadMarkerDemoQuiet/>
        <div.demo-row>
            <div.demo-phone id="unread-marker-none" style="height: 160px">
                <UnreadMarker last_read="an id that is gone" messages={[{ id: "a", name: "Ana", text: "A last_read it cannot find draws no line." }]}/>
            </div>
            <div.demo-phone id="unread-marker-all" style="height: 160px">
                <UnreadMarker messages={[{ id: "constructor", name: "Ana", text: "Nothing read yet: the line is on top." }, { id: "constructor", name: "Ana", text: "Shown once." }, { id: "b", mine: true, text: "Yours is never unread." }]}/>
            </div>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "unread_marker", name: "UnreadMarker", group: "Mobile",
    summary: "A new-messages line that stays in place, a jump button with a count, and messages marked read as they are seen.",
    tags: ["mobile", "interactive", "chat", "unread", "messages", "scroll"], needs: ["message_bubble"], demo: UnreadMarkerDemo })
