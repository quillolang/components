let wallet_card_demo_cards = [
    { id: "visa", name: "Ana Reyes", number: "4242 4242 4242 4242", expiry: "04/28", color: "#27324b", nick: "Everyday" },
    { id: "amex", name: "Ana Reyes", number: "378282246310005", expiry: "11/26", color: "#176d5a" },
    { id: "mc", name: "Ana Reyes", number: "5555555555554444", expiry: "09/26", color: "#7a2e3a" },
    { id: "server", name: "Ana Reyes", last4: "1117", brand: "Discover", expiry: "02/29", color: "#6a4a16" },
]

component WalletCardDemoLive() {
    state lifted = "none"
    <div.demo-stack>
        <WalletCard cards={wallet_card_demo_cards} today="2026-11-01" hide_after={3} id="wallet-demo"
                    on_change={(c) => { lifted = c ?? "none" }}
                    on_reveal={(c) => c.id == "amex" ? c.number : c.id == "server" ? js("Promise.resolve", js_new("Promise", (done) => { done() })) : js("Promise.resolve", js_new("Promise", (done) => { done(c.number) }))}/>
        <p.demo-note id="wallet-demo-lifted">Lifted: {lifted}</p>
    </div>
}

view WalletCardDemo() = <WalletCardDemoLive/>

ui_gallery = ui_gallery | push({ slug: "wallet_card", name: "WalletCard", group: "Mobile",
    summary: "A stack of cards pulled apart by tap, with the chosen card lifted, and its number hidden until asked.",
    tags: ["mobile", "interactive", "finance", "cards", "wallet", "tablet"],
    demo: WalletCardDemo })
