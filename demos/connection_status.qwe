component ConnectionStatusDemoLive() {
    state changes = []
    <div.demo-stack>
        <div.demo-row>
            <ConnectionStatus position="inline" seconds={2} on_change={(on) => { changes = push(changes, on ? "online" : "offline") }}/>
            <ConnectionStatus position="inline" always={true} seconds={2}/>
        </div>
        <p.demo-note>{len(changes) == 0 ? "Turn the network off (or the browser's Offline setting) to see it." : `Seen: ${join(changes, ", ")}.`}</p>
    </div>
}

view ConnectionStatusDemo() =
    <div.demo-stack>
        <ConnectionStatusDemoLive/>
        <ConnectionStatus/>
        <p.demo-note>A bar across the top of the window shows while offline; it is the default, and nothing shows while all is well.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "connection_status", name: "ConnectionStatus", group: "Feedback",
    summary: "Says when the browser goes offline, as a bar across the top or a pill, and that it is back online for a moment.",
    tags: ["feedback", "status", "notification", "interactive"],
    demo: ConnectionStatusDemo })
