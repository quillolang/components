let boarding_pass_card_demo_pass = {
    airline: "Quillo Air", flight: "QA 204", passenger: "Ada Lovelace", seat: "14A", group: "2", terminal: "1", gate: "B12", was_gate: "A3",
    from: { code: "LIS", city: "Lisbon" }, to: { code: "DXB", city: "Dubai" },
    departs: "2026-11-03T22:40:00+00:00", boarding: "2026-11-03T21:55:00+00:00",
    code: "M1LOVELACE/ADA        EQA204 LISDXBQA 0204 307Y014A0042 100",
}

component BoardingPassCardDemoLive() {
    state time = "2026-11-03T20:40:00+00:00"
    state told = 0
    state second = false
    <div.demo-stack>
        <BoardingPassCard pass={boarding_pass_card_demo_pass} now={time} keep_key="quillo-demo-pass" on_keep={(_p) => { told += 1 }}/>
        <div.demo-row>
            <button.boarding-pass-card-demo-soon type="button" style="min-height: 44px" @click={() => { time = "2026-11-03T21:45:30+00:00" }}>Ten minutes before</button>
            <button.boarding-pass-card-demo-board type="button" style="min-height: 44px" @click={() => { time = "2026-11-03T22:15:00+00:00" }}>Boarding</button>
            <button.boarding-pass-card-demo-close type="button" style="min-height: 44px" @click={() => { time = "2026-11-03T22:30:00+00:00" }}>Doors closed</button>
            <button.boarding-pass-card-demo-gone type="button" style="min-height: 44px" @click={() => { time = "2026-11-03T22:41:00+00:00" }}>Gone</button>
            <button.boarding-pass-card-demo-copy type="button" style="min-height: 44px" @click={() => { second = !second }}>A page with no pass</button>
        </div>
        <p.demo-note>on_keep was called <span class="boarding-pass-card-demo-told">{told}</span> times.</p>
        {second && <div.boarding-pass-card-demo-second>
            <BoardingPassCard pass={null} now={time} keep_key="quillo-demo-pass"/>
            <BoardingPassCard pass={null} now={time} keep_key="quillo-demo-nothing" class="boarding-pass-card-demo-none"/>
            <BoardingPassCard pass={{ ...boarding_pass_card_demo_pass, code: null }} now={time} keep={false} class="boarding-pass-card-demo-nocode"/>
        </div>}
    </div>
}

view BoardingPassCardDemo() = <BoardingPassCardDemoLive/>

ui_gallery = ui_gallery | push({ slug: "boarding_pass_card", name: "BoardingPassCard", group: "Mobile",
    summary: "A boarding pass with its code ready at full brightness, the gate and time large, a countdown, and offline working.",
    tags: ["mobile", "interactive", "tablet", "travel", "ticket", "qr"],
    needs: ["qr_code", "barcode"], demo: BoardingPassCardDemo })
