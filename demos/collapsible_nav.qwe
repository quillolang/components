let collapsible_nav_demo_groups = [
    { label: "Overview", href: "#overview" },
    { title: "Getting started", items: [
        { label: "Install", href: "#install" }, { label: "Your first program", href: "#collapsible_nav" }, { label: "Editors", href: "#editors" }
    ] },
    { title: "Language", items: [
        { label: "Values", href: "#values" }, { label: "Functions", href: "#functions" }, { label: "Views", href: "#views" }, { label: "Components", href: "#components", badge: 4 }
    ] },
    { title: "Deploying", open: false, items: [
        { label: "One server", href: "#server" }, { label: "Docker", href: "#docker" }
    ] }
]

component CollapsibleNavDemoLive() {
    state last = null
    <div.demo-row style="align-items: flex-start; gap: 24px">
        <div style="width: 240px">
            <CollapsibleNav id="collapsible-nav-demo" groups={collapsible_nav_demo_groups} current="#collapsible_nav"
                            on_toggle={(t, o) => { last = `${t} ${o ? "opened" : "closed"}` }}/>
        </div>
        <p.demo-note style="flex: 1 1 200px">{last ?? "Fold a group: the browser remembers it (reload the page to see)."}</p>
    </div>
}

view CollapsibleNavDemo() =
    <div.demo-stack>
        <CollapsibleNavDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "collapsible_nav", name: "CollapsibleNav", group: "Navigation",
    summary: "Side navigation in groups that fold under their titles, the browser remembering which are open.",
    tags: ["navigation", "menu", "link", "document", "interactive"], demo: CollapsibleNavDemo })
