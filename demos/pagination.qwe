component PaginationDemoLive() {
    state page = 3
    <div.demo-stack>
        <Pagination page={page} pages={8} on_change={(p) => { page = p }}/>
        <p.demo-note>Showing posts {(page - 1) * 10 + 1}–{page * 10} (page {page} of 8, from state).</p>
    </div>
}

view PaginationDemo() =
    <div.demo-stack>
        <Pagination page={5} pages={20} href="/posts?page={page}"/>
        <Pagination page={1} pages={20} href="/posts?page={page}" size="sm"/>
        <Pagination page={20} pages={20} href="/posts?page={page}" size="sm"/>
        <PaginationDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "pagination", name: "Pagination", group: "Navigation",
    summary: "Links to the pages of a long list: first, last, the ones around this page, and Previous and Next.",
    demo: PaginationDemo })
