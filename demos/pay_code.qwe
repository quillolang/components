component PayCodeDemoLive() {
    state paid = false
    state shows = 0
    state locks = 0
    state turn = 0
    state down = false
    // Answers at once on even periods and later on odd ones, as a server fn would.
    let service = (step) => down ? null : step % 2 == 0 ? `40000000${step % 10000}` : js("Promise.resolve", js_new("Promise", (done) => { done(`40000000${step % 10000}`) }))
    <div.demo-stack>
        {turn % 2 == 0
            ? <PayCode key={turn} amount={dec("12.50")} payee="Cafe Luz" seed="demo-seed" period={2} hold_ms={500} lock_after={7} confirmed={paid}
                       on_show={() => { shows += 1 }} on_lock={() => { locks += 1 }}/>
            : <PayCode key={turn} amount={dec("12.50")} payee="Cafe Luz" period={2} lock_after={30} confirmed={paid} on_refresh={service}/>}
        <div.demo-row>
            <Button id="pay-demo-till" variant="outline" size="lg" on_click={() => { paid = true }}>The till confirms</Button>
            <Button id="pay-demo-again" variant="ghost" size="lg" on_click={() => { paid = false; turn += 2 }}>Start again</Button>
            <Button id="pay-demo-service" variant="ghost" size="lg" on_click={() => { paid = false; turn += 1 }}>Codes from a service</Button>
            <Button id="pay-demo-down" variant="ghost" size="lg" on_click={() => { down = !down }}>{down ? "Service back" : "Service down"}</Button>
        </div>
        <p.demo-note id="pay-demo-said">Shown {shows}, locked {locks}</p>
    </div>
}

view PayCodeDemo() = <PayCodeDemoLive/>

ui_gallery = ui_gallery | push({ slug: "pay_code", name: "PayCode", group: "Mobile",
    summary: "A QR or code to pay with, refreshing on a timer, screen brightness up while shown, locked until confirmed.",
    tags: ["mobile", "interactive", "commerce", "payment", "qr"],
    needs: ["qr_code", "price"],
    demo: PayCodeDemo })
