component BreakingNewsDemoLive() {
    state note = "Not dismissed yet."
    <div.demo-stack>
        <BreakingNews id="breaking-news-demo-dev" label="Developing" tone="warning" headline="Power cut hits half the city; trams stopped"
                      time="Updated 14:20" on_dismiss={() => { note = "on_dismiss was called." }}/>
        <p.demo-note id="breaking-news-demo-note">{note}</p>
    </div>
}

view BreakingNewsDemo() =
    <div.demo-stack>
        <BreakingNews id="breaking-news-demo-main" headline="Magnitude 6.1 earthquake strikes off the northern coast" href="#quake-live"
                      summary="A tsunami warning is in force for the islands; residents are told to move to higher ground."
                      datetime={date.from_ms(now() - 4 * 60000 - 5000, "UTC")} remember="demo-quake"/>
        <BreakingNewsDemoLive/>
        <BreakingNews id="breaking-news-demo-fixed" label="Live" tone="accent" headline="Election night: results as they come in"
                      href="#results" datetime={date.from_ms(now() - 3 * 3600000, "UTC")} dismissable={false}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "breaking_news", name: "BreakingNews", group: "News",
    summary: "A breaking-news banner: the label in a block of colour, the headline and a line more, how long ago it came in, kept up to date, and a close that can be remembered.",
    tags: ["news", "banner", "alert", "live", "interactive"], demo: BreakingNewsDemo })
