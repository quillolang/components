let slide_over_demo_css = css`
.demo-over { display: grid; gap: 12px; align-content: start; height: 100%; box-sizing: border-box; padding: 18px 20px; font: 15px/1.6 var(--ui-font); }
.demo-over h4 { margin: 0; font-size: 20px; }
.demo-over input { box-sizing: border-box; width: min(320px, 100%); height: 46px; padding: 0 10px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius-sm); background: var(--ui-surface); color: var(--ui-fg); font: 16px/1.2 var(--ui-font); }
.demo-over-note { margin: 0 0 10px; }
`

component SlideOverDemoLive() {
    style global slide_over_demo_css
    state tally = 0
    state where = "right"
    state said = "open"
    state wide = false
    <div.demo-tablet>
        <div.demo-over>
            <h4>Stock count</h4>
            <p>The page behind works while the panel floats over it.</p>
            <div.demo-row>
                <Button id="over-demo-count" size="lg" variant="outline" on_click={() => { tally += 1 }}>Counted {tally}</Button>
                <SlideOver title="Delivery notes" trigger="Notes" width={wide ? 340 : 320} on_edge={(e) => { where = e }}
                           on_close={() => { said = "put away" }} on_open={() => { said = "brought back" }}>
                    {for n in range(1, 61) => <p.demo-over-note>Crate {n}: checked in at the side door.</p>}
                    <label for="over-demo-note">A note</label>
                    <input id="over-demo-note" type="text"/>
                </SlideOver>
                <Button id="over-demo-wider" size="lg" variant="outline" on_click={() => { wide = !wide }}>Change its width</Button>
            </div>
            <label for="over-demo-field">Bin number</label>
            <input id="over-demo-field" type="text"/>
            <p id="over-demo-said">Panel on the {where}, {said}</p>
        </div>
    </div>
}

view SlideOverDemo() = <SlideOverDemoLive/>

ui_gallery = ui_gallery | push({ slug: "slide_over", name: "SlideOver", group: "Mobile",
    summary: "A floating panel that slides over from either edge and stays while the page behind stays usable, moved between edges by drag.",
    tags: ["mobile", "tablet", "interactive", "panel", "overlay", "drag"],
    demo: SlideOverDemo })
