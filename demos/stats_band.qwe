view StatsBandDemo() =
    <div.demo-stack>
        <StatsBand id="stats-band-demo" stats={[
            { value: "12k", label: "Developers" },
            { value: "99.99%", label: "Uptime", note: "last 90 days" },
            { value: "< 1 ms", label: "To render a page" },
            { value: "108", label: "Components", note: "and counting" },
        ]}/>
        <StatsBand tone="accent" columns={3} stats={[
            { value: "4.9", label: "Average rating", note: "from 2,140 reviews" },
            { value: "38", label: "Countries" },
            { value: "2019", label: "Founded" },
        ]}/>
        <StatsBand tone="plain" stats={[{ value: "3", label: "People" }, { value: "1", label: "File" }, { value: "0", label: "Build steps" }]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "stats_band", name: "StatsBand", group: "Marketing",
    summary: "Big numbers with their labels across a tinted, filled, outlined or plain band, as a <dl>.",
    tags: ["marketing", "section", "data", "no-js"],
    demo: StatsBandDemo })
