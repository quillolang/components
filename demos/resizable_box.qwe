component ResizableBoxDemoLive() {
    state w = 320
    state h = 200
    <div.demo-stack>
        <ResizableBox id="resizable-box-demo-live" width={320} height={200} min_width={160} max_width={600} min_height={100} max_height={400}
                      label="Resize the preview" on_resize={(nw, nh) => { w = nw; h = nh }}>
            <div style="display: grid; place-items: center; height: 100%; padding: 16px; text-align: center; color: var(--ui-muted); font-size: 13px">
                Drag the corner, or focus it and use the arrow keys (Shift for bigger steps), Home and End.
            </div>
        </ResizableBox>
        <p.demo-note>{w} × {h} pixels.</p>
    </div>
}

view ResizableBoxDemo() =
    <div.demo-stack>
        <ResizableBoxDemoLive/>
        <ResizableBox id="resizable-box-demo-wide" axis="x" width={420} min_width={200} max_width={800} label="Resize the column">
            <p style="margin: 0; padding: 16px; font-size: 13px">Only the width changes (axis="x"): a column of text to try line lengths with. The handle is along the right edge.</p>
        </ResizableBox>
    </div>

ui_gallery = ui_gallery | push({ slug: "resizable_box", name: "ResizableBox", group: "Layout",
    summary: "A box the user resizes by dragging its corner or an edge, within limits, with the keyboard too.",
    tags: ["layout", "drag", "keyboard", "utility", "interactive"], demo: ResizableBoxDemo })
