let conflict_sheet_demo_now = 1793534400000
let conflict_sheet_demo_fields = [
    { name: "name", label: "Name" }, { name: "phone", label: "Phone" }, { name: "street", label: "Street" }, { name: "note", label: "Note" },
    { name: "email", label: "Email" }, { name: "news", label: "Sends news" },
]
let conflict_sheet_demo_base = { name: "Ana Reyes", phone: "555 0100", street: "14 Mill Road", note: "Ring twice", email: "ana@example.com", news: false }
let conflict_sheet_demo_mine = { name: "Ana Reyes", phone: "555 0199", street: "14 Mill Lane", note: "", email: "ana@example.com", news: true }
let conflict_sheet_demo_theirs = { name: "Ana Reyes", phone: "555 0123", street: "14 Mill Road", note: "Leave at the door", email: "ana.reyes@example.com", news: false }

component ConflictSheetDemoLive() {
    state got = "Nothing saved yet."
    state closed = 0
    state refuse = false
    // A pretend server, a moment away. Named, as js_new is not waited for in a function written
    // in the markup's prop.
    let keep = (merged, picks) => {
        let pause = js("Promise.resolve", js_new("Promise", (done) => { js("AbortSignal.timeout", 80).addEventListener("abort", (_e) => { done(true) }) }))
        if refuse { return { ok: false, error: "The server is busy." } }
        got = `${json.stringify(merged)} | ${json.stringify(picks)}`
        pause
    }
    <div.demo-stack>
        <div.demo-row>
            <ConflictSheet id="cflct-demo" trigger="Review the changes" fields={conflict_sheet_demo_fields} base={conflict_sheet_demo_base} local={conflict_sheet_demo_mine}
                           remote={conflict_sheet_demo_theirs} local_at={conflict_sheet_demo_now - 300000} remote_at={conflict_sheet_demo_now - 7200000} now={conflict_sheet_demo_now}
                           remote_name="Ben's tablet" on_resolve={keep} on_close={() => { closed += 1 }}/>
            <ConflictSheet id="cflct-two" trigger="With no shared start" title="Which is right?" local={{ phone: "1", city: "Porto" }} remote={{ phone: "2", city: "Porto" }} on_resolve={(_m, _p) => { true }}/>
            <ConflictSheet id="cflct-same" trigger="Nothing differs" local={{ a: "", b: 1 }} remote={{ a: null, b: 1 }}/>
            <ConflictSheet id="cflct-bad" trigger="Bad data" local={null} remote="not a map" fields="nor this"/>
            <Button size="lg" variant="outline" id="cflct-refuse" on_click={() => { refuse = !refuse }}>{refuse ? "Let saves through" : "Make saves fail"}</Button>
        </div>
        <p.demo-note id="cflct-got">{got}</p>
        <p.demo-note id="cflct-closed">{`Closed without saving: ${closed}.`}</p>
    </div>
}

view ConflictSheetDemo() = <ConflictSheetDemoLive/>

ui_gallery = ui_gallery | push({ slug: "conflict_sheet", name: "ConflictSheet", group: "Mobile",
    summary: "This device's version against the server's, chosen field by field, explained in plain words.",
    tags: ["mobile", "interactive", "offline", "sync", "sheet", "tablet"],
    demo: ConflictSheetDemo })
