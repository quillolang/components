let image_gallery_demo_photos = [
    { src: "https://picsum.photos/seed/porto/1200/800", thumb: "https://picsum.photos/seed/porto/300/300", alt: "Rooftops by the river", caption: "Day 1: rooftops by the river" },
    { src: "https://picsum.photos/seed/tiles/1200/800", thumb: "https://picsum.photos/seed/tiles/300/300", alt: "Blue tiles on a church", caption: "Day 1: the tiles of Santo Ildefonso" },
    { src: "https://picsum.photos/seed/bridge/1200/800", thumb: "https://picsum.photos/seed/bridge/300/300", alt: "An iron bridge at dusk" },
    { src: "https://picsum.photos/seed/market/1200/800", thumb: "https://picsum.photos/seed/market/300/300", alt: "A covered market", caption: "Day 2: Bolhão market" },
    { src: "https://picsum.photos/seed/coast/1200/800", thumb: "https://picsum.photos/seed/coast/300/300", alt: "Waves on the coast", caption: "Day 3: Foz do Douro" },
    { src: "https://picsum.photos/seed/tram/1200/800", thumb: "https://picsum.photos/seed/tram/300/300", alt: "An old yellow tram", caption: "Day 3: tram 1" },
    { src: "https://picsum.photos/seed/cellar/1200/800", thumb: "https://picsum.photos/seed/cellar/300/300", alt: "Barrels in a cellar", caption: "Day 4: a port cellar" },
]

component ImageGalleryDemoLive() {
    state opened = null
    <div.demo-stack>
        <ImageGallery label="Four days in Porto" images={image_gallery_demo_photos} limit={4} ratio="4/3"
                      on_open={(i) => { opened = i }}/>
        <p.demo-note id="image-gallery-demo-note">{opened == null ? "Click a photo." : `Opened on photo ${opened + 1}.`}</p>
    </div>
}

view ImageGalleryDemo() =
    <div.demo-stack>
        <ImageGalleryDemoLive/>
        <div style="max-width: 360px">
            <ImageGallery label="Three in a row" images={take(image_gallery_demo_photos, 3)} columns={3}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "image_gallery", name: "ImageGallery", group: "Media",
    summary: "A grid of thumbnails (the last can say \"+N\") opening a framed viewer with captions, next and previous, the keys and a strip.",
    tags: ["media", "image", "grid", "dialog", "interactive"], demo: ImageGalleryDemo })
