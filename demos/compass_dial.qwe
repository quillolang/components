component CompassDialDemoLive() {
    state shown = true
    state seen = "nothing yet"
    <div.demo-stack>
        {shown && <CompassDial bearing={132} target="Base camp" on_heading={(h) => { seen = str(h) }}/>}
        <p.demo-note id="compass-dial-demo-note">on_heading: {seen}</p>
        <Button size="lg" variant="ghost" id="compass-dial-demo-show" on_click={() => { shown = !shown }}>{shown ? "Remove it" : "Put it back"}</Button>
    </div>
}

view CompassDialDemo() = <CompassDialDemoLive/>

ui_gallery = ui_gallery | push({ slug: "compass_dial", name: "CompassDial", group: "Mobile",
    summary: "A dial from the device's orientation with calibration advice, smoothed across north, and the permission iOS requires.",
    tags: ["mobile", "interactive", "compass", "heading", "sensor"],
    needs: ["button"],
    demo: CompassDialDemo })
