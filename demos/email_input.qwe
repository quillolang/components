component EmailInputDemoLive() {
    state email = ""
    <div.demo-stack>
        <EmailInput name="ei-demo-email" label="Email" required={true} hint="Try ada@gmial.com and leave the box."
                    on_change={(v) => { email = v }}/>
        <p.demo-note>{email == "" ? "Nothing typed yet." : `The form sends ${email}.`}</p>
    </div>
}

view EmailInputDemo() {
    <div.demo-stack.demo-narrow>
        <EmailInputDemoLive/>
        <EmailInput name="ei-demo-work" label="Work email" domains={["example.com", "example.org"]} value="grace@examlpe.com"
                    placeholder="you@example.com"/>
        <EmailInput name="ei-demo-bad" label="Email" value="not an email" size="sm" error="That is not an email address."/>
    </div>
}

ui_gallery = ui_gallery | push({ slug: "email_input", name: "EmailInput", group: "Forms",
    summary: "An email box that offers the address probably meant when the domain has a slip (gmial.com, outlook.con), one click to take it.",
    tags: ["forms", "input", "user", "interactive"], demo: EmailInputDemo })
