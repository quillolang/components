let inspection_form_demo_sections = [
    { title: "Cab", items: [
        { id: "brakes", text: "Brakes hold on a slope", critical: true, weight: 3 },
        { id: "horn", text: "Horn works" },
        { id: "lights", text: "All lights work" },
    ] },
    { title: "Body", items: [
        { id: "tyres", text: "Tyres at legal depth", weight: 2 },
        { id: "mirrors", text: "Mirrors whole and clean" },
        { id: "straps", text: "Load straps not frayed", photo: false },
    ] },
    { title: "Papers", items: [
        { id: "insurance", text: "Insurance card in the cab", note: false },
        { id: "first_aid", text: "First aid kit in date" },
    ] },
]

component InspectionFormDemoLive() {
    state said = "Nothing sent yet."
    state drafts = 0
    <div.demo-stack>
        <InspectionForm title="Daily truck check" job="Truck 14" pass_mark={85} sections={inspection_form_demo_sections} store="demo"
                        on_draft={(_d) => { drafts += 1 }}
                        on_submit={(r) => { said = `Sent: ${r.outcome}, ${r.score}%, ${r.failed} failed, ${len(r.lines)} lines` }}/>
        <p.demo-note id="inspect-demo-said">{said}</p>
        <p.demo-note id="inspect-demo-drafts">{drafts}</p>
    </div>
}

view InspectionFormDemo() = <InspectionFormDemoLive/>

ui_gallery = ui_gallery | push({ slug: "inspection_form", name: "InspectionForm", group: "Mobile",
    summary: "A checklist of pass, fail and N/A with big targets, a note and stamped photo needed on a fail, a score, and a draft kept.",
    tags: ["mobile", "interactive", "checklist", "offline", "form", "tablet"],
    needs: ["photo_evidence"],
    demo: InspectionFormDemo })
