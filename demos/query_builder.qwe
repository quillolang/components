let query_builder_demo_fields = [
    { key: "name", label: "Name", type: "text" },
    { key: "age", label: "Age", type: "number" },
    { key: "joined", label: "Joined", type: "date" },
    { key: "active", label: "Active", type: "boolean" },
    { key: "plan", label: "Plan", type: "enum", options: ["free", "pro", "team"] },
    { key: "balance", label: "Balance", type: "number", column: "balance_usd" },
]

let query_builder_demo_rows = [
    { name: "Ada Lovelace", age: 36, joined: "2026-01-05", active: true, plan: "pro", balance: 12.50m },
    { name: "Grace Hopper", age: 85, joined: "2025-03-20", active: false, plan: "free", balance: 0.1 },
    { name: "Alan Turing", age: 41, joined: "2026-06-30", active: true, plan: "team", balance: "1200.00" },
    { name: "Bo", age: 17, joined: null, active: true, plan: "pro", balance: 0 },
    { name: "", age: null, joined: "2024-02-29", active: null, plan: null, balance: null },
    { name: "Linus 50%", age: "not known", joined: "2026-02-01", active: false, plan: "free", balance: 0.2 },
]

component QueryBuilderDemoLive() {
    state q = null
    <div.demo-stack>
        <QueryBuilder id="query-builder-demo-live" title="Add a rule" fields={["city", "street"]}
                      value={{ and: [{ field: "city", op: "eq", value: "Lisbon" }] }} on_change={(x) => { q = x }}/>
        <p.demo-note>{q == null ? "Change it to see on_change." : `on_change: ${q.where} with ${len(q.params)} parameters.`}</p>
    </div>
}

view QueryBuilderDemo() =
    <div.demo-stack>
        <QueryBuilder id="query-builder-demo" table="people" name="filter" fields={query_builder_demo_fields} rows={query_builder_demo_rows}
                      value={{ and: [{ field: "age", op: "gte", value: "18" },
                                     { or: [{ field: "plan", op: "eq", value: "pro" }, { field: "name", op: "contains", value: "tur" }] }] }}/>
        <QueryBuilderDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "query_builder", name: "QueryBuilder", group: "Data",
    summary: "Builds nested AND/OR filters with operators by field type, and gives a JSON filter and parametrised SQL, with a live count of the sample rows that match.",
    tags: ["smart", "interactive", "filter", "sql", "query", "search"], demo: QueryBuilderDemo })
