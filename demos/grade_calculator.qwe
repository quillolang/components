component GradeCalculatorDemoLive() {
    state current = null
    <div.demo-stack>
        <GradeCalculator id="grade-calculator-demo-merit" title="Module out of 20" top={20} name="module"
                         targets={[{ label: "Pass", min: 10 }, { label: "Merit", min: 14 }, { label: "Distinction", min: 16 }]}
                         parts={[{ name: "Project", weight: 3, mark: "15" }, { name: "Viva", weight: 3, mark: "60%" }, { name: "Exam", weight: 6 }]}
                         on_change={(f) => { current = f == null ? "none" : str(round(f.current, 2, "half_up")) }}/>
        <p.demo-note>{current == null ? "Change a mark to see on_change." : `on_change: the current grade is ${current}.`}</p>
    </div>
}

view GradeCalculatorDemo() =
    <div.demo-stack>
        <GradeCalculator id="grade-calculator-demo"
                         parts={[{ name: "Essay", weight: 20, mark: 85 }, { name: "Midterm", weight: 30, mark: "36/50" },
                                 { name: "Labs", weight: 10, mark: 90 }, { name: "Final exam", weight: 40 }]}/>
        <GradeCalculatorDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "grade_calculator", name: "GradeCalculator", group: "Utilities",
    summary: "Works out a weighted current grade from the marks so far, and the mark needed on what is left to reach each target, or that it is out of reach.",
    tags: ["smart", "interactive", "education", "grades", "calculator", "forms"], demo: GradeCalculatorDemo })
