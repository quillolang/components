let device_preview_demo_css = css`
.device-preview-demo-app { display: grid; grid-template-rows: auto 1fr; height: 100cqh; }
.device-preview-demo-head { display: flex; align-items: center; justify-content: space-between; padding: 8px 16px; background: var(--ui-accent); color: var(--ui-accent-fg); font-weight: 600; }
.device-preview-demo-cards { display: grid; grid-template-columns: 1fr; gap: 10px; align-content: start; padding: 14px; overflow: auto; }
.device-preview-demo-cards > div { padding: 14px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius); background: var(--ui-surface); }
@container (min-width: 600px) { .device-preview-demo-cards { grid-template-columns: repeat(3, 1fr); } }
.device-preview-demo-count { min-width: 64px; min-height: 44px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius-sm); background: var(--ui-surface); color: var(--ui-fg); font: 600 16px var(--ui-font); }
`

component DevicePreviewDemoLive() {
    style global device_preview_demo_css
    state count = 0
    state changes = 0
    state said = ""
    <div.demo-stack>
        <DevicePreview id="device-preview-demo" model="iphone-15" max_height={620}
                       on_change={(c) => { changes += 1; said = `${c.model} ${c.landscape} ${c.theme} ${c.insets}` }}>
            <SafeArea id="device-preview-demo-safe" class="device-preview-demo-app">
                <div.device-preview-demo-head>
                    <span>Orders</span>
                    <button.device-preview-demo-count id="device-preview-demo-count" type="button" @click={() => { count += 1 }}>{count}</button>
                </div>
                <div.device-preview-demo-cards id="device-preview-demo-cards">
                    <div>Today, 4 to pack</div>
                    <div>Tomorrow, 9 booked</div>
                    <div>Friday, 2 waiting</div>
                </div>
            </SafeArea>
        </DevicePreview>
        <p.demo-note id="device-preview-demo-out">{changes} changes. {said}</p>
    </div>
}

view DevicePreviewDemo() =
    <div.demo-stack>
        <DevicePreviewDemoLive/>
        <DevicePreview id="device-preview-demo-tablet" model="ipad-11" landscape={true} theme="dark" controls={false} max_height={300} label="A tablet">
            <p style="margin: 40px">A tablet on its side, dark, fitted to 300 px.</p>
        </DevicePreview>
    </div>

ui_gallery = ui_gallery | push({ slug: "device_preview", name: "DevicePreview", group: "Mobile",
    summary: "A phone or tablet frame sized by model for showing a component, rotation, safe areas drawn, dark or light.",
    tags: ["mobile", "interactive", "tablet", "preview", "frame", "rotation"],
    needs: ["safe_area"],
    demo: DevicePreviewDemo })
