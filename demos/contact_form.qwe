component ContactFormDemoLive() {
    state got = null
    <div.demo-stack>
        {got == null
            ? <ContactForm action="#" id="contact-form-demo-live" subjects={["Sales", "Support", "Press"]} rows={3}
                           on_submit={(f) => { got = f }}/>
            : <ContactForm sent={true} id="contact-form-demo-sent"/>}
        <p.demo-note>{got == null ? "Nothing sent yet." : `on_submit got ${got.name} about ${got.subject}.`}</p>
    </div>
}

view ContactFormDemo() =
    <div.demo-stack>
        <ContactForm action="/contact" id="contact-form-demo-plain" phone={true} title="Get in touch"
                     text="We answer within a working day." values={{ name: "Ada Lovelace", email: "ada@example" }}
                     errors={{ email: "Enter an email address such as ada@example.com." }}
                     notice="Your message was not sent: check the fields below."/>
        <ContactFormDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "contact_form", name: "ContactForm", group: "Forms",
    summary: "Name, email, subject and message with a Send button: a plain form posting to your route, shown again with errors or as sent.",
    tags: ["forms", "input", "page", "no-js"], demo: ContactFormDemo })
