component BookmarkButtonDemoLive() {
    state kept = false
    <div.demo-row>
        <BookmarkButton on_change={(on) => { kept = on }}/>
        <span.demo-note>{kept ? "Saved for later." : "Not saved."}</span>
    </div>
}

view BookmarkButtonDemo() =
    <div.demo-stack>
        <BookmarkButtonDemoLive/>
        <div.demo-row>
            <BookmarkButton saved={true} name="saved"/>
            <BookmarkButton icon_only={true}/>
            <BookmarkButton icon_only={true} saved={true} variant="ghost"/>
            <BookmarkButton variant="soft" size="sm" label="Bookmark" saved_label="Bookmarked"/>
            <BookmarkButton size="lg"/>
            <BookmarkButton disabled={true}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "bookmark_button", name: "BookmarkButton", group: "Actions",
    summary: "A save-for-later toggle whose bookmark fills when pressed, with or without its label.",
    tags: ["button", "social", "forms", "interactive"],
    demo: BookmarkButtonDemo })
