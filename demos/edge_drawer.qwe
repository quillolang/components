let edge_drawer_demo_css = css`
.ui-edgedrawer-demo-list { margin: 0; padding: 8px; list-style: none; }
.ui-edgedrawer-demo-list a, .ui-edgedrawer-demo-list button {
  box-sizing: border-box; display: flex; align-items: center; width: 100%; min-height: 48px; padding: 0 12px; border: 0; border-radius: var(--ui-radius-sm);
  background: transparent; color: var(--ui-fg); font: 15px var(--ui-font); text-align: start; text-decoration: none; cursor: pointer;
}
.ui-edgedrawer-demo-list [aria-current] { background: var(--ui-accent-soft); color: var(--ui-accent); }
.ui-edgedrawer-demo-top { display: flex; align-items: center; gap: 10px; padding: 8px 12px; border-bottom: 1px solid var(--ui-border); }
.ui-edgedrawer-demo-top h3 { margin: 0; font-size: 17px; }
`

let edge_drawer_demo_places = ["Inbox", "Field notes", "Photos", "Settings"]

component EdgeDrawerDemoLive() {
    style global edge_drawer_demo_css
    state menu = false
    state place = "Inbox"
    state changes = 0
    state overlay = false
    <div.demo-stack>
        <div.demo-tablet>
            <EdgeDrawer title="Fieldbook" dock={!overlay} open={menu} on_change={(on) => { menu = on; changes += 1 }}
                        drawer={<ul.ui-edgedrawer-demo-list>
                            {for p in edge_drawer_demo_places => <li key={p}><button type="button" aria-current={p == place ? "page" : null}
                                @click={() => { place = p; menu = false }}>{p}</button></li>}
                            <li><a href="#edge-drawer-help">Help (a link)</a></li>
                            <li><a href="#edge-drawer-about">About (a link)</a></li>
                            <li><a href="#edge-drawer-terms">Terms (a link)</a></li>
                        </ul>}>
                <div.ui-edgedrawer-demo-top>
                    <Button size="lg" variant="outline" class="ui-edgedrawer-menu" id="edge-drawer-demo-menu" on_click={() => { menu = true }}>Menu</Button>
                    <h3>{place}</h3>
                </div>
                <div style="padding: 12px 16px">
                    {for i in range(1, 30) => <p key={i}>{place}, line {i}</p>}
                </div>
            </EdgeDrawer>
        </div>
        <p class="demo-note">Opened or closed {changes} {changes == 1 ? "time" : "times"}</p>
        <Button size="lg" variant="outline" on_click={() => { overlay = !overlay }}>{overlay ? "Dock it when there is room" : "Always an overlay"}</Button>
        <p class="demo-note">Open from the start:</p>
        <div style="height: 320px; border: 1px solid var(--ui-border)">
            <EdgeDrawer title="Opened at load" open={true} drawer={<p style="margin: 16px">Open from the start.</p>}>
                <p style="margin: 16px">The screen under it.</p>
            </EdgeDrawer>
        </div>
    </div>
}

view EdgeDrawerDemo() = <EdgeDrawerDemoLive/>

ui_gallery = ui_gallery | push({ slug: "edge_drawer", name: "EdgeDrawer", group: "Mobile",
    summary: "A navigation drawer pulled from the screen's edge: follows the finger, snaps by speed, holds the focus, closes on Back; stands beside the content on a tablet.",
    tags: ["mobile", "interactive", "tablet", "gesture", "navigation", "menu"],
    demo: EdgeDrawerDemo })
