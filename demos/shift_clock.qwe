component ShiftClockDemoLive() {
    state sent = []
    <div.demo-stack>
        <ShiftClock time_now={1793631909000} offset={-240} store="demo"
                    sites={[{ name: "Depot", lat: 45.5017, lon: -73.5673, radius: 150 }, { name: "North yard", lat: 45.56, lon: -73.6, radius: 200 }]}
                    on_punch={(p) => { sent = sent + [p.kind] }}/>
        <p.demo-note id="punch-demo-sent">Sent: {join(sent, ", ")}</p>
    </div>
}

view ShiftClockDemo() = <ShiftClockDemoLive/>

ui_gallery = ui_gallery | push({ slug: "shift_clock", name: "ShiftClock", group: "Mobile",
    summary: "Punch in and out with a check of the place, breaks and today's hours, safe from double taps and with no connection.",
    tags: ["mobile", "interactive", "location", "time", "offline", "tablet"],
    needs: ["photo_evidence"],
    demo: ShiftClockDemo })
