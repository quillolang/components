view FlowStepsDemo() =
    <div.demo-stack>
        <FlowSteps id="flow-steps-demo-simple" label="Release" steps={["Write", "Review", "Merge", "Deploy"]}/>
        <FlowSteps id="flow-steps-demo-order" label="Order" numbered={true} steps={[
            { title: "Order placed", text: "Payment held", status: "done", then: "paid" },
            { title: "Packed", text: "At the warehouse", status: "done", then: "within a day" },
            { title: "Shipped", text: "UPS 1Z999", status: "current" },
            { title: "Delivered", status: "coming" },
        ]}/>
        <div style="max-width: 420px">
            <FlowSteps id="flow-steps-demo-vertical" direction="vertical" label="Review" steps={[
                { title: "Draft", tone: "info", then: "submit" },
                { title: "In review", text: "Two approvals", tone: "warning", then: "if approved" },
                { title: "Published", tone: "success" },
            ]}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "flow_steps", name: "FlowSteps", group: "Data",
    summary: "A process as boxes joined by arrows, with words on the arrows, tones and done, current or coming steps; horizontal, or vertical where narrow.",
    tags: ["chart", "progress", "list", "no-js"],
    demo: FlowStepsDemo })
