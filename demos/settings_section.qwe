view SettingsSectionDemo() =
    <div.demo-stack>
        <SettingsSection id="settings-section-demo" title="Notifications" description="What we email you about."
                         footer={<Button size="sm">Save</Button>}>
            <SettingsRow label="Replies" hint="When someone answers you." field="settings-demo-replies">
                <Switch name="replies" checked={true}/>
            </SettingsRow>
            <SettingsRow label="Weekly digest" hint="A summary of what happened." field="settings-demo-digest">
                <Select name="digest" field="settings-demo-digest" size="sm" value="monday"
                        options={[{ label: "Never", value: "never" }, { label: "Mondays", value: "monday" }, { label: "Fridays", value: "friday" }]}/>
            </SettingsRow>
            <SettingsRow label="Signature" hint="Added to the end of every email." field="settings-demo-sig" wide={true}>
                <TextArea name="signature" field="settings-demo-sig" rows={2} value="— Ada"/>
            </SettingsRow>
        </SettingsSection>
        <SettingsSection title="Danger" level={3}>
            <SettingsRow label="Export data" hint="A zip of everything, within a minute.">
                <Button size="sm" variant="outline">Export</Button>
            </SettingsRow>
        </SettingsSection>
    </div>

ui_gallery = ui_gallery | push({ slug: "settings_section", name: "SettingsSection", group: "Dashboard",
    summary: "A titled block of settings rows, each a label and hint with its control at the right (SettingsRow).",
    tags: ["dashboard", "settings", "forms", "layout", "list", "no-js"],
    demo: SettingsSectionDemo })
