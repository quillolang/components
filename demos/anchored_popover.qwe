let anchored_popover_demo_css = css`
.demo-anchored { display: grid; grid-template-rows: auto 1fr auto; gap: 12px; height: 100%; box-sizing: border-box; padding: 14px; font: 14px/1.5 var(--ui-font); }
.demo-anchored-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
.demo-anchored-mid { display: grid; place-items: center; color: var(--ui-muted); text-align: center; }
.demo-anchored-long p { margin: 0 0 12px; }
.demo-anchored-field { display: grid; gap: 6px; }
.demo-anchored-field input { box-sizing: border-box; width: 100%; height: 46px; padding: 0 10px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius-sm); background: var(--ui-surface); color: var(--ui-fg); font: 16px/1.2 var(--ui-font); }
`

component AnchoredPopoverDemoLive() {
    style global anchored_popover_demo_css
    state opened = 0
    state closed = 0
    state controlled = false
    state wide = false
    <div.demo-tablet>
        <div.demo-anchored>
            <div.demo-anchored-row>
                <AnchoredPopover id="anchored-demo-sort" trigger="Sort" title="Sort by"
                                 on_open={() => { opened += 1 }} on_close={() => { closed += 1 }}>
                    <p>Newest first, with the unread at the top.</p>
                </AnchoredPopover>
                <AnchoredPopover id="anchored-demo-reply" trigger="Reply" title="Quick reply" width={wide ? 360 : 320}>
                    <div.demo-anchored-field>
                        <label for="anchored-demo-text">Your reply</label>
                        <input id="anchored-demo-text" type="text"/>
                        <button.ui-anchored-trigger id="anchored-demo-wider" type="button" @click={() => { wide = !wide }}>Change the width</button>
                    </div>
                </AnchoredPopover>
            </div>
            <div.demo-anchored-mid>
                <div>
                    <p id="anchored-demo-count">Opened {opened}, closed {closed}</p>
                    <button.ui-anchored-trigger id="anchored-demo-other" type="button"
                            @click={() => { controlled = !controlled }}>{controlled ? "Showing the note" : "Show a note"}</button>
                </div>
            </div>
            <div.demo-anchored-row>
                <AnchoredPopover id="anchored-demo-info" trigger="Details" side="top" width={360}>
                    <div.demo-anchored-long>
                        <p>Delivered on Tuesday to the side door, signed for by the caretaker.</p>
                        <p>Three boxes, one marked fragile. Nothing was left at the front.</p>
                    </div>
                </AnchoredPopover>
                <AnchoredPopover id="anchored-demo-side" trigger="Long" title="All the steps" side="right" width={300}>
                    <div.demo-anchored-long>
                        {for n in range(1, 41) => <p>Step {n} of the route</p>}
                    </div>
                </AnchoredPopover>
            </div>
            <AnchoredPopover id="anchored-demo-tied" trigger={null} anchor="anchored-demo-other" open={controlled} label="A note"
                             on_close={() => { controlled = false }}>
                <p>Tied to a button of yours, by its id, and opened from your own state.</p>
            </AnchoredPopover>
        </div>
    </div>
}

view AnchoredPopoverDemo() = <AnchoredPopoverDemoLive/>

ui_gallery = ui_gallery | push({ slug: "anchored_popover", name: "AnchoredPopover", group: "Mobile",
    summary: "A popover with an arrow tied to its button on a tablet and a sheet on a phone, re-anchored on rotation and when a keyboard opens.",
    tags: ["mobile", "tablet", "interactive", "popover", "sheet", "overlay"],
    demo: AnchoredPopoverDemo })
