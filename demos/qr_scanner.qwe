component QrScannerDemoLive() {
    state last = ""
    state shown = true
    <div.demo-stack>
        {shown && <QrScanner on_scan={(text) => { last = text }}/>}
        <p.demo-note id="qr-scanner-demo-note" style="overflow-wrap: anywhere">{last == "" ? "Nothing scanned yet." : `on_scan got: ${last}`}</p>
        <Button size="lg" variant="ghost" tone="neutral" on_click={() => { shown = !shown }}>{shown ? "Leave the page" : "Come back"}</Button>
    </div>
}

view QrScannerDemo() =
    <div.demo-stack>
        <QrScannerDemoLive/>
        <p.demo-note>Chrome on Android reads codes itself. On an iPhone there is no detector, and the code is typed.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "qr_scanner", name: "QrScanner", group: "Mobile",
    summary: "Scans a QR code with the camera by BarcodeDetector where present, with a viewfinder, a torch and entry by hand where not.",
    tags: ["mobile", "interactive", "camera", "qr", "scanner"], needs: ["button"], demo: QrScannerDemo })
