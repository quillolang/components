component BusinessDaysCalcDemoLive() {
    state due = null
    <div.demo-stack>
        <BusinessDaysCalc id="business-days-calc-demo-add" title="Delivery promise (Gulf week)" name="promise" mode="add" start="2026-12-30" count={3}
                          weekend={[5, 6]} holidays={[{ date: "12-31", name: "New Year's Eve" }, "2027-01-01 New Year's Day"]}
                          on_change={(r) => { due = r.date }}/>
        <p.demo-note>{due == null ? "Change a figure to see on_change." : `on_change: the date is ${due}.`}</p>
    </div>
}

view BusinessDaysCalcDemo() =
    <div.demo-stack>
        <BusinessDaysCalc id="business-days-calc-demo" start="2026-03-02" end="2026-04-03"
                          holidays={["2026-04-03 Good Friday", "2026-03-17 St Patrick's Day"]}/>
        <BusinessDaysCalcDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "business_days_calc", name: "BusinessDaysCalc", group: "Scheduling",
    summary: "Counts the working days between two dates, or finds a date N working days away, with your own weekends and holidays, listing each day it skipped.",
    tags: ["smart", "interactive", "dates", "calendar", "calculator", "deadline"], demo: BusinessDaysCalcDemo })
