component SheetDemoLive() {
    state showing = false
    state stop = "Central Station"
    <div.demo-row>
        <Button variant="soft" on_click={() => { showing = true }}>Pick a stop (from state)</Button>
        <span.demo-note>Stop: {stop}</span>
        <Sheet title="Pick a stop" open={showing} snap="full" on_close={() => { showing = false }}>
            <div.demo-stack>
                {for s in ["Central Station", "Harbour Gate", "Museum Quarter", "University", "Old Town"] =>
                    <Button variant={s == stop ? "solid" : "outline"} full={true}
                            on_click={() => { stop = s; showing = false }}>{s}</Button>}
            </div>
        </Sheet>
    </div>
}

view SheetDemo() =
    <div.demo-row>
        <Sheet title="Share this trip" trigger="Share">
            <p>Anyone with the link can see the route and the times. Drag the handle up for more room, or down to close.</p>
            <div.demo-stack>
                <Button variant="outline" full={true}>Copy link</Button>
                <Button variant="outline" full={true}>Send by email</Button>
                <Button variant="outline" full={true}>Show QR code</Button>
            </div>
        </Sheet>
        <SheetDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "sheet", name: "Sheet", group: "Overlays",
    summary: "A bottom sheet on the browser's <dialog>: half or full height by its handle or a drag, Escape to close.",
    demo: SheetDemo })
