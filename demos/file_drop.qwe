component FileDropDemoLive() {
    state total = 0
    <div.demo-stack>
        <FileDrop name="fd-docs" label="Documents" accept=".pdf,.docx,.txt" multiple={true}
                  on_change={(fs) => { total = sum(fs | map((f) => f.size)) }}/>
        <p.demo-note>{total > 0 ? `${file_drop_size(total)} in all.` : "Nothing chosen yet."}</p>
    </div>
}

view FileDropDemo() =
    <div.demo-stack.demo-narrow>
        <FileDrop name="fd-photos" label="Photos" accept="image/*" multiple={true}
                  hint="PNG or JPEG, up to 10 MB each." required={true}/>
        <FileDropDemoLive/>
        <FileDrop name="fd-off" label="Contract" text="Uploads are closed" disabled={true}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "file_drop", name: "FileDrop", group: "Forms",
    summary: "Drop files or click to choose them: a real file input that a form posts, listing names and sizes.",
    demo: FileDropDemo })
