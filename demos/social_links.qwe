let social_links_demo_all = [
    { kind: "x", href: "https://x.com/quillolang" }, { kind: "github", href: "https://github.com/quillolang" },
    { kind: "linkedin", href: "https://linkedin.com/company/quillolang" }, { kind: "youtube", href: "https://youtube.com/@quillolang" },
    { kind: "instagram", href: "https://instagram.com/quillolang" }, { kind: "facebook", href: "https://facebook.com/quillolang" },
    { kind: "mastodon", href: "https://fosstodon.org/@quillolang" }, { kind: "bluesky", href: "https://bsky.app/profile/quillolang.org" },
    { kind: "tiktok", href: "https://tiktok.com/@quillolang" }, { kind: "discord", href: "https://discord.gg/quillolang" },
    { kind: "email", href: "mailto:hello@quillolang.org", label: "Email us" }, { kind: "rss", href: "/feed.xml" },
    { kind: "website", href: "https://quillolang.org" },
]

view SocialLinksDemo() =
    <div.demo-stack>
        <SocialLinks id="social-links-demo" links={social_links_demo_all}/>
        <div.demo-row>
            <SocialLinks variant="outline" links={take(social_links_demo_all, 4)}/>
            <SocialLinks variant="solid" size="sm" links={take(social_links_demo_all, 4)}/>
        </div>
        <SocialLinks variant="outline" size="lg" show_labels={true} links={[social_links_demo_all[1], social_links_demo_all[10], social_links_demo_all[0]]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "social_links", name: "SocialLinks", group: "Marketing",
    summary: "Icon links to accounts on X, GitHub, LinkedIn, YouTube, Mastodon, Bluesky and more, each named for screen readers.",
    tags: ["marketing", "social", "link", "icon", "no-js"],
    demo: SocialLinksDemo })
