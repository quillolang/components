let data_table_demo_team = [
    { name: "Ada Lovelace", role: "Engineering", hours: 1284.5, utilisation: 0.92 },
    { name: "Grace Hopper", role: "Engineering", hours: 1190, utilisation: 0.875 },
    { name: "Katherine Johnson", role: "Research", hours: 978.25, utilisation: 0.7 },
    { name: "Hedy Lamarr", role: "Design", hours: 1012, utilisation: null },
]

view DataTableDemo() =
    <div.demo-stack>
        <DataTable label="Invoices" search={true} page_size={10} order_by="issued" descending={true}
                   rows={data_table_demo_invoices} empty="No invoice matches."
                   columns={[
                       { key: "number", label: "Invoice", sortable: true },
                       { key: "customer", label: "Customer", sortable: true },
                       { key: "issued", label: "Issued", format: "date", sortable: true },
                       { key: "status", label: "Status", sortable: true },
                       { key: "tax", label: "Tax", format: "percent" },
                       { key: "total", label: "Total", format: "money", sortable: true },
                   ]}/>
        <DataTable label="Team" zebra={true} rows={data_table_demo_team}
                   columns={[
                       { key: "name", label: "Name", sortable: true },
                       { key: "role", label: "Team" },
                       { key: "hours", label: "Hours", format: "number", sortable: true },
                       { key: "utilisation", label: "Booked", format: "percent" },
                   ]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "data_table", name: "DataTable", group: "Data",
    summary: "Rows of data sorted by their headers, with search, pages, number, money, percent and date columns.",
    demo: DataTableDemo })
