view ComparisonTableDemo() =
    <div.demo-stack>
        <ComparisonTable id="comparison-table-demo-plans" label="Plans compared" picked={1}
                         options={[{ label: "Free", meta: "$0" }, { label: "Team", meta: "$12 / user / month" }, { label: "Business", meta: "Talk to us" }]}
                         features={[
                             { label: "Projects", values: ["3", "Unlimited", "Unlimited"] },
                             { label: "Members", values: ["1", "Up to 50", "Unlimited"], hint: "Guests are free" },
                             { label: "Version history", values: [false, true, true] },
                             { label: "Single sign-on", values: [false, false, true] },
                             { group: "Support" },
                             { label: "Email", values: [true, true, true], hint: "Within a day" },
                             { label: "Phone", values: [null, false, true] },
                         ]}/>
        <ComparisonTable id="comparison-table-demo-tools" label="Editors compared" options={["Vim", "Emacs", "VS Code"]}
                         features={[
                             { label: "Modal editing", values: [true, false, false] },
                             { label: "Written in", values: ["C", "Lisp", "TypeScript"] },
                             { label: "First release", values: ["1991", "1976", "2015"] },
                         ]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "comparison_table", name: "ComparisonTable", group: "Data",
    summary: "Features down the side and options across, with ticks, crosses and values in the cells, and one option picked out.",
    tags: ["data", "table", "commerce", "no-js"], demo: ComparisonTableDemo })
