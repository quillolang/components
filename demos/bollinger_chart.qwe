// Prices from a seeded random walk (Park–Miller), the same on every render: `count`
// candles from the day `from` on, skipping weekends, daily or hourly (10:00 to 16:00),
// rounded to `places` decimals.
fn bollinger_chart_demo_walk(seed: int, count: int, start: num, from: str, hourly: bool = false, places: int = 2) -> list {
    let s = seed
    let rnd = () => {
        s = s * 16807 % 2147483647
        s / 2147483647
    }
    let scale = pow(10, places)
    let cut = (v) => round(v * scale) / scale
    let p = start
    let day = from
    let hour = 10
    let out = []
    while len(out) < count {
        if date.weekday(day) <= 5 {
            let open = cut(p * (1 + (rnd() - 0.5) * 0.006))
            let close = cut(open * (1 + (rnd() - 0.485) * (hourly ? 0.012 : 0.035)))
            let high = cut(max([open, close]) * (1 + rnd() * 0.01))
            let low = cut(min([open, close]) * (1 - rnd() * 0.01))
            let volume = round((hourly ? 90000 : 900000) * (1 + rnd() * 1.5 + abs(close - open) * 30 / open))
            out = out | push({ time: hourly ? `${day}T${hour < 10 ? "0" : ""}${hour}:00:00Z` : day, open, high, low, close, volume })
            p = close
        }
        if hourly && hour < 16 && date.weekday(day) <= 5 {
            hour += 1
        } else {
            hour = 10
            day = date.add_days(day, 1)
        }
    }
    out
}

let bollinger_chart_demo_daily = bollinger_chart_demo_walk(61, 110, 96.2, "2026-04-06")

view BollingerChartDemo() =
    <div.demo-stack>
        <div id="bollinger_chart-demo-line">
            <BollingerChart label="Soylent, Bollinger 20, 2" show_label={true} candles={bollinger_chart_demo_daily} prefix="$"/>
        </div>
        <div id="bollinger_chart-demo-bars">
            <BollingerChart label="Soylent, last 50 days as candles, Bollinger 10, 1.5" show_label={true}
                            candles={drop(bollinger_chart_demo_daily, 60)} period={10} deviations={1.5} bars={true}
                            prefix="$" height={220}/>
        </div>
        <p.demo-note>Rings mark closes outside the bands; hover for the bands, %B and their width.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "bollinger_chart", name: "BollingerChart", group: "Charts",
    summary: "Prices with Bollinger bands of a period and a number of deviations, closes outside them marked, as a line or candles.",
    tags: ["chart", "data", "trading", "no-js"],
    demo: BollingerChartDemo })
