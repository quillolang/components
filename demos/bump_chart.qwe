view BumpChartDemo() =
    <div.demo-stack>
        <BumpChart label="League table after each round" show_label={true}
                   labels={["R1", "R2", "R3", "R4", "R5", "R6", "R7", "R8"]}
                   series={[{ name: "Lions", values: [3, 2, 1, 1, 1, 2, 2, 1] },
                            { name: "Hawks", values: [1, 1, 2, 3, 2, 1, 1, 2] },
                            { name: "Bears", values: [2, 3, 3, 2, 4, 4, 3, 3] },
                            { name: "Wolves", values: [5, 4, 4, 4, 3, 3, 4, 4] },
                            { name: "Foxes", values: [4, 5, 6, 5, 5, 5, 5, 5] },
                            { name: "Otters", values: [6, 6, 5, 6, 6, 6, 6, 6] }]}/>
        <BumpChart label="Languages by questions asked" show_label={true} ranked={false} suffix="k" row={30}
                   labels={["2021", "2022", "2023", "2024", "2025"]}
                   series={[{ name: "Python", values: [210, 236, 251, 262, 270] },
                            { name: "JavaScript", values: [240, 238, 229, 214, 205] },
                            { name: "Rust", values: [38, 51, 66, 84, 101] },
                            { name: "Go", values: [52, 58, 63, 70, 74] },
                            { name: "Quillo", values: [null, null, 12, 48, 96] }]}/>
        <p.demo-note>Quillo has no rank before 2023, so its line starts there.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "bump_chart", name: "BumpChart", group: "Charts",
    summary: "Rankings over time as curved lines between numbered places, from places or from values, with each line picked out on hover.",
    tags: ["chart", "data", "no-js"],
    demo: BumpChartDemo })
