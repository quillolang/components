let stacked_modal_demo_css = css`
.stacked-modal-demo-page { padding: 20px; border: 1px solid var(--ui-border); background: var(--ui-subtle); }
.stacked-modal-demo-page h3 { margin: 0 0 4px; }
.stacked-modal-demo-rows { margin: 12px 0 0; padding: 0; list-style: none; }
.stacked-modal-demo-rows li { padding: 12px 0; border-bottom: 1px solid var(--ui-border); }
`

component StackedModalDemoLive() {
    style global stacked_modal_demo_css
    state first = false
    state second = false
    state third = false
    state how = "Never"
    state closes = 0
    <div.demo-stack>
        <StackedModalPage>
            <div class="stacked-modal-demo-page">
                <h3>Thursday</h3>
                <p.demo-note>Repeats: <span class="stacked-modal-demo-how">{how}</span>. Closed: <span class="stacked-modal-demo-closes">{closes}</span>.</p>
                <div.demo-row>
                    <Button size="lg" on_click={() => { first = true }}>New event</Button>
                </div>
            </div>
        </StackedModalPage>
        <StackedModal title="New event" open={first} on_close={() => { first = false; closes += 1 }}>
            <p>Team review, 3 pm in room 4.</p>
            <Button size="lg" variant="outline" on_click={() => { second = true }}>Repeat</Button>
        </StackedModal>
        <StackedModal title="Repeat" open={second} on_close={() => { second = false; closes += 1 }}>
            <div.demo-stack>
                {for h in ["Never", "Every day", "Every week", "Every month"] =>
                    <Button size="lg" variant={h == how ? "solid" : "outline"} full={true} on_click={() => { how = h }}>{h}</Button>}
                <Button size="lg" variant="ghost" on_click={() => { third = true }}>Custom</Button>
            </div>
        </StackedModal>
        <StackedModal title="Custom" open={third} on_close={() => { third = false; closes += 1 }}>
            <ul.stacked-modal-demo-rows>
                {for n in range(40) => <li key={n}>Every {n + 2} days</li>}
            </ul>
        </StackedModal>
        <StackedModal title="Agree first" trigger="Must answer" dismissable={false}>
            <p>This one has to be closed by its button: a drag only stretches it.</p>
        </StackedModal>
    </div>
}

view StackedModalDemo() = <StackedModalDemoLive/>

ui_gallery = ui_gallery | push({ slug: "stacked_modal", name: "StackedModal", group: "Mobile",
    summary: "Modals over modals with the page behind scaled back as cards, dragged down one at a time; on a tablet, cards in the middle of the screen.",
    tags: ["mobile", "interactive", "tablet", "modal", "stack", "gesture"],
    needs: ["button", "bottom_sheet"], demo: StackedModalDemo })
