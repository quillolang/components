let keyboard_avoider_demo_css = css`
.keyboard-avoider-demo-scroll { height: 100%; overflow: auto; overscroll-behavior: contain; }
.keyboard-avoider-demo-form { display: grid; gap: 14px; padding: 16px; }
.keyboard-avoider-demo-form label { display: grid; gap: 4px; color: var(--ui-muted); font: 500 13px/1.3 var(--ui-font); }
.keyboard-avoider-demo-form input, .keyboard-avoider-demo-form textarea {
  box-sizing: border-box; width: 100%; min-height: 46px; padding: 10px 12px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius-sm);
  background: var(--ui-surface); color: var(--ui-fg); font: 16px/1.4 var(--ui-font);
}
.keyboard-avoider-demo-status { position: sticky; top: 0; z-index: 1; margin: 0; padding: 8px 16px; border-bottom: 1px solid var(--ui-border); background: var(--ui-subtle); color: var(--ui-muted); font: 13px/1.4 var(--ui-font); }
`

component KeyboardAvoiderDemoLive() {
    style global keyboard_avoider_demo_css
    state height = 0
    state changes = 0
    let fields = ["Full name", "Street", "Town", "Postcode", "Region", "Country", "Phone", "Email", "Company", "Reference"]
    <div.demo-phone>
        <div.keyboard-avoider-demo-scroll id="keyboard-avoider-demo-scroll">
            <p.keyboard-avoider-demo-status id="keyboard-avoider-demo-status" role="status" data-changes={changes}>
                {height > 0 ? `Keyboard up: ${height} px` : "On a phone, tap a field near the bottom."}
            </p>
            <KeyboardAvoider id="keyboard-avoider-demo" on_change={(k) => {
                height = k.height
                changes += 1
            }}>
                <form.keyboard-avoider-demo-form>
                    {for [i, f] in enumerate(fields) => <label key={f}>{f}
                        <input id={`keyboard-avoider-demo-f${i}`} name={`f${i}`} autocomplete="off"/></label>}
                    <label>A note
                        <textarea id="keyboard-avoider-demo-note" name="note" rows="12"></textarea></label>
                    <label>Agreed <input id="keyboard-avoider-demo-box" name="agreed" type="checkbox"/></label>
                </form>
            </KeyboardAvoider>
        </div>
    </div>
}

view KeyboardAvoiderDemo() = <div><KeyboardAvoiderDemoLive/></div>

ui_gallery = ui_gallery | push({ slug: "keyboard_avoider", name: "KeyboardAvoider", group: "Mobile",
    summary: "Keeps a focused field in view above the on-screen keyboard by visualViewport, on both systems, handing back on close.",
    tags: ["mobile", "interactive", "keyboard", "forms", "layout"],
    demo: KeyboardAvoiderDemo })
