component FormSummaryDemoLive() {
    state editing = null
    <div.demo-stack>
        <FormSummary columns={1} on_edit={(k) => { editing = k }} sections={[
            { title: "Shipping", key: "ship", items: [{ label: "Address", value: "1 Rue de Rivoli, 75001 Paris" }] },
            { title: "Payment", key: "pay", items: [{ label: "Card", value: "Visa ending 4242" }] },
        ]}/>
        <p.demo-note>{editing == null ? "Press Edit on a section." : `on_edit got "${editing}".`}</p>
    </div>
}

view FormSummaryDemo() =
    <div.demo-stack>
        <FormSummary sections={[
            { title: "Account", href: "#account", items: [{ label: "Name", value: "Ada Lovelace" }, { label: "Email", value: "ada@example.com" },
                                                           { label: "Newsletter", value: true }] },
            { title: "Plan", href: "#plan", items: [{ label: "Plan", value: "Team" }, { label: "Seats", value: 4 },
                                                     { label: "Add-ons", value: ["Audit log", "SSO"] }, { label: "Coupon", value: null }] },
        ]}/>
        <FormSummaryDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "form_summary", name: "FormSummary", group: "Forms",
    summary: "A read-only review of the values entered, in sections each with an Edit link, for the last step before sending.",
    tags: ["forms", "record", "list", "no-js"], demo: FormSummaryDemo })
