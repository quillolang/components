let checkbox_demo_topics = [{ label: "Releases", value: "releases", hint: "A note when a version ships." },
                            { label: "Events", value: "events" }, { label: "Jobs", value: "jobs" }]

component CheckboxDemoLive() {
    state picked = ["releases"]
    let all = len(picked) == len(checkbox_demo_topics)
    <div.demo-stack>
        <Checkbox label="All topics" checked={all} indeterminate={!all && len(picked) > 0}
                  on_change={(on) => { picked = on ? checkbox_demo_topics | map((t) => t.value) : [] }}/>
        <CheckboxGroup name="topics" label="Email me about" options={checkbox_demo_topics} values={picked}
                       on_change={(v, on) => { picked = on ? picked | push(v) : picked | filter((p) => p != v) }}/>
        <p.demo-note>Subscribed to {len(picked)} of {len(checkbox_demo_topics)}.</p>
    </div>
}

view CheckboxDemo() =
    <div.demo-stack>
        <Checkbox name="remember" label="Remember me" checked={true} hint="For 30 days on this device."/>
        <div.demo-row>
            <Checkbox name="mixed" label="Some files" indeterminate={true}/>
            <Checkbox name="off" label="Disabled" disabled={true}/>
        </div>
        <Checkbox name="terms" label="I accept the terms of service" required={true}
                  error="You need to accept them to go on."/>
        <CheckboxGroup name="days" label="Days" direction="row" values={["Mon", "Wed"]}
                       options={["Mon", "Tue", "Wed", "Thu", "Fri"]} hint="When we may call you."/>
        <CheckboxDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "checkbox", name: "Checkbox", group: "Forms",
    summary: "A checkbox drawn by CSS on a real input, with an indeterminate state, and a group of them in a fieldset.",
    tags: ["forms", "input", "no-js"],
    demo: CheckboxDemo })
