view IdCardDemo() =
    <div.demo-row style="align-items: flex-start; gap: 24px">
        <IdCard id="id-card-demo-ada" name="Ada Lovelace" role="Analytical engineer" department="Engines" org="Analytical Engines" kind="Staff"
                number="AE-0042" issued="2026-01-10" expires="2027-01-10"/>
        <IdCard id="id-card-demo-visitor" name="Grace Hopper" role="Visitor" org="Analytical Engines" kind="Visitor" tone="warning"
                src="https://i.pravatar.cc/192?img=47" number="V-2026-118" issued="2026-10-28" expires="2026-10-28" expired={true}>
            <svg width="160" height="30" viewBox="0 0 100 20" preserveAspectRatio="none" role="img" aria-label="Barcode" shape-rendering="crispEdges">
                <path fill="currentColor" d="M0 0h2v20H0zM3 0h1v20H3zM6 0h3v20H6zM11 0h1v20h-1zM14 0h2v20h-2zM18 0h1v20h-1zM21 0h3v20h-3zM26 0h1v20h-1zM29 0h2v20h-2zM33 0h1v20h-1zM36 0h3v20h-3zM41 0h2v20h-2zM45 0h1v20h-1zM48 0h3v20h-3zM53 0h1v20h-1zM56 0h2v20h-2zM60 0h1v20h-1zM63 0h3v20h-3zM68 0h2v20h-2zM72 0h1v20h-1zM75 0h3v20h-3zM80 0h1v20h-1zM83 0h2v20h-2zM87 0h1v20h-1zM90 0h3v20h-3zM95 0h1v20h-1zM98 0h2v20h-2z"/>
            </svg>
        </IdCard>
        <IdCard id="id-card-demo-wide" layout="landscape" name="Alan Turing" role="Research fellow" org="Bletchley Park" kind="Contractor" tone="neutral"
                number="BP-1912" expires="2027-06-23" logo="https://dummyimage.com/80x20/ffffff/17161f.png&text=BP"/>
    </div>

ui_gallery = ui_gallery | push({ slug: "id_card", name: "IdCard", group: "Data",
    summary: "An ID badge with a lanyard slot: photo or initials, name, role, organisation, number, issued and expiry dates, an Expired stamp, and a barcode slot.",
    tags: ["document", "card", "user", "print", "no-js"],
    needs: ["avatar"],
    demo: IdCardDemo })
