let permissions_matrix_demo_roles = [{ key: "owner", label: "Owner", locked: true }, { key: "editor", label: "Editor" }, { key: "viewer", label: "Viewer" }]
let permissions_matrix_demo_perms = [
    { key: "read", label: "Read", group: "Content" },
    { key: "write", label: "Write", group: "Content", hint: "Create and edit pages" },
    { key: "publish", label: "Publish", group: "Content" },
    { key: "invite", label: "Invite people", group: "Team" },
    { key: "billing", label: "See invoices", group: "Billing", hint: "Amounts and cards" },
]

component PermissionsMatrixDemoLive() {
    state last = null
    <div.demo-stack>
        <PermissionsMatrix roles={permissions_matrix_demo_roles} permissions={permissions_matrix_demo_perms}
                           granted={["owner:read", "owner:write", "owner:publish", "owner:invite", "owner:billing", "editor:read", "editor:write", "editor:publish", "viewer:read"]}
                           on_change={(r, p, on) => { last = `${r} ${on ? "gets" : "loses"} ${p}` }}/>
        <p.demo-note>{last == null ? "Tick a box, or a role's All box." : `Last change: ${last}.`}</p>
    </div>
}

view PermissionsMatrixDemo() =
    <div.demo-stack>
        <PermissionsMatrixDemoLive/>
        <form method="post" action="#permissions_matrix" id="permissions-matrix-demo-form">
            <PermissionsMatrix name="grant" label="Project roles" roles={take(permissions_matrix_demo_roles, 2) | map((r) => { key: r.key, label: r.label })}
                               permissions={take(permissions_matrix_demo_perms, 2) | map((p) => { key: p.key, label: p.label })} granted={["owner:read"]}/>
        </form>
    </div>

ui_gallery = ui_gallery | push({ slug: "permissions_matrix", name: "PermissionsMatrix", group: "Dashboard",
    summary: "Roles across, permissions down, a checkbox at each: a form sends the pairs ticked, a column box ticks a whole role.",
    tags: ["dashboard", "admin", "security", "forms", "table", "interactive"],
    demo: PermissionsMatrixDemo })
