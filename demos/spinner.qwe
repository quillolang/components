view SpinnerDemo() =
    <div.demo-stack>
        <div.demo-row>
            <Spinner size="sm"/>
            <Spinner/>
            <Spinner size="lg" label="Loading the report"/>
            <Spinner tone="neutral"/>
            <Spinner tone="success"/>
        </div>
        <div.demo-row>
            <Spinner size="sm" show_label={true} label="Saving"/>
            <Spinner show_label={true} label="Loading invoices"/>
            <p.demo-note><Spinner size="sm" tone="current" label="Sending"/> In a line of text, in its colour.</p>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "spinner", name: "Spinner", group: "Feedback",
    summary: "A loading spinner with a label for screen readers; it pulses instead of turning with reduced motion.",
    tags: ["feedback", "loading", "no-js"],
    demo: SpinnerDemo })
