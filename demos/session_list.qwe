let session_list_demo_sessions = [
    { id: "s1", browser: "Chrome 130", os: "macOS", device: "desktop", place: "Lisbon, Portugal", ip: "85.244.1.2", time: "2026-10-28T09:12:00Z", current: true },
    { id: "s2", browser: "Safari", os: "iOS 19", device: "mobile", place: "Porto, Portugal", time: "2026-10-26T20:03:00Z" },
    { id: "s3", browser: "Firefox 131", os: "Windows 11", place: "Madrid, Spain", ip: "81.33.4.5", time: "2026-10-14" },
    { id: "s4", browser: "Safari", os: "iPadOS 19", device: "tablet", time: "2026-09-30T07:45:00Z" },
]

component SessionListDemoLive() {
    state ended = []
    <div.demo-stack>
        <SessionList sessions={session_list_demo_sessions} on_sign_out={(id) => { ended = ended | push(id) }}/>
        <p.demo-note>{len(ended) == 0 ? "Sign one out, or all the others." : `Signed out: ${join(ended, ", ")}.`}</p>
    </div>
}

view SessionListDemo() =
    <div.demo-stack>
        <SessionListDemoLive/>
        <SessionList sign_out_action="#session_list" sessions={take(session_list_demo_sessions, 2)}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "session_list", name: "SessionList", group: "Dashboard",
    summary: "Signed-in devices with browser, system, place and time, this one marked, and Sign out for each or all the others.",
    tags: ["dashboard", "security", "settings", "list", "user", "interactive"],
    demo: SessionListDemo })
