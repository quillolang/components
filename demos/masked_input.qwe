component MaskedInputDemoLive() {
    state plate = ""
    state done = false
    <div.demo-stack>
        <MaskedInput name="mi-demo-plate" label="Licence plate" mask="AA-00-AA" on_change={(v, d) => {
            plate = v
            done = d
        }}/>
        <p.demo-note>{plate == "" ? "Nothing typed yet." : done ? `Plate ${plate} is complete.` : `So far: ${plate}`}</p>
    </div>
}

view MaskedInputDemo() {
    <div.demo-stack>
        <div.demo-row>
            <MaskedInput name="mi-demo-phone" label="Phone" mask="(###) ###-####" raw={true} hint="Sent as digits only."/>
            <MaskedInputDemoLive/>
        </div>
        <div.demo-row>
            <MaskedInput name="mi-demo-code" label="Product code" mask="AAA-####" value="abc1234" size="sm"/>
            <MaskedInput name="mi-demo-exp" label="Expiry" mask="##/##" placeholder="MM/YY" error="That card has expired."/>
        </div>
    </div>
}

ui_gallery = ui_gallery | push({ slug: "masked_input", name: "MaskedInput", group: "Forms",
    summary: "A box that shapes what is typed to a pattern (### ###-####, AA-00-AA) as it is typed, dropping what does not fit.",
    tags: ["forms", "input", "text", "interactive"], demo: MaskedInputDemo })
