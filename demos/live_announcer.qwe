component LiveAnnouncerDemoLive() {
    state n = 0
    <div.demo-stack>
        <div.demo-row>
            <Button id="live-announcer-demo-polite" variant="outline"
                    on_click={() => { n += 1; live_announcer_say(`${n * 3} results for “lisbon”`) }}>Search</Button>
            <Button id="live-announcer-demo-same" variant="outline" on_click={() => { live_announcer_say("Saved") }}>Save</Button>
            <Button id="live-announcer-demo-assertive" variant="outline" tone="danger"
                    on_click={() => { live_announcer_say("Could not send: you are offline", "assertive") }}>Fail</Button>
        </div>
    </div>
}

view LiveAnnouncerDemo() =
    <div.demo-stack>
        <LiveAnnouncer visible={true} history={4}/>
        <LiveAnnouncerDemoLive/>
        <p.demo-note>What screen readers would hear, shown here with visible on; the region itself is hidden.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "live_announcer", name: "LiveAnnouncer", group: "Utilities",
    summary: "A hidden aria-live region the page writes messages to with live_announcer_say(), politely or at once.",
    tags: ["utility", "accessibility", "notification", "interactive"],
    demo: LiveAnnouncerDemo })
