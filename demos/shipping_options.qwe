let shipping_options_demo_ways = [
    { value: "standard", label: "Standard", time: "3–5 business days", price: 0 },
    { value: "express", label: "Express", time: "1–2 business days", price: 12.9 },
    { value: "overnight", label: "Overnight", time: "Next business day, by 10 am", price: 29, hint: "Order by 4 pm" },
    { value: "pickup", label: "Collect in store", time: "Ready tomorrow", price: 0, hint: "Oxford Street", disabled: true },
]

component ShippingOptionsDemoLive() {
    state way = "standard"
    <div.demo-stack.demo-narrow>
        <ShippingOptions name="shipping-demo-live" value={way} options={shipping_options_demo_ways} on_change={(v) => { way = v }}/>
        <p.demo-note>Sending by {way} (on_change).</p>
    </div>
}

view ShippingOptionsDemo() =
    <div.demo-row style="align-items: flex-start; gap: 32px">
        <ShippingOptionsDemoLive/>
        <div.demo-narrow>
            <ShippingOptions name="shipping-demo-eur" label="Delivery" currency="EUR" locale="de-DE" required={true} error="Pick a delivery option"
                             options={[{ value: "post", label: "Post", time: "4–6 days", price: 4.95 }, { value: "courier", label: "Courier", time: "1–2 days", price: 14.5 }]}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "shipping_options", name: "ShippingOptions", group: "Commerce",
    summary: "Shipping methods as radio cards, each with its price and how long it takes; a plain form sends the choice.",
    tags: ["commerce", "checkout", "forms", "select", "card", "no-js"],
    needs: ["price"], demo: ShippingOptionsDemo })
