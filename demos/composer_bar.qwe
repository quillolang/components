component ComposerBarDemoLive() {
    state sent = []
    state clips = 0
    <div.demo-phone id="composer-bar-demo" style="height: 420px; display: flex; flex-direction: column">
        <div style="flex: 1; min-height: 0; overflow: auto; padding: 14px">
            <p.demo-note id="composer-bar-log">{len(sent) == 0 ? "Nothing sent yet." : join(sent, " | ")}</p>
            <p.demo-note id="composer-bar-clips">{clips} voice messages</p>
        </div>
        <ComposerBar id="composer-bar-live" limit={200} max_rows={4} max_files={3} max_mb={1}
                     on_send={(m) => { sent = sent + [`${m.text} (${len(m.files)})`] }}
                     on_voice={(v) => { clips += 1; sent = sent + [`voice ${v.type} ${v.seconds > 0}`] }}/>
    </div>
}

view ComposerBarDemo() =
    <div.demo-stack>
        <ComposerBarDemoLive/>
        <p.demo-note>Sent as a plain form when it is placed straight in a page, with no microphone:</p>
        <div style="position: relative"><ComposerBar id="composer-bar-plain" name="note" keyboard={false} voice={false} attach={false} action="#composer_bar" placeholder="A note"/></div>
    </div>

ui_gallery = ui_gallery | push({ slug: "composer_bar", name: "ComposerBar", group: "Mobile",
    summary: "A message box that grows to a limit, swaps send and voice, keeps attachments in a tray, rides above the keyboard and is safe to paste into.",
    tags: ["mobile", "interactive", "chat", "keyboard", "input", "voice"], demo: ComposerBarDemo })
