// Prices from a seeded random walk (Park–Miller), the same on every render: `count`
// candles from the day `from` on, skipping weekends, daily or hourly (10:00 to 16:00),
// rounded to `places` decimals.
fn volume_profile_demo_walk(seed: int, count: int, start: num, from: str, hourly: bool = false, places: int = 2) -> list {
    let s = seed
    let rnd = () => {
        s = s * 16807 % 2147483647
        s / 2147483647
    }
    let scale = pow(10, places)
    let cut = (v) => round(v * scale) / scale
    let p = start
    let day = from
    let hour = 10
    let out = []
    while len(out) < count {
        if date.weekday(day) <= 5 {
            let open = cut(p * (1 + (rnd() - 0.5) * 0.006))
            let close = cut(open * (1 + (rnd() - 0.485) * (hourly ? 0.012 : 0.035)))
            let high = cut(max([open, close]) * (1 + rnd() * 0.01))
            let low = cut(min([open, close]) * (1 - rnd() * 0.01))
            let volume = round((hourly ? 90000 : 900000) * (1 + rnd() * 1.5 + abs(close - open) * 30 / open))
            out = out | push({ time: hourly ? `${day}T${hour < 10 ? "0" : ""}${hour}:00:00Z` : day, open, high, low, close, volume })
            p = close
        }
        if hourly && hour < 16 && date.weekday(day) <= 5 {
            hour += 1
        } else {
            hour = 10
            day = date.add_days(day, 1)
        }
    }
    out
}

let volume_profile_demo_daily = volume_profile_demo_walk(31, 126, 88.4, "2026-04-01")
let volume_profile_demo_hourly = volume_profile_demo_walk(8, 35, 61250, "2026-10-19", true, 0)

view VolumeProfileDemo() =
    <div.demo-stack>
        <div id="volume_profile-demo-daily">
            <VolumeProfile label="Hooli, six months" show_label={true} candles={volume_profile_demo_daily} prefix="$"/>
        </div>
        <div id="volume_profile-demo-hourly">
            <VolumeProfile label="BTC-USD, a week of hours" show_label={true} candles={volume_profile_demo_hourly}
                           rows={16} value_area={68} decimals={0} height={220}/>
        </div>
        <p.demo-note>Hover a level for its volume, and how much of it closed up or down.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "volume_profile", name: "VolumeProfile", group: "Charts",
    summary: "Volume traded at each price level as bars beside the price, split into buying and selling, with the point of control and the value area marked.",
    tags: ["chart", "data", "trading", "no-js"],
    demo: VolumeProfileDemo })
