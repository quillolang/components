component RelativeTimeDemoLive() {
    state stamp = date.from_ms(now() - 12000, "UTC")
    <div.demo-row id="relative-time-demo-live">
        <span>Saved <RelativeTime time={stamp}/></span>
        <button type="button" @click={() => { stamp = date.from_ms(now() - 12000, "UTC") }}>Save again</button>
        <button type="button" @click={() => { stamp = date.from_ms(now() - 3 * 3600000, "UTC") }}>Saved 3 hours ago</button>
    </div>
}

view RelativeTimeDemo() =
    <div.demo-stack>
        <RelativeTimeDemoLive/>
        <ul.demo-stack id="relative-time-demo-fixed" style="margin: 0; padding-left: 18px; gap: 4px; font-size: 14px">
            <li>Posted <RelativeTime time="2026-10-28T13:55:00Z" at="2026-10-28T14:00:00Z"/></li>
            <li>Edited <RelativeTime time="2026-10-27T09:00:00Z" at="2026-10-28T14:00:00Z"/></li>
            <li>Joined <RelativeTime time="2026-08-01" at="2026-10-28T14:00:00Z"/></li>
            <li>Starts <RelativeTime time="2026-10-28T16:30:00Z" at="2026-10-28T14:00:00Z"/></li>
            <li>Short: <RelativeTime time="2026-10-21T14:00:00Z" at="2026-10-28T14:00:00Z" style="short"/>, <RelativeTime time="2026-10-28T13:59:57Z" at="2026-10-28T14:00:00Z" style="short" title={false}/></li>
        </ul>
    </div>

ui_gallery = ui_gallery | push({ slug: "relative_time", name: "RelativeTime", group: "Scheduling",
    summary: "\"3 minutes ago\" or \"in 2 hours\" from an ISO time, kept up to date in the browser, with the full date on hover.",
    tags: ["schedule", "time", "text", "interactive"], demo: RelativeTimeDemo })
