let size_advisor_demo_charts = [
    { id: "shirt", label: "Shirt", sizes: [
        { name: "S", chest: [86, 91], waist: [71, 76] },
        { name: "M", chest: [94, 99], waist: [79, 84] },
        { name: "L", chest: [102, 107], waist: [87, 92] },
        { name: "XL", chest: [110, 115], waist: [95, 100] }] },
    { id: "jeans", label: "Jeans", unit: "in", sizes: [
        { name: "30", waist: "30-31", inside_leg: "30-32" },
        { name: "32", waist: "32-33", inside_leg: "30-32" },
        { name: "34", waist: "34-35", inside_leg: "31-33" }] },
    { id: "cap", label: "Cap", sizes: [
        { name: "S/M", head: [54, 58] },
        { name: "L/XL", head: [57, 61] }] }]

component SizeAdvisorDemoLive() {
    state seen = null
    <div.demo-stack>
        <SizeAdvisor id="size-advisor-demo-live" title="Inches first" unit="in" fit="snug" name="me" values={{ chest: 36.5 }}
                     charts={[{ id: "tee", label: "Tee", sizes: [{ name: "S", chest: [86, 91] }, { name: "M", chest: [94, 99] }, { name: "bad", chest: "wide" }, "no"] }, { id: "none" }]}
                     on_change={(f) => { seen = f }}/>
        <p.demo-note>{seen == null ? "Change something to see on_change." : `on_change: ${seen.unit}, ${seen.fit}, tee ${seen.sizes.tee}.`}</p>
    </div>
}

view SizeAdvisorDemo() =
    <div.demo-stack>
        <SizeAdvisor id="size-advisor-demo" charts={size_advisor_demo_charts} values={{ chest: 92.5, waist: 78 }}
                     measures={[{ id: "chest", label: "Chest" }, { id: "waist", label: "Waist" }, { id: "inside_leg" }, { id: "head", label: "Head" }]}/>
        <SizeAdvisorDemoLive/>
        <SizeAdvisor id="size-advisor-demo-empty" title="No charts" name="empty" charts={[]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "size_advisor", name: "SizeAdvisor", group: "Commerce",
    summary: "Takes measurements in cm or inches and a size chart, recommends a size per garment, says how it fits by measurement, and settles between-sizes by a stated preference.",
    tags: ["smart", "interactive", "commerce", "sizing", "fit", "fashion"], demo: SizeAdvisorDemo })
