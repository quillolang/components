let top_app_bar_demo_notes = ["Survey of the north ridge", "Water samples, batch 12", "Trail markers to replace", "Rain gauge readings", "Bird count, Tuesday", "Soil pits 3 to 7"]

component TopAppBarDemoLive() {
    state presses = 0
    state hides = 0
    state keep = false
    <div.demo-stack>
        <div.demo-tablet>
            <TopAppBar title="Field notes" hide={!keep} nav_icon={keep ? "back" : "menu"} nav_label={keep ? "Back" : "Open menu"} on_nav={() => { presses += 1 }} on_hide={(_h) => { hides += 1 }}
                       actions={<button type="button" aria-label="Search" @click={() => { presses += 10 }}>
                           <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16zM21 21l-4.3-4.3"/></svg>
                       </button>}>
                {for r in range(0, 8) => <div key={r}>
                    {for n in top_app_bar_demo_notes => <p key={n} style="margin: 0; padding: 16px; border-bottom: 1px solid var(--ui-border)">{n}</p>}
                </div>}
            </TopAppBar>
        </div>
        <p class="demo-note">Pressed {presses}; went or came back {hides} {hides == 1 ? "time" : "times"}</p>
        <Button size="lg" variant="outline" on_click={() => { keep = !keep }}>{keep ? "Let the bar hide" : "Keep the bar"}</Button>
    </div>
}

view TopAppBarDemo() = <TopAppBarDemoLive/>

ui_gallery = ui_gallery | push({ slug: "top_app_bar", name: "TopAppBar", group: "Mobile",
    summary: "A Material top bar that hides as content scrolls down, returns on the way up, and takes a tint once content passes under it.",
    tags: ["mobile", "interactive", "tablet", "navigation", "header", "scroll"],
    demo: TopAppBarDemo })
