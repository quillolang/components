let phone_shell_demo_css = css`
.phone-shell-demo-list { margin: 0; padding: 0; list-style: none; }
.phone-shell-demo-row { display: flex; align-items: center; box-sizing: border-box; width: 100%; min-height: 56px; padding: 0 16px; border: 0; border-bottom: 1px solid var(--ui-border); background: transparent; color: inherit; font: inherit; text-align: left; }
.phone-shell-demo-form { display: grid; gap: 12px; padding: 16px; }
.phone-shell-demo-form input { box-sizing: border-box; width: 100%; min-height: 46px; padding: 0 12px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius-sm); background: var(--ui-surface); color: var(--ui-fg); font: 16px var(--ui-font); }
.phone-shell-demo-key { min-width: 44px; min-height: 44px; border: 0; background: transparent; color: var(--ui-accent); font: 600 15px var(--ui-font); }
`

let phone_shell_demo_tabs = [
    { id: "home", label: "Home", icon: "M3 11 12 3l9 8M5 9.5V21h14V9.5" },
    { id: "inbox", label: "Inbox", icon: "M4 4h16v16H4zM4 13h5l1.5 2h3L15 13h5", badge: 3 },
    { id: "search", label: "Search", icon: "M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14ZM16.5 16.5 21 21", badge: 150 },
    { id: "me", label: "You", icon: "●", badge: true },
]

component PhoneShellDemoLive() {
    style global phone_shell_demo_css
    state tab = "home"
    state open = null
    state again = 0
    state marks = 0
    state shown = true
    let names = get({ home: "Today", inbox: "Inbox", search: "Search", me: "You" }, tab)
    <div.demo-stack>
    <div.demo-phone id="phone-shell-demo-frame">
        {shown && <PhoneShell id="phone-shell-demo" title={open != null ? open : names} subtitle={`${again} times to the top, ${marks} marks`} tabs={phone_shell_demo_tabs}
                    tab={tab} screen={open} back={open != null}
                    actions={<button.phone-shell-demo-key type="button" id="phone-shell-demo-mark" @click={() => { marks += 1 }}>Mark</button>}
                    on_tab={(id) => { tab = id; open = null }} on_again={(_id) => { again += 1 }} on_back={() => { open = null }}>
            {tab == "search"
                ? <form.phone-shell-demo-form>
                    {for i in range(0, 14) => <input key={i} id={`phone-shell-demo-f${i}`} name={`f${i}`} aria-label={`Field ${i}`} placeholder={`Field ${i}`} autocomplete="off"/>}
                  </form>
                : (open != null
                    ? <p style="margin: 0; padding: 16px">{open}, in full.</p>
                    : <ul.phone-shell-demo-list>
                        {for i in range(1, tab == "home" ? 41 : 31) => <li key={`${tab}${i}`}>
                            <button.phone-shell-demo-row type="button" id={`phone-shell-demo-${tab}-${i}`} @click={() => { open = `Row ${i}` }}>{names} row {i}</button>
                        </li>}
                      </ul>)}
        </PhoneShell>}
    </div>
    <div><Button size="lg" variant="outline" id="phone-shell-demo-leave" on_click={() => { shown = !shown }}>{shown ? "Leave the app" : "Come back"}</Button></div>
    </div>
}

view PhoneShellDemo() = <div><PhoneShellDemoLive/></div>

ui_gallery = ui_gallery | push({ slug: "phone_shell", name: "PhoneShell", group: "Mobile",
    summary: "The whole app frame: header, scroller, tab bar, safe areas and keyboard handled once, for one fixed-height screen that does not bounce.",
    tags: ["mobile", "interactive", "tablet", "layout", "app-shell", "tabs"],
    needs: ["keyboard_avoider"],
    demo: PhoneShellDemo })
