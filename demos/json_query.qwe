let json_query_demo_text = json.stringify({
    store: "Hardware Co", open: true,
    items: [
        { sku: "A-1", name: "Bolt", qty: 3, price: 0.12, tags: ["steel", "m6"], "in stock": true },
        { sku: "A-2", name: "Nut", qty: 1, price: 0.08, tags: [], supplier: { name: "Acme" } },
        { sku: "B-7", name: "Saw", qty: 12, price: 19.5, tags: ["tool"], "in stock": false },
    ],
    supplier: { name: "Zenith", city: "Porto" },
}, true)

component JsonQueryDemoLive() {
    state found = null
    <div.demo-stack>
        <JsonQuery id="json-query-demo-live" title="Live" text={"[1, 2, 3, 4]"} path="$[1:3]" on_change={(r) => { found = r }}/>
        <p.demo-note>{found == null ? "Change the path to see on_change." : `on_change: ${len(found)} result${len(found) == 1 ? "" : "s"}${len(found) > 0 ? `, the first ${found[0].path} = ${found[0].value}` : ""}.`}</p>
    </div>
}

view JsonQueryDemo() =
    <div.demo-stack>
        <JsonQuery id="json-query-demo" text={json_query_demo_text} path="$.items[*].price" name="query"/>
        <JsonQueryDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "json_query", name: "JsonQuery", group: "Data",
    summary: "Runs a JSONPath over a JSON document as you type: wildcards, recursive descent and filters, each result with its path, and a clear message where a path fails.",
    tags: ["smart", "interactive", "json", "jsonpath", "query", "explorer"], demo: JsonQueryDemo })
