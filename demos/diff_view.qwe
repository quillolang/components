let diff_view_demo_before = `[server]
port = 8080
workers = 4
log = "info"

[database]
url = "sqlite://app.db"
pool = 5

[mail]
from = "hello@example.com"
`

let diff_view_demo_after = `[server]
port = 8443
workers = 8
log = "info"
tls = true

[database]
url = "postgres://db.internal/app"

[mail]
from = "hello@example.com"
`

let diff_view_demo_old = for i in range(1, 31) => i == 12 ? "    total = price * qty" : `    line ${i}`
let diff_view_demo_new = for i in range(1, 31) => i == 12 ? "    total = price * qty * (1 + tax)" : `    line ${i}`

view DiffViewDemo() =
    <div.demo-stack>
        <DiffView before={diff_view_demo_before} after={diff_view_demo_after}
                  before_name="config/app.toml" after_name="config/app.toml"/>
        <DiffView before={diff_view_demo_before} after={diff_view_demo_after} mode="split"
                  before_name="app.toml (main)" after_name="app.toml (deploy)"/>
        <DiffView before={join(diff_view_demo_old, "\n")} after={join(diff_view_demo_new, "\n")} context={2}
                  before_name="checkout.qwe"/>
        <DiffView before="same text" after="same text" before_name="README.md"/>
    </div>

ui_gallery = ui_gallery | push({ slug: "diff_view", name: "DiffView", group: "Data",
    summary: "The lines added and removed between two texts, unified or side by side, with line numbers.",
    demo: DiffViewDemo })
