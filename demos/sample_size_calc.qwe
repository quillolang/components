component SampleSizeCalcDemoLive() {
    state seen = "Change a figure to see on_change."
    <div.demo-stack>
        <SampleSizeCalc id="sample-size-calc-demo-live" title="Fall in sign-ups" name="signup" baseline="3" effect="-20" significance={1} power={90} sides="one" variants={3} daily={15000}
                        on_change={(r) => { seen = r.error != null ? `on_change: refused at ${r.field}.` : `on_change: ${r.per_variant} a variant.` }}/>
        <p.demo-note>{seen}</p>
    </div>
}

view SampleSizeCalcDemo() =
    <div.demo-stack>
        <SampleSizeCalc id="sample-size-calc-demo" title="Checkout test" baseline={10} effect={20} daily={2000}/>
        <SampleSizeCalcDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "sample_size_calc", name: "SampleSizeCalc", group: "Marketing",
    summary: "Visitors per variant and days to run for an A/B test, with the formula shown, refusing inputs that have no answer.",
    tags: ["smart", "interactive", "statistics", "experiment", "calculator", "marketing"], demo: SampleSizeCalcDemo })
