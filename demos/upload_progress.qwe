component UploadProgressDemoLive() {
    state sent = 0
    state status = "uploading"
    let size = 84000000
    if status == "uploading" && sent < size {
        every(400, () => {
            sent = min([size, sent + 6000000])
            if sent >= size { status = "done" }
        })
    }
    <div.demo-stack>
        <UploadProgress id="upload-progress-demo-live" name="holiday-in-lisbon.mp4" size={size} sent={sent}
                        speed={status == "uploading" ? 15000000 : null} status={status}
                        on_cancel={() => { status = "paused" }}/>
        <div.demo-row>
            <Button id="upload-progress-demo-restart" size="sm" variant="outline" on_click={() => { sent = 0; status = "uploading" }}>Start again</Button>
            <span.demo-note>It uploads by itself; Cancel pauses it.</span>
        </div>
    </div>
}

view UploadProgressDemo() =
    <div.demo-stack>
        <UploadProgressDemoLive/>
        <UploadProgress id="upload-progress-demo-half" name="quarterly-report-final-v3-really-final.pdf" size={4200000} sent={1554000} speed={620000}/>
        <UploadProgress id="upload-progress-demo-done" name="logo.svg" size={18400} sent={18400} status="done"/>
        <UploadProgress id="upload-progress-demo-error" name="scan-0042.tiff" size={9000000} sent={1200000} status="error" error="The connection dropped"/>
        <UploadProgress name="archive.zip" size={2500000000} sent={1000000000} status="paused"/>
    </div>

ui_gallery = ui_gallery | push({ slug: "upload_progress", name: "UploadProgress", group: "Feedback",
    summary: "One file's upload: name, bytes sent of its size, speed, time left, a bar, and Cancel; done, paused and error states.",
    tags: ["feedback", "progress", "upload", "file", "no-js"],
    demo: UploadProgressDemo })
