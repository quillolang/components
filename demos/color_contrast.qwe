component ColorContrastDemoLive() {
    state said = "Change a colour to see on_change."
    <div.demo-stack>
        <ColorContrast id="color-contrast-demo-live" title="Warning banner" name="banner" foreground="hsl(30, 90%, 50%)" background="#fff7e6"
                       sample="Your card expires this month"
                       on_change={(r) => { said = r == null ? "on_change: not a colour." : `on_change: ${r.foreground} on ${r.background}, AA ${r.aa ? "passes" : "fails"}.` }}/>
        <p.demo-note>{said}</p>
    </div>
}

view ColorContrastDemo() =
    <div.demo-stack>
        <ColorContrast id="color-contrast-demo" foreground="#777777" background="#ffffff"/>
        <ColorContrastDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "color_contrast", name: "ColorContrast", group: "Forms",
    summary: "Checks two colours against WCAG 2 for normal and large text, and finds the nearest colour that passes with the same hue and saturation.",
    tags: ["smart", "interactive", "colour", "accessibility", "wcag", "contrast"], demo: ColorContrastDemo })
