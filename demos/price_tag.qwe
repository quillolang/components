view PriceTagDemo() =
    <div.demo-stack>
        <div.demo-row style="gap: 36px; align-items: flex-start">
            <PriceTag amount={12} period="month" note="billed yearly"/>
            <PriceTag amount={89} old={120} currency="EUR" locale="de-DE" period="night" prefix="From"/>
            <PriceTag amount="Free" note="no card needed"/>
        </div>
        <div.demo-row style="gap: 36px; align-items: flex-start">
            <PriceTag amount={4.99} period="seat" size="sm"/>
            <PriceTag amount={240} period="year" size="lg" align="center" note="save 20%"/>
            <PriceTag amount={1999} currency="GBP" locale="en-GB" size="xl"/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "price_tag", name: "PriceTag", group: "Commerce",
    summary: "A bold price with its period (/month) and a note under it, for plans, rooms and seats.",
    tags: ["commerce", "price", "no-js", "marketing"],
    needs: ["price"], demo: PriceTagDemo })
