view StackedLayoutDemoBar(label: str) =
    <div style="padding: 10px 16px; background: var(--ui-subtle); border-block: 1px solid var(--ui-border); font-size: 13px; font-weight: 500">{label}</div>

view StackedLayoutDemo() =
    <div.demo-stack>
        <div id="stacked-layout-demo-short" style="height: 300px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius); overflow: auto">
            <StackedLayout height="100%" pad={16} header={<StackedLayoutDemoBar label="Header"/>} footer={<StackedLayoutDemoBar label="Footer, kept at the bottom"/>}>
                <p style="margin: 0">Short content: the footer stays at the bottom of the window anyway.</p>
            </StackedLayout>
        </div>
        <div id="stacked-layout-demo-long" style="height: 220px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius); overflow: auto">
            <StackedLayout height="100%" pad={16} sticky={true} header={<StackedLayoutDemoBar label="Sticky header"/>} footer={<StackedLayoutDemoBar label="Footer, pushed down by the content"/>}>
                {for i in range(1, 9) => <p>Paragraph {i}: long content pushes the footer down; scroll to see the header stay.</p>}
            </StackedLayout>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "stacked_layout", name: "StackedLayout", group: "Layout",
    summary: "Header, content and footer in three bands, the footer kept at the bottom of the viewport when the content is short.",
    tags: ["layout", "page", "no-js"], demo: StackedLayoutDemo })
