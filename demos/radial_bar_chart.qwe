view RadialBarChartDemo() =
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(380px, 1fr)); gap: 32px 40px">
        <RadialBarChart label="Goals reached today" show_label={true} suffix="%" limit={100} size={210}
                        items={[{ label: "Steps", value: 82 }, { label: "Exercise", value: 64 }, { label: "Stand", value: 100 },
                                { label: "Water", value: 45 }, { label: "Sleep", value: 91 }]}/>
        <RadialBarChart label="Sales by region" show_label={true} prefix="$" turn={360} size={200}
                        items={[{ label: "Europe", value: 48200 }, { label: "Americas", value: 39700 },
                                { label: "Asia", value: 27150 }, { label: "Africa", value: 8400 }]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "radial_bar_chart", name: "RadialBarChart", group: "Charts",
    summary: "Bars bent into rings around a centre, each as long as its value against a limit, with a legend that picks a ring out on hover.",
    tags: ["chart", "data", "dashboard", "no-js"],
    demo: RadialBarChartDemo })
