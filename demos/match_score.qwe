view MatchScoreDemo() =
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 12px; align-items: start">
        <MatchScore id="match-score-demo-live" competition="Premier League · Matchday 10" venue="Emirates Stadium" status="live" minute="67'"
                    href="#ars-che"
                    home={{ name: "Arsenal", short: "ARS", score: 2, color: "#db0007", scorers: ["Saka 23'", "Ødegaard 51'"] }}
                    away={{ name: "Chelsea", short: "CHE", score: 1, color: "#034694", scorers: ["Palmer 40' (pen)"] }}/>
        <MatchScore id="match-score-demo-final" competition="Cup · Quarter-final" status="final" winner="away"
                    note="Porto win 4–3 on penalties"
                    home={{ name: "Real Sociedad", score: 1, color: "#0067b1", note: "(a.e.t.)" }}
                    away={{ name: "Porto", score: 1, color: "#1d3b85" }}/>
        <MatchScore id="match-score-demo-ft" status="final" size="sm"
                    home={{ name: "Lyon", score: 0, color: "#d6001c" }} away={{ name: "Nantes", score: 3, color: "#fcd405" }}/>
        <MatchScore id="match-score-demo-next" competition="Premier League" status="scheduled" kickoff="2026-11-01T15:00:00Z" kickoff_text="Sat 3:00 PM"
                    home={{ name: "Leeds United", color: "#1d428a" }} away={{ name: "Everton", color: "#003399" }}/>
        <MatchScore id="match-score-demo-off" status="postponed" note="Waterlogged pitch; a new date will be set."
                    home={{ name: "Bristol City" }} away={{ name: "Hull" }}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "match_score", name: "MatchScore", group: "News",
    summary: "A game's score: both teams with crests or colours, the score and scorers, and where it stands: kick-off, live with the minute, half time, full time or postponed.",
    tags: ["news", "sports", "card", "live", "no-js"], demo: MatchScoreDemo })
