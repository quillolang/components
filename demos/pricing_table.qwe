view PricingTableDemo() =
    <div.demo-stack>
        <PricingTable plans={[
                { name: "Hobby", price: 0, period: "month", href: "#pricing_table", button: "Start free" },
                { name: "Pro", price: 12, old: 15, period: "month", note: "billed yearly", href: "#pricing_table", recommended: true },
                { name: "Team", price: 49, period: "month", note: "for 5 people", href: "#pricing_table" }]}
            features={[
                { group: "Usage" },
                { label: "Projects", values: ["3", "Unlimited", "Unlimited"] },
                { label: "Storage", values: ["1 GB", "50 GB", "1 TB"] },
                { label: "Custom domain", values: [false, true, true] },
                { group: "Support" },
                { label: "Community forum", values: [true, true, true] },
                { label: "Priority support", hint: "Answered within a day", values: [false, true, true] },
                { label: "Dedicated manager", values: [false, false, true] }]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "pricing_table", name: "PricingTable", group: "Commerce",
    summary: "Plans across and features down, with ticks, dashes and values in the cells and the recommended plan marked.",
    tags: ["commerce", "price", "table", "marketing", "no-js"],
    needs: ["price"], demo: PricingTableDemo })
