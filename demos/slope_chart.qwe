view SlopeChartDemo() =
    <div.demo-stack>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(420px, 1fr)); gap: 32px 40px">
            <SlopeChart label="Share of sales by channel" show_label={true} start_label="2021" end_label="2025" suffix="%"
                        items={[{ label: "Online", start: 31, end: 52 }, { label: "Stores", start: 54, end: 36 },
                                { label: "Wholesale", start: 11, end: 8 }, { label: "Marketplace", start: 4, end: 4 }]}/>
            <SlopeChart label="Median rent by city" show_label={true} start_label="2020" end_label="2025" prefix="$"
                        by_change={false} change={false}
                        items={[{ label: "Lisbon", start: 1150, end: 1690 }, { label: "Porto", start: 820, end: 1240 },
                                { label: "Madrid", start: 1280, end: 1610 }, { label: "Berlin", start: 1240, end: 1650 },
                                { label: "Vienna", start: 1010, end: 1150 }]}/>
        </div>
        <p.demo-note>In the second, Berlin, Madrid and Lisbon end close together: their labels move apart.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "slope_chart", name: "SlopeChart", group: "Charts",
    summary: "A line per item from its value then to its value now, coloured by rise or fall, with labelled ends that keep apart.",
    tags: ["chart", "data", "no-js"],
    demo: SlopeChartDemo })
