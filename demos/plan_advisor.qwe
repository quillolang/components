let plan_advisor_demo_meters = [
    { id: "seats", label: "Seats", low: 1, high: 50, start: 8 },
    { id: "gb", label: "Storage", unit: "GB", low: 0, high: 1000, step: 10, start: 120 }]

let plan_advisor_demo_plans = [
    { id: "free", name: "Free", price: 0, included: { seats: 1, gb: 5 } },
    { id: "team", name: "Team", price: "29", annual_discount: 20, included: { seats: 5, gb: 50 }, overage: { seats: { price: "8" }, gb: { per: 10, price: "2" } } },
    { id: "biz", name: "Business", price: "99", annual_discount: 20, included: { seats: 20, gb: 500 }, overage: { seats: { price: "7.50" }, gb: { per: 100, price: "15" } } }]

component PlanAdvisorDemoLive() {
    state seen = null
    <div.demo-stack>
        <PlanAdvisor id="plan-advisor-demo-live" title="An API, by requests" currency="EUR" name="api"
                     meters={[{ id: "calls", label: "Calls a month", unit: "calls", high: 1000000, start: 150000 }]}
                     plans={[{ id: "pay", name: "Pay as you go", price: "10", included: { calls: 1000 }, overage: { calls: { per: 1000, price: "0.50" } } },
                             { id: "flat", name: "Flat", price: "100", included: { calls: "unlimited" } }, { id: "bad", name: "Odd", price: "soon" }]}
                     on_change={(f) => { seen = f }}/>
        <p.demo-note>{seen == null ? "Change a figure to see on_change." : `on_change: ${seen.best.plan.name}, ${seen.best.year} a year, ${seen.billing}.`}</p>
    </div>
}

view PlanAdvisorDemo() =
    <div.demo-stack>
        <PlanAdvisor id="plan-advisor-demo" meters={plan_advisor_demo_meters} plans={plan_advisor_demo_plans}/>
        <PlanAdvisorDemoLive/>
        <PlanAdvisor id="plan-advisor-demo-limit" title="Nothing holds it" name="limit" meters={[{ id: "seats", label: "Seats", high: 500, start: 400 }]}
                     plans={[{ id: "a", name: "Small", price: 5, included: { seats: 10 } }]}/>
        <PlanAdvisor id="plan-advisor-demo-empty" title="Nothing to go on" name="empty" meters={[{ id: "m", high: 0 }]} plans={[]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "plan_advisor", name: "PlanAdvisor", group: "Commerce",
    summary: "Usage sliders against plans with included amounts, overage and an annual discount: the actual cost of each, the cheapest, and at what usage the answer changes.",
    tags: ["smart", "interactive", "commerce", "pricing", "plans", "billing"], demo: PlanAdvisorDemo })
