component ActionSheetDemoLive() {
    state did = "nothing yet"
    state closes = 0
    <div.demo-stack>
        <div.demo-row>
            <ActionSheet title="Holiday photo" message="Taken on 12 August, 2.4 MB" trigger="Photo options"
                         actions={[{ label: "Share", value: "share" }, "Duplicate", { label: "Move to album", value: "move" },
                                   { label: "Print", value: "print", disabled: true }, { label: "Delete photo", value: "delete", destructive: true }]}
                         on_pick={(v) => { did = v }} on_close={() => { closes += 1 }}/>
            <ActionSheet title="Choose a size" trigger="Long list"
                         actions={["Extra small", "Small", "Medium", "Large", "Extra large", "Size 6", "Size 8", "Size 10", "Size 12", "Size 14", "Size 16", "Size 18", "Size 20", "Size 22", "Size 24", "Size 26"]}
                         on_pick={(v) => { did = v }}/>
        </div>
        <p.demo-note>Chosen: <span class="action-sheet-demo-did">{did}</span>. Closed: <span class="action-sheet-demo-closes">{closes}</span>.</p>
    </div>
}

view ActionSheetDemo() = <ActionSheetDemoLive/>

ui_gallery = ui_gallery | push({ slug: "action_sheet", name: "ActionSheet", group: "Mobile",
    summary: "A list of actions rising from the bottom, with a destructive style and Cancel: swipe down or the phone's back gesture closes it; on a tablet, a card by what opened it.",
    tags: ["mobile", "interactive", "tablet", "sheet", "menu", "gesture"],
    needs: ["button", "bottom_sheet"], demo: ActionSheetDemo })
