component VoteButtonsDemoLive() {
    state v = 0
    <div.demo-row>
        <VoteButtons score={41} on_change={(x) => { v = x }}/>
        <span.demo-note>{v == 1 ? "Voted up." : v == -1 ? "Voted down." : "No vote."}</span>
    </div>
}

view VoteButtonsDemo() =
    <div.demo-stack>
        <VoteButtonsDemoLive/>
        <div.demo-row>
            <VoteButtons score={128} vote={1} name="vote" layout="horizontal"/>
            <VoteButtons score={-3} vote={-1} layout="horizontal" size="sm"/>
            <VoteButtons score={7} size="lg"/>
            <VoteButtons score={2} disabled={true}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "vote_buttons", name: "VoteButtons", group: "Actions",
    summary: "Up and down votes around a score that follows them, as on a forum, in a column or a row.",
    tags: ["button", "social", "forms", "interactive"],
    demo: VoteButtonsDemo })
