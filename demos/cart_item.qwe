component CartItemDemoLive() {
    state qty = 2
    state gone = false
    <div.demo-stack>
        {!gone && <CartItem id="runner" name="Trail runner" options={[{ label: "Size", value: "42" }, "Black"]} price={89} quantity={2} limit={5}
                            image="https://picsum.photos/seed/runner/200/200" href="#cart_item"
                            on_change={(n) => { qty = n }} on_remove={() => { gone = true }}/>}
        <p.demo-note>{gone ? "Removed (on_remove)." : `Quantity ${qty} (on_change); at most 5.`}</p>
    </div>
}

view CartItemDemo() =
    <div.demo-stack>
        <CartItemDemoLive/>
        <form method="post" action="/cart" @submit={(e) => { e.preventDefault() }}>
            <CartItem id="beanie" name="Wool beanie" options={["One size"]} price={24} currency="EUR" locale="de-DE" quantity={1}
                      image="https://picsum.photos/seed/beanie/200/200" field="qty[beanie]" remove_field="remove" stock="low"/>
            <CartItem id="bottle" name="Insulated bottle, 750 ml" price={32.5} quantity={3} size="sm"
                      image="https://picsum.photos/seed/bottle/200/200" field="qty[bottle]" remove_field="remove" stock="out"/>
        </form>
        <p.demo-note>The second two are in a plain form: the quantities are inputs named qty[...], and Remove is a submit button named remove.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "cart_item", name: "CartItem", group: "Commerce",
    summary: "One line of a cart: picture, name and options, a quantity control, the line's total and Remove, as inputs a form sends.",
    tags: ["commerce", "cart", "price", "forms", "input", "interactive"],
    needs: ["price"], demo: CartItemDemo })
