let receipt_share_demo_one = { title: "Harbour Lettings", status: "Paid", at: "2026-11-01T09:43:00Z", ref: "TX-20261101-0042", from: "Everyday •• 4021", note: "November rent",
    lines: [{ label: "Rent, November", amount: 950m }, { label: "Parking", amount: "45.10" }, { label: "Transfer fee", amount: 1.50m }], total: 996.60m }
let receipt_share_demo_two = { title: "A very long merchant name that has to break over more than one line", status: "Paid", at: "2026-10-30",
    lines: [{ label: "Coffee", amount: 3.10m }, { label: "Cake", amount: 4.20m }] }

component ReceiptShareDemoLive() {
    state log = "Nothing yet"
    state second = false
    <div.demo-stack>
        <ReceiptShare receipt={second ? receipt_share_demo_two : receipt_share_demo_one} on_share={(how) => { log = `Shared: ${how}` }}/>
        <Button id="rcptshare-next" size="lg" variant="ghost" on_click={() => { second = !second }}>Another receipt</Button>
        <p.demo-note id="rcptshare-log">{log}</p>
    </div>
}

view ReceiptShareDemo() =
    <div.demo-stack>
        <ReceiptShareDemoLive/>
        <div id="rcptshare-off"><ReceiptShare receipt={{ title: "Does not add up", lines: [{ label: "One", amount: 1m }, { label: "Two", amount: 2m }], total: 4m }}/></div>
        <div id="rcptshare-bad"><ReceiptShare receipt={{ lines: [{ label: "Odd", amount: "abc" }, { amount: 2 }], at: "never" }} locale="de-DE" currency="EUR"/></div>
    </div>

ui_gallery = ui_gallery | push({ slug: "receipt_share", name: "ReceiptShare", group: "Mobile",
    summary: "A receipt drawn as a picture for the share sheet, the numbers the same as on screen, falling back to text.",
    tags: ["mobile", "interactive", "banking", "receipt", "share", "tablet"],
    needs: ["price", "button"],
    demo: ReceiptShareDemo })
