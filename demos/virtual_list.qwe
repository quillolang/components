let virtual_list_demo_first = ["Ada", "Grace", "Alan", "Katherine", "Linus", "Margaret", "Dennis", "Barbara", "Ken", "Frances", "Edsger", "Radia"]
let virtual_list_demo_last = ["Lovelace", "Hopper", "Turing", "Johnson", "Torvalds", "Hamilton", "Ritchie", "Liskov", "Thompson", "Allen", "Dijkstra", "Perlman", "Knuth"]
let virtual_list_demo_teams = ["Design", "Platform", "Growth", "Support", "Research", "Billing"]

// 10,000 people, made the same way on the server and in the browser.
fn virtual_list_demo_people(n: int) -> list =
    for i in range(0, n) => {
        let a = virtual_list_demo_first[i % 12]
        let b = virtual_list_demo_last[(i * 7) % 13]
        { title: `${a} ${b}`, subtitle: `${lower(a)}.${lower(b)}${i}@example.com`, meta: virtual_list_demo_teams[(i * 5) % 6],
          value: `u${i + 1}` }
    }

component VirtualListDemoLive() {
    state picked = null
    let people = virtual_list_demo_people(10000)
    <div.demo-stack>
        <VirtualList id="vl-people" label="People" items={people} height={340} name="person"
                     on_select={(v) => { picked = v }}/>
        <p.demo-note>10,000 people; {picked == null ? "none picked" : `picked ${picked}`}.</p>
    </div>
}

view VirtualListDemo() =
    <div.demo-row style="align-items: flex-start; gap: 24px">
        <div style="flex: 2 1 320px; min-width: 0"><VirtualListDemoLive/></div>
        <div style="flex: 1 1 200px; min-width: 0">
            <VirtualList id="vl-tz" label="Time zones" item_height={36} height={340} selected="Europe/Lisbon"
                         items={["Africa/Cairo", "Africa/Lagos", "America/Chicago", "America/Los_Angeles", "America/New_York",
                                 "America/Sao_Paulo", "Asia/Dubai", "Asia/Kolkata", "Asia/Shanghai", "Asia/Singapore",
                                 "Asia/Tokyo", "Australia/Sydney", "Europe/Berlin", "Europe/Lisbon", "Europe/London",
                                 "Europe/Madrid", "Europe/Paris", "Pacific/Auckland", "UTC"]}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "virtual_list", name: "VirtualList", group: "Data",
    summary: "A list of thousands of items that stays fast by drawing only those in view, with keyboard picking.",
    tags: ["data", "list", "interactive"],
    demo: VirtualListDemo })
