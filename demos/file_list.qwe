let file_list_demo_files = [
    { id: 1, name: "Q3 report.pdf", size: 2483112, modified: "2026-10-02T09:14:00", href: "#file_list" },
    { id: 2, name: "Budget 2027.xlsx", size: 84211, modified: "2026-10-21T16:40:00", href: "#file_list" },
    { id: 3, name: "Team offsite.jpg", size: 3912004, modified: "2026-09-18T12:00:00", href: "#file_list" },
    { id: 4, name: "Contract draft.docx", size: 41250, modified: "2026-10-25T08:05:00", href: "#file_list" },
    { id: 5, name: "Brand assets.zip", size: 18440230, modified: "2026-08-30T17:22:00", href: "#file_list" },
    { id: 6, name: "notes.md", size: 812, modified: "2026-10-27T21:10:00", href: "#file_list" },
]

component FileListDemoLive() {
    state docs = file_list_demo_files
    state picked = []
    <div.demo-stack>
        <FileList id="fl-live" label="Shared with me" files={docs} layout="grid" selectable={true} order_by="modified"
                  descending={true}
                  on_select={(fs) => { picked = fs | map((f) => f.name) }}
                  on_delete={(f) => { docs = docs | filter((d) => d.id != f.id) }}/>
        <p.demo-note>{len(picked) == 0 ? "Nothing picked." : `Picked: ${join(picked, ", ")}.`}</p>
    </div>
}

view FileListDemo() =
    <div.demo-stack>
        <FileList id="fl-docs" label="Project files" files={file_list_demo_files} selectable={true}
                  delete_action="/files/delete"/>
        <FileListDemoLive/>
        <FileList id="fl-none" label="Archive" files={[]} empty="The archive is empty."/>
    </div>

ui_gallery = ui_gallery | push({ slug: "file_list", name: "FileList", group: "Data",
    summary: "Files as a table or a grid, with kind icons, sizes and dates, sorted, picked, downloaded or deleted.",
    demo: FileListDemo })
