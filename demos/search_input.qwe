let search_input_demo_books = ["Middlemarch", "Moby-Dick", "Mrs Dalloway", "Persuasion", "The Leopard",
    "The Master and Margarita", "To the Lighthouse", "War and Peace"]

component SearchInputDemoLive() {
    state q = ""
    state sent = ""
    let found = search_input_demo_books | filter((b) => contains(lower(b), lower(q)))
    <div.demo-stack.demo-narrow>
        <SearchInput name="book" label="Find a book" placeholder="Title" on_input={(t) => { q = t }}
                     on_submit={(t) => { sent = t }}/>
        <p.demo-note>{len(found)} of {len(search_input_demo_books)}: {join(found, ", ")}</p>
        {sent != "" && <p.demo-note>Enter pressed with “{sent}”.</p>}
    </div>
}

view SearchInputDemo() =
    <div.demo-stack>
        <form.demo-narrow method="get" action="#search_input">
            <SearchInput name="q" placeholder="Search the docs" value="components" hint="Press Enter to search."/>
        </form>
        <div.demo-row>
            <SearchInput name="s" size="sm" placeholder="Small"/>
            <SearchInput name="d" placeholder="Disabled" disabled={true}/>
        </div>
        <SearchInputDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "search_input", name: "SearchInput", group: "Forms",
    summary: "A search box with a magnifier and a clear button; Escape clears, Enter submits its form.",
    demo: SearchInputDemo })
