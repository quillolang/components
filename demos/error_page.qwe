view ErrorPageDemo() =
    <div.demo-stack>
        <ErrorPage id="error-page-demo-404" search="#error_page"
                   links={[{ label: "Go home", href: "#error_page" }, { label: "Read the docs", href: "#error_page" }]}/>
        <div.demo-row style="align-items: stretch">
            <div style="flex: 1; min-width: 260px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius)">
                <ErrorPage id="error-page-demo-500" code={500} reference="req_8f3a21" home="#error_page"/>
            </div>
            <div style="flex: 1; min-width: 260px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius)">
                <ErrorPage code={403} title="Members only" text="This area is for members of the workspace. Ask an admin to invite you."
                           links={[{ label: "Sign in", href: "#error_page" }, { label: "Go home", href: "#error_page" }]}/>
            </div>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "error_page", name: "ErrorPage", group: "Feedback",
    summary: "A 404 or 500 page: the code large, what it means, a search box if wanted, and links to go on from.",
    tags: ["feedback", "page", "status", "navigation", "no-js"],
    demo: ErrorPageDemo })
