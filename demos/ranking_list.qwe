view RankingListDemo() =
    <div.demo-row style="align-items: flex-start; gap: 32px">
        <div style="flex: 1 1 300px; max-width: 400px">
            <RankingList id="ranking-list-demo-songs" label="Top songs this week" items={[
                { label: "Midnight City", meta: "M83", previous: 3, value: "1.2M plays", href: "#midnight" },
                { label: "Dreams", meta: "Fleetwood Mac", previous: 1, value: "1.1M plays" },
                { label: "Running Up That Hill", meta: "Kate Bush", value: "980K plays" },
                { label: "Heroes", meta: "David Bowie", previous: 4, value: "870K plays" },
                { label: "Blue Monday", meta: "New Order", previous: 2, value: "700K plays" },
            ]}/>
        </div>
        <div style="flex: 1 1 220px; max-width: 300px">
            <RankingList id="ranking-list-demo-searches" label="Trending searches" start={11} show_new={false} items={[
                { label: "quillo components", move: "up", by: 6 },
                { label: "css nesting", move: "same" },
                { label: "server functions", move: "new" },
                { label: "sqlite wal", move: "down", by: 1 },
            ]}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "ranking_list", name: "RankingList", group: "Data",
    summary: "A ranked list with how each item moved since last time: up, down, the same or new, said in words to screen readers.",
    tags: ["data", "list", "no-js"], demo: RankingListDemo })
