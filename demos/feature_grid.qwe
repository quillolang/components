let feature_grid_demo_items = [
    { icon: "⚡", title: "No build step", text: "Save the file and the page is there. Nothing to install but one binary." },
    { icon: "🔒", title: "Safe by default", text: "Escaped HTML, parameterised SQL, records checked at the door." },
    { icon: "📡", title: "Live data", text: "A query the page follows as rows change, with nothing to wire up.", href: "#feature_grid" },
    { icon: "🧩", title: "Components", text: "Views on the server, components in the browser, one language for both." },
    { icon: "🗄️", title: "A database inside", text: "SQLite built in, Postgres and MySQL a connection string away." },
    { icon: "🚀", title: "One file to deploy", text: "Copy the binary and the program; it serves, it watches, it reloads." },
]

view FeatureGridDemo() =
    <div.demo-stack>
        <FeatureGrid id="feature-grid-demo" title="Everything in one file" text="What you would otherwise assemble from a dozen packages."
                     features={feature_grid_demo_items}/>
        <FeatureGrid columns={3} variant="cards" align="center">
            <Feature title="Fast" icon={<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg>}>
                Pages in well under a millisecond, components resumed, not rebuilt.
            </Feature>
            <Feature title="Small" icon={<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="3"/><path d="M9 12h6"/></svg>}>
                A 10 KB runtime, and only the components a page shows.
            </Feature>
            <Feature title="Checked" icon={<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>}>
                Types, effects and SQL looked over before the program runs.
            </Feature>
        </FeatureGrid>
    </div>

ui_gallery = ui_gallery | push({ slug: "feature_grid", name: "FeatureGrid", group: "Marketing",
    summary: "A grid of a product's features, each an icon, a title and a sentence, from a list or written by hand (Feature).",
    tags: ["marketing", "section", "grid", "card", "no-js"],
    demo: FeatureGridDemo })
