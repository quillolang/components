let json_table_demo_names = ["Ada Lovelace", "Grace Hopper", "Alan Turing", "Katherine Johnson", "Linus Torvalds",
    "Margaret Hamilton", "Dennis Ritchie", "Barbara Liskov", "Ken Thompson", "Radia Perlman", "Edsger Dijkstra"]
let json_table_demo_cities = ["Berlin", "Lisbon", "London", "Madrid", "New York", "Oslo", "Paris", "São Paulo", "Tokyo", "Toronto"]
let json_table_demo_plans = ["free", "team", "business", "enterprise"]
let json_table_demo_tags = ["beta", "vip", "churn-risk", "partner", "trial", "invoice"]
let json_table_demo_kinds = ["login", "view", "order", "refund", "logout"]

// An API's answer: { meta, users (3,000), events (50,000) }, made the same way on
// the server and in the browser.
fn json_table_demo_data(n: int, events: int) -> map = {
    meta: { source: "accounts-api", version: 3, generated: "2026-10-28T09:00:00Z", paging: { page: 1, per_page: n, total: n } },
    users: for i in range(0, n) => {
        let name = json_table_demo_names[i % 11]
        {
            id: 1000 + i,
            name,
            email: `${lower(split(name, " ")[0])}.${i}@example.com`,
            active: i % 7 != 0,
            plan: json_table_demo_plans[(i * 3) % 4],
            score: ((i * 37) % 1000) / 10,
            address: { city: json_table_demo_cities[i % 10], zip: `${10000 + (i * 13) % 89999}`,
                       geo: { lat: ((i * 7) % 180) - 90, lng: ((i * 11) % 360) - 180 } },
            tags: take(drop(json_table_demo_tags, i % 3), i % 4),
            orders: for j in range(0, i % 4) => {
                number: `ORD-${20000 + i * 4 + j}`,
                total: ((i * 7919 + j * 104729) % 50000) / 100,
                items: for k in range(0, j + 1) => { sku: `SKU-${(i + k) % 97}`, qty: k + 1 },
            },
            manager: i % 9 == 0 ? null : 1000 + (i % 50),
        }
    },
    events: for i in range(0, events) => { at: 1767225600 + i * 61, kind: json_table_demo_kinds[(i * 7) % 5], user: 1000 + (i * 31) % n },
}

component JsonTableDemoLive() {
    let data = json_table_demo_data(3000, 50000)
    <JsonTable id="jt-api" label="Accounts API" value={data} path={["users"]} filename="accounts" height={400}/>
}

view JsonTableDemo() =
    <div.demo-stack>
        <JsonTableDemoLive/>
        <p.demo-note>3,000 users and 50,000 events. Open a cell's object or array, open it as the table, go back by the path, search, export.</p>
        <JsonTable id="jt-config" label="Settings" height={240} filename="settings" value={{
            name: "billing-worker",
            replicas: 3,
            "max-retries": 5,
            debug: false,
            region: null,
            queues: ["invoices", "refunds", "payouts"],
            database: { url: "postgres://db.internal/billing", pool: 20, timeout_ms: 1500.5 },
        }}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "json_table", name: "JsonTable", group: "Data",
    summary: "JSON as a table: open nested objects and arrays in place or as the table, search at every depth, export as JSON or CSV, thousands of lines kept fast.",
    demo: JsonTableDemo })
