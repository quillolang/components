view CorrectionNoticeDemo() =
    <div.demo-stack style="gap: 18px">
        <CorrectionNotice id="correction-notice-demo-fix" date="2026-10-29" href="#corrections">
            An earlier version of this article misstated the year the Tagus bridge opened. It was 1966, not 1962.
        </CorrectionNotice>
        <CorrectionNotice id="correction-notice-demo-note" kind="editors_note" date="2026-10-30T09:15:00Z">
            This article has been updated to include a response from the Ministry of Health, received after publication.
        </CorrectionNotice>
        <CorrectionNotice id="correction-notice-demo-retract" kind="retraction" date_text="Oct. 28">
            The Ledger has retracted this article. Its central claim, that the contract was awarded without a tender, was not true.
        </CorrectionNotice>
        <CorrectionNotice id="correction-notice-demo-end" kind="clarification" placement="end" date="2026-10-27" href="#standards" link="How we correct our journalism">
            This article has been amended to make clear that the figures are the council's estimates, not its final accounts.
        </CorrectionNotice>
    </div>

ui_gallery = ui_gallery | push({ slug: "correction_notice", name: "CorrectionNotice", group: "News",
    summary: "A correction, clarification, update, editor's note or retraction on a story, dated, with a link to the corrections policy; boxed on top or a line at the end.",
    tags: ["news", "notice", "article", "feedback", "no-js"], demo: CorrectionNoticeDemo })
