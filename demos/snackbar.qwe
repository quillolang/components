component SnackbarDemoLive() {
    state archived = 0
    state restored = 0
    <div.demo-stack>
        <div.demo-row>
            <Button id="snackbar-demo-archive" variant="outline"
                    on_click={() => {
                        archived += 1
                        snackbar_show("Message archived", { action: "Undo", on_action: () => { restored += 1 } })
                    }}>Archive a message</Button>
            <Button id="snackbar-demo-saved" variant="outline"
                    on_click={() => { snackbar_show("Draft saved", { tone: "success", seconds: 2 }) }}>Save a draft</Button>
            <Button id="snackbar-demo-failed" variant="outline" tone="danger"
                    on_click={() => { snackbar_show("Could not send. Check the connection and try again.", { tone: "danger", seconds: 0 }) }}>Fail to send</Button>
        </div>
        <p.demo-note>Archived {archived}, restored {restored}. Press the buttons quickly: each message waits its turn.</p>
    </div>
}

view SnackbarDemo() =
    <div.demo-stack>
        <Snackbar/>
        <SnackbarDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "snackbar", name: "Snackbar", group: "Feedback",
    summary: "A short message along the bottom of the window with one action, shown from anywhere by calling snackbar_show().",
    tags: ["feedback", "notification", "toast", "status", "interactive"],
    demo: SnackbarDemo })
