let paywall_sheet_demo_plans = [
    { id: "week", name: "Weekly", price: "2.99", period: "week" },
    { id: "month", name: "Monthly", price: "9.99", period: "month" },
    { id: "year", name: "Yearly", price: "59.99", period: "year", trial_days: 7, recommended: true },
    { id: "life", name: "For life", price: "149.00", period: "once" },
    { id: "bad", name: "Broken", price: "nine dollars", period: "month" },
]

let paywall_sheet_demo_yen = [
    { id: "m", name: "Monthly", price: 980, period: "month" },
    { id: "y", name: "Yearly", price: 6800, period: "year", trial_days: 7, recommended: true },
]

let paywall_sheet_demo_odd = [
    { id: "q", name: "Quarterly", price: "4.99", period: "quarter", trial_days: "seven" },
]

// The same answer a moment later, as a `server fn` gives it: a Promise.
fn paywall_sheet_demo_late(answer) = js("Promise.resolve", js_new("Promise", (done) => { done(answer) }))

fn paywall_sheet_demo_buy(fail: bool, plan) {
    if fail { return { ok: false, message: "The store said no." } }
    if plan.id == "life" { return { ok: false, cancelled: true } }
    if plan.id == "week" { return null }
    true
}

component PaywallSheetDemoLive() {
    state said = "Nothing bought."
    state fail = false
    state slow = false
    state now = false
    // A named `let` here and an inline function below: callbacks of both kinds.
    let buying = (plan) => {
        let answer = paywall_sheet_demo_buy(fail, plan)
        slow ? paywall_sheet_demo_late(answer) : answer
    }
    <div.demo-stack>
        <div.demo-row id="paywall-sheet-demo-one">
            <PaywallSheet trigger="See plans" title="Keep every note" today="2026-11-01" terms="#terms" privacy="#privacy"
                benefits={["Unlimited notes", "Photos and voice memos", "Sync across your devices"]} plans={paywall_sheet_demo_plans}
                on_buy={buying}
                on_restore={() => {
                    let answer = fail ? { ok: false } : { ok: true, message: "Restored your Yearly plan." }
                    slow ? paywall_sheet_demo_late(answer) : answer
                }}
                on_bought={(plan) => { said = `Bought ${plan.id}.` }}
                on_close={() => { said = `${said} Closed.` }}/>
        </div>
        <div.demo-row id="paywall-sheet-demo-two">
            <PaywallSheet id="paywall-sheet-yen" trigger="In yen" title="Plans in yen" today="2026-12-28" currency="JPY" plans={paywall_sheet_demo_yen}/>
        </div>
        <div.demo-row id="paywall-sheet-demo-three">
            <PaywallSheet id="paywall-sheet-odd" trigger="Odd data" title="Odd data" currency="NOPE" today="not a date" plans={paywall_sheet_demo_odd}/>
            <Button size="lg" variant="outline" id="paywall-sheet-demo-now" on_click={() => { now = true }}>Open from state</Button>
        </div>
        {now && <PaywallSheet id="paywall-sheet-now" open={true} title="Opened from state" plans={paywall_sheet_demo_plans} on_close={() => { now = false }}/>}
        <label><input type="checkbox" id="paywall-sheet-demo-fail" bind:checked={fail}/> Let the store refuse</label>
        <label><input type="checkbox" id="paywall-sheet-demo-slow" bind:checked={slow}/> Answers come as Promises</label>
        <p.demo-note id="paywall-sheet-demo-said">{said}</p>
    </div>
}

view PaywallSheetDemo() = <PaywallSheetDemoLive/>

ui_gallery = ui_gallery | push({ slug: "paywall_sheet", name: "PaywallSheet", group: "Mobile",
    summary: "Plans with a recommended one, the price per month and per year worked out, restore, terms and honest trial wording.",
    tags: ["mobile", "interactive", "tablet", "paywall", "subscription", "pricing"],
    needs: ["price"],
    demo: PaywallSheetDemo })
