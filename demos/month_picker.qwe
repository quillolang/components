component MonthPickerDemoLive() {
    state month = null
    <div.demo-stack>
        <MonthPicker name="mp-demo-start" label="Start month" inline={true} earliest="2026-04" latest="2027-06" today="2026-10"
                     on_change={(m) => { month = m }}/>
        <p.demo-note>{month == null ? "No month picked." : `Starting ${month}.`}</p>
    </div>
}

view MonthPickerDemo() {
    <div.demo-stack>
        <div.demo-row>
            <MonthPicker name="mp-demo-period" label="Period" value="2026-03" today="2026-10" hint="The arrow keys move; PageUp/PageDown turn the year."/>
            <MonthPicker name="mp-demo-exp" label="Expiry" size="sm" today="2026-10" error="That card has expired."/>
        </div>
        <MonthPickerDemoLive/>
    </div>
}

ui_gallery = ui_gallery | push({ slug: "month_picker", name: "MonthPicker", group: "Forms",
    summary: "A month and year picked from a grid of twelve months under the year, from a button or in the page, sent as YYYY-MM.",
    tags: ["forms", "picker", "calendar", "keyboard", "interactive"], demo: MonthPickerDemo })
