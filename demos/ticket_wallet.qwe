let ticket_wallet_demo_tickets = [
    { id: "t2", title: "Train to Porto", kind: "barcode", starts: "2026-11-04T08:30:00+00:00", ends: "2026-11-04T11:15:00+00:00", seat: "Coach 3, 41", code: "CP4418221" },
    { id: "c1", title: "Dead Combo", venue: "Coliseu dos Recreios", starts: "2026-11-03T21:00:00+00:00", seat: "Row F, 12", holder: "Ada Lovelace", code: "TK-88213" },
    { id: "c2", title: "Dead Combo, plus one", venue: "Coliseu dos Recreios", starts: "2026-11-03T21:00:00+00:00", seat: "Row F, 13", code: "TK-88214" },
    { id: "m1", title: "Museum, all day", venue: "Gulbenkian", starts: "2026-11-07", code: "GB-1120" },
    { id: "n1", title: "Guest list", venue: "Lux", starts: "2026-11-07T23:00:00+00:00" },
    { id: "x1", title: "Ferry, no date yet", starts: "when the sea allows", code: "FR-7" },
    { id: "p1", title: "Football", venue: "Estadio da Luz", starts: "2026-11-02T20:00:00+00:00", code: "SL-9" },
    { id: "p2", title: "Morning tour", venue: "Alfama", starts: "2026-10-30T09:00:00+00:00", ends: "2026-10-30T12:00:00+00:00", code: "AL-3" },
]

component TicketWalletDemoLive() {
    state time = "2026-11-03T18:00:00+00:00"
    state told = 0
    state second = false
    <div.demo-stack>
        <TicketWallet label="Your tickets" tickets={ticket_wallet_demo_tickets} now={time} tick={1} keep_key="quillo-demo-wallet" on_keep={(_x) => { told += 1 }}/>
        <div.demo-row>
            <button.ticket-wallet-demo-next type="button" style="min-height: 44px" @click={() => { time = "2026-11-04T09:00:00+00:00" }}>The next morning</button>
            <button.ticket-wallet-demo-copy type="button" style="min-height: 44px" @click={() => { second = !second }}>A page with no tickets</button>
            <span.demo-note>on_keep: <span class="ticket-wallet-demo-told">{told}</span></span>
        </div>
        {second && <div.ticket-wallet-demo-second>
            <TicketWallet label="From the saved copy" tickets={[]} now={time} keep_key="quillo-demo-wallet"/>
        </div>}
    </div>
}

view TicketWalletDemo() = <TicketWalletDemoLive/>

ui_gallery = ui_gallery | push({ slug: "ticket_wallet", name: "TicketWallet", group: "Mobile",
    summary: "Tickets stacked by date with past ones kept apart, each code at full size and full brightness, and ready with no network.",
    tags: ["mobile", "interactive", "tablet", "ticket", "wallet", "qr"],
    needs: ["qr_code", "barcode"], demo: TicketWalletDemo })
