component GiftArticleDemoLive() {
    state made = 0
    <div.demo-stack>
        <GiftArticle id="gift-article-demo-last" href="https://ledger.example/2026/10/30/budget" title="The budget in four lines"
                     left={1} limit={10} renews="Dec 1" align="start"
                     on_gift={(url) => {
                         made += 1
                         `${url}?gift=DESK${made}`
                     }}/>
        <p.demo-note id="gift-article-demo-note">{made == 0 ? "on_gift not called yet." : `on_gift made ${made} link`}</p>
    </div>
}

view GiftArticleDemo() =
    <div class="demo-row" style="align-items: flex-start; gap: 48px; min-height: 300px">
        <GiftArticle id="gift-article-demo" href="https://ledger.example/2026/10/29/river" title="The river that ran out of water"
                     left={8} limit={10} renews="Dec 1"/>
        <GiftArticleDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "gift_article", name: "GiftArticle", group: "News",
    summary: "Gift this article: a panel with the gift articles left this month, a link anyone can read the story with, Copy and Email, and when more come once used up.",
    tags: ["news", "share", "subscription", "popover", "interactive"], demo: GiftArticleDemo })
