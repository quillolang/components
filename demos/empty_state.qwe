view EmptyStateDemo() =
    <div.demo-stack>
        <EmptyState icon="inbox" title="No messages yet"
                    actions={[<Button>Write a message</Button>, <Button variant="outline">Import contacts</Button>]}>
            When someone writes to you, it shows up here.
        </EmptyState>
        <div.demo-row>
            <EmptyState size="sm" icon="search" title="No results for “invoice 42”"
                        actions={<Button size="sm" variant="ghost">Clear the search</Button>}>
                Try fewer words.
            </EmptyState>
            <EmptyState size="sm" icon="folder" title="This folder is empty"/>
            <EmptyState size="sm" icon="chart" title="No data for March">Sales show up a day after they happen.</EmptyState>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "empty_state", name: "EmptyState", group: "Feedback",
    summary: "What a list or page shows when there is nothing in it yet, with an icon and what to do next.",
    demo: EmptyStateDemo })
