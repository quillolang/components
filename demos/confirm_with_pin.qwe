component ConfirmWithPinDemoLive() {
    state asking = false
    state request = "tx-1"
    state log = "Nothing yet"
    state seconds = 60
    state lost = false
    <div.demo-stack>
        <div.demo-row>
            <Button id="pinstep-open" size="lg" on_click={() => {
                seconds = 60
                asking = true
            }}>Send $4,000.00</Button>
            <Button id="pinstep-quick" size="lg" variant="outline" on_click={() => {
                seconds = 2
                request = "tx-quick"
                asking = true
            }}>Two seconds</Button>
            <Button id="pinstep-new" size="lg" variant="ghost" on_click={() => { request = `tx-${len(log)}` }}>New request</Button>
        </div>
        <label.demo-row style="min-height: 44px"><input id="pinstep-lost" type="checkbox" bind:checked={lost}/> The check fails to run</label>
        <p.demo-note id="pinstep-log">{log}</p>
        <ConfirmWithPin open={asking} title="Confirm this transfer" request={request} seconds={seconds} digits={4} warning="This cannot be undone."
                        summary={[{ label: "To", value: "Harbour Lettings" }, { label: "Amount", value: "$4,000.00" }]}
                        on_check={(pin) => {
                            if lost { return err("offline") }
                            // A stand-in: a real check is a server fn, so the PIN is never in the page.
                            js("Promise.resolve", pin == "2580")
                        }}
                        on_confirm={() => { log = "Confirmed" }}
                        on_close={() => {
                            asking = false
                            if log != "Confirmed" { log = "Cancelled" }
                        }}
                        on_timeout={() => { log = "Timed out" }}
                        on_locked={() => { log = "Locked" }}/>
    </div>
}

view ConfirmWithPinDemo() = <div.demo-stack><ConfirmWithPinDemoLive/></div>

ui_gallery = ui_gallery | push({ slug: "confirm_with_pin", name: "ConfirmWithPin", group: "Mobile",
    summary: "A step-up before something risky: what is about to happen, a PIN pad, tries counted, and a clock.",
    tags: ["mobile", "interactive", "banking", "pin", "security", "tablet"],
    needs: ["button"],
    demo: ConfirmWithPinDemo })
