component PostComposerDemoLive() {
    state posts = []
    <div.demo-stack>
        <PostComposer id="post-composer-demo-live" you="Ana Silva" limit={120}
                      on_post={(text, files) => { posts = posts | push({ text, files }) }}/>
        <p.demo-note>{len(posts) == 0 ? "Nothing posted yet."
            : join(posts | map((p) => `"${p.text}" with ${len(p.files)} ${len(p.files) == 1 ? "file" : "files"}`), " · ")}</p>
    </div>
}

view PostComposerDemo() =
    <div.demo-stack>
        <PostComposerDemoLive/>
        <p.demo-note>Ctrl+Enter posts. Below, one that sends a form (text and files):</p>
        <PostComposer id="post-composer-demo-form" you="Ben Okafor" avatar="https://i.pravatar.cc/80?img=15" method="get"
                      action="#post_composer" placeholder="Share an update with the team…" post_label="Share" attach={false}>
            <input type="hidden" name="channel" value="general"/>
        </PostComposer>
    </div>

ui_gallery = ui_gallery | push({ slug: "post_composer", name: "PostComposer", group: "Social",
    summary: "Write a post with a character ring and count, attach files, and post with a button or Ctrl+Enter; a plain form in a page.",
    tags: ["social", "forms", "input", "upload", "interactive"], demo: PostComposerDemo })
