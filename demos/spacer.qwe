view SpacerDemoBlock(label: str) =
    <div style="padding: 8px 12px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius-sm); background: var(--ui-subtle); font-size: 13px">{label}</div>

view SpacerDemo() =
    <div.demo-stack>
        <div id="spacer-demo-column">
            <SpacerDemoBlock label="Above"/>
            <Spacer/>
            <SpacerDemoBlock label="16px below the first (the default)"/>
            <Spacer size="lg"/>
            <SpacerDemoBlock label="32px below (lg)"/>
            <Spacer size={50}/>
            <SpacerDemoBlock label="50px below (a number)"/>
        </div>
        <div id="spacer-demo-row" style="display: flex; align-items: center">
            <SpacerDemoBlock label="Left"/>
            <Spacer horizontal={true} size="sm"/>
            <SpacerDemoBlock label="8px to the right"/>
            <Spacer grow={true}/>
            <SpacerDemoBlock label="Pushed to the end"/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "spacer", name: "Spacer", group: "Layout",
    summary: "Empty room between things, down a column or along a row, in the kit's sizes or pixels, or growing to push things apart.",
    tags: ["layout", "utility", "no-js"], demo: SpacerDemo })
