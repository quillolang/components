component RecurrencePickerDemoLive() {
    state rule = { freq: "monthly", interval: 1, by: "day", ends: "after", count: 12 }
    <div.demo-stack>
        <RecurrencePicker id="recurrence-picker-demo-live" label="Rent reminder" start="2026-11-10" value={rule}
                          on_change={(r) => { rule = r }}/>
        <p.demo-note>on_change: {rule.freq}, every {rule.interval}, by {rule.by}, ends {rule.ends}.</p>
    </div>
}

view RecurrencePickerDemo() =
    <div.demo-stack>
        <RecurrencePicker id="recurrence-picker-demo-plain" name="repeat" start="2026-11-02"
                          value={{ freq: "weekly", interval: 1, days: ["MO", "WE"] }}
                          hint="The form gets the rule as JSON and as an RRULE."/>
        <RecurrencePickerDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "recurrence_picker", name: "RecurrencePicker", group: "Forms",
    summary: "How something repeats, daily, weekly on chosen days, monthly or yearly, and when it ends, said in words and sent as a rule and an RRULE.",
    tags: ["forms", "picker", "calendar", "schedule", "interactive"], demo: RecurrencePickerDemo })
