component FxQuoteTicketDemoLive() {
    state ticks = 0
    state note = "No deal yet."
    <div.demo-stack>
        <FxQuoteTicket name="desk" pair="EUR/USD" bid={1.08421m} ask={1.08429m} amount={250000} seconds={6}
                       on_requote={(side) => {
                           ticks += 1
                           let move = dec((ticks % 3) - 1) * 0.00007m
                           { bid: 1.08421m + move, ask: 1.08429m + move }
                       }}
                       on_confirm={(d) => { note = `${d.side} ${d.amount} ${d.base} at ${d.rate} = ${round(d.counter, 2)} ${d.quote}` }}/>
        <p.demo-note id="fx-quote-ticket-demo-note">{note}</p>
    </div>
}

view FxQuoteTicketDemo() =
    <div class="demo-row" style="align-items: start">
        <FxQuoteTicketDemoLive/>
        <FxQuoteTicket pair="USD/JPY" bid={156.238m} ask={156.251m} side="sell" amount={100000} seconds={5} action="#deals"/>
    </div>

ui_gallery = ui_gallery | push({ slug: "fx_quote_ticket", name: "FxQuoteTicket", group: "Finance",
    summary: "An order ticket for a currency deal: buy or sell, the amount, the quoted rate counting down to its expiry, the other currency's amount and Confirm.",
    tags: ["finance", "forex", "forms", "trading", "interactive"], demo: FxQuoteTicketDemo })
