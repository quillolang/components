let file_icon_demo_files = ["Q3 report.xlsx", "Contract (signed).pdf", "team-photo.JPG", "pitch.key", "notes.md",
                            "main.qwe", "backup.tar.gz", "voice memo.m4a", "intro.mp4", "README", "proposal.docx"]

view FileIconDemo() =
    <div.demo-stack>
        <div.demo-row id="file-icon-demo-sizes">
            <FileIcon ext="pdf" size="sm"/>
            <FileIcon ext="pdf"/>
            <FileIcon ext="pdf" size="lg"/>
            <FileIcon ext="pdf" size="xl"/>
        </div>
        <ul id="file-icon-demo-list" style="display: grid; gap: 6px; margin: 0; padding: 0; list-style: none">
            {for f in file_icon_demo_files => <li style="display: flex; align-items: center; gap: 10px">
                <FileIcon name={f} size="sm" label=""/>
                <span>{f}</span>
                <span style="color: var(--ui-muted); font-size: 13px">{file_icon_kind(file_icon_ext(f))}</span>
            </li>}
        </ul>
    </div>

ui_gallery = ui_gallery | push({ slug: "file_icon", name: "FileIcon", group: "Media",
    summary: "A file's icon by its extension, written on it and coloured by its kind: document, sheet, PDF, image, code and more.",
    tags: ["file", "icon", "media", "no-js"], demo: FileIconDemo })
