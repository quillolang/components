component SplitButtonDemoLive() {
    state did = "nothing yet"
    <div.demo-row>
        <SplitButton id="split-demo-merge" label="Merge pull request" variant="outline" tone="neutral"
                     on_click={() => { did = "merged" }} on_select={(it) => { did = it.label }}
                     items={[{ label: "Squash and merge", value: "squash" }, { label: "Rebase and merge", value: "rebase" },
                             { label: "Merge when checks pass", disabled: true }]}/>
        <span.demo-note>Did: {did}</span>
    </div>
}

view SplitButtonDemo() =
    <div.demo-stack>
        <form.demo-row method="get" action="#split_button">
            <SplitButton id="split-demo-save" label="Save" type="submit" name="action" value="save"
                         items={[{ label: "Save as draft", value: "draft" }, { label: "Save and publish", value: "publish" },
                                 { divider: true }, { label: "Version history", href: "#split_button" }]}/>
            <span.demo-note>In a form: each choice sends action=…</span>
        </form>
        <div.demo-row>
            <SplitButton id="split-demo-export" label="Export" variant="soft" size="sm"
                         items={[{ label: "As CSV" }, { label: "As JSON" }]}/>
            <SplitButton id="split-demo-delete" label="Delete" tone="danger"
                         items={[{ label: "Delete and block sender", tone: "danger" }, { label: "Archive instead" }]}/>
            <SplitButton id="split-demo-off" label="Deploy" variant="outline" disabled={true} items={[{ label: "Deploy to staging" }]}/>
        </div>
        <SplitButtonDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "split_button", name: "SplitButton", group: "Actions",
    summary: "The usual action as a button, joined to a menu of the other ways to do it, with the keyboard.",
    demo: SplitButtonDemo })
