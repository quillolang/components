view NotificationDotDemo() =
    <div.demo-stack>
        <div.demo-row style="gap: 28px">
            <NotificationDot count={3} label="unread messages"><IconButton icon="menu" label="Inbox" variant="outline"/></NotificationDot>
            <NotificationDot count={1284} label="notifications"><IconButton icon="settings" label="Settings" variant="outline"/></NotificationDot>
            <NotificationDot tone="success" position="bottom-right" label="Online" pulse={true}><Avatar name="Ada Lovelace"/></NotificationDot>
            <NotificationDot tone="accent" size="sm"><Button variant="outline" size="sm">Updates</Button></NotificationDot>
            <NotificationDot show={false} count={0}><IconButton icon="search" label="Search" variant="outline"/></NotificationDot>
        </div>
        <div.demo-row style="gap: 28px">
            <NotificationDot count={7} tone="info" position="top-left" size="lg"><Button variant="soft">Reports</Button></NotificationDot>
            <NotificationDot tone="warning" position="bottom-left" outline={false}><Button variant="outline">Review</Button></NotificationDot>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "notification_dot", name: "NotificationDot", group: "Feedback",
    summary: "A small dot or a count on the corner of anything, in tones and four positions, with a label for screen readers.",
    tags: ["feedback", "notification", "status", "no-js"],
    demo: NotificationDotDemo })
