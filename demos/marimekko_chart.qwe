view MarimekkoChartDemo() =
    <div.demo-stack>
        <MarimekkoChart label="Revenue by region and product" show_label={true} prefix="$"
                        labels={["Europe", "Americas", "Asia", "Africa"]}
                        series={[{ name: "Hardware", values: [42000, 61000, 18000, 3500] },
                                 { name: "Software", values: [30000, 52000, 9000, 1200] },
                                 { name: "Services", values: [18000, 21000, 14500, 2100] }]}/>
        <MarimekkoChart label="Phones sold by brand and price band" show_label={true} suffix="k" height={200} value_labels={false}
                        labels={["Budget", "Mid-range", "Premium"]}
                        series={[{ name: "Brand A", values: [120, 210, 340] }, { name: "Brand B", values: [310, 180, 90] },
                                 { name: "Brand C", values: [260, 150, 20] }, { name: "Others", values: [400, 95, null] }]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "marimekko_chart", name: "MarimekkoChart", group: "Charts",
    summary: "100% stacked bars as wide as their totals, so every part's area is its value, with its shares on hover.",
    tags: ["chart", "data", "no-js"],
    demo: MarimekkoChartDemo })
