let inspector_panel_demo_css = css`
.demo-inspect-stage { position: relative; min-height: 420px; height: 100%; box-sizing: border-box; background: var(--ui-subtle); }
.demo-inspect-tools { position: absolute; left: 10px; top: 10px; z-index: 1; display: flex; flex-wrap: wrap; gap: 8px; }
.demo-inspect-shape { position: absolute; display: grid; place-items: center; box-sizing: border-box; min-width: 44px; min-height: 44px; padding: 0; border: 2px solid transparent; color: #fff; font: 600 13px/1.2 var(--ui-font); cursor: pointer; }
.demo-inspect-shape[aria-pressed="true"] { border-color: var(--ui-fg); box-shadow: var(--ui-focus); }
.demo-inspect-out { margin: 0; }
`

let inspector_panel_demo_shapes = [
    { id: "a", name: "Header", kind: "rect", x: 40, y: 80, width: 180, height: 80, corners: 8, fill: "#5b4bdb", locked: false, layer: "Front" },
    { id: "b", name: "Badge", kind: "circle", x: 260, y: 120, width: 90, height: 90, fill: "#18794e", locked: true, layer: "Middle" },
    { id: "c", name: "Photo", kind: "rect", x: 80, y: 200, width: 140, height: 120, corners: 0, fill: "#a35200", locked: false, layer: "Back" },
]

let inspector_panel_demo_sections = [
    { title: "About", fields: [
        { key: "name", label: "Name", type: "text" },
        { key: "kind", label: "Kind", type: "readonly" },
    ] },
    { title: "Place", fields: [
        { key: "x", label: "X", type: "number", min: 0, max: 800, step: 10, unit: "px" },
        { key: "y", label: "Y", type: "number", min: 0, max: 800, step: 10, unit: "px" },
        { key: "width", label: "Width", type: "number", min: 44, max: 400, step: 10, unit: "px" },
    ] },
    { title: "Look", fields: [
        { key: "corners", label: "Corners", type: "number", min: 0, max: 40, step: 2, unit: "px", kinds: ["rect"] },
        { key: "fill", label: "Fill", type: "color" },
        { key: "layer", label: "Layer", type: "select", options: ["Back", "Middle", "Front"] },
        { key: "locked", label: "Locked", type: "toggle" },
    ] },
    { title: "Rounding", kinds: ["circle"], closed: true, fields: [
        { key: "height", label: "Height", type: "number", min: 44, max: 400, unit: "px" },
    ] },
]

component InspectorPanelDemoLive() {
    style global inspector_panel_demo_css
    state shapes = inspector_panel_demo_shapes
    state chosen = ""
    state said = "No change yet"
    state tall = "100%"
    let picked = find(shapes, (s) => s.id == chosen)
    let change = (k, v) => {
        shapes = shapes | map((s) => s.id == chosen ? set(s, k, v) : s)
        said = `${k} is ${v}`
    }
    <div.demo-stack>
        <div.demo-tablet>
            <InspectorPanel title="Shape" selection={picked} sections={inspector_panel_demo_sections} on_change={change} id="inspect-demo" height={tall}>
                <div.demo-inspect-stage>
                    <div.demo-inspect-tools>
                        <Button id="inspect-demo-nudge" size="lg" variant="outline" on_click={() => {
                            shapes = shapes | map((s) => s.id == chosen ? set(s, "x", s.x + 5) : s)
                        }}>Nudge right</Button>
                        <Button id="inspect-demo-none" size="lg" variant="outline" on_click={() => { chosen = "" }}>Select nothing</Button>
                    </div>
                    {for s in shapes =>
                        <button.demo-inspect-shape key={s.id} type="button" id={`inspect-demo-${s.id}`} aria-pressed={s.id == chosen ? "true" : "false"}
                                style={`left: ${s.x}px; top: ${s.y}px; width: ${s.width}px; height: ${s.height}px; background: ${s.fill}; border-radius: ${s.kind == "circle" ? "50%" : `${get(s, "corners", 0)}px`}`}
                                @click={() => { chosen = s.id }}>{s.name}</button>}
                </div>
            </InspectorPanel>
        </div>
        <div.demo-row>
            <Button id="inspect-demo-tall" size="lg" variant="outline" on_click={() => { tall = tall == "100%" ? "96%" : "100%" }}>Change the height</Button>
            <p.demo-note.demo-inspect-out id="inspect-demo-said">{said}</p>
        </div>
    </div>
}

view InspectorPanelDemo() = <InspectorPanelDemoLive/>

ui_gallery = ui_gallery | push({ slug: "inspector_panel", name: "InspectorPanel", group: "Mobile",
    summary: "A right-hand panel of properties for the selected thing, in sections, live both ways, and a sheet on a phone.",
    tags: ["mobile", "tablet", "interactive", "panel", "properties", "sheet"],
    demo: InspectorPanelDemo })
