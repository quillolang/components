let hover_cursor_row_demo_rows = [
    { id: 1, title: "Quarterly report", detail: "Edited this morning", side: "4.2 MB" }, { id: 2, title: "Site photos", detail: "38 items", side: "210 MB" },
    { id: 3, title: "Invoice 2291", detail: "PDF, paid", side: "96 KB" }, { id: 4, title: "Meeting notes", detail: "Shared with 3 people", side: "12 KB" },
    { id: 5, title: "Budget 2027", detail: "Spreadsheet", side: "1.1 MB" }, { id: 6, title: "Contract draft", detail: "Waiting for signature", side: "640 KB" },
]

let hover_cursor_row_demo_actions = [{ id: "open", label: "Open" }, { id: "rename", label: "Rename" }, { id: "share", label: "Share" }, { id: "delete", label: "Delete", tone: "danger" }]

component HoverCursorRowDemoLive() {
    state note = "Nothing chosen yet."
    <div.demo-stack>
        <HoverCursorRow rows={hover_cursor_row_demo_rows} actions={hover_cursor_row_demo_actions} label="Files"
                        on_open={(id) => { note = `Opened ${id}.` }} on_action={(id, act) => { note = `${act} on ${id}.` }}/>
        <p.demo-note id="hover-cursor-row-note">{note}</p>
        <div id="hover-cursor-row-bad" hidden="true"><HoverCursorRow rows={[null, { id: 1 }, { id: 2, title: "Two" }, { id: 2, title: "Again" }, { title: "No id" }]}/><HoverCursorRow rows="none"/></div>
    </div>
}

view HoverCursorRowDemo() = <HoverCursorRowDemoLive/>

ui_gallery = ui_gallery | push({ slug: "hover_cursor_row", name: "HoverCursorRow", group: "Mobile",
    summary: "Rows with the iPad pointer's lift on a trackpad or mouse, none on touch, and right-click menus.",
    tags: ["mobile", "tablet", "interactive", "pointer", "list", "context-menu"],
    demo: HoverCursorRowDemo })
