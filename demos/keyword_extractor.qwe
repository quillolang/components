let keyword_extractor_demo_text = "Cold brew coffee is coffee made with cold water. Cold brew takes twelve hours, so cold brew tastes smooth. Good coffee beans matter, and fresh beans matter more. Grind the beans coarsely, then wait. Don't rush it: the barista's patience is the recipe."

component KeywordExtractorDemoLive() {
    state tags = null
    <div.demo-stack>
        <KeywordExtractor id="keyword-extractor-demo-live" label="Your post" name="post" tags_name="post_tags" rows={3} top={3} value="Café au lait: le café du matin, le lait de l'après-midi." on_change={(r) => { tags = r.tags }}/>
        <p.demo-note>{tags == null ? "Change the post or untick a tag to see on_change." : `on_change: ${tags}`}</p>
    </div>
}

view KeywordExtractorDemo() =
    <div.demo-stack>
        <KeywordExtractor id="keyword-extractor-demo" value={keyword_extractor_demo_text} name="body" top={6}/>
        <KeywordExtractorDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "keyword_extractor", name: "KeywordExtractor", group: "Blogging",
    summary: "Finds a text's top words and two-word phrases without each language's common words, warns of stuffing, and copies them as tags.",
    tags: ["smart", "interactive", "keywords", "seo", "tags", "text"], needs: ["readability_meter", "copy_button"], demo: KeywordExtractorDemo })
