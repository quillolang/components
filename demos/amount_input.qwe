component AmountInputDemoLive() {
    state got = null
    <div.demo-stack>
        <AmountInput id="amount-demo-live" name="budget" label="Budget" currency="EUR" locale="de-DE" negative={true}
                     on_change={(a) => { got = a }}/>
        <p.demo-note>{got == null || got.amount == null ? "Type an amount to see on_change." : `on_change: ${got.amount} ${got.currency}`}</p>
    </div>
}

view AmountInputDemo() =
    <div class="demo-stack demo-narrow">
        <form>
            <AmountInput id="amount-demo" name="price" label="Price" value="1.5k" hint="Write it as you would: 1.5k, $12, EUR 40, 1.234,50."/>
        </form>
        <AmountInputDemoLive/>
        <AmountInput id="amount-demo-fixed" name="fare" label="Fare in Canadian dollars" currency="CAD" fixed={true}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "amount_input", name: "AmountInput", group: "Forms",
    summary: "Reads 1.5k, 2m, 1,234.50, 1.234,50, $12 and EUR 40, decides which mark groups, shows the normalised amount, flags what could go two ways, and sends a real decimal.",
    tags: ["smart", "interactive", "money", "currency", "parser", "forms"], demo: AmountInputDemo })
