// A floor plan drawn in SVG, so the demo needs no image files.
let image_hotspots_demo_plan = `data:image/svg+xml,${url_encode(
    `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="800" height="500">`
    + `<rect width="800" height="500" fill="#f4efe6"/>`
    + `<rect x="40" y="40" width="330" height="260" fill="#fff" stroke="#8a7f70" stroke-width="4"/>`
    + `<rect x="370" y="40" width="390" height="180" fill="#fff" stroke="#8a7f70" stroke-width="4"/>`
    + `<rect x="370" y="220" width="390" height="240" fill="#fff" stroke="#8a7f70" stroke-width="4"/>`
    + `<rect x="40" y="300" width="330" height="160" fill="#fff" stroke="#8a7f70" stroke-width="4"/>`
    + `<rect x="60" y="60" width="120" height="80" rx="6" fill="#d6e6f5"/><rect x="400" y="250" width="200" height="110" rx="8" fill="#e8dcc8"/></svg>`)}`

let image_hotspots_demo_points = [
    { x: 14, y: 20, title: "Bed", text: "A 160 cm bed by the window." },
    { x: 60, y: 25, title: "Kitchen", text: "Induction hob, oven, dishwasher." },
    { x: 62, y: 62, title: "Living room", text: "A sofa that sleeps two, and the TV." },
    { x: 25, y: 76, title: "Bathroom", text: "Walk-in shower; towels provided." },
    { x: 90, y: 90, title: "Balcony" },
]

view ImageHotspotsDemo() =
    <div.demo-stack>
        <ImageHotspots id="image-hotspots-demo" src={image_hotspots_demo_plan} alt="The flat's floor plan" points={image_hotspots_demo_points}
                       label="Rooms"/>
        <p.demo-note>Rest the pointer on a number, or Tab to it, to read the note.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "image_hotspots", name: "ImageHotspots", group: "Media",
    summary: "A picture with numbered points that show a note on hover or focus, with no script: a plan, a product, a photo.",
    tags: ["media", "image", "popover", "accessibility", "no-js"], demo: ImageHotspotsDemo })
