let table_floor_plan_demo_tables = [
    { id: 1, label: "1", x: 40, y: 40, seats: 2, shape: "round", status: "seated", guests: 2 }, { id: 2, label: "2", x: 160, y: 40, seats: 2, shape: "round" },
    { id: 3, label: "3", x: 280, y: 40, seats: 4, status: "ordered", guests: 3, w: 110 }, { id: 4, label: "4", x: 430, y: 40, seats: 4, status: "bill", guests: 4, w: 110 },
    { id: 5, label: "5", x: 40, y: 190, seats: 4, w: 110, status: "served", guests: 2 }, { id: 6, label: "6", x: 200, y: 190, seats: 6, w: 150, status: "dirty" },
    { id: 7, label: "7", x: 400, y: 190, seats: 6, w: 150 }, { id: 8, label: "8", x: 40, y: 340, seats: 2, shape: "round" },
    { id: 9, label: "9", x: 160, y: 340, seats: 2, shape: "round", status: "seated", guests: 1 }, { id: 10, label: "10", x: 280, y: 340, seats: 8, w: 200, status: "seated", guests: 7 },
    { id: 11, label: "P1", x: 40, y: 540, seats: 4, shape: "round" }, { id: 12, label: "P2", x: 200, y: 540, seats: 4, shape: "round" },
]

let table_floor_plan_demo_zones = [{ label: "Bar", x: 720, y: 40, w: 240, h: 300 }, { label: "Kitchen", x: 720, y: 380, w: 240, h: 280 }, { label: "Patio", x: 20, y: 500, w: 660, h: 180 }]

component TableFloorPlanDemoLive() {
    state note = "No table opened."
    state layout = "Not saved."
    <div.demo-stack>
        <div.demo-tablet>
            <TableFloorPlan tables={table_floor_plan_demo_tables} zones={table_floor_plan_demo_zones} label="Dining room"
                            on_open={(id) => { note = `Check of ${id} opened.` }}
                            on_status={(id, s) => { note = `${id} is ${s}.` }}
                            on_layout={(t) => { layout = join(t | map((x) => `${x.id}:${x.x},${x.y}`), " ") }}/>
        </div>
        <p.demo-note id="table-floor-plan-note">{note}</p>
        <p.demo-note id="table-floor-plan-layout">{layout}</p>
        <div id="table-floor-plan-bad" hidden="true"><TableFloorPlan zones="none" tables={[null, { id: 1 }, { id: 2, x: "a", y: 3 }, { id: 3, x: 950, y: 690, status: "ghost" }, { id: 3, x: 1, y: 1 }, { x: 5, y: 5 }]}/><TableFloorPlan tables="none" statuses={[{ id: "open", label: "Open" }]}/></div>
    </div>
}

view TableFloorPlanDemo() = <TableFloorPlanDemoLive/>

ui_gallery = ui_gallery | push({ slug: "table_floor_plan", name: "TableFloorPlan", group: "Mobile",
    summary: "Restaurant tables on a floor plan with status, moved in an edit mode, tapped to open a check, scaled to fit either way up.",
    tags: ["mobile", "tablet", "interactive", "restaurant", "floor-plan", "gesture"],
    demo: TableFloorPlanDemo })
