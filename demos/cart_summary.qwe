component CartSummaryDemoLive() {
    state clicked = 0
    <div.demo-stack>
        <CartSummary subtotal={213.5} shipping={9.9} discount={21.35} discount_label="SAVE10" count={3}
                     note="Taxes are included." on_checkout={() => { clicked += 1 }}/>
        <p.demo-note>{clicked == 0 ? "Checkout not clicked." : `on_checkout called ${clicked} ${clicked == 1 ? "time" : "times"}.`}</p>
    </div>
}

view CartSummaryDemo() =
    <div.demo-row style="align-items: flex-start; gap: 24px">
        <div style="width: 300px">
            <CartSummary subtotal={213.5} shipping={0} tax={42.7} checkout_href="#cart_summary" continue_href="#product_grid"/>
        </div>
        <div style="width: 300px"><CartSummaryDemoLive/></div>
        <div style="width: 300px">
            <CartSummary subtotal={1250} shipping="Calculated at checkout" currency="JPY" locale="ja-JP" title="Your order"
                         lines={[{ label: "Gift wrap", amount: 300 }]} action="/checkout" disabled={true}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "cart_summary", name: "CartSummary", group: "Commerce",
    summary: "Subtotal, shipping, tax, a discount and the total added up, with a Checkout button as a link, a form or a callback.",
    tags: ["commerce", "cart", "checkout", "price", "no-js"],
    needs: ["price"], demo: CartSummaryDemo })
