let variant_picker_demo_groups = [
    { name: "colour", label: "Colour", kind: "swatches", values: [
        { value: "black", label: "Black", color: "#222" }, { value: "sand", label: "Sand", color: "#d8c7a0" },
        { value: "forest", label: "Forest", color: "#2f6b3a" }, { value: "red", label: "Red", color: "#c62a2f", sold_out: true }]},
    { name: "size", label: "Size", values: ["XS", "S", "M", { value: "L", hint: "Fits large" }, { value: "XL", sold_out: true }]},
]

component VariantPickerDemoLive() {
    state picked = { colour: "black", size: "M" }
    <div.demo-stack>
        <VariantPicker groups={variant_picker_demo_groups} chosen={{ colour: "black", size: "M" }} on_change={(c) => { picked = c }}/>
        <p.demo-note>Chosen: {join(keys(picked) | map((k) => `${k}=${picked[k]}`), ", ")} (on_change gives the whole map).</p>
    </div>
}

view VariantPickerDemo() =
    <div.demo-stack style="gap: 28px">
        <VariantPickerDemoLive/>
        <VariantPicker size="sm" required={true} groups={[
            { name: "width", label: "Width", values: ["Narrow", "Regular", "Wide"] },
            { name: "material", label: "Material", kind: "swatches", values: [{ value: "oak", label: "Oak", color: "#c9a26b" }, { value: "walnut", label: "Walnut", color: "#5a3a22" }] }]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "variant_picker", name: "VariantPicker", group: "Commerce",
    summary: "Sizes as buttons and colours as swatches, sold-out ones crossed out: radio groups for the keyboard, hidden inputs for forms.",
    tags: ["commerce", "forms", "select", "picker", "interactive"], demo: VariantPickerDemo })
