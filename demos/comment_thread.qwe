let comment_thread_demo_start = [
    { id: 1, name: "Ben Okafor", time: "2 h", datetime: "2026-10-28T09:12:00Z", likes: 3,
      text: "Does this work with SQLite as well as Postgres?",
      replies: [
          { id: 2, name: "Lee Chen", role: "Author", time: "1 h", text: "It does: the same migrations run on both.", likes: 1,
            replies: [{ id: 3, name: "Ben Okafor", time: "50 min", text: "Perfect, thanks." }] },
          { id: 4, name: "Mia Rossi", avatar: "https://i.pravatar.cc/80?img=32", time: "40 min", text: "Same here, works on SQLite." },
      ] },
    { id: 5, name: "Sam Patel", time: "30 min", text: "Nice release! The new tables are much faster.", likes: 7 },
]

component CommentThreadDemoLive() {
    state log = []
    <div.demo-stack>
        <CommentThread id="comment-thread-demo" you="Ana Silva" comments={comment_thread_demo_start} folded={[2]}
                       on_reply={(to, text) => { log = log | push(`reply to ${to}: ${text}`) }}
                       on_like={(cid, on) => { log = log | push(`${on ? "liked" : "unliked"} ${cid}`) }}/>
        <p.demo-note>{len(log) == 0 ? "Nothing yet." : join(log, " · ")}</p>
    </div>
}

view CommentThreadDemo() =
    <div.demo-stack>
        <CommentThreadDemoLive/>
        <CommentThread id="comment-thread-demo-empty" comments={[]} empty="Be the first to comment."/>
    </div>

ui_gallery = ui_gallery | push({ slug: "comment_thread", name: "CommentThread", group: "Social",
    summary: "Nested comments with Like and Reply, a reply box that opens under the comment answered, and branches that fold.",
    tags: ["social", "comment", "list", "interactive"],
    needs: ["comment", "reply_box"], demo: CommentThreadDemo })
