component WeekPickerDemoLive() {
    state week = null
    <div.demo-stack>
        <WeekPicker name="wp-demo-sprint" label="Sprint starts" inline={true} today="2026-10-28"
                    on_change={(w) => { week = w }}/>
        <p.demo-note>{week == null ? "No week picked." : `${week.week}: ${week.start} to ${week.end}.`}</p>
    </div>
}

view WeekPickerDemo() {
    <div.demo-stack>
        <div.demo-row>
            <WeekPicker name="wp-demo-week" label="Week" value="2026-W45" today="2026-10-28" hint="ISO weeks start on Monday."/>
            <WeekPicker name="wp-demo-sm" label="Week" size="sm" today="2026-10-28" error="Choose a week."/>
        </div>
        <WeekPickerDemoLive/>
    </div>
}

ui_gallery = ui_gallery | push({ slug: "week_picker", name: "WeekPicker", group: "Forms",
    summary: "An ISO week picked from a month shown as numbered weeks, by click or the arrow keys, sent as 2026-W45.",
    tags: ["forms", "picker", "calendar", "keyboard", "interactive"], demo: WeekPickerDemo })
