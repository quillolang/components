component LikertScaleDemoLive() {
    state answer = null
    <div.demo-stack>
        <LikertScale name="recommend" label="I would recommend Quillo to a colleague" points={7} value={answer}
                     field="likert-scale-demo-live" on_change={(v) => { answer = v }}/>
        <p.demo-note>{answer == null ? "No answer yet." : `You chose ${answer} of 7.`}</p>
    </div>
}

view LikertScaleDemo() =
    <div.demo-stack>
        <LikertScale name="docs" label="The docs were easy to follow" value={4} field="likert-scale-demo-five"
                     hint="1 is strongly disagree, 5 is strongly agree." required={true}/>
        <LikertScaleDemoLive/>
        <LikertScale name="often" label="How often do you deploy?" field="likert-scale-demo-words"
                     points={["Never", "Monthly", "Weekly", "Daily", "Hourly"]} low={null} high={null}
                     error="Pick how often."/>
    </div>

ui_gallery = ui_gallery | push({ slug: "likert_scale", name: "LikertScale", group: "Forms",
    summary: "A statement with a row of points from Strongly disagree to Strongly agree: real radios in a fieldset, posted with a form.",
    tags: ["forms", "input", "no-js"], demo: LikertScaleDemo })
