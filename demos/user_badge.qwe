view UserBadgeDemo() =
    <div.demo-stack>
        <div.demo-row>
            <UserBadge id="user-badge-demo-ana" name="Ana Silva" src="https://i.pravatar.cc/80?img=47" verified={true}/>
            <UserBadge id="user-badge-demo-ben" name="Ben Okafor" role="Admin" href="#user_badge"/>
            <UserBadge name="Lee Chen" tone="accent" role="Author"/>
            <UserBadge name="Mia Rossi" status="online"/>
        </div>
        <div.demo-row>
            <UserBadge id="user-badge-demo-sm" name="Sam Patel" size="sm" role="Reviewer"/>
            <UserBadge name="Plato" size="sm" tone="accent"/>
            <p.demo-note style="margin: 0">Assigned to <UserBadge id="user-badge-demo-plain" name="Ana Silva" size="sm" tone="plain"/> yesterday.</p>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "user_badge", name: "UserBadge", group: "Social",
    summary: "A small chip with a person's avatar and name, plus a role label or a verified tick; a link when given an href.",
    tags: ["social", "user", "profile", "no-js"], demo: UserBadgeDemo })
