view DividendStatementDemo() =
    <div.demo-stack>
        <DividendStatement id="dividend-statement-demo" year={2025} member="Lourdes Villanueva" number="M-004217"
                           coop="Bayanihan Multi-Purpose Cooperative" currency="PHP"
                           share_base={18437.50} dividend_rate={6.5} patronage_base="24512.80" patronage_rate={12}
                           tax_rate={10} paid="2026-03-31" credited="Savings account •••• 4821"
                           note="Approved by the General Assembly of March 14, 2026."/>
        <DividendStatement id="dividend-statement-demo-cu" year={2025} member="Harriet Okafor" number="CU-88213"
                           coop="Lakeshore Teachers Credit Union" share_base={2350} dividend_rate={3.25}
                           share_label="Average share balance" credited="Share savings •••• 0377"/>
    </div>

ui_gallery = ui_gallery | push({ slug: "dividend_statement", name: "DividendStatement", group: "Finance",
    summary: "A member's dividend on share capital and patronage refund for a year: bases, rates and amounts, the withholding tax and the net.",
    tags: ["finance", "coop", "document", "print", "no-js"], demo: DividendStatementDemo })
