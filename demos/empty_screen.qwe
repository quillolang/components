let empty_screen_demo_css = css`
.empty-screen-demo-keys { display: flex; flex-wrap: wrap; gap: 8px; }
.empty-screen-demo-q { box-sizing: border-box; width: 100%; min-height: 46px; padding: 0 12px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius-sm); background: var(--ui-surface); color: var(--ui-fg); font: 16px var(--ui-font); }
`

component EmptyScreenDemoLive() {
    style global empty_screen_demo_css
    state kind = "none"
    state q = "red bicycle lamp"
    state filters = [{ id: "open", label: "Open only" }, { id: "week", label: "This week" }]
    state steps = [{ label: "Add a customer", done: true }, { label: "Set your prices" }, { label: "Send your first invoice" }]
    state acted = 0
    state second = 0
    <div.demo-stack>
        <div.empty-screen-demo-keys>
            {for k in ["first", "none", "done"] => <Button key={k} size="lg" id={`empty-screen-demo-k${k}`} variant={kind == k ? "solid" : "outline"} on_click={() => { kind = k }}>{k}</Button>}
        </div>
        <label class="ui-sr" for="empty-screen-demo-q">Search</label>
        <input.empty-screen-demo-q id="empty-screen-demo-q" value={q} @input={(e) => { q = e.value }}/>
        <p.demo-note id="empty-screen-demo-out">{acted} actions, {second} others.</p>
        <div.demo-phone>
            <EmptyScreen id="empty-screen-demo" kind={kind} noun="invoices" query={q} filters={filters} steps={steps} count={12}
                         next="The next ones come on Monday."
                         action={kind == "first" ? "Create an invoice" : (kind == "done" ? "See what is finished" : null)}
                         secondary={kind == "first" ? "Import from a file" : null}
                         on_action={() => { acted += 1; if kind == "none" { q = ""; filters = [] } }}
                         on_secondary={() => { second += 1 }}
                         on_clear={(id) => { filters = filters | filter((f) => f.id != id) }}
                         on_step={(i) => { steps = enumerate(steps) | map((p) => p[0] == i ? { label: p[1].label, done: true } : p[1]) }}/>
        </div>
    </div>
}

view EmptyScreenDemo() =
    <div.demo-stack>
        <EmptyScreenDemoLive/>
        <div.demo-tablet style="height: 360px">
            <EmptyScreen id="empty-screen-demo-plain" kind="first" noun="reports" action="Write a report" href="/reports/new"
                         steps={[{ label: "Connect a source", done: true }, { label: "Pick a template", href: "/templates" }]}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "empty_screen", name: "EmptyScreen", group: "Mobile",
    summary: "Empty states for first use, none-found and all-done, each with what to do next.",
    tags: ["mobile", "no-js", "tablet", "empty", "onboarding", "search"],
    needs: ["button"],
    demo: EmptyScreenDemo })
