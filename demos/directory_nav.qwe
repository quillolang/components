let directory_nav_demo_people = [
    { label: "Grace Hopper", href: "#grace", meta: "Navy" }, { label: "Ada Lovelace", href: "#directory_nav", meta: "Engineering" },
    { label: "Alan Turing", href: "#alan", meta: "Research" }, { label: "Barbara Liskov", href: "#barbara", meta: "Engineering" },
    { label: "Dennis Ritchie", href: "#dennis" }, { label: "Donald Knuth", href: "#donald", meta: "Research" },
    { label: "Edsger Dijkstra", href: "#edsger" }, { label: "Frances Allen", href: "#frances", meta: "Compilers" },
    { label: "Guido van Rossum", href: "#guido" }, { label: "Hedy Lamarr", href: "#hedy", meta: "Radio" },
    { label: "John McCarthy", href: "#john" }, { label: "Ken Thompson", href: "#ken" },
    { label: "Linus Torvalds", href: "#linus", meta: "Kernel" }, { label: "Margaret Hamilton", href: "#margaret", meta: "Apollo" },
    { label: "Niklaus Wirth", href: "#niklaus" }, { label: "Radia Perlman", href: "#radia", meta: "Networks" },
    { label: "Tim Berners-Lee", href: "#tim", meta: "Web" }, { label: "Yukihiro Matsumoto", href: "#matz" },
    { label: "3Blue1Brown", href: "#3b1b", meta: "Videos" }
]

view DirectoryNavDemo() =
    <div.demo-stack>
        <div style="max-width: 420px">
            <DirectoryNav id="directory-nav-demo" items={directory_nav_demo_people} current="#directory_nav" height={360}/>
        </div>
        <p.demo-note>Scroll the list: each letter's header stays at the top while its names pass; the row of letters jumps.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "directory_nav", name: "DirectoryNav", group: "Navigation",
    summary: "A long list of names grouped under sticky letter headers, with a row of letters at the top that jumps to each group.",
    tags: ["navigation", "list", "link", "user", "no-js"], demo: DirectoryNavDemo })
