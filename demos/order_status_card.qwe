let order_status_card_demo_now = "2026-11-01T12:00:00Z"

fn order_status_card_demo_stages(packed, shipped, out, there) = [
    { label: "Ordered", at: "2026-10-26T09:00:00Z", hours: 1 },
    { label: "Packed", at: packed, hours: 23 },
    { label: "Shipped", at: shipped, hours: 24 },
    { label: "Out for delivery", at: out, hours: 48 },
    { label: "Delivered", at: there, hours: 8 },
]

view OrderStatusCardDemo() =
    <div.demo-stack>
        <OrderStatusCard order="#4102" now={order_status_card_demo_now} promised="2026-11-04" carrier="Northline" track_href="#track"
            stages={[{ label: "Ordered", at: "2026-10-31T10:00:00Z", hours: 1 }, { label: "Packed", at: "2026-10-31T22:00:00Z", hours: 12 },
                     { label: "Shipped", hours: 24 }, { label: "Delivered", hours: 48 }]}/>
        <OrderStatusCard order="#3990" now={order_status_card_demo_now} promised="2026-11-01" carrier="Northline" track_href="#track" help_href="#help"
            stages={order_status_card_demo_stages("2026-10-27T08:00:00Z", "2026-10-31T09:00:00Z", null, null)}/>
        <OrderStatusCard order="#3871" now={order_status_card_demo_now} promised="2026-10-30" carrier="Northline" track_href="#track" help_href="#help"
            stages={order_status_card_demo_stages("2026-10-27T08:00:00Z", "2026-10-28T09:00:00Z", "2026-11-01T06:00:00Z", null)}/>
        <OrderStatusCard order="#3644" now={order_status_card_demo_now} promised="2026-10-29" carrier="Northline" track_href="#track" help_href="#help" refund_href="#refund"
            stages={order_status_card_demo_stages("2026-10-26T20:00:00Z", "2026-10-27T10:00:00Z", null, null)}/>
        <OrderStatusCard order="#3502" now={order_status_card_demo_now} promised="2026-10-28"
            stages={order_status_card_demo_stages("2026-10-26T20:00:00Z", "2026-10-27T10:00:00Z", "2026-10-27T20:00:00Z", "2026-10-28T11:00:00Z")}/>
        <OrderStatusCard order="#3388" now={order_status_card_demo_now} cancelled={true}
            stages={order_status_card_demo_stages(null, null, null, null)}/>
        <OrderStatusCard order="#0" now="not a date" promised="never" stages={[{ label: "Ordered", at: "whenever", hours: "soon" }, "junk"]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "order_status_card", name: "OrderStatusCard", group: "Mobile",
    summary: "The stages of an order with a progress bar, an estimate from data, and what to do when it is late.",
    tags: ["mobile", "no-js", "commerce", "order", "tracking", "tablet"],
    demo: OrderStatusCardDemo })
