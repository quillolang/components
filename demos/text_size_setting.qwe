component TextSizeSettingDemoLive(saved = null) {
    state said = "nothing yet"
    state changes = 0
    state shown = true
    <div.demo-stack>
        {shown && <TextSizeSetting id="text-size-setting-demo" saved={saved} on_change={(p) => { said = `${p}%`; changes += 1 }}/>}
        <Button size="lg" variant="ghost" id="text-size-setting-demo-remount" on_click={() => { shown = !shown }}>{shown ? "Leave the screen" : "Come back"}</Button>
        <p.demo-note id="text-size-setting-demo-out" data-changes={changes}>Kept: {said}.</p>
    </div>
}

component TextSizeSettingDemoOwn() {
    state said = 0
    <div.demo-stack>
        <TextSizeSetting id="text-size-setting-demo-own" value={500} least={80} most={120} step={10} remember={null} apply={false} on_change={(p) => { said = p }}/>
        <p.demo-note id="text-size-setting-demo-own-out">{said}</p>
    </div>
}

// A view cannot read `request`; a server fn can, and a route's own page would just use it.
server fn text_size_setting_demo_saved() = get(request.cookies, "ui-text-size")

view TextSizeSettingDemo() {
    let saved = text_size_setting_demo_saved()
    <div.demo-stack>
        <TextSizeSettingStyle saved={saved}/>
        <TextSizeSettingDemoLive saved={saved}/>
        <p id="text-size-setting-demo-page" style="margin: 0; font: 15px/20px var(--ui-font)">A paragraph of the page itself, written at 15 px.</p>
        <TextSizeSettingDemoOwn/>
    </div>
}

ui_gallery = ui_gallery | push({ slug: "text_size_setting", name: "TextSizeSetting", group: "Mobile",
    summary: "A text-size slider with a preview and the page following, respecting the system.",
    tags: ["mobile", "interactive", "tablet", "settings", "accessibility", "slider"],
    needs: ["button"],
    demo: TextSizeSettingDemo })
