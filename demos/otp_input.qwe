component OtpInputDemoLive() {
    state status = "Type the code: 6 digits."
    <div.demo-stack>
        <OtpInput name="otp-demo-live" label="Verification code" hint="We sent it to ada@example.com."
                  on_change={(c) => { status = `${len(c)} of 6 typed.` }}
                  on_complete={(c) => { status = `Checking ${c}…` }}/>
        <p.demo-note>{status}</p>
    </div>
}

view OtpInputDemo() =
    <div.demo-stack>
        <OtpInputDemoLive/>
        <OtpInput name="otp-demo-key" label="Recovery key" length={8} digits={false} groups={4}
                  hint="Letters and digits; paste it whole."/>
        <OtpInput name="otp-demo-pin" label="PIN" length={4} masked={true} value="12"
                  error="That PIN is not right: 2 tries left."/>
    </div>

ui_gallery = ui_gallery | push({ slug: "otp_input", name: "OtpInput", group: "Forms",
    summary: "Boxes for a one-time code: typing moves along, Backspace goes back, pasting fills them all.",
    tags: ["forms", "input", "security", "interactive"],
    demo: OtpInputDemo })
