component MarkdownEditorDemoLive() {
    state text = "Some **bold** text."
    <div.demo-stack>
        <MarkdownEditor name="md-demo-note" label="Note" rows={4} value={text} tools={["bold", "italic", "link", "code"]}
                        on_change={(t) => { text = t }}/>
        <p.demo-note>{len(text)} characters of Markdown.</p>
    </div>
}

view MarkdownEditorDemo() {
    <div.demo-stack>
        <MarkdownEditor name="md-demo-post" label="Post" placeholder="Write in Markdown…"
                        value={"# Release notes\n\nThe gallery has **search** now.\n\n- Tags\n- Dark mode"}
                        hint="Ctrl+B and Ctrl+I work too."/>
        <MarkdownEditorDemoLive/>
    </div>
}

ui_gallery = ui_gallery | push({ slug: "markdown_editor", name: "MarkdownEditor", group: "Forms",
    summary: "A Markdown textarea with a toolbar that wraps the selection (bold, italic, link, list) and a Preview tab rendered as the page will show it.",
    tags: ["forms", "input", "text", "tabs", "interactive"], demo: MarkdownEditorDemo })
