view SectionDemoCell(label: str) =
    <div style="padding: 16px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius-sm); background: var(--ui-subtle); font-size: 13px">{label}</div>

view SectionDemo() =
    <div.demo-stack>
        <Section id="section-demo-pricing" title="Pricing" description="One price per seat, monthly or yearly. No card needed to start."
                 spacing="sm" size="full" pad={false}
                 actions={[<Button variant="outline" size="sm">Compare plans</Button>, <Button size="sm">Start free</Button>]}>
            <Grid columns={3}>{for p in ["Free", "Team", "Business"] => <SectionDemoCell label={p}/>}</Grid>
        </Section>
        <Section id="section-demo-cta" title="Ready when you are" level={3} description="Set up takes five minutes."
                 size="sm" align="center" tone="subtle" spacing="sm"
                 actions={<Button href="https://quillolang.org/">Get started</Button>}>
            <p style="margin: 0">Centred, kept narrow, on a tinted band.</p>
        </Section>
        <p.demo-note>Each section's heading names it, so screen readers can jump from one to the next.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "section", name: "Section", group: "Layout",
    summary: "A part of a page under its title and a line about it, kept to a readable width, with room above and below.",
    tags: ["layout", "section", "page", "no-js"], demo: SectionDemo })
