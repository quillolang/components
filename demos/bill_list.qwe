let bill_list_demo_bills = [
    { id: "b-rent", payee: "Linden Court Lettings", category: "Rent", due: "2026-11-01", amount: 1450m, autopay: true },
    { id: "b-power", payee: "City Power & Light", category: "Electricity", due: "2026-10-27", amount: 88.15m },
    { id: "b-water", payee: "Port Ellis Water", category: "Water", due: "2026-11-20", amount: 34.6m },
    { id: "b-phone", payee: "Brightwave Mobile", category: "Phone", due: "2026-10-29", amount: 29m },
    { id: "b-stream", payee: "Streamly", category: "Subscription", due: "2026-10-30", amount: 12.99m, autopay: true },
    { id: "b-gym", payee: "Harbour Fitness", category: "Membership", due: "2026-10-22", amount: 45m, paid: true },
]

component BillListDemoLive() {
    state paying = ""
    <div.demo-stack>
        <BillList id="bill-list-demo" bills={bill_list_demo_bills} today="2026-10-29" on_pay={(id) => { paying = id }}/>
        <p.demo-note>{paying == "" ? "Press Pay on one." : `on_pay: ${paying}`}</p>
    </div>
}

view BillListDemo() = <div style="max-width: 560px"><BillListDemoLive/></div>

ui_gallery = ui_gallery | push({ slug: "bill_list", name: "BillList", group: "Finance",
    summary: "Upcoming bills soonest first, overdue and due-soon ones marked, autopay on or off, with the total to pay and a Pay button each.",
    tags: ["finance", "banking", "list", "payments", "no-js"], demo: BillListDemo })
