let contact_list_demo_people = [
    { id: 1, name: "Ada Lovelace", phone: "+44 20 7946 0018" },
    { id: 2, name: "Alan Turing", phone: "+44 20 7946 0954" },
    { id: 3, name: "Émile Borel", phone: "+33 1 70 18 99 00", org: "Sorbonne" },
    { id: 4, name: "edsger dijkstra", phone: "(020) 555-0123" },
    { id: 5, name: "Grace Hopper", phone: "+1 212 555 0147", phones: ["+1 646 555 0199"] },
    { id: 6, name: "Katherine Johnson", phone: "+1 757 555 0110" },
    { id: 7, name: "Linus Pauling" },
    { org: "Night Pharmacy", phone: "0800 555 111" },
    { id: 9, name: "Niklaus Wirth", phone: "+41 44 555 01 22" },
    { id: 10, name: "Ørsted Hans", phone: "+45 32 55 01 01" },
    { id: 11, name: "Radia Perlman", phone: "+1 415 555 0132" },
    { id: 12, name: "Żaneta Nowak", phone: "+48 22 555 01 01" },
    { id: 13, name: "李雷", phone: "+86 10 5555 0101" },
    { id: 14, name: "007 Bond", phone: "+44 20 7946 0007" },
    { id: 15, name: "Yukihiro Matsumoto", phone: "+81 3 5555 0100" }
]

// A long list to prove the search quick: names made from two short lists.
fn contact_list_demo_many(n: int) -> list {
    let firsts = ["Ana", "Ben", "Chloe", "Dan", "Eva", "Finn", "Gus", "Hana", "Ivan", "Jade", "Kofi", "Lena", "Mia", "Nils", "Omar", "Pia", "Quinn", "Rosa", "Sam", "Tara"]
    let lasts = ["Abbott", "Baker", "Costa", "Dahl", "Evans", "Fox", "Gray", "Hill", "Ito", "Jones", "Khan", "Lund", "Moss", "Novak", "Ortiz", "Park", "Reed", "Silva", "Tran", "Wood"]
    range(0, n) | map((i) => { id: i, name: `${firsts[i % 20]} ${lasts[(i * 7 + floor(i / 20)) % 20]}`, phone: `+1 555 ${1000 + i}` })
}

component ContactListDemoLive() {
    state picked = "none"
    state called = "none"
    <div.demo-stack>
        <div.demo-phone style="height: 560px">
            <ContactList id="contacts-demo" people={contact_list_demo_people} on_select={(p) => { picked = p.name ?? p.org }}/>
        </div>
        <p.demo-note>Picked <b data-picked>{picked}</b>; called <b data-called>{called}</b></p>
        <div.demo-phone style="height: 300px">
            <ContactList id="contacts-last" by="last" search={false} people={[{ name: "Ada Lovelace", phone: "+1" }, { name: "Grace Hopper", phone: "1 2" }, { name: "Plato" }]}
                         on_call={(p) => { called = p.name }} on_message={(p) => { called = `${p.name} by message` }}/>
        </div>
        <div.demo-phone style="height: 420px">
            <ContactList id="contacts-many" people={contact_list_demo_many(2000)} limit={120}/>
        </div>
        <div style="height: 120px"><ContactList id="contacts-bad" people={[null, 4, {}, { name: "Twin" }, { name: "Twin" }]} search={false}/></div>
        <div style="height: 120px"><ContactList id="contacts-empty" empty="Nobody yet" search={false}/></div>
    </div>
}

view ContactListDemo() = <ContactListDemoLive/>

ui_gallery = ui_gallery | push({ slug: "contact_list", name: "ContactList", group: "Mobile",
    summary: "People grouped by letter with avatars from initials, fast search across names and numbers, a call and message action per row.",
    tags: ["mobile", "interactive", "tablet", "list", "search", "people"], needs: ["avatar"],
    demo: ContactListDemo })
