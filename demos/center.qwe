view CenterDemo() =
    <div.demo-stack>
        <Center limit={420} class="center-demo-form">
            <div style="padding: 16px; border: 1px dashed var(--ui-strong); border-radius: var(--ui-radius-sm); text-align: left">
                A column no wider than 420px, centred, with the room left over at its sides.
            </div>
        </Center>
        <Center intrinsic={true} class="center-demo-button"><Button variant="outline">Load more</Button></Center>
        <Center text={true} limit={520} class="center-demo-text">
            <p style="margin: 0; color: var(--ui-muted)">Text centred as well, kept to 520px so the lines stay short enough to read.</p>
        </Center>
    </div>

ui_gallery = ui_gallery | push({ slug: "center", name: "Center", group: "Layout",
    summary: "Puts its content in the middle: a column capped in width, a thing centred by its own width, or centred text.",
    tags: ["layout", "utility", "no-js"], demo: CenterDemo })
