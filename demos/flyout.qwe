component FlyoutDemoLive() {
    state paid = false
    state times = 0
    <div.demo-row>
        <Flyout id="flyout-demo-filters" trigger="Filters" title="Filter orders" side="right" on_open={() => { times += 1 }}>
            <div.demo-stack>
                <Switch label="Paid only" checked={paid} on_change={(v) => { paid = v }}/>
                <Select name="status" label="Status" options={["Any", "Open", "Shipped"]}/>
            </div>
        </Flyout>
        <span.demo-note>{paid ? "Paid only" : "All orders"}, opened {times} {times == 1 ? "time" : "times"}.</span>
    </div>
}

view FlyoutDemo() =
    <div.demo-stack>
        <FlyoutDemoLive/>
        <div.demo-row style="padding-top: 120px">
            <Flyout id="flyout-demo-top" trigger="Above" side="top" align="center" variant="soft">
                <p>Opened above its button, centred on it.</p>
                <a href="#flyout">A link inside</a>
            </Flyout>
            <Flyout id="flyout-demo-bottom" trigger="Below, at the end" align="end" width={220}>
                <p>Its right edge lines up with the button's.</p>
            </Flyout>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "flyout", name: "Flyout", group: "Overlays",
    summary: "A panel that opens beside its button at a chosen side, keeps open while you work in it, and closes on a click outside.",
    tags: ["popover", "overlay", "interactive"],
    demo: FlyoutDemo })
