let welcome_carousel_demo_pages = [
    { art: "M4 4h16v16H4zM8 9h8M8 13h8M8 17h5", title: "Your notes, in your pocket", text: "They live on your phone and work with no signal at all." },
    { art: "M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11zM12 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z", title: "Remember where you were", text: "A note can keep its place, so you can find the spot again." },
    { art: "M4 12v7a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-7M16 7l-4-4-4 4M12 3v12", title: "Share a page with anyone", text: "Send a link. They need no account to read it." },
    { art: "M5 13l4 4L19 7", title: "That is all", text: "Your first note is one tap away." },
]

component WelcomeCarouselDemoLive() {
    state run = 0
    state how = "Not finished yet."
    <div.demo-stack>
        <div.demo-phone id="welcome-carousel-demo-frame">
            <div style="padding: 24px"><p class="demo-note">The app itself, behind the carousel.</p></div>
            <WelcomeCarousel key={run} remember="ui-demo-welcome" pages={welcome_carousel_demo_pages}
                             on_done={(h) => { how = `Done: ${h}` }}/>
        </div>
        <div.demo-row>
            <Button size="lg" variant="outline" id="welcome-carousel-demo-open" on_click={() => { run = run + 1 }}>Open the app again</Button>
            <Button size="lg" variant="ghost" id="welcome-carousel-demo-forget" on_click={() => {
                welcome_carousel_forget("ui-demo-welcome")
                how = "Forgotten."
                run = run + 1
            }}>Forget it was seen</Button>
        </div>
        <p.demo-note id="welcome-carousel-demo-how">{how}</p>
    </div>
}

view WelcomeCarouselDemo() = <WelcomeCarouselDemoLive/>

ui_gallery = ui_gallery | push({ slug: "welcome_carousel", name: "WelcomeCarousel", group: "Mobile",
    summary: "First-run pages swiped by finger with dots, Skip, Get started on the last page, shown once.",
    tags: ["mobile", "interactive", "tablet", "onboarding", "first-run", "swipe"],
    demo: WelcomeCarouselDemo })
