view CaptionDemo() =
    <div.demo-stack>
        <figure style="margin: 0; max-width: 360px">
            <div style="height: 120px; border-radius: var(--ui-radius-sm); background: linear-gradient(135deg, var(--ui-accent-soft), var(--ui-accent))"></div>
            <Caption id="caption-demo-figure" align="center">Figure 1. Sales by month, January to June. <a href="#caption">Source</a>.</Caption>
        </figure>
        <table id="caption-demo-table" style="border-collapse: collapse; font: 14px/1.4 var(--ui-font)">
            <Caption tag="caption">Orders this week, by day.</Caption>
            <thead><tr><th style="text-align: left; padding: 4px 12px 4px 0">Day</th><th style="text-align: right; padding: 4px 0">Orders</th></tr></thead>
            <tbody>
                <tr><td style="padding: 4px 12px 4px 0">Monday</td><td style="text-align: right">42</td></tr>
                <tr><td style="padding: 4px 12px 4px 0">Tuesday</td><td style="text-align: right">38</td></tr>
            </tbody>
        </table>
        <div.demo-narrow>
            <label for="caption-demo-field" style="display: block; margin-bottom: 6px; font: 500 13px/1.4 var(--ui-font)">Display name</label>
            <input id="caption-demo-field" name="caption-demo-field" type="text" aria-describedby="caption-demo-hint"
                   style="width: 100%; height: 38px; padding: 0 12px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius-sm); background: var(--ui-surface); color: var(--ui-fg); font: 14px var(--ui-font)"/>
            <Caption tag="p" id="caption-demo-hint" size="xs">Shown on your public profile. Letters and spaces only.</Caption>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "caption", name: "Caption", group: "Typography",
    summary: "Small muted text under a figure, a table or a field, as the right element for each.",
    tags: ["typography", "text", "image", "no-js"],
    demo: CaptionDemo })
