component RadioGroupDemoLive() {
    state plan = "pro"
    <div.demo-stack>
        <RadioGroup name="plan" label="Plan" cards={true} direction="row" value={plan}
                    options={[{ label: "Hobby", value: "hobby", hint: "Free, one project" },
                              { label: "Pro", value: "pro", hint: "$12 a month" },
                              { label: "Team", value: "team", hint: "$8 a seat" }]}
                    on_change={(v) => { plan = v }}/>
        <p.demo-note>You picked {plan}.</p>
    </div>
}

view RadioGroupDemo() =
    <div.demo-stack>
        <div.demo-row>
            <RadioGroup name="size" label="Size" value="m" direction="row" hint="Sizes run small."
                        options={[{ label: "Small", value: "s" }, { label: "Medium", value: "m" },
                                  { label: "Large", value: "l" }, { label: "XL (sold out)", value: "xl", disabled: true }]}/>
        </div>
        <RadioGroup name="ship" label="Delivery" required={true} error="Choose how it gets to you."
                    options={["Standard, 3 to 5 days", "Express, next day", "Pick up in store"]}/>
        <RadioGroupDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "radio_group", name: "RadioGroup", group: "Forms",
    summary: "One choice of several: real radio buttons in a fieldset, in a column, a row or as cards.",
    demo: RadioGroupDemo })
