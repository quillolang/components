component SliderDemoLive() {
    state price = 120
    <div.demo-stack>
        <Slider name="price" label="Max price" min={10} max={500} step={10} value={price} prefix="$"
                on_change={(v) => { price = v }}/>
        <p.demo-note>{price >= 300 ? "Showing everything." : `Showing hotels under $${price} a night.`}</p>
    </div>
}

view SliderDemo() =
    <div.demo-stack.demo-narrow>
        <Slider name="volume" label="Volume" value={60} format="%"/>
        <Slider name="radius" label="Search radius" min={1} max={50} value={5} format=" km"
                hint="How far from the address to look."/>
        <SliderDemoLive/>
        <Slider name="locked" label="Locked" value={30} disabled={true}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "slider", name: "Slider", group: "Forms",
    summary: "A range input with its value shown beside the label and the track filled up to the thumb.",
    demo: SliderDemo })
