// A year of daily closing prices: a seeded random walk with a drift, the same on every run
// and in the browser too (the generator's products stay under 2^53, exact in JavaScript).
fn brush_chart_demo_prices(seed: int, n: int) -> list {
    let s = seed
    let price = 120.0
    let out = []
    while len(out) < n {
        s = (s * 48271) % 2147483647
        price = price * (1 + (s / 2147483647 - 0.49) * 0.04)
        out = push(out, round(price * 100) / 100)
    }
    out
}
let brush_chart_demo_days = for i in range(240) => date.format(date.add_days("2026-01-05", i), "MMM D")

component BrushChartDemoLive() {
    state shown = `${brush_chart_demo_days[180]} to ${brush_chart_demo_days[239]}`
    <div.demo-stack>
        <BrushChart label="Closing price" show_label={true} labels={brush_chart_demo_days} values={brush_chart_demo_prices(11, 240)}
                    prefix="$" decimals={2} start={180} end={239} on_change={(first, last) => { shown = `${first} to ${last}` }}/>
        <p.demo-note>Showing {shown}. Drag the window under the chart, or its edges.</p>
    </div>
}

view BrushChartDemo() = <BrushChartDemoLive/>

ui_gallery = ui_gallery | push({ slug: "brush_chart", name: "BrushChart", group: "Charts",
    summary: "A large chart of a range with an overview below, where a window dragged or moved by keys picks the range shown.",
    tags: ["chart", "data", "interactive", "drag", "keyboard"],
    demo: BrushChartDemo })
