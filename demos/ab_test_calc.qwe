component AbTestCalcDemoLive() {
    state seen = "Change a figure to see on_change."
    <div.demo-stack>
        <AbTestCalc id="ab-test-calc-demo-live" title="New pricing page" names={["Old page", "New page"]} name="pricing" visitors_a={1000} conversions_a={100}
                    visitors_b={1000} conversions_b={110} confidence={90}
                    on_change={(f) => { seen = f == null ? "on_change: not a complete test." : `on_change: winner ${f.winner ?? "none"}, significant ${f.significant}.` }}/>
        <p.demo-note>{seen}</p>
    </div>
}

view AbTestCalcDemo() =
    <div.demo-stack>
        <AbTestCalc id="ab-test-calc-demo" title="Checkout button test" visitors_a={10000} conversions_a={500} visitors_b={10000} conversions_b={580}/>
        <AbTestCalcDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "ab_test_calc", name: "AbTestCalc", group: "Marketing",
    summary: "Reads an A/B test from visitors and conversions: lift, z-test, p-value, interval and a plain verdict, refusing to call too small a sample.",
    tags: ["smart", "interactive", "statistics", "experiment", "calculator", "marketing"], demo: AbTestCalcDemo })
