component ProfileFormDemoLive() {
    state got = null
    <div.demo-stack>
        <ProfileForm action="#" id="profile-form-demo-live" avatar={false} values={{ name: "Grace Hopper", username: "grace" }}
                     on_submit={(f) => { got = f }}/>
        <p.demo-note>{got == null ? "Not saved yet." : `on_submit got @${got.username} (${got.name}).`}</p>
    </div>
}


view ProfileFormDemo() =
    <div.demo-stack>
        <ProfileForm action="/settings/profile" id="profile-form-demo-plain" cancel_href="https://quillolang.org/"
                     values={{ name: "Ada Lovelace", username: "ada", bio: "Analytical engines and the first program.", website: "ada.example" }}
                     errors={{ username: "That username is taken." }}/>
        <ProfileFormDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "profile_form", name: "ProfileForm", group: "Forms",
    summary: "Avatar, name, username, bio and website in the usual layout: a plain form posting to your route, shown again with errors.",
    tags: ["forms", "input", "profile", "user", "upload", "no-js"], demo: ProfileFormDemo })
