let marquee_demo_words = ["Fast", "Accessible", "No build step", "One file", "Dark mode", "Keyboard first", "Forms that post"]

view MarqueeDemo() =
    <div.demo-stack>
        <Marquee speed={18} label="What people say">
            {for w in marquee_demo_words => <span style="padding: 6px 14px; border: 1px solid var(--ui-border); border-radius: 999px; background: var(--ui-subtle)">{w}</span>}
        </Marquee>
        <Marquee direction="right" speed={30} gap={24} pause={false} label="Numbers">
            {for n in range(1, 13) => <span style="font: 600 22px var(--ui-mono); color: var(--ui-muted)">{n * 111}</span>}
        </Marquee>
        <p.demo-note>The first pauses under the pointer; the second runs right and never stops.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "marquee", name: "Marquee", group: "Media",
    summary: "Content scrolling sideways without end, in CSS alone: seamless, paused on hover, still when motion is reduced.",
    tags: ["animation", "marketing", "media", "no-js"], demo: MarqueeDemo })
