let seat_picker_sheet_demo_fares = [
    { name: "Front", first: 1, last: 4, price: 42.50m },
    { name: "Exit row", first: 12, last: 12, price: 55.00m },
    { name: "Back", first: 18, last: 30, price: 9.99m },
]

component SeatPickerSheetDemoLive() {
    state seats = []
    state sum_of = "nothing yet"
    state changes = 0
    state closed = 0
    <div.demo-stack>
        <div.demo-row>
            <SeatPickerSheet trigger="Choose seats" title="Lisbon to Dubai" count={2} rows={24} layout="ABC DEFG HJK" skip_rows={[13]}
                             taken={["1A", "1B", "1C", "2D", "5A", "5B", "6B", "6C", "14C", "14D", "15B", "18H"]} exit_rows={[12]} access_seats={["3C", "3D", "4C"]} base={18.00m} fares={seat_picker_sheet_demo_fares}
                             currency="EUR" locale="en-IE" name="seats" on_change={(_s, _t) => { changes += 1 }}
                             on_confirm={(s, t) => { seats = s; sum_of = str(t) }} on_close={() => { closed += 1 }}/>
        </div>
        <p.demo-note>Confirmed: <span class="seat-picker-sheet-demo-seats">{join(seats, ", ")}</span>, total <span class="seat-picker-sheet-demo-total">{sum_of}</span>. Changes <span class="seat-picker-sheet-demo-changes">{changes}</span>, closed <span class="seat-picker-sheet-demo-closed">{closed}</span>.</p>
    </div>
}

view SeatPickerSheetDemo() = <SeatPickerSheetDemoLive/>

ui_gallery = ui_gallery | push({ slug: "seat_picker_sheet", name: "SeatPickerSheet", group: "Mobile",
    summary: "Pick seats in a sheet by zoom and tap, with fares, who sits beside you, seats found together and accessible seats.",
    tags: ["mobile", "interactive", "tablet", "travel", "seats", "gesture"],
    needs: ["button"], demo: SeatPickerSheetDemo })
