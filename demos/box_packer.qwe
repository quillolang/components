let box_packer_demo_boxes = [
    { name: "Extra large", size: "60 x 40 x 40", tare: "0.7", max_weight: "30" },
    { name: "Small", size: "20 x 15 x 10", tare: "0.1", max_weight: "5" },
    { name: "Large", size: "40 x 30 x 30", tare: "0.4", max_weight: "20" },
    { name: "Medium", size: "30 x 20 x 15", tare: "0.2", max_weight: "10" }]

component BoxPackerDemoLive() {
    state seen = null
    <div.demo-stack>
        <BoxPacker id="box-packer-demo-live" title="Exactly full, in inches" unit="in" name="order" boxes={[{ name: "Cube", size: [12, 12, 12] }, { name: "Oops", size: "12 x 12" }, 4]}
                   items={[{ name: "Block", size: [6, 6, 6], weight: "1.5", qty: 8 }]} on_change={(f) => { seen = f }}/>
        <p.demo-note>{seen == null ? "Change a figure to see on_change." : `on_change: ${len(seen.shipments)} box, ${seen.billable} billable.`}</p>
    </div>
}

view BoxPackerDemo() =
    <div.demo-stack>
        <BoxPacker id="box-packer-demo" boxes={box_packer_demo_boxes} items={[{ name: "Poster tube", size: "5 x 28 x 5", weight: "0.3" }]}/>
        <BoxPackerDemoLive/>
        <BoxPacker id="box-packer-demo-upright" title="This side up" boxes={[{ name: "Flat", size: "40 x 40 x 20" }]} items={[{ name: "Bottle", size: "10 x 10 x 30", weight: "1", upright: true }, { name: "Laid flat", size: "10 x 10 x 30", weight: "1" }]}/>
        <BoxPacker id="box-packer-demo-none" title="No boxes" boxes={[]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "box_packer", name: "BoxPacker", group: "Commerce",
    summary: "Picks the smallest box that takes items with rotation, or splits across boxes, works out dimensional and billable weight, and says when an item fits none.",
    tags: ["smart", "interactive", "commerce", "shipping", "packing", "weight"], demo: BoxPackerDemo })
