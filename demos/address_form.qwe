component AddressFormDemoLive() {
    state changed = null
    <div.demo-stack>
        <AddressForm id="address-form-demo-live" prefix="billing_" section="billing" legend="Billing address"
                     countries={["US", "CA", "GB", ["XK", "Kosovo"]]} values={{ country: "US" }}
                     on_change={(f, v) => { changed = `${f} = ${v}` }}/>
        <p.demo-note>{changed == null ? "Nothing changed yet." : `on_change: ${changed}`}</p>
    </div>
}

view AddressFormDemo() =
    <div.demo-stack>
        <AddressForm action="/account/address" id="address-form-demo-plain" section="shipping" legend="Shipping address"
                     values={{ line1: "1 Rue de Rivoli", city: "Paris", postcode: "75001", country: "FR" }}
                     errors={{ postcode: "A French postcode has five digits." }}/>
        <AddressFormDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "address_form", name: "AddressForm", group: "Forms",
    summary: "Street, city, region, postcode and country in the usual layout, with the autocomplete names browsers fill from.",
    tags: ["forms", "input", "checkout", "commerce", "no-js"], demo: AddressFormDemo })
