let token_list_demo_tokens = [
    { id: 7, name: "CI deploy", prefix: "qt_live_8f3a", created: "2026-09-14", last_used: "2026-10-27T09:12:00Z", scopes: ["read", "deploy"] },
    { id: 8, name: "Laptop", prefix: "qt_live_c01d", created: "2026-10-01", last_used: null, expires: "2027-12-31", scopes: ["read", "write"] },
    { id: 9, name: "Old script", prefix: "qt_live_77aa", created: "2025-02-03", last_used: "2025-08-19", expires: "2026-02-03" },
]

component TokenListDemoLive() {
    state revoked = []
    <div.demo-stack>
        <TokenList tokens={token_list_demo_tokens} on_revoke={(t) => { revoked = revoked | push(t.name) }}/>
        <p.demo-note>{len(revoked) == 0 ? "Revoke one: it asks first." : `Revoked: ${join(revoked, ", ")}.`}</p>
    </div>
}

view TokenListDemo() =
    <div.demo-stack>
        <TokenListDemoLive/>
        <TokenList revoke_action="#token_list" tokens={take(token_list_demo_tokens, 1)}/>
        <TokenList tokens={[]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "token_list", name: "TokenList", group: "Dashboard",
    summary: "API tokens with name, prefix, created, last used, scopes and expiry, and a Revoke that asks first.",
    tags: ["dashboard", "security", "settings", "table", "admin", "interactive"],
    needs: ["confirm_button"],
    demo: TokenListDemo })
