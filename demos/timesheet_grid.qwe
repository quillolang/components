component TimesheetGridDemoLive() {
    state sent = null
    <div.demo-stack>
        <TimesheetGrid id="timesheet-grid-demo-live" title="Night team" name="night" week="2026-11-04" overtime="weekly" weekly_hours={37.5}
                       projects={[{ name: "Plant", hours: ["22:00-06:00", "", "", "", "", "", ""] }]} on_submit={(s) => { sent = s }}/>
        <p.demo-note>{sent == null ? "Submit to see on_submit." : `on_submit: week of ${sent.week}, ${sent.total} hours, ${sent.overtime} overtime.`}</p>
    </div>
}

view TimesheetGridDemo() =
    <div.demo-stack>
        <TimesheetGrid id="timesheet-grid-demo" week="2026-11-02"
                       projects={[{ name: "Website", hours: ["7:30", "4", "8.5", "", "3.25", "", ""] },
                                  { name: "Support", hours: ["", "4.5", "", "9", "4:07", "", ""] }]}/>
        <TimesheetGridDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "timesheet_grid", name: "TimesheetGrid", group: "Scheduling",
    summary: "A week by projects: type 7.5, 7:30 or 22:00-06:00 and it rounds to the quarter, takes off breaks, totals the days and splits out overtime by rule.",
    tags: ["smart", "interactive", "hours", "payroll", "overtime", "forms"], demo: TimesheetGridDemo })
