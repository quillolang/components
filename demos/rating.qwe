component RatingDemoLive() {
    state given = null
    <div.demo-stack>
        <Rating name="rating-demo-live" label="How was your delivery?" labels={["Awful", "Poor", "OK", "Good", "Great"]}
                on_change={(v) => { given = v }}/>
        <p.demo-note>{given == null ? "Not rated yet." : `You gave ${rating_num(given)} of 5.`}</p>
    </div>
}

view RatingDemo() =
    <div.demo-stack.demo-narrow>
        <Rating name="rating-demo-stars" label="Your rating" required={true} hint="Use the arrow keys, or click a star."/>
        <Rating name="rating-demo-half" label="Overall (half stars)" value={3.5} half={true} size="lg"/>
        <RatingDemoLive/>
        <div.demo-row>
            <Rating value={4.3} readonly={true} count={128}/>
            <Rating value={2} readonly={true} size="sm"/>
        </div>
        <Rating name="rating-demo-locked" label="Locked" value={4} disabled={true} size="sm"/>
    </div>

ui_gallery = ui_gallery | push({ slug: "rating", name: "Rating", group: "Forms",
    summary: "Stars to give a score (radio buttons underneath, half stars if wanted) or to show one, read-only.",
    tags: ["forms", "input", "interactive"],
    demo: RatingDemo })
