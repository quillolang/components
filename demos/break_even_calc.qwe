component BreakEvenCalcDemoLive() {
    state note = "Change something to see on_change."
    <div.demo-stack>
        <BreakEvenCalc id="break-even-calc-demo-live" name="cafe" title="Coffee cart" unit="cup" fixed="1000" variable="3" price="6.25" volume={250} currency="EUR"
                       on_change={(b) => { note = `on_change: ${b.units} units, profit ${b.profit}, price ${b.target_price}.` }}/>
        <p.demo-note>{note}</p>
    </div>
}

view BreakEvenCalcDemo() =
    <div.demo-stack>
        <BreakEvenCalc id="break-even-calc-demo" fixed="12000" variable="7.50" price="12.50" volume={3000} target="10000"/>
        <BreakEvenCalcDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "break_even_calc", name: "BreakEvenCalc", group: "Finance",
    summary: "Finds break-even units and revenue from costs and price, the margin of safety at a volume, a chart, and the price a target profit needs.",
    tags: ["smart", "interactive", "finance", "business", "pricing", "calculator"], demo: BreakEvenCalcDemo })
