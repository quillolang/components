let expandable_table_demo_orders = [
    { id: "o-1041", number: "#1041", customer: "Northwind Traders", total: 1240.5, email: "orders@northwind.example", shipped: "2026-03-14", items: 3,
      note: "Leave the parcel with the neighbour at 14b if nobody answers." },
    { id: "o-1042", number: "#1042", customer: "Acme Corp", total: 310, email: "buy@acme.example", shipped: null, items: 1, note: "" },
    { id: "o-1043", number: "#1043", customer: "Globex", total: 5125.75, email: "ops@globex.example", shipped: "2026-03-18", items: 12,
      note: "Invoice to the Hamburg office, not the one on the order." },
]

let expandable_table_demo_jobs = [
    { id: 7, name: "nightly-backup", status: "ok", took: 312, log: "Snapshot taken. 1.2 GB uploaded in 5 min 12 s." },
    { id: 8, name: "rebuild-index", status: "failed", took: 44, log: "Out of disk at 38%: /var/index needs 2 GB more." },
    { id: 9, name: "send-digests", status: "ok", took: 1290, log: "4,210 emails sent, 3 bounced." },
]

component ExpandableTableDemoLive() {
    state last = "none"
    <div.demo-stack>
        <ExpandableTable id="expandable-table-demo-jobs" label="Jobs" rows={expandable_table_demo_jobs} single={true} expanded={[8]} zebra={true}
                         render={(r) => <p.ui-expandable-text><b>{r.status == "ok" ? "Succeeded" : "Failed"}</b> after {r.took} s: {r.log}</p>}
                         on_toggle={(rid, open) => { last = `${open ? "opened" : "closed"} ${rid}` }}
                         columns={[{ key: "name", label: "Job" }, { key: "status", label: "Status" }, { key: "took", label: "Seconds", format: "number" }]}/>
        <p.demo-note>Last toggle: {last}. Only one row is open at a time here (<code>single</code>).</p>
    </div>
}

view ExpandableTableDemo() =
    <div.demo-stack>
        <ExpandableTable id="expandable-table-demo-orders" label="Orders" rows={expandable_table_demo_orders} detail="note"
                         fields={[{ key: "email", label: "Email" }, { key: "shipped", label: "Shipped", format: "date" }, { key: "items", label: "Items" }]}
                         columns={[{ key: "number", label: "Order" }, { key: "customer", label: "Customer" }, { key: "total", label: "Total", format: "money" }]}/>
        <ExpandableTableDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "expandable_table", name: "ExpandableTable", group: "Data",
    summary: "Rows with a button that opens a panel of details under them: labelled fields, a note, or your own markup.",
    tags: ["data", "table", "interactive"], demo: ExpandableTableDemo })
