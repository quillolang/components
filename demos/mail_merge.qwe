let mail_merge_demo_template = "Hi {{name|there}},\n\nYour order {{order}} ships on {{date}}. Thanks for shopping at {{shop|our store}}!"
let mail_merge_demo_rows = "name,order,date,email\nAna Reyes,1041,3 March,ana@example.com\n,1042,4 March,ben@example.com\n\"Lee, Sam\",1043,,sam@example.com"

component MailMergeDemoLive() {
    state queued = null
    <div.demo-stack>
        <MailMerge id="mail-merge-demo-live" name="body" data_name="people" template="Dear {{name}}, welcome." rows={[{ name: "Ana" }, { name: "" }, { name: "Sam" }]} rows_box={4}
                   on_send={(rendered) => { queued = rendered }}/>
        <p.demo-note>{queued == null ? "Send to see on_send." : `on_send: ${len(queued)} messages, the last to row ${last(queued).row}: ${last(queued).text}`}</p>
    </div>
}

view MailMergeDemo() =
    <div.demo-stack>
        <MailMerge id="mail-merge-demo" template={mail_merge_demo_template} data={mail_merge_demo_rows}/>
        <MailMergeDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "mail_merge", name: "MailMerge", group: "Marketing",
    summary: "Fills a template with {{name}} and fallbacks from CSV or JSON rows: a preview for each row, the missing and unused variables, and the rows that would send an empty value.",
    tags: ["smart", "interactive", "email", "template", "marketing", "merge"], demo: MailMergeDemo })
