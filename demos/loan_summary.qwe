                     rate={6.25} next_amount={1539.29} next_date="2026-11-15" today="2026-10-29" ends="2051-06-15" payments_left={296}
                     pay_href="#pay-4821" href="#loan-4821"/>
        <LoanSummary id="loan-summary-demo-personal" name="Personal loan" lender="Northwind Credit Union" account="•••• 0937" balance={6240.5}
                     original={9000} rate={11.4} next_amount={318.77} next_date="2026-10-24" today="2026-10-29" payments_left={21}
                     pay_href="#pay-0937"/>
        <LoanSummary id="loan-summary-demo-car" name="Autokredit" lender="Rheinland Bank" account="•••• 5512" balance={0} original={18000}
                     rate={3.9} rate_label="eff." currency="EUR" locale="de-DE" pay_href="#pay-5512" href="#loan-5512" link_label="Kontoauszug"/>
    </div>

ui_gallery = ui_gallery | push({ slug: "loan_summary", name: "LoanSummary", group: "Finance",
    summary: "A loan in a card: the outstanding balance out of the amount borrowed, how much is paid off as a bar, the rate, and the next payment and when it is due.",
    tags: ["finance", "loans", "card", "banking", "no-js"], demo: LoanSummaryDemo })
