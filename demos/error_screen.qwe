let error_screen_demo_css = css`
.error-screen-demo-keys { display: flex; flex-wrap: wrap; gap: 8px; }
`

component ErrorScreenDemoLive() {
    style global error_screen_demo_css
    state status = 500
    state plan = "fail"
    state calls = 0
    state back = false
    state homes = 0
    let answer = () => {
        calls += 1
        match plan {
            "fail" => false
            "status" => { status: 503, reason: "Maintenance until noon." }
            "wait" => { status: 429, retry_after: 2 }
            "promise-fail" => js("Promise.resolve", { status: 504 })
            "reject" => js("Promise.reject", "no")
            "err" => err("broke")
            _ => { back = true; true }
        }
    }
    <div.demo-stack>
        <div.error-screen-demo-keys>
            {for s in [500, 503, 404, 401, 429, 0] => <Button key={s} size="lg" variant={status == s ? "solid" : "outline"} id={`error-screen-demo-s${s}`} on_click={() => { status = s; back = false }}>{s == 0 ? "No answer" : `${s}`}</Button>}
            {for p in ["fail", "status", "wait", "promise-fail", "reject", "err", "ok"] => <Button key={p} size="lg" variant={plan == p ? "soft" : "ghost"} id={`error-screen-demo-p${p}`} on_click={() => { plan = p }}>{p}</Button>}
        </div>
        <p.demo-note id="error-screen-demo-out">{calls} calls. {back ? "It worked." : ""} {homes} homes.</p>
        <div.demo-phone id="error-screen-demo-frame">
            <ErrorScreen id="error-screen-demo" status={status} reference="req-7f3a2c" home_label="Back to the shop"
                         reason={status == 500 ? "The price list could not be loaded." : null}
                         on_retry={answer} on_home={() => { homes += 1 }}/>
        </div>
    </div>
}

view ErrorScreenDemo() = <div><ErrorScreenDemoLive/></div>

ui_gallery = ui_gallery | push({ slug: "error_screen", name: "ErrorScreen", group: "Mobile",
    summary: "A full screen for failure with the reason, retry, and offline told apart from server trouble.",
    tags: ["mobile", "interactive", "tablet", "error", "offline", "retry"],
    needs: ["button"],
    demo: ErrorScreenDemo })
