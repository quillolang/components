component NewsQuizDemoLive() {
    state note = "Not finished yet."
    <div.demo-stack>
        <NewsQuiz id="news-quiz-demo" title="The week in news, Oct 30" on_finish={(score, total) => { note = `on_finish gave ${score} of ${total}` }}
                  questions={[
                      { q: "Which city was picked on Tuesday to host the 2030 climate summit?", choices: ["Lisbon", "Nairobi", "Osaka", "Bogotá"],
                        answer: 1, explain: "Nairobi will be the first African city to host it.", href: "#summit" },
                      { q: "By how much did the central bank change its main rate this week?", choices: ["Cut by 0.25 points", "Raised by 0.25 points", "No change"],
                        answer: 2, explain: "It held at 4.25% for a fourth month." },
                      { q: "What did the city council vote to ban from the old town from January?", choices: ["Cars", "Tour buses", "E-scooters", "Short-term rentals"],
                        answer: 2, href: "#scooters" },
                  ]}/>
        <p.demo-note id="news-quiz-demo-note">{note}</p>
    </div>
}

view NewsQuizDemo() = <NewsQuizDemoLive/>

ui_gallery = ui_gallery | push({ slug: "news_quiz", name: "NewsQuiz", group: "News",
    summary: "The week's news quiz: a question at a time, each pick marked right or wrong with the story behind it, then the score with a mark per question and Play again.",
    tags: ["news", "quiz", "game", "forms", "interactive"], demo: NewsQuizDemo })
