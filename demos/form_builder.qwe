let form_builder_demo_fields = [
    { name: "full_name", label: "Full name", type: "text", required: true, placeholder: "Ana Silva" },
    { name: "email", label: "Email", type: "email", required: true, hint: "We reply here." },
    { name: "topic", label: "Topic", type: "select", options: ["Sales", "Support"] },
    { name: "details", label: "Details", type: "textarea", show_if: { field: "topic", is: "Support" } },
]

component FormBuilderDemoLive() {
    state said = "Change the form to see on_change."
    <div.demo-stack>
        <FormBuilder id="form-builder-demo" fields={form_builder_demo_fields} name="form_json" on_change={(f) => { said = `on_change: ${len(f)} fields, the last ${f[len(f) - 1].name ?? "none"}.` }}/>
        <p.demo-note data-said="true">{said}</p>
    </div>
}

view FormBuilderDemo() = <FormBuilderDemoLive/>

ui_gallery = ui_gallery | push({ slug: "form_builder", name: "FormBuilder", group: "Forms",
    summary: "Add, reorder and set up fields beside a live preview; names cannot repeat, and the form goes out as JSON that also loads back.",
    tags: ["smart", "interactive", "form", "builder", "json", "editor"], needs: ["rule_form", "regex_tester"], demo: FormBuilderDemo })
