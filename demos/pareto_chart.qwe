view ParetoChartDemo() =
    <div.demo-stack>
        <ParetoChart label="Returns by reason" show_label={true} value_name="Returns"
                     labels={["Damaged", "Late", "Wrong size", "Not as shown", "Changed mind", "Duplicate", "Other"]}
                     values={[160, 74, 412, 96, 38, 12, 21]}/>
        <ParetoChart label="Support hours by topic" show_label={true} suffix=" h" threshold={70} value_name="Hours" height={180}
                     labels={["Login", "Billing", "Exports", "API", "Mobile app"]} values={[36.5, 28, 9.5, 14, 6]}/>
        <p.demo-note>Given in any order, drawn largest first; the strong bars reach the dashed line.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "pareto_chart", name: "ParetoChart", group: "Charts",
    summary: "Causes as bars sorted largest first with the running share as a line on a 0 to 100% axis, and the few that reach 80% picked out.",
    tags: ["chart", "data", "dashboard", "no-js"],
    demo: ParetoChartDemo })
