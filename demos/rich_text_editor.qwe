component RichTextEditorDemoLive() {
    state html = ""
    <div.demo-stack>
        <RichTextEditor name="rte-demo-note" label="Note" tools={["bold", "italic", "underline", "list"]} min_height={80}
                        on_change={(h) => { html = h }}/>
        <p.demo-note>{html == "" ? "Empty." : `HTML: ${html}`}</p>
    </div>
}

view RichTextEditorDemo() {
    <div.demo-stack>
        <RichTextEditor name="rte-demo-body" label="Description"
                        value="<p>A <b>bold</b> start, and a <a href=\"https://quillolang.org\">link</a>.</p><ul><li>One</li><li>Two</li></ul>"
                        hint="Select text, then use the toolbar or Ctrl+B / I / U."/>
        <RichTextEditorDemoLive/>
    </div>
}

ui_gallery = ui_gallery | push({ slug: "rich_text_editor", name: "RichTextEditor", group: "Forms",
    summary: "A formatted-text editor (bold, italic, lists, links, headings) on contenteditable, its HTML kept in a hidden input a form sends.",
    tags: ["forms", "input", "text", "interactive"], demo: RichTextEditorDemo })
