component VideoCaptureDemoLive() {
    state got = null
    state shown = true
    <div.demo-stack>
        {shown && <form.demo-stack method="post" action="/" enctype="multipart/form-data">
            <VideoCapture name="clip" limit={2} hint="Two seconds in this example." on_change={(c) => { got = c }}/>
        </form>}
        <p.demo-note id="video-capture-demo-note">{got == null ? "No clip yet." : `Accepted: ${got.name}, ${got.type}, ${got.seconds == null ? "length not known" : `${round(got.seconds)} s`}.`}</p>
        <Button size="lg" variant="ghost" tone="neutral" on_click={() => { shown = !shown }}>{shown ? "Leave the page" : "Come back"}</Button>
    </div>
}

view VideoCaptureDemo() =
    <div.demo-stack>
        <VideoCaptureDemoLive/>
        <p.demo-note>The browser asks first. If it is refused, the same field opens the phone's own camera.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "video_capture", name: "VideoCapture", group: "Mobile",
    summary: "Records a short clip through the camera with a limit and a timer ring, shows it before it is accepted, and falls back to the system's camera where recording is refused.",
    tags: ["mobile", "interactive", "camera", "video", "upload", "forms"], needs: ["button"], demo: VideoCaptureDemo })
