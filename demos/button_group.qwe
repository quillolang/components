view ButtonGroupDemo() =
    <div.demo-stack>
        <div.demo-row>
            <ButtonGroup label="Text alignment">
                <Button variant="outline">Left</Button>
                <Button variant="outline">Centre</Button>
                <Button variant="outline">Right</Button>
            </ButtonGroup>
            <ButtonGroup label="Save">
                <Button>Save</Button>
                <IconButton icon="chevron-down" label="More ways to save" variant="solid" tone="accent"/>
            </ButtonGroup>
            <ButtonGroup label="Zoom">
                <IconButton icon="plus" label="Zoom in" variant="outline"/>
                <IconButton icon="search" label="Fit" variant="outline"/>
                <IconButton icon="x" label="Reset" variant="outline"/>
            </ButtonGroup>
        </div>
        <div.demo-row>
            <ButtonGroup label="Actions" attached={false}>
                <Button variant="soft">Archive</Button>
                <Button variant="soft">Move</Button>
                <Button variant="soft" tone="danger">Delete</Button>
            </ButtonGroup>
            <ButtonGroup label="Order" vertical={true}>
                <Button variant="outline" size="sm">First</Button>
                <Button variant="outline" size="sm">Second</Button>
            </ButtonGroup>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "button_group", name: "ButtonGroup", group: "Actions",
    summary: "Buttons joined edge to edge into one control, or spaced in a row; across or upright.",
    tags: ["forms", "button", "no-js"],
    demo: ButtonGroupDemo })
