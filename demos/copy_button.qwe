view CopyButtonDemo() =
    <div.demo-stack>
        <div.demo-row>
            <code style="padding: 8px 12px; border-radius: var(--ui-radius-sm); background: var(--ui-subtle); font: 13px var(--ui-mono)">quillo run app.qwe</code>
            <CopyButton text="quillo run app.qwe"/>
        </div>
        <div.demo-row>
            <CopyButton text="https://quillolang.org/components/" label="Copy link" variant="soft" size="sm"/>
            <CopyButton text="demo-key-not-a-secret" label="Copy key" done="Key copied" variant="ghost"/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "copy_button", name: "CopyButton", group: "Actions",
    summary: "Copies text to the clipboard and says so for a moment, to the eye and to screen readers.",
    demo: CopyButtonDemo })
