let responsive_split_demo_css = css`
.responsive-split-demo-note { box-sizing: border-box; display: block; width: 100%; min-height: 120px; padding: 10px 12px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius-sm); background: var(--ui-surface); color: var(--ui-fg); font: 16px/1.4 var(--ui-font); }
`

let responsive_split_demo_mail = range(1, 41) | map((i) => {
    id: `m${i}`,
    title: i == 1 ? "Ana Silva" : i == 2 ? "Rooftop Deliveries" : i == 3 ? "Ben Okafor" : `Sender ${i}`,
    subtitle: i == 1 ? "The plans for Saturday" : i == 2 ? "Your parcel is at the depot" : `Message number ${i}`,
    meta: `${8 + (i % 4)}:${i % 2 == 0 ? "15" : "40"}`,
    body: `Message ${i}. It is long enough to read on a phone, and wide enough on a tablet to want a side of its own.`
})

component ResponsiveSplitDemoLive() {
    style global responsive_split_demo_css
    state open = "m2"
    state picks = 0
    state backs = 0
    state read = 0
    // Changes the list as well as the page's text, as new mail would while a finger is down.
    let mail = responsive_split_demo_mail | map((m) => m.id == open ? { id: m.id, title: m.title, subtitle: `Read ${read} times`, meta: m.meta, body: m.body } : m)
    <div.demo-tablet>
        <ResponsiveSplit id="responsive-split-demo" title="Inbox" items={mail} selected={open} label="Messages"
                         on_select={(id) => { open = id; picks += 1 }} on_back={() => { backs += 1 }}>
            <label class="ui-sr" for="responsive-split-demo-reply">Reply</label>
            <textarea.responsive-split-demo-note id="responsive-split-demo-reply" placeholder="Write a reply"></textarea>
            <p.demo-note id="responsive-split-demo-out">Open: {open}. Picked {picks}, back {backs}, read {read}.</p>
            <Button size="lg" variant="outline" id="responsive-split-demo-read" on_click={() => { read += 1 }}>Mark as read</Button>
        </ResponsiveSplit>
    </div>
}

view ResponsiveSplitDemo() = <div><ResponsiveSplitDemoLive/></div>

ui_gallery = ui_gallery | push({ slug: "responsive_split", name: "ResponsiveSplit", group: "Mobile",
    summary: "Master and detail as one stack on a phone and side by side on a tablet, changing live on rotation and keeping the selection.",
    tags: ["mobile", "interactive", "tablet", "layout", "master-detail", "rotation"],
    demo: ResponsiveSplitDemo })
