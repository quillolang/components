// The clip is one of MDN's shared sample sounds.
let audio_player_demo_src = "https://mdn.github.io/shared-assets/audio/t-rex-roar.mp3"

component AudioPlayerDemoLive() {
    state ended = 0
    <div.demo-stack>
        <AudioPlayer src={audio_player_demo_src} title="T. rex roar" artist="MDN sample sounds" on_end={() => { ended += 1 }}/>
        <p.demo-note id="audio-player-demo-note">Ended {ended} times.</p>
    </div>
}

view AudioPlayerDemo() =
    <div.demo-stack.demo-narrow style="max-width: 520px">
        <AudioPlayerDemoLive/>
        <AudioPlayer src={audio_player_demo_src} title="Compact, two speeds" compact={true} speeds={[1, 2]}/>
        <AudioPlayer src={audio_player_demo_src} title="No speed button" speeds={[]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "audio_player", name: "AudioPlayer", group: "Media",
    summary: "An audio clip with play, a seek bar that says the time, and a button cycling through playback speeds.",
    tags: ["media", "audio", "interactive"], demo: AudioPlayerDemo })
