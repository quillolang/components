view AuthorBioDemo() =
    <div.demo-stack>
        <AuthorBio id="author-bio-demo" name="Ada Lovelace" href="#author_bio-ada" role="Compiler engineer at Quillo" posts={42}
                   bio="Ada writes about compilers, browsers and the odd analytical engine. Before Quillo she spent ten years making databases fast, and she still answers every email about them."
                   links={[{ kind: "website", href: "https://ada.example.dev" }, { kind: "mastodon", href: "https://hachyderm.io/@ada" },
                           { kind: "github", href: "https://github.com/ada" }, { kind: "rss", href: "#author_bio-feed", label: "Her feed" }]}
                   follow_href="#author_bio-follow"/>
        <div style="max-width: 300px">
            <AuthorBio id="author-bio-demo-stacked" name="Ben Okafor" layout="stacked" eyebrow="Guest post by" posts={1}
                       posts_href="#author_bio-ben">
                <p>Ben runs <a href="#author_bio-ben">a small bakery</a> and writes its website in Quillo, between batches.</p>
            </AuthorBio>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "author_bio", name: "AuthorBio", group: "Blogging",
    summary: "The box at the end of a post about its author: picture or initials, name and role, a short bio, links elsewhere, their post count and a follow link.",
    tags: ["blogging", "user", "card", "profile", "no-js"], demo: AuthorBioDemo })
