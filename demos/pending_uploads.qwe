component PendingUploadsDemoLive() {
    state log = []
    state refuse = false
    state slow = false
    state say_net = null
    state rule_said = "The rule has not been touched."
    state kept = "Nothing reported yet."
    // A pretend server, a moment away. Named, as js_new is not waited for in a function written
    // in the markup's prop.
    let take_part = (p) => {
        let pause = js("Promise.resolve", js_new("Promise", (done) => { js("AbortSignal.timeout", slow ? 300 : 60).addEventListener("abort", (_e) => { done(true) }) }))
        if refuse {
            return { ok: false, error: "The server is busy." }
        }
        if js("navigator.onLine") == false {
            return err("not reached")
        }
        log = log | push(`${p.name} ${p.offset}-${p.end}${p.last ? " last" : ""} (${p.part.size})`)
        pause
    }
    <div.demo-stack>
        <PendingUploads id="pendup-demo" chunk={1024} send_part={take_part} network={say_net} max_size={20000} max_files={4}
                        on_rule={(on) => { rule_said = on ? "Wifi only is on." : "Wifi only is off." }}/>
        <div.demo-row>
            <Button size="lg" variant="outline" id="pendup-refuse" on_click={() => { refuse = !refuse }}>{refuse ? "Let parts through" : "Make the server fail"}</Button>
            <Button size="lg" variant="outline" id="pendup-slow" on_click={() => { slow = !slow }}>{slow ? "Speed up" : "Slow down"}</Button>
            <Button size="lg" variant="outline" id="pendup-wifi" on_click={() => { say_net = "wifi" }}>Say wifi</Button>
            <Button size="lg" variant="outline" id="pendup-cell" on_click={() => { say_net = "cellular" }}>Say mobile data</Button>
            <Button size="lg" variant="outline" id="pendup-none" on_click={() => { say_net = null }}>Say nothing</Button>
        </div>
        <p.demo-note id="pendup-rule-said">{rule_said}</p>
        <p.demo-note id="pendup-log">{len(log) == 0 ? "The server has taken nothing yet." : join(log, ", ")}</p>
        <PendingUploads id="pendup-kept" chunk={1024} send_part={take_part} wifi_only={true} network="wifi" saved={{ rule: false, items: [{ id: "scan.pdf:3000:5", name: "scan.pdf", size: 3000, type: "application/pdf", modified: 5, sent: 1024, status: "sending", kept: true }] }}
                        on_change={(s) => { kept = `Would keep: ${s.rule} ${join(s.items | map((a) => `${a.name} ${a.sent}`), ", ")}.` }}/>
        <p.demo-note id="pendup-kept-said">{kept}</p>
    </div>
}

view PendingUploadsDemo() = <PendingUploadsDemoLive/>

ui_gallery = ui_gallery | push({ slug: "pending_uploads", name: "PendingUploads", group: "Mobile",
    summary: "A queue of files with progress, pause, retry and a wifi-only rule, surviving a reload as far as a browser can.",
    tags: ["mobile", "interactive", "offline", "upload", "files", "tablet"],
    demo: PendingUploadsDemo })
