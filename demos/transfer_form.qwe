let transfer_form_demo_accounts = [
    { id: "chk", name: "Everyday", number: "0012 0048 21", available: 2310.18m },
    { id: "sav", name: "Rainy day", number: "0012 0077 10", available: 420m },
]
let transfer_form_demo_payees = [
    { id: "p-ana", name: "Ana Okafor", bank: "Harbor Bank", number: "88120345" },
    { id: "p-rent", name: "Linden Court Lettings", bank: "Fernway Credit Union", number: "40029917" },
]

component TransferFormDemoLive() {
    state sent = ""
    <div.demo-stack>
        <TransferForm id="transfer-form-demo" accounts={transfer_form_demo_accounts} payees={transfer_form_demo_payees}
                      today="2026-10-29" fee={1.5m} memo="October rent"
                      on_confirm={(t) => { sent = `${t.from} to ${t.to}: ${t.amount} + ${t.fee} on ${t.date}, "${t.memo}"` }}/>
        <p.demo-note>{sent == "" ? "Nothing sent yet." : `on_confirm: ${sent}`}</p>
    </div>
}

view TransferFormDemo() = <TransferFormDemoLive/>

ui_gallery = ui_gallery | push({ slug: "transfer_form", name: "TransferForm", group: "Finance",
    summary: "A transfer between your accounts or to a payee: from, to, amount, date and memo, checked, then a review with the fee and the balance after.",
    tags: ["finance", "banking", "forms", "wizard", "interactive"], demo: TransferFormDemo })
