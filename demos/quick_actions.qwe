let quick_actions_demo_icon = (d: str) =>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={d}/></svg>

component QuickActionsDemoLive() {
    state picked = null
    <div.demo-stack>
        <QuickActions id="quick-actions-demo" on_select={(a) => { picked = a.label }} actions={[
            { label: "New order", href: "#quick_actions", icon: quick_actions_demo_icon("M12 5v14M5 12h14") },
            { label: "Add customer", icon: quick_actions_demo_icon("M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM19 8v6M22 11h-6"), tone: "success" },
            { label: "Export", hint: "CSV of this month", icon: quick_actions_demo_icon("M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"), tone: "info" },
            { label: "Billing", href: "#quick_actions", icon: "💳", tone: "warning" },
            { label: "Settings", href: "#quick_actions", icon: quick_actions_demo_icon("M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"), tone: "neutral" },
            { label: "Delete all", icon: "🗑️", tone: "danger", disabled: true },
        ]}/>
        <p.demo-note>{picked == null ? "Pick a button (not a link) to call on_select." : `Picked: ${picked}.`}</p>
    </div>
}

view QuickActionsDemo() =
    <div.demo-stack>
        <QuickActionsDemoLive/>
        <form method="post" action="#quick_actions">
            <QuickActions columns={3} label="Reports" actions={[
                { label: "Sales", name: "report", value: "sales", icon: "📈" },
                { label: "Stock", name: "report", value: "stock", icon: "📦" },
                { label: "Taxes", name: "report", value: "taxes", icon: "🧾" },
            ]}/>
        </form>
    </div>

ui_gallery = ui_gallery | push({ slug: "quick_actions", name: "QuickActions", group: "Dashboard",
    summary: "A grid of big icon buttons for the common actions: links, submit buttons in a form, or on_select.",
    tags: ["dashboard", "button", "grid", "navigation", "forms", "no-js"],
    demo: QuickActionsDemo })
