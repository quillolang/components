let quick_transfer_demo_people = [
    { id: "ana", name: "Ana Reyes", note: "Lunch last week" },
    { id: "joe", name: "Joe Park", note: "Rent" },
    { id: "mia", name: "Mia Lindqvist", note: "Book club" },
    { id: "sam", name: "Sam", note: "Bike repair" },
    { id: "lea", name: "Léa Dubois", note: "Flat deposit" },
    { id: "tom", name: "Tom O'Brien", note: "Pizza" },
]

component QuickTransferDemoLive() {
    state log = "Nothing sent"
    state refuse = false
    <div.demo-stack>
        <QuickTransfer people={quick_transfer_demo_people} balance={2481.07m} per_transfer={1000m} daily_left={750m}
                       on_send={(t) => {
                           if refuse { return { ok: false, message: "Your bank declined this." } }
                           log = `Sent ${str(t.amount)} ${t.currency} to ${t.to} (${t.text})`
                           js("Promise.resolve", { ok: true })
                       }}/>
        <p.demo-note><span id="qtransfer-log">{log}</span></p>
        <label.demo-row style="min-height: 44px"><input id="qtransfer-refuse" type="checkbox" bind:checked={refuse}/> Refuse the next transfer</label>
    </div>
}

view QuickTransferDemo() =
    <div.demo-stack>
        <QuickTransferDemoLive/>
        <div id="qtransfer-yen"><QuickTransfer people={[{ id: "k", name: "Kenji" }]} balance={50000} currency="JPY" locale="ja-JP"/></div>
    </div>

ui_gallery = ui_gallery | push({ slug: "quick_transfer", name: "QuickTransfer", group: "Mobile",
    summary: "Recent people in a row, a keypad amount checked against every limit, and a slide to send.",
    tags: ["mobile", "interactive", "banking", "keypad", "transfer", "tablet"],
    needs: ["price", "button"],
    demo: QuickTransferDemo })
