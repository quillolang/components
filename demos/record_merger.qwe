let record_merger_demo_records = [
    { source: "CRM", updated: "2026-01-10", name: "Ada Lovelace", email: "ada@old.example", phone: "", city: "London", tags: ["vip"], plan: "free" },
    { source: "Billing", updated: "2026-03-02", name: "Ada Lovelace", email: "ada@example.com", phone: "+44 20 7946 0000", city: "", tags: ["vip"], plan: "pro" },
    { source: "Sign-up", updated: "2025-11-20", name: "Ada Lovelace", email: "a.lovelace@example.org", phone: null, city: "Greater London", tags: ["vip"], plan: "free", note: "Met at the fair" },
]

component RecordMergerDemoLive() {
    state got = null
    <div.demo-stack>
        <RecordMerger id="record-merger-demo-live" title="Two versions, no dates" records={[{ sku: "B-1", price: 12.50m }, { sku: "B-1", price: 13.00m }]}
                      on_merge={(r) => { got = r }}/>
        <p.demo-note>{got == null ? "Merge to see on_merge." : `on_merge: ${got.sku} at ${got.price}.`}</p>
    </div>
}

view RecordMergerDemo() =
    <div.demo-stack>
        <RecordMerger id="record-merger-demo" records={record_merger_demo_records} label_key="source" name="merged"/>
        <RecordMerger id="record-merger-demo-one" title="One version" records={[{ a: 1 }, "not a record"]}/>
        <RecordMerger id="record-merger-demo-times" title="Times without an offset" records={[{ updated: "2026-01-02 09:30", v: "later" },
                                                                                              { updated: "soon", v: "no date" },
                                                                                              { updated: "2026-01-02T08:00:00", v: "earlier" }]}/>
        <RecordMergerDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "record_merger", name: "RecordMerger", group: "Data",
    summary: "Merges versions of a record field by field: agreed fields settle, conflicts are marked, and one click takes the newest, non-empty or longest values.",
    tags: ["smart", "interactive", "merge", "conflicts", "dedupe", "records"], demo: RecordMergerDemo })
