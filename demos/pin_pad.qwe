// As a `server fn` would answer: later. The code stays out of the page, and so out of the demo's markup.
fn pin_pad_demo_ask(code: str) = js("Promise.resolve", code == join(["2", "5", "8", "0"], ""))

component PinPadDemoLive() {
    state open = false
    state showing = true
    state told = ""
    <div.demo-stack>
        <div id="pin-pad-demo-main">
            {showing
                ? (open
                    ? <p id="pin-pad-demo-open">Unlocked. Welcome back.</p>
                    : <PinPad length={4} tries={3} lock_seconds={3} remember="pin-pad-demo"
                              check={(code) => pin_pad_demo_ask(code)}
                              on_success={() => { open = true }} on_locked={(s) => { told = `Locked for ${s} s` }}/>)
                : <p>The pad is away.</p>}
        </div>
        <p.demo-note id="pin-pad-demo-out">The code is the middle column, top to bottom. {told}</p>
        <div.demo-row>
            <Button size="lg" variant="outline" id="pin-pad-demo-again" on_click={() => { open = false; showing = !showing }}>{showing ? "Put it away" : "Bring it back"}</Button>
        </div>
    </div>
}

component PinPadDemoQuick() {
    state said = "Two digits, checked here on the spot: 4 and 2."
    <div id="pin-pad-demo-quick">
        <p.demo-note id="pin-pad-demo-quick-out">{said}</p>
        <PinPad length={2} remember={null} title="Quick code" check={(code) => code == join(["4", "2"], "")} on_success={() => { said = "Quick code right." }}/>
    </div>
}

// What a broken check does: nothing as an answer, or no answer at all.
component PinPadDemoBlank() {
    state showing = false
    <div.demo-stack>
        <Button size="lg" variant="outline" id="pin-pad-demo-nothing" on_click={() => { showing = true }}>A check that goes wrong</Button>
        <div id="pin-pad-demo-blank">
            {showing && <PinPad length={1} remember={null} title="One digit"
                                check={(code) => code == "2" ? js("Promise.reject", "offline") : js("Promise.resolve", js("window").nothing_here)}/>}
        </div>
    </div>
}

view PinPadDemo() =
    <div.demo-stack>
        <PinPadDemoLive/>
        <PinPadDemoQuick/>
        <PinPadDemoBlank/>
    </div>

ui_gallery = ui_gallery | push({ slug: "pin_pad", name: "PinPad", group: "Mobile",
    summary: "A passcode keypad with dots, a shake on a wrong entry, a lock-out with a countdown, the code never kept in the page's text.",
    tags: ["mobile", "interactive", "passcode", "keypad", "security", "lock"], needs: ["number_pad"],
    demo: PinPadDemo })
