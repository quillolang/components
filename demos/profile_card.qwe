view ProfileCardDemo() =
    <div.demo-stack>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; align-items: start">
            <ProfileCard id="profile-card-demo-ada" name="Ada Lovelace" handle="@ada" title="Analytical engineer" location="London"
                         cover_band={true} href="#profile_card" bio="Wrote the first program for a machine that was never built."
                         stats={[{ label: "Posts", value: "248" }, { label: "Followers", value: "12.4k" }, { label: "Following", value: "180" }]}>
                <Button size="sm">Follow</Button>
                <Button size="sm" variant="outline">Message</Button>
            </ProfileCard>
            <ProfileCard name="Grace Hopper" title="Rear admiral" src="https://i.pravatar.cc/144?img=47"
                         cover="https://picsum.photos/seed/sea/600/200" bio="Compilers, COBOL, and a nanosecond of wire."
                         stats={[{ label: "Talks", value: "61" }, { label: "Papers", value: "19" }]}>
                <Button size="sm" variant="soft">Follow</Button>
            </ProfileCard>
        </div>
        <ProfileCard layout="row" name="Linus Torvalds" handle="@torvalds" title="Maintainer" location="Portland, OR"
                     bio="Just for fun." stats={[{ label: "Commits", value: "32k" }, { label: "Repos", value: "6" }]}>
            <Button size="sm" variant="outline">Sponsor</Button>
        </ProfileCard>
    </div>

ui_gallery = ui_gallery | push({ slug: "profile_card", name: "ProfileCard", group: "Data",
    summary: "A person at a glance: picture, name, title, bio, a row of stats and action buttons, stacked or in a row.",
    tags: ["card", "profile", "user", "social", "no-js"],
    needs: ["avatar"],
    demo: ProfileCardDemo })
