component UnitConverterDemoLive() {
    state seen = null
    <div.demo-stack>
        <UnitConverter id="unit-converter-demo-data" title="Download size" category="data" from="gib" to="gb" value="1" name="size"
                       on_change={(c) => { seen = c }}/>
        <p.demo-note>{seen == null ? "Change it to see on_change." : `on_change: ${seen.from_value} ${seen.from_unit} is ${seen.to_value} ${seen.to_unit}.`}</p>
    </div>
}

view UnitConverterDemo() =
    <div.demo-stack>
        <UnitConverter id="unit-converter-demo" value="26.2" category="length" from="mi" to="km"/>
        <UnitConverter id="unit-converter-demo-heat" title="Oven temperature" category="temperature" from="c" to="f" value="100"/>
        <UnitConverterDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "unit_converter", name: "UnitConverter", group: "Utilities",
    summary: "Converts length, mass, volume, area, speed, temperature, data and time with exact decimal factors, either way as you type, and shows the formula.",
    tags: ["smart", "interactive", "converter", "units", "calculator", "temperature"], demo: UnitConverterDemo })
