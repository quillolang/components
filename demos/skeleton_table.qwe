view SkeletonTableDemo() =
    <div.demo-stack>
        <SkeletonTable id="skeleton-table-demo-plain"/>
        <SkeletonTable id="skeleton-table-demo-orders" rows={4} columns={5} striped={true} label="Loading orders"/>
        <SkeletonTable id="skeleton-table-demo-small" rows={3} columns={3} widths={[80, 40, 25]} header={false} size="sm"/>
    </div>

ui_gallery = ui_gallery | push({ slug: "skeleton_table", name: "SkeletonTable", group: "Feedback",
    summary: "A table of grey bars in rows and columns, with a header row, while a table's data loads.",
    tags: ["feedback", "loading", "table", "data", "no-js"],
    demo: SkeletonTableDemo })
