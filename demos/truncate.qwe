let truncate_demo_long = "A very long name for a file that will not fit in the space it is given, so it is cut.pdf"

view TruncateDemo() =
    <div.demo-stack>
        <div style="width: 260px; border: 1px dashed var(--ui-border); padding: 8px; border-radius: var(--ui-radius-sm)">
            <Truncate text={truncate_demo_long} id="truncate-demo-end"/>
        </div>
        <div style="width: 260px; border: 1px dashed var(--ui-border); padding: 8px; border-radius: var(--ui-radius-sm)">
            <Truncate text={truncate_demo_long} keep={7} id="truncate-demo-mid"/>
        </div>
        <Truncate text="Short enough to show whole" width="260px" id="truncate-demo-short"/>
        <p.demo-note>In a sentence: <Truncate text={truncate_demo_long} width="160px" id="truncate-demo-inline"/> was uploaded.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "truncate", name: "Truncate", group: "Typography",
    summary: "Text kept to one line and cut with an ellipsis at the end or the middle, with the whole text in its title.",
    tags: ["typography", "text", "layout", "no-js"],
    demo: TruncateDemo })
