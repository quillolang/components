let csv_importer_demo_fields = [
    { key: "name", label: "Name", required: true, aliases: ["full name"] },
    { key: "email", label: "Email", type: "email", required: true },
    { key: "joined", label: "Joined", type: "date", format: "DD/MM/YYYY" },
    { key: "plan", label: "Plan", type: "enum", options: ["free", "pro"] },
    { key: "balance", label: "Balance", type: "money" },
    { key: "seats", label: "Seats", type: "integer" },
    { key: "active", label: "Active", type: "boolean" },
]

let csv_importer_demo_text = "Full Name;E-mail;Joined;Plan;Balance;Seats;Active\n\"Lovelace; Ada\";ada@example.com;2026-03-14;PRO;\"$1,234.50\";3;yes\nGrace Hopper;grace@example;2026-02-30;team;12.345;x;maybe\nAlan Turing;alan@example.com;23/06/2026;free;0.10;1;no\n;nobody@example.com;;;;;\n"

component CsvImporterDemoLive() {
    state got = null
    <div.demo-stack>
        <CsvImporter id="csv-importer-demo-live" title="Import people" fields={csv_importer_demo_fields}
                     text={"name,email\nAda,ada@example.com\nGrace,grace@example.com\nbad,nope\n"}
                     on_import={(rows) => { got = rows }}/>
        <p.demo-note>{got == null ? "Import to see on_import." : `on_import: ${len(got)} rows, the first ${got[0].name} <${got[0].email}>.`}</p>
    </div>
}

view CsvImporterDemo() =
    <div.demo-stack>
        <CsvImporter id="csv-importer-demo" fields={csv_importer_demo_fields} text={csv_importer_demo_text} name="people"/>
        <CsvImporterDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "csv_importer", name: "CsvImporter", group: "Data",
    summary: "Takes pasted or dropped CSV: detects the delimiter, quotes and header, guesses the column for each field, checks every row and lists the bad ones with the reason.",
    tags: ["smart", "interactive", "csv", "import", "upload", "validation"], demo: CsvImporterDemo })
