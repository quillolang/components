// A season of mornings: a slow slide with a scale's usual noise, and a fortnight's holiday.
let weight_trend_demo_noise = [0.4, -0.3, 0.1, 0.6, -0.5, 0.2, -0.1, 0.5, -0.4, 0.0, 0.3, -0.6]
let weight_trend_demo_days = range(0, 75) | filter((i) => i % 7 != 5 && (i < 38 || i > 52))
let weight_trend_demo_season = for i in weight_trend_demo_days => {
    date: date.add_days("2026-08-17", i), weight: round(82.4 - i * 0.045 + weight_trend_demo_noise[i % 12], 1),
}

// Small enough to work by hand.
let weight_trend_demo_exact = [
    { date: "2026-09-01", weight: 80 }, { date: "2026-09-02", weight: 81 }, { date: "2026-09-04", weight: 79 },
    { date: "2026-09-05", weight: 80 }, { date: "2026-09-05", weight: 81 }, { date: "2026-09-17", weight: 78 },
    { date: "2026-09-18", weight: 79 }, { date: "bad", weight: 79 }, { date: "2026-09-19", weight: "heavy" }, null, { date: "2026-09-20", weight: -3 },
]

component WeightTrendDemoLive() {
    state said = "Nothing chosen."
    state unit = "kg"
    state stir = 0
    <div.demo-stack>
        <div id="weight-trend-exact"><WeightTrend title="Worked by hand" entries={weight_trend_demo_exact | map((e) => type_of(e) == "map" ? { ...e, stir } : e)} goal={76}
            on_select={(i) => { said = i == null ? "Cleared." : `${i.date} ${i.weight} ${i.trend}` }} on_unit={(u) => { unit = u }}/></div>
        <p.demo-note id="weight-trend-said">{said}</p>
        <p.demo-note id="weight-trend-unit">{unit}</p>
        <div.demo-row><Button id="weight-trend-stir" size="lg" variant="soft" on_click={() => { stir += 1 }}>New data arrives</Button></div>
    </div>
}

view WeightTrendDemo() =
    <div.demo-stack>
        <WeightTrendDemoLive/>
        <div id="weight-trend-season"><WeightTrend title="This autumn" entries={weight_trend_demo_season} goal={78}/></div>
        <div id="weight-trend-lb"><WeightTrend title="Pounds in, pounds shown" unit="lb" goal={165} entries={[{ date: "2026-10-01", weight: 176.4 }]}/></div>
        <div id="weight-trend-none"><WeightTrend title="Nothing yet" entries={[]} show="stone"/></div>
    </div>

ui_gallery = ui_gallery | push({ slug: "weight_trend", name: "WeightTrend", group: "Mobile",
    summary: "A smoothed trend over noisy weigh-ins, in kg or lb, with a goal line, read by finger, and holes left as holes.",
    tags: ["mobile", "interactive", "health", "chart", "gesture", "tablet"],
    demo: WeightTrendDemo })
