let series_nav_demo_parts = [
    { title: "Routes and pages", href: "#series_nav-1" },
    { title: "A database of posts", href: "#series_nav-2" },
    { title: "Comments that resume in the browser", href: "#series_nav-3" },
    { title: "Feeds, sitemaps and search", href: "#series_nav-4" },
    { title: "Deploying it on a small server", soon: "Nov 12" },
]

view SeriesNavDemo() =
    <div.demo-stack>
        <SeriesNav id="series-nav-demo" title="Building a blog in Quillo" href="#series_nav" current={2} parts={series_nav_demo_parts}/>
        <SeriesNav id="series-nav-demo-end" title="Building a blog in Quillo" current={4} position="bottom" open={true}
                   parts={series_nav_demo_parts}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "series_nav", name: "SeriesNav", group: "Blogging",
    summary: "Where a post stands in a series: Part 2 of 5, a bar of the parts, the list of them all with this one marked, and the parts before and after.",
    tags: ["blogging", "navigation", "series", "list", "no-js"], demo: SeriesNavDemo })
