component NetworkStatusDemoLive() {
    state plan = "Nothing yet."
    state changes = 0
    <div.demo-stack>
        <NetworkStatus on_change={(n) => {
            changes += 1
            plan = `slow ${n.slow == null ? "unknown" : n.slow}, images ${n.plan.images}, video ${n.plan.video}, prefetch ${n.plan.prefetch}`
        }}/>
        <p.demo-note id="network-status-demo-note">{plan}</p>
        <div.demo-row><span.demo-note>In a header:</span><NetworkStatus compact={true}/></div>
    </div>
}

view NetworkStatusDemo() = <NetworkStatusDemoLive/>

ui_gallery = ui_gallery | push({ slug: "network_status", name: "NetworkStatus", group: "Mobile",
    summary: "Connection type, offline and save-data, with a reading of whether the link is slow, updated live, and a stated limit where the phone does not say.",
    tags: ["mobile", "interactive", "network", "offline", "save-data"],
    demo: NetworkStatusDemo })
