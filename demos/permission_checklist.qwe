component PermissionChecklistDemoLive() {
    state run = 0
    state said = "Nothing yet."
    <div.demo-stack>
        <PermissionChecklist key={run}
            items={[
                { kind: "camera", reason: "To photograph a page into your notes." },
                { kind: "microphone", reason: "To keep a voice memo with a note." },
                { kind: "location", reason: "To keep the place with a note. Never in the background.", required: true },
                { kind: "notifications", reason: "Only for a reminder you set yourself." },
                { kind: "motion", reason: "To point the compass on the map." },
                { kind: "telepathy", reason: "A kind this device does not have." },
            ]}
            on_change={(s) => { said = keys(s) | sort() | map((k) => `${k}: ${get(s, k)}`) | join(", ") }}
            on_done={(s) => { said = `Done with ${get(s, "location")} location.` }}/>
        <Button size="lg" variant="ghost" id="permission-checklist-demo-again" on_click={() => { run = run + 1 }}>Start over</Button>
        <p.demo-note id="permission-checklist-demo-said">{said}</p>
    </div>
}

view PermissionChecklistDemo() = <PermissionChecklistDemoLive/>

ui_gallery = ui_gallery | push({ slug: "permission_checklist", name: "PermissionChecklist", group: "Mobile",
    summary: "Camera, location, notifications and the like, each with its reason, a live state, and a route to Settings.",
    tags: ["mobile", "interactive", "tablet", "permissions", "onboarding", "device"],
    demo: PermissionChecklistDemo })
