view CheckListDemo() =
    <div.demo-stack>
        <div.demo-row style="align-items: flex-start; gap: 40px">
            <CheckList id="check-list-demo-plan" items={[
                { text: "Unlimited projects", done: true },
                { text: "Priority support", done: true },
                { text: "Phone support", done: false },
                { text: "Single sign-on", done: false },
            ]}/>
            <CheckList id="check-list-demo-steps" undone="empty" strike={true} summary={true} items={[
                { text: "Create an account", done: true },
                { text: "Verify your email", done: true },
                { text: "Add a payment method", done: false },
            ]}/>
            <CheckList size="sm" items={[{ text: "Small", done: true }, { text: "Also small", done: false }]}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "check_list", name: "CheckList", group: "Typography",
    summary: "Items shown done or not with ticks and crosses (or empty circles), read-only, with an optional count.",
    tags: ["typography", "list", "status", "no-js"],
    demo: CheckListDemo })
