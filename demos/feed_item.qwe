component FeedItemDemoLive() {
    state liked = false
    state likes = 128
    state last = "Nothing yet."
    <div.demo-stack>
        <div style="border: 1px solid var(--ui-border); border-radius: var(--ui-radius); overflow: hidden">
        <FeedItem id="feed-item-demo-live" name="Ada Lovelace" handle="@ada" time="2h" datetime="2026-10-28T09:00:00Z" href="#feed_item" verified={true}
                  text="The first program is written.\nThe machine is not even built yet." media="https://picsum.photos/seed/engine/800/400"
                  likes={likes} comments={12} shares={4} liked={liked}
                  on_like={() => { liked = !liked; likes = liked ? likes + 1 : likes - 1; last = liked ? "Liked." : "Unliked." }}
                  on_comment={() => { last = "Comment box opened." }}
                  on_share={() => { last = "Share sheet opened." }}/>
            <FeedItem id="feed-item-demo-plain" name="Grace Hopper" handle="@grace" src="https://i.pravatar.cc/80?img=47" time="Yesterday"
                      text="A nanosecond is 30 cm of wire. Keep one on your desk." likes={64} comments={3}/>
            <FeedItem name="Alan Turing" time="Oct 20" text="Can machines think?">
                <div style="padding: 12px 14px; font-size: 14px; color: var(--ui-muted)">A quoted post, as children.</div>
            </FeedItem>
        </div>
        <p.demo-note>{last}</p>
    </div>
}

view FeedItemDemo() =
    <div.demo-stack>
        <FeedItemDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "feed_item", name: "FeedItem", group: "Data",
    summary: "A social-feed item: avatar, name, handle, time, text, a picture or any media, and like, comment and share buttons with counts.",
    tags: ["social", "card", "user", "comment", "no-js"],
    needs: ["avatar"],
    demo: FeedItemDemo })
