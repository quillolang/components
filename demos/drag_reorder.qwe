let drag_reorder_demo_stops = [
    { id: 1, title: "Depot", subtitle: "Load by 7:30" }, { id: 2, title: "Harbour Street", subtitle: "3 parcels" },
    { id: 3, title: "Mill Lane", subtitle: "1 parcel, signature" }, { id: 4, title: "Station Road", subtitle: "2 parcels" },
    { id: 5, title: "Oak Avenue", subtitle: "5 parcels" }, { id: 6, title: "Bridge Court", subtitle: "1 parcel" },
    { id: 7, title: "Quarry Hill", subtitle: "2 parcels, steep drive" }, { id: 8, title: "Park View", subtitle: "4 parcels" },
    { id: 9, title: "Church Close", subtitle: "1 parcel" }, { id: 10, title: "Market Square", subtitle: "6 parcels" },
    { id: 11, title: "Willow Way", subtitle: "2 parcels" }, { id: 12, title: "Depot return", subtitle: "By 16:00" },
]

component DragReorderDemoLive() {
    state order = "Not changed yet."
    <div.demo-stack>
        <DragReorder items={drag_reorder_demo_stops} max_height="390px" label="Delivery stops" on_reorder={(ids) => { order = join(ids, " ") }}/>
        <p.demo-note id="drag-reorder-order">{order}</p>
        // Bad data, for the test to look at: nothing here should stop the page.
        <div id="drag-reorder-bad" hidden="true"><DragReorder items={[null, { id: 1 }, { id: 2, title: "Two" }, { id: 2, title: "Again" }, { title: "No id" }]}/><DragReorder items="none"/></div>
    </div>
}

view DragReorderDemo() = <DragReorderDemoLive/>

ui_gallery = ui_gallery | push({ slug: "drag_reorder", name: "DragReorder", group: "Mobile",
    summary: "Put a list in order by long press and drag, scrolling at its edges, and by keys or buttons too.",
    tags: ["mobile", "interactive", "gesture", "reorder", "list", "tablet"],
    demo: DragReorderDemo })
