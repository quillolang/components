view MemberCardDemo() =
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 12px">
        <MemberCard id="member-card-demo-active" name="Lourdes Villanueva" number="M-004217" since="2014-03-04" share_capital={18500}
                    currency="PHP" coop="Bayanihan Multi-Purpose Cooperative" kind="Regular member" href="#member-4217"/>
        <MemberCard id="member-card-demo-dormant" name="Tomas de la Cruz Reyes" number="M-010388" since="2019-07-15" share_capital={2500.5}
                    currency="PHP" status="dormant" kind="Associate member" note="No transaction since Jan 2025"/>
        <MemberCard id="member-card-demo-usd" name="Harriet Okafor" number="CU-88213" since="2008-11-20" share_capital="$5.00 (1 share)"
                    coop="Lakeshore Teachers Credit Union" status="suspended"/>
    </div>

ui_gallery = ui_gallery | push({ slug: "member_card", name: "MemberCard", group: "Finance",
    summary: "A co-op or credit union member's card: photo or initials, name and number, member since, share capital and status.",
    tags: ["finance", "coop", "card", "user", "no-js"], demo: MemberCardDemo })
