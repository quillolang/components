component SlotFinderDemoLive() {
    state picked = null
    <div.demo-stack>
        <SlotFinder id="slot-finder-demo" from="2026-11-02" to="2026-11-03" zone="Europe/Lisbon" minutes={60} people={[
            { name: "Ana", busy: ["2026-11-02 09:00-12:00", "2026-11-02 13:00-17:00", { start: "2026-11-03T09:00:00Z", end: "2026-11-03T10:00:00Z" }] },
            { name: "Ben", zone: "America/New_York", busy: ["2026-11-03 06:00-08:00"] },
            { name: "Cara", zone: "Asia/Kolkata", busy: ["2026-11-03 18:30-20:30"] }]} on_pick={(s) => { picked = s }}/>
        <p.demo-note>{picked == null ? "Choose a slot to see on_pick." : `on_pick: ${picked.start} to ${picked.end}, ${len(picked.busy)} affected.`}</p>
    </div>
}

view SlotFinderDemo() =
    <div.demo-stack>
        <SlotFinderDemoLive/>
        <SlotFinder id="slot-finder-demo-dst" title="Over a clock change" from="2026-03-29" to="2026-03-29" zone="Europe/Paris" day_start="00:00" day_end="06:00" minutes={60} weekends={true} name="dst"
                    people={[{ name: "Dee", busy: ["2026-03-29 00:30-01:30"] }, { name: "Eli", busy: ["bad line", { start: "x", end: "y" }, "2026-03-30 25:00-26:00"], zone: "Mars/Base" }]}/>
        <SlotFinder id="slot-finder-demo-bad" title="A zone nobody has" name="bad" from="2026-11-02" to="2026-11-02" zone="Mars/Base" people={[{ name: "Fay", busy: ["2026-11-02 10:00-11:00"] }]}/>
        <SlotFinder id="slot-finder-demo-offset" title="An offset for a zone" name="offset" from="2026-11-02" to="2026-11-02" zone="+05:30" people={[{ name: "Gus", busy: ["2026-11-02 12:00-17:00"] }, "Hal"]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "slot_finder", name: "SlotFinder", group: "Scheduling",
    summary: "Finds common free slots from several people's busy lists, in working hours in a chosen time zone, ranking the closest by who is affected when none suits all.",
    tags: ["smart", "interactive", "meetings", "calendar", "availability", "timezone"], needs: ["timezone_picker"], demo: SlotFinderDemo })
