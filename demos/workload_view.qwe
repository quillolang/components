let workload_view_demo_people = [
    { id: "ana", name: "Ana", capacity: 40, skills: ["go", "sql"] },
    { id: "ben", name: "Ben", capacity: 40, skills: ["go"] },
    { id: "cara", name: "Cara", capacity: 32, skills: ["design"], weeks: { "2026-11-09": 16 } }]

let workload_view_demo_items = [
    { id: "api", title: "API", person: "ana", week: "2026-11-02", hours: 30, skill: "go" },
    { id: "db", title: "Migration", person: "ana", week: "2026-11-02", hours: 16, skill: "sql" },
    { id: "tests", title: "Tests", person: "ana", week: "2026-11-02", hours: 7.5, skill: "go" },
    { id: "bugs", title: "Bug fixes", person: "ben", week: "2026-11-02", hours: 12, skill: "go" },
    { id: "brand", title: "Brand", person: "cara", week: "2026-11-02", hours: 30, skill: "design" },
    { id: "site", title: "Site", person: "cara", week: "2026-11-09", hours: 20, skill: "design" },
    { id: "ops", title: "On call", person: "ben", week: "2026-11-09", hours: 38.5 }]

component WorkloadViewDemoLive() {
    state moved = null
    <div.demo-stack>
        <WorkloadView id="workload-view-demo" weeks={["2026-11-02", "2026-11-09"]} people={workload_view_demo_people} assignments={workload_view_demo_items}
                      on_move={(c) => { moved = c }}/>
        <p.demo-note>{moved == null ? "Apply a suggestion to see on_move." : `on_move: ${moved.title}, ${moved.hours} h, ${moved.from} to ${moved.to}, week of ${moved.week}.`}</p>
    </div>
}

view WorkloadViewDemo() =
    <div.demo-stack>
        <WorkloadViewDemoLive/>
        <WorkloadView id="workload-view-demo-bad" title="Awkward data" weeks={["w1"]} people={[{ id: "a", capacity: 0 }, "not a person", { id: "b", capacity: 10 }]}
                      assignments={[{ id: "x", person: "a", week: "w1", hours: 5 }, { id: "x", person: "a", week: "w1", hours: 5 }, { id: "y", person: "z", week: "w1", hours: 1 },
                                    { id: "n", person: "a", week: "w9", hours: 1 }, { id: "q", person: "b", week: "w1", hours: "lots" }, "junk"]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "workload_view", name: "WorkloadView", group: "Scheduling",
    summary: "People by weeks with their assignments: marks who is over or under allocated, and suggests which assignment to move to whom, keeping skills.",
    tags: ["smart", "interactive", "capacity", "team", "planning", "resources"], demo: WorkloadViewDemo })
