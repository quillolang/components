component ScrollProgressDemoLive() {
    state at = 0
    <div.demo-stack>
        <div id="scroll-progress-demo-box" tabindex="0" aria-label="A long article"
             style="height: 220px; overflow: auto; border: 1px solid var(--ui-border); border-radius: var(--ui-radius)">
            <ScrollProgress scroller="scroll-progress-demo-box" height={4} tone="success" label="Article progress" on_change={(p) => { at = p }}/>
            <div style="padding: 4px 18px">
                {for i in range(1, 16) => <p key={i}>Paragraph {i} of a long article. Scroll this box: the green bar on its top edge fills as you go.</p>}
            </div>
        </div>
        <p.demo-note>Read {at}% of the box.</p>
    </div>
}

view ScrollProgressDemo() =
    <div.demo-stack>
        <ScrollProgressDemoLive/>
        <ScrollProgress/>
        <p.demo-note>The page has one too: the thin bar along the top of the window, filling as this page is scrolled.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "scroll_progress", name: "ScrollProgress", group: "Utilities",
    summary: "A thin bar along the top of the window, or of a scrolling box, that fills as it is scrolled.",
    tags: ["utility", "progress", "page", "interactive"],
    demo: ScrollProgressDemo })
