view EyebrowDemo() =
    <div.demo-stack>
        <div>
            <Eyebrow id="eyebrow-demo-new">New in 0.9</Eyebrow>
            <Heading level={2} id="eyebrow-demo-title">Live queries</Heading>
        </div>
        <div>
            <Eyebrow tone="accent" dot={true} id="eyebrow-demo-beta">Beta</Eyebrow>
            <Heading level={3}>Channels over WebTransport</Heading>
        </div>
        <div.demo-row>
            <Eyebrow tag="span" tone="success" dot={true}>Shipped</Eyebrow>
            <Eyebrow tag="span" tone="warning" dot={true}>In review</Eyebrow>
            <Eyebrow tag="span" tone="danger" dot={true}>Blocked</Eyebrow>
            <Eyebrow tag="span" tone="info">Guide</Eyebrow>
        </div>
        <div>
            <Eyebrow align="center" id="eyebrow-demo-center">Pricing</Eyebrow>
            <Heading level={2} align="center">Plans for every team</Heading>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "eyebrow", name: "Eyebrow", group: "Typography",
    summary: "A small uppercase label above a heading, in a tone, with an optional dot.",
    tags: ["typography", "text", "marketing", "no-js"],
    demo: EyebrowDemo })
