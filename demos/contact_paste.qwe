let contact_paste_demo_text = "Best regards,

Jane Doe
Head of Sales | Acme Robotics Inc.
+1 (415) 555-0132 | jane.doe@acmerobotics.com
www.acmerobotics.com
123 Market St, Suite 400
San Francisco, CA 94105"

component ContactPasteDemoLive() {
    state got = null
    <div.demo-stack>
        <ContactPaste id="contact-paste-demo-live" prefix="lead_" on_change={(c) => { got = c }}/>
        <p.demo-note>{got == null ? "Paste something to see on_change." : `on_change: ${got.name} / ${got.email}`}</p>
    </div>
}

view ContactPasteDemo() =
    <div.demo-stack>
        <form>
            <ContactPaste id="contact-paste-demo" text={contact_paste_demo_text}/>
        </form>
        <ContactPasteDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "contact_paste", name: "ContactPaste", group: "Forms",
    summary: "Paste an email signature or a blurb: it pulls out the name, email, phone, website, company and address into editable fields, marks how sure each guess is, and never overwrites an edit.",
    tags: ["smart", "interactive", "contact", "parser", "paste", "forms"], needs: ["slug_input"], demo: ContactPasteDemo })
