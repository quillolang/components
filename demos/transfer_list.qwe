let transfer_list_demo_perms = [
    { label: "Read posts", value: "posts.read" }, { label: "Write posts", value: "posts.write" },
    { label: "Delete posts", value: "posts.delete" }, { label: "Read comments", value: "comments.read" },
    { label: "Moderate comments", value: "comments.moderate" }, { label: "Manage users", value: "users.manage" },
    { label: "Invite users", value: "users.invite" }, { label: "View billing", value: "billing.read" },
    { label: "Change billing", value: "billing.write" }, { label: "Export data", value: "data.export" },
    { label: "View audit log", value: "audit.read" }, { label: "Manage API keys", value: "keys.manage" },
]

component TransferListDemoLive() {
    state cols = ["Name", "Email"]
    <div.demo-stack>
        <TransferList id="tl-cols" label="Columns to show" available_label="Hidden" chosen_label="Shown"
                      search={false} height="170px" value={cols}
                      options={["Name", "Email", "Company", "Plan", "Signed up", "Last seen", "Country"]}
                      on_change={(vs) => { cols = vs }}/>
        <p.demo-note>Showing: {join(cols, ", ")}</p>
    </div>
}

view TransferListDemo() =
    <div.demo-stack>
        <TransferList id="tl-perms" name="permissions" label="Editor role permissions" options={transfer_list_demo_perms}
                      value={["posts.read", "posts.write", "comments.read"]}
                      hint="Select with a click, Space or Shift; move with the buttons, Enter or a double click."/>
        <TransferListDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "transfer_list", name: "TransferList", group: "Forms",
    summary: "Two filterable lists to move options between, several at a time, by mouse or keyboard.",
    demo: TransferListDemo })
