let team_balancer_demo_people = "Ada, 9\nBo, 8.5\nCy, 7\nDi, 6\nEd, 6\nFlo, 5\nGus, 4\nHal, 3\nIvy, 2"

component TeamBalancerDemoLive() {
    state seen = null
    <div.demo-stack>
        <TeamBalancer id="team-balancer-demo-six" title="Six players" name="squad" team_names={["Reds", "Blues"]}
                      people={[{ name: "Ann", rating: 6 }, { name: "Ben", rating: 5 }, { name: "Cal", rating: 4 }, { name: "Dee", rating: 3 }, { name: "Eli", rating: 2 }, { name: "Fay", rating: 1 }]}
                      together={[["Ann", "Fay"]]} on_change={(r) => { seen = r }}/>
        <p.demo-note>{seen == null ? "Change it to see on_change." : seen.ok ? `on_change: a spread of ${str(seen.spread)}.` : "on_change: no split."}</p>
    </div>
}

view TeamBalancerDemo() =
    <div.demo-stack>
        <TeamBalancer id="team-balancer-demo" title="Saturday five-a-side" people={team_balancer_demo_people} teams={3} together="Ada, Ivy" apart="Bo, Cy"/>
        <TeamBalancerDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "team_balancer", name: "TeamBalancer", group: "Social",
    summary: "Splits people into teams balanced by rating, with keep-together and keep-apart rules, shows each total and the spread, and says when the rules cannot be met.",
    tags: ["smart", "interactive", "teams", "groups", "games", "balance"], demo: TeamBalancerDemo })
