component ThemeToggleDemoLive() {
    state t = "system"
    <div.demo-row>
        <ThemeToggle on_change={(v) => { t = v }}/>
        <span.demo-note>Theme: {t}. It changes this whole page.</span>
    </div>
}

view ThemeToggleDemo() =
    <div.demo-stack>
        <ThemeToggleDemoLive/>
        <div.demo-row>
            <ThemeToggle variant="button"/>
            <ThemeToggle size="sm" light="Day" dark="Night" system="Auto"/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "theme_toggle", name: "ThemeToggle", group: "Actions",
    summary: "Light, dark or system, set on <html> for the whole page and remembered in the browser.",
    tags: ["button", "theme", "settings", "interactive"],
    demo: ThemeToggleDemo })
