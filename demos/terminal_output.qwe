view TerminalOutputDemo() =
    <div.demo-stack>
        <TerminalOutput id="terminal-output-demo-run" title="~/app — zsh" lines={[
            { note: "start the app and watch for changes" },
            { cmd: "quillo run app.qwe --watch" },
            { out: "quillo: 3 routes listening on http://127.0.0.1:8080" },
            { cmd: "curl -s localhost:8080/health" },
            { ok: "ok" },
            { cmd: "curl -s localhost:8080/missing" },
            { err: "404 not found" },
        ]}/>
        <TerminalOutput id="terminal-output-demo-text" theme="system" prompt="%" errors={["No such file"]} max_height="160px"
                        label="Listing files" text={"% ls\nREADME.md  app.qwe  public\n% cat notes.txt\ncat: notes.txt: No such file or directory\n% echo done\ndone"}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "terminal_output", name: "TerminalOutput", group: "Data",
    summary: "A terminal-like window with a title, commands after a prompt and their output, errors in red, for docs and tutorials.",
    tags: ["data", "code", "document", "no-js"], demo: TerminalOutputDemo })
