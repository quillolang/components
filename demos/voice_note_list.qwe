// Silence, as WAV: four and eight seconds, so a test can really play it.
let voice_note_list_demo_short = "data:audio/wav;base64,UklGRqQ+AABXQVZFZm10IBAAAAABAAEAoA8AAKAPAAABAAgAZGF0YYA+AACA" + repeat("gICA", 5333)
let voice_note_list_demo_long = "data:audio/wav;base64,UklGRiZ9AABXQVZFZm10IBAAAAABAAEAoA8AAKAPAAABAAgAZGF0YQJ9AACA" + repeat("gICA", 10667)

component VoiceNoteListDemoLive() {
    state notes = [
        { id: 1, title: "Standup ideas", src: voice_note_list_demo_short, seconds: 4, at: "2026-11-01T09:12:00Z",
          transcript: [{ at: 2, text: "The build is green." }, { at: 0, text: "Morning, everyone." }] },
        { id: 2, src: voice_note_list_demo_long, seconds: 9, at: "2026-10-31T18:05:00Z" },
        { id: 3, title: "Old memo", src: "data:audio/wav;base64,AAAA", seconds: 65, at: "2026-03-04T08:00:00Z", transcript: "Remember the keys." },
        { id: 4, title: "Lost file", seconds: 3725, at: "2025-12-24T08:00:00Z" },
    ]
    state tries = 0
    state log = ""
    <div.demo-stack>
        <VoiceNoteList notes={notes} today="2026-11-01" speeds={[1, 1.5, 2]}
                       on_play={(id) => { log = `play ${id}` }} on_rename={(id, t) => { log = `rename ${id} ${t}` }}
                       on_transcribe={(id) => {
                           tries += 1
                           tries == 1 ? false : true
                       }}/>
        <p.demo-note id="voice-notes-log">{log}</p>
        <button id="voice-notes-deliver" type="button" hidden="true"
                @click={() => { notes = notes | map((n) => n.id == 2 ? { ...n, transcript: "Buy stamps on the way home." } : n) }}>Transcript arrives</button>
        <div id="voice-notes-bad" hidden="true"><VoiceNoteList/><VoiceNoteList notes={[null, 5, { id: 1 }, { id: 1, title: "Again" }, { title: "No id", seconds: "long", at: "yesterday", transcript: [null, { at: "x" }] }]} speeds="fast" today="never"/></div>
    </div>
}

view VoiceNoteListDemo() = <div.demo-stack><VoiceNoteListDemoLive/></div>

ui_gallery = ui_gallery | push({ slug: "voice_note_list", name: "VoiceNoteList", group: "Mobile",
    summary: "Recordings with titles, duration, a scrub bar for the finger, and a place for the transcript.",
    tags: ["mobile", "interactive", "audio", "notes", "gesture", "tablet"],
    demo: VoiceNoteListDemo })
