let headline_analyzer_demo_variants = ["5 Simple Ways to Write Better Headlines Today", "Some Things You Might Want To Know", "Why the City Council Finally Approved the New Bicycle Lanes on Main Street After Years of Arguing Over Parking"]

component HeadlineAnalyzerDemoLive() {
    state best = null
    <div.demo-stack>
        <HeadlineAnalyzer id="headline-analyzer-demo-live" name="title" value="Tea cools fast" on_change={(r) => { best = r.best }}/>
        <p.demo-note>{best == null ? "Change the headline to see on_change." : `on_change: the best is "${best}".`}</p>
    </div>
}

view HeadlineAnalyzerDemo() =
    <div.demo-stack>
        <HeadlineAnalyzer id="headline-analyzer-demo" variants={headline_analyzer_demo_variants}/>
        <HeadlineAnalyzerDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "headline_analyzer", name: "HeadlineAnalyzer", group: "News",
    summary: "Scores headlines for length, word balance, numbers, power and weak words, shows where search and phones cut them, and compares variants side by side.",
    tags: ["smart", "interactive", "headline", "seo", "news", "compare"], needs: ["readability_meter"], demo: HeadlineAnalyzerDemo })
