component KeyboardShortcutsDemoLive() {
    state log = []
    let did = (what: str) => { log = take(push(log, what) | reverse, 4) | reverse }
    <div.demo-stack>
        <KeyboardShortcuts show={true} bindings={[
            { keys: "mod+s, mod+Enter", label: "Save", run: () => { did("saved") } },
            { keys: "alt+n", label: "New item", run: () => { did("new item") } },
            { keys: "?", label: "Show help", run: () => { did("help") } },
            { keys: "Escape", label: "Close", run: () => { did("closed") }, in_fields: true },
            { keys: "g", run: () => { did("g") } },
        ]}/>
        <TextField name="kbsc_try" label="A text box: shortcuts other than Escape are left alone in it" placeholder="Type here"/>
        <p.demo-note>Last done: {len(log) == 0 ? "nothing yet; press one of the keys above" : join(log, ", ")}.</p>
    </div>
}

view KeyboardShortcutsDemo() =
    <div.demo-stack>
        <KeyboardShortcutsDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "keyboard_shortcuts", name: "KeyboardShortcuts", group: "Utilities",
    summary: "Binds key combinations such as ⌘S or ? to functions on the page, leaving text boxes alone, and lists them.",
    tags: ["utility", "keyboard", "accessibility", "interactive"],
    demo: KeyboardShortcutsDemo })
