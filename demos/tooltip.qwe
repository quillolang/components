view TooltipDemo() =
    <div.demo-stack>
        <p.demo-note>Hover over them, or Tab to them.</p>
        <div.demo-row>
            <Tooltip text="Opens above"><Button variant="outline">Top</Button></Tooltip>
            <Tooltip text="Opens below" placement="bottom"><Button variant="outline">Bottom</Button></Tooltip>
            <Tooltip text="Opens to the left" placement="left"><Button variant="outline">Left</Button></Tooltip>
            <Tooltip text="Opens to the right" placement="right"><Button variant="outline">Right</Button></Tooltip>
            <Tooltip text="Copy the link to this page" placement="bottom">
                <Button variant="ghost" label="Copy link">⧉</Button>
            </Tooltip>
        </div>
        <p.demo-note>Last edited <Tooltip text="27 October 2026, 14:02 UTC"><span tabindex="0"
            style="text-decoration: underline dotted; cursor: help">2 hours ago</span></Tooltip> by Ada.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "tooltip", name: "Tooltip", group: "Feedback",
    summary: "A short note shown while something is hovered or focused, in CSS alone, on any of its four sides.",
    tags: ["overlay", "popover", "no-js"],
    demo: TooltipDemo })
