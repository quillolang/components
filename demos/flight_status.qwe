view FlightStatusDemo() =
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 12px; align-items: start">
        <FlightStatus id="flight-status-demo-late" flight="TP 1351" airline="TAP Air Portugal" date="2026-11-05" status="scheduled"
                      from={{ code: "LHR", city: "London", terminal: "2", gate: "B42", gate_was: "B36" }} to={{ code: "LIS", city: "Lisbon", terminal: "1" }}
                      departs="07:45" departs_new="08:30" arrives="10:20" arrives_new="11:05" updated="Updated 06:58 local time"/>
        <FlightStatus id="flight-status-demo-air" flight="QA 88" airline="Quillo Air" status="in_air" progress={62}
                      from={{ code: "OPO", city: "Porto", terminal: "1", gate: "12" }} to={{ code: "FRA", city: "Frankfurt", terminal: "1", belt: "14" }}
                      departs="22:30" departs_new="22:41" arrives="02:05" arrives_new="01:52" arrive_days={1}/>
        <FlightStatus id="flight-status-demo-off" flight="NW 512" airline="Nordic Wings" status="cancelled"
                      from={{ code: "CPH", city: "Copenhagen" }} to={{ code: "LHR", city: "London" }} departs="18:05" arrives="19:00"
                      note="Rebooked on NW 516 tomorrow at 07:10. Your new boarding pass is in the app."/>
        <FlightStatus id="flight-status-demo-ok" flight="DA 4" status="boarding" from={{ code: "LHR", terminal: "4", gate: "10" }}
                      to={{ code: "DXB", terminal: "3" }} departs="07:30" arrives="18:25"/>
    </div>

ui_gallery = ui_gallery | push({ slug: "flight_status", name: "FlightStatus", group: "Travel",
    summary: "A flight's status today: on time, delayed, boarding, in the air or cancelled, with the new times beside the old, gate changes and the baggage belt.",
    tags: ["travel", "flights", "status", "card", "no-js"], demo: FlightStatusDemo })
