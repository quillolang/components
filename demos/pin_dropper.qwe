component PinDropperDemoLive() {
    state spot = "none yet"
    state rest = "none yet"
    state start = [38.7139, -9.1394]
    state shown = true
    <div.demo-stack>
        <div.demo-phone>
            {shown && <PinDropper center={start} zoom={16} name="pin-dropper-demo" on_pick={(lat, lng) => { spot = `${lat}, ${lng}` }} on_move={(lat, lng) => { rest = `${lat}, ${lng}` }}/>}
        </div>
        <div.demo-row>
            <button.pin-dropper-demo-porto type="button" style="min-height: 44px" @click={() => { start = [41.1496, -8.6110] }}>Go to Porto</button>
            <button.pin-dropper-demo-toggle type="button" style="min-height: 44px" @click={() => { shown = !shown }}>Take it away, or bring it back</button>
            <span.demo-note>on_pick: <span class="pin-dropper-demo-spot">{spot}</span>. on_move: <span class="pin-dropper-demo-rest">{rest}</span>.</span>
        </div>
    </div>
}

view PinDropperDemo() = <PinDropperDemoLive/>

ui_gallery = ui_gallery | push({ slug: "pin_dropper", name: "PinDropper", group: "Mobile",
    summary: "A fixed centre pin with the map moving under it: gives the coordinates and calls on_pick, with arrow keys and buttons as equals of the drag.",
    tags: ["mobile", "interactive", "tablet", "map", "location", "gesture"], demo: PinDropperDemo })
