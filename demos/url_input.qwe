component UrlInputDemoLive() {
    state url = null
    <div.demo-stack>
        <UrlInput name="ui-demo-site" label="Website" protocol="https://" placeholder="example.com" on_change={(u) => { url = u }}/>
        <p.demo-note>{url == null ? "No address yet." : `The form sends ${url}.`}</p>
    </div>
}

view UrlInputDemo() {
    <div.demo-stack.demo-narrow>
        <UrlInputDemoLive/>
        <UrlInput name="ui-demo-link" label="Link" value="https://quillolang.org" hint="The whole address, scheme first."/>
        <UrlInput name="ui-demo-repo" label="Repository" protocol="https://github.com/" placeholder="owner/repo" size="sm"
                  error="That repository does not exist."/>
    </div>
}

ui_gallery = ui_gallery | push({ slug: "url_input", name: "UrlInput", group: "Forms",
    summary: "A web address box that shows the protocol fixed at the start and lets the browser check the shape, with a tick when it looks right.",
    tags: ["forms", "input", "link", "no-js"], demo: UrlInputDemo })
