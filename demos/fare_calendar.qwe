// A month and a half of fares, cheaper midweek and dearer at weekends, with a few days without flights.
let fare_calendar_demo_prices = {
    "2026-11-02": 129.00m, "2026-11-03": 89.00m, "2026-11-04": 94.50m, "2026-11-05": 112.00m, "2026-11-06": 158.00m, "2026-11-07": 171.00m,
    "2026-11-08": 149.00m, "2026-11-09": 119.00m, "2026-11-10": 79.00m, "2026-11-11": 84.00m, "2026-11-12": 99.00m, "2026-11-13": 164.00m,
    "2026-11-14": 182.00m, "2026-11-15": 140.00m, "2026-11-16": 109.00m, "2026-11-17": 92.00m, "2026-11-18": 92.00m, "2026-11-19": 118.00m,
    "2026-11-20": 199.00m, "2026-11-21": 214.00m, "2026-11-22": 176.00m, "2026-11-23": 121.00m, "2026-11-24": 101.00m,
    "2026-11-26": 133.00m, "2026-11-27": 245.00m, "2026-11-28": 239.00m, "2026-11-29": 198.00m, "2026-11-30": 115.00m,
    "2026-10-30": 99.00m, "2026-10-31": 139.00m,
    "2026-12-01": 104.00m, "2026-12-02": 88.00m, "2026-12-03": 97.00m, "2026-12-04": 151.00m, "2026-12-05": 166.00m,
}

component FareCalendarDemoLive() {
    state note = "Pick a day: on_pick gets it and its fare."
    <div.demo-stack>
        <FareCalendar id="fare-calendar-demo" name="depart" prices={fare_calendar_demo_prices} month="2026-11" today="2026-10-31"
                      on_pick={(day, price) => { note = `on_pick: ${day} at ${price}` }}/>
        <p.demo-note id="fare-calendar-demo-note">{note}</p>
    </div>
}

view FareCalendarDemo() =
    <div class="demo-row" style="align-items: start">
        <FareCalendarDemoLive/>
        <FareCalendar id="fare-calendar-demo-eur" name="back" prices={{ "2026-12-07": 64.90m, "2026-12-08": 59.90m, "2026-12-10": 71.00m }}
                      value="2026-12-10" week_start={0} currency="EUR" locale="de-DE" cents={true}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "fare_calendar", name: "FareCalendar", group: "Travel",
    summary: "A month of the cheapest fare each day: prices coloured cheap to dear, the lowest day marked, months with fares to move between, and a day to pick.",
    tags: ["travel", "flights", "calendar", "picker", "interactive"], demo: FareCalendarDemo })
