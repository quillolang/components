let filter_sheet_demo_items = [
    { id: 1, name: "Trail runner", brand: "Northpeak", sizes: ["8", "9", "10"], colour: "Black", price: "120.00", in_stock: true },
    { id: 2, name: "Road racer", brand: "Northpeak", sizes: ["9", "10"], colour: "Red", price: "160.00", in_stock: true },
    { id: 3, name: "Canvas low", brand: "Hollis", sizes: ["7", "8"], colour: "White", price: "65.00", in_stock: true },
    { id: 4, name: "Canvas high", brand: "Hollis", sizes: ["8", "9"], colour: "Black", price: "75.00", in_stock: false },
    { id: 5, name: "Court classic", brand: "Ace & Co", sizes: ["9"], colour: "White", price: "90.00", in_stock: true },
    { id: 6, name: "Court pro", brand: "Ace & Co", sizes: ["10", "11"], colour: "Red", price: "140.00", in_stock: false },
    { id: 7, name: "Slip-on", brand: "Hollis", sizes: ["7", "8", "9"], colour: "Black", price: "55.00", in_stock: true },
    { id: 8, name: "Hiker mid", brand: "Northpeak", sizes: ["10", "11"], colour: "Brown", price: "180.00", in_stock: true },
]

let filter_sheet_demo_facets = [
    { key: "brand", label: "Brand" },
    { key: "sizes", label: "Size", options: ["7", "8", "9", "10", "11", "12"] },
    { key: "colour", label: "Colour" },
    { key: "price", label: "Price", kind: "range" },
    { key: "in_stock", label: "In stock only", kind: "flag" },
]

component FilterSheetDemoLive() {
    state shown = filter_sheet_demo_items
    state round = 0
    state kept = null
    <div.demo-stack>
        <div.demo-row>
            <FilterSheet key={round} items={filter_sheet_demo_items} facets={filter_sheet_demo_facets} noun="shoes" save_key="demo-shoes" saved={kept}
                         id={`filter-demo-${round}`} on_apply={(_c, found) => { shown = found }}/>
            <Button id="filter-demo-again" variant="ghost" size="lg" on_click={() => { round += 1 }}>Come back later</Button>
            <Button id="filter-demo-app" variant="ghost" size="lg" on_click={() => { kept = { colour: ["Red"] }; round += 1 }}>Come back, as an app</Button>
        </div>
        <p.demo-note id="filter-demo-list">{len(shown)} shown: {shown | map((x) => x.name) | join(", ")}</p>
    </div>
}

view FilterSheetDemo() = <FilterSheetDemoLive/>

ui_gallery = ui_gallery | push({ slug: "filter_sheet", name: "FilterSheet", group: "Mobile",
    summary: "Facets in a sheet, with result counts updating live, clear, apply, the count on the button, and a state kept for next time.",
    tags: ["mobile", "interactive", "commerce", "sheet", "filter", "tablet"],
    needs: ["cart_sheet"],
    demo: FilterSheetDemo })
