let currency_converter_demo_rates = { USD: 1, EUR: 0.9224m, GBP: 0.7841m, JPY: 156.24m, CHF: 0.8812m, CAD: 1.3746m,
                                      PHP: 58.12m, MXN: 18.0450m }

component CurrencyConverterDemoLive() {
    state note = "Pick a trip budget."
    <div.demo-stack>
        <CurrencyConverter name="trip" label="Trip budget" rates={currency_converter_demo_rates} amount="2500" from="USD" to="JPY"
                           currencies={["USD", "EUR", "JPY", "PHP"]} updated="Mid-market rates at 14:05 UTC"
                           on_change={(r) => { note = `${r.amount} ${r.from} is ${round(r.converted, 2)} ${r.to}.` }}/>
        <p.demo-note id="currency-converter-demo-note">{note}</p>
    </div>
}

view CurrencyConverterDemo() =
    <div.demo-stack>
        <CurrencyConverter rates={currency_converter_demo_rates} amount={1000} from="USD" to="EUR"
                           updated="Mid-market rates at 14:05 UTC"/>
        <CurrencyConverterDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "currency_converter", name: "CurrencyConverter", group: "Finance",
    summary: "An amount and two currencies with a swap button, the rate both ways and the converted amount, crossed through the base from the rates given.",
    tags: ["finance", "forex", "calculator", "forms", "interactive"], demo: CurrencyConverterDemo })
