let scan_to_add_demo_catalog = [
    { code: "4006381333931", name: "Marker pen", price: "1.90" },
    { code: "5901234123457", name: "Notebook, A5", price: "4.25" },
    { code: "0012345678905", name: "Sticky notes", price: "2.10" },
    { code: "96385074", name: "Eraser", price: "0.80" },
]

component ScanToAddDemoLive() {
    state last = "Nothing yet."
    <div.demo-stack>
        <ScanToAdd catalog={scan_to_add_demo_catalog} gap={600} on_scan={(c, how) => { last = `${c} by ${how}` }}/>
        <p.demo-note id="scan-demo-last">{last}</p>
    </div>
}

view ScanToAddDemo() = <ScanToAddDemoLive/>

ui_gallery = ui_gallery | push({ slug: "scan_to_add", name: "ScanToAdd", group: "Mobile",
    summary: "Scan a product's code to add it to a list, by the camera, a photo or typing, with a beep, a haptic and a count of repeats.",
    tags: ["mobile", "interactive", "camera", "barcode", "commerce", "tablet"],
    demo: ScanToAddDemo })
