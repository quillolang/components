let trip_timeline_demo_legs = [
    { id: "t3", kind: "flight", title: "EK 318", from: "Dubai", to: "Tokyo", departs: "2026-11-05T02:50:00+04:00", arrives: "2026-11-05T17:35:00+09:00", ref: "Seat 31K" },
    { id: "t1", kind: "train", title: "Metro to the airport", from: "Rossio", to: "Lisbon Airport", departs: "2026-11-03T18:30:00+00:00", arrives: "2026-11-03T19:05:00+00:00" },
    { id: "t2", kind: "flight", title: "TP 1012", from: "Lisbon", to: "Dubai", departs: "2026-11-03T22:40:00+00:00", arrives: "2026-11-04T09:15:00+04:00", ref: "Seat 14A", note: "Bag through to Tokyo." },
    { id: "s1", kind: "stay", title: "Airport hotel", from: "Dubai", to: "Dubai", departs: "2026-11-04T11:00:00+04:00", arrives: "2026-11-04T23:00:00+04:00" },
    { id: "t4", kind: "ferry", title: "Water bus", from: "Tokyo Bay", departs: "2026-11-06T10:00:00+09:00" },
    { id: "t5", kind: "flight", title: "NZ 90", from: "Tokyo", to: "Auckland", departs: "2026-11-07T18:00:00+09:00", arrives: "2026-11-08T08:45:00+13:00" },
    { id: "t6", kind: "flight", title: "NZ 2", from: "Auckland", to: "Los Angeles", departs: "2026-11-08T21:00:00+13:00", arrives: "2026-11-08T12:30:00-08:00" },
    { id: "bad", kind: "bus", title: "Lost its time", from: "Nowhere", departs: "tomorrow" },
    { id: "odd", kind: "bus", title: "Arrives before it leaves", from: "Here", to: "There", departs: "2026-11-09T09:00:00-08:00", arrives: "2026-11-09T08:00:00-08:00" },
]

component TripTimelineDemoLive() {
    state time = "2026-11-03T14:05:00+00:00"
    state picked = "nothing yet"
    <div.demo-stack>
        <TripTimeline title="Lisbon to Los Angeles, the long way" legs={trip_timeline_demo_legs} now={time} tick={1} on_pick={(l) => { picked = l.title }}/>
        <div.demo-row>
            <button.trip-timeline-demo-onboard type="button" style="min-height: 44px" @click={() => { time = "2026-11-03T23:30:00+00:00" }}>On the first flight</button>
            <button.trip-timeline-demo-after type="button" style="min-height: 44px" @click={() => { time = "2026-11-20T10:00:00+00:00" }}>Home again</button>
        </div>
        <p.demo-note>Picked: <span class="trip-timeline-demo-picked">{picked}</span>.</p>
    </div>
}

view TripTimelineDemo() = <TripTimelineDemoLive/>

ui_gallery = ui_gallery | push({ slug: "trip_timeline", name: "TripTimeline", group: "Mobile",
    summary: "The legs of a trip through time zones, each in local time, with the next one highlighted, waits between legs, and when clocks and days change.",
    tags: ["mobile", "interactive", "tablet", "travel", "timeline", "time-zones"], demo: TripTimelineDemo })
