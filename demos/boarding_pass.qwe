view BoardingPassDemo() =
    <div.demo-stack>
        <BoardingPass id="boarding-pass-demo-full" airline="Quillo Air" flight="QA 204" passenger="Ada Lovelace" date="2026-11-03"
                      from={{ code: "LHR", city: "London Heathrow" }} to={{ code: "OPO", city: "Porto" }}
                      departs="07:45" arrives="10:20" boarding="07:10" gate="B12" seat="14A" group="2" terminal="5" cabin="Economy" record="X7K2QL"
                      logo="https://dummyimage.com/110x24/ffffff/5b4bdb.png&text=QA"/>
        <BoardingPass id="boarding-pass-demo-min" airline="Nordic" flight="NR 17" passenger="Grace Hopper"
                      from={{ code: "CPH" }} to={{ code: "ARN" }} seat="3C">
            <svg width="200" height="44" viewBox="0 0 100 22" preserveAspectRatio="none" role="img" aria-label="Barcode" shape-rendering="crispEdges">
                <path fill="currentColor" d="M0 0h2v22H0zM3 0h1v22H3zM6 0h3v22H6zM11 0h1v22h-1zM14 0h2v22h-2zM18 0h1v22h-1zM21 0h3v22h-3zM26 0h1v22h-1zM29 0h2v22h-2zM33 0h1v22h-1zM36 0h3v22h-3zM41 0h2v22h-2zM45 0h1v22h-1zM48 0h3v22h-3zM53 0h1v22h-1zM56 0h2v22h-2zM60 0h1v22h-1zM63 0h3v22h-3zM68 0h2v22h-2zM72 0h1v22h-1zM75 0h3v22h-3zM80 0h1v22h-1zM83 0h2v22h-2zM87 0h1v22h-1zM90 0h3v22h-3zM95 0h1v22h-1zM98 0h2v22h-2z"/>
            </svg>
        </BoardingPass>
    </div>

ui_gallery = ui_gallery | push({ slug: "boarding_pass", name: "BoardingPass", group: "Data",
    summary: "A boarding pass with from and to, flight, date and times, gate, seat, boarding group, a barcode area and a stub.",
    tags: ["document", "card", "schedule", "print", "no-js"],
    demo: BoardingPassDemo })
