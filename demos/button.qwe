view ButtonDemo() =
    <div.demo-stack>
        <div.demo-row>
            <Button id="button-demo-save">Save changes</Button>
            <Button variant="soft">Soft</Button>
            <Button variant="outline">Outline</Button>
            <Button variant="ghost">Ghost</Button>
        </div>
        <div.demo-row>
            <Button tone="neutral">Neutral</Button>
            <Button tone="danger">Delete</Button>
            <Button tone="danger" variant="soft">Discard</Button>
            <Button variant="outline" href="https://quillolang.org/docs/">A link</Button>
        </div>
        <div.demo-row>
            <Button size="sm">Small</Button>
            <Button size="lg">Large</Button>
            <Button loading={true}>Saving</Button>
            <Button disabled={true}>Disabled</Button>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "button", name: "Button", group: "Actions",
    summary: "A button, or a link that looks like one: four variants, three tones, three sizes, loading.",
    demo: ButtonDemo })
