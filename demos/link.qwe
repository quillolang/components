view LinkDemo() =
    <div.demo-stack>
        <p.demo-note style="color: var(--ui-fg); font-size: 15px">
            Read <Link href="/docs" id="link-demo-docs">the docs</Link>, or the source on
            <Link href="https://github.com/quillolang/components" id="link-demo-ext">GitHub</Link>. The release notes
            are on <Link href="https://quillolang.org/notes" new_tab={false} id="link-demo-same">the site</Link>.
        </p>
        <div.demo-row>
            <Link href="#link" underline="hover" id="link-demo-hover">Underline on hover</Link>
            <Link href="#link" underline="none">No underline</Link>
            <Link href="#link" tone="inherit" id="link-demo-inherit">Inherits the colour</Link>
            <Link href="#link" tone="muted">Muted</Link>
            <Link href="#link" weight="medium">Medium weight</Link>
            <Link href="data:text/plain,hello" download="hello.txt" id="link-demo-download">Download hello.txt</Link>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "link", name: "Link", group: "Typography",
    summary: "A styled link that shows an icon and opens a new tab when it leaves the site, with underline and tone variants.",
    tags: ["typography", "link", "navigation", "no-js"],
    demo: LinkDemo })
