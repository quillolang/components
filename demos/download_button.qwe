view DownloadButtonDemo() =
    <div.demo-stack>
        <div.demo-row>
            <DownloadButton id="dl-demo-report" href="https://quillolang.org/components/quillo-ui.qwe" filename="report.pdf" bytes={1843200}/>
            <DownloadButton href="https://quillolang.org/components/quillo-ui.qwe" filename="orders.csv" bytes={52000} label="Export orders" variant="solid"/>
            <DownloadButton href="https://quillolang.org/components/quillo-ui.qwe" kind="ZIP" bytes={2254857830} label="Source" variant="soft" tone="neutral"/>
        </div>
        <div.demo-row>
            <DownloadButton href="/files/photo.jpg" bytes={820} size="sm"/>
            <DownloadButton href="/files/notes.txt" label="Notes" variant="ghost"/>
            <DownloadButton href="/export?format=csv" filename="people.csv" label="Export" size="lg" tone="danger"/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "download_button", name: "DownloadButton", group: "Actions",
    summary: "A link that downloads a file, showing its kind and size so nobody is surprised by a big one.",
    tags: ["button", "link", "file", "no-js"],
    demo: DownloadButtonDemo })
