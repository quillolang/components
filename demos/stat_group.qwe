view StatGroupDemo() =
    <div.demo-stack>
        <StatGroup id="stat-group-demo-sales" label="This month" items={[
            { label: "Revenue", value: "$48,210", delta: 12.5, delta_suffix: "%", hint: "vs last month" },
            { label: "Orders", value: "1,284", delta: -3.2, delta_suffix: "%", hint: "vs last month" },
            { label: "Refunds", value: "$1,020", delta: 8, delta_suffix: "%", good: "down", hint: "lower is better" },
            { label: "Open tickets", value: "37", delta: 0, hint: "same as yesterday" },
        ]}/>
        <StatGroup id="stat-group-demo-site" label="Site" columns={3} items={[
            { label: "Visitors", value: "92.4k" }, { label: "Bounce rate", value: "41%", delta: -2, delta_suffix: " pts", good: "down" }, { label: "Avg. session", value: "3m 12s" },
        ]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "stat_group", name: "StatGroup", group: "Data",
    summary: "Several numbers that matter in one bordered row, each with its change coloured by whether that is good.",
    tags: ["data", "dashboard", "no-js"], demo: StatGroupDemo })
