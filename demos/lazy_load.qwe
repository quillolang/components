component LazyLoadDemoLive() {
    state shown = 0
    <div.demo-stack>
        <div id="lazy-load-demo-box" tabindex="0" aria-label="A long page"
             style="height: 240px; overflow: auto; border: 1px solid var(--ui-border); border-radius: var(--ui-radius); padding: 0 16px">
            {for i in range(1, 9) => <p key={i}>Paragraph {i}. Keep scrolling: the pictures below are not on the page yet.</p>}
            <LazyLoad scroller="lazy-load-demo-box" margin="40px" height="120px" on_show={() => { shown += 1 }}>
                <div id="lazy-load-demo-content" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px">
                    {for i in range(3) => <div key={i} style="height: 120px; border-radius: var(--ui-radius); background: var(--ui-accent-soft); display: grid; place-items: center">Picture {i + 1}</div>}
                </div>
            </LazyLoad>
            <p>The end.</p>
        </div>
        <p.demo-note>{shown == 0 ? "Not loaded yet: scroll the box." : "Loaded once it came near."}</p>
    </div>
}

view LazyLoadDemo() =
    <div.demo-stack>
        <LazyLoadDemoLive/>
        <LazyLoad height="100px" placeholder="Loading…">
            <div style="padding: 14px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius)">This block, placed in the page, was made when the gallery scrolled near it.</div>
        </LazyLoad>
    </div>

ui_gallery = ui_gallery | push({ slug: "lazy_load", name: "LazyLoad", group: "Utilities",
    summary: "Puts its content on the page only once it is scrolled near, holding its height until then.",
    tags: ["utility", "loading", "media", "page", "interactive"],
    demo: LazyLoadDemo })
