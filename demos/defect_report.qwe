// A plan drawn for the demo, 800 by 600, in rooms a test can reason about.
let defect_report_demo_svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600"><rect width="800" height="600" fill="#fff"/><g fill="none" stroke="#111" stroke-width="6"><rect x="10" y="10" width="780" height="580"/><path d="M400 10v300M10 310h780M560 310v280"/></g><g font-family="sans-serif" font-size="28" fill="#333"><text x="120" y="170">Kitchen</text><text x="520" y="170">Living room</text><text x="200" y="460">Bedroom</text><text x="620" y="460">Bath</text></g></svg>`

let defect_report_demo_plans = [
    { id: "l2", label: "Level 2", src: `data:image/svg+xml,${url_encode(defect_report_demo_svg)}`, width: 800, height: 600,
      zones: [{ name: "Kitchen", x: 0, y: 0, w: 50, h: 50 }, { name: "Living room", x: 50, y: 0, w: 50, h: 50 }, { name: "Bedroom", x: 0, y: 50, w: 70, h: 50 }, { name: "Bath", x: 70, y: 50, w: 30, h: 50 }] },
    { id: "l3", label: "Level 3", src: `data:image/svg+xml,${url_encode(defect_report_demo_svg)}`, width: 800, height: 600 },
]

component DefectReportDemoLive() {
    state said = "Nothing sent yet."
    <div.demo-stack>
        <DefectReport reporter="J. Tremblay" job="Block C, unit 12" drawings={defect_report_demo_plans} on_send={(r) => { said = `Sent ${r.grid} ${r.zone} ${r.severity} ${len(r.photos)}` }}/>
        <p.demo-note id="defect-demo-said">{said}</p>
    </div>
}

view DefectReportDemo() = <DefectReportDemoLive/>

ui_gallery = ui_gallery | push({ slug: "defect_report", name: "DefectReport", group: "Mobile",
    summary: "Severity, a location by a tap on the drawing with its grid square and room, photos, and a clear summary to send.",
    tags: ["mobile", "interactive", "field", "drawing", "report", "tablet"],
    needs: ["photo_evidence"],
    demo: DefectReportDemo })
