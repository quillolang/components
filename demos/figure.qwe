// A picture drawn in SVG, so the demo needs no image files.
fn figure_demo_pic(a: str, b: str, w: int = 800, h: int = 500) -> str {
    let svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${w} ${h}" width="${w}" height="${h}">`
        + `<rect width="${w}" height="${h}" fill="${a}"/>`
        + `<circle cx="${w * 0.72}" cy="${h * 0.3}" r="${h * 0.12}" fill="#fff" opacity=".8"/>`
        + `<path d="M0 ${h * 0.7} Q ${w * 0.3} ${h * 0.45} ${w * 0.55} ${h * 0.68} T ${w} ${h * 0.6} V ${h} H 0 Z" fill="${b}"/></svg>`
    `data:image/svg+xml,${url_encode(svg)}`
}

view FigureDemo() =
    <div.demo-stack>
        <Figure src={figure_demo_pic("#7cb7f0", "#2f6b3a")} alt="Green hills under a blue sky" width={800} height={500}
                caption="The valley at noon, from the north ridge." credit="Photo: Ana Reis" credit_href="https://example.com/ana"/>
        <div.demo-row style="align-items: flex-start">
            <Figure src={figure_demo_pic("#f3a46b", "#5b3a5e")} alt="Purple hills at sunset" size="sm" caption="Sunset, day one."/>
            <Figure src={figure_demo_pic("#1d2b53", "#0f1a33")} alt="Dark hills under a full moon" size="sm" align="center"
                    caption="The moon over camp." credit="© Ben Lee"/>
        </div>
        <Figure size="sm" align="right" caption="A figure can hold anything: here, a table.">
            <table style="border-collapse: collapse; width: 100%">
                <tr><td style="padding: 4px 8px; border: 1px solid var(--ui-border)">Mon</td><td style="padding: 4px 8px; border: 1px solid var(--ui-border)">12 km</td></tr>
                <tr><td style="padding: 4px 8px; border: 1px solid var(--ui-border)">Tue</td><td style="padding: 4px 8px; border: 1px solid var(--ui-border)">18 km</td></tr>
            </table>
        </Figure>
    </div>

ui_gallery = ui_gallery | push({ slug: "figure", name: "Figure", group: "Media",
    summary: "An image (or anything) with a caption and a credit under it, as a figure with its figcaption.",
    tags: ["media", "image", "typography", "no-js"], demo: FigureDemo })
