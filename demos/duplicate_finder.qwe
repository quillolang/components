let duplicate_finder_demo_rows = [
    { name: "Ada Lovelace", email: "ada@example.com", city: "London" },
    { name: "ada  lovelace", email: "ada@example.com", city: "" },
    { name: "Lovelace, Ada", email: "ada.l@example.com", city: "London" },
    { name: "Grace Hopper", email: "grace@navy.mil", city: "New York" },
    { name: "Grace Hoper", email: "grace@navy.mil", city: "NYC" },
    { name: "José Álvarez", email: "jose@example.com", city: "Madrid" },
    { name: "Jose Alvarez", email: "jose@example.com", city: "Madrid" },
    { name: "Alan Turing", email: "alan@turing.org", city: "Manchester" },
]

component DuplicateFinderDemoLive() {
    state result = null
    <div.demo-stack>
        <DuplicateFinder id="duplicate-finder-demo-live" title="Merge contacts" fields={[{ key: "name", label: "Name" }]} threshold={90}
                         rows={[{ name: "Ann Lee", ref: 1 }, { name: "Anne Lee", ref: 2 }, { name: "Bo Diddley", ref: 3 }]}
                         on_resolve={(kept, dropped) => { result = { kept, dropped } }}/>
        <p.demo-note>{result == null ? "Resolve to see on_resolve." : `on_resolve: kept ${len(result.kept)} (${join(result.kept | map((r) => r.ref), ", ")}), dropped ${len(result.dropped)} (${join(result.dropped | map((r) => r.ref), ", ")}).`}</p>
    </div>
}

view DuplicateFinderDemo() =
    <div.demo-stack>
        <DuplicateFinder id="duplicate-finder-demo" rows={duplicate_finder_demo_rows}
                         fields={[{ key: "name", label: "Name" }, { key: "email", label: "Email" }, { key: "city", label: "City" }]}/>
        <DuplicateFinderDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "duplicate_finder", name: "DuplicateFinder", group: "Data",
    summary: "Finds near-duplicate rows by normalised text and edit distance with an adjustable threshold, marks what differs, and lets you pick the row to keep.",
    tags: ["smart", "interactive", "duplicates", "dedupe", "matching", "cleaning"], demo: DuplicateFinderDemo })
