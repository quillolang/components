component LikeButtonDemoLive() {
    state liked = false
    <div.demo-row>
        <LikeButton count={12} on_change={(on) => { liked = on }}/>
        <span.demo-note>{liked ? "You like this." : "Not liked."}</span>
    </div>
}

view LikeButtonDemo() =
    <div.demo-stack>
        <LikeButtonDemoLive/>
        <div.demo-row>
            <LikeButton count={1280} liked={true} name="like"/>
            <LikeButton count={45200} variant="outline"/>
            <LikeButton count={2400000} variant="soft" size="sm"/>
            <LikeButton count={7} size="lg"/>
            <LikeButton show_count={false}/>
            <LikeButton count={3} disabled={true}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "like_button", name: "LikeButton", group: "Actions",
    summary: "A heart that toggles with a count that follows it, a real toggle for screen readers and forms.",
    tags: ["button", "social", "forms", "interactive"],
    demo: LikeButtonDemo })
