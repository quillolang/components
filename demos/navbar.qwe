let navbar_demo_links = [{ label: "Product", href: "#navbar" }, { label: "Docs", href: "/" },
                         { label: "Pricing", href: "#pricing" }, { label: "Blog", href: "#blog" }]

view NavbarDemo() =
    <div.demo-stack>
        <div style="border: 1px solid var(--ui-border); border-radius: var(--ui-radius); overflow: hidden">
            <Navbar brand="Acme" links={navbar_demo_links} current="/">
                <Button size="sm" variant="ghost" href="#navbar">Sign in</Button>
                <Button size="sm" href="#navbar">Start free</Button>
            </Navbar>
            <div style="height: 40px"></div>
        </div>
        <p.demo-note>When it is narrow, the links fold into a menu:</p>
        <div style="width: min(360px, 100%); height: 260px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius); overflow: hidden">
            <Navbar brand="Acme" links={navbar_demo_links} current="/">
                <Button size="sm" href="#navbar">Start free</Button>
            </Navbar>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "navbar", name: "Navbar", group: "Layout",
    summary: "The bar along the top of a site: name, links and actions; the links fold into a menu when narrow.",
    demo: NavbarDemo })
