let shift_planner_demo_people = [
    { id: "ana", name: "Ana", skills: ["forklift"] }, { id: "ben", name: "Ben", skills: ["forklift"], max_hours: 24 },
    { id: "cara", name: "Cara", off: [6, 7] }, { id: "dev", name: "Dev", off: ["2026-11-04"] }]

let shift_planner_demo_shifts = [
    { id: "early", name: "Early", start: "06:00", end: "14:00", need: 1 },
    { id: "late", name: "Late", start: "14:00", end: "22:00", need: [1, 1, 1, 1, 1, 0, 0] },
    { id: "night", name: "Night", start: "22:00", end: "06:00", need: 1, skill: "forklift" }]

component ShiftPlannerDemoLive() {
    state count = null
    <div.demo-stack>
        <ShiftPlanner id="shift-planner-demo" week="2026-11-04" people={shift_planner_demo_people} shifts={shift_planner_demo_shifts}
                      assigned={[{ person: "ana", day: 0, shift: "late" }, { person: "ana", day: "2026-11-03", shift: "early" }, { person: "cara", day: 5, shift: "night" }]}
                      on_change={(p) => { count = len(p) }}/>
        <p.demo-note>{count == null ? "Change a shift to see on_change." : `on_change: ${count} shifts planned.`}</p>
    </div>
}

view ShiftPlannerDemo() =
    <div.demo-stack>
        <ShiftPlannerDemoLive/>
        <ShiftPlanner id="shift-planner-demo-small" title="A small team" name="small" week="2026-11-02" people={[{ id: "a", name: "Ana" }, { id: "b", name: "Ben", off: [2] }]}
                      shifts={[{ id: "day", name: "Day", start: "09:00", end: "17:30", need: [1, 1, 1, 1, 0, 0, 0] }, { id: "crane", name: "Crane", start: "08:00", end: "12:00", need: [0, 0, 0, 0, 0, 1, 0], skill: "crane" },
                               { id: "bad", name: "Bad", start: "25:00", end: "26:00" }, { id: "day", name: "Twin", start: "09:00", end: "10:00" }, "junk"]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "shift_planner", name: "ShiftPlanner", group: "Scheduling",
    summary: "People by shifts across a week: checks rest, hours, skills and coverage, marks each breach with its reason, and auto-fills fairly, saying what it could not fill.",
    tags: ["smart", "interactive", "rota", "staff", "roster", "planning"], demo: ShiftPlannerDemo })
