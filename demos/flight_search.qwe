let flight_search_demo_airports = [
    { code: "LHR", city: "London", name: "Heathrow" }, { code: "LGW", city: "London", name: "Gatwick" },
    { code: "LIS", city: "Lisbon" }, { code: "OPO", city: "Porto" }, { code: "JFK", city: "New York", name: "John F. Kennedy" },
    { code: "CDG", city: "Paris", name: "Charles de Gaulle" }, { code: "FRA", city: "Frankfurt" }, { code: "SIN", city: "Singapore", name: "Changi" },
]

component FlightSearchDemoLive() {
    state note = "Search: on_search gets the query."
    <div.demo-stack>
        <FlightSearch id="flight-search-demo" name="trip" from="LHR" to="LIS" depart="2026-11-05" back="2026-11-12" adults={2} kids={1}
                      today="2026-10-30" airports={flight_search_demo_airports}
                      on_search={(q) => { note = `on_search: ${q.trip} ${q.from} to ${q.to}, ${q.depart} to ${q.back ?? "-"}, ${q.adults}+${q.children}+${q.infants}, ${q.cabin}` }}/>
        <p.demo-note id="flight-search-demo-note">{note}</p>
    </div>
}

view FlightSearchDemo() =
    <div.demo-stack>
        <FlightSearchDemoLive/>
        <FlightSearch id="flight-search-demo-get" trip="oneway" cabin="business" action="#flights" airports={flight_search_demo_airports}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "flight_search", name: "FlightSearch", group: "Travel",
    summary: "A flight search form: return or one way, from and to with a swap button and airport suggestions, dates, travellers and cabin, checked before it searches.",
    tags: ["travel", "flights", "forms", "search", "interactive"], demo: FlightSearchDemo })
