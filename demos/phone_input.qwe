component PhoneInputDemoLive() {
    state phone = null
    <div.demo-stack>
        <PhoneInput name="pi-demo-mobile" label="Mobile" country="PT" countries={["PT", "ES", "FR", "GB", "US"]}
                    on_change={(p) => { phone = p }}/>
        <p.demo-note>{phone == null || phone.e164 == "" ? "No number yet." : `Will call ${phone.e164} (${phone.country}).`}</p>
    </div>
}

view PhoneInputDemo() {
    <div.demo-stack>
        <PhoneInput name="pi-demo-phone" label="Phone" value="+44 20 7946 0958" hint="Pick the country, then type the national number."/>
        <PhoneInputDemoLive/>
        <div.demo-row>
            <PhoneInput name="pi-demo-sm" label="Small" country="JP" size="sm"/>
            <PhoneInput name="pi-demo-bad" label="Phone" country="US" value="555" error="That number is too short."/>
        </div>
    </div>
}

ui_gallery = ui_gallery | push({ slug: "phone_input", name: "PhoneInput", group: "Forms",
    summary: "A country code select and a number box, sent together in international form (+351912345678) with the country's ISO code.",
    tags: ["forms", "input", "select", "user", "interactive"], demo: PhoneInputDemo })
