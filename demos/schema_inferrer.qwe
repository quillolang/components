component SchemaInferrerDemoLive() {
    state schema = null
    <div.demo-stack>
        <SchemaInferrer id="schema-inferrer-demo-live" title="Lines, live" text={"{\"a\": 1}\n{\"a\": 2, \"b\": \"x\"}\n"}
                        on_change={(s) => { schema = s }}/>
        <p.demo-note>{schema == null ? "Change the text to see on_change." : `on_change: ${join(keys(schema.properties ?? {}), ", ")} (required: ${join(schema.required ?? [], ", ")}).`}</p>
    </div>
}

view SchemaInferrerDemo() =
    <div.demo-stack>
        <SchemaInferrer id="schema-inferrer-demo" text={schema_inferrer_demo_text} name="sample"/>
        <SchemaInferrerDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "schema_inferrer", name: "SchemaInferrer", group: "Data",
    summary: "Reads JSON samples and infers fields, types, optional and nullable, enums and formats, merging across samples and nested data, as a table and JSON Schema.",
    tags: ["smart", "interactive", "json", "schema", "inference", "validation"], demo: SchemaInferrerDemo })
