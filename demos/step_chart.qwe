let step_chart_demo_grid = "display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 32px 40px"

view StepChartDemo() =
    <div.demo-stack>
        <StepChart label="Policy rate" show_label={true} suffix="%" decimals={2}
                   labels={["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]}
                   values={[4.5, 4.5, 4.25, 4.25, 4.25, 4, 4, 3.75, 3.75, 3.75, 3.5, 3.5]}/>
        <div style={step_chart_demo_grid}>
            <StepChart label="Seats in use" show_label={true} area={true} height={170}
                       labels={["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]}
                       series={[{ name: "Team", values: [12, 14, 14, 18, 18, 9, 9] },
                                { name: "Guests", values: [3, 3, 6, 6, 4, 1, 0] }]}/>
            <StepChart label="Plan price" show_label={true} prefix="$" zero={true} height={170}
                       labels={["2019", "2020", "2021", "2022", "2023", "2024", "2025"]}
                       values={[8, 8, 10, null, 12, 12, 15]}/>
        </div>
        <p.demo-note>Each value holds until the next label; 2022's price is unknown, so the line breaks.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "step_chart", name: "StepChart", group: "Charts",
    summary: "Lines that hold each value flat and move in steps, for one or more series, with an optional fill and every value on hover.",
    tags: ["chart", "data", "no-js"],
    demo: StepChartDemo })
