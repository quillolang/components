component EventCardDemoLive() {
    state going = false
    <div.demo-stack>
        <EventCard id="event-card-demo-live" day="2026-12-02" start="18:00" title="Release party" place="Online" badge="Free" tone="success"
                   text="Pop in for the demo and stay for the questions." action_label={going ? "You're in" : "I'm in"}
                   on_action={() => { going = !going }}/>
        <p.demo-note>{going ? "Going." : "Not going yet."}</p>
    </div>
}

view EventCardDemo() =
    <div.demo-stack>
        <div.demo-row style="align-items: stretch">
            <div style="flex: 1 1 320px">
                <EventCard id="event-card-demo-first" day="2026-11-14" start="19:00" end="22:00" title="Quillo meetup" href="#event_card"
                           place="LX Factory, Lisbon" text="Talks, demos and pizza. Bring a laptop." action_label="Register" action_href="#event_card"/>
            </div>
            <div style="flex: 1 1 320px">
                <EventCard id="event-card-demo-image" day="2027-01-20" start="09:00" end="17:00" title="Workshop: building apps in a day"
                           place="Porto" image="https://picsum.photos/seed/workshop/800/300" image_alt="People at laptops in a bright room"
                           badge="Sold out" tone="danger" action_label="Sold out" disabled={true}/>
            </div>
        </div>
        <div.demo-narrow>
            <EventCardDemoLive/>
        </div>
        <div.demo-narrow id="event-card-demo-stack">
            <EventCard day="2026-11-20" title="Office closed" tone="neutral" horizontal={false} action={false}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "event_card", name: "EventCard", group: "Scheduling",
    summary: "An event as a card: a date block, title, time, place, a line about it, an optional picture and badge, and a button.",
    tags: ["schedule", "calendar", "card", "time", "no-js"], demo: EventCardDemo })
