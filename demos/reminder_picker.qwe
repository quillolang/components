component ReminderPickerDemoLive() {
    state got = ""
    state last = ""
    state cleared = false
    <div.demo-stack>
        <ReminderPicker id="reminder-demo" today="2026-11-01" now="10:20" about="Pay the rent"
                        on_set={(r) => { got = `${r.at} | ${r.sentence} | ${join(r.next, " ")}` }}
                        on_change={(r) => { last = r != null ? r.sentence : "cannot be set" }}/>
        <p.demo-note id="reminder-got">{got}</p>
        <p.demo-note id="reminder-last">{last}</p>
        // Twelve-hour, late in the day, and given a value; and bad data. Radio groups stay apart.
        <div id="reminder-late"><ReminderPicker id="reminder-two" today="2026-02-27" now="23:10" hour12={true}
            value={{ date: "2026-02-28", time: "13:30", rule: { unit: "week", every: 2, days: [2, 6], ends: "after", times: 4 } }} on_clear={() => { cleared = true }}/></div>
        <p.demo-note id="reminder-cleared">{cleared ? "cleared" : ""}</p>
        <div id="reminder-bad" hidden="true"><ReminderPicker id="reminder-three" today="nope" now="99:99" time="later" value={{ date: "2026-02-30", rule: "no" }}/></div>
    </div>
}

view ReminderPickerDemo() = <div.demo-stack><ReminderPickerDemoLive/></div>

ui_gallery = ui_gallery | push({ slug: "reminder_picker", name: "ReminderPicker", group: "Mobile",
    summary: "Today, tomorrow, next week or custom, repeating, with a plain sentence of what was set.",
    tags: ["mobile", "interactive", "dates", "tasks", "form", "tablet"],
    demo: ReminderPickerDemo })
