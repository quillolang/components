let slug_input_demo_taken = ["hello-world", "my-first-post", "my-first-post-2", "my-first-post-3", "Launch-Notes", "pricing-for-teams-in-eur"]
let slug_input_demo_reserved = ["admin", "login", "api", "new"]

component SlugInputDemoLive() {
    state heading = "Pricing for teams"
    state got = null
    <div.demo-stack>
        <label>Page heading <input type="text" id="slug-demo-heading" value={heading} @input={(e) => { heading = e.value }}/></label>
        <SlugInput id="slug-demo-live" name="page" title={heading} show_title={false} taken={slug_input_demo_taken} limit={24}
                   on_change={(r) => { got = r }}/>
        <p.demo-note>{got == null ? "Edit the link to see on_change." : `on_change: ${got.status} ${got.slug}`}</p>
    </div>
}

view SlugInputDemo() =
    <div class="demo-stack demo-narrow">
        <form>
            <SlugInput id="slug-demo" prefix="https://example.com/blog/" title_value="Crème Brûlée à la carte!" taken={slug_input_demo_taken}
                       reserved={slug_input_demo_reserved}/>
        </form>
        <SlugInputDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "slug_input", name: "SlugInput", group: "Forms",
    summary: "Makes a URL slug from a title as it is typed, writing accents plainly, stops following once edited by hand, and checks taken and reserved links, offering the next free one.",
    tags: ["smart", "interactive", "slug", "url", "validation", "forms"], demo: SlugInputDemo })
