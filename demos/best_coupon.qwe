let best_coupon_demo_cart = [
    { name: "Trail shoes", category: "Shoes", price: "120.00" },
    { name: "Wool socks", category: "Apparel", price: "10.00", qty: 3 },
    { name: "Route guide", category: "Books", price: "20.00" }]

let best_coupon_demo_coupons = [
    { code: "TAKE15", label: "Take 15", kind: "fixed", value: "15", stackable: true, min_spend: "100" },
    { code: "save10", label: "Save 10", kind: "percent", value: "10", stackable: true },
    { code: "SHOES25", label: "Shoe sale", kind: "percent", value: "25", category: "shoes" },
    { code: "BOOK5", label: "Book token", kind: "fixed", value: "5", stackable: true, category: "books", min_spend: "25" },
    { code: "OLD20", label: "Last season", kind: "percent", value: "20", expires: "2026-10-01" },
    { code: "BIG50", label: "Big spender", kind: "fixed", value: "50", min_spend: "300" },
    { code: "TOYS", label: "Toy sale", kind: "percent", value: "50", category: "toys" },
    { code: "FLAT20", label: "Flat 20", kind: "fixed", value: "20" },
    { code: "SAVE10", label: "Again", kind: "percent", value: "99" },
    { code: "HUGE", kind: "percent", value: "120" }]

component BestCouponDemoLive() {
    state seen = null
    <div.demo-stack>
        <BestCoupon id="best-coupon-demo-live" title="The shop's order, minimum after discounts" order="percent_first" basis="after" name="codes"
                    cart={[{ name: "Jacket", price: "100.00" }]}
                    coupons={[{ code: "FIVE", kind: "fixed", value: "5", stackable: true, min_spend: "95" }, { code: "TEN", kind: "percent", value: "10", stackable: true }]}
                    on_change={(f) => { seen = f }}/>
        <p.demo-note>{seen == null ? "Switch a coupon off to see on_change." : `on_change: ${join(seen.codes, ", ")}, to pay ${seen.total}, saving ${seen.saving}.`}</p>
    </div>
}

view BestCouponDemo() =
    <div.demo-stack>
        <BestCoupon id="best-coupon-demo" today="2026-11-01" cart={best_coupon_demo_cart} coupons={best_coupon_demo_coupons}/>
        <BestCouponDemoLive/>
        <BestCoupon id="best-coupon-demo-free" title="A coupon larger than the cart, in pennies across categories" currency="GBP"
                    cart={[{ name: "A", category: "x", price: "0.05" }, { name: "B", category: "y", price: "0.05" }, { name: "Bad", price: "soon" }]}
                    coupons={[{ code: "THIRD", kind: "percent", value: "33.3", cap: "0.02", stackable: true }, { code: "ALL", kind: "fixed", value: "5", stackable: true }]}/>
        <BestCoupon id="best-coupon-demo-many" title="More stacking coupons than are tried together" cart={[{ name: "Sofa", price: "1000.00" }]}
                    coupons={range(1, 9) | map((n) => { code: `C${n}`, kind: "percent", value: n, stackable: true })}/>
        <BestCoupon id="best-coupon-demo-empty" title="An empty cart" cart={[]} coupons={[{ code: "X", kind: "percent", value: "10" }]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "best_coupon", name: "BestCoupon", group: "Commerce",
    summary: "Works out the lowest total from several coupons, trying each combination and order under their rules, and explains the winner and why each other coupon lost.",
    tags: ["smart", "interactive", "commerce", "coupon", "discount", "checkout"], demo: BestCouponDemo })
