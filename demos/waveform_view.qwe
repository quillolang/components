// 2.5 seconds at 4000 Hz: one of silence, one of a loud tone, half of it at half the height.
let waveform_view_demo_wav = "data:audio/wav;base64,"

component WaveformViewDemoLive() {
    state at = -1
    <div.demo-stack>
        <WaveformView src={waveform_view_demo_wav} bars={50} step={0.5} label="Voice note from Ana" on_seek={(s) => { at = s }}/>
        <p.demo-note id="waveform-view-demo-note">{at < 0 ? "Not moved yet." : `on_seek got ${round(at, 1)} s`}</p>
    </div>
}

view WaveformViewDemo() =
    <div.demo-stack>
        <WaveformViewDemoLive/>
        <WaveformView src={waveform_view_demo_wav} peaks={[0, 0.25, 0.5, 1, "bad", 2, -1, 0.75]} label="Peaks the server already knew"/>
        <WaveformView src="data:audio/wav;base64,AAAA" label="A file that cannot be read"/>
    </div>

ui_gallery = ui_gallery | push({ slug: "waveform_view", name: "WaveformView", group: "Mobile",
    summary: "Draws an audio file's waveform on the phone, with scrubbing by finger, a current-time line, and a reduced-motion form.",
    tags: ["mobile", "interactive", "audio", "waveform", "player"], needs: ["button"], demo: WaveformViewDemo })
