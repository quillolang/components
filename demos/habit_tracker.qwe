component HabitTrackerDemoLive() {
    state ticks = null
    <div.demo-stack>
        <HabitTracker id="habit-tracker-demo-live" title="This fortnight" today="2026-11-11" days={14} name="fortnight"
                      habits={[{ name: "Water plants", weekdays: [3, 6], start: "2026-11-04", done: ["2026-11-04"] }]}
                      on_change={(hs) => { ticks = len(hs[0].done) }}/>
        <p.demo-note>{ticks == null ? "Tick a day to see on_change." : `on_change: ${ticks} ticked.`}</p>
    </div>
}

view HabitTrackerDemo() =
    <div.demo-stack>
        <HabitTracker id="habit-tracker-demo" today="2026-11-11" days={21} habits={[
            { id: "read", name: "Read", start: "2026-10-26",
              done: ["2026-10-26", "2026-10-27", "2026-10-28", "2026-10-30", "2026-10-31", "2026-11-01", "2026-11-02", "2026-11-03",
                     "2026-11-06", "2026-11-07", "2026-11-08", "2026-11-09", "2026-11-10"] },
            { id: "run", name: "Run", weekdays: [1, 3, 5], start: "2026-10-26",
              done: ["2026-10-26", "2026-10-28", "2026-10-30", "2026-11-02", "2026-11-06", "2026-11-07", "2026-11-09"] },
            { id: "stretch", name: "Stretch", weekdays: [2, 4], grace: 1, start: "2026-10-27",
              done: ["2026-10-27", "2026-10-29", "2026-11-05", "2026-11-10"] }]}/>
        <HabitTrackerDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "habit_tracker", name: "HabitTracker", group: "Scheduling",
    summary: "A grid of days per habit that works out streaks, completion and grace days, on chosen weekdays only, and tells streaks apart across a missed day.",
    tags: ["smart", "interactive", "streaks", "calendar", "tracker", "goals"], demo: HabitTrackerDemo })
