component ColorSwatchesDemoLive() {
    state theme = "ocean"
    <div.demo-stack>
        <ColorSwatches name="theme" label="Theme" value={theme} size="lg" names={true} field="color-swatches-demo-live"
                       options={[{ label: "Ocean", value: "ocean", color: "#0b6bcb" }, { label: "Forest", value: "forest", color: "#18794e" },
                                 { label: "Plum", value: "plum", color: "#5b4bdb" }, { label: "Ember", value: "ember", color: "#c62a2f" },
                                 { label: "Sand", value: "sand", color: "#d9b26f", disabled: true }]}
                       on_change={(v) => { theme = v }}/>
        <p.demo-note>Theme: {theme}.</p>
    </div>
}

view ColorSwatchesDemo() =
    <div.demo-stack>
        <ColorSwatches name="color" label="Label colour" value="#18794e" field="color-swatches-demo-hex"
                       options={["#5b4bdb", "#18794e", "#c62a2f", "#a35200", "#0b6bcb", "#17161f"]}
                       hint="The arrow keys move between them."/>
        <ColorSwatchesDemoLive/>
        <div.demo-row>
            <ColorSwatches name="tiny" label="Small" size="sm" options={["#5b4bdb", "#18794e", "#c62a2f"]} required={true}
                           error="Pick a colour."/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "color_swatches", name: "ColorSwatches", group: "Forms",
    summary: "Pick one colour from a set of round swatches: real radio buttons, so they post with a form and work with the keyboard.",
    tags: ["forms", "picker", "input", "theme", "no-js"], demo: ColorSwatchesDemo })
