view LoadingDotsDemo() =
    <div.demo-stack>
        <div.demo-row style="gap: 28px">
            <LoadingDots/>
            <LoadingDots size="sm" tone="neutral"/>
            <LoadingDots size="lg" tone="success"/>
            <LoadingDots tone="info" show_label={true} label="Thinking"/>
        </div>
        <div.demo-row>
            <Button disabled={true}><LoadingDots tone="current" label="Sending"/> Sending</Button>
            <span style="display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; border-radius: 18px; background: var(--ui-subtle)">
                <LoadingDots size="sm" tone="neutral" label="Ada is typing"/>
            </span>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "loading_dots", name: "LoadingDots", group: "Feedback",
    summary: "Three dots bouncing in turn, inline, for something short that is on its way; screen readers hear the label.",
    tags: ["feedback", "loading", "status", "animation", "no-js"],
    demo: LoadingDotsDemo })
