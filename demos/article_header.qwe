view ArticleHeaderDemo() =
    <div.demo-stack style="gap: 40px">
        <ArticleHeader id="article-header-demo-main" kicker="Climate" kicker_href="#climate" label="Analysis"
                       headline="The river that ran out of water"
                       dek="Three summers of drought have turned the Douro into a string of ponds, and the vineyards along it are deciding what to give up."
                       authors={[{ name: "Inês Carvalho", href: "#by-ines" }, "Tom Reid", { name: "Maya Okafor", href: "#by-maya" },
                                 { name: "Luís Pinto", role: "Photographs by" }, { name: "Sara Klein", role: "With additional reporting by" }]}
                       published="2026-10-29T08:00:00-04:00" updated="2026-10-30T14:20:00-04:00" zone_label="ET" read_time="9 min read"/>
        <ArticleHeader id="article-header-demo-live" label="Live" kicker="Election 2026" level={2} align="center"
                       headline="Polls close in the first states"
                       authors={["The Ledger staff"]} published="2026-11-03T19:00:00-05:00" published_text="Started 19 minutes ago"/>
    </div>

ui_gallery = ui_gallery | push({ slug: "article_header", name: "ArticleHeader", group: "News",
    summary: "The top of a story: its label and section, the headline, the dek, every author grouped by role, published and updated times, and the reading time.",
    tags: ["news", "article", "typography", "byline", "no-js"], demo: ArticleHeaderDemo })
