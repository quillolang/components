let tablet_toolbar_demo_css = css`
.demo-bar { display: flex; flex-direction: column; height: 100%; font: 15px/1.6 var(--ui-font); }
.demo-bar-page { flex: 1; min-height: 0; overflow: auto; padding: 18px 20px; }
.demo-bar-page h4 { margin: 0 0 6px; font-size: 20px; }
.demo-bar-swatches { display: flex; flex-wrap: wrap; gap: 6px; }
.demo-bar-swatch { width: 44px; height: 44px; padding: 0; border: 1px solid var(--ui-border); border-radius: var(--ui-radius-sm); cursor: pointer; }
`

let tablet_toolbar_demo_groups = [
    { id: "history", label: "History", priority: 3, items: [
        { id: "undo", label: "Undo", icon: "M9 14 4 9l5-5M4 9h11a5 5 0 0 1 0 10h-3" },
        { id: "redo", label: "Redo", icon: "M15 14l5-5-5-5M20 9H9a5 5 0 0 0 0 10h3" },
    ] },
    { id: "text", label: "Text", priority: 2, items: [
        { id: "bold", label: "Bold", icon: "B", toggle: true },
        { id: "italic", label: "Italic", icon: "I", toggle: true },
        { id: "size", label: "Size", icon: "Aa", options: ["Small", "Normal", "Large"] },
        { id: "colour", label: "Colour", icon: "C" },
    ] },
    { id: "insert", label: "Insert", priority: 1, items: [
        { id: "image", label: "Image", icon: "M4 5h16v14H4zM4 16l5-5 4 4 3-3 4 4" },
        { id: "table", label: "Table", icon: "M4 5h16v14H4zM4 10h16M10 5v14" },
        { id: "link", label: "Link", icon: "M10 14a4 4 0 0 0 6 0l3-3a4 4 0 0 0-6-6l-1 1M14 10a4 4 0 0 0-6 0l-3 3a4 4 0 0 0 6 6l1-1" },
    ] },
    { id: "view", label: "View", items: [
        { id: "outline", label: "Outline", icon: "M4 6h16M8 12h12M8 18h12", toggle: true },
        { id: "zoom", label: "Zoom", icon: "Z", options: [{ value: "100", label: "100%" }, { value: "150", label: "150%" }] },
    ] },
    { id: "share", label: "Share", items: [
        { id: "send", label: "Send", icon: "M4 12 20 4l-6 16-3-7z" },
        { id: "print", label: "Print", icon: "M6 9V3h12v6M6 18H3v-8h18v8h-3M6 14h12v7H6z" },
    ] },
]

component TabletToolbarDemoSwatches(on_pick = null) {
    <div.demo-bar-swatches>
        {for c in ["#c62a2f", "#18794e", "#0b6bcb"] =>
            <button.demo-bar-swatch key={c} type="button" aria-label={`Colour ${c}`} data-swatch={c} style={`background: ${c}`} @click={() => { on_pick && on_pick(c) }}></button>}
    </div>
}

component TabletToolbarDemoLive() {
    style global tablet_toolbar_demo_css
    state said = "Nothing pressed yet"
    state kept = { order: ["nothing-like-this", "history", "text"], hidden: ["no-such-item", 7] }
    state told = "Nothing customised yet"
    state round = 0
    <div.demo-tablet>
        <div.demo-bar>
            <TabletToolbar key={round} id={`bar-demo-${round}`} label="Format" groups={tablet_toolbar_demo_groups} saved={kept}
                           panels={{ colour: <TabletToolbarDemoSwatches on_pick={(c) => { said = `colour ${c}` }}/> }}
                           on_action={(tool, value) => { said = `${tool} ${str(value)}` }}
                           on_customize={(k) => {
                               kept = k
                               told = json.stringify(k)
                           }}/>
            <div.demo-bar-page>
                <h4>Site report</h4>
                <p id="bar-demo-said">{said}</p>
                <p id="bar-demo-told">{told}</p>
                <Button id="bar-demo-again" size="lg" variant="outline" on_click={() => { round += 1 }}>Come back later</Button>
            </div>
        </div>
    </div>
}

view TabletToolbarDemo() = <TabletToolbarDemoLive/>

ui_gallery = ui_gallery | push({ slug: "tablet_toolbar", name: "TabletToolbar", group: "Mobile",
    summary: "A top toolbar whose groups overflow into a menu as width shrinks, customisable, with popovers anchored to their buttons.",
    tags: ["mobile", "tablet", "interactive", "toolbar", "overflow", "popover"],
    needs: ["anchored_popover"],
    demo: TabletToolbarDemo })
