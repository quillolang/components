view CollateralListDemo() {
    <div.demo-stack>
        <CollateralList id="collateral-list-demo-home" loan={182450} limit={80} items={[
            { name: "14 Alder Row, Fairhaven", kind: "Property", detail: "Three-bedroom house, freehold", value: 265000, valued_on: "2026-08-12",
              valuer: "Coastline Surveyors",
              documents: [{ name: "Title deed", status: "verified", href: "#deed" }, { name: "Valuation report", status: "verified", href: "#valuation" },
                          { name: "Buildings insurance", status: "pending" }] },
        ]}/>
        <CollateralList id="collateral-list-demo-business" loan={410000} label="Business loan collateral" items={[
            { name: "Unit 7, Millbrook Trading Estate", kind: "Property", value: 380000, valued_on: "2026-06-30", valuer: "Halden & Pryce",
              documents: [{ name: "Lease", status: "verified" }, { name: "Valuation report", status: "verified", href: "#unit7" }] },
            { name: "Two delivery vans", kind: "Vehicles", detail: "Registrations KX24 FHD, KX24 FHE", value: 64000, valued_on: "2026-09-02",
              documents: [{ name: "Registration documents", status: "verified" }, { name: "Fleet insurance", status: "missing" }] },
            { name: "Cash deposit, 12-month term", kind: "Deposit", detail: "Account •••• 2207", value: 77000 },
        ]}/>
        <div.demo-narrow style="max-width: 460px">
            <CollateralList id="collateral-list-demo-car" loan={21500} limit={85} currency="EUR" locale="de-DE" items={[
                { name: "2024 Kestrel Tourer 1.6", kind: "Vehicle", value: 23500, valued_on: "2026-10-01",
                  documents: [{ name: "Fahrzeugbrief", status: "verified" }] },
            ]}/>
        </div>
    </div>
}

ui_gallery = ui_gallery | push({ slug: "collateral_list", name: "CollateralList", group: "Finance",
    summary: "What secures a loan: each item's valuation and documents, and the loan-to-value ratio as a meter against the lender's limit.",
    tags: ["finance", "loans", "list", "data", "no-js"], demo: CollateralListDemo })
