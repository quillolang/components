component NotificationBellDemoLive() {
    state unread = 2
    <div.demo-row>
        <NotificationBell id="notification-bell-demo-live" count={unread} on_click={() => { unread = 0 }}/>
        <Button size="sm" variant="outline" id="notification-bell-demo-more" on_click={() => { unread += 1 }}>New notification</Button>
        <span.demo-note>{unread == 0 ? "All read (the bell was clicked)." : `${unread} unread; click the bell to read them.`}</span>
    </div>
}

view NotificationBellDemo() =
    <div.demo-stack>
        <div.demo-row style="gap: 20px">
            <NotificationBell id="notification-bell-demo" count={3} href="#notification_bell"/>
            <NotificationBell count={0} href="#notification_bell"/>
            <NotificationBell id="notification-bell-demo-many" count={120}/>
            <NotificationBell id="notification-bell-demo-dot" count={1} dot={true}/>
            <NotificationBell count={7} size="sm"/>
            <NotificationBell count={7} size="lg"/>
        </div>
        <div.demo-row>
            <NotificationBell id="notification-bell-demo-panel" count={2} target="notification-bell-demo-pop"/>
            <div id="notification-bell-demo-pop" popover="auto" style="margin: auto; padding: 14px 16px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius); background: var(--ui-surface); color: var(--ui-fg); box-shadow: var(--ui-shadow-lg); font: 14px/1.5 var(--ui-font)">
                <b>2 notifications</b><br/>Ana replied to your comment.<br/>The build finished.
            </div>
            <span.demo-note>This one opens a popover by its id.</span>
        </div>
        <NotificationBellDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "notification_bell", name: "NotificationBell", group: "Navigation",
    summary: "A bell with the unread count on its corner: a link, or a button that opens any panel.",
    tags: ["navigation", "notification", "button", "icon", "no-js"], demo: NotificationBellDemo })
