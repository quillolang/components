component TabsDemoLive() {
    state tab = 0
    let files = ["main.qwe", "style.css", "README.md"]
    <TabBar id="tabs-demo-bar" label="Files" labels={files} selected={tab} on_change={(i) => { tab = i }}>
        <p.demo-note>Editing {files[tab]} (tab {tab + 1} of 3, from state; the arrow keys move between tabs).</p>
    </TabBar>
}

view TabsDemo() =
    <div.demo-stack style="gap: 32px">
        <Tabs label="Install">
            <Tab group="tabs-demo-os" label="macOS" selected={true}>
                <p>Install with Homebrew: <code>brew install quillo</code>, then run <code>quillo --version</code>.</p>
            </Tab>
            <Tab group="tabs-demo-os" label="Linux">
                <p>Run the installer: <code>curl -fsSL https://quillolang.org/install.sh | sh</code>.</p>
            </Tab>
            <Tab group="tabs-demo-os" label="Windows">
                <p>Download the installer from the releases page, or run <code>winget install quillo</code>.</p>
            </Tab>
        </Tabs>
        <Tabs variant="pill" label="Period">
            <Tab group="tabs-demo-period" label="This week"><p>128 orders, €4,210 in sales.</p></Tab>
            <Tab group="tabs-demo-period" label="This month"><p>512 orders, €17,960 in sales.</p></Tab>
            <Tab group="tabs-demo-period" label="This year"><p>5,904 orders, €201,330 in sales.</p></Tab>
        </Tabs>
        <TabsDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "tabs", name: "Tabs", group: "Navigation",
    summary: "Panels behind a row of tabs, from radio buttons and CSS: no JavaScript, any HTML from the server.",
    demo: TabsDemo })
