let sheet_select_demo_towns = ["Antipolo", "Bacolod", "Baguio", "Cagayan de Oro", "Cebu City", "Davao", "Dumaguete", "Iloilo", "Legazpi", "Manila", "Tacloban", "Zamboanga"]

component SheetSelectDemoLive() {
    state town = "Cebu City"
    state extras = ["egg"]
    <div.demo-stack>
        <SheetSelect label="Town" field="sheet-select-demo-town" options={sheet_select_demo_towns} value={town} on_change={(v) => { town = v }}/>
        <SheetSelect label="Add to your order" field="sheet-select-demo-extras" multiple={true} value={extras}
                     options={[{ value: "egg", label: "Fried egg", hint: "₱25" }, { value: "rice", label: "Extra rice", hint: "₱20" },
                               { value: "soup", label: "Soup", hint: "₱35" }, { value: "cake", label: "Rice cake", hint: "Sold out", disabled: true }]}
                     on_change={(v) => { extras = v }}/>
        <p.demo-note id="sheet-select-demo-out">Town: {town}. Extras: {join(extras, ", ")}.</p>
    </div>
}

view SheetSelectDemo() =
    <div.demo-stack>
        <SheetSelectDemoLive/>
        <form id="sheet-select-demo-form" method="get" action="#" class="demo-stack">
            <SheetSelect label="Size" name="size" required={true} field="sheet-select-demo-size" options={["Small", "Medium", "Large"]}/>
            <SheetSelect label="Colours" name="colours" multiple={true} field="sheet-select-demo-colours" value={["Red", "Blue"]} options={["Red", "Green", "Blue"]}/>
            <Button type="reset" size="lg" variant="outline" id="sheet-select-demo-reset">Reset</Button>
        </form>
    </div>

ui_gallery = ui_gallery | push({ slug: "sheet_select", name: "SheetSelect", group: "Mobile",
    summary: "A select that opens as a bottom sheet, with search past a size, multi-select with Done, and a real field in a form.",
    tags: ["mobile", "interactive", "select", "sheet", "picker", "forms"],
    demo: SheetSelectDemo })
