view ProgressDemo() =
    <div.demo-stack>
        <div.demo-stack.demo-narrow>
            <Progress value={42} label="Uploading 12 photos" show_value={true}/>
            <Progress value={3} max={5} tone="success" label="Profile, 3 of 5 steps" show_value={true}/>
            <Progress value={91} tone="warning" size="sm" label="Storage almost full" show_value={true}/>
            <Progress label="Preparing the export"/>
            <Progress value={66.5} size="lg" tone="info"/>
        </div>
        <div.demo-row>
            <Progress variant="ring" value={72} label="Storage used"/>
            <Progress variant="ring" value={100} tone="success" size="lg" label="Sync complete"/>
            <Progress variant="ring" value={18} tone="danger" label="Battery"/>
            <Progress variant="ring" size="sm" value={50} label="Halfway"/>
            <Progress variant="ring" label="Connecting"/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "progress", name: "Progress", group: "Feedback",
    summary: "How far along something is, as a bar or a ring, with its percentage, or indeterminate.",
    tags: ["feedback", "progress", "loading", "no-js"],
    demo: ProgressDemo })
