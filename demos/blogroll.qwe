view BlogrollDemo() =
    <div style="max-width: 560px">
        <Blogroll id="blogroll-demo" today="2026-10-30" opml="#blogroll-opml" blogs={[
            { name: "The Morning Paper", href: "https://blog.acolyer.example", author: "Adrian Colyer", feed: "https://blog.acolyer.example/feed",
              description: "A computer science paper a day, read and explained." },
            { name: "Julia Evans", href: "https://jvns.example", feed: "https://jvns.example/atom.xml", group: "Programming",
              description: "Comics and notes about how computers work.",
              latest: { title: "Notes on git's data model", href: "https://jvns.example/blog/git", date: "2026-10-27" } },
            { name: "Simon's weblog", href: "https://simon.example", group: "Programming", feed: "https://simon.example/atom/everything/",
              latest: { title: "Running a database in the browser", href: "https://simon.example/2026/Oct/5/", date: "2026-10-05" } },
            { name: "Low Tech Magazine", href: "https://solar.lowtech.example", group: "Elsewhere",
              description: "A website that runs on solar power, and goes offline when it is cloudy.",
              latest: { title: "How to keep warm in a cold house", date: "2025-11-20" } },
        ]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "blogroll", name: "Blogroll", group: "Blogging",
    summary: "The blogs a writer recommends, in groups: name, a line about each, its latest post and how long ago, its feed, and the list as OPML.",
    tags: ["blogging", "list", "links", "feeds", "no-js"], demo: BlogrollDemo })
