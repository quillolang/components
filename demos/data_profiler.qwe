let data_profiler_demo_rows = [
    { id: 1, name: "Ada Lovelace", city: "London", plan: "pro", balance: 0.1, joined: "2026-01-05", note: null, country: "UK", age: 36, tag: "a", zip: "007" },
    { id: 2, name: "Grace Hopper", city: "New York", plan: "free", balance: 0.2, joined: "2026-03-20", note: "", country: "UK", age: "41", tag: "b", zip: "012" },
    { id: 3, name: "Alan Turing", city: "london", plan: "pro", balance: 12.50m, joined: "2025-12-31", note: "  ", country: "UK", age: 41, tag: 3, zip: "n/a" },
    { id: 4, name: "Edsger Dijkstra ", city: "Austin", plan: "free", balance: 1200, joined: null, note: null, country: "UK", age: 72, tag: true, zip: "999" },
    { id: 5, name: "Mary Jackson", city: null, plan: "free", balance: "1,000.25", joined: "2026-02-28", note: "called back", country: "UK", age: 83, tag: "a", zip: "100" },
]

component DataProfilerDemoLive() {
    state picked = null
    <div.demo-stack>
        <DataProfiler id="data-profiler-demo-live" title="Pick a column" top={1} columns={["plan"]} rows={data_profiler_demo_rows}
                      on_select={(c) => { picked = c }}/>
        <p.demo-note>{picked == null ? "Pick a column to see on_select." : `on_select: ${picked.key}, ${picked.distinct} distinct, commonest ${picked.top[0].value}.`}</p>
    </div>
}

view DataProfilerDemo() =
    <div.demo-stack>
        <DataProfiler id="data-profiler-demo" rows={data_profiler_demo_rows} mostly_empty={75}/>
        <DataProfiler id="data-profiler-demo-bad" title="Awkward rows" rows={[{ a: 1 }, "not a record", null, { a: "😀", b: [1, 2], c: { d: 1 } }, { a: 1e30 }]}/>
        <DataProfiler id="data-profiler-demo-times" title="Times" rows={[{ at: "2026-01-02 03:00" }, { at: "2026-01-02T05:00:00Z" }, { at: "2026-01-01T23:30:00-05:00" }]}/>
        <DataProfiler id="data-profiler-demo-empty" title="Nothing yet" rows={[]}/>
        <DataProfilerDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "data_profiler", name: "DataProfiler", group: "Data",
    summary: "Reports each column of a list of rows: inferred type, missing, distinct, range, commonest values and warnings in plain words.",
    tags: ["smart", "interactive", "profiling", "quality", "statistics", "columns"], demo: DataProfilerDemo })
