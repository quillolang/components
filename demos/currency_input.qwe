component CurrencyInputDemoLive() {
    state fee = null
    <div.demo-stack>
        <CurrencyInput name="ci-demo-fee" label="Fee" currency="JPY" placeholder="0" on_change={(n) => { fee = n }}/>
        <p.demo-note>{fee == null ? "No fee yet." : `The fee is ${fee} yen.`}</p>
    </div>
}

view CurrencyInputDemo() {
    <div.demo-stack>
        <div.demo-row>
            <CurrencyInput name="ci-demo-price" label="Price" value={1234.5} currency="USD" hint="Thousands are grouped as you type."/>
            <CurrencyInput name="ci-demo-budget" label="Budget" currency="EUR" locale="de" symbol_after={true} placeholder="0,00"/>
        </div>
        <CurrencyInputDemoLive/>
        <div.demo-row>
            <CurrencyInput name="ci-demo-refund" label="Refund" value="-250" currency="GBP" negative={true} size="sm"/>
            <CurrencyInput name="ci-demo-bad" label="Deposit" value={0} currency="INR" error="A deposit must be more than zero."/>
        </div>
    </div>
}

ui_gallery = ui_gallery | push({ slug: "currency_input", name: "CurrencyInput", group: "Forms",
    summary: "An amount with its currency's symbol, thousands grouped as it is typed and the decimals the currency has, sent as plain digits.",
    tags: ["forms", "input", "price", "commerce", "interactive"], demo: CurrencyInputDemo })
