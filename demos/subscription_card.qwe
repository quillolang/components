component SubscriptionCardDemoLive() {
    state did = null
    <div.demo-stack style="width: 340px">
        <SubscriptionCard plan="Team" price={49} status="trialing" renews="2026-11-20" locale="en-US"
                          usage={[{ label: "Seats", used: 5, limit: 5 }]}
                          on_change={() => { did = "change" }} on_cancel={() => { did = "cancel" }}/>
        <p.demo-note>{did == null ? "The links call on_change and on_cancel." : `Clicked ${did}.`}</p>
    </div>
}

view SubscriptionCardDemo() =
    <div.demo-row style="align-items: flex-start; gap: 20px">
        <div style="width: 340px">
            <SubscriptionCard plan="Pro" price={12} status="active" renews="2026-11-12" payment="Visa ending 4242"
                              manage_href="#subscription_card" change_href="#pricing_table" cancel_href="#subscription_card"
                              usage={[{ label: "Projects", used: 7, limit: 10 }, { label: "Storage", used: 42.5, limit: 50, unit: " GB" }]}
                              note="Prices exclude VAT."/>
        </div>
        <SubscriptionCardDemoLive/>
        <div style="width: 340px">
            <SubscriptionCard plan="Hobby" price={0} status="cancelled" ends="2026-12-01" manage_href="#subscription_card"/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "subscription_card", name: "SubscriptionCard", group: "Commerce",
    summary: "The plan someone is on: price, status, renewal date, usage bars and the links to manage, change or cancel it.",
    tags: ["commerce", "price", "card", "settings", "dashboard", "no-js"],
    needs: ["price"], demo: SubscriptionCardDemo })
