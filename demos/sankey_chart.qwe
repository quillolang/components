view SankeyChartDemo() =
    <div.demo-stack>
        <SankeyChart label="Where sign-ups come from" show_label={true}
                     links={[{ from: "Search", to: "Pricing", value: 4200 }, { from: "Search", to: "Docs", value: 3100 },
                             { from: "Search", to: "Blog", value: 1500 }, { from: "Social", to: "Blog", value: 2600 },
                             { from: "Social", to: "Pricing", value: 700 }, { from: "Email", to: "Pricing", value: 1800 },
                             { from: "Email", to: "Docs", value: 400 }, { from: "Pricing", to: "Sign-up", value: 1900 },
                             { from: "Pricing", to: "Left", value: 4800 }, { from: "Docs", to: "Sign-up", value: 900 },
                             { from: "Docs", to: "Left", value: 2600 }, { from: "Blog", to: "Sign-up", value: 300 },
                             { from: "Blog", to: "Left", value: 3800 }]}/>
        <SankeyChart label="Household budget" show_label={true} prefix="$" height={260}
                     links={[{ from: "Salary", to: "Budget", value: 4800 }, { from: "Freelance", to: "Budget", value: 1200 },
                             { from: "Budget", to: "Housing", value: 1900 }, { from: "Budget", to: "Food", value: 900 },
                             { from: "Budget", to: "Transport", value: 450 }, { from: "Budget", to: "Savings", value: 1500 },
                             { from: "Budget", to: "Other", value: 1250 }, { from: "Savings", to: "Pension", value: 600 },
                             { from: "Savings", to: "Holiday", value: 900 }]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "sankey_chart", name: "SankeyChart", group: "Charts",
    summary: "Flows between nodes in columns as bands as wide as their amounts, laid out to cross little, with each flow on hover.",
    tags: ["chart", "data", "no-js"],
    demo: SankeyChartDemo })
