view MessageBubbleDemo() =
    <div.demo-stack style="gap: 4px">
        <MessageBubble tone="system" time="Today">Ana Silva joined the chat</MessageBubble>
        <MessageBubble id="message-bubble-demo-theirs" name="Ana Silva" avatar="https://i.pravatar.cc/80?img=47" time="09:41" datetime="2026-10-28T09:41:00Z"
                       last={false}>Morning! Any luck with that test?</MessageBubble>
        <MessageBubble name="Ana Silva" avatar="https://i.pravatar.cc/80?img=47" time="09:41" first={false}>I can pair on it after lunch
if that helps.</MessageBubble>
        <MessageBubble id="message-bubble-demo-mine" mine={true} time="09:42" datetime="2026-10-28T09:42:00Z" status="read">Fixed it: a path with a space in it.</MessageBubble>
        <MessageBubble mine={true} time="09:42" status="delivered">Shipping now 🚀</MessageBubble>
        <MessageBubble name="Ben Okafor" time="09:43">Nice one.</MessageBubble>
        <MessageBubble mine={true} time="09:44" status="sent">Thanks!</MessageBubble>
        <MessageBubble mine={true} time="09:44" status="sending">And the release notes are up.</MessageBubble>
        <MessageBubble id="message-bubble-demo-failed" mine={true} time="09:45" status="failed">This one did not go.</MessageBubble>
    </div>

ui_gallery = ui_gallery | push({ slug: "message_bubble", name: "MessageBubble", group: "Social",
    summary: "One chat message, yours on the right or theirs on the left, with the time and sent, delivered, read or failed ticks.",
    tags: ["social", "chat", "no-js"], demo: MessageBubbleDemo })
