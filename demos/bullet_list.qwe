view BulletListDemo() =
    <div.demo-stack>
        <div.demo-row style="align-items: flex-start; gap: 40px">
            <BulletList id="bullet-list-demo-dots" items={["Free returns within 30 days", "Two-year warranty", "Ships in one day"]}/>
            <BulletList id="bullet-list-demo-checks" icon="check" tone="success" items={["Unlimited projects", "Priority support", "Single sign-on"]}/>
            <BulletList id="bullet-list-demo-arrows" icon="arrow" tone="accent" spacing="tight" items={["Install", "Run", "Deploy"]}/>
        </div>
        <div.demo-row style="align-items: flex-start; gap: 40px">
            <BulletList icon="star" tone="warning" size="sm" items={["Starred", "Also starred"]}/>
            <BulletList icon="dash" items={["A dash", "Another"]}/>
            <BulletList id="bullet-list-demo-glyph" glyph="🚀" spacing="loose" items={["Fast to start", "Faster to ship"]}/>
            <BulletList id="bullet-list-demo-kids" icon="none">
                <li>Written <b>by hand</b>, with no bullet</li>
                <li>Nested:
                    <BulletList items={["one", "two"]}/>
                </li>
            </BulletList>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "bullet_list", name: "BulletList", group: "Typography",
    summary: "An unordered list with dot, tick, arrow, star, dash or any glyph bullets, in a tone and a spacing.",
    tags: ["typography", "list", "text", "no-js"],
    demo: BulletListDemo })
