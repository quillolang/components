component NumberPadDemoLive() {
    state reading = "1204.5"
    <div.demo-stack>
        <div id="number-pad-demo-reading">
            <NumberPad label="Meter reading" name="reading" decimal={true} places={1} limit={6} value={reading} on_change={(t) => { reading = t }}/>
        </div>
        <p.demo-note id="number-pad-demo-out">Reading: {reading}</p>
        <Button size="lg" variant="outline" id="number-pad-demo-clear" on_click={() => { reading = "" }}>Start again</Button>
    </div>
}

view NumberPadDemo() =
    <div.demo-stack>
        <NumberPadDemoLive/>
        <div id="number-pad-demo-count">
            <p.demo-note>Whole numbers, four digits at most:</p>
            <NumberPad label="Boxes counted" value="12" limit={4} name="boxes"/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "number_pad", name: "NumberPad", group: "Mobile",
    summary: "An on-screen number pad with a decimal and delete, a hold to delete fast and a haptic, for where the system keyboard is wrong.",
    tags: ["mobile", "interactive", "keypad", "number", "input", "forms"],
    demo: NumberPadDemo })
