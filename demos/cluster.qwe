view ClusterDemo() =
    <div.demo-stack>
        <Cluster gap="sm" class="cluster-demo-tags">
            {for t in ["Quillo", "layout", "flex", "wrapping", "tags", "chips", "keywords", "and", "more", "of", "them",
                       "until", "the", "row", "runs", "out", "of", "room", "and", "goes", "on"] => <Tag>{t}</Tag>}
        </Cluster>
        <Cluster justify="end" class="cluster-demo-actions">
            <Button variant="ghost">Cancel</Button>
            <Button>Save</Button>
        </Cluster>
        <Cluster justify="between" align="baseline" class="cluster-demo-title">
            <h3 style="margin: 0">Members</h3>
            <span style="color: var(--ui-muted); font-size: 13px">12 people</span>
        </Cluster>
    </div>

ui_gallery = ui_gallery | push({ slug: "cluster", name: "Cluster", group: "Layout",
    summary: "Things in a row that goes on to the next line when it runs out of room, with gap and alignment.",
    tags: ["layout", "list", "no-js"], demo: ClusterDemo })
