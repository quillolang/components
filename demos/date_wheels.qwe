component DateWheelsDemoLive() {
    state day = "2028-01-31"
    state said = "2028-01-31"
    <div.demo-stack>
        <div id="date-wheels-demo-free">
            <DateWheels label="Start date" value={day} today="2026-11-01" earliest="1990-01-01" latest="2035-12-31" name="start"
                        on_change={(d) => { day = d; said = d }}/>
        </div>
        <p.demo-note id="date-wheels-demo-out">Value: {said}</p>
        <div.demo-row>
            <Button size="lg" variant="outline" id="date-wheels-demo-set" on_click={() => { day = "2024-02-29" }}>Go to 29 February 2024</Button>
            <Button size="lg" variant="outline" id="date-wheels-demo-long" on_click={() => { day = "2031-12-31" }}>Go to the last of 2031</Button>
        </div>
    </div>
}

view DateWheelsDemo() =
    <div.demo-stack>
        <DateWheelsDemoLive/>
        <div id="date-wheels-demo-limits">
            <p.demo-note>Booking window, 10 March 2026 to 5 February 2027, day first:</p>
            <DateWheels label="Check-in" today="2026-11-01" value="2026-03-20" earliest="2026-03-10" latest="2027-02-05" order="dmy" rows={3}/>
        </div>
        <div id="date-wheels-demo-bad">
            <p.demo-note>A date that does not exist, limits that are not dates and limits the wrong way round:</p>
            <DateWheels label="Odd" today="2026-11-01" value="2026-02-31" earliest="soon" latest="later" rows={3} name="odd"/>
            <DateWheels label="Swapped" value="garbage" earliest="2030-06-01" latest="2030-01-15" rows={3} name="swapped"/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "date_wheels", name: "DateWheels", group: "Mobile",
    summary: "Month, day and year wheels that keep each other valid, with limits, and a value in ISO.",
    tags: ["mobile", "interactive", "date", "picker", "wheel", "forms"], needs: ["wheel_picker"],
    demo: DateWheelsDemo })
