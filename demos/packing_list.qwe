component PackingListDemoLive() {
    state note = "Tick something: on_change gets the list."
    <div.demo-stack>
        <PackingList id="packing-list-demo" name="packed" title="Lisbon, 4 nights" groups={[
            { name: "Documents", items: ["Passport", "Boarding passes", { label: "Euros", packed: true }, "Travel insurance card"] },
            { name: "Clothes", items: [{ label: "T-shirts", qty: 4 }, { label: "Socks", qty: 5 }, "Light jacket", "Walking shoes"] },
            { name: "Toiletries", items: ["Toothbrush", { label: "Sunscreen", packed: true }] },
            { name: "Tech", items: [{ label: "Phone charger", packed: true }, { label: "Plug adapter (type F)", packed: true }] }]}
            on_change={(items) => {
                let n = len(items | filter((i) => i.packed))
                note = `on_change: ${n} of ${len(items)} packed.`
            }}/>
        <p.demo-note id="packing-list-demo-note">{note}</p>
    </div>
}

view PackingListDemo() =
    <div class="demo-row" style="align-items: start">
        <PackingListDemoLive/>
        <PackingList id="packing-list-demo-day" name="day" title="Day hike" add={false}
                     groups={[{ name: "Bag", items: ["Water", "Snacks", "Rain jacket"] }, { name: "Extras", items: [] }]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "packing_list", name: "PackingList", group: "Travel",
    summary: "What to pack, in groups: a checkbox for each thing with how many, a bar of how much is packed, things to add or take off, packed ones hidden and all unpacked again.",
    tags: ["travel", "list", "checklist", "forms", "interactive"], demo: PackingListDemo })
