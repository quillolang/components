let pos_register_demo_products = [
    { id: "fw", name: "Flat white", price: "4.50", category: "Coffee" }, { id: "lt", name: "Latte", price: "4.75", category: "Coffee" },
    { id: "es", name: "Espresso", price: "3.20", category: "Coffee" }, { id: "cr", name: "Croissant", price: "3.75", category: "Bakery" },
    { id: "mf", name: "Blueberry muffin", price: "3.95", category: "Bakery" }, { id: "sc", name: "Scone", price: "3.10", category: "Bakery" },
    { id: "tw", name: "Toastie", price: "7.60", category: "Kitchen" }, { id: "sp", name: "Soup of the day", price: "6.85", category: "Kitchen" },
    { id: "wt", name: "Water", price: "0.10", category: "Drinks" }, { id: "oj", name: "Orange juice", price: "3.30", category: "Drinks" },
    { id: "bad", name: "No price" }, { id: "bad2", name: "Bad price", price: "abc" }, { id: "bad3", name: "Exponent", price: "1e3" },
    { id: "fw", name: "Flat white again", price: "9.99" },
]

component PosRegisterDemoLive() {
    state note = "No sale yet."
    state refuse = false
    state charges = 0
    state reader = null
    if reader != null { every(150, () => {
        let answer = reader
        reader = null
        answer(!refuse)
    }) }
    <div.demo-stack>
        <div.demo-tablet>
            <PosRegister products={pos_register_demo_products} tax_rate="0.0825" storage_key="pos-demo"
                         on_card={(_amount, _ref) => {
                             charges += 1
                             // A reader takes a moment, and a second tap in it must not charge twice.
                             js("Promise.resolve", js_new("Promise", (ok) => { reader = ok }))
                         }}
                         on_sale={(d) => { note = `${d.paid_by}: ${d.total.amount}, change ${d.change != null ? d.change.amount : "none"}, ${len(d.lines)} lines.` }}/>
        </div>
        <button id="pos-refuse" style="min-height: 44px; min-width: 44px" @click={() => { refuse = !refuse }}>{refuse ? "Card refused" : "Card accepted"}</button>
        <p.demo-note id="pos-register-note">{note}</p>
        <p.demo-note id="pos-register-charges">{charges} card attempts.</p>
        <div id="pos-register-yen" hidden="true"><PosRegister products={[{ id: 1, name: "Ramen", price: 1250 }, { id: 2, name: "Tea", price: "333" }]} currency="JPY" locale="ja-JP" tax_rate="0.1" tax_included={true} storage_key={null}/></div>
        <div id="pos-register-held" hidden="true"><PosRegister storage_key={null} products={[]} currency="XXQ" tax_rate="soon" saved={{ ref: "held-1", lines: [{ id: "a", name: "Held", price: "2.50", qty: 2 }, { id: "b", name: "Bad qty", price: "1", qty: 0 }, { id: "c", name: "Bad price", price: "x", qty: 1 }, null], off: "100.5", off_kind: "pct" }}/></div>
    </div>
}

view PosRegisterDemo() = <PosRegisterDemoLive/>

ui_gallery = ui_gallery | push({ slug: "pos_register", name: "PosRegister", group: "Mobile",
    summary: "A tablet till: a product grid, ticket, quantity and discount, cash and card, in decimals, keeping the sale through a reload.",
    tags: ["mobile", "tablet", "interactive", "till", "commerce", "decimal"],
    demo: PosRegisterDemo })
