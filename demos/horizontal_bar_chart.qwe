let horizontal_bar_chart_demo_grid = "display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 32px 40px"

view HorizontalBarChartDemo() =
    <div style={horizontal_bar_chart_demo_grid}>
        <HorizontalBarChart label="Top pages by views" show_label={true} sort="desc"
                            labels={["/about", "/docs/getting-started", "/pricing", "/blog/quillo-1-0", "/components", "/careers"]}
                            values={[2340, 12960, 18420, 9875, 6210, 1180]}/>
        <HorizontalBarChart label="Satisfaction by team" show_label={true} suffix="%" highlight="Support" limit={100}
                            labels={["Sales", "Support", "Billing", "Onboarding", "Engineering"]}
                            values={[78, 91, 64, 85, 72]}/>
        <HorizontalBarChart label="Net change in headcount" show_label={true} bar_height={12}
                            labels={["Design", "Engineering", "Marketing", "Sales", "Finance"]}
                            values={[3, 12, -2, 5, -1]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "horizontal_bar_chart", name: "HorizontalBarChart", group: "Charts",
    summary: "Bars across with the labels down the side, sorted if asked, one picked out, values at their ends and on hover.",
    tags: ["chart", "data", "dashboard", "no-js"],
    demo: HorizontalBarChartDemo })
