component StoryCaptureDemoLive() {
    state got = null
    state shown = true
    state at_once = false
    <div.demo-stack>
        <div.demo-tablet>
            {shown && <form style="height: 100%" method="post" action="/" enctype="multipart/form-data">
                <StoryCapture name="story" limit={2} auto={at_once} on_capture={(s) => { got = s }}/>
            </form>}
        </div>
        <p.demo-note id="story-capture-demo-note">{got == null ? "Nothing used yet." : `Used: ${got.kind}, ${got.name}, ${got.type}${got.width != null ? `, ${got.width} by ${got.height}` : ""}.`}</p>
        <Button size="lg" variant="ghost" tone="neutral" on_click={() => { at_once = false; shown = !shown }}>{shown ? "Leave the page" : "Come back"}</Button>
        {!shown && <Button size="lg" variant="ghost" tone="neutral" on_click={() => { at_once = true; shown = true }}>Come back with the camera open</Button>}
    </div>
}

view StoryCaptureDemo() =
    <div.demo-stack>
        <StoryCaptureDemoLive/>
        <p.demo-note>Two seconds in this example. On a wide screen the shutter moves to the side.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "story_capture", name: "StoryCapture", group: "Mobile",
    summary: "A stories camera: hold to record, tap for a photo, with a progress ring, a switch of camera, and a screen for a refused permission.",
    tags: ["mobile", "interactive", "camera", "video", "photo", "stories"], needs: ["button"], demo: StoryCaptureDemo })
