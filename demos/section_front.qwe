// A picture drawn here, so the demo needs no network: a sky of `a` over hills of `b`.
fn section_front_demo_pic(a: str, b: str) -> str =
    "data:image/svg+xml," + url_encode(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 300 200"><defs><linearGradient id="g" x2="0" y2="1"><stop offset="0" stop-color="${a}"/><stop offset="1" stop-color="#fff"/></linearGradient></defs><rect width="300" height="200" fill="url(#g)"/><circle cx="220" cy="62" r="24" fill="#fff" opacity=".8"/><path d="M0 150 Q70 100 140 140 T300 120 V200 H0z" fill="${b}"/><path d="M0 175 Q90 140 180 170 T300 160 V200 H0z" fill="${b}" opacity=".7"/></svg>`)

view SectionFrontDemo() =
    <SectionFront id="section-front-demo" title="Business" href="#business" more_href="#business-all"
        lead={{ headline: "Central bank holds rates as inflation cools for a fourth month", href: "#rates", kicker: "Economy",
                dek: "Policymakers kept the benchmark at 4.25% and signalled that cuts could come early next year if prices keep easing.",
                src: section_front_demo_pic("#7aa7d9", "#2f5d50"), alt: "The central bank's building at dusk", credit: "Photo: Lena Ortiz for The Ledger",
                time: "1 h ago", datetime: "2026-10-30T13:05:00Z", author: "Ada Lovelace" }}
        stories={[
            { headline: "Ports clear the last of the summer backlog", href: "#ports", kicker: "Trade", label: "Analysis",
              dek: "Container waits are back under two days.", src: section_front_demo_pic("#e0b07a", "#4a5a7a"), alt: "Cranes at the container port",
              time: "3 h ago" },
            { headline: "Markets: shares edge up as oil slips", href: "#markets", label: "Live", time: "Updated 4 min ago" },
            { headline: "The four-day week, a year on", href: "#four-day", kicker: "Work", time: "Yesterday" },
        ]}
        more={[
            { headline: "Shipping costs fall for a sixth week", href: "#shipping", time: "5 h ago" },
            { headline: "Chipmaker to build second plant in the north", href: "#chips", time: "6 h ago" },
            { headline: "What the new pension rules mean for you", href: "#pensions", label: "Explainer" },
            { headline: "Airline strike called off after late deal", href: "#strike", time: "Yesterday" },
        ]}/>

ui_gallery = ui_gallery | push({ slug: "section_front", name: "SectionFront", group: "News",
    summary: "A section's front: the lead story large with its picture and dek, the next stories beside it, and a column of more headlines; one column where narrow.",
    tags: ["news", "layout", "article", "grid", "no-js"], demo: SectionFrontDemo })
