let post_stats_demo_views = [420, 380, 510, 460, 1240, 2860, 1930, 1180, 840, 720, 690, 560, 610, 480]
let post_stats_demo_reads = [170, 150, 220, 190, 560, 1310, 860, 480, 330, 280, 270, 210, 230, 160]

view PostStatsDemo() =
    <div style="max-width: 720px">
        <PostStats id="post-stats-demo" title="Islands, resumed: how a page wakes up" href="#post_stats" period="Oct 17 – 30, 2026"
                   views={12880} reads={5420} read_seconds={222} previous={{ views: 10100, reads: 3960, read_seconds: 236 }}
                   daily={range(14) | map((i) => { date: date.add_days("2026-10-17", i), views: post_stats_demo_views[i], reads: post_stats_demo_reads[i] })}
                   referrers={[{ source: "Hacker News", count: 5120, href: "#post_stats-hn" }, { source: "Newsletter", count: 2310 },
                               { source: "Search", count: 1904 }, { source: "Mastodon", count: 1288 }, { source: "Bluesky", count: 940 },
                               { source: "Direct", count: 870 }]}
                   likes={318} comments={42} shares={1}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "post_stats", name: "PostStats", group: "Blogging",
    summary: "How a post is doing, for its author: views, reads, read ratio and reading time against the period before, a bar a day, where readers came from.",
    tags: ["blogging", "dashboard", "chart", "analytics", "no-js"], demo: PostStatsDemo })
