let balance_card_demo_accounts = [
    { id: "main", name: "Everyday", last4: "4021", balance: 2481.07m, available: 2231.07m, currency: "USD" },
    { id: "save", name: "Savings", last4: "7730", balance: "15200.50", currency: "USD" },
    { id: "eur", name: "Euro wallet", balance: 318.40m, currency: "EUR" },
    { id: "card", name: "Credit card", last4: "1188", balance: -642.19m, available: 4357.81m, currency: "USD" },
]

component BalanceCardDemoLive() {
    state seen = "main"
    state told = "Nothing yet"
    <div.demo-stack>
        <BalanceCard accounts={balance_card_demo_accounts} updated_at="2026-11-01T09:37:00Z" now_at="2026-11-01T09:42:00Z"
                     on_change={(the_id) => { seen = the_id }} on_hide={(h) => { told = h ? "Hidden" : "Shown" }}/>
        <p.demo-note>Account: <span id="balcard-seen">{seen}</span>. Balances: <span id="balcard-told">{told}</span>.</p>
    </div>
}

view BalanceCardDemo() =
    <div.demo-stack>
        <BalanceCardDemoLive/>
        <div id="balcard-bad"><BalanceCard hidden={true} accounts={[{ id: "x", name: "Broken", balance: "abc" }, { id: "y", name: "Null", balance: null, currency: "JPY" }]} updated_at="nonsense"/></div>
        <div id="balcard-none"><BalanceCard/></div>
    </div>

ui_gallery = ui_gallery | push({ slug: "balance_card", name: "BalanceCard", group: "Mobile",
    summary: "Balances that hide with a tap and show for a hold, swiped between accounts, in decimals, with when they were read.",
    tags: ["mobile", "interactive", "banking", "balance", "swipe", "tablet"],
    needs: ["price"],
    demo: BalanceCardDemo })
