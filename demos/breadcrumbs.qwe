view BreadcrumbsDemo() =
    <div.demo-stack>
        <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Docs", href: "/docs/" },
                             { label: "Components", href: "/components/" }, { label: "Breadcrumbs" }]}/>
        <Breadcrumbs items={[{ label: "Acme Inc.", href: "/" }, { label: "Projects", href: "/projects" },
                             { label: "Quarterly marketing campaign for the spring launch", href: "/projects/41" },
                             { label: "Settings" }]}/>
        <p.demo-note>On a phone, the middle items are cut short; their whole label is a tooltip.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "breadcrumbs", name: "Breadcrumbs", group: "Navigation",
    summary: "Where this page sits: a trail of links up to the home page, the last one marked as this page.",
    demo: BreadcrumbsDemo })
