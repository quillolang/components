// Sounds made here so that the demo needs no file: 8-bit WAV at 3000 Hz, whose base64
// repeats by the three bytes: gICA is silence and gOAg a tone of 1000 Hz.
let voice_message_demo_short = "data:audio/wav;base64,UklGRp4XAABXQVZFZm10IBAAAAABAAEAuAsAALgLAAABAAgASlVOSwIAAAAAAGRhdGFwFwAA"
    + repeat("gICA", 500) + repeat("gOAg", 1000) + repeat("gICA", 500)
let voice_message_demo_long = "data:audio/wav;base64,UklGRg4vAABXQVZFZm10IBAAAAABAAEAuAsAALgLAAABAAgASlVOSwIAAAAAAGRhdGHgLgAA"
    + repeat(repeat("gOAg", 500) + repeat("gICA", 500), 4)

component VoiceMessageDemoLive() {
    state note = "Nothing heard yet."
    <div.demo-stack id="voice-message-demo">
        <VoiceMessage id="voice-message-a" src={voice_message_demo_short} seconds={2} from="Ana Silva" time="09:41"
                      on_played={() => { note = "Heard" }} on_speed={(r) => { note = `Speed ${r}` }}/>
        <div style="text-align: right">
            <VoiceMessage id="voice-message-b" mine={true} src={voice_message_demo_long} seconds={4} played={true} time="09:44"
                          peaks={[0.2, 0.9, 1, 0.4, "bad", 0.7, 2]} bars={7}/>
        </div>
        <VoiceMessage id="voice-message-c" from="Ben" seconds={75}/>
        <VoiceMessage id="voice-message-d" src={voice_message_demo_short} from="No length given" peaks={[0.4, 0.8]} bars={12}/>
        <p.demo-note id="voice-message-note" role="status">{note}</p>
    </div>
}

view VoiceMessageDemo() = <VoiceMessageDemoLive/>

ui_gallery = ui_gallery | push({ slug: "voice_message", name: "VoiceMessage", group: "Mobile",
    summary: "A voice message with its waveform to scrub, speed, whether it was heard, and only one playing at a time.",
    tags: ["mobile", "interactive", "chat", "audio", "voice", "player"], demo: VoiceMessageDemo })
