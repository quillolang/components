let grouped_table_demo_expenses = [
    { team: "Design", item: "Figma seats", when: "2026-03-02", amount: 540, share: 0.12 },
    { team: "Design", item: "Stock photos", when: "2026-03-14", amount: 89.5, share: 0.02 },
    { team: "Engineering", item: "Cloud hosting", when: "2026-03-01", amount: 2310.4, share: 0.51 },
    { team: "Engineering", item: "CI minutes", when: "2026-03-09", amount: 410, share: 0.09 },
    { team: "Engineering", item: "Laptops", when: "2026-03-21", amount: 1180, share: 0.26 },
    { team: "Sales", item: "Conference booth", when: "2026-03-11", amount: null, share: null },
]

let grouped_table_demo_scores = [
    { round: "Round 2", player: "Mika", points: 48 }, { round: "Round 1", player: "Ada", points: 51 },
    { round: "Round 1", player: "Mika", points: 44 }, { round: "Round 2", player: "Ada", points: 39 },
    { round: "Round 1", player: "Sol", points: 47 },
]

view GroupedTableDemo() =
    <div.demo-stack>
        <GroupedTable id="grouped-table-demo-expenses" label="Expenses by team" by="team" totals={["amount", "share"]}
                      show_count={true} rows={grouped_table_demo_expenses}
                      columns={[
                          { key: "item", label: "Item" },
                          { key: "when", label: "Date", format: "date" },
                          { key: "share", label: "Share", format: "percent" },
                          { key: "amount", label: "Amount", format: "money" },
                      ]}/>
        <GroupedTable id="grouped-table-demo-scores" label="Scores by round" by="round" order="asc" zebra={true}
                      grand={false} subtotal_label="Round total" rows={grouped_table_demo_scores}
                      totals={["points"]}
                      columns={[{ key: "player", label: "Player" }, { key: "points", label: "Points", format: "number" }]}/>
        <p.demo-note>Each group is a row heading over its own table body; the subtotal and total rows sum the columns named in <code>totals</code>.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "grouped_table", name: "GroupedTable", group: "Data",
    summary: "Rows under a heading per group, with a subtotal row after each group and a grand total, from a flat list.",
    tags: ["data", "table", "no-js"], demo: GroupedTableDemo })
