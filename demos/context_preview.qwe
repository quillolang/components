let context_preview_demo_css = css`
.context-preview-demo-trip { padding: 16px 60px 16px 16px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius); background: var(--ui-surface); }
.context-preview-demo-trip h3 { margin: 0 0 4px; font-size: 16px; }
.context-preview-demo-trip p { margin: 0; color: var(--ui-muted); font-size: 14px; }
.context-preview-demo-sub { margin: 8px 0 0; color: var(--ui-muted); font-size: 14px; }
`

component ContextPreviewDemoLive() {
    style global context_preview_demo_css
    state did = "nothing yet"
    state closes = 0
    <div.demo-stack>
        <ContextPreview label="Trip to Lisbon" title="Lisbon, 4 nights"
                        actions={[{ label: "Open", value: "open" }, "Share", { label: "Archive", value: "archive", disabled: true },
                                  { label: "Delete trip", value: "delete", destructive: true }]}
                        preview={<div>
                            <p>Flights on 12 May, back on 16 May. Hotel in Alfama, 3 bookings.</p>
                            <p class="context-preview-demo-sub">Shared with Ana and Tom.</p>
                        </div>}
                        on_pick={(v) => { did = v }} on_close={() => { closes += 1 }}>
            <div class="context-preview-demo-trip">
                <h3>Trip to Lisbon</h3>
                <p>12 to 16 May. Press and hold.</p>
            </div>
        </ContextPreview>
        <ContextPreview label="Trip to Oslo" stay={true} actions={["Open", "Share"]} on_pick={(v) => { did = `${v} Oslo` }}>
            <div class="context-preview-demo-trip">
                <h3>Trip to Oslo</h3>
                <p>This one stays open when you let go.</p>
            </div>
        </ContextPreview>
        <p.demo-note>Chosen: <span class="context-preview-demo-did">{did}</span>. Closed: <span class="context-preview-demo-closes">{closes}</span>.</p>
    </div>
}

view ContextPreviewDemo() = <ContextPreviewDemoLive/>

ui_gallery = ui_gallery | push({ slug: "context_preview", name: "ContextPreview", group: "Mobile",
    summary: "A long press lifts a card with the page blurred behind it, showing a preview and actions: slide to one and let go, or let go to close.",
    tags: ["mobile", "interactive", "tablet", "long-press", "menu", "gesture"],
    needs: ["action_sheet", "bottom_sheet"], demo: ContextPreviewDemo })
