view TicketDemo() =
    <div.demo-stack>
        <Ticket id="ticket-demo-ada" kind="Evening talk" event="Ada Lovelace Day" date="2026-10-13" time="19:30" venue="Royal Institution, London"
                section="Stalls" row="C" seat="12" holder="Grace Hopper" price="£24.00" number="0931" code="ALD-2026-0931"
                src="https://picsum.photos/seed/hall/800/300"/>
        <Ticket id="ticket-demo-ga" kind="General admission" event="Quillo Conf" date="2026-11-20" venue="Porto" gate="B" holder="Ada Lovelace" tone="success">
            <svg width="72" height="72" viewBox="0 0 8 8" shape-rendering="crispEdges" aria-label="A code" role="img">
                <path fill="currentColor" d="M0 0h3v3H0zM5 0h3v3H5zM0 5h3v3H0zM4 1h1v1H4zM1 1h1v1H1zM6 1h1v1H6zM1 6h1v1H1zM4 4h1v1H4zM6 5h2v1H6zM5 6h1v2H5zM7 7h1v1H7z"/>
            </svg>
        </Ticket>
    </div>

ui_gallery = ui_gallery | push({ slug: "ticket", name: "Ticket", group: "Data",
    summary: "An event ticket with a tear line and stub: event, date, venue, section, row and seat, the holder, a code or a QR as children.",
    tags: ["document", "card", "schedule", "print", "no-js"],
    demo: TicketDemo })
