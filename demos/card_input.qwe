component CardInputDemoLive() {
    state card = null
    <div.demo-stack>
        <CardInput name="ci-demo" label="Pay with a card" today="2026-11-20"
                   hint="A demo: 4242 4242 4242 4242 is a good number, 4242 4242 4242 4241 has a typo."
                   on_change={(c) => { card = c }}/>
        <p.demo-note>{card == null ? "Nothing typed." : card.complete ? `Ready: ${card.brand ?? "card"} ending ${slice(card.number, len(card.number) - 4, len(card.number))}, ${card.expiry}.` : "Not complete yet."}</p>
    </div>
}

view CardInputDemo() =
    <div.demo-stack>
        <CardInputDemoLive/>
        <CardInput name="ci-demo-off" label="Disabled" disabled={true}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "card_input", name: "CardInput", group: "Forms",
    summary: "A payment card as it is typed: the number grouped, the brand, MM/YY and the code, with typos said.",
    tags: ["forms", "input", "payment", "checkout", "interactive"],
    demo: CardInputDemo })
