let org_chart_demo_team = { name: "Ada Lovelace", title: "CTO", href: "#org_chart", note: "3 reports", children: [
    { name: "Grace Hopper", title: "Compilers", src: "https://i.pravatar.cc/80?img=47", children: [
        { name: "Jean Sammet", title: "Languages" }, { id: "fran", name: "Frances Allen", title: "Optimisation" },
    ] },
    { name: "Alan Turing", title: "Research", children: [{ name: "Joan Clarke", title: "Cryptanalysis" }] },
    { name: "Hedy Lamarr", title: "Radio", note: "Hiring" },
] }

view OrgChartDemo() =
    <div.demo-stack>
        <OrgChart id="org-chart-demo-full" label="Engineering" root={org_chart_demo_team} highlight="fran"/>
        <OrgChart id="org-chart-demo-compact" compact={true} label="Board" root={{ name: "Chair", children: [{ name: "Treasurer" }] }}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "org_chart", name: "OrgChart", group: "Data",
    summary: "A tree of people as boxes joined by lines, drawn with CSS on nested lists, with pictures, titles, notes and the reader's place marked.",
    tags: ["chart", "user", "list", "no-js"],
    needs: ["avatar"],
    demo: OrgChartDemo })
