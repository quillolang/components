component DurationInputDemoLive() {
    state secs = 1500
    <div.demo-stack>
        <DurationInput name="di-demo-cook" label="Cooking time" value={1500} seconds={false} on_change={(s) => { secs = s }}/>
        <p.demo-note>{secs == null ? "No time set." : `${secs} seconds.`}</p>
    </div>
}

view DurationInputDemo() {
    <div.demo-stack>
        <div.demo-row>
            <DurationInput name="di-demo-length" label="Length" value={5400} hint="Hours, minutes and seconds."/>
            <DurationInputDemoLive/>
        </div>
        <div.demo-row>
            <DurationInput name="di-demo-lap" label="Lap" hours={false} required={true}/>
            <DurationInput name="di-demo-bad" label="Timeout" value={0} error="Give it at least a second."/>
        </div>
    </div>
}

ui_gallery = ui_gallery | push({ slug: "duration_input", name: "DurationInput", group: "Forms",
    summary: "Hours, minutes and seconds typed side by side, giving one value in seconds, with the arrow keys and carrying past 59.",
    tags: ["forms", "input", "time", "interactive"], demo: DurationInputDemo })
