component UpdatePromptDemoLive() {
    state latest = "2.4.0"
    state name = ""
    state looks = 0
    state store = "Not pressed."
    let check = () => {
        looks += 1
        latest
    }
    <div.demo-phone>
        <div.demo-stack style="padding: 14px; overflow-y: auto; height: 100%; box-sizing: border-box; align-content: start">
            <input id="upgp-plain" aria-label="A plain field" placeholder="A plain field" style="min-height: 46px; font-size: 16px; padding: 0 10px"/>
            <input id="upgp-bound" aria-label="A field in state" placeholder="A field in state" style="min-height: 46px; font-size: 16px; padding: 0 10px" bind:value={name}/>
            <p.demo-note id="upgp-bound-says">{`State holds: ${name}.`}</p>
            <textarea name="upgp-notes" id="upgp-notes" aria-label="Notes" placeholder="Notes" style="min-height: 66px; font-size: 16px; padding: 8px 10px"></textarea>
            <input id="upgp-pass" type="password" aria-label="A password" placeholder="A password" style="min-height: 46px; font-size: 16px; padding: 0 10px"/>
            <input id="upgp-card" autocomplete="cc-number" aria-label="A card" placeholder="A card" style="min-height: 46px; font-size: 16px; padding: 0 10px"/>
            <div.demo-row>
                <Button size="lg" variant="outline" id="upgp-publish" on_click={() => { latest = "2.5.0" }}>Publish a new version</Button>
            </div>
            <p.demo-note id="upgp-looks">{`Looked ${looks} times.`}</p>
            <p.demo-note id="upgp-store">{store}</p>
        </div>
        <UpdatePrompt id="upgp-demo" version="2.4.0" check={check} every_ms={300} quiet_ms={500} later_ms={900} on_store={() => { store = "The store was asked for." }}/>
        <UpdatePrompt id="upgp-own" place="top" title="This page has changed" every_ms={1000} quiet_ms={0}/>
    </div>
}

view UpdatePromptDemo() = <UpdatePromptDemoLive/>

ui_gallery = ui_gallery | push({ slug: "update_prompt", name: "UpdatePrompt", group: "Mobile",
    summary: "Notices a new version of the program, offers a reload at a good moment, without losing input.",
    tags: ["mobile", "interactive", "offline", "update", "reload", "tablet"],
    demo: UpdatePromptDemo })
