component FabDemoLive() {
    state calls = 0
    <div.demo-stack>
        <div style="position: relative; height: 120px; border: 1px dashed var(--ui-border); border-radius: var(--ui-radius)">
            <Fab id="fab-demo-call" label="Call us" icon="phone" tone="neutral" inline={true} on_click={() => { calls += 1 }}/>
        </div>
        <p.demo-note>{calls == 0 ? "Not called yet." : `Called ${calls} ${calls == 1 ? "time" : "times"}.`}</p>
    </div>
}

view FabDemo() =
    <div.demo-stack>
        <div style="position: relative; height: 150px; border: 1px dashed var(--ui-border); border-radius: var(--ui-radius)">
            <Fab id="fab-demo-new" label="New message" icon="edit" href="#fab" inline={true}/>
            <Fab id="fab-demo-add" label="Add" extended={true} corner="bottom-left" inline={true}/>
            <Fab label="Search" icon="search" size="sm" corner="top-right" inline={true}/>
            <Fab label="Delete" icon="x" tone="danger" size="lg" corner="top-left" inline={true}/>
        </div>
        <p.demo-note>These are inline, in the corners of the box above; without inline they sit in the corners of the screen.</p>
        <FabDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "fab", name: "Fab", group: "Actions",
    summary: "A round floating action button fixed to a corner of the screen, with an icon and an optional label.",
    tags: ["button", "forms", "mobile", "no-js"],
    demo: FabDemo })
