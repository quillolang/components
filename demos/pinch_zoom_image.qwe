// A picture with a size of its own, 3:2, that needs no network.
let pinch_zoom_image_demo_src = "data:image/svg+xml," + url_encode("<svg xmlns='http://www.w3.org/2000/svg' width='1200' height='800' viewBox='0 0 1200 800'><defs><linearGradient id='s' x2='0' y2='1'><stop offset='0' stop-color='#9ec5fe'/><stop offset='1' stop-color='#fde2b3'/></linearGradient></defs><rect width='1200' height='800' fill='url(#s)'/><circle cx='930' cy='180' r='80' fill='#fff3bf'/><path d='M0 620 260 300 480 560 700 240 1200 660V800H0z' fill='#4b6a88'/><path d='M0 700 320 520 620 700 900 560 1200 720V800H0z' fill='#2f4858'/><g fill='#fff'><circle cx='180' cy='120' r='5'/><circle cx='420' cy='90' r='4'/><circle cx='640' cy='150' r='3'/></g></svg>")

component PinchZoomImageDemoLive() {
    state scale = 1
    <div.demo-stack>
        <PinchZoomImage src={pinch_zoom_image_demo_src} alt="Mountains under a pale sky" label="Mountains" height="320px" on_zoom={(s) => { scale = s }}/>
        <p.demo-note id="pinch-zoom-said">Settled at {scale}. Pinch, double tap, or use the buttons.</p>
        // Bad data, for the test to look at: nothing here should stop the page.
        <div id="pinch-zoom-bad" hidden="true"><PinchZoomImage src="data:image/png;base64,AAAA" alt="Broken" limit={0}/><PinchZoomImage src=""/></div>
    </div>
}

view PinchZoomImageDemo() = <PinchZoomImageDemoLive/>

ui_gallery = ui_gallery | push({ slug: "pinch_zoom_image", name: "PinchZoomImage", group: "Mobile",
    summary: "Pinch and double tap to zoom an image, pan to its edges, with a rubber band at the limits and zoom buttons as well.",
    tags: ["mobile", "interactive", "gesture", "pinch", "image", "tablet"],
    demo: PinchZoomImageDemo })
