component DebtPayoffDemoLive() {
    state note = "Change something to see on_change."
    <div.demo-stack>
        <DebtPayoff id="debt-payoff-demo-live" name="loans" title="A minimum below the interest" currency="EUR" extra="0" plan="snowball"
                    debts={[{ name: "Payday", balance: 1000, rate: 120, minimum: 50 }, { name: "Card", balance: 500, rate: 20, minimum: 100 }]}
                    on_change={(r) => { note = `on_change: avalanche ${r.avalanche.months} months, ${r.avalanche.interest} interest, first ${r.avalanche.order[0]}.` }}/>
        <p.demo-note>{note}</p>
    </div>
}

view DebtPayoffDemo() =
    <div.demo-stack>
        <DebtPayoff id="debt-payoff-demo" extra="200"
                    debts={[{ name: "Card", balance: 4000, rate: 22.9, minimum: 100 }, { name: "Car", balance: "2500", rate: 6.5, minimum: 120 }, { name: "Store", balance: 900, rate: 12, minimum: 35 }]}/>
        <DebtPayoffDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "debt_payoff", name: "DebtPayoff", group: "Finance",
    summary: "Compares avalanche and snowball on several debts with an extra payment: months, interest, payoff order, each month, and warns of a debt that never clears.",
    tags: ["smart", "interactive", "finance", "debt", "loans", "payoff"], demo: DebtPayoffDemo })
