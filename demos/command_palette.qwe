let command_palette_demo_pages = [
    { label: "Button", group: "Actions", href: "#button", keywords: ["submit", "link"] },
    { label: "Dropdown menu", group: "Actions", href: "#dropdown_menu", keywords: ["options"] },
    { label: "Data table", group: "Data", href: "#data_table", keywords: ["grid", "rows", "sort"] },
    { label: "Timeline", group: "Data", href: "#timeline", keywords: ["history", "activity"] },
    { label: "File drop", group: "Forms", href: "#file_drop", keywords: ["upload", "attachment"] },
    { label: "Modal", group: "Overlays", href: "#modal", keywords: ["dialog", "popup"] },
    { label: "Navigation bar", group: "Layout", href: "#navbar", keywords: ["header", "menu"] },
    { label: "Dark theme", group: "Theme", href: "?theme=dark", hint: "Ctrl Shift L", keywords: ["night"] },
    { label: "Light theme", group: "Theme", href: "?theme=light", keywords: ["day"] },
]

let command_palette_demo_actions = [
    { label: "New file", group: "File", hint: "Ctrl N" },
    { label: "Open file…", group: "File", hint: "Ctrl O" },
    { label: "Save all", group: "File", hint: "Ctrl Alt S" },
    { label: "Close window", group: "File", hint: "Ctrl W" },
    { label: "Find in files", group: "Edit", hint: "Ctrl Shift F", keywords: ["search", "grep"] },
    { label: "Format document", group: "Edit", keywords: ["prettier", "indent"] },
    { label: "Toggle line comment", group: "Edit", hint: "Ctrl /" },
    { label: "Go to line…", group: "Go", hint: "Ctrl G" },
    { label: "Go to symbol…", group: "Go", hint: "Ctrl Shift O" },
    { label: "Run tests", group: "Terminal", keywords: ["check", "spec"] },
    { label: "Restart server", group: "Terminal" },
]

component CommandPaletteDemoLive() {
    state ran = null
    <div.demo-stack>
        <CommandPalette id="cmdk-actions" trigger="Run a command…" shortcut={false} recent={0}
                        label="Commands" items={command_palette_demo_actions} on_select={(c) => { ran = c.label }}/>
        <p.demo-note>{ran == null ? "Nothing run yet." : `Ran “${ran}”.`}</p>
    </div>
}

view CommandPaletteDemo() =
    <div.demo-stack>
        <div.demo-stack>
            <CommandPalette id="cmdk-site" trigger="Search the kit…" label="Search the kit" items={command_palette_demo_pages}/>
            <p.demo-note>Press Ctrl+K (⌘K on a Mac) anywhere on this page. Try “dtbl”, “dark” or “upload”: choosing one goes to it.</p>
        </div>
        <CommandPaletteDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "command_palette", name: "CommandPalette", group: "Overlays",
    summary: "Ctrl+K opens a fuzzy search of commands and pages, grouped, with keys, recent picks and the arrow keys.",
    tags: ["overlay", "search", "keyboard", "interactive"],
    demo: CommandPaletteDemo })
