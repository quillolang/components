view ActionBarDemo() =
    <div.demo-stack>
        <ActionBar text="€95 a night" detail="5 – 9 Nov · 2 guests · €552.80 in all">
            <Button>Reserve</Button>
        </ActionBar>
        <p.demo-note>On a phone it is fixed to the bottom of the screen, with room left for it at the end of the page.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "action_bar", name: "ActionBar", group: "Layout",
    summary: "A page's main action and a line about it, fixed to the bottom of the screen on a phone.",
    demo: ActionBarDemo })
