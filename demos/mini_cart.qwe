let mini_cart_demo_items = [
    { id: "runner", name: "Trail runner", price: 89, quantity: 1, image: "https://picsum.photos/seed/runner/100/100", options: ["Size 42", "Black"] },
    { id: "beanie", name: "Wool beanie", price: 24, quantity: 2, image: "https://picsum.photos/seed/beanie/100/100" },
    { id: "socks", name: "Merino socks, 3 pairs", price: 29, quantity: 1 },
]

component MiniCartDemoLive() {
    state removed = []
    <div.demo-row>
        <MiniCart id="mini-cart-demo-live" items={mini_cart_demo_items} cart_href="#cart_item" checkout_href="#checkout_steps"
                  on_remove={(id) => { removed = removed | push(id) }}/>
        <p.demo-note>{len(removed) == 0 ? "Open the bag; × removes an item (on_remove)." : `Removed: ${join(removed, ", ")}.`}</p>
    </div>
}

view MiniCartDemo() =
    <div.demo-stack>
        <MiniCartDemoLive/>
        <div.demo-row>
            <MiniCart id="mini-cart-demo-plain" items={mini_cart_demo_items} currency="EUR" locale="de-DE" cart_href="#cart_item" checkout_href="#checkout_steps" align="start"/>
            <MiniCart id="mini-cart-demo-empty" items={[]} cart_href="#cart_item"/>
            <p.demo-note>Without on_remove the items are read-only; an empty bag says so.</p>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "mini_cart", name: "MiniCart", group: "Commerce",
    summary: "A bag icon with the count that opens a small panel of the items, the subtotal and the way to the cart and checkout.",
    tags: ["commerce", "cart", "popover", "navigation", "interactive"],
    needs: ["price"], demo: MiniCartDemo })
