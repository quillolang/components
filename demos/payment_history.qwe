view PaymentHistoryDemo() {
    <div.demo-stack>
        <PaymentHistory id="payment-history-demo-home" account="Harbor Federal, home loan •••• 4821" start="2024-11" statuses={[
            "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "30", "ok", "ok", "ok",
            "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok", "ok"]}/>
        <PaymentHistory id="payment-history-demo-card" account="Northwind Visa •••• 7710" start="2024-11" statuses={[
            "none", "none", "ok", "ok", "30", "60", "90", "120", "ok", "ok", "ok", "none",
            "ok", "30", "ok", "ok", "ok", "ok", "ok", null, "ok", "ok", "ok", "ok"]}/>
    </div>
}

ui_gallery = ui_gallery | push({ slug: "payment_history", name: "PaymentHistory", group: "Finance",
    summary: "Twenty-four months of payments as a grid of years and months, on time, 30, 60 or 90 days late, or nothing due, as credit reports show them, with a legend.",
    tags: ["finance", "loans", "chart", "data", "no-js"], demo: PaymentHistoryDemo })
