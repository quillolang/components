view ArticleCardDemo() =
    <div.demo-stack>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 16px">
            <ArticleCard id="article-card-demo-first" href="#article_card" src="https://picsum.photos/seed/islands/640/360" alt="Rocks in a calm sea"
                         category="Engineering" category_href="#article_card" title="Islands, resumed"
                         excerpt="How a page's components wake up exactly where the server left them, without rendering twice."
                         author="Ada Lovelace" date="2026-10-12" read_time="4 min read" tags={["components", "runtime"]}/>
            <ArticleCard href="#article_card" src="https://picsum.photos/seed/forms/640/360" category="Guides" title="Forms that post without a script"
                         excerpt="Every field in the kit is a real input, so a plain form sends it." author="Grace Hopper"
                         author_src="https://i.pravatar.cc/64?img=47" date="2026-09-28" read_time="7 min read"/>
            <ArticleCard id="article-card-demo-bare" href="#article_card" title="Release notes, October" date="2026-10-01"/>
        </div>
        <ArticleCard id="article-card-demo-wide" layout="horizontal" href="#article_card" src="https://picsum.photos/seed/wide/640/400"
                     category="Design" title="One theme, two modes"
                     excerpt="Every colour is a variable, so dark mode is the system's choice and yours: set ui-dark on any element."
                     author="Alan Turing" date="2026-08-15" read_time="3 min read"/>
    </div>

ui_gallery = ui_gallery | push({ slug: "article_card", name: "ArticleCard", group: "Data",
    summary: "A post to click into: image, category, title, excerpt, author, date and reading time; image on top or to the side.",
    tags: ["card", "marketing", "page", "link", "no-js"],
    needs: ["avatar"],
    demo: ArticleCardDemo })
