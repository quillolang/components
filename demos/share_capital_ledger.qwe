            { date: "2024-01-15", description: "Initial paid-up capital", ref: "OR-10233", amount: 5000 },
            { date: "2024-02-29", description: "Salary deduction", amount: 1000 },
            { date: "2024-03-31", description: "Salary deduction", amount: 1000 },
            { date: "2024-06-28", description: "Cash contribution", ref: "OR-10877", amount: 2500 },
            { date: "2025-03-31", description: "2024 dividend converted to shares", amount: 1840.25 },
            { date: "2025-06-10", description: "Transfer to member M-009914", ref: "JV-2025-061", amount: -500 },
            { date: "2025-09-30", description: "Salary deduction", amount: 1500 },
