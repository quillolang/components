        <ShareCapitalLedger id="share-capital-ledger-demo-paid" title="Membership share" required={500} entries={[
            { date: "2025-01-06", description: "First installment", amount: 250 },
            { date: "2025-04-07", description: "Second installment", amount: 250 },
            { date: "2026-01-31", description: "Patronage credited", amount: 25.5 },
