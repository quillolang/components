component BarcodeDemoLive() {
    state text = "Hello 2026"
    <div.demo-stack style="justify-items: start">
        <label style="display: grid; gap: 4px; font-size: 13px; width: min(320px, 100%)">Text to encode
            <input id="barcode-demo-input" value={text} @input={(e) => { text = e.value }}
                   style="height: 34px; padding: 0 10px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius-sm); background: var(--ui-surface); color: var(--ui-fg); font: inherit"/>
        </label>
        <Barcode id="barcode-demo-live" text={text}/>
        <p.demo-note>{len(barcode_values(text))} symbols, drawn in the browser as you type.</p>
    </div>
}

view BarcodeDemo() =
    <div.demo-stack>
        <div.demo-row style="align-items: flex-end; gap: 28px">
            <Barcode id="barcode-demo-ticket" text="QA204-LHR-OPO"/>
            <Barcode id="barcode-demo-digits" text="0012345678905" bar={1.5} height={48}/>
            <Barcode id="barcode-demo-bare" text="Order 98765" show_text={false} height={40} themed={true} label="Order number"/>
        </div>
        <BarcodeDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "barcode", name: "Barcode", group: "Data",
    summary: "A Code 128 barcode drawn as SVG from text, switching to the compact digit set for long numbers, with the text under it.",
    tags: ["image", "data", "document", "commerce", "no-js"],
    demo: BarcodeDemo })
