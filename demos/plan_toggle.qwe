component PlanToggleDemoLive() {
    state period = "monthly"
    <div.demo-stack>
        <PlanToggle name="plan-toggle-demo-live" saving={20} on_change={(p) => { period = p }}/>
        <p.demo-note>Pro costs {period == "yearly" ? "$115 a year ($9.60 a month)" : "$12 a month"} (on_change).</p>
    </div>
}

view PlanToggleDemo() =
    <div.demo-stack>
        <PlanToggleDemoLive/>
        <div.demo-row style="gap: 20px">
            <PlanToggle name="plan-toggle-demo-free" value="yearly" saving="2 months free"/>
            <PlanToggle name="plan-toggle-demo-sm" size="sm" labels={["Pay monthly", "Pay yearly"]} values={["m", "y"]}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "plan_toggle", name: "PlanToggle", group: "Commerce",
    summary: "Monthly or yearly billing as a pill of two radios, with the saving shown on the yearly side.",
    tags: ["commerce", "price", "forms", "select", "interactive"], demo: PlanToggleDemo })
