let form_wizard_demo_steps = [
    { title: "Account", text: "How you sign in.", fields: [
        { name: "email", label: "Email", type: "email", required: true, autocomplete: "email" },
        { name: "password", label: "Password", type: "password", required: true, hint: "At least 8 characters." },
    ] },
    { title: "Team", fields: [
        { name: "team", label: "Team name", required: true, placeholder: "Acme" },
        { name: "size", label: "Team size", type: "select", required: true, options: ["Just me", "2 to 10", "11 to 50", "More"] },
        { name: "plan", label: "Plan", type: "radio", options: [{ label: "Free", value: "free" }, { label: "Pro", value: "pro" }] },
    ] },
    { title: "Extras", fields: [
        { name: "about", label: "What will you build?", type: "textarea", rows: 2 },
        { name: "news", label: "Email me product news", type: "checkbox" },
    ] },
]

component FormWizardDemoLive() {
    state step = 0
    state sent = null
    <div.demo-stack>
        <FormWizard id="form-wizard-demo" steps={form_wizard_demo_steps} values={{ plan: "free" }}
                    on_step={(i) => { step = i }} on_submit={(v) => { sent = v }}/>
        <p.demo-note>{sent != null ? `on_submit got ${sent.email}, team ${sent.team}, plan ${sent.plan}.` : `on_step: ${step}`}</p>
    </div>
}

view FormWizardDemo() =
    <div.demo-stack>
        <FormWizardDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "form_wizard", name: "FormWizard", group: "Forms",
    summary: "A long form in steps, with the steps shown, Back and Next that check each step, and a review with Edit before it is sent as one form.",
    tags: ["forms", "progress", "interactive"], demo: FormWizardDemo })
