view BadgeDemo() =
    <div.demo-stack>
        <div.demo-row>
            <Badge>Draft</Badge>
            <Badge tone="accent">New</Badge>
            <Badge tone="success">Paid</Badge>
            <Badge tone="warning">Overdue</Badge>
            <Badge tone="danger">Failed</Badge>
            <Badge tone="info">Beta</Badge>
        </div>
        <div.demo-row>
            <Badge tone="success" dot={true}>Online</Badge>
            <Badge tone="warning" dot={true} variant="outline">Degraded</Badge>
            <Badge tone="danger" dot={true} variant="solid">Down</Badge>
            <Badge variant="outline">Outline</Badge>
            <Badge tone="accent" variant="solid">Solid</Badge>
            <Badge size="sm" tone="info">Small</Badge>
        </div>
        <div.demo-row>
            <span>Inbox <Badge tone="danger" variant="solid" count={3} label="unread messages"/></span>
            <span>Mentions <Badge tone="accent" count={42}/></span>
            <span>Notifications <Badge tone="danger" variant="solid" count={128} label="notifications"/></span>
            <span>Tasks <Badge size="sm" count={7}/></span>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "badge", name: "Badge", group: "Feedback",
    summary: "A small pill for a status or a count: six tones, soft, solid or outline, a status dot, and 99+.",
    tags: ["feedback", "status", "no-js"],
    demo: BadgeDemo })
