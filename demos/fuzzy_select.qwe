let fuzzy_select_demo_cities = [{ label: "Lisbon", value: "LIS", hint: "Portugal" }, { label: "London", value: "LON", hint: "United Kingdom" }, { label: "Los Angeles", value: "LAX", hint: "United States" },
    { label: "Luxembourg", value: "LUX" }, { label: "São Paulo", value: "SAO", hint: "Brazil" }, { label: "Salzburg", value: "SZG" }, { label: "San Salvador", value: "SAL" },
    { label: "Zürich", value: "ZRH", hint: "Switzerland" }, { label: "Kraków", value: "KRK" }, { label: "Reykjavík", value: "REK" }, { label: "New York", value: "NYC" },
    { label: "Newark", value: "EWR" }, { label: "Auckland", value: "AKL", hint: "New Zealand" }, { label: "Straße des 17. Juni", value: "STR" }, { label: "Москва", value: "MOW" }]

component FuzzySelectDemoLive() {
    state got = null
    <div.demo-stack>
        <FuzzySelect id="fuzzy-select-demo-live" name="assignee" label="Assignee" options={["Ana Núñez", "Ben Okafor", "Bo Li", "Chloé Martin"]} value="Bo Li"
                     on_change={(v) => { got = { v } }}/>
        <p.demo-note>{got == null ? "Pick someone to see on_change." : `on_change: ${got.v ?? "nothing"}`}</p>
    </div>
}

view FuzzySelectDemo() =
    <div class="demo-stack demo-narrow">
        <form>
            <FuzzySelect id="fuzzy-select-demo" name="city" label="City" options={fuzzy_select_demo_cities} recent={["ZRH", "LON"]} placeholder="Try sao, nyc or krk"/>
        </form>
        <FuzzySelectDemoLive/>
        <FuzzySelect id="fuzzy-select-demo-many" label="Part number" options={range(3000) | map((i) => `Part ${i} of the catalogue`)} limit={20}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "fuzzy_select", name: "FuzzySelect", group: "Forms",
    summary: "A combobox that ranks options by fuzzy subsequence score with matched letters highlighted and recent picks first, ignoring case and accents, with full ARIA keyboard behaviour and a real field.",
    tags: ["smart", "interactive", "combobox", "search", "fuzzy", "forms"], needs: ["slug_input"], demo: FuzzySelectDemo })
