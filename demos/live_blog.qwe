let live_blog_demo_entries = [
    { id: "pin", pinned: true, time: "19:05", title: "What we know so far",
      body: "Polls have closed in 31 states. The Senate is the race to watch: each party needs four of the seven toss-ups to hold a majority.\n\nWe will call races only when our decision desk is sure." },
    { id: "u11", time: "21:48", datetime: "2026-11-03T21:48:00-05:00", key: true, tag: "Senate", title: "Ohio Senate race called",
      body: "The Ledger's decision desk calls Ohio for the challenger, the first seat to change hands tonight.", author: "Ada Lovelace, decision desk" },
    { id: "u10", time: "21:40", body: "Turnout in the capital is running about 6% ahead of the last midterm, the elections office says." },
    { id: "u9", time: "21:31", tag: "House", body: "Three House seats in the suburbs are too close to call with about 70% of the expected vote counted." },
    { id: "u8", time: "21:15", datetime: "2026-11-03T21:15:00-05:00", key: true, tag: "Governor", title: "Governor concedes",
      body: "The incumbent governor has conceded in a short statement outside her campaign office.", author: "Grace Hopper, in Columbus" },
    { id: "u7", time: "20:58", body: "Lines are still long at some polling places; anyone in line at closing time can still vote." },
    { id: "u6", time: "20:40", tag: "Analysis", body: "Early returns lean towards the incumbents, but the mail-in ballots, which are counted later, may shift that." },
    { id: "u5", time: "20:22", body: "A judge has kept three precincts open an hour longer after their machines broke down this morning." },
    { id: "u4", time: "20:00", datetime: "2026-11-03T20:00:00-05:00", key: true, title: "Polls close in 16 more states",
      body: "Polls are now closed in most of the East and the Midwest." },
    { id: "u3", time: "19:30", body: "Our reporters are at the campaigns' parties in six states tonight." },
    { id: "u2", time: "19:12", body: "The first counties have started to report their results." },
    { id: "u1", time: "19:00", datetime: "2026-11-03T19:00:00-05:00", title: "Welcome", body: "Welcome to our live coverage of election night." },
]

view LiveBlogDemo() =
    <LiveBlog id="live-blog-demo" title="Election night live" updated="Updated 2 min ago" page_size={5} entries={live_blog_demo_entries}/>

ui_gallery = ui_gallery | push({ slug: "live_blog", name: "LiveBlog", group: "News",
    summary: "A live blog: timestamped updates with a pinned summary on top, key events that jump to their entry, key-events-only and oldest-first switches, and paging.",
    tags: ["news", "live", "feed", "time", "interactive"], demo: LiveBlogDemo })
