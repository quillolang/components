let decision_matrix_demo_options = ["Atlas", "Birch", "Cedar"]
let decision_matrix_demo_criteria = [{ name: "Price", weight: 40, cost: true }, { name: "Quality", weight: 35 }, { name: "Support", weight: 25 }]
let decision_matrix_demo_scores = [[1200, 8, 7], [900, 6, 9], [1500, 9, 5]]

component DecisionMatrixDemoLive() {
    state seen = "Change a figure to see on_change."
    <div.demo-stack>
        <DecisionMatrix id="decision-matrix-demo-live" title="Where to hold the offsite" name="venue" options={["Lisbon", "Porto"]}
                        criteria={[{ name: "Cost", weight: 1, cost: true }, { name: "Flights", weight: 1 }]} scores={[[10, 2], [20, 4]]}
                        on_change={(r) => { seen = r == null ? "on_change: something is missing." : `on_change: ${join(r.winners, " and ")}${r.tied ? " tied" : ""}.` }}/>
        <p.demo-note>{seen}</p>
    </div>
}

view DecisionMatrixDemo() =
    <div.demo-stack>
        <DecisionMatrix id="decision-matrix-demo" title="Choosing a supplier" options={decision_matrix_demo_options} criteria={decision_matrix_demo_criteria} scores={decision_matrix_demo_scores}/>
        <DecisionMatrixDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "decision_matrix", name: "DecisionMatrix", group: "Dashboard",
    summary: "Ranks options on weighted criteria, cost counting against them, shows ties as ties, and says how far each weight must move to change the winner.",
    tags: ["smart", "interactive", "decision", "ranking", "weights", "analysis"], demo: DecisionMatrixDemo })
