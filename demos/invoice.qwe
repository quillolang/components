view InvoiceDemo() =
    <div.demo-stack>
        <Invoice id="invoice-demo-due" number="INV-2026-0042" date="2026-10-01" due="2026-10-31" status="due"
                 logo="https://dummyimage.com/180x44/5b4bdb/ffffff.png&text=ENGINES"
                 from={{ name: "Analytical Engines Ltd", lines: ["1 Difference Street", "London N1 9AA"], email: "billing@example.com", tax_id: "VAT GB 123 4567 89" }}
                 to={{ name: "Babbage & Co", lines: ["22 Dorset Street", "London W1U 6QW"], email: "charles@example.com" }}
                 lines={[
                     { description: "Design", detail: "October, 12 days at the day rate", qty: 12, unit: "€90.00", amount: "€1,080.00" },
                     { description: "Hosting", detail: "Two services, one region", qty: 1, unit: "€120.00", amount: "€120.00" },
                     { description: "Domain renewal", qty: 2, unit: "€14.50", amount: "€29.00" },
                 ]}
                 subtotal="€1,229.00" discount="−€29.00" tax="€240.00" tax_label="VAT 20%" total="€1,440.00" paid="€500.00" balance="€940.00"
                 notes="Thank you for your business.\nBank: Example Bank, IBAN GB00 EXMP 0000 0000 0000 00" terms="Payable within 30 days. Late payments carry 2% a month."/>
        <Invoice id="invoice-demo-paid" number="Q-118" title="Quote" date="2026-09-12" status="paid"
                 to={{ name: "Ada Lovelace" }} lines={[{ description: "A short consult", amount: "$250.00" }]} total="$250.00"/>
    </div>

ui_gallery = ui_gallery | push({ slug: "invoice", name: "Invoice", group: "Data",
    summary: "A printable invoice: parties, number and dates, lines with quantity and unit price, totals, paid and balance, notes and terms.",
    tags: ["document", "commerce", "price", "print", "record", "no-js"],
    demo: InvoiceDemo })
