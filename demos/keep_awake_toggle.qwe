component KeepAwakeToggleDemoLive() {
    state seen = "Nothing yet."
    state no = "none"
    <div.demo-stack>
        <KeepAwakeToggle hint="For the length of the recipe." on_change={(on, how) => { seen = `on_change: ${on}, ${how ?? "none"}.` }}
                         on_refused={(why) => { no = why }}/>
        <p.demo-note id="keep-awake-toggle-demo-note">{seen} Last refused: {no}.</p>
        <KeepAwakeToggle label="On from the start" start={true}/>
    </div>
}

view KeepAwakeToggleDemo() = <KeepAwakeToggleDemoLive/>

ui_gallery = ui_gallery | push({ slug: "keep_awake_toggle", name: "KeepAwakeToggle", group: "Mobile",
    summary: "Holds the screen on with the app or the Wake Lock, takes it again on coming back, and says when it was refused.",
    tags: ["mobile", "interactive", "wake-lock", "screen", "switch"],
    demo: KeepAwakeToggleDemo })
