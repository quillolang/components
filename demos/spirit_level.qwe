component SpiritLevelDemoLive() {
    state seen = "Not level yet."
    state times = 0
    <div.demo-stack>
        <SpiritLevel on_level={(on, r) => {
            if on { times += 1 }
            seen = `${on ? "Level" : "Off level"} in ${r.mode}, x ${round(r.x, 1)}, y ${round(r.y, 1)}.`
        }}/>
        <p.demo-note id="spirit-level-demo-note">{seen} Reached {times} times.</p>
    </div>
}

view SpiritLevelDemo() = <SpiritLevelDemoLive/>

ui_gallery = ui_gallery | push({ slug: "spirit_level", name: "SpiritLevel", group: "Mobile",
    summary: "A bubble level from the device's motion, with a zero, a haptic when level, and a message where there is no sensor.",
    tags: ["mobile", "interactive", "level", "motion", "sensor"],
    needs: ["button"],
    demo: SpiritLevelDemo })
