let activity_feed_demo_items = [
    { day: "Today", who: "Ada Lovelace", action: "commented on", target: "Invoice #1041", href: "#inv-1041", icon: "comment",
      time: "2 h ago", datetime: "2026-10-28T09:12:00Z", body: "Sent to accounts; they pay on the 30th." },
    { day: "Today", who: "Grace Hopper", action: "merged", target: "pull request #212", href: "#pr-212", icon: "merge", time: "5 h ago" },
    { day: "Today", who: "Alan Turing", action: "deleted", target: "draft-q3.pdf", icon: "delete", time: "6 h ago" },
    { day: "Yesterday", who: "Katherine Johnson", action: "created the project", target: "Moon shot", icon: "create", time: "Oct 27, 16:40" },
    { day: "Yesterday", who: "Hedy Lamarr", action: "starred", target: "quillo/components", icon: "star", time: "Oct 27, 11:02" },
]

view ActivityFeedDemo() =
    <div.demo-row style="align-items: flex-start; gap: 32px">
        <div style="flex: 1 1 320px; max-width: 460px">
            <ActivityFeed id="activity-feed-demo-main" label="Recent activity" items={activity_feed_demo_items}/>
        </div>
        <div style="flex: 1 1 240px; max-width: 320px">
            <ActivityFeed id="activity-feed-demo-compact" label="Deploys" compact={true} items={[
                { who: "CI", action: "deployed", target: "v1.8.2", icon: "check", time: "09:40" },
                { who: "Mika", action: "uploaded", target: "build.tar.gz", icon: "upload", time: "09:31" },
                { who: "Sol", action: "tagged", target: "v1.8.2", icon: "tag", tone: "accent", time: "09:30" },
            ]}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "activity_feed", name: "ActivityFeed", group: "Data",
    summary: "A stream of what people did, with their pictures, an icon for each kind of action, when, quotes and day headings.",
    tags: ["data", "list", "social", "time", "no-js"], demo: ActivityFeedDemo })
