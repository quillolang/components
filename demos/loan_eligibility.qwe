component LoanEligibilityDemoLive() {
    state verdict = "none yet"
    <div.demo-stack>
        <LoanEligibility id="loan-eligibility-demo-filled" name="filled" income={4200} debts={650} amount={15000} apply_href="#apply"
                         on_change={(r) => { verdict = r.verdict ?? "none yet" }}/>
        <p.demo-note id="loan-eligibility-demo-note">on_change: {verdict}</p>
    </div>
}

view LoanEligibilityDemo() {
    <div.demo-stack>
        <LoanEligibilityDemoLive/>
        <LoanEligibility id="loan-eligibility-demo-empty" name="empty" label="Check before you apply" rate={6.9} term={84} max_dti={36}
                         currency="EUR" locale="de-DE"/>
    </div>
}

ui_gallery = ui_gallery | push({ slug: "loan_eligibility", name: "LoanEligibility", group: "Finance",
    summary: "Four questions (income, debts, work, amount) and, as they are answered, whether a loan is likely, the amount within reach and why.",
    tags: ["finance", "loans", "forms", "calculator", "interactive"], demo: LoanEligibilityDemo })
