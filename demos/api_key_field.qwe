component ApiKeyFieldDemoLive() {
    state looks = 0
    <div.demo-stack>
        <ApiKeyField label="Live key" value="qk_live_4f9a2b7c1d3e5f6a7b8c9d0e" name="live_key" id="api-key-demo"
                     on_reveal={(s) => { if s { looks += 1 } }}/>
        <p.demo-note>{looks == 0 ? "Not revealed yet." : `Revealed ${looks} time${looks == 1 ? "" : "s"}.`}</p>
    </div>
}

view ApiKeyFieldDemo() =
    <div.demo-stack.demo-narrow>
        <ApiKeyFieldDemoLive/>
        <ApiKeyField label="Webhook secret" value="whsec_9a8b7c6d5e4f3a2b1c0d" shown={true} hint="Shown once; copy it now." size="sm"/>
    </div>

ui_gallery = ui_gallery | push({ slug: "api_key_field", name: "ApiKeyField", group: "Dashboard",
    summary: "A secret shown masked in a read-only field, with Show and Copy buttons and a hidden input for forms.",
    tags: ["dashboard", "security", "settings", "forms", "input", "interactive"],
    demo: ApiKeyFieldDemo })
