view BlockquoteDemo() =
    <div.demo-stack>
        <Blockquote author="Ada Lovelace" source="Notes on the Analytical Engine, 1843" id="blockquote-demo-ada">
            The Analytical Engine weaves algebraic patterns just as the Jacquard loom weaves flowers and leaves.
        </Blockquote>
        <Blockquote variant="marks" author="Grace Hopper" source="Interview" href="https://en.wikipedia.org/wiki/Grace_Hopper"
                    id="blockquote-demo-grace">
            <p>The most dangerous phrase in the language is, "we've always done it this way."</p>
        </Blockquote>
        <Blockquote variant="plain" size="lg" author="Someone on the team" id="blockquote-demo-plain">
            Ship the smallest thing that teaches you something.
        </Blockquote>
        <Blockquote id="blockquote-demo-bare">A quote with no one named.</Blockquote>
    </div>

ui_gallery = ui_gallery | push({ slug: "blockquote", name: "Blockquote", group: "Typography",
    summary: "A quotation with the person and the source in a figure, as a bar, with a quote mark, or plain.",
    tags: ["typography", "text", "document", "no-js"],
    demo: BlockquoteDemo })
