let avatar_demo_team = [
    { name: "Ada Lovelace", status: "online" },
    { name: "Grace Hopper", src: "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'%3E%3Crect width='40' height='40' fill='%23c9b8f5'/%3E%3Ccircle cx='20' cy='16' r='7' fill='%236e56cf'/%3E%3Cpath d='M6 40c2-9 8-13 14-13s12 4 14 13z' fill='%236e56cf'/%3E%3C/svg%3E" },
    { name: "Alan Turing" },
    { name: "Katherine Johnson" },
    { name: "Linus Torvalds" },
    { name: "Margaret Hamilton" },
    { name: "Dennis Ritchie" },
]

view AvatarDemo() =
    <div.demo-stack>
        <div.demo-row>
            <Avatar name="Ada Lovelace" size="xs"/>
            <Avatar name="Grace Hopper" size="sm"/>
            <Avatar name="Alan Turing"/>
            <Avatar name="Katherine Johnson" size="lg"/>
            <Avatar name="Plato" size="xl"/>
            <Avatar name="Margaret Hamilton" shape="square" size="lg"/>
        </div>
        <div.demo-row>
            <Avatar name="Ada Lovelace" status="online"/>
            <Avatar name="Linus Torvalds" status="away"/>
            <Avatar name="Dennis Ritchie" status="busy"/>
            <Avatar name="Barbara Liskov" status="offline"/>
            <Avatar name="Grace Hopper" src={avatar_demo_team[1].src} size="lg" status="online"/>
            <Avatar name="Broken Picture" src="data:image/png;base64,bm90IGEgcGljdHVyZQ==" size="lg"/>
        </div>
        <div.demo-row>
            <AvatarGroup people={avatar_demo_team} max={4} label="Project members"/>
            <AvatarGroup people={take(avatar_demo_team, 3)} size="sm"/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "avatar", name: "Avatar", group: "Data",
    summary: "A picture, or initials on a colour of the person's own, with a status dot; and overlapping groups with +N.",
    tags: ["user", "image", "profile", "no-js"],
    demo: AvatarDemo })
