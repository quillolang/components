let long_press_menu_demo_items = [
    { id: "copy", label: "Copy link" }, { id: "share", label: "Share" }, { id: "pin", label: "Pin to top", disabled: true },
    { id: "delete", label: "Delete", tone: "danger" },
]

component LongPressMenuDemoLive() {
    state said = "Nothing chosen yet."
    state felt = "Press and hold to see."
    <div.demo-stack>
        <LongPressMenu label="Morning walk" items={long_press_menu_demo_items}
                       on_select={(id) => { said = `Chose ${id}.` }}
                       on_open={(how) => { felt = how == "none" ? "This device gave no tap: the menu opening is the signal." : `Tap felt through: ${how}.` }}>
            <div style="padding: 14px 12px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius-sm)">
                <strong id="long-press-demo-text">Morning walk</strong>
                <div style="color: var(--ui-muted)">6.2 km along the river, shared with two people. Press and hold anywhere here.</div>
            </div>
        </LongPressMenu>
        <p.demo-note id="long-press-demo-said" role="status">{said}</p>
        <p.demo-note id="long-press-demo-felt">{felt}</p>
        // Bad data, for the test to look at: nothing here should stop the page.
        <div id="long-press-bad" hidden="true"><LongPressMenu items={[null, 3, { id: "x" }, { label: "Only" }]}>Bad</LongPressMenu><LongPressMenu items="none">Worse</LongPressMenu></div>
    </div>
}

view LongPressMenuDemo() = <LongPressMenuDemoLive/>

ui_gallery = ui_gallery | push({ slug: "long_press_menu", name: "LongPressMenu", group: "Mobile",
    summary: "A long press opens a menu at the finger, with a haptic, no text selected and no browser callout.",
    tags: ["mobile", "interactive", "gesture", "menu", "long-press", "tablet"],
    demo: LongPressMenuDemo })
