component QrCodeDemoLive() {
    state text = "Hello from Quillo"
    <div.demo-stack style="justify-items: start">
        <label style="display: grid; gap: 4px; font-size: 13px; width: min(320px, 100%)">Text to encode
            <input id="qr-code-demo-input" value={text} @input={(e) => { text = e.value }}
                   style="height: 34px; padding: 0 10px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius-sm); background: var(--ui-surface); color: var(--ui-fg); font: inherit"/>
        </label>
        <QrCode id="qr-code-demo-live" text={text} size={140}/>
        <p.demo-note>{len(qr_code_bytes(text))} bytes, drawn in the browser as you type.</p>
    </div>
}

view QrCodeDemo() =
    <div.demo-stack>
        <div.demo-row style="align-items: flex-start; gap: 24px">
            <QrCode id="qr-code-demo-site" text="https://quillolang.org/components" caption="quillolang.org/components"/>
            <QrCode id="qr-code-demo-wifi" text="WIFI:T:WPA;S:Quillo Café;P:espresso;;" size={120} label="Wi-Fi: Quillo Café" caption="Wi-Fi"/>
            <QrCode id="qr-code-demo-themed" text="Olá, mundo! ✓" size={120} themed={true} caption="themed"/>
            <QrCode id="qr-code-demo-long" text={repeat("Too long. ", 30)} size={120}/>
        </div>
        <QrCodeDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "qr_code", name: "QrCode", group: "Data",
    summary: "A QR code drawn as SVG by an encoder written in Quillo: any text as UTF-8, level M, versions 1 to 10, the same on the server and in the browser.",
    tags: ["image", "data", "document", "commerce", "no-js"],
    demo: QrCodeDemo })
