let focus_timer_demo_past = [
    { date: "2026-11-03", minutes: 25 }, { date: "2026-11-03", minutes: 45 }, { date: "2026-11-02", minutes: 25 },
    { date: "2026-10-30", minutes: 25 }, { date: "2026-10-29", minutes: 25 }, { date: "2026-10-28", minutes: 25 }, "2026-10-27", "not a day", 7,
]

component FocusTimerDemoLive() {
    state got = ""
    state last = ""
    <div.demo-stack>
        <FocusTimer today="2026-11-04" sessions={focus_timer_demo_past} rounds={2}
                    on_session={(s) => { got = `${s.date} ${s.minutes} ${s.started_at != null} ${s.ended_at > 0}` }}
                    on_state={(s) => { last = `${s.phase} ${s.status} ${s.round}` }}/>
        <p.demo-note id="focus-timer-got">{got}</p>
        <p.demo-note id="focus-timer-state">{last}</p>
        // A real three seconds, one paused and one that ended long ago, for the test to look at.
        <div id="focus-timer-short"><FocusTimer today="2026-11-04" focus_minutes={0.05} break_minutes={0.05} rounds={1} choices={[]} keep_awake={false}/></div>
        <div id="focus-timer-paused"><FocusTimer today="2026-11-04" choices={[]} keep_awake={false} resume={{ phase: "focus", status: "paused", left: 90000, round: 2, minutes: 25 }}/></div>
        <div id="focus-timer-gone"><FocusTimer today="2026-11-04" choices={[]} keep_awake={false} resume={{ phase: "focus", status: "running", ends_at: 1000, round: 1, minutes: 30 }}/></div>
        <div id="focus-timer-bad" hidden="true"><FocusTimer today="never" sessions="none" focus_minutes={-5} rounds={0} choices="none" resume="no"/></div>
    </div>
}

view FocusTimerDemo() = <div.demo-stack><FocusTimerDemoLive/></div>

ui_gallery = ui_gallery | push({ slug: "focus_timer", name: "FocusTimer", group: "Mobile",
    summary: "Sessions with a keep-awake, a streak, time that survives the background, and an end alert.",
    tags: ["mobile", "interactive", "timer", "device", "tablet"],
    demo: FocusTimerDemo })
