component NotificationCenterDemoLive() {
    state did = "Nothing read yet."
    <div.demo-row>
        <NotificationCenter id="nc-demo" all_href="#notification_center" items={[
            { id: 1, title: "Ana commented on Invoice #1042", text: "Looks good to me, sending it today.", time: "2 min ago" },
            { id: 2, title: "Payment received", text: "€1,240.00 from Northwind.", time: "1 h ago", href: "#notification_center" },
            { id: 3, title: "Ben invited you to Design", time: "Yesterday" },
            { id: 4, title: "Your export is ready", time: "2 days ago", read: true },
        ]} on_read={(i) => { did = `Read ${i}.` }} on_read_all={() => { did = "Read all." }}/>
        <span.demo-note>{did}</span>
    </div>
}

view NotificationCenterDemo() =
    <div.demo-stack>
        <NotificationCenterDemoLive/>
        <div.demo-row>
            <NotificationCenter id="nc-demo-empty" align="start" items={[{ id: 1, title: "Welcome aboard", time: "Last week", read: true }]}/>
            <span.demo-note>Nothing unread: no count on the bell.</span>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "notification_center", name: "NotificationCenter", group: "Overlays",
    summary: "A bell with the unread count, opening a panel of notifications to filter and mark read, one by one or all at once.",
    tags: ["notification", "popover", "overlay", "interactive"],
    demo: NotificationCenterDemo })
