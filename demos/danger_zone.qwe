component DangerZoneDemoLive() {
    state done = null
    <div.demo-stack>
        <DangerZone title="Account" description="These act on your whole account.">
            <DangerAction title="Sign out everywhere" text="Every other device is signed out." label="Sign out all"
                          tone="neutral" on_confirm={() => { done = "Signed out everywhere." }}/>
            <DangerAction title="Delete account" text="Your projects, files and billing history go, for good."
                          on_confirm={() => { done = "Account deleted (not really)." }}/>
        </DangerZone>
        <p.demo-note>{done ?? "Each button asks first; yes calls on_confirm."}</p>
    </div>
}

view DangerZoneDemo() =
    <div.demo-stack>
        <DangerZone id="danger-zone-demo">
            <DangerAction title="Transfer ownership" text="Give this project to someone else on the team." label="Transfer"
                          href="#danger_zone" tone="neutral" confirm={false}/>
            <DangerAction title="Archive project" text="Read-only for everyone; you can bring it back." label="Archive"
                          action="#danger_zone" name="archive" value="yes" tone="neutral" message="People lose write access until you restore it."/>
            <DangerAction title="Delete project" text="Everything in it goes, for good, within the hour." label="Delete project"
                          action="#danger_zone" name="delete" value="yes" message="The files, the database and the deploys go too."/>
        </DangerZone>
        <DangerZoneDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "danger_zone", name: "DangerZone", group: "Dashboard",
    summary: "A red-bordered block of destructive actions (DangerAction), each a form, link or callback that asks before it acts.",
    tags: ["dashboard", "settings", "security", "button", "forms", "no-js"],
    needs: ["button", "confirm_button"],
    demo: DangerZoneDemo })
