view BulletChartDemo() =
    <div.demo-stack>
        <BulletChart label="Quarter goals" show_label={true} items={[
            { label: "Revenue", sub: "US$, thousands", value: 270, target: 250, ranges: [150, 225, 300] },
            { label: "Profit", sub: "%", value: 22.5, target: 26, ranges: [20, 25, 30] },
            { label: "Order size", sub: "US$, average", value: 320, target: 550, ranges: [350, 500, 600] },
            { label: "New customers", sub: "count", value: 1650, target: 2100, ranges: [1400, 2000, 2500] },
            { label: "Satisfaction", sub: "out of 5", value: 4.5, target: 4.2, ranges: [3.5, 4.25, 5] }]}/>
        <BulletChart label="Response times" show_label={true} suffix=" ms" lower_is_better={true} ranges={[200, 500, 1000]}
                     band_names={["Slow", "Fair", "Fast"]} items={[
            { label: "Home", value: 180, target: 200 }, { label: "Search", value: 420, target: 300 },
            { label: "Checkout", value: 760, target: 500 }]}/>
        <p.demo-note>For times, the first band is the good one (lower_is_better); the thin black mark is each target.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "bullet_chart", name: "BulletChart", group: "Charts",
    summary: "Measures as thin bars against a target mark over grey bands from poor to good, a row each, with the band named on hover.",
    tags: ["chart", "data", "dashboard", "no-js"],
    demo: BulletChartDemo })
