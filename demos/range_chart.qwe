let range_chart_demo_months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
let range_chart_demo_temps = [[-6, 2, -2], [-5, 4, -1], [-1, 9, 4], [4, 15, 9], [9, 21, 15], [13, 25, 19],
                              [15, 28, 21], [14, 27, 20], [10, 22, 16], [5, 15, 10], [0, 8, 4], [-4, 3, -1]]

view RangeChartDemo() =
    <div.demo-stack>
        <RangeChart label="Temperature in Montreal, low to high" show_label={true} suffix="°" value_labels={true}
                    items={for [i, m] in enumerate(range_chart_demo_months) =>
                        { label: m, low: range_chart_demo_temps[i][0], high: range_chart_demo_temps[i][1], value: range_chart_demo_temps[i][2] }}/>
        <RangeChart label="Monthly revenue forecast" show_label={true} band={true} prefix="$" color={7} height={200}
                    items={[{ label: "Jul", low: 41000, high: 41000, value: 41000 }, { label: "Aug", low: 42500, high: 46100, value: 44200 },
                            { label: "Sep", low: 43100, high: 49800, value: 46300 }, { label: "Oct", low: 43900, high: 53600, value: 48500 },
                            { label: "Nov", low: 44200, high: 57900, value: 50800 }, { label: "Dec", low: 44800, high: 62500, value: 53100 }]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "range_chart", name: "RangeChart", group: "Charts",
    summary: "A low and a high per label as floating bars or a band, with an optional middle value, and each range on hover.",
    tags: ["chart", "data", "no-js"],
    demo: RangeChartDemo })
