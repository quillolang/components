let approval_queue_demo_requests = [
    { id: "r1", title: "New laptops for design", who: "Maya Chen, Design", amount: "4,860.00 USD", detail: "Three machines, replacing ones from 2021.", fields: [{ label: "Vendor", value: "Northwind" }, { label: "Budget", value: "Equipment" }] },
    { id: "r2", title: "Team offsite in March", who: "Tom Reyes, Sales", amount: "12,400.50 USD", detail: "Two nights for 14 people." },
    { id: "r3", title: "Annual licence renewal", who: "Priya Nair, IT", amount: "980.00 USD" },
    { id: "r4", title: "Contractor extension", who: "Lena Fox, Support", detail: "Six more weeks at the same rate." },
]

component ApprovalQueueDemoLive() {
    state told = "Nothing yet."
    state done_said = "Not done."
    state kept = []
    state again = 0
    state stir = 0
    <div.demo-stack>
        <div id="approval-queue-main"><ApprovalQueue key={again} label={`Approvals${stir > 0 ? " (updated)" : ""}`}
            requests={approval_queue_demo_requests | map((r) => r.id == "r4" ? { ...r, detail: `Six more weeks at the same rate, note ${stir}.` } : r)} saved={kept} reasons={["Over budget", "Needs a quote"]}
            on_change={(l) => { kept = l }}
            on_decide={(d) => { told = `${d.id} ${d.decision} [${d.reason}]` }} on_undo={(d) => { told = `undo ${d.id}` }} on_done={(l) => { done_said = `done ${len(l)}` }}/></div>
        <p.demo-note id="approval-queue-told">{told}</p>
        <p.demo-note id="approval-queue-done">{done_said}</p>
        <p.demo-note id="approval-queue-kept">{json.stringify(kept)}</p>
        <div.demo-row>
            <Button id="approval-queue-remake" size="lg" variant="soft" on_click={() => { again += 1 }}>Make it again from what was kept</Button>
            <Button id="approval-queue-stir" size="lg" variant="soft" on_click={() => { stir += 1 }}>A request is updated</Button>
        </div>
        <div id="approval-queue-both"><ApprovalQueue label="A reason each way" reason_for="both" requests={[{ id: "b1", title: "Both ways" }]}/></div>
        <div id="approval-queue-free"><ApprovalQueue label="No reasons" reason_for="none" requests={[{ id: "f1", title: "One" }]}/></div>
        <div id="approval-queue-bad"><ApprovalQueue label="Bad data" requests={[null, 3, { id: "x" }, { id: 1, title: "Twin", fields: "many" }, { id: 1, title: "Twin again" }]} saved={[null, { id: 1 }, { id: "gone", decision: "approved" }]}/></div>
    </div>
}

view ApprovalQueueDemo() = <ApprovalQueueDemoLive/>

ui_gallery = ui_gallery | push({ slug: "approval_queue", name: "ApprovalQueue", group: "Mobile",
    summary: "One request at a time, swiped to approve or reject, with a required reason, undo and a count of what is left.",
    tags: ["mobile", "interactive", "approval", "gesture", "swipe", "tablet"],
    demo: ApprovalQueueDemo })
