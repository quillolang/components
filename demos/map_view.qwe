let map_view_demo_places = [
    { id: 1, lat: 38.7114, lng: -9.1305, text: "€95", title: "Alfama flat with river view" },
    { id: 2, lat: 38.7171, lng: -9.1312, text: "€140", title: "Tiled house in Graça" },
    { id: 3, lat: 38.7130, lng: -9.1460, text: "€70", title: "Bairro Alto studio" },
    { id: 4, lat: 38.7145, lng: -9.1600, text: "<b>€45</b>", title: "Room by the Estrela garden" },
]

component MapViewDemoLive() {
    state picked = null
    state cheap = false
    state spot = [38.7139, -9.1394]
    let shown = cheap ? map_view_demo_places | filter((p) => p.id != 2) : map_view_demo_places
    <div.demo-stack>
        <MapView label="Places to stay" center={[38.7139, -9.1394]} zoom={14} markers={shown} picked={picked}
                 height={300} on_pick={(id) => { picked = id }}/>
        <div.demo-row>
            <button type="button" class="map-view-demo-cheap" @click={() => { cheap = !cheap }}>{cheap ? "Show all" : "Under €100 only"}</button>
            <p.demo-note>{picked == null
                ? "Click a price."
                : `Picked ${(find(map_view_demo_places, (p) => p.id == picked) ?? { title: "?" }).title}.`}</p>
        </div>
        <MapView label="Where it is" center={spot} zoom={15} pin={spot} height={220}
                 markers={[{ id: "cafe", lat: 38.7105, lng: -9.1415, tone: "warning", title: "A café" }]}
                 on_pin={(lat, lng) => { spot = [lat, lng] }}/>
        <p.demo-note>The pin is at {round(spot[0], 4)}, {round(spot[1], 4)}. Drag it, or click the map.</p>
    </div>
}

view MapViewDemo() =
    <div.demo-stack>
        <MapViewDemoLive/>
        <p.demo-note>A label's text is escaped: the last one is written "&lt;b&gt;€45&lt;/b&gt;".</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "map_view", name: "MapView", group: "Data",
    summary: "A map (Leaflet's) with prices or dots for places on a list, one picked, and a pin to drag where something is.",
    demo: MapViewDemo })
