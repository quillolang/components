view FooterNavDemo() =
    <div.demo-stack>
        <FooterNav id="footer-nav-demo" current="#footer_nav" groups={[
            { title: "Product", links: [
                { label: "Features", href: "#features" }, { label: "Pricing", href: "#pricing" },
                { label: "Components", href: "#footer_nav" }, { label: "Changelog", href: "#changelog", badge: "New" }
            ] },
            { title: "Resources", links: [
                { label: "Documentation", href: "#docs" }, { label: "Guides", href: "#guides" },
                { label: "GitHub", href: "https://github.com/quillolang", external: true }
            ] },
            { title: "Company", links: [
                { label: "About", href: "#about" }, { label: "Blog", href: "#blog" }, { label: "Careers", href: "#careers" }
            ] },
            { title: "Legal", links: [
                { label: "Privacy", href: "#privacy" }, { label: "Terms", href: "#terms" }
            ] }
        ]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "footer_nav", name: "FooterNav", group: "Navigation",
    summary: "Columns of grouped links for a site's footer, each under its title, wrapping on narrow screens.",
    tags: ["navigation", "link", "layout", "marketing", "no-js"], demo: FooterNavDemo })
