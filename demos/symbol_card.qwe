// A day of prices from a seeded random walk (Park–Miller), the same on every render.
fn symbol_card_demo_day(seed: int, start: num, count: int, swing: num, drift: num = 0) -> list {
    let s = seed
    let p = start
    for i in range(count) {
        s = s * 16807 % 2147483647
        p = round(p * (1 + (s / 2147483647 - 0.5 + drift) * swing) * 100) / 100
        p
    }
}

let symbol_card_demo_acme = symbol_card_demo_day(3, 180.15, 48, 0.006, 0.12)
let symbol_card_demo_glbx = symbol_card_demo_day(11, 49.02, 48, 0.008)

view SymbolCardDemo() =
    <div.demo-stack>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px">
            <div id="symbol_card-demo-acme">
                <SymbolCard symbol="ACME" name="Acme Corporation" price={symbol_card_demo_acme[-1]} prev={180.15}
                            values={symbol_card_demo_acme} prefix="$" low={min(symbol_card_demo_acme)} high={max(symbol_card_demo_acme)}
                            volume={4182330} note="At close"/>
            </div>
            <div id="symbol_card-demo-glbx">
                <SymbolCard symbol="GLBX" name="Globex" price={symbol_card_demo_glbx[-1]} prev={49.02} values={symbol_card_demo_glbx}
                            prefix="$" href="#symbol_card" note="Delayed 15 min"/>
            </div>
        </div>
        <div class="demo-stack demo-narrow" id="symbol_card-demo-small" style="gap: 8px">
            <SymbolCard size="sm" symbol="BTC" name="Bitcoin" price={61250} prev={61250} decimals={0} values={[61100, 61400, 61180, 61250]}/>
            <SymbolCard size="sm" symbol="ETH" name="Ether" price={2410.5} change={-25.1} values={[2440, 2431, 2425, 2410.5]}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "symbol_card", name: "SymbolCard", group: "Charts",
    summary: "A symbol with its name, last price, change and percent, a sparkline over the previous close, the day's range and volume.",
    tags: ["card", "data", "trading", "no-js"],
    demo: SymbolCardDemo })
