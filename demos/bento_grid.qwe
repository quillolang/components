view BentoGridDemoTiles() =
    [
        <BentoTile cols={2} rows={2} tone="accent" title="Fast" subtitle="Pages in 40 ms, components resumed, not rebuilt." class="bento-grid-demo-big">
            <p style="margin: 12px 0 0; font-size: 40px; font-weight: 650; letter-spacing: -.02em">40 ms</p>
        </BentoTile>,
        <BentoTile title="Safe" subtitle="Escaped by default." class="bento-grid-demo-small"/>,
        <BentoTile title="Docs" subtitle="Guides and the reference." href="https://quillolang.org/docs/" class="bento-grid-demo-link"/>,
        <BentoTile cols={2} tone="subtle" title="Small" subtitle="30 KB of runtime, once." class="bento-grid-demo-wide"/>,
        <BentoTile tone="success" title="Tested"><p style="margin: 0; font-size: 28px; font-weight: 650">98%</p></BentoTile>,
        <BentoTile tone="info" title="Live"><p style="margin: 0; color: var(--ui-muted)">Pages follow the data.</p></BentoTile>
    ]

view BentoGridDemo() =
    <div.demo-stack>
        <BentoGrid id="bento-grid-demo-wall" columns={4} rows="140px"><BentoGridDemoTiles/></BentoGrid>
        <p.demo-note>The same wall in a 480px-wide box: two columns, wide tiles across both.</p>
        <div style="width: 480px; max-width: 100%">
            <BentoGrid id="bento-grid-demo-narrow" columns={4} rows="120px" gap="sm"><BentoGridDemoTiles/></BentoGrid>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "bento_grid", name: "BentoGrid", group: "Layout",
    summary: "A grid of tiles spanning columns and rows, with titles, tints and links, packed to leave no holes.",
    tags: ["layout", "grid", "card", "marketing", "no-js"], demo: BentoGridDemo })
