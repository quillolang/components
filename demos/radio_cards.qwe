component RadioCardsDemoLive() {
    state size = "m"
    <div.demo-stack>
        <RadioCards name="rc-demo-size" label="Size" value={size} columns={4} size="sm"
                    options={[{ label: "S", value: "s", description: "1 CPU" }, { label: "M", value: "m", description: "2 CPUs" },
                              { label: "L", value: "l", description: "4 CPUs" }, { label: "XL", value: "xl", description: "8 CPUs" }]}
                    on_change={(v) => { size = v }}/>
        <p.demo-note>Size {upper(size)} it is.</p>
    </div>
}

view RadioCardsDemo() =
    <div.demo-stack>
        <RadioCards name="rc-demo-plan" label="Plan" value="pro" hint="Change it any time."
                    options={[{ label: "Hobby", value: "hobby", description: "One project and community help.", meta: "Free" },
                              { label: "Pro", value: "pro", description: "Unlimited projects, email support.", meta: "$12/mo" },
                              { label: "Enterprise", value: "ent", description: "Single sign-on and a contract. Talk to us.", meta: "Custom", disabled: true }]}/>
        <RadioCardsDemoLive/>
        <RadioCards name="rc-demo-ship" label="Shipping" columns={1} required={true} error="Choose how to ship it."
                    options={[{ label: "Standard", value: "std", description: "3 to 5 working days", meta: "Free", icon: "📦" },
                              { label: "Express", value: "exp", description: "Next working day", meta: "$9", icon: "🚀" }]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "radio_cards", name: "RadioCards", group: "Forms",
    summary: "One choice of several as cards with a title, a line of detail and a dot, each a real radio a form sends.",
    tags: ["forms", "input", "card", "select", "no-js"], demo: RadioCardsDemo })
