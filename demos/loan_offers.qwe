view LoanOffersDemo() {
    <div.demo-stack style="padding-top: 10px">
        <LoanOffers id="loan-offers-demo-personal" amount={20000} offers={[
            { lender: "Harbor Federal", apr: 7.49, term: 60, fees: 0, href: "#harbor", note: "No early repayment fee." },
            { lender: "Summit Lending", apr: 6.99, term: 60, fees: 600, tag: "Pre-approved", href: "#summit" },
            { lender: "Bluewater Bank", apr: 8.25, term: 72, fees: 150, href: "#bluewater", note: "Lowest monthly payment." },
            { lender: "Northwind Credit Union", apr: 6.75, rate: 6.5, term: 48, fees: 250, tag: "Members", href: "#northwind" },
        ]}/>
        <div.demo-narrow style="max-width: 520px">
            <LoanOffers id="loan-offers-demo-eur" amount={12000} currency="EUR" locale="de-DE" choose_label="Auswählen" offers={[
                { lender: "Rheinland Bank", apr: 5.9, term: 36, href: "#rheinland" },
                { lender: "Alpen Kredit", apr: 5.4, term: 36, fees: 240, monthly: 361.81, href: "#alpen" },
            ]}/>
        </div>
    </div>
}

ui_gallery = ui_gallery | push({ slug: "loan_offers", name: "LoanOffers", group: "Finance",
    summary: "Loan offers side by side: each lender's APR, term, monthly payment, fees and total cost, with the cheapest in total marked.",
    tags: ["finance", "loans", "card", "data", "no-js"], demo: LoanOffersDemo })
