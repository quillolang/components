view TrustBadgesDemo() =
    <div.demo-stack>
        <TrustBadges/>
        <TrustBadges layout="grid" bordered={true} items={[
            "shipping",
            { icon: "support", title: "Here to help", text: "Chat with us, 9 to 6" },
            { icon: "🌱", title: "Plants a tree", text: "With every order" },
            "warranty",
        ]}/>
        <TrustBadges layout="list" size="sm" items={["privacy", "eco"]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "trust_badges", name: "TrustBadges", group: "Commerce",
    summary: "Secure payment, free returns, a guarantee: reassurance icons with a line each, in a row, a grid or a list.",
    tags: ["commerce", "checkout", "marketing", "icon", "no-js"], demo: TrustBadgesDemo })
