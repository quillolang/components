component ProfileHeaderDemoLive() {
    state following = false
    state followers = 2399
    <div.demo-stack>
        <ProfileHeader id="profile-header-demo-live" name="Ana Silva" handle="@ana" verified={true}
                       avatar="https://i.pravatar.cc/160?img=47" cover="https://picsum.photos/seed/cover/1200/300"
                       bio="Builds things with Quillo. Runs by the river.
Opinions my own."
                       meta={[{ text: "Lisbon", kind: "place" }, { text: "quillolang.org", kind: "link", href: "https://quillolang.org" }, { text: "Joined March 2024", kind: "joined" }]}
                       stats={[{ label: "Posts", value: 128 }, { label: "Followers", value: followers, href: "#profile_header" }, { label: "Following", value: 312 }]}
                       following={following} on_follow={(on) => { following = on; followers = on ? followers + 1 : followers - 1 }}/>
        <p.demo-note>{following ? "You follow Ana." : "You do not follow Ana."}</p>
    </div>
}

view ProfileHeaderDemo() =
    <div.demo-stack>
        <ProfileHeaderDemoLive/>
        <ProfileHeader id="profile-header-demo-plain" name="Ben Okafor" handle="@ben" bio="Photos, mostly."
                       stats={[{ label: "Posts", value: 42 }, { label: "Followers", value: 1500000 }]}
                       following={true} follow_href="#profile_header">
            <a href="#profile_header" class="ui-profile-header-follow" aria-pressed="true">Message</a>
        </ProfileHeader>
    </div>

ui_gallery = ui_gallery | push({ slug: "profile_header", name: "ProfileHeader", group: "Social",
    summary: "The top of a profile: cover, avatar, name, handle, bio, facts, counts and a Follow button that becomes Following.",
    tags: ["social", "profile", "user", "page", "no-js"], demo: ProfileHeaderDemo })
