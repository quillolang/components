view StickyDemo() =
    <div.demo-stack>
        <div id="sticky-demo-box" style="height: 240px; overflow: auto; border: 1px solid var(--ui-border); border-radius: var(--ui-radius); padding: 0 16px">
            <Sticky top={8} class="sticky-demo-title">
                <div style="padding: 8px 12px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius-sm); background: var(--ui-surface); box-shadow: var(--ui-shadow); font-weight: 600">Chapter 3: Tides</div>
            </Sticky>
            {for i in range(1, 13) => <p>Paragraph {i}. Scroll the box: the chapter's title stays 8px from its top while the text goes by.</p>}
            <Sticky bottom={8} class="sticky-demo-bar">
                <Button full={true}>Continue to chapter 4</Button>
            </Sticky>
        </div>
        <p.demo-note>The title sticks to the top of the box and the button to its bottom, each until its content has scrolled past.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "sticky", name: "Sticky", group: "Layout",
    summary: "Keeps what it holds in view at an offset from the top, or the bottom, while the rest scrolls past.",
    tags: ["layout", "utility", "no-js"], demo: StickyDemo })
