let tree_view_demo_files = [
    { label: "src", expanded: true, children: [
        { label: "main.qwe", value: "src/main.qwe", meta: "4 KB" },
        { label: "ui", value: "src/ui", children: [
            { label: "button.qwe", value: "src/ui/button.qwe", meta: "2 KB" },
            { label: "modal.qwe", value: "src/ui/modal.qwe", meta: "3 KB" },
            { label: "tabs.qwe", value: "src/ui/tabs.qwe", meta: "4 KB" },
        ] },
        { label: "db", value: "src/db", children: [
            { label: "schema.sql", value: "src/db/schema.sql", meta: "1 KB" },
            { label: "seed.sql", value: "src/db/seed.sql", meta: "9 KB" },
        ] },
    ] },
    { label: "static", children: [
        { label: "logo.svg", value: "static/logo.svg", meta: "6 KB" },
        { label: "favicon.ico", value: "static/favicon.ico", meta: "15 KB" },
    ] },
    { label: "README.md", meta: "2 KB" },
    { label: "quillo.toml", meta: "1 KB" },
]

let tree_view_demo_regions = [
    { label: "Europe", value: "eu", expanded: true, children: [
        { label: "Frankfurt", value: "eu-fra" }, { label: "Dublin", value: "eu-dub" }, { label: "Stockholm", value: "eu-sto" },
    ] },
    { label: "Americas", value: "am", expanded: true, children: [
        { label: "North", value: "am-n", children: [{ label: "Virginia", value: "us-east" }, { label: "Oregon", value: "us-west" }, { label: "Montréal", value: "ca-mtl" }] },
        { label: "São Paulo", value: "sa-sao" },
    ] },
    { label: "Asia Pacific", value: "ap", children: [
        { label: "Tokyo", value: "ap-tyo" }, { label: "Singapore", value: "ap-sin" }, { label: "Sydney", value: "ap-syd" },
    ] },
]

component TreeViewDemoLive() {
    state picked = ["eu-fra", "eu-dub", "us-east"]
    <div.demo-stack>
        <TreeView id="tv-regions" label="Regions" checkboxes={true} name="regions" items={tree_view_demo_regions}
                  checked={picked} on_check={(vs) => { picked = vs }}/>
        <p.demo-note>{len(picked)} region{len(picked) == 1 ? "" : "s"}: {join(picked, ", ")}</p>
    </div>
}

view TreeViewDemo() =
    <div.demo-row style="align-items: flex-start; gap: 28px">
        <div style="flex: 1 1 260px; max-width: 340px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius-sm)">
            <TreeView id="tv-files" label="Project files" name="file" selected="src/main.qwe" items={tree_view_demo_files}/>
        </div>
        <div style="flex: 1 1 260px; max-width: 340px">
            <TreeViewDemoLive/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "tree_view", name: "TreeView", group: "Navigation",
    summary: "Nested items that open and close, with the arrow keys, type-ahead and optional tri-state checkboxes.",
    tags: ["navigation", "list", "interactive"],
    demo: TreeViewDemo })
