// Trading days of results from a seeded random walk (Park–Miller), the same on every render.
fn pnl_chart_demo_days(seed: int, count: int, from: str, size: num, edge: num) -> list {
    let s = seed
    let day = from
    let out = []
    while len(out) < count {
        if date.weekday(day) <= 5 {
            s = s * 16807 % 2147483647
            out = out | push({ date: day, pnl: round((s / 2147483647 - 0.5 + edge) * size) })
        }
        day = date.add_days(day, 1)
    }
    out
}

let pnl_chart_demo_q3 = pnl_chart_demo_days(13, 64, "2026-07-01", 4000, 0.025)

view PnlChartDemo() =
    <div.demo-stack>
        <div id="pnl_chart-demo-q3">
            <PnlChart label="Strategy P&L, Q3 2026" show_label={true} days={pnl_chart_demo_q3} prefix="$" decimals={0}/>
        </div>
        <div id="pnl_chart-demo-small" style="max-width: 520px">
            <PnlChart label="Two weeks, no figures" show_label={true} stats={false} height={140} bars_height={60} prefix="$"
                      days={[{ date: "2026-10-12", pnl: 120.5 }, { date: "2026-10-13", pnl: -40.25 }, { date: "2026-10-14", pnl: -95 },
                             { date: "2026-10-15", pnl: 60 }, { date: "2026-10-16", pnl: 210.75 }, { date: "2026-10-19", pnl: 0 },
                             { date: "2026-10-20", pnl: -130 }, { date: "2026-10-21", pnl: 85.5 }, { date: "2026-10-22", pnl: 40 },
                             { date: "2026-10-23", pnl: 155 }]}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "pnl_chart", name: "PnlChart", group: "Charts",
    summary: "Profit and loss per day as green and red bars, with the running total and its drawdowns shaded, and the key figures above.",
    tags: ["chart", "data", "trading", "dashboard", "no-js"],
    demo: PnlChartDemo })
