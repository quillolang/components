component DoubleTapLikeDemoLive() {
    state said = "Nothing yet."
    state taps = 0
    <div.demo-stack style="max-width: 760px">
        <DoubleTapLike title="Harbour at dusk" text="Taken from the old sea wall, a little after eight." count={1284}
                       alt="Harbour at dusk" color="linear-gradient(160deg, #f6b26b, #674ea7 70%, #20124d)"
                       on_like={(on, n) => { said = `liked ${on} ${n}` }} on_tap={() => { taps += 1 }}/>
        <p.demo-note id="double-tap-said">{said}</p>
        <p.demo-note id="double-tap-taps">Single taps: {taps}</p>
        // Bad data, for the test to look at: nothing here should stop the page.
        <div id="double-tap-bad" hidden="true"><DoubleTapLike count="many"/><DoubleTapLike count={-4}/><DoubleTapLike count={12.7}/><DoubleTapLike count={1500000}/></div>
    </div>
}

view DoubleTapLikeDemo() = <DoubleTapLikeDemoLive/>

ui_gallery = ui_gallery | push({ slug: "double_tap_like", name: "DoubleTapLike", group: "Mobile",
    summary: "Double tap a photo card to like it, a heart bursting at the finger, with a plain Like button as the equal.",
    tags: ["mobile", "interactive", "gesture", "like", "media", "tablet"],
    demo: DoubleTapLikeDemo })
