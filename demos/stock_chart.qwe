// Prices from a seeded random walk (Park–Miller), the same on every render: `count`
// candles from the day `from` on, skipping weekends, daily or hourly (10:00 to 16:00),
// rounded to `places` decimals.
fn stock_chart_demo_walk(seed: int, count: int, start: num, from: str, hourly: bool = false, places: int = 2) -> list {
    let s = seed
    let rnd = () => {
        s = s * 16807 % 2147483647
        s / 2147483647
    }
    let scale = pow(10, places)
    let cut = (v) => round(v * scale) / scale
    let p = start
    let day = from
    let hour = 10
    let out = []
    while len(out) < count {
        if date.weekday(day) <= 5 {
            let open = cut(p * (1 + (rnd() - 0.5) * 0.006))
            let close = cut(open * (1 + (rnd() - 0.485) * (hourly ? 0.012 : 0.035)))
            let high = cut(max([open, close]) * (1 + rnd() * 0.01))
            let low = cut(min([open, close]) * (1 - rnd() * 0.01))
            let volume = round((hourly ? 90000 : 900000) * (1 + rnd() * 1.5 + abs(close - open) * 30 / open))
            out = out | push({ time: hourly ? `${day}T${hour < 10 ? "0" : ""}${hour}:00:00Z` : day, open, high, low, close, volume })
            p = close
        }
        if hourly && hour < 16 && date.weekday(day) <= 5 {
            hour += 1
        } else {
            hour = 10
            day = date.add_days(day, 1)
        }
    }
    out
}

// A year and a quarter of hourly candles (314 trading days of 7), made in the browser as on the server, so the
// page does not carry them.
component StockChartDemoLive() {
    let hourly = stock_chart_demo_walk(77, 2198, 141.2, "2025-07-01", true)
    state chosen = "3M"
    <div.demo-stack id="stock_chart-demo-main">
        <StockChart label="ACME · hourly" candles={hourly} prefix="$" indicators={["sma20", "ema50"]}
                    on_range={(r) => { chosen = r }}/>
        <p.demo-note>{chosen == "" ? "Zoomed or panned by hand." : `Showing ${chosen}.`}</p>
    </div>
}

let stock_chart_demo_daily = stock_chart_demo_walk(5, 260, 48.2, "2025-10-01")

view StockChartDemo() =
    <div.demo-stack>
        <StockChartDemoLive/>
        <div id="stock_chart-demo-daily">
            <StockChart label="Globex · daily, line with RSI and MACD" candles={stock_chart_demo_daily} kind="line" period="All"
                        indicators={["bb", "rsi", "macd"]} prefix="$" height={240}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "stock_chart", name: "StockChart", group: "Charts",
    summary: "A full trading chart: candles, line or area, volume, range buttons, a crosshair with the OHLC readout, wheel zoom and drag pan, indicators and RSI and MACD panes.",
    tags: ["chart", "data", "trading", "dashboard", "interactive", "keyboard"],
    demo: StockChartDemo })
