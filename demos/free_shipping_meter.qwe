let free_shipping_meter_demo_items = [
    { id: "socks", name: "Wool socks", price: "12.00" },
    { id: "cap", name: "Canvas cap", price: "11.50" },
    { id: "mug", name: "Enamel mug", price: "9.00" },
    { id: "pin", name: "Enamel pin", price: "2.75" },
    { id: "tote", name: "Tote bag", price: "40.00" },
    { id: "bad", name: "No price yet", price: "soon" }]

let free_shipping_meter_demo_tiers = [
    { at: { USD: 100, EUR: 90, JPY: 12000 }, label: "A free gift" },
    { at: { USD: 50, EUR: 45, JPY: 6000 }, label: "Free shipping", shipping: true }]

component FreeShippingMeterDemoLive() {
    state seen = null
    state last_added = null
    <div.demo-stack>
        <FreeShippingMeter id="free-shipping-meter-demo-live" title="In euros" currency="EUR" total="44.99" fee="6.50" tiers={free_shipping_meter_demo_tiers} name="basket"
                           items={[{ id: "clip", name: "Clip", price: { EUR: "0.01", USD: "1" } }, { id: "only", name: "Dollars only", price: { USD: "1" } }]}
                           on_add={(i) => { last_added = i.name }} on_change={(f) => { seen = f }}/>
        <p.demo-note>{seen == null ? "Add an item to see on_add and on_change." : `on_add: ${last_added}; on_change: ${seen.total}, reached ${join(seen.reached, ", ")}, next ${seen.next}, short ${seen.short}.`}</p>
    </div>
}

view FreeShippingMeterDemo() =
    <div.demo-stack>
        <FreeShippingMeter id="free-shipping-meter-demo" title="Your cart" total="38.50" fee="5.99" tiers={free_shipping_meter_demo_tiers} items={free_shipping_meter_demo_items}/>
        <FreeShippingMeterDemoLive/>
        <FreeShippingMeter id="free-shipping-meter-demo-yen" title="In yen" currency="JPY" total="5800" fee="700" tiers={free_shipping_meter_demo_tiers + [{ at: { USD: 500 }, label: "Dollars only" }]}
                           items={[{ id: "a", name: "Sticker", price: { JPY: "100" } }, { id: "b", name: "Badge", price: { JPY: "150" } }, { id: "c", name: "Poster", price: { JPY: "900" } }]}/>
        <FreeShippingMeter id="free-shipping-meter-demo-top" title="Exactly at the top" total="100.00" tiers={free_shipping_meter_demo_tiers}/>
        <FreeShippingMeter id="free-shipping-meter-demo-bad" title="A bad total" total="lots" tiers={free_shipping_meter_demo_tiers}/>
        <FreeShippingMeter id="free-shipping-meter-demo-none" title="No tiers" total="10" currency="GBP" tiers={[{ at: { USD: 5 }, label: "Dollars only" }, { at: 0, label: "Zero" }]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "free_shipping_meter", name: "FreeShippingMeter", group: "Commerce",
    summary: "How far a cart is from free shipping or the next reward, and the cheapest item or set that gets it there, with tiers per currency, exact when reached.",
    tags: ["smart", "interactive", "commerce", "shipping", "cart", "rewards"], demo: FreeShippingMeterDemo })
