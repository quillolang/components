view SitemapListDemo() =
    <div.demo-stack>
        <SitemapList id="sitemap-list-demo" columns={3} current="#sitemap_list" pages={[
            { label: "Docs", href: "#docs", children: [
                { label: "Install", href: "#install" },
                { label: "Language", href: "#language", children: [
                    { label: "Values", href: "#values" }, { label: "Views", href: "#views" }, { label: "Components", href: "#sitemap_list" }
                ] },
                { label: "Standard library", href: "#stdlib" }
            ] },
            { label: "Components", href: "#components", children: [
                { label: "Forms", href: "#forms" }, { label: "Navigation", href: "#navigation" }, { label: "Data", href: "#data" }
            ] },
            { label: "Company", children: [
                { label: "About", href: "#about" }, { label: "Blog", href: "#blog" }, { label: "Contact", href: "#contact" }
            ] }
        ]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "sitemap_list", name: "SitemapList", group: "Navigation",
    summary: "A site's pages as a nested list of links, as deep as the site goes, flowing into columns on wide screens.",
    tags: ["navigation", "link", "list", "page", "no-js"], demo: SitemapListDemo })
