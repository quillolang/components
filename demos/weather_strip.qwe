component WeatherStripDemoLive() {
    state note = "Unit not switched yet."
    <div.demo-stack>
        <WeatherStrip id="weather-strip-demo-lisbon" place="Lisbon" temp={18} condition="partly" high={21} low={12} feels={17} unit="C"
                      updated="Forecast at 14:00" href="#weather-lisbon" on_unit={(u) => { note = `on_unit gave ${u}` }}
                      hours={[
                          { label: "Now", temp: 18, condition: "partly" },
                          { label: "3 PM", temp: 20, condition: "sun" },
                          { label: "4 PM", temp: 19, condition: "showers", rain: 40 },
                          { label: "5 PM", temp: 17, condition: "rain", rain: 80 },
                          { label: "6 PM", temp: 16, condition: "storm", rain: 70 },
                          { label: "7 PM", temp: 15, condition: "cloud", rain: 5 },
                          { label: "8 PM", temp: 13, condition: "partly_night" },
                          { label: "9 PM", temp: 12, condition: "clear_night" },
                      ]}/>
        <p.demo-note id="weather-strip-demo-note">{note}</p>
    </div>
}

view WeatherStripDemo() =
    <div.demo-stack>
        <WeatherStripDemoLive/>
        <WeatherStrip id="weather-strip-demo-chicago" place="Chicago" temp={28} condition="snow" summary="Light snow" high={31} low={19} unit="F"
                      show="C" remember={true} hours={[
                          { label: "Thu", high: 31, low: 19, condition: "snow", rain: 60 },
                          { label: "Fri", high: 35, low: 24, condition: "sleet", rain: 30 },
                          { label: "Sat", high: 41, low: 30, condition: "fog" },
                          { label: "Sun", high: 44, low: 33, condition: "wind" },
                          { label: "Mon", high: 39, low: 28, condition: "sun" },
                      ]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "weather_strip", name: "WeatherStrip", group: "News",
    summary: "The weather for a news page: the temperature now with the sky drawn, the high and low, the hours or days ahead with rain chances, and a °C/°F switch.",
    tags: ["news", "weather", "forecast", "widget", "interactive"], demo: WeatherStripDemo })
