view PortfolioAllocationDemo() =
    <div.demo-stack>
        <div id="portfolio_allocation-demo-main">
            <PortfolioAllocation label="Retirement account" show_label={true} prefix="$" holdings={[
                { symbol: "NOVA", name: "Nova Systems", shares: 60, price: 412.3, cost: 18900 },
                { symbol: "BOND", name: "Total Bond Fund", value: 21500, cost: 22400 },
                { symbol: "ACME", name: "Acme Corp.", shares: 80, price: 182.4, cost: 12210 },
                { symbol: "WRLD", name: "World Index Fund", value: 15800, cost: 13100 },
                { symbol: "GLBX", name: "Globex", shares: 150, price: 48.61, cost: 8020 },
                { symbol: "CASH", name: "Cash", value: 4250, cost: 4250 }]}/>
        </div>
        <div id="portfolio_allocation-demo-many">
            <PortfolioAllocation label="Eleven coins, no costs" show_label={true} prefix="$" decimals={0} size={140} holdings={[
                { symbol: "BTC", value: 30625 }, { symbol: "ETH", value: 12050 }, { symbol: "SOL", value: 4560 },
                { symbol: "BNB", value: 2900 }, { symbol: "XRP", value: 1560 }, { symbol: "ADA", value: 980 },
                { symbol: "DOT", value: 740 }, { symbol: "LINK", value: 610 }, { symbol: "AVAX", value: 420 },
                { symbol: "ATOM", value: 300 }, { symbol: "DOGE", value: 150 }]}/>
        </div>
        <p.demo-note>Hover a holding, on the ring or in the table, to pick it out.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "portfolio_allocation", name: "PortfolioAllocation", group: "Charts",
    summary: "A donut of a portfolio's holdings beside a table of each one's weight, value and gain, with the totals.",
    tags: ["chart", "data", "trading", "table", "no-js"],
    demo: PortfolioAllocationDemo })
