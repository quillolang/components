// Metres east of the yard's centre, as a place, to walk across its edge by hand.
let geofence_status_demo_lat = 38.7139
let geofence_status_demo_lng = -9.1394
fn geofence_status_demo_east(m) = geofence_status_demo_lng + m / (6371008.8 * math.cos(math.radians(geofence_status_demo_lat)) * math.pi / 180)

let geofence_status_demo_areas = [
    { id: "yard", name: "The yard", lat: geofence_status_demo_lat, lng: geofence_status_demo_lng, radius: 150 },
    { id: "gate", name: "Gate 3", lat: geofence_status_demo_lat, lng: geofence_status_demo_east(600), radius: 40, },
    { id: "bad", name: "Lost its radius", lat: 1, lng: 2 },
]

component GeofenceStatusDemoLive() {
    state east = 100
    state accuracy = 5
    state events = []
    <div.demo-stack>
        <GeofenceStatus label="Site areas" areas={geofence_status_demo_areas} margin={15}
                        position={{ lat: geofence_status_demo_lat, lng: geofence_status_demo_east(east), accuracy: accuracy }}
                        on_enter={(a) => { events = events + [`in ${a.name}`] }} on_exit={(a) => { events = events + [`out ${a.name}`] }}/>
        <label.demo-note>Metres east of the yard's centre: {east}
            <input.geofence-status-demo-east type="range" min="0" max="700" value={east} style="display: block; width: 100%; min-height: 44px"
                   @input={(e) => { east = int(e.value) ?? 0 }}/>
        </label>
        <div.demo-row>
            {for a in [5, 40, 150] => <button key={a} type="button" class={`geofence-status-demo-acc-${a}`} style="min-height: 44px; min-width: 44px" @click={() => { accuracy = a }}>Fix to {a} m</button>}
        </div>
        <p.demo-note>Crossings: <span class="geofence-status-demo-events">{join(events, ", ")}</span></p>
    </div>
}

view GeofenceStatusDemo() = <GeofenceStatusDemoLive/>

ui_gallery = ui_gallery | push({ slug: "geofence_status", name: "GeofenceStatus", group: "Mobile",
    summary: "Inside or outside of areas given as data, by real distance, with a band at each edge so that it does not flap, and poor fixes held.",
    tags: ["mobile", "interactive", "tablet", "location", "geofence", "gps"], demo: GeofenceStatusDemo })
