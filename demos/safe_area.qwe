let safe_area_demo_css = css`
.safe-area-demo-screen { height: 100%; background: var(--ui-accent-soft); }
.safe-area-demo-fill { display: grid; align-content: space-between; height: 100%; min-height: 100%; color: var(--ui-fg); font: 15px/1.5 var(--ui-font); }
.safe-area-demo-fill > * { margin: 0; padding: 10px 12px; background: var(--ui-surface); }
.safe-area-demo-keys { display: flex; flex-wrap: wrap; gap: 8px; }
`

component SafeAreaDemoLive() {
    style global safe_area_demo_css
    state shape = "none"
    state debug = true
    let vars = match shape {
        "notch" => "--ui-safe-top: 59px; --ui-safe-right: 0px; --ui-safe-bottom: 34px; --ui-safe-left: 0px"
        "turned" => "--ui-safe-top: 0px; --ui-safe-right: 59px; --ui-safe-bottom: 21px; --ui-safe-left: 59px"
        _ => ""
    }
    <div.demo-phone id="safe-area-demo-frame" style={vars}>
        <SafeArea id="safe-area-demo-box" least={8} debug={debug} class="safe-area-demo-screen">
            <div.safe-area-demo-fill>
                <p>Top bar, clear of the notch</p>
                <div.safe-area-demo-keys>
                    <Button size="lg" variant={shape == "none" ? "solid" : "outline"} on_click={() => { shape = "none" }}>Flat</Button>
                    <Button size="lg" variant={shape == "notch" ? "solid" : "outline"} on_click={() => { shape = "notch" }}>Notch</Button>
                    <Button size="lg" variant={shape == "turned" ? "solid" : "outline"} on_click={() => { shape = "turned" }}>Turned</Button>
                    <Button size="lg" variant="ghost" on_click={() => { debug = !debug }}>{debug ? "Hide insets" : "Show insets"}</Button>
                </div>
                <p>Bottom bar, clear of the home bar</p>
            </div>
        </SafeArea>
    </div>
}

view SafeAreaDemo() =
    <div.demo-stack>
        <SafeAreaDemoLive/>
        <SafeArea id="safe-area-demo-sides" sides="top bottom" least={12} extra={4}>
            <p.demo-note>Only the top and the bottom, at least 12 px, plus 4.</p>
        </SafeArea>
    </div>

ui_gallery = ui_gallery | push({ slug: "safe_area", name: "SafeArea", group: "Mobile",
    summary: "Pads content for notches and home bars by env(), per side, with a view of the insets under a debug prop.",
    tags: ["mobile", "interactive", "layout", "notch", "tablet"],
    demo: SafeAreaDemo })
