component ProofOfDeliveryDemoLive() {
    state said = "Nothing sent yet."
    state said2 = ""
    state more = false
    <div.demo-stack>
        <ProofOfDelivery driver="J. Tremblay" delivery={{ id: "8841", to: "A. Moreau", address: "12 Rue Saint-Paul, Montreal", value: "240.00", lat: 45.5017, lon: -73.5673,
                                                          items: ["Two boxes of tiles", "Adhesive"] }}
                         rules={[{ need: "recipient", when: "handed" }, { need: "signature", when: "handed", over: "100" }, { need: "spot", when: "left" },
                                 { need: "photo", when: ["left", "refused"], count: 2 }, { need: "reason", when: "refused" }, { need: "place", when: "always", within: 200 }]}
                         on_complete={(r) => { said = `Sent ${r.ref}` }}/>
        <p.demo-note id="pod-demo-said">{said}</p>
        <Button size="lg" variant="outline" id="pod-demo-more" on_click={() => { more = !more }}>{more ? "Hide" : "A small parcel, with a strict place"}</Button>
        {more && <ProofOfDelivery id="pod2" delivery={{ id: "8842", to: "B. Roy", address: "3 Rue Notre-Dame", value: "40.00", lat: 45.5017, lon: -73.5673 }}
                                  rules={[{ need: "signature", when: "handed", over: "100" }, { need: "spot", when: "left" }, { need: "photo", when: "left", count: 2 },
                                          { need: "place", when: "always", within: 200, strict: true }]}
                                  on_complete={(r) => { said2 = `Sent ${r.ref}` }}/>}
        <p.demo-note id="pod-demo-said2">{said2}</p>
    </div>
}

view ProofOfDeliveryDemo() = <ProofOfDeliveryDemoLive/>

ui_gallery = ui_gallery | push({ slug: "proof_of_delivery", name: "ProofOfDelivery", group: "Mobile",
    summary: "Who took it, a signature, a photo and the place in one flow, each required by a rule, ending in a receipt.",
    tags: ["mobile", "interactive", "signature", "location", "delivery", "tablet"],
    needs: ["photo_evidence", "shift_clock", "signature_pad", "button"],
    demo: ProofOfDeliveryDemo })
