let cloud_cost_estimator_demo_resources = [
    { id: "web", name: "Web servers", unit: "instance", quantity: 6, hours: 730, reserve: true,
      tiers: [{ upto: null, price: "0.0416" }], reserved: { price: "0.026", upfront: "0", term_months: 12 } },
    { id: "store", name: "Object storage", unit: "GB", quantity: 5000,
      tiers: [{ upto: 1000, price: "0.023" }, { upto: 10000, price: "0.022" }, { upto: null, price: "0.021" }] },
    { id: "egress", name: "Data transfer out", unit: "GB", quantity: 12000,
      tiers: [{ upto: 100, price: "0" }, { upto: 10000, price: "0.09" }, { upto: null, price: "0.085" }] },
    { id: "db", name: "Database", unit: "instance", quantity: 1, hours: 730,
      tiers: [{ upto: null, price: "0.68" }], reserved: { price: "0.30", upfront: "1200", term_months: 12 } },
]

component CloudCostEstimatorDemoLive() {
    state total = null
    <div.demo-stack>
        <CloudCostEstimator id="cloud-cost-estimator-demo-live" title="With on_change" currency="EUR" locale="de-DE" on_change={(b) => { total = b.monthly }}
                            resources={[{ id: "cdn", name: "CDN", unit: "GB", quantity: 3,
                                          tiers: [{ upto: 10, price: "0.333" }] }]}/>
        <p.demo-note>{total == null ? "Change the quantity to see on_change." : `on_change: the month comes to ${total}.`}</p>
    </div>
}

view CloudCostEstimatorDemo() =
    <div.demo-stack>
        <CloudCostEstimator id="cloud-cost-estimator-demo" currency="USD" locale="en-US" resources={cloud_cost_estimator_demo_resources}/>
        <CloudCostEstimatorDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "cloud_cost_estimator", name: "CloudCostEstimator", group: "Dashboard",
    summary: "Prices cloud resources through graduated tiers, compares reserved with on-demand, and says what drives the bill most.",
    tags: ["smart", "interactive", "cloud", "cost", "calculator", "pricing"], demo: CloudCostEstimatorDemo })
