view CtaSectionDemo() =
    <div.demo-stack>
        <CtaSection id="cta-section-demo" title="Ready to try it?" text="Free for one project and up to three people. No card needed.">
            <Button size="lg" tone="neutral" href="#cta_section">Create an account</Button>
            <Button size="lg" variant="ghost" tone="neutral" href="#cta_section">Read the docs</Button>
        </CtaSection>
        <CtaSection tone="soft" align="split" title="Questions about pricing?" text="Write to us; we answer within a working day.">
            <Button href="#cta_section">Email us</Button>
        </CtaSection>
        <CtaSection tone="outline" title="Join the newsletter">
            <Button variant="outline" href="#cta_section">Subscribe</Button>
        </CtaSection>
    </div>

ui_gallery = ui_gallery | push({ slug: "cta_section", name: "CtaSection", group: "Marketing",
    summary: "A call-to-action band: a title, a line and the buttons, filled, tinted or outlined, centred or split.",
    tags: ["marketing", "section", "button", "page", "no-js"],
    demo: CtaSectionDemo })
