view ProgressRingDemo() =
    <div.demo-stack>
        <div.demo-row style="gap: 24px">
            <ProgressRing value={8} size="sm" label="Uploading"/>
            <ProgressRing value={42} label="Storage used"/>
            <ProgressRing value={3} max={5} value_text="3/5" size="lg" tone="success" label="Lessons done"/>
            <ProgressRing value={91} size="xl" tone="warning" thickness={8} label="Monthly quota" show_label={true}/>
        </div>
        <div.demo-row style="gap: 24px">
            <ProgressRing value={100} tone="success" label="Backup complete" show_label={true}/>
            <ProgressRing value={0} label="Not started" show_label={true}/>
            <ProgressRing size="sm" label="Syncing" show_label={true}/>
            <ProgressRing size="lg" tone="neutral" label="Preparing export" show_label={true}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "progress_ring", name: "ProgressRing", group: "Feedback",
    summary: "Circular progress in four sizes, with its percentage or a value of your own in the middle, or turning while not known.",
    tags: ["feedback", "progress", "no-js"],
    demo: ProgressRingDemo })
