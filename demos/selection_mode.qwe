let selection_mode_demo_mail = [
    { id: 1, title: "Grace Hopper", text: "Compiler notes for Thursday", meta: "09:12" },
    { id: 2, title: "Katherine Johnson", text: "Trajectory checks attached", meta: "08:40" },
    { id: 3, title: "Alan Turing", text: "Re: the bombe schedule", meta: "Mon" },
    { id: 4, title: "Margaret Hamilton", text: "Priority display review", meta: "Mon" },
    { id: 5, title: "Dorothy Vaughan", text: "Fortran class, room change", meta: "Sun", disabled: true },
    { id: 6, title: "Edsger Dijkstra", text: "Shortest path to lunch", meta: "Sat" },
    { id: 7, title: "Barbara Liskov", text: "Substitution, again", meta: "Sat" },
    { id: 8, title: "John McCarthy", text: "Garbage collection meeting", meta: "Fri" },
    { id: 9, title: "Radia Perlman", text: "Spanning trees poem", meta: "Fri" },
    { id: 10, title: "Donald Knuth", text: "A reward cheque for 2.56", meta: "Thu" },
    { id: 11, title: "Ada Lovelace", text: "Notes on the engine", meta: "Wed" },
    { id: 12, title: "Tim Berners-Lee", text: "A small proposal", meta: "Tue" },
    { id: 12, title: "Tim Berners-Lee", text: "A small proposal", meta: "Tue" }
]

component SelectionModeDemoLive() {
    state mail = selection_mode_demo_mail
    state log = "none"
    state opened = "none"
    state ids = ""
    state mode = "off"
    <div.demo-stack>
        <div.demo-phone style="height: 560px">
            <SelectionMode id="selmode-demo" label="Inbox" items={mail} hold={450}
                           actions={[{ key: "archive", label: "Archive" }, { key: "delete", label: "Delete", danger: true }]}
                           on_open={(the_id) => { opened = str(the_id) }}
                           on_change={(chosen) => { ids = join(chosen, ",") }}
                           on_mode={(on) => { mode = on ? "on" : "off" }}
                           on_action={(key, chosen) => {
                               log = `${key}:${join(chosen, ",")}`
                               if key == "delete" { mail = mail | filter((m) => !contains(chosen, m.id)) }
                           }}/>
        </div>
        <p.demo-note>Mode <b data-mode>{mode}</b>; opened <b data-opened>{opened}</b>; chosen <b data-ids>{ids}</b>; last action <b data-log>{log}</b></p>
        <div style="height: 300px"><SelectionMode id="selmode-none" items={[null, { title: "no id" }]} empty="No mail" label="Empty"/></div>
    </div>
}

view SelectionModeDemo() = <SelectionModeDemoLive/>

ui_gallery = ui_gallery | push({ slug: "selection_mode", name: "SelectionMode", group: "Mobile",
    summary: "Long press starts selecting, tap adds, a toolbar shows the count and actions, and back leaves the mode.",
    tags: ["mobile", "interactive", "tablet", "list", "gesture", "selection"],
    demo: SelectionModeDemo })
