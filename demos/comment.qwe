component CommentDemoLive() {
    state liked = false
    state likes = 3
    state replies = 0
    <div.demo-stack>
        <Comment id="comment-demo-live" name="Ben Okafor" role="Author" time="1 h" datetime="2026-10-28T10:30:00Z"
                 text="Yes, and Postgres: the same query runs on both." likes={likes} liked={liked}
                 on_like={(on) => { liked = on; likes = on ? likes + 1 : likes - 1 }}
                 on_reply={() => { replies += 1 }}/>
        <p.demo-note>{liked ? "You liked it." : "Not liked."} Reply pressed {replies} {replies == 1 ? "time" : "times"}.</p>
    </div>
}

view CommentDemo() =
    <div.demo-stack>
        <Comment id="comment-demo-first" name="Ana Silva" time="2 h" datetime="2026-10-28T09:12:00Z" likes={12}
                 text="Does this work with SQLite too?
Asking for a small project.">
            <Comment name="Ben Okafor" role="Author" time="1 h" text="It does. The migrations run the same way." likes={2}>
                <Comment name="Ana Silva" time="40 min" text="Great, thanks!"/>
            </Comment>
            <Comment name="Lee Chen" avatar="https://i.pravatar.cc/80?img=12" time="30 min" text="Same question here, answered then."/>
        </Comment>
        <CommentDemoLive/>
        <Comment id="comment-demo-quiet" name="Mia Rossi" time="Yesterday" text="A comment with no actions under it." actions={false}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "comment", name: "Comment", group: "Social",
    summary: "One comment: avatar, name, role, time, text, Like and Reply, with its replies nested inside it.",
    tags: ["social", "comment", "user", "no-js"], demo: CommentDemo })
