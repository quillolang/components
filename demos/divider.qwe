view DividerDemo() =
    <div.demo-stack.demo-narrow>
        <p.demo-note>Above the line.</p>
        <Divider spacing="sm"/>
        <Button variant="outline" full={true}>Continue with email</Button>
        <Divider label="or"/>
        <Button variant="outline" full={true}>Continue with a passkey</Button>
        <div.demo-row style="gap: 0">
            <Button variant="ghost" size="sm">Edit</Button>
            <Divider vertical={true} spacing="sm"/>
            <Button variant="ghost" size="sm">Share</Button>
            <Divider vertical={true} spacing="sm"/>
            <Button variant="ghost" size="sm">Archive</Button>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "divider", name: "Divider", group: "Layout",
    summary: "A line between parts of a page, across or upright, with a label in the middle if it has one.",
    tags: ["layout", "no-js"],
    demo: DividerDemo })
