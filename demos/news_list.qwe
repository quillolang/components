let news_list_demo_items = [
    { title: "Quillo 0.5: components resume where the server left them", href: "#news_list", source: "Blog", time: "2 h ago", datetime: "2026-10-28T08:00:00Z", src: "https://picsum.photos/seed/n1/128/96" },
    { title: "The UI kit passes 400 components", href: "#news_list", source: "Blog", time: "Yesterday", datetime: "2026-10-27T10:00:00Z", src: "https://picsum.photos/seed/n2/128/96" },
    { title: "Services: one program, split apart when it is time", href: "#news_list", source: "Docs", time: "Oct 20", datetime: "2026-10-20" },
    { title: "Decimals, money and why floats cannot bill", href: "#news_list", source: "Guides", time: "Oct 12", datetime: "2026-10-12" },
]

view NewsListDemo() =
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 32px; align-items: start">
        <NewsList id="news-list-demo-latest" label="Latest" items={news_list_demo_items}/>
        <NewsList id="news-list-demo-top" label="Most read" numbered={true} dense={true}
                  items={news_list_demo_items | map((n) => { title: n.title, href: n.href, time: n.time })}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "news_list", name: "NewsList", group: "Data",
    summary: "Headlines in a compact list with source, time and a small picture; numbered for a most-read list.",
    tags: ["list", "link", "marketing", "no-js"],
    demo: NewsListDemo })
