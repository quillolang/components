view MilestoneListDemo() =
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 32px; align-items: start">
        <MilestoneList id="milestone-list-demo-launch" title="Launch" items={[
            { title: "Design signed off", date: "2026-09-01", status: "done" },
            { title: "Private alpha", date: "2026-09-20", status: "done", href: "#milestone_list" },
            { title: "Beta", date: "2026-10-15", status: "current", progress: 60, text: "3 of 5 features in" },
            { title: "Security review", date: "2026-10-20", status: "late", progress: 25, text: "Waiting on the auditors" },
            { title: "Public launch", date: "2026-11-30" },
        ]}/>
        <MilestoneList id="milestone-list-demo-plain" summary={false} label="Q4" items={[
            { title: "Hire two engineers", date: "December" }, { title: "Open the Porto office", status: "current" },
        ]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "milestone_list", name: "MilestoneList", group: "Data",
    summary: "Milestones down a line with dates, done, current, coming or late, a progress bar on those under way, and the whole project's progress.",
    tags: ["list", "progress", "schedule", "no-js"],
    demo: MilestoneListDemo })
