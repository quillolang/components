let variant_sheet_demo_options = [
    { key: "size", label: "Size", values: ["S", "M", "L", "XL"] },
    { key: "colour", label: "Colour", values: [{ value: "sand", label: "Sand", swatch: "#d8c7a8" }, { value: "navy", label: "Navy", swatch: "#1f2a44" }, { value: "rust", label: "Rust", swatch: "#a4502b" }] },
]

let variant_sheet_demo_stock = [
    { size: "S", colour: "sand", qty: 4 },
    { size: "S", colour: "navy", qty: 0, due: "2026-12-12" },
    { size: "M", colour: "sand", qty: 2, price: "52.00" },
    { size: "M", colour: "navy", qty: 7 },
    { size: "L", colour: "navy", qty: 0 },
    { size: "XL", colour: "sand", qty: 0, due: "2026-12-20" },
    { size: "S", colour: "rust", qty: 0 },
]

let variant_sheet_demo_image = "data:image/svg+xml," + url_encode("<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 300 300'><rect width='300' height='300' fill='#d8c7a8'/><path d='M100 60h100l50 40-30 40-20-14v124H100V126l-20 14-30-40z' fill='#b8a27c'/></svg>")

component VariantSheetDemoLive() {
    state got = "Nothing added yet."
    <div.demo-stack>
        <VariantSheet title="Linen shirt" price="48.00" image={variant_sheet_demo_image} id="variant-demo"
                      options={variant_sheet_demo_options} stock={variant_sheet_demo_stock}
                      on_pick={(r) => { got = `Added ${r.size} ${r.colour} at ${r.price}, ${r.qty} there` }}/>
        <p.demo-note id="variant-demo-got">{got}</p>
    </div>
}

view VariantSheetDemo() = <VariantSheetDemoLive/>

ui_gallery = ui_gallery | push({ slug: "variant_sheet", name: "VariantSheet", group: "Mobile",
    summary: "Pick size and colour in a sheet, with stock by combination and each unavailable option marked with its reason.",
    tags: ["mobile", "interactive", "commerce", "sheet", "stock", "tablet"],
    needs: ["cart_sheet"],
    demo: VariantSheetDemo })
