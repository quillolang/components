let downloads_list_demo_items = [
    { id: "a", title: "Episode 12: Views first", size: 41000000, done: 20500000, state: "loading" },
    { id: "b", title: "Harbour film", size: 1200000000, done: 300000000, state: "loading" },
    { id: "c", title: "Salt, the album", size: 88000000, done: 30000000, state: "paused" },
    { id: "d", title: "Salt roads", size: 62000000, done: 12000000, state: "failed", error: "Connection lost" },
    { id: "e", title: "Fog", size: 15000000, state: "queued" },
    { id: "f", title: "Weather for sailors", size: 9000000, state: "done" },
    { title: "no id" },
    "bad",
]

fn downloads_list_demo_on(d, field: str, v) = type_of(d) == "map" ? set(d, field, v) : d

component DownloadsListDemoLive() {
    state list_of = downloads_list_demo_items
    state turn = 0
    state said = "none"
    state hold = "no"
    state on_data = "unset"
    let mark = (d, st) => { list_of = list_of | map((x) => type_of(x) == "map" && get(x, "id") == d.id ? downloads_list_demo_on(x, "state", st) : x) }
    <div.demo-stack>
        <DownloadsList key={turn} items={list_of} quota={5000000000}
                       on_pause={(d) => { said = `pause ${d.id}` }}
                       on_resume={(d) => { said = `resume ${d.id}`; mark(d, "loading") }}
                       on_retry={(d) => { said = `retry ${d.id}`; mark(d, "loading") }}
                       on_remove={(d) => { said = `remove ${d.id}` }}
                       on_wifi_only={(on) => { on_data = `${on}` }}
                       on_hold={(held) => { hold = held ? "yes" : "no" }}
                       on_clear={(done) => { said = `clear ${len(done)}`; list_of = list_of | filter((x) => type_of(x) != "map" || get(x, "state") != "done") }}/>
        <p.demo-note id="dlist-demo-note">Last {said}; held {hold}; setting {on_data}</p>
        <div.demo-row>
            <Button id="dlist-demo-more" size="lg" variant="ghost" on_click={() => {
                list_of = list_of | map((x) => type_of(x) == "map" && get(x, "state") == "loading" ? set(x, "done", min([get(x, "size") ?? 0, (get(x, "done") ?? 0) + 20500000])) : x)
            }}>A bit more arrives</Button>
            <Button id="dlist-demo-again" size="lg" variant="ghost" on_click={() => { list_of = downloads_list_demo_items; turn += 1 }}>Make it again</Button>
        </div>
        <div id="dlist-demo-none"><DownloadsList items={null}/></div>
    </div>
}

view DownloadsListDemo() = <DownloadsListDemoLive/>

ui_gallery = ui_gallery | push({ slug: "downloads_list", name: "DownloadsList", group: "Mobile",
    summary: "Items with size, progress, pause and retry, the storage used, and a Wi-Fi only setting that holds to the network.",
    tags: ["mobile", "interactive", "media", "downloads", "network", "tablet"],
    demo: DownloadsListDemo })
