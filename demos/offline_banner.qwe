component OfflineBannerDemoLive() {
    state seen = []
    <div.demo-stack>
        <OfflineBanner sticky={false} title="No connection." text="You can keep writing: your changes are sent when it is back."
                       on_change={(on) => { seen = push(seen, on ? "online" : "offline") }}/>
        <p.demo-note>{len(seen) == 0 ? "Nothing shows while online. Turn the network off to see the banners." : `Seen: ${join(seen, ", ")}.`}</p>
    </div>
}

view OfflineBannerDemo() =
    <div.demo-stack>
        <OfflineBannerDemoLive/>
        <OfflineBanner reload={true}/>
        <p.demo-note>The second is the default: fixed across the top of the window, with a Try again button here.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "offline_banner", name: "OfflineBanner", group: "Utilities",
    summary: "A banner across the top of the page for as long as the browser is offline, gone by itself when the connection is back.",
    tags: ["utility", "notification", "status", "interactive"],
    demo: OfflineBannerDemo })
