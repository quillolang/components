view GradientTextDemo() =
    <div.demo-stack>
        <Heading level={1}>Build <GradientText id="gradient-text-demo-accent">beautiful</GradientText> apps in one file</Heading>
        <div.demo-row style="font: 650 26px/1.2 var(--ui-font)">
            <GradientText preset="sunset" id="gradient-text-demo-sunset">Sunset</GradientText>
            <GradientText preset="ocean">Ocean</GradientText>
            <GradientText preset="forest">Forest</GradientText>
        </div>
        <div style="font: 600 20px/1.3 var(--ui-font)">
            <GradientText tag="p" from="#0ea5e9" to="#8b5cf6" angle={135} id="gradient-text-demo-custom">Any two colours, at any angle, as a paragraph.</GradientText>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "gradient_text", name: "GradientText", group: "Typography",
    summary: "Text filled with a gradient: the theme's, a preset, or any two colours at an angle.",
    tags: ["typography", "text", "marketing", "no-js"],
    demo: GradientTextDemo })
