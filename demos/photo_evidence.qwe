component PhotoEvidenceDemoLive() {
    state sent = []
    state said = "Nothing sent yet."
    <div.demo-stack>
        <PhotoEvidence job="Job 4471" required={[{ tag: "Front", count: 1 }, { tag: "Damage", count: 2 }]} tags={["Other"]} limit={6}
                       store="demo" library={true}
                       on_send={(p) => {
                           sent = sent + [p.tag]
                           said = `Sent: ${join(sent, ", ")}`
                       }}
                       on_done={(ps) => { said = `Done with ${len(ps)} photos.` }}/>
        <p.demo-note id="phev-demo-said">{said}</p>
    </div>
}

view PhotoEvidenceDemo() = <PhotoEvidenceDemoLive/>

ui_gallery = ui_gallery | push({ slug: "photo_evidence", name: "PhotoEvidence", group: "Mobile",
    summary: "Photos stamped with the time and place into the picture, with counts of what is still needed, tags, and a queue for when there is no connection.",
    tags: ["mobile", "interactive", "camera", "offline", "field", "tablet"],
    demo: PhotoEvidenceDemo })
