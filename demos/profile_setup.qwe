let profile_setup_demo_steps = [
    { id: "photo", kind: "photo", title: "Add a photo", text: "People you share a page with will see it." },
    { id: "name", kind: "text", title: "What should we call you?", label: "Your name", placeholder: "Ada Lovelace", autocomplete: "name" },
    { id: "use", kind: "choice", title: "What brings you here?", text: "We use this to pick your first template.", options: ["Work", "School", "Just for me"] },
]

component ProfileSetupDemoLive() {
    state run = 0
    state said = "Not finished."
    <div.demo-stack>
        <div.demo-phone id="profile-setup-demo-frame">
            <ProfileSetup key={run} remember="ui-demo-profile" steps={profile_setup_demo_steps}
                on_finish={(r) => { said = `Finished. Done: ${r.done | join(", ")}. Left: ${r.left | join(", ")}.` }}/>
        </div>
        <div.demo-row>
            <Button size="lg" variant="outline" id="profile-setup-demo-open" on_click={() => { run = run + 1 }}>Leave and come back</Button>
            <Button size="lg" variant="ghost" id="profile-setup-demo-forget" on_click={() => {
                welcome_carousel_forget("ui-demo-profile")
                js("localStorage.removeItem", "ui-demo-profile-photos")
                said = "Not finished."
                run = run + 1
            }}>Start over</Button>
        </div>
        <p.demo-note id="profile-setup-demo-said">{said}</p>
    </div>
}

view ProfileSetupDemo() = <ProfileSetupDemoLive/>

ui_gallery = ui_gallery | push({ slug: "profile_setup", name: "ProfileSetup", group: "Mobile",
    summary: "A few steps after sign-up with a skip: keeps progress, a photo, a name, and ends with what was left undone.",
    tags: ["mobile", "interactive", "tablet", "onboarding", "profile", "forms"],
    needs: ["welcome_carousel"],
    demo: ProfileSetupDemo })
