let icon_tabs_demo_tabs = [
    { label: "Photos", icon: "M4 5h16v14H4zM4 15l5-5 4 4 3-3 4 4" },
    { label: "Albums", icon: "M4 6h16v14H4zM8 3h8M8 10h8", badge: 3 },
    { label: "Shared", icon: "M16 19v-1a4 4 0 0 0-8 0v1M12 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6M20 19v-1a3 3 0 0 0-2-2.8" },
    { label: "Trash", icon: "M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13", disabled: true }
]

component IconTabsDemoLive() {
    state tab = 0
    <div.demo-stack>
        <IconTabs id="icon-tabs-demo" label="Library" tabs={icon_tabs_demo_tabs} selected={tab} on_change={(i) => { tab = i }}>
            <p.demo-note>{icon_tabs_demo_tabs[tab].label}: the panel for tab {tab + 1} of 4, from state.</p>
        </IconTabs>
    </div>
}

component IconTabsDemoFull() {
    state tab = 1
    <div style="width: min(360px, 100%)">
        <IconTabs id="icon-tabs-demo-full" full={true} size="sm" label="Emoji" selected={tab} on_change={(i) => { tab = i }}
                  tabs={[{ label: "Feed", icon: "📰" }, { label: "Explore", icon: "🧭" }, { label: "Saved", icon: "🔖", badge: 12 }]}>
            <p.demo-note>Tab {tab + 1} of 3, the tabs sharing the width.</p>
        </IconTabs>
    </div>
}

view IconTabsDemo() =
    <div.demo-stack style="gap: 28px">
        <IconTabsDemoLive/>
        <IconTabsDemoFull/>
    </div>

ui_gallery = ui_gallery | push({ slug: "icon_tabs", name: "IconTabs", group: "Navigation",
    summary: "Tabs with an icon above each label and a count on its corner, the arrow keys moving between them.",
    tags: ["navigation", "tabs", "icon", "interactive"], demo: IconTabsDemo })
