component SwitchDemoLive() {
    state on = true
    <div.demo-stack>
        <Switch label="Email me about replies" hint="At most one a day." checked={on}
                on_change={(v) => { on = v }}/>
        <p.demo-note>Emails are {on ? "on" : "off"}.</p>
    </div>
}

view SwitchDemo() =
    <div.demo-stack>
        <SwitchDemoLive/>
        <div.demo-row>
            <Switch name="beta" label="Beta features"/>
            <Switch size="sm" label="Small" checked={true}/>
            <Switch label="Disabled" disabled={true}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "switch", name: "Switch", group: "Forms",
    summary: "An on/off toggle that is a real checkbox: it submits with a form and works with the keyboard.",
    tags: ["forms", "input", "no-js"],
    demo: SwitchDemo })
