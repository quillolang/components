component PasswordGeneratorDemoLive() {
    state n = 0
    <div.demo-stack>
        <PasswordGenerator id="password-generator-demo-phrase" title="A passphrase" mode="passphrase" count={5} on_change={(p) => { n += 1 }}/>
        <p.demo-note data-said="true">{`on_change has been called ${n} time${n == 1 ? "" : "s"}.`}</p>
    </div>
}

view PasswordGeneratorDemo() =
    <div.demo-stack>
        <PasswordGenerator id="password-generator-demo" length={20}/>
        <PasswordGeneratorDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "password_generator", name: "PasswordGenerator", group: "Forms",
    summary: "Generates from a policy with a cryptographic source and no modulo bias, as random, pronounceable or a passphrase, shows true entropy, and refuses an impossible policy.",
    tags: ["smart", "interactive", "password", "security", "generator", "entropy"], demo: PasswordGeneratorDemo })
