component PasswordStrengthDemoLive() {
    state word = ""
    <div.demo-stack>
        <PasswordStrength name="pw_live" label="Choose a password" min_length={12} rules={["length", "case", "number"]}
                          field="password-strength-demo-live" on_input={(t, s) => { word = s }}/>
        <p.demo-note>{word == "" ? "Nothing typed." : `on_input says ${word}.`}</p>
    </div>
}

view PasswordStrengthDemo() =
    <div.demo-stack.demo-narrow>
        <PasswordStrength name="pw" field="password-strength-demo-plain" hint="Use a passphrase you do not use elsewhere." required={true}/>
        <PasswordStrengthDemoLive/>
        <PasswordStrength name="pw_bad" label="Small" size="sm" field="password-strength-demo-small" value="abc"
                          error="That password was found in a leak."/>
    </div>

ui_gallery = ui_gallery | push({ slug: "password_strength", name: "PasswordStrength", group: "Forms",
    summary: "A new-password field with a meter that fills as it gets stronger and a checklist of rules ticked as they are met.",
    tags: ["forms", "input", "security", "feedback", "interactive"], demo: PasswordStrengthDemo })
