view LinkListDemo() =
    <div.demo-row style="align-items: flex-start; gap: 32px">
        <div style="flex: 1 1 300px; max-width: 420px">
            <LinkList id="link-list-demo" heading="Read next" items={[
                { label: "Getting started", href: "#start", description: "Install Quillo and write a first page with a route and a view.",
                  icon: "M12 3 2 8l10 5 10-5zM2 14l10 5 10-5" },
                { label: "Components", href: "#link_list", description: "The UI kit, each component with its examples and its props.",
                  icon: "M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z" },
                { label: "Source on GitHub", href: "https://github.com/quillolang", external: true,
                  description: "The language, the kit and the examples.", icon: "M8 6 2 12l6 6M16 6l6 6-6 6" }
            ]}/>
        </div>
        <div style="flex: 1 1 300px; max-width: 420px">
            <LinkList id="link-list-demo-divided" label="Downloads" divided={true} arrows={true} items={[
                { label: "Quillo 0.5.0 for macOS", href: "#mac", description: "Apple silicon and Intel", meta: "14 MB" },
                { label: "Quillo 0.5.0 for Linux", href: "#linux", description: "x86-64 and arm64", meta: "12 MB" },
                { label: "Quillo 0.5.0 for Windows", href: "#win", meta: "15 MB" }
            ]}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "link_list", name: "LinkList", group: "Navigation",
    summary: "A plain list of links, each with a line saying where it leads, an icon and a short note at the right.",
    tags: ["navigation", "link", "list", "no-js"], demo: LinkListDemo })
