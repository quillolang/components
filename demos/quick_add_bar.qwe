component QuickAddBarDemoLive() {
    state added = []
    state live = "nothing"
    <div.demo-stack>
        <QuickAddBar today="2026-11-04" now="10:20" lists={["Inbox", "Work", "Home", "Side project"]}
                     on_add={(t) => { added = added + [t] }}
                     on_change={(t) => { live = `${t.title}|${t.date}|${t.time}|${t.list}|${t.priority}` }}/>
        <ul.demo-note id="quick-add-added">{for t in added => <li>{t.title} / {t.date} / {t.time} / {t.list} / {t.priority} / {t.repeat}</li>}</ul>
        <p.demo-note id="quick-add-live">{live}</p>
    </div>
}

component QuickAddBarDemoDocked() {
    <div.demo-phone id="quick-add-screen" style="height: 240px">
        <QuickAddBar today="2026-11-04" lists={["Work"]} docked={true} new_lists={false} day_first={false}/>
    </div>
}

view QuickAddBarDemo() = <div.demo-stack><QuickAddBarDemoLive/><QuickAddBarDemoDocked/></div>

ui_gallery = ui_gallery | push({ slug: "quick_add_bar", name: "QuickAddBar", group: "Mobile",
    summary: "Type a line and it finds the date, list and priority in the words, marked as you go.",
    tags: ["mobile", "interactive", "tasks", "dates", "keyboard", "tablet"],
    demo: QuickAddBarDemo })
