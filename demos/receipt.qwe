view ReceiptDemo() =
    <div.demo-row style="align-items: flex-start; gap: 28px">
        <Receipt id="receipt-demo-cafe" store="Corner Café" address="12 Bridge Street, Porto" phone="+351 22 000 0000" number="0042"
                 date="2026-10-28T09:14:00" cashier="Rui" table="4" currency="€"
                 lines={[{ name: "Flat white", qty: 2, unit: "3.50", amount: "7.00" }, { name: "Croissant", amount: "2.80" }, { name: "Orange juice", qty: 1, amount: "3.20" }]}
                 subtotal="13.00" discount="−1.30" tax="1.17" tax_label="VAT 10%" tip="1.00" total="13.87"
                 paid={[{ method: "Cash", amount: "20.00" }]} change="6.13" footer="Thank you, come again\nWi-Fi: cornercafe / espresso" code="ORD-20261028-0042"/>
        <Receipt id="receipt-demo-min" store="Kiosk" date="2026-10-28" lines={[{ name: "Newspaper", amount: "$2.50" }]} total="$2.50"/>
    </div>

ui_gallery = ui_gallery | push({ slug: "receipt", name: "Receipt", group: "Data",
    summary: "A narrow till-style receipt in a monospace face: shop, date, lines, totals, payment and change, a footer and a torn edge.",
    tags: ["document", "commerce", "price", "print", "no-js"],
    demo: ReceiptDemo })
