let swipe_tabs_demo_tabs = [{ id: "top", label: "Top" }, { id: "local", label: "Local" }, { id: "business", label: "Business" }, { id: "sport", label: "Sport" }, { id: "weather", label: "Weather" }]

component SwipeTabsDemoCounter(name: str) {
    state n = 0
    <Button size="lg" variant="outline" on_click={() => { n += 1 }}>{name} liked {n}</Button>
}

view SwipeTabsDemoPage(name: str) =
    <div data-built={name} style="padding: 12px 16px">
        <SwipeTabsDemoCounter name={name}/>
        {for i in range(1, 30) => <p key={i} style="margin: 0; padding: 14px 0; border-bottom: 1px solid var(--ui-border)">{name} story {i}</p>}
    </div>

component SwipeTabsDemoLive() {
    state shown = "top"
    state changes = 0
    state wanted = "top"
    <div.demo-stack>
        <div.demo-tablet>
            <SwipeTabs id="swipe-tabs-demo" current={wanted} tabs={swipe_tabs_demo_tabs} page={(t) => <SwipeTabsDemoPage name={t}/>}
                       on_change={(t) => { shown = t; changes += 1 }}/>
        </div>
        <p class="demo-note">Showing {shown}, after {changes} {changes == 1 ? "change" : "changes"}</p>
        <Button size="lg" variant="outline" on_click={() => { wanted = "sport" }}>Go to sport</Button>
        <p class="demo-note">Starting on the third tab, with a tab given twice and a bad row dropped:</p>
        <div style="height: 260px; border: 1px solid var(--ui-border)">
            <SwipeTabs id="swipe-tabs-demo-third" current="business" tabs={[null, swipe_tabs_demo_tabs[0], swipe_tabs_demo_tabs[0], swipe_tabs_demo_tabs[1], swipe_tabs_demo_tabs[2]]}
                       page={(t) => <p data-third={t} style="margin: 12px">{t} page</p>}/>
        </div>
    </div>
}

view SwipeTabsDemo() = <SwipeTabsDemoLive/>

ui_gallery = ui_gallery | push({ slug: "swipe_tabs", name: "SwipeTabs", group: "Mobile",
    summary: "Pages swiped sideways in step with their tab strip, the line under the tabs tracking the finger, pages built when reached; tapping and keys do the same.",
    tags: ["mobile", "interactive", "tablet", "tabs", "swipe", "gesture"],
    demo: SwipeTabsDemo })
