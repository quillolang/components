let bottom_nav_demo_items = [
    { label: "Home", href: "#home", icon: "M3 11 12 3l9 8M5 9.5V21h14V9.5" },
    { label: "Search", href: "#search", icon: "M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14zM16 16l5 5" },
    { label: "Inbox", href: "#bottom_nav", icon: "M4 4h16v16H4zM4 13h5l1.5 2h3L15 13h5", badge: 3 },
    { label: "Profile", href: "#profile", icon: "M16 19v-1a4 4 0 0 0-8 0v1M12 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6" }
]

component BottomNavDemoLive() {
    state tab = "Feed"
    <div.demo-stack>
        <div style="width: min(360px, 100%); border: 1px solid var(--ui-border); border-radius: var(--ui-radius); overflow: hidden">
            <div style="height: 80px; padding: 14px"><p.demo-note>Showing: {tab}</p></div>
            <BottomNav id="bottom-nav-demo-live" fixed={false} labels={false} current={tab} items={[
                { label: "Feed", icon: "📰" }, { label: "Explore", icon: "🧭" }, { label: "Saved", icon: "🔖", badge: 7 }
            ]} on_select={(it) => { tab = it.label }}/>
        </div>
    </div>
}

view BottomNavDemo() =
    <div.demo-stack>
        <div style="width: min(360px, 100%); border: 1px solid var(--ui-border); border-radius: var(--ui-radius); overflow: hidden">
            <div style="height: 80px; padding: 14px"><p.demo-note>A phone's screen; the bar stays at its bottom.</p></div>
            <BottomNav id="bottom-nav-demo" fixed={false} items={bottom_nav_demo_items} current="#bottom_nav"/>
        </div>
        <BottomNavDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "bottom_nav", name: "BottomNav", group: "Navigation",
    summary: "A fixed bar of icon tabs along the bottom of a phone's screen, with counts and the current one marked.",
    tags: ["navigation", "mobile", "tabs", "icon", "no-js"], demo: BottomNavDemo })
