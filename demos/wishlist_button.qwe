component WishlistButtonDemoLive() {
    state saved = false
    <div.demo-row>
        <WishlistButton id="sku-7" text={true} on_change={(on) => { saved = on }}/>
        <p.demo-note>{saved ? "Saved for later (on_change)." : "Not saved."}</p>
    </div>
}

view WishlistButtonDemo() =
    <div.demo-stack>
        <WishlistButtonDemoLive/>
        <div.demo-row style="gap: 20px">
            <WishlistButton name="wish" id="sku-1"/>
            <WishlistButton saved={true} size="sm"/>
            <WishlistButton size="lg"/>
            <WishlistButton variant="plain" text={true} label="Save for later" saved_label="Saved for later"/>
        </div>
        <div style="position: relative; width: 160px; height: 110px; border-radius: var(--ui-radius); background: var(--ui-subtle)">
            <span style="position: absolute; top: 8px; right: 8px"><WishlistButton/></span>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "wishlist_button", name: "WishlistButton", group: "Commerce",
    summary: "A heart that saves a product for later: a pressed-state toggle, named for screen readers, with a hidden input for forms.",
    tags: ["commerce", "button", "forms", "interactive"], demo: WishlistButtonDemo })
