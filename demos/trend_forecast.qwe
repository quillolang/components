let trend_forecast_demo_points = [
    { t: "2024-01-01", value: 132 }, { t: "2024-02-01", value: 118 }, { t: "2024-03-01", value: 141 }, { t: "2024-04-01", value: 160 },
    { t: "2024-05-01", value: 150 }, { t: "2024-06-01", value: 139 }, { t: "2024-07-01", value: 164 }, { t: "2024-08-01", value: 181 },
    { t: "2024-09-01", value: 170 }, { t: "2024-10-01", value: 157 }, { t: "2024-11-01", value: 182 }, { t: "2024-12-01", value: 201 },
    { t: "2025-01-01", value: 188 }, { t: "2025-02-01", value: 178 }, { t: "2025-03-01", value: 200 }, { t: "2025-04-01", value: 222 },
]

component TrendForecastDemoLive() {
    state seen = "Change a field to see on_change."
    <div.demo-stack>
        <TrendForecast id="trend-forecast-demo-live" title="Tickets a week" name="tickets" horizon={3} confidence={90} period="none"
                       points={[40, 12, 55, 23, 61, 8, 37, 49, 15, 52]}
                       on_change={(r) => { seen = r == null ? "on_change: nothing to fit." : `on_change: ${len(r.forecast)} steps.` }}/>
        <p.demo-note>{seen}</p>
    </div>
}

view TrendForecastDemo() =
    <div.demo-stack>
        <TrendForecast id="trend-forecast-demo" title="Monthly sales" points={trend_forecast_demo_points} horizon={4}/>
        <TrendForecastDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "trend_forecast", name: "TrendForecast", group: "Charts",
    summary: "Fits a least-squares trend and any seasonal pattern to a series, forecasts it with a band, and warns plainly when the fit is poor.",
    tags: ["smart", "interactive", "forecast", "trend", "chart", "regression"], demo: TrendForecastDemo })
