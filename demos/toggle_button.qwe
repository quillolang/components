let toggle_button_demo_mic = "M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3ZM19 10v2a7 7 0 0 1-14 0v-2M12 19v3"
let toggle_button_demo_star = "M12 2l3.1 6.3 6.9 1-5 4.9 1.2 6.8-6.2-3.2-6.2 3.2 1.2-6.8-5-4.9 6.9-1z"

component ToggleButtonDemoLive() {
    state follows = false
    state styles = ["b"]
    <div.demo-stack>
        <div.demo-row>
            <ToggleButton label="Follow" pressed_label="Following" variant="soft" on_change={(on) => { follows = on }}/>
            <span.demo-note>{follows ? "You follow Ana: her posts show in your feed." : "Not following Ana."}</span>
        </div>
        <div.demo-row>
            <ToggleButtonGroup label="Text style" multiple={true} values={styles} icon_only={true}
                               on_change={(vs) => { styles = vs }}
                               options={[{ label: "Bold", value: "b", icon: "B" }, { label: "Italic", value: "i", icon: "I" },
                                         { label: "Underline", value: "u", icon: "U" }]}/>
            <span.demo-note>Styles: {len(styles) == 0 ? "none" : join(styles | sort(), ", ")}</span>
        </div>
    </div>
}

view ToggleButtonDemo() =
    <div.demo-stack>
        <div.demo-row>
            <ToggleButton label="Mute" icon={toggle_button_demo_mic} name="mute"/>
            <ToggleButton label="Star" icon={toggle_button_demo_star} icon_only={true} pressed={true}/>
            <ToggleButton label="Notifications" variant="ghost" pressed={true}/>
            <ToggleButton label="Small" size="sm"/>
            <ToggleButton label="Locked" disabled={true}/>
        </div>
        <div.demo-row>
            <ToggleButtonGroup name="align" label="Alignment" value="left"
                               options={[{ label: "Left", value: "left" }, { label: "Center", value: "center" },
                                         { label: "Right", value: "right" }]}/>
            <ToggleButtonGroup name="days" label="Days" multiple={true} values={["mon", "wed"]} attached={false} size="sm"
                               options={[{ label: "Mon", value: "mon" }, { label: "Tue", value: "tue" }, { label: "Wed", value: "wed" },
                                         { label: "Thu", value: "thu" }, { label: "Fri", value: "fri" }]}/>
        </div>
        <ToggleButtonDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "toggle_button", name: "ToggleButton", group: "Actions",
    summary: "A button that stays pressed, alone or in a group where one or any number are pressed; a form sends it.",
    tags: ["forms", "button", "interactive"],
    demo: ToggleButtonDemo })
