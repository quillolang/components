let scroll_tabs_demo_months = ["January", "February", "March", "April", "May", "June", "July", "August", "September",
                               "October", "November", "December"]

component ScrollTabsDemoLive() {
    state m = 0
    <div style="width: min(420px, 100%)">
        <ScrollTabs id="scroll-tabs-demo" label="Months" labels={scroll_tabs_demo_months} selected={m} on_change={(i) => { m = i }}>
            <p.demo-note>Sales for {scroll_tabs_demo_months[m]} (tab {m + 1} of 12). The row scrolls: the arrows, a swipe, or the arrow keys.</p>
        </ScrollTabs>
    </div>
}

component ScrollTabsDemoPill() {
    state t = 2
    <div style="width: min(360px, 100%)">
        <ScrollTabs id="scroll-tabs-demo-pill" variant="pill" label="Topics" selected={t} on_change={(i) => { t = i }}
                    labels={["All", "Design", "Engineering", "Marketing", "Sales", "Support", "Legal", "Finance"]}>
            <p.demo-note>Topic {t + 1} of 8.</p>
        </ScrollTabs>
    </div>
}

view ScrollTabsDemo() =
    <div.demo-stack style="gap: 28px">
        <ScrollTabsDemoLive/>
        <ScrollTabsDemoPill/>
    </div>

ui_gallery = ui_gallery | push({ slug: "scroll_tabs", name: "ScrollTabs", group: "Navigation",
    summary: "A row of tabs that scrolls sideways when there are more than fit, with arrows at the ends and the keyboard.",
    tags: ["navigation", "tabs", "mobile", "interactive"], demo: ScrollTabsDemo })
