component TorchToggleDemoLive() {
    state lit = false
    state shown = true
    <div.demo-stack>
        {shown && <TorchToggle on_change={(on) => { lit = on }}/>}
        <p.demo-note id="torch-toggle-demo-note">{lit ? "on_change said: on" : "on_change said: off"}</p>
        <Button size="lg" variant="ghost" tone="neutral" on_click={() => { shown = !shown }}>{shown ? "Leave the page" : "Come back"}</Button>
    </div>
}

view TorchToggleDemo() =
    <div.demo-stack>
        <TorchToggleDemoLive/>
        <p.demo-note>Most Android phones allow it. iPhones and computers mostly do not, and it says so.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "torch_toggle", name: "TorchToggle", group: "Mobile",
    summary: "Turns the camera's light on through a track's constraints where the phone allows, says so where it does not, and turns off on leaving.",
    tags: ["mobile", "interactive", "camera", "torch", "flashlight"], demo: TorchToggleDemo })
