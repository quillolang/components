view KeyPointsDemo() =
    <div.demo-stack style="gap: 20px">
        <KeyPoints id="key-points-demo-quake" title="What we know" updated="Updated 14:20 GMT" datetime="2026-10-30T14:20:00Z" visible={3} tone="danger"
                   note="Written by our editors from the reporting below." points={[
            "A magnitude 6.1 earthquake struck at 06:12 local time, 40 km off the northern coast.",
            { text: "A tsunami warning is in force for the northern islands; people are told to move to higher ground.", href: "#warning" },
            "No deaths have been reported; 23 people were hurt, two seriously.",
            "Schools on the islands are closed today and ferries are not running.",
            { text: "Aftershocks of up to 4.8 have followed; more are expected this week.", href: "#aftershocks" },
        ]}/>
        <KeyPoints id="key-points-demo-budget" title="The budget in four lines" numbered={true} level={3} points={[
            "Income tax stays the same; the threshold rises with inflation.",
            "Fuel duty goes up by 2p a litre from April.",
            "Free school meals are extended to every primary school.",
            "Borrowing falls to 3.1% of national income.",
        ]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "key_points", name: "KeyPoints", group: "News",
    summary: "The story in a few lines at the top of an article: points with links, marks or numbers, when they were updated, and the rest folded under Show more.",
    tags: ["news", "list", "summary", "article", "no-js"], demo: KeyPointsDemo })
