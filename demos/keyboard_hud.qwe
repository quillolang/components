let keyboard_hud_demo_css = css`
.keyboard-hud-demo-btn { min-height: 44px; min-width: 44px; padding: 0 14px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius-sm); background: var(--ui-surface); color: var(--ui-fg); font: 500 14px var(--ui-font); }
`

component KeyboardHudDemoLive() {
    style global keyboard_hud_demo_css
    state ran = "Nothing yet."
    state found = "None reported."
    <div.demo-stack>
        <div.demo-tablet>
            <div style="display: grid; gap: 12px; padding: 16px; align-content: start; height: 100%; box-sizing: border-box; font: 15px var(--ui-font)">
                <div.demo-row>
                    <button.keyboard-hud-demo-btn id="kh-save" data-shortcut="Mod+S" data-shortcut-group="File" @click={() => { ran = "Saved." }}>Save</button>
                    <button.keyboard-hud-demo-btn id="kh-export" data-shortcut="s+mod" data-shortcut-label="Export" data-shortcut-group="File" @click={() => { ran = "Exported." }}>Share</button>
                    <button.keyboard-hud-demo-btn aria-keyshortcuts="Shift+Meta+F Control+F" aria-label="Find" data-shortcut-group="Edit" @click={() => { ran = "Find." }}>Find</button>
                    <button.keyboard-hud-demo-btn data-shortcut="Mod+Tab" data-shortcut-group="View" @click={() => { ran = "Switched." }}>Switch</button>
                    <button.keyboard-hud-demo-btn disabled="true" data-shortcut="Mod+P" data-shortcut-group="File">Print</button>
                    <button.keyboard-hud-demo-btn hidden="true" data-shortcut="Mod+J">Hidden</button>
                </div>
                <label>Notes <input id="kh-notes" style="height: 44px; font: 16px var(--ui-font); padding: 0 8px"/></label>
                <KeyboardHud shortcuts={[{ keys: "Mod+/", label: "Show help", group: "Help" }, { keys: "", label: "No keys" }, null]} on_conflict={(c) => { found = join(c | map((x) => `${x.kind} ${x.keys}: ${join(x.labels, "/")}`), "; ") }}/>
                <KeyboardHud trigger_label="With a bad scope" title="Bad scope" scope="[[" modifier="Alt"/>
                <p.demo-note>Hold Cmd on an attached keyboard (Ctrl elsewhere), or use the button.</p>
                <p.demo-note id="keyboard-hud-ran">{ran}</p>
                <p.demo-note id="keyboard-hud-found">{found}</p>
            </div>
        </div>
    </div>
}

view KeyboardHudDemo() = <KeyboardHudDemoLive/>

ui_gallery = ui_gallery | push({ slug: "keyboard_hud", name: "KeyboardHud", group: "Mobile",
    summary: "Hold a modifier on an attached keyboard to see the screen's shortcuts, found from data, conflicts reported, focus left alone.",
    tags: ["mobile", "tablet", "interactive", "keyboard", "shortcuts", "help"],
    demo: KeyboardHudDemo })
