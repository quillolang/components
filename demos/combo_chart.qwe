let combo_chart_demo_grid = "display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 32px 40px"

view ComboChartDemo() =
    <div.demo-stack>
        <ComboChart label="Revenue and margin" show_label={true} bar_prefix="$" line_suffix="%"
                    labels={["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug"]}
                    bars={[{ name: "Revenue", values: [42100, 45800, 51200, 49900, 56300, 61750, 58200, 64900] }]}
                    lines={[{ name: "Margin", values: [18.2, 19.5, 22.1, 20.4, 23.8, 26.1, 24.9, 27.3] }]}/>
        <div style={combo_chart_demo_grid}>
            <ComboChart label="Visits and conversion" show_label={true} line_suffix="%" line_zero={false} height={180}
                        bar_axis="Visits" line_axis="Conversion" decimals={1}
                        labels={["Mon", "Tue", "Wed", "Thu", "Fri"]}
                        bars={[{ name: "Desktop", values: [3200, 3540, 3310, 3620, 2980] },
                               { name: "Mobile", values: [4100, 4380, 4560, 4720, 5210] }]}
                        lines={[{ name: "Conversion", values: [2.4, 2.7, 2.5, null, 3.1] }]}/>
            <ComboChart label="Rainfall and temperature" show_label={true} bar_suffix=" mm" line_suffix="°" height={180}
                        labels={["Jan", "Feb", "Mar", "Apr", "May", "Jun"]}
                        bars={[{ name: "Rainfall", values: [78, 61, 55, 42, 38, 21] }]}
                        lines={[{ name: "High", values: [6, 8, 12, 16, 20, 24] }, { name: "Low", values: [-2, -1, 3, 6, 10, 14] }]}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "combo_chart", name: "ComboChart", group: "Charts",
    summary: "Bars on a left axis and lines on a right axis over the same labels, for two measures of different size, with every value on hover.",
    tags: ["chart", "data", "dashboard", "no-js"],
    demo: ComboChartDemo })
