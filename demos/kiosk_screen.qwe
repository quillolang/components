component KioskScreenDemoLive() {
    state step = 1
    state note = "Not started."
    state resets = 0
    <div.demo-stack>
        <div.demo-tablet>
            <KioskScreen title="Visitor check-in" intro="Set the tablet on its stand, then start." idle_seconds={4} warn_seconds={2} pin="1234" lock_seconds={2} tries={3}
                         on_start={() => { note = "Started." }}
                         on_reset={() => {
                             step = 1
                             resets += 1
                             note = `Reset ${resets}.`
                         }}
                         on_exit={() => { note = "Staff left." }}>
                <div style="display: grid; gap: 14px; padding: 28px; font: 17px var(--ui-font)">
                    <h2 id="kiosk-screen-step" style="margin: 0">Step {step} of 2</h2>
                    <form><label>Your name <input id="kiosk-screen-name" style="height: 48px; font: 17px var(--ui-font); padding: 0 8px"/></label></form>
                    <button id="kiosk-screen-next" style="min-height: 52px; font: 600 16px var(--ui-font)" @click={() => { step = 2 }}>Next</button>
                </div>
            </KioskScreen>
        </div>
        <p.demo-note id="kiosk-screen-note">{note}</p>
        <div id="kiosk-screen-odd" hidden="true"><KioskScreen title="Odd" idle_seconds={-3} warn_seconds={99} pin="" corner="middle"/><KioskScreen title="Odder" idle_seconds="soon" warn_seconds={null}/></div>
    </div>
}

view KioskScreenDemo() = <KioskScreenDemoLive/>

ui_gallery = ui_gallery | push({ slug: "kiosk_screen", name: "KioskScreen", group: "Mobile",
    summary: "A locked-down screen for a shared tablet: full screen, back to the start when idle, a hidden staff exit with a PIN.",
    tags: ["mobile", "tablet", "interactive", "kiosk", "fullscreen", "pin"],
    demo: KioskScreenDemo })
