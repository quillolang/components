view FormFieldDemo() =
    <div.demo-stack.demo-narrow>
        <FormField label="Username" field="form-field-demo-user" hint="Letters, digits and dashes." required={true}>
            <input id="form-field-demo-user" name="username" type="text" aria-describedby="form-field-demo-user-hint" required={true}/>
        </FormField>
        <FormField label="Country" field="form-field-demo-country" error="Choose a country." aside={<a href="#form_field">Why?</a>}>
            <select id="form-field-demo-country" name="country" aria-describedby="form-field-demo-country-error" aria-invalid="true">
                <option value="">Choose one</option>
                <option value="PT">Portugal</option>
                <option value="JP">Japan</option>
            </select>
        </FormField>
        <FormField label="Nickname" field="form-field-demo-nick" optional={true} inline={true} width="20ch">
            <input id="form-field-demo-nick" name="nickname" type="text"/>
        </FormField>
        <FormField label="Notes" field="form-field-demo-notes" inline={true} hint="Shown to the team only.">
            <textarea id="form-field-demo-notes" name="notes" aria-describedby="form-field-demo-notes-hint"></textarea>
        </FormField>
    </div>

ui_gallery = ui_gallery | push({ slug: "form_field", name: "FormField", group: "Forms",
    summary: "A label, a hint and an error around any control, with a required mark, the label beside or above it.",
    tags: ["forms", "input", "layout", "no-js"], demo: FormFieldDemo })
