let proration_calc_demo_plans = [
    { id: "basic", name: "Basic", price: "10.00", cycle: "monthly" },
    { id: "pro", name: "Pro", price: "30.00", cycle: "monthly" },
    { id: "team", name: "Team", price: "50.00", cycle: "monthly" },
    { id: "small", name: "Small", price: "1.35", cycle: "monthly" },
    { id: "yearly", name: "Pro yearly", price: "300.00", cycle: "annual" },
    { id: "max", name: "Max yearly", price: "600.00", cycle: "annual" },
    { id: "odd", name: "Broken", price: "soon", cycle: "monthly" }]

component ProrationCalcDemoLive() {
    state seen = null
    <div.demo-stack>
        <ProrationCalc id="proration-calc-demo-live" title="Downgrade, refunded" name="sub" plans={proration_calc_demo_plans} from="team" to="basic"
                       anchor="2024-02-10" change="2024-02-20" downgrade="refund" on_change={(f) => { seen = f }}/>
        <p.demo-note>{seen == null ? "Change a field to see on_change." : `on_change: net ${seen.net.amount}, ${seen.left} of ${seen.days} days left.`}</p>
    </div>
}

view ProrationCalcDemo() =
    <div.demo-stack>
        <ProrationCalc id="proration-calc-demo" plans={proration_calc_demo_plans} from="pro" to="team" anchor="2026-01-10" change="2026-01-23" today="2026-11-01"/>
        <ProrationCalcDemoLive/>
        <ProrationCalc id="proration-calc-demo-wait" title="Downgrade at renewal" plans={proration_calc_demo_plans} from="team" to="basic"
                       anchor="2026-01-10" today="2026-02-01" downgrade="renewal"/>
    </div>

ui_gallery = ui_gallery | push({ slug: "proration_calc", name: "ProrationCalc", group: "Commerce",
    summary: "Works out a mid-period change of plan by the day: credit for the time left, charge for the new plan and what is due, across month lengths, leap years and downgrades.",
    tags: ["smart", "interactive", "commerce", "billing", "subscription", "calculator"], demo: ProrationCalcDemo })
