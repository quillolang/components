component QuantityInputDemoLive() {
    state tickets = 2
    <div.demo-stack>
        <QuantityInput name="qi-demo-tickets" label="Tickets" value={tickets} least={1} most={8} unit="ticket"
                       on_change={(n) => { tickets = n }}/>
        <p.demo-note>{tickets} {tickets == 1 ? "ticket" : "tickets"}, ${tickets * 12} in all.</p>
    </div>
}

view QuantityInputDemo() {
    <div.demo-stack>
        <div.demo-row>
            <QuantityInput name="qi-demo-qty" value={1} least={0} most={10} hint="Up to 10 per order."/>
            <QuantityInputDemoLive/>
        </div>
        <div.demo-row>
            <QuantityInput name="qi-demo-pack" label="Packs of 6" size="sm" value={6} step={6} least={6} most={48}/>
            <QuantityInput name="qi-demo-lg" label="Guests" size="lg" value={4}/>
            <QuantityInput name="qi-demo-off" label="Sold out" value={0} disabled={true}/>
        </div>
    </div>
}

ui_gallery = ui_gallery | push({ slug: "quantity_input", name: "QuantityInput", group: "Forms",
    summary: "A compact count with − and + either side, kept to its limits and step, with the arrow keys, PageUp/PageDown, Home and End.",
    tags: ["forms", "input", "cart", "commerce", "interactive"], demo: QuantityInputDemo })
