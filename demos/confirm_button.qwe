component ConfirmButtonDemoLive() {
    state archived = false
    <div.demo-row>
        <ConfirmButton message="Archive this project? You can bring it back later." tone="accent" variant="soft"
                       ok="Archive" on_confirm={() => { archived = true }}>Archive</ConfirmButton>
        <span.demo-note>{archived ? "Archived." : "Not archived."}</span>
    </div>
}

view ConfirmButtonDemo() =
    <div.demo-stack>
        <form.demo-row method="get" action="#confirm_button">
            <ConfirmButton title="Delete project?" message="This deletes the project and all its files. It cannot be undone."
                           ok="Delete" name="deleted" value="yes">Delete project</ConfirmButton>
            <span.demo-note>Submits its form on yes (here, reloading this page).</span>
        </form>
        <div.demo-row>
            <ConfirmButton href="#confirm_button" message="Leave this page?" tone="neutral" variant="outline" ok="Leave">
                A link
            </ConfirmButton>
        </div>
        <ConfirmButtonDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "confirm_button", name: "ConfirmButton", group: "Overlays",
    summary: "A button that asks first, in a dialog on the page, then submits its form, follows its link or calls back.",
    demo: ConfirmButtonDemo })
