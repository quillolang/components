component ReplyBoxDemoLive() {
    state posted = []
    state cancelled = 0
    <div.demo-stack>
        <ReplyBox id="reply-box-demo-live" you="Ana Silva" on_post={(t) => { posted = posted | push(t) }}
                  on_cancel={() => { cancelled += 1 }}/>
        <p.demo-note>{len(posted) == 0 ? "Nothing posted yet." : `Posted: ${join(posted, " · ")}.`}{cancelled > 0 ? ` Cancelled ${cancelled}.` : ""}</p>
    </div>
}

view ReplyBoxDemo() =
    <div.demo-stack>
        <ReplyBoxDemoLive/>
        <p.demo-note>Click in the box: it grows and shows the buttons. Ctrl+Enter posts, Escape cancels. Below, one that posts a form:</p>
        <ReplyBox id="reply-box-demo-form" name="text" method="get" action="#reply_box" you="Ben Okafor"
                  avatar="https://i.pravatar.cc/80?img=15" placeholder="Reply to Ana…">
            <input type="hidden" name="post" value="42"/>
        </ReplyBox>
    </div>

ui_gallery = ui_gallery | push({ slug: "reply_box", name: "ReplyBox", group: "Social",
    summary: "A reply box that is one line until focused, then grows and shows Post and Cancel; it posts a form or calls back.",
    tags: ["social", "comment", "forms", "input", "interactive"], demo: ReplyBoxDemo })
