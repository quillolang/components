view InlineCodeDemo() =
    <div.demo-stack>
        <p.demo-note style="color: var(--ui-fg); font-size: 15px">
            Run <InlineCode id="inline-code-demo-run">quillo run app.qwe --watch</InlineCode> in the folder, then open
            <InlineCode tone="accent">http://localhost:8080</InlineCode>. The config is read from
            <InlineCode>quillo.toml</InlineCode>.
        </p>
        <p.demo-note style="color: var(--ui-fg); font-size: 15px">
            Your API key is <InlineCodeCopy code="qk_live_4f9a0c12e7b3" id="inline-code-demo-copy"/>, and the
            webhook secret <InlineCodeCopy code="whsec_9d8e7f" label="Copy the webhook secret"/>.
        </p>
    </div>

ui_gallery = ui_gallery | push({ slug: "inline_code", name: "InlineCode", group: "Typography",
    summary: "A code span in running text, and a variant that copies its text when clicked.",
    tags: ["typography", "code", "text", "interactive"],
    demo: InlineCodeDemo })
