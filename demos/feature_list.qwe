let feature_list_demo_shot = (a: str, b: str) =>
    `data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 400 240'%3E%3Crect width='400' height='240' rx='12' fill='${a}'/%3E%3Crect x='30' y='30' width='340' height='28' rx='6' fill='${b}'/%3E%3Crect x='30' y='78' width='220' height='16' rx='4' fill='${b}'/%3E%3Crect x='30' y='106' width='300' height='16' rx='4' fill='${b}'/%3E%3Crect x='30' y='150' width='340' height='60' rx='8' fill='${b}'/%3E%3C/svg%3E`

view FeatureListDemo() =
    <div.demo-stack>
        <FeatureList id="feature-list-demo" features={[
            { eyebrow: "Write", title: "The page is the program", text: "A route returns HTML; a view is a function that makes some. There is no template language to learn beside the one you write.",
              image: feature_list_demo_shot("%23ecebfd", "%23b9a8ff"), image_alt: "A page sketched as grey blocks",
              points: ["JSX-like markup, escaped by default", "Views compose like tags", "Styles scoped to the component"],
              href: "#feature_list", link: "About views" },
            { eyebrow: "Watch", title: "The page follows the data", text: "A live query keeps the page current as rows change, over one connection, with nothing to wire up.",
              image: feature_list_demo_shot("%23e3f5ec", "%234cc38a"), image_alt: "A list sketched as green blocks",
              points: ["Live queries", "Streams and channels"] },
            { eyebrow: "Ship", title: "One binary, one file", text: "Copy them to a server and run. It serves, watches, reloads and logs.",
              side: <CodeBlock code="scp app.qwe box:~ && ssh box quillo run app.qwe --port 80" language="sh"/> },
        ]}/>
        <p.demo-note>Words first, then the picture; the next row the other way round. On a phone each row stacks.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "feature_list", name: "FeatureList", group: "Marketing",
    summary: "Features in alternating rows of words and a picture (or code), with ticked points and a link each.",
    tags: ["marketing", "section", "list", "image", "no-js"],
    demo: FeatureListDemo })
