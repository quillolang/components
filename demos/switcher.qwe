view SwitcherDemoCell(label: str) =
    <div style="padding: 18px 12px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius-sm); background: var(--ui-subtle); text-align: center; font-size: 13px">{label}</div>

view SwitcherDemo() =
    <div.demo-stack>
        <Switcher id="switcher-demo-three">
            <SwitcherDemoCell label="Starter"/><SwitcherDemoCell label="Team"/><SwitcherDemoCell label="Business"/>
        </Switcher>
        <p.demo-note>The same three in a 400px-wide box, under the 640px threshold: each on a line of its own.</p>
        <div style="width: 400px; max-width: 100%">
            <Switcher id="switcher-demo-narrow">
                <SwitcherDemoCell label="Starter"/><SwitcherDemoCell label="Team"/><SwitcherDemoCell label="Business"/>
            </Switcher>
        </div>
        <p.demo-note>Five with limit={4}: too many for a row, so they stack whatever the width.</p>
        <Switcher id="switcher-demo-many" limit={4} gap="sm">
            {for i in range(1, 6) => <SwitcherDemoCell label={`Item ${i}`}/>}
        </Switcher>
    </div>

ui_gallery = ui_gallery | push({ slug: "switcher", name: "Switcher", group: "Layout",
    summary: "Children side by side until the row would be too narrow, then each on its own line, with no in-between.",
    tags: ["layout", "grid", "no-js"], demo: SwitcherDemo })
