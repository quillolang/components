let swipe_toast_demo_css = css`
.swipe-toast-demo-page { display: flex; flex-direction: column; gap: 12px; box-sizing: border-box; height: 100%; padding: 20px 20px 72px; }
.swipe-toast-demo-tabs { position: absolute; inset: auto 0 0 0; display: flex; align-items: center; justify-content: space-around; height: 56px; border-top: 1px solid var(--ui-border); background: var(--ui-surface); color: var(--ui-muted); font: 12px var(--ui-font); }
`

component SwipeToastDemoLive() {
    style global swipe_toast_demo_css
    state notes = []
    state next = 1
    state kept = 0
    state undone = 0
    state dropped = 0
    let add = (text: str, undo: str?) => {
        notes = notes + [{ id: `toast-${next}`, text: text, undo: undo, seconds: 3 }]
        next = next + 1
    }
    <div.demo-stack>
        <div.demo-phone>
            <div class="swipe-toast-demo-page">
                <Button size="lg" on_click={() => { add(`Email ${next} deleted`, "Undo") }}>Delete an email</Button>
                <Button size="lg" variant="outline" on_click={() => { add("Draft saved", null) }}>Save a draft</Button>
                <Button size="lg" variant="soft" on_click={() => {
                    notes = notes + [{ id: `toast-${next}`, text: "No connection. Will try again.", tone: "danger", seconds: 0 }]
                    next = next + 1
                }}>Lose the connection</Button>
                <p.demo-note>Undone: <span class="swipe-toast-demo-undone">{undone}</span>. Dismissed: <span class="swipe-toast-demo-dropped">{dropped}</span>.</p>
            </div>
            <div class="swipe-toast-demo-tabs" aria-hidden="true"><span>Inbox</span><span>Sent</span><span>Settings</span></div>
            <SwipeToast toasts={notes} on_undo={(_t) => { undone += 1 }} on_dismiss={(_t) => { dropped += 1 }}/>
        </div>
    </div>
}

view SwipeToastDemo() = <SwipeToastDemoLive/>

ui_gallery = ui_gallery | push({ slug: "swipe_toast", name: "SwipeToast", group: "Mobile",
    summary: "A toast sent away by a sideways swipe, with Undo, stacked and timed, standing above the tab bar and the on-screen keyboard.",
    tags: ["mobile", "interactive", "toast", "undo", "gesture"],
    needs: ["bottom_sheet"], demo: SwipeToastDemo })
