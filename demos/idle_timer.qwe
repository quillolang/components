component IdleTimerDemoLive() {
    state log = []
    <div.demo-stack>
        <IdleTimer seconds={8} warn={4} title="Still reading?" message="This demo signs you out in {s} seconds." button="I'm here"
                   on_warn={() => { log = push(log, "warned") }}
                   on_active={() => { log = push(log, "back") }}
                   on_idle={() => { log = push(log, "idle") }}/>
        <p.demo-note>Hold still for 4 seconds: a warning appears at the bottom right; 4 more and it says you went idle. Events: {len(log) == 0 ? "none yet" : join(log, ", ")}.</p>
    </div>
}

view IdleTimerDemo() =
    <div.demo-stack>
        <IdleTimerDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "idle_timer", name: "IdleTimer", group: "Utilities",
    summary: "Calls on_idle() after a time without mouse, key, touch or scroll, with a warning dialog and a Stay button first.",
    tags: ["utility", "time", "security", "dialog", "interactive"],
    demo: IdleTimerDemo })
