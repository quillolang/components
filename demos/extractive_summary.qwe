let extractive_summary_demo_text = "The city council approved the new bicycle lanes on Tuesday. Crews will paint bicycle lanes along Main Street this spring. The mayor wore a blue tie to the meeting. Cyclists have asked the council for safer lanes since 2019. Shop owners worry the lanes will remove parking. The council said parking will move to side streets. Rain is expected later this week."

component ExtractiveSummaryDemoLive() {
    state kept = null
    <div.demo-stack>
        <ExtractiveSummary id="extractive-summary-demo-live" label="Your article" name="article" keep_name="article_keep" rows={3} keep={1}
                           value="Tea cools fast in a wide cup. Tea stays hot in a narrow cup. Cats sleep all day." on_change={(r) => { kept = r.summary }}/>
        <p.demo-note>{kept == null ? "Move the slider to see on_change." : `on_change: ${kept}`}</p>
    </div>
}

view ExtractiveSummaryDemo() =
    <div.demo-stack>
        <ExtractiveSummary id="extractive-summary-demo" value={extractive_summary_demo_text} name="body" keep={2}/>
        <ExtractiveSummaryDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "extractive_summary", name: "ExtractiveSummary", group: "News",
    summary: "Keeps a text's best sentences, scored by word frequency and position, in their order, with a length slider and the chosen ones marked. No AI service.",
    tags: ["smart", "interactive", "summary", "news", "text", "tldr"], needs: ["readability_meter", "copy_button"], demo: ExtractiveSummaryDemo })
