let sprint_planner_demo_items = [
    { id: "A", title: "Sign in", points: 5, priority: 1 },
    { id: "B", title: "Billing", points: 8, priority: 1, deps: ["D"] },
    { id: "C", title: "Dashboard", points: 13, priority: 2, deps: ["A"] },
    { id: "D", title: "Plans table", points: 2.5, priority: "low" },
    { id: "E", title: "Audit log", points: 3, priority: 3 },
    { id: "F", title: "Export", points: 1, priority: "low", deps: ["Z"] },
    { id: "G", title: "Invites", points: 2, priority: 2, deps: ["H"] },
    { id: "H", title: "Teams", points: 2, priority: 2, deps: ["G"] },
    { id: "I", title: "Webhooks", points: 1, deps: ["H"] }]

component SprintPlannerDemoLive() {
    state plan = null
    <div.demo-stack>
        <SprintPlanner id="sprint-planner-demo" days={10} rate={0.8} items={sprint_planner_demo_items}
                       team={[{ name: "Ana", days_off: 2 }, { name: "Ben" }, { name: "Cara", days_off: 8 }]}
                       on_change={(p) => { plan = p }}/>
        <p.demo-note>{plan == null ? "Move an item to see on_change." : `on_change: ${plan.used} of ${plan.capacity} points, ${join(plan.planned, " ")}.`}</p>
    </div>
}

view SprintPlannerDemo() =
    <div.demo-stack>
        <SprintPlannerDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "sprint_planner", name: "SprintPlanner", group: "Scheduling",
    summary: "Works out team capacity from days off, fits the backlog by priority keeping dependencies, says why the rest did not fit, and tracks capacity as items move by hand.",
    tags: ["smart", "interactive", "agile", "capacity", "backlog", "planning"], demo: SprintPlannerDemo })
