component DateRangePickerDemoLive() {
    state picked = "Nothing chosen yet."
    <div.demo-stack>
        <DateRangePicker name="drp-demo-report" label="Report period"
                         on_change={(a, b) => { picked = a == null ? "Cleared." : `The form sends ${a} to ${b}.` }}/>
        <p.demo-note>{picked}</p>
    </div>
}

view DateRangePickerDemo() =
    <div.demo-stack>
        <DateRangePicker name="drp-demo-stay" label="Your stay" start="2026-12-20" end="2026-12-27"
                         min="2026-11-01" max="2027-03-31" presets={[]}
                         hint="Pick the day you arrive, then the day you leave."/>
        <DateRangePickerDemoLive/>
        <DateRangePicker name="drp-demo-q" names={["period[start]", "period[end]"]} label="Quarter" size="sm"
                         week_start={0} error="Choose a whole quarter."
                         presets={[{ label: "Q3 2026", start: "2026-07-01", end: "2026-09-30" },
                                   { label: "Q4 2026", start: "2026-10-01", end: "2026-12-31" }]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "date_range_picker", name: "DateRangePicker", group: "Forms",
    summary: "A first and last day picked on two months (with a preview as you go) or from presets such as Last 7 days.",
    demo: DateRangePickerDemo })
