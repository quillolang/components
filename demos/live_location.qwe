// A short walk across Rizal Park in Manila, ten seconds a fix, as a saved one would be.
let live_location_demo_walk = [
    { lat: 14.58320, lon: 120.97950, accuracy: 8, at: 1700000000000 },
    { lat: 14.58340, lon: 120.97960, accuracy: 8, at: 1700000010000 },
    { lat: 14.58360, lon: 120.97975, accuracy: 6, at: 1700000020000 },
    { lat: 14.58385, lon: 120.97990, accuracy: 6, at: 1700000030000 },
    { lat: 14.58400, lon: 120.98015, accuracy: 5, at: 1700000040000 },
    { lat: 14.58410, lon: 120.98040, accuracy: 7, at: 1700000050000 }
]

component LiveLocationDemoLive() {
    state seen = "Nothing yet."
    state stopped = "Not stopped."
    state second = false
    <div.demo-stack>
        <LiveLocation track={live_location_demo_walk} gap={1}
            on_update={(s) => { seen = `${s.fixes} fixes, ${s.dropped} left out, ${round(s.distance)} m.` }}
            on_stop={(s) => { stopped = `Stopped at ${round(s.distance)} m.` }}/>
        <p.demo-note id="live-location-demo-note">{seen} {stopped}</p>
        {second && <LiveLocation start={true} units="mi" gap={1}/>}
        <Button size="lg" variant="ghost" id="live-location-demo-second" on_click={() => { second = !second }}>{second ? "Remove the second" : "Add one that starts by itself"}</Button>
    </div>
}

view LiveLocationDemo() = <LiveLocationDemoLive/>

ui_gallery = ui_gallery | push({ slug: "live_location", name: "LiveLocation", group: "Mobile",
    summary: "Follows a position over time with a smoothed path, distance, speed and accuracy, and stops on leaving the screen.",
    tags: ["mobile", "interactive", "location", "gps", "tracking"],
    needs: ["button"],
    demo: LiveLocationDemo })
