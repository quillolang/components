component EmojiPickerDemoLive() {
    state status = "🌴"
    <div.demo-stack>
        <EmojiPicker id="emoji-picker-demo-live" label="Status" value={status} on_change={(e) => { status = e }}/>
        <p.demo-note>Your status: {status}</p>
    </div>
}

view EmojiPickerDemo() =
    <div.demo-stack>
        <EmojiPicker id="emoji-picker-demo-all" name="emoji" label="Reaction" hint="Search by name: party, coffee, heart."/>
        <EmojiPickerDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "emoji_picker", name: "EmojiPicker", group: "Forms",
    summary: "Pick an emoji from tabs of categories or by searching their names; each is named for screen readers and a form gets the one picked.",
    tags: ["forms", "picker", "search", "social", "interactive"], demo: EmojiPickerDemo })
