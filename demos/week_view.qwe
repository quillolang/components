let week_view_demo_events = [
    { id: 1, title: "Stand-up", start: "2026-11-02T09:00", end: "2026-11-02T09:15" },
    { id: 2, title: "Design review", start: "2026-11-03T14:00", end: "2026-11-03T15:30", place: "Room 2", href: "#week_view" },
    { id: 3, title: "Lunch with Ana", start: "2026-11-03T12:30", end: "2026-11-03T13:30", tone: "success" },
    { id: 4, title: "1:1 Ben", start: "2026-11-04T10:00", end: "2026-11-04T10:30", tone: "info" },
    { id: 5, title: "Planning", start: "2026-11-04T10:00", end: "2026-11-04T11:30", tone: "warning" },
    { id: 6, title: "Dentist", start: "2026-11-04T11:00", end: "2026-11-04T12:00", tone: "danger", place: "Rua Augusta 10" },
    { id: 7, title: "Release", start: "2026-11-06T16:00", end: "2026-11-06T19:00", tone: "accent" },
    { id: 8, title: "Offsite", day: "2026-11-05" },
    { id: 9, title: "Ana out", day: "2026-11-05", tone: "neutral" },
]

component WeekViewDemoLive() {
    state opened = null
    <div.demo-stack>
        <WeekView start="2026-11-02" today="2026-11-04" now="2026-11-04T14:20" events={week_view_demo_events}
                  on_open={(id) => { opened = id }}/>
        <p.demo-note>{opened == null ? "Press an event." : `Opened event ${opened}.`}</p>
    </div>
}

view WeekViewDemo() =
    <div.demo-stack>
        <WeekViewDemoLive/>
        <div id="week-view-demo-short">
            <WeekView start="2026-11-04" days={3} from_hour={9} to_hour={13} hour_height={40} label="Three days"
                      events={week_view_demo_events | filter((e) => e.id == 4 || e.id == 7 || e.id == 8)}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "week_view", name: "WeekView", group: "Scheduling",
    summary: "A week of hour columns with events drawn at their times, side by side when they overlap, and all-day events across the top.",
    tags: ["schedule", "calendar", "time", "data", "no-js"], demo: WeekViewDemo })
