let in_app_banner_demo_msgs = [
    { app: "Messages", title: "Ana Ruiz", body: "Are we still on for lunch at one?", time: "now" },
    { app: "Calendar", title: "Team review", body: "Starts in 15 minutes in room 4", time: "now" },
    { app: "Deliveries", title: "Parcel arriving", body: "Your parcel is 3 stops away", time: "2 min ago" },
    { app: "Bank", title: "Card payment", body: "Paid 12.40 at Harbour Coffee", time: "now" }]

component InAppBannerDemoLive() {
    state notes = []
    state next = 0
    state opened = "none"
    state dismissed = 0
    let send = (count: int) => {
        let more = range(count) | map((i) => {
            let m = in_app_banner_demo_msgs[(next + i) % len(in_app_banner_demo_msgs)]
            set(m, "id", `note-${next + i}`)
        })
        next = next + count
        notes = notes + more
    }
    <div.demo-stack>
        <div.demo-phone>
            <InAppBanner notes={notes} seconds={3} on_open={(n) => { opened = n.title }} on_dismiss={(_n) => { dismissed += 1 }}/>
            <div class="in-app-banner-demo-page">
                <div.demo-stack>
                    <Button size="lg" on_click={() => { send(1) }}>One banner</Button>
                    <Button size="lg" variant="outline" on_click={() => { send(3) }}>Three at once</Button>
                    <p.demo-note>Opened: <span class="in-app-banner-demo-opened">{opened}</span>. Dismissed: <span class="in-app-banner-demo-dismissed">{dismissed}</span>.</p>
                </div>
            </div>
        </div>
    </div>
}

let in_app_banner_demo_css = css`
.in-app-banner-demo-page { display: flex; align-items: flex-end; box-sizing: border-box; height: 100%; padding: 20px; }
.in-app-banner-demo-page .demo-stack { width: 100%; }
`

view InAppBannerDemo() =
    <div>
        <style>{in_app_banner_demo_css}</style>
        <InAppBannerDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "in_app_banner", name: "InAppBanner", group: "Mobile",
    summary: "A notification-style banner sliding from the top: tap to open, swipe up to dismiss, a queue for several, held while touched.",
    tags: ["mobile", "interactive", "notification", "banner", "gesture"],
    needs: ["bottom_sheet"], demo: InAppBannerDemo })
