let footer_demo_columns = [
    { title: "Product", links: [{ label: "Pricing", href: "#" }, { label: "Changelog", href: "#" }, { label: "Roadmap", href: "#" }] },
    { title: "Company", links: [{ label: "About", href: "#" }, { label: "Jobs", href: "#" }, { label: "Press", href: "#" }] },
    { title: "Help", links: [{ label: "Docs", href: "#" }, { label: "Status", href: "#" }, { label: "Contact", href: "#" }] }
]

view FooterDemo() =
    <div.demo-stack>
        <Footer id="footer-demo-site" brand="Acme" brand_href="#footer" tagline="Tools for small teams who ship often."
                columns={footer_demo_columns} bottom="© 2026 Acme Ltd. All rights reserved." tone="subtle"
                links={[{ label: "Privacy", href: "#" }, { label: "Terms", href: "#" }, { label: "Cookies", href: "#" }]}>
            <a href="#" aria-label="Acme on GitHub" style="color: var(--ui-muted)">GitHub</a>
            <a href="#" aria-label="Acme on Mastodon" style="color: var(--ui-muted)">Mastodon</a>
        </Footer>
        <p.demo-note>Below, in a 400px-wide box, the columns wrap and the social links take a line of their own.</p>
        <div style="width: 400px; max-width: 100%">
            <Footer id="footer-demo-narrow" brand="Acme" columns={footer_demo_columns} bottom="© 2026 Acme Ltd.">
                <a href="#" style="color: var(--ui-muted)">GitHub</a>
            </Footer>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "footer", name: "Footer", group: "Layout",
    summary: "A site's footer: brand and tagline, columns of links under titles, and a bottom line with the small print.",
    tags: ["layout", "page", "navigation", "link", "no-js"], demo: FooterDemo })
