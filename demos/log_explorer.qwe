component LogExplorerDemoLive() {
    state seen = null
    <div.demo-stack>
        <LogExplorer id="log-explorer-demo-live" title="Plain lines, with on_change" text={`starting up\nlistening on 8080\nerror: disk full\n  while writing /var/data\n`} query="error"
                     on_change={(r) => { seen = r }}/>
        <p.demo-note>{seen == null ? "Change the search to see on_change." : `on_change: ${seen.matched} of ${seen.total} for "${seen.query}".`}</p>
    </div>
}

view LogExplorerDemo() =
    <div.demo-stack>
        <LogExplorer id="log-explorer-demo" text={log_explorer_demo_text}/>
        <LogExplorerDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "log_explorer", name: "LogExplorer", group: "Data",
    summary: "Reads raw logs in logfmt, JSON lines or plain text, keeps traces together, and searches them like level:error status:5xx \"timeout\".",
    tags: ["smart", "interactive", "logs", "search", "monitoring", "developer"], demo: LogExplorerDemo })
