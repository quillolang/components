{"timestamp":1793351653,"severity":"WARNING","message":"retrying payment","attempt":2,"host":"web-2"}
{"time":"2026-10-30T09:14:14Z","level":50,"msg":"Timeout talking to Redis","status":503,"host":"web-1"}
