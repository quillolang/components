component SlideToConfirmDemoLive() {
    state paid = false
    state count = 0
    <div.demo-stack style="max-width: 640px">
        <SlideToConfirm label="Slide to pay $120.00" done_label="Paid" hold_label="Hold to pay" hold_ms={900} done={paid}
                        on_confirm={() => { paid = true; count += 1 }}/>
        <p.demo-note id="slide-confirm-count">Confirmed {count} times.</p>
        <button id="slide-confirm-again" style="min-height: 46px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius-sm); background: var(--ui-surface); color: var(--ui-fg); font: 500 15px var(--ui-font)" type="button" @click={() => { paid = false }}>Ask again</button>
        <SlideToConfirm label="Slide to delete the account" tone="danger" disabled={true}/>
    </div>
}

view SlideToConfirmDemo() = <SlideToConfirmDemoLive/>

ui_gallery = ui_gallery | push({ slug: "slide_to_confirm", name: "SlideToConfirm", group: "Mobile",
    summary: "Drag a thumb across to confirm something serious, with keys, and a hold for screen readers.",
    tags: ["mobile", "interactive", "gesture", "confirm", "slider"],
    demo: SlideToConfirmDemo })
