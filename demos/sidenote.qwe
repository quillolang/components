view SidenoteDemoText() = [
    <p>Quillo pages are rendered on the server<Sidenote n={1} id="sidenote-demo-">Every route, every time: nothing is prerendered, and
        a cached view is the exception you ask for.</Sidenote> and then resumed in the browser, which takes the server's elements as its
        own instead of drawing them again. A component's state travels with it, as JSON, in an attribute of its island.</p>,
    <p>That is why an image does not load twice and a scrolled list stays where it was<Sidenote n={2} id="sidenote-demo-">The browser
        checks that the elements are the same; one that differs is made again, for that component only.
        See <a href="#sidenote">the guide</a>.</Sidenote>. What someone typed before the bundle came is kept, and done once it is there.
        Islands are woken when they are reached<Sidenote id="sidenote-demo-margin">Pointed at, touched, focused, or a key pressed in them.</Sidenote>,
        which keeps a long page light.</p>,
]

view SidenoteDemo() =
    <div.demo-stack style="gap: 28px">
        <SidenoteText id="sidenote-demo-wide" width={210}><SidenoteDemoText/></SidenoteText>
        <div style="max-width: 420px; padding: 14px; border: 1px dashed var(--ui-border); border-radius: 8px">
            <SidenoteText id="sidenote-demo-narrow">
                <p>On a phone the notes fold<Sidenote n={1} id="sidenote-demo-n">Press the number to open one under its line, and again to close it.</Sidenote>
                    and their numbers open them.</p>
            </SidenoteText>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "sidenote", name: "Sidenote", group: "Blogging",
    summary: "Notes in the margin beside the line they belong to, numbered or not; on a narrow page they fold, and the number opens each under its line.",
    tags: ["blogging", "typography", "article", "notes", "no-js"], demo: SidenoteDemo })
