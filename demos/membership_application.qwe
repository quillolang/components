component MembershipApplicationDemoLive() {
    state step = 0
    <div.demo-stack>
        <MembershipApplication id="membership-application-demo" action="#membership-application" coop="Bayanihan Multi-Purpose Cooperative"
                               currency="PHP" par={100} min_shares={50} initial_percent={25} hidden={{ branch: "poblacion" }}
                               on_step={(i) => { step = i }}/>
        <p.demo-note>on_step: {step}</p>
    </div>
}

view MembershipApplicationDemo() = <MembershipApplicationDemoLive/>

ui_gallery = ui_gallery | push({ slug: "membership_application", name: "MembershipApplication", group: "Finance",
    summary: "A co-op membership application in steps: personal details, ID, beneficiaries adding up to 100%, the share pledge, and a review.",
    tags: ["finance", "coop", "forms", "wizard", "interactive"], demo: MembershipApplicationDemo })
