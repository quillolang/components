component NotifyPromptDemoLive() {
    state seen = "Nothing yet."
    state kept = null       // stands for the app's own database, which outlasts a launch
    <div.demo-stack>
        <NotifyPrompt store="ui-notify-prompt-demo" saved={kept} on_save={(t) => { kept = t }} why="We'll tell you when your parcel is at the door, and nothing else."
                      reasons={["Delivery on the day", "Changes to an order", "A driver at the door", "Nothing for marketing"]}
                      again_days={7} on_result={(r) => { seen = r }}/>
        <p.demo-note id="notify-prompt-demo-note">on_result: {seen}</p>
        <p.demo-note id="notify-prompt-demo-kept">To keep in the app's database: {kept ?? "nothing"}</p>
        <Button size="lg" variant="ghost" id="notify-prompt-demo-forget" on_click={() => { kept = null }}>Forget it</Button>
    </div>
}

view NotifyPromptDemo() = <NotifyPromptDemoLive/>

ui_gallery = ui_gallery | push({ slug: "notify_prompt", name: "NotifyPrompt", group: "Mobile",
    summary: "Explains why, then asks for notifications, handles refused and never-asked, and shows a way to Settings.",
    tags: ["mobile", "interactive", "notifications", "permission"],
    needs: ["button"],
    demo: NotifyPromptDemo })
