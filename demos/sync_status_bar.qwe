// The time on the page is fixed here, as a page's would be from the server.
let sync_status_bar_demo_now = 1793534400000

component SyncStatusBarDemoLive() {
    state status = "saved"
    state pending = 0
    state tries = 0
    state fix = false
    // A pretend sync, a moment long. Named, as js_new is not waited for in a function written
    // in the markup's prop.
    let try_it = () => {
        tries += 1
        let pause = js("Promise.resolve", js_new("Promise", (done) => { js("AbortSignal.timeout", 600).addEventListener("abort", (_e) => { done(true) }) }))
        if pause && fix {
            status = "saved"
            return true
        }
        false
    }
    <div.demo-stack>
        <SyncStatusBar id="syncbar-demo" status={status} last_synced={sync_status_bar_demo_now - 180000} now={sync_status_bar_demo_now} pending={pending}
                       error="The server did not answer." on_retry={try_it}/>
        <div.demo-row>
            <Button size="lg" variant="outline" id="syncbar-saved" on_click={() => { status = "saved" }}>Saved</Button>
            <Button size="lg" variant="outline" id="syncbar-syncing" on_click={() => { status = "syncing" }}>Syncing</Button>
            <Button size="lg" variant="outline" id="syncbar-failed" on_click={() => { status = "failed" }}>Failed</Button>
            <Button size="lg" variant="outline" id="syncbar-pending" on_click={() => { pending += 1 }}>One more change</Button>
            <Button size="lg" variant="outline" id="syncbar-fix" on_click={() => { fix = true }}>Mend the server</Button>
        </div>
        <p.demo-note id="syncbar-tries">{`Retries asked for: ${tries}.`}</p>
    </div>
}

view SyncStatusBarDemo() =
    <div.demo-stack>
        <SyncStatusBarDemoLive/>
        <SyncStatusBar id="syncbar-iso" last_synced="2026-11-01T08:30:00Z" now="2026-11-01T10:30:00Z" follow_network={false}/>
        <SyncStatusBar id="syncbar-never" now={sync_status_bar_demo_now} follow_network={false}/>
        <SyncStatusBar id="syncbar-ahead" last_synced={sync_status_bar_demo_now + 90000} now={sync_status_bar_demo_now} follow_network={false}/>
        <SyncStatusBar id="syncbar-bad" last_synced="soon" now={sync_status_bar_demo_now} follow_network={false}/>
        <SyncStatusBar id="syncbar-stale" last_synced={sync_status_bar_demo_now - 7200000} now={sync_status_bar_demo_now} stale_minutes={60} follow_network={false}/>
        <SyncStatusBar id="syncbar-words" status="syncing" pending={1} words={{ syncing: "Sending" }} now={sync_status_bar_demo_now} follow_network={false}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "sync_status_bar", name: "SyncStatusBar", group: "Mobile",
    summary: "Saved, syncing, offline or failed, with last-synced as relative time from a prop, and a retry.",
    tags: ["mobile", "interactive", "offline", "sync", "status", "tablet"],
    demo: SyncStatusBarDemo })
