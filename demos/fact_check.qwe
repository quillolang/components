view FactCheckDemo() =
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 16px; align-items: start">
        <FactCheck id="fact-check-demo-crime" claim="Crime in this city has doubled since 2020." claimant="Dana Reyes"
                   claimant_role="Mayor of Riverside" context="in a radio interview" claim_date="2026-10-21" rating="Mostly false"
                   author="Ada Lovelace" published="2026-10-24" href="#fact-check-crime"
                   sources={[{ label: "Riverside Police annual report, 2025", href: "#police-report" },
                             { label: "State crime statistics, 2020–2025", href: "#state-stats" },
                             { label: "Interview with the police commissioner, Oct. 23" }]}>
            <p>Reported crime rose 14% from 2020 to 2025, not 100%. Property crime drove the rise; violent crime fell by a fifth.</p>
        </FactCheck>
        <FactCheck id="fact-check-demo-true" claim="Unemployment is at its lowest since 2001." claimant="Finance minister" rating="true">
            The statistics office puts it at 4.1%, the lowest since the 3.9% of March 2001.
        </FactCheck>
        <FactCheck id="fact-check-demo-off" claim="The new bridge was built without a single steel beam from abroad." rating="Misleading"
                   scale={["Correct", "Misleading", "False"]} heading="Verified"/>
    </div>

ui_gallery = ui_gallery | push({ slug: "fact_check", name: "FactCheck", group: "News",
    summary: "A fact-check: the claim and who said it, the rating large and on its scale from true to false, what was found, the sources, with ClaimReview markup.",
    tags: ["news", "card", "rating", "article", "no-js"], demo: FactCheckDemo })
