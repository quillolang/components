component PhotoCaptureDemoLive() {
    state got = null
    <form.demo-stack method="post" action="/" enctype="multipart/form-data">
        <PhotoCapture name="receipt" label="Photograph the receipt" max_side={200} hint="Made smaller on this phone before it goes."
                      on_change={(p) => { got = p }}/>
        <p.demo-note id="photo-capture-demo-note">{got == null ? "Nothing taken yet." : `Ready to send: ${got.name}, ${got.width} by ${got.height}, from ${got.from_width} by ${got.from_height}.`}</p>
    </form>
}

view PhotoCaptureDemo() =
    <div.demo-stack>
        <PhotoCaptureDemoLive/>
        <p.demo-note>On a phone the button opens the camera; on a computer, a file. A photo held sideways comes out upright.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "photo_capture", name: "PhotoCapture", group: "Mobile",
    summary: "Takes a photo through the phone's camera, with preview and retake, made smaller on the phone and upright by its EXIF, as a real file in a form.",
    tags: ["mobile", "interactive", "camera", "photo", "upload", "forms"], needs: ["button"], demo: PhotoCaptureDemo })
