component OnboardingChecklistDemoLive() {
    state last = null
    state hidden = false
    <div.demo-stack>
        <OnboardingChecklist steps={[
            { id: "profile", title: "Fill in your profile", text: "A name and a picture.", done: true },
            { id: "team", title: "Invite your team", text: "Three seats are free on this plan.", href: "#onboarding_checklist", link: "Invite" },
            { id: "deploy", title: "Deploy a project", href: "#onboarding_checklist" },
        ]} on_change={(id, on) => { last = `${id} ${on ? "done" : "undone"}` }} on_dismiss={() => { hidden = true }}/>
        <p.demo-note>{hidden ? "Hidden: on_dismiss was called." : last ?? "Tick a step, or follow its link."}</p>
    </div>
}

view OnboardingChecklistDemo() =
    <div.demo-stack.demo-narrow>
        <OnboardingChecklistDemoLive/>
        <OnboardingChecklist title="Billing" dismissable={false} steps={[
            { id: "card", title: "Add a card", done: true }, { id: "vat", title: "Add a VAT number", done: true },
        ]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "onboarding_checklist", name: "OnboardingChecklist", group: "Dashboard",
    summary: "Steps to finish setting up, with a progress bar, a tick on each done and a link to where the rest get done.",
    tags: ["dashboard", "progress", "list", "forms", "user", "interactive"],
    demo: OnboardingChecklistDemo })
