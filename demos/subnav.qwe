let subnav_demo_links = [
    { label: "Code", href: "#code", icon: "M8 6 2 12l6 6M16 6l6 6-6 6" },
    { label: "Issues", href: "#subnav", icon: "M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM12 8v4M12 16h.01", badge: 24 },
    { label: "Pull requests", href: "#pulls", badge: 3 },
    { label: "Actions", href: "#actions" },
    { label: "Wiki", href: "#wiki" },
    { label: "Settings", href: "#settings" }
]

view SubnavDemo() =
    <div.demo-stack style="gap: 20px">
        <div style="border: 1px solid var(--ui-border); border-radius: var(--ui-radius); overflow: hidden">
            <Subnav id="subnav-demo" title="quillo/components" links={subnav_demo_links} current="#subnav">
                <Button size="sm" variant="outline" href="#subnav">Watch</Button>
            </Subnav>
            <div style="height: 32px"></div>
        </div>
        <Subnav id="subnav-demo-pill" variant="pill" label="Period" current="#month" links={[
            { label: "Today", href: "#today" }, { label: "This week", href: "#week" },
            { label: "This month", href: "#month" }, { label: "This year", href: "#year" }
        ]}/>
        <div style="width: 300px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius); overflow: hidden">
            <Subnav id="subnav-demo-narrow" links={subnav_demo_links} current="#wiki"/>
        </div>
        <p.demo-note>Narrow, the row scrolls sideways.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "subnav", name: "Subnav", group: "Navigation",
    summary: "A second row of links under the main navigation, for one section's pages, with counts and the current one marked.",
    tags: ["navigation", "link", "tabs", "no-js"], demo: SubnavDemo })
