let review_list_demo_reviews = [
    { id: "a1", rating: 5, title: "Exactly as described", name: "Ola N.", date: "2026-10-02", verified: true, helpful: 3, text: "Arrived in two days, well packed." },
    { id: "a2", rating: 2, title: "Smaller than it looks", name: "Jun K.", date: "2026-08-21", helpful: 9, text: "The photos make it look twice the size." },
    { id: "a3", rating: 4, title: "Good value", name: "Marta R.", date: "2026-09-14", verified: true, helpful: 12, text: "Does the job. The lid is a bit loose." },
    { id: "a4", rating: 5, title: "Second one I bought", name: "Sam T.", date: "2026-07-01", helpful: 1, text: "Gave the first to my sister." },
    { id: "a5", rating: 3, name: "Anonymous", date: "2026-06-11", helpful: 0, text: "Fine." },
    { id: "a6", rating: 4, title: "Quiet", name: "Lea B.", date: "2026-05-30", verified: true, helpful: 5, text: "Quieter than the old one." },
    { id: "a7", rating: 1, title: "Broke in a week", name: "Ivo P.", date: "2026-04-18", helpful: 20, text: "The hinge snapped. Support replaced it, to be fair." },
]

component ReviewListDemoLive() {
    state mine = []
    state log = "No votes yet."
    <div.demo-stack>
        <ReviewList id="rl-live" reviews={take(review_list_demo_reviews, 3)} voted={mine}
                    on_helpful={(rid) => {
                        mine = contains(mine, rid) ? mine | filter((x) => x != rid) : push(mine, rid)
                        log = `Voted: ${len(mine) == 0 ? "none" : join(mine, ", ")}.`
                    }}/>
        <p.demo-note>{log}</p>
    </div>
}

view ReviewListDemo() =
    <div.demo-stack>
        <form method="post" action="/reviews/helpful">
            <ReviewList id="rl-all" reviews={review_list_demo_reviews} limit={4}/>
        </form>
        <ReviewListDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "review_list", name: "ReviewList", group: "Data",
    summary: "Reviews sorted by a select (newest, highest, most helpful), filtered by stars with counts, shown a page at a time.",
    tags: ["list", "sort", "filter", "commerce", "social", "interactive"],
    needs: ["avatar", "review_card"],
    demo: ReviewListDemo })
