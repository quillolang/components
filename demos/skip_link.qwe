view SkipLinkDemo() =
    <div.demo-stack>
        <div.demo-row>
            <SkipLink id="skip-link-demo" target="skip-link-demo-content"/>
            <Button id="skip-link-demo-before" variant="outline" size="sm">Tab from here</Button>
            <p.demo-note>Shift+Tab from the button: the link appears at the top left of the page.</p>
        </div>
        <div.demo-row>
            <SkipLink target="skip-link-demo-content" shown={true}/>
            <SkipLink target="skip-link-demo-content" text="Skip to results" shown={true}/>
        </div>
        <p.demo-note id="skip-link-demo-content" tabindex="-1" style="padding: 10px; border: 1px dashed var(--ui-border); border-radius: var(--ui-radius-sm)">
            The content the link goes to: it takes the focus, so the keyboard carries on from here.
        </p>
    </div>

ui_gallery = ui_gallery | push({ slug: "skip_link", name: "SkipLink", group: "Navigation",
    summary: "\"Skip to content\": the first link on a page, out of sight until the keyboard reaches it.",
    tags: ["navigation", "accessibility", "keyboard", "link", "no-js"], demo: SkipLinkDemo })
