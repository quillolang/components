let card_stack_demo_cards = [
    { id: "a", name: "Everyday", brand: "Visa", last4: "4242", color: "#27324b" },
    { id: "b", name: "Travel", brand: "Mastercard", last4: "4444", color: "#176d5a", frozen: true },
    { id: "c", name: "Bills", brand: "Visa", last4: "1881", color: "#6a2c70" },
    { id: "d", name: "Shared", brand: "Amex", last4: "0005", color: "not a colour" },
]

component CardStackDemoLive() {
    state log = "Nothing yet"
    state refuse = false
    state lost = false
    <div.demo-stack>
        <CardStack cards={card_stack_demo_cards} hide_after={3}
                   on_lift={(the_id) => { log = `Lifted ${the_id}` }}
                   on_copy={(the_id, field) => { log = `Copied ${field} of ${the_id}` }}
                   on_freeze={(the_id, on) => {
                       if refuse { return false }
                       log = `${on ? "Froze" : "Unfroze"} ${the_id}`
                       js("Promise.resolve", true)
                   }}
                   on_reveal={(card) => {
                       if lost { return null }
                       js("Promise.resolve", { number: "4242 4242 4242 4242", expiry: "04/28", cvv: "737", holder: "A. Reyes" })
                   }}/>
        <p.demo-note id="cardstack-log">{log}</p>
        <div.demo-row>
            <label.demo-row style="min-height: 44px"><input id="cardstack-refuse" type="checkbox" bind:checked={refuse}/> Refuse freezing</label>
            <label.demo-row style="min-height: 44px"><input id="cardstack-lost" type="checkbox" bind:checked={lost}/> Refuse details</label>
        </div>
    </div>
}

view CardStackDemo() =
    <div.demo-stack>
        <CardStackDemoLive/>
        <div id="cardstack-none"><CardStack/></div>
        <div id="cardstack-own"><CardStack cards={[{ id: "z", name: "Own", last4: "9999", number: "5555555555554444", cvv: "123" }]}/></div>
    </div>

ui_gallery = ui_gallery | push({ slug: "card_stack", name: "CardStack", group: "Mobile",
    summary: "Cards in a fan: a tap lifts one, a switch freezes it, and its details are hidden, shown and copied a field at a time.",
    tags: ["mobile", "interactive", "banking", "card", "clipboard", "tablet"],
    needs: ["button"],
    demo: CardStackDemo })
