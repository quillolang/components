component TimezonePickerDemoLive() {
    state zone = "Asia/Tokyo"
    <div.demo-stack>
        <TimezonePicker name="meeting_tz" label="Meeting time zone" value={zone} field="timezone-picker-demo-live"
                        zones={["UTC", "Europe/London", "Europe/Berlin", "America/New_York", "America/Los_Angeles", "Asia/Tokyo", "Australia/Sydney"]}
                        on_change={(z) => { zone = z }}/>
        <p.demo-note>Meetings are set in {zone}.</p>
    </div>
}

view TimezonePickerDemo() =
    <div.demo-stack.demo-narrow>
        <TimezonePicker name="tz" label="Time zone" value="Europe/Lisbon" field="timezone-picker-demo-all"
                        hint="Offsets are for today, daylight saving included." required={true}/>
        <TimezonePickerDemoLive/>
        <div.demo-row>
            <TimezonePicker name="tz_small" label="Small" size="sm" placeholder="Pick a zone" field="timezone-picker-demo-small"
                            zones={["Europe/Paris", "Asia/Kolkata", "Pacific/Auckland"]}/>
            <TimezonePicker name="tz_locked" label="Disabled" size="sm" value="UTC" disabled={true} zones={["UTC"]}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "timezone_picker", name: "TimezonePicker", group: "Forms",
    summary: "A drop-down of time zones grouped by region, each with its UTC offset for today, sending the IANA name with a form.",
    tags: ["forms", "select", "picker", "time", "no-js"], demo: TimezonePickerDemo })
