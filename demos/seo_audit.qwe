let seo_audit_demo_body = "<h1>Cold brew at home</h1>\n<p>Cold brew is easier than it looks, and it keeps for a week.</p>\n<img src=\"/img/jar.jpg\" alt=\"A jar of cold brew\">\n<img src=\"/img/beans.jpg\">\n<h3>What you need</h3>\n<p>Coarse beans, a jar and <a href=\"/guides/grind\">the right grind</a>. See the <a href=\"https://example.org/brew\">brewing study</a>.</p>"
let seo_audit_demo_markdown = "# Tea at home\n\nTea at home takes three minutes.\n\n## Steps\n\n![A cup of tea](/img/tea.jpg)\n\nBoil the water, then read [our guide](/guides/tea)."

component SeoAuditDemoLive() {
    state score = null
    <div.demo-stack>
        <SeoAudit id="seo-audit-demo-live" name="post" title="How to make tea at home" slug="tea-at-home" keyword="tea" body={seo_audit_demo_markdown} rows={6} on_change={(r) => { score = r.score }}/>
        <p.demo-note>{score == null ? "Change a field to see on_change." : `on_change: the score is ${score}.`}</p>
    </div>
}

view SeoAuditDemo() =
    <div.demo-stack>
        <SeoAudit id="seo-audit-demo" title="Cold brew at home" description="Cold brew in three steps." slug="Cold_Brew" keyword="cold brew" body={seo_audit_demo_body} base_url="https://blog.example.com/"/>
        <SeoAuditDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "seo_audit", name: "SeoAudit", group: "Blogging",
    summary: "Audits a post's title, description, slug and HTML or Markdown body: lengths, headings, alt text, keyword placement and links, with a score and how to fix each failure.",
    tags: ["smart", "interactive", "seo", "audit", "blogging", "checklist"], needs: ["readability_meter"], demo: SeoAuditDemo })
