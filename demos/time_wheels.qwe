component TimeWheelsDemoLive() {
    state alarm = "07:30"
    <div.demo-stack>
        <div id="time-wheels-demo-alarm">
            <TimeWheels label="Alarm" name="alarm" value={alarm} step={5} locale="en-US" on_change={(t) => { alarm = t }}/>
        </div>
        <p.demo-note id="time-wheels-demo-out">Value: {alarm}</p>
        <Button size="lg" variant="outline" id="time-wheels-demo-set" on_click={() => { alarm = "18:12" }}>Set 18:12</Button>
    </div>
}

view TimeWheelsDemo() =
    <div.demo-stack>
        <TimeWheelsDemoLive/>
        <div id="time-wheels-demo-night">
            <p.demo-note>A night shift, 22:00 to 02:00 in steps of 15 minutes, on en-GB's clock:</p>
            <TimeWheels label="Shift start" name="shift" value="23:10" step={15} earliest="22:00" latest="02:00" locale="en-GB" rows={3}/>
        </div>
        <div id="time-wheels-demo-late">
            <p.demo-note>The same limits on a 12-hour clock:</p>
            <TimeWheels label="Pick-up" name="pickup" value="22:30" step={30} earliest="22:00" latest="01:00" hour24={false} rows={3}/>
        </div>
        <div id="time-wheels-demo-bad">
            <p.demo-note>A time that does not exist, a step of 0, limits nothing fits, and a locale that is not one:</p>
            <TimeWheels label="Odd" name="odd" value="25:99" step={0} earliest="never" latest="soon" locale="not a locale!" rows={3}/>
            <TimeWheels label="Tight" name="tight" value="10:00" step={30} earliest="10:05" latest="10:10" hour24={true} rows={3}/>
            <TimeWheels label="By the browser" name="plain" value="13:05" rows={3}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "time_wheels", name: "TimeWheels", group: "Mobile",
    summary: "Hour, minute and AM/PM wheels with steps, a 24-hour mode by locale, and limits across midnight.",
    tags: ["mobile", "interactive", "time", "picker", "wheel", "forms"], needs: ["wheel_picker"],
    demo: TimeWheelsDemo })
