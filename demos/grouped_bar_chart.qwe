let grouped_bar_chart_demo_grid = "display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 32px 40px"

view GroupedBarChartDemo() =
    <div.demo-stack>
        <GroupedBarChart label="Signups by plan" show_label={true} labels={["Q1", "Q2", "Q3", "Q4"]}
                         series={[{ name: "Free", values: [1840, 2210, 2650, 3120] },
                                  { name: "Pro", values: [420, 515, 640, 810] },
                                  { name: "Team", values: [96, 130, 188, 245] }]}/>
        <div style={grouped_bar_chart_demo_grid}>
            <GroupedBarChart label="Budget and actual" show_label={true} prefix="$" value_labels={true} height={180}
                             labels={["Design", "Eng", "Sales"]}
                             series={[{ name: "Budget", values: [42000, 96000, 58000] },
                                      { name: "Actual", values: [39500, 104200, 51800] }]}/>
            <GroupedBarChart label="Change from last year" show_label={true} suffix="%" value_labels={true} height={180}
                             labels={["North", "South", "East", "West"]}
                             series={[{ name: "Units", values: [12, -4, 7.5, 3] },
                                      { name: "Revenue", values: [9, -8, 11, -2] }]}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "grouped_bar_chart", name: "GroupedBarChart", group: "Charts",
    summary: "A bar per series side by side for each label, below zero too, with the group's values on hover and the bar under the pointer picked out.",
    tags: ["chart", "data", "dashboard", "no-js"],
    demo: GroupedBarChartDemo })
