component ProductCardDemoLive() {
    state added = 0
    <div.demo-stack>
        <div style="max-width: 240px">
            <ProductCard id="beanie" name="Wool beanie" brand="Northwind" price={24} image="https://picsum.photos/seed/beanie/400/300"
                         rating={4} reviews={37} stock="low" on_add={() => { added += 1 }}/>
        </div>
        <p.demo-note>{added == 0 ? "Nothing added yet." : `Added ${added} ${added == 1 ? "time" : "times"} (on_add).`}</p>
    </div>
}

view ProductCardDemo() =
    <div.demo-stack>
        <div.demo-row style="align-items: stretch">
            <div style="width: 240px">
                <ProductCard id="runner" name="Trail runner" brand="Northwind" price={89} old={120} currency="USD"
                             image="https://picsum.photos/seed/runner/400/300" rating={4.5} reviews={128} badge="Sale" badge_tone="danger"
                             href="#product_card" action="/cart"/>
            </div>
            <div style="width: 240px">
                <ProductCard id="bottle" name="Insulated bottle, 750 ml" price={32.5} currency="EUR" locale="de-DE"
                             image="https://picsum.photos/seed/bottle/400/300" rating={3.8} reviews={9} badge="New" ratio="1"/>
            </div>
            <div style="width: 240px">
                <ProductCard id="jacket" name="Rain jacket" price={149} image="https://picsum.photos/seed/jacket/400/300" stock="out" action="/cart"/>
            </div>
        </div>
        <ProductCardDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "product_card", name: "ProductCard", group: "Commerce",
    summary: "A product in a shop's grid: picture, name, price with the discount, stars, a badge and Add to cart, as a plain form or a callback.",
    tags: ["commerce", "card", "price", "image", "button", "cart"],
    needs: ["price"], demo: ProductCardDemo })
