view ColumnsDemoCell(label: str) =
    <div style="padding: 18px 12px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius-sm); background: var(--ui-subtle); text-align: center; font-size: 13px">{label}</div>

view ColumnsDemo() =
    <div.demo-stack>
        <Columns class="columns-demo-equal">
            <ColumnsDemoCell label="One"/><ColumnsDemoCell label="Two"/><ColumnsDemoCell label="Three"/>
        </Columns>
        <Columns widths={[2, 1]} gap="lg" class="columns-demo-weighted">
            <ColumnsDemoCell label="Twice as wide"/><ColumnsDemoCell label="Aside"/>
        </Columns>
        <p.demo-note>Below, the same columns in a 400px-wide box: they stack, the last one first.</p>
        <div style="width: 400px; max-width: 100%">
            <Columns widths={[1, 2]} reverse={true} class="columns-demo-narrow">
                <ColumnsDemoCell label="Image"/><ColumnsDemoCell label="Text"/>
            </Columns>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "columns", name: "Columns", group: "Layout",
    summary: "Children side by side, equal or weighted, that go one under another when their box is narrow.",
    tags: ["layout", "grid", "no-js"], demo: ColumnsDemo })
