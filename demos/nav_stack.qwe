let nav_stack_demo_mail = [
    { id: 1, from: "Ana Reyes", subject: "Invoice for the site survey" }, { id: 2, from: "Ben Okafor", subject: "Friday's call moved" }, { id: 3, from: "Carla Lim", subject: "Photos from the ridge" },
    { id: 4, from: "Dante Cruz", subject: "Trail markers" }, { id: 5, from: "Elena Marsh", subject: "Rain gauge readings" }, { id: 6, from: "Farid Haddad", subject: "Soil pits" },
    { id: 7, from: "Grace Tan", subject: "Water samples" }, { id: 8, from: "Hugo Silva", subject: "Permit renewal" }, { id: 9, from: "Ines Duarte", subject: "Bird count" },
    { id: 10, from: "Jun Park", subject: "Drone batteries" }, { id: 11, from: "Kira Novak", subject: "Field kit list" }, { id: 12, from: "Luis Ortega", subject: "Budget for spring" },
]

let nav_stack_demo_css = css`
.ui-navstack-demo-row { display: block; box-sizing: border-box; width: 100%; min-height: 64px; padding: 10px 16px; border: 0; border-bottom: 1px solid var(--ui-border); background: transparent; color: var(--ui-fg); font: 15px/1.4 var(--ui-font); text-align: start; cursor: pointer; }
.ui-navstack-demo-row small { display: block; color: var(--ui-muted); }
.ui-navstack-demo-field { box-sizing: border-box; display: block; width: calc(100% - 24px); height: 44px; margin: 12px; padding: 0 12px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius-sm); background: var(--ui-surface); color: var(--ui-fg); font: 16px var(--ui-font); }
`

component NavStackDemoCounter() {
    state n = 0
    <Button size="lg" variant="outline" on_click={() => { n += 1 }}>Starred {n}</Button>
}

fn nav_stack_demo_screen(s, nav) = match get(s, "name") {
    "inbox" => <div data-screen="inbox">
        <input.ui-navstack-demo-field aria-label="Filter" placeholder="Filter"/>
        {for m in range(0, 3) => <div key={m}>
            {for r in nav_stack_demo_mail => <button.ui-navstack-demo-row key={r.id} type="button"
                    @click={() => { nav.push({ name: "mail", title: r.subject, mail: r.id, path: `#mail-${r.id}` }) }}>{r.subject}<small>{r.from}</small></button>}
        </div>}
    </div>
    "mail" => <div data-screen="mail" style="padding: 16px">
        <p style="margin-top: 0">Mail {get(s, "mail")}, the message itself.</p>
        <div class="demo-row">
            <NavStackDemoCounter/>
            <Button size="lg" variant="soft" on_click={() => { nav.push({ name: "file", title: "Attachment" }) }}>Attachment</Button>
        </div>
        {for i in range(1, 40) => <p key={i}>Line {i} of mail {get(s, "mail")}</p>}
    </div>
    _ => <div data-screen="file" style="padding: 16px">
        <p style="margin-top: 0">The attachment, from "{get(s, "before")}".</p>
        <div class="demo-row">
            <Button size="lg" variant="outline" on_click={() => { nav.home() }}>Back to the inbox</Button>
            <Button size="lg" variant="soft" on_click={() => { nav.push({ name: "file", title: 12345, path: "https://example.com/elsewhere" }) }}>A bad entry</Button>
        </div>
    </div>
}

component NavStackDemoLive() {
    style global nav_stack_demo_css
    state top = "Inbox"
    state shown_depth = 1
    state run = 0
    state steps = true
    <div.demo-stack>
        <div.demo-tablet>
            <NavStack key={run} id="nav-stack-demo" back={steps} root={{ name: "inbox", title: "Inbox" }} screen={(s, nav) => nav_stack_demo_screen(s, nav)}
                      on_change={(e, d) => { top = get(e, "title", ""); shown_depth = d }}/>
        </div>
        <div.demo-row>
            <p class="demo-note">Showing {top}, {shown_depth} deep</p>
            <Button size="lg" variant="outline" on_click={() => { run += 1 }}>Build it again</Button>
            <Button size="lg" variant="outline" on_click={() => { steps = !steps; run += 1 }}>{steps ? "Without the history" : "With the history"}</Button>
        </div>
    </div>
}

view NavStackDemo() = <NavStackDemoLive/>

ui_gallery = ui_gallery | push({ slug: "nav_stack", name: "NavStack", group: "Mobile",
    summary: "A stack of screens pushed and popped with a slide, each keeping its state and scroll, with a real Back through the browser's history; a column beside the rest on a tablet.",
    tags: ["mobile", "interactive", "tablet", "navigation", "history", "gesture"],
    needs: ["swipe_back"],
    demo: NavStackDemo })
