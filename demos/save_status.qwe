component SaveStatusDemoLive() {
    state status = "saved"
    state saves = 0
    <div.demo-stack>
        <div.demo-row>
            <TextArea name="notes" label="Notes" rows={2} value="Edit me to see the status change."
                      on_input={(_v) => { status = "unsaved" }}/>
        </div>
        <div.demo-row>
            <SaveStatus id="save-status-demo-live" status={status} time="14:02" action={status == "unsaved" ? "Save now" : null}
                        on_click={() => { status = "saving"; saves += 1 }}/>
            {status == "saving" && <Button size="sm" variant="outline" id="save-status-demo-finish" on_click={() => { status = "saved" }}>Pretend it finished</Button>}
        </div>
        <p.demo-note>Saved {saves} {saves == 1 ? "time" : "times"} from the button.</p>
    </div>
}

view SaveStatusDemo() =
    <div.demo-stack>
        <div.demo-row style="gap: 24px">
            <SaveStatus id="save-status-demo-saved" status="saved" time="2026-10-27T14:02:00Z"/>
            <SaveStatus id="save-status-demo-saving" status="saving"/>
            <SaveStatus id="save-status-demo-unsaved" status="unsaved"/>
            <SaveStatus id="save-status-demo-error" status="error" action="Retry"/>
            <SaveStatus status="saved" time="just now" size="sm" words={{ saved: "All changes saved" }}/>
        </div>
        <SaveStatusDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "save_status", name: "SaveStatus", group: "Feedback",
    summary: "Saving…, Saved, Unsaved changes or Could not save, with an icon, the time last saved and an optional action.",
    tags: ["feedback", "status", "time", "no-js"],
    demo: SaveStatusDemo })
