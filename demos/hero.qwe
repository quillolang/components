view HeroDemo() =
    <div.demo-stack>
        <Hero id="hero-demo-center" eyebrow="Now in beta" title="Ship the whole app in one file"
              text="Routes, views and live components in a language made for the web. No build step, no framework to wire up.">
            <Button size="lg" href="#hero">Get started</Button>
            <Button size="lg" variant="outline" href="#hero">Read the docs</Button>
        </Hero>
        <Hero title="See the code" level={2} text="A route, a view and a component: the whole page."
              side={<CodeBlock code={"route GET / =\n    <html><body>\n        <Counter start={5}/>\n    </body></html>"} language="quillo"/>}>
            <Button href="#hero">Try it</Button>
        </Hero>
        <p.demo-note>Centred without a side; words left and the picture or code right with one. On a phone the side goes under.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "hero", name: "Hero", group: "Marketing",
    summary: "A landing page's opening: eyebrow, headline, lead, buttons, and a picture or code on the side.",
    tags: ["marketing", "section", "page", "layout", "no-js"],
    demo: HeroDemo })
