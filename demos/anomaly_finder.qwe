let anomaly_finder_demo_points = [
    { t: "2026-01-01", value: 100 }, { t: "2026-01-02", value: 102 }, { t: "2026-01-03", value: 98 }, { t: "2026-01-04", value: 101 }, { t: "2026-01-05", value: 99 },
    { t: "2026-01-06", value: 103 }, { t: "2026-01-07", value: 97 }, { t: "2026-01-08", value: 100 }, { t: "2026-01-09", value: 102 }, { t: "2026-01-10", value: 180 },
    { t: "2026-01-11", value: 99 }, { t: "2026-01-12", value: 101 }, { t: "2026-01-13", value: 100 }, { t: "2026-01-14", value: 98 }, { t: "2026-01-15", value: 102 },
    { t: "2026-01-16", value: 150 }, { t: "2026-01-17", value: 152 }, { t: "2026-01-18", value: 148 }, { t: "2026-01-19", value: 151 }, { t: "2026-01-20", value: 149 },
    { t: "2026-01-21", value: 153 }, { t: "2026-01-25", value: 150 }, { t: "2026-01-26", value: 148 }, { t: "2026-01-27", value: 152 }, { t: "2026-01-28", value: 149 },
