]

component AnomalyFinderDemoLive() {
    state seen = "Change the sensitivity to see on_change."
    <div.demo-stack>
        <AnomalyFinder id="anomaly-finder-demo-live" title="Requests a minute" name="traffic" points={[812, 790, 804, 2210, 798, 801, 795, 809, 787, 803]} sensitivity={5}
                       on_change={(f) => { seen = `on_change: ${len(f)} found.` }}/>
        <p.demo-note>{seen}</p>
    </div>
}

view AnomalyFinderDemo() =
    <div.demo-stack>
        <AnomalyFinder id="anomaly-finder-demo" title="Daily orders" points={anomaly_finder_demo_points}/>
        <AnomalyFinderDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "anomaly_finder", name: "AnomalyFinder", group: "Dashboard",
    summary: "Flags outliers by median absolute deviation, gaps and level shifts in a time series, plots them, and says why each was flagged.",
    tags: ["smart", "interactive", "anomaly", "outlier", "chart", "analysis"], demo: AnomalyFinderDemo })
