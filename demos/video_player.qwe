// A poster drawn in SVG, so the demo needs no image files; the clip is one of MDN's shared sample videos.
let video_player_demo_poster = `data:image/svg+xml,${url_encode(
    `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 360" width="640" height="360">`
    + `<rect width="640" height="360" fill="#2a3b2c"/><circle cx="320" cy="170" r="70" fill="#e8a0c8"/>`
    + `<circle cx="320" cy="170" r="28" fill="#ffd36b"/><rect x="310" y="240" width="20" height="120" fill="#4b7a3a"/></svg>`)}`

let video_player_demo_sources = [
    { src: "https://mdn.github.io/shared-assets/videos/flower.webm", type: "video/webm" },
    { src: "https://mdn.github.io/shared-assets/videos/flower.mp4", type: "video/mp4" },
]

component VideoPlayerDemoLive() {
    state events = []
    <div.demo-stack>
        <VideoPlayer sources={video_player_demo_sources} poster={video_player_demo_poster} label="A flower, muted" muted={true}
                     on_play={() => { events = events | push("play") }} on_pause={() => { events = events | push("pause") }}
                     on_end={() => { events = events | push("end") }}/>
        <p.demo-note id="video-player-demo-events">{len(events) == 0 ? "Nothing yet." : join(events, ", ")}</p>
    </div>
}

view VideoPlayerDemo() =
    <div.demo-stack>
        <VideoPlayer sources={video_player_demo_sources} poster={video_player_demo_poster} label="A flower opening"/>
        <VideoPlayerDemoLive/>
        <p.demo-note>Space plays, the arrows seek and set the volume, M mutes, F goes full screen.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "video_player", name: "VideoPlayer", group: "Media",
    summary: "A video with the kit's own controls: play, seek, time, volume, full screen and the keyboard.",
    tags: ["media", "video", "keyboard", "interactive"], demo: VideoPlayerDemo })
