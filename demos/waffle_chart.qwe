let waffle_chart_demo_grid = "display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 32px 40px"

view WaffleChartDemo() =
    <div style={waffle_chart_demo_grid}>
        <WaffleChart label="Electricity by source" show_label={true} suffix=" TWh" parts={[
            { label: "Wind", value: 81.2 }, { label: "Gas", value: 62.5 }, { label: "Solar", value: 44.9 },
            { label: "Nuclear", value: 31.7 }, { label: "Coal", value: 12.4 }, { label: "Hydro", value: 8.3 }]}/>
        <WaffleChart label="Seats sold" show_label={true} size={150} total={5000} parts={[
            { label: "Members", value: 2380 }, { label: "Public", value: 1740 }]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "waffle_chart", name: "WaffleChart", group: "Charts",
    summary: "Parts of a whole as a 10×10 grid of squares, one per percent, with a legend of values and shares; hovering picks a part out.",
    tags: ["chart", "data", "no-js"],
    demo: WaffleChartDemo })
