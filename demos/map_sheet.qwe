component MapSheetDemoLive() {
    state chosen = "nothing yet"
    state stop = "half"
    state from_page = null
    state shown = true
    <div.demo-stack>
        <div.demo-phone>
            {shown && <MapSheet title="In Lisbon" label="Places in Lisbon" places={map_sheet_demo_places} selected={from_page}
                      on_pick={(p) => { chosen = p.name }} on_detent={(n) => { stop = n }}/>}
        </div>
        <div.demo-row>
            <button.map-sheet-demo-page type="button" style="min-height: 44px" @click={() => { from_page = 10 }}>Mark the market from the page</button>
            <button.map-sheet-demo-toggle type="button" style="min-height: 44px" @click={() => { shown = !shown }}>Take it away, or bring it back</button>
            <span.demo-note>Picked: <span class="map-sheet-demo-chosen">{chosen}</span>. Stop: <span class="map-sheet-demo-stop">{stop}</span>.</span>
        </div>
    </div>
}

view MapSheetDemo() = <MapSheetDemoLive/>

ui_gallery = ui_gallery | push({ slug: "map_sheet", name: "MapSheet", group: "Mobile",
    summary: "A list in a sheet over a Leaflet map, each synced to the other, pins and rows, with the sheet dragged down to see more of the map; on a tablet, a list beside it.",
    tags: ["mobile", "interactive", "tablet", "map", "sheet", "gesture"], demo: MapSheetDemo })
