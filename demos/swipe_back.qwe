let swipe_back_demo_names = ["Inbox", "Ana Reyes", "Invoice 2041"]
let swipe_back_demo_lines = [
    ["Ana Reyes: the invoice is attached", "Ben Okafor: Friday's call moved", "Carla Lim: photos from the site"],
    ["The invoice is attached.", "It is due on the 14th, in pesos.", "Tell me if the address has changed."],
    ["Invoice 2041", "Site survey, two days", "Total: PHP 48,500.00"],
]

view SwipeBackDemoScreen(name: str, lines: list) =
    <div style="padding: 8px 16px">
        <p class="demo-note">{name}</p>
        {for l in lines => <p style="margin: 12px 0; padding-bottom: 12px; border-bottom: 1px solid var(--ui-border)">{l}</p>}
        {for i in range(1, 45) => <p style="margin: 18px 0; color: var(--ui-muted)">Older line {i}</p>}
    </div>

component SwipeBackDemoLive() {
    state depth = 2
    state backs = 0
    state across = 0
    let name = swipe_back_demo_names[depth]
    let before = depth > 0 ? swipe_back_demo_names[depth - 1] : ""
    <div.demo-stack>
        <div.demo-tablet>
            <SwipeBack title={name} back_label={`Back to ${before}`} back_text={before} enabled={depth > 0}
                       behind={depth > 0 ? <div style="padding-top: 48px"><SwipeBackDemoScreen name={before} lines={swipe_back_demo_lines[depth - 1]}/></div> : null}
                       on_back={() => { depth -= 1; backs += 1 }} on_progress={(p) => { across = round(p * 100) }}>
                <SwipeBackDemoScreen name={name} lines={swipe_back_demo_lines[depth]}/>
            </SwipeBack>
        </div>
        <div.demo-row>
            <p class="demo-note">Went back {backs} {backs == 1 ? "time" : "times"}, now {across}% across</p>
            <Button size="lg" variant="outline" on_click={() => { depth = 2 }}>Start again</Button>
        </div>
    </div>
}

view SwipeBackDemo() = <SwipeBackDemoLive/>

ui_gallery = ui_gallery | push({ slug: "swipe_back", name: "SwipeBack", group: "Mobile",
    summary: "Pull a screen away from the left edge to go back, with the previous one peeking behind; a Back button for everyone else.",
    tags: ["mobile", "interactive", "gesture", "navigation", "back"],
    demo: SwipeBackDemo })
