let rotation_layout_demo_css = css`
.demo-rotation { display: flex; flex-direction: column; height: 100%; font: 14px/1.45 var(--ui-font); }
.demo-rotation-bar { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 10px 14px; border-bottom: 1px solid var(--ui-border); background: var(--ui-subtle); }
.demo-rotation-body { flex: 1; min-height: 0; padding: 12px; }
.demo-rotation-photo { height: 100%; min-height: 120px; border-radius: var(--ui-radius); background: linear-gradient(135deg, #2b6f8f, #7ab77a 60%, #e0c56e); }
.demo-rotation-card { display: grid; gap: 8px; align-content: start; padding: 12px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius); }
.demo-rotation-card label { font-weight: 600; }
.demo-rotation-card input { box-sizing: border-box; width: 100%; height: 46px; padding: 0 10px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius-sm); background: var(--ui-surface); color: var(--ui-fg); font: 16px/1.2 var(--ui-font); }
.demo-rotation-stop { margin: 0; padding: 10px 12px; border-bottom: 1px solid var(--ui-border); }
.demo-rotation-stops { border: 1px solid var(--ui-border); border-radius: var(--ui-radius); }
.demo-rotation-tip { padding: 12px; border-radius: var(--ui-radius); background: var(--ui-accent-soft); }
.demo-rotation-tile { display: grid; place-items: center; min-height: 40px; border-radius: var(--ui-radius-sm); background: var(--ui-accent-soft); }
`

let rotation_layout_demo_stops = range(1, 61) | map((n) => {
    n: n,
    text: `Stop ${n}: ${n % 3 == 0 ? "the long way round the reservoir, past the old pumping station and over the footbridge to the north gate" : n % 3 == 1 ? "the depot" : "the car park behind the school, on the left as you come in"}`
})

component RotationLayoutDemoLive() {
    style global rotation_layout_demo_css
    state facing = "unknown"
    state shape = "unknown"
    <div.demo-stack>
        <div.demo-tablet>
            <div.demo-rotation>
                <div.demo-rotation-bar>
                    <strong>Site survey</strong>
                    <output id="rotation-demo-facing">{facing}</output>
                </div>
                <div.demo-rotation-body>
                    <RotationLayout portrait={["photo", "details", "stops"]} portrait_rows="180px auto minmax(0, 1fr)"
                                    landscape={["photo stops", "tip stops", "details stops"]} landscape_columns="3fr 2fr"
                                    landscape_rows="minmax(0, 1fr) auto auto"
                                    on_turn={(o) => { facing = o }}>
                        <RotationLayoutArea name="photo"><div.demo-rotation-photo id="rotation-demo-photo" role="img" aria-label="The site from the north gate"></div></RotationLayoutArea>
                        <RotationLayoutArea name="details">
                            <div.demo-rotation-card>
                                <label for="rotation-demo-name">Name of the site</label>
                                <input id="rotation-demo-name" type="text" autocomplete="off"/>
                            </div>
                        </RotationLayoutArea>
                        <RotationLayoutArea name="stops" scroll={true} class="demo-rotation-stops">
                            <div id="rotation-demo-stops">
                                {for s in rotation_layout_demo_stops => <p.demo-rotation-stop key={s.n} id={`rotation-demo-stop-${s.n}`}>{s.text}</p>}
                            </div>
                        </RotationLayoutArea>
                        <RotationLayoutArea name="tip" only="landscape">
                            <p.demo-rotation-tip id="rotation-demo-tip">Turned: more room for the map.</p>
                        </RotationLayoutArea>
                    </RotationLayout>
                </div>
            </div>
        </div>
        <p.demo-note>This one reads the shape of its own box ({shape}), not the screen's:</p>
        <div id="rotation-demo-box-wrap" style="width: 100%; max-width: 480px; height: 200px">
            <RotationLayout fit="box" portrait={["a", "b"]} landscape={["a b"]} on_turn={(o) => { shape = o }}>
                <RotationLayoutArea name="a"><div.demo-rotation-tile id="rotation-demo-a">First</div></RotationLayoutArea>
                <RotationLayoutArea name="b"><div.demo-rotation-tile id="rotation-demo-b">Second</div></RotationLayoutArea>
            </RotationLayout>
        </div>
        <p.demo-note>Given an arrangement that is not a rectangle, it stacks:</p>
        <div id="rotation-demo-bad">
            <RotationLayout portrait={["a b", "b a"]} landscape={["a a b", "c"]} height="auto">
                <RotationLayoutArea name="a"><div.demo-rotation-tile>One</div></RotationLayoutArea>
                <RotationLayoutArea name="b"><div.demo-rotation-tile>Two</div></RotationLayoutArea>
            </RotationLayout>
        </div>
    </div>
}

view RotationLayoutDemo() = <RotationLayoutDemoLive/>

ui_gallery = ui_gallery | push({ slug: "rotation_layout", name: "RotationLayout", group: "Mobile",
    summary: "Two arrangements of one set of children, upright and turned: no flash, and focus and scroll kept across the turn.",
    tags: ["mobile", "tablet", "interactive", "layout", "rotation", "orientation"],
    demo: RotationLayoutDemo })
