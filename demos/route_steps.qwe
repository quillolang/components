let route_steps_demo_steps = [
    { text: "Head south on Rua Augusta", road: "Rua Augusta", turn: "straight", metres: 400, seconds: 300, lat: 38.7105, lng: -9.1370 },
    { text: "Turn left onto Rua do Comercio", road: "Rua do Comercio", turn: "left", metres: 120, seconds: 90, lat: 38.7095, lng: -9.1356 },
    { text: "Turn right at the river", turn: "right", metres: 1800, seconds: 1320, lat: 38.7070, lng: -9.1140 },
    { text: "At the roundabout, take the second exit", turn: "roundabout", metres: 60, seconds: 45, lat: 38.7066, lng: -9.1133 },
    { text: "Keep right to the ferry terminal", turn: "slight-right", metres: 15, seconds: 15, lat: 38.7065, lng: -9.1132 },
    { text: "You have reached the terminal", turn: "arrive", metres: 0, seconds: 0, lat: 38.7062, lng: -9.1131 },
]

let route_steps_demo_fixes = [
    { lat: 38.7139, lng: -9.1378 },     // near the start
    { lat: 38.7123, lng: -9.1374 },     // along Rua Augusta, the end 200 m on
    { lat: 38.7105, lng: -9.1370 },     // the first turn
    { lat: 38.7105, lng: -9.1370 },
    { lat: 38.7070, lng: -9.1140 },     // a long gap, past two turns
    { lat: 38.7062, lng: -9.1131 },     // the end
]

component RouteStepsDemoLive() {
    state fix = -1
    state time = "2026-11-03T14:05:00+00:00"
    state log = "none yet"
    state ended = false
    state unit = "km"
    <div.demo-stack>
        <div.demo-phone>
            <RouteSteps steps={route_steps_demo_steps} now={time} units={unit} position={fix >= 0 ? route_steps_demo_fixes[fix] : null}
                        on_step={(i) => { log = `step ${i}` }} on_arrive={() => { ended = true }}/>
        </div>
        <div.demo-row>
            <button.route-steps-demo-fix type="button" style="min-height: 44px" @click={() => { fix = min([fix + 1, 5]) }}>Next fix</button>
            <button.route-steps-demo-late type="button" style="min-height: 44px" @click={() => { time = "2026-11-03T23:50:00+00:00" }}>Leave late</button>
            <button.route-steps-demo-unit type="button" style="min-height: 44px" @click={() => { unit = unit == "km" ? "mi" : "km" }}>Units</button>
            <span.demo-note>on_step: <span class="route-steps-demo-log">{log}</span>. Arrived: <span class="route-steps-demo-ended">{ended ? "yes" : "no"}</span>.</span>
        </div>
    </div>
}

view RouteStepsDemo() = <RouteStepsDemoLive/>

ui_gallery = ui_gallery | push({ slug: "route_steps", name: "RouteSteps", group: "Mobile",
    summary: "Turn-by-turn steps with the current one large, progress, distance left and an ETA from data, moved along by a position, a swipe, buttons or keys.",
    tags: ["mobile", "interactive", "tablet", "navigation", "map", "gesture"], demo: RouteStepsDemo })
