view DiscountBadgeDemo() =
    <div.demo-stack>
        <div.demo-row>
            <DiscountBadge percent={20}/>
            <DiscountBadge amount={10}/>
            <DiscountBadge amount="€5" tone="success"/>
            <DiscountBadge amount={7.5} currency="EUR" locale="de-DE" tone="accent"/>
            <DiscountBadge label="2 for 1" tone="warning"/>
            <DiscountBadge label="Clearance" tone="neutral"/>
        </div>
        <div.demo-row>
            <DiscountBadge percent={30} variant="soft"/>
            <DiscountBadge percent={30} variant="outline"/>
            <DiscountBadge percent={30} size="sm"/>
            <DiscountBadge amount={15} variant="soft" tone="success" size="sm"/>
        </div>
        <div style="position: relative; width: 160px; height: 100px; border-radius: var(--ui-radius); background: var(--ui-subtle)">
            <DiscountBadge percent={40} corner="top-left"/>
            <DiscountBadge label="Last one" tone="neutral" variant="outline" corner="bottom-right" size="sm"/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "discount_badge", name: "DiscountBadge", group: "Commerce",
    summary: "\"−20%\" or \"Save $10\" as a small label, in tones, solid, soft or outline, or pinned to an image's corner.",
    tags: ["commerce", "price", "status", "no-js"],
    needs: ["price"], demo: DiscountBadgeDemo })
