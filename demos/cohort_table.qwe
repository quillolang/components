let cohort_table_demo_events = [
    { user: "a", date: "2026-01-05", event: "signup" }, { user: "a", date: "2026-01-13" }, { user: "a", date: "2026-01-20" }, { user: "a", date: "2026-01-21" },
    { user: "a", date: "2026-01-27" }, { user: "a", date: "2026-02-03" }, { user: "a", date: "2026-01-01" },
    { user: "b", date: "2026-01-06T09:30:00Z", event: "signup" }, { user: "b", date: "2026-01-14T23:00:00Z" },
    { user: "c", date: "2026-01-07" },
    { user: "d", date: "2026-01-11", event: "signup" }, { user: "d", date: "2026-01-12" },
    { user: "e", date: "2026-01-12" }, { user: "e", date: "2026-01-19" },
    { user: 6, date: "2026-01-15" },
    { user: "g", date: "2026-01-20" }, { user: "g", date: "2026-01-26" },
    { user: "h", date: "2026-02-02" }, { user: "h", date: "2026-02-09" },
    { user: "k", date: "2026-03-01", event: "signup" },
    { user: "z", date: "not a date" }, { user: "", date: "2026-01-10" }, "not even an event", { user: "y", date: "2026-02-30" },
]

component CohortTableDemoLive() {
    state seen = "Switch a view to see on_change."
    <div.demo-stack>
        <CohortTable id="cohort-table-demo-live" title="By month, in people" name="monthly" events={cohort_table_demo_events} today="2026-03-10" period="month" show="count"
                     on_change={(v) => { seen = `on_change: ${v.period}, ${v.show}, ${len(v.average)} periods.` }}/>
        <p.demo-note>{seen}</p>
    </div>
}

view CohortTableDemo() =
    <div.demo-stack>
        <CohortTable id="cohort-table-demo" title="Weekly retention" name="weekly" events={cohort_table_demo_events} today="2026-02-04"/>
        <CohortTableDemoLive/>
        <CohortTable id="cohort-table-demo-empty" title="Nothing yet" name="empty" events={[]} today="2026-02-04"/>
        <CohortTable id="cohort-table-demo-bad" title="A bad day" name="bad" events={cohort_table_demo_events} today="soon"/>
    </div>

ui_gallery = ui_gallery | push({ slug: "cohort_table", name: "CohortTable", group: "Dashboard",
    summary: "Signup and activity events to a retention triangle by week or month, heat-coloured, with a weighted average and unfinished periods left blank.",
    tags: ["smart", "interactive", "retention", "cohort", "analytics", "table"], demo: CohortTableDemo })
