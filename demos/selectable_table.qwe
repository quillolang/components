let selectable_table_demo_users = [
    { id: 1, name: "Ada Lovelace", email: "ada@example.com", role: "Owner", seats: 12 },
    { id: 2, name: "Grace Hopper", email: "grace@example.com", role: "Admin", seats: 4 },
    { id: 3, name: "Katherine Johnson", email: "katherine@example.com", role: "Member", seats: 1 },
    { id: 4, name: "Hedy Lamarr", email: "hedy@example.com", role: "Member", seats: 2 },
    { id: 5, name: "Margaret Hamilton", email: "margaret@example.com", role: "Admin", seats: 7 },
]

component SelectableTableDemoLive() {
    state picked = ["3"]
    <div.demo-stack>
        <SelectableTable id="selectable-table-demo-users" label="Users" name="user" rows={selectable_table_demo_users} selected={[3]}
                         columns={[{ key: "name", label: "Name" }, { key: "email", label: "Email" }, { key: "role", label: "Role" }, { key: "seats", label: "Seats", format: "number" }]}
                         on_change={(ids) => { picked = ids }}/>
        <p.demo-note>on_change: {len(picked) == 0 ? "nothing" : join(picked, ", ")}</p>
    </div>
}

view SelectableTableDemo() =
    <div.demo-stack>
        <SelectableTableDemoLive/>
        <SelectableTable id="selectable-table-demo-limit" label="Reviewers" rows={take(selectable_table_demo_users, 4)} limit={2} zebra={true}
                         columns={[{ key: "name", label: "Name" }, { key: "role", label: "Role" }]}/>
        <p.demo-note>The second table takes at most two; the rest are disabled once two are checked. Shift+click checks a range.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "selectable_table", name: "SelectableTable", group: "Data",
    summary: "Rows with checkboxes, a select-all that shows when only some are checked, a count of the selected, and hidden inputs for a form.",
    tags: ["data", "table", "forms", "interactive"], demo: SelectableTableDemo })
