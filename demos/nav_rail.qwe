let nav_rail_demo_css = css`
.demo-rail-page { padding: 18px 20px; font: 15px/1.6 var(--ui-font); }
.demo-rail-page h4 { margin: 0 0 6px; font-size: 20px; }
`

let nav_rail_demo_items = [
    { id: "inbox", label: "Inbox", icon: "M4 5h16v14H4zM4 13h5l2 2h2l2-2h5", badge: 4 },
    { id: "calls", label: "Calls", icon: "M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A15 15 0 0 1 3 6a2 2 0 0 1 2-2z", badge: 120 },
    { id: "team", label: "Team", icon: "M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM2 21a7 7 0 0 1 14 0M16 3a4 4 0 0 1 0 8M22 21a7 7 0 0 0-5-6.7", badge: true },
    { id: "files", label: "Files", icon: "M3 6h6l2 2h10v11H3z", badge: 0 },
    { id: "plans", label: "Plans", icon: "M4 4h16v16H4zM4 9h16M9 4v16", badge: "soon" },
    { id: "stats", label: "Reports", icon: "M4 20V10M10 20V4M16 20v-7M22 20H2" },
]

let nav_rail_demo_menu = [
    { id: "settings", label: "Settings", icon: "S" },
    { id: "help", label: "Help", icon: "?" },
]

component NavRailDemoLive() {
    style global nav_rail_demo_css
    state page = "Inbox"
    state drafts = 0
    <div.demo-tablet>
        <NavRail current="inbox" items={nav_rail_demo_items} menu={nav_rail_demo_menu} action={{ label: "New message", icon: "+" }}
                 on_select={(it) => { page = it.label }} on_action={() => { drafts += 1 }}>
            <div.demo-rail-page>
                <h4 id="rail-demo-page">{page}</h4>
                <p id="rail-demo-drafts">{drafts} drafts started</p>
                <p>A rail where there is room for one, and a bar along the bottom where there is not.</p>
            </div>
        </NavRail>
    </div>
}

view NavRailDemo() = <NavRailDemoLive/>

ui_gallery = ui_gallery | push({ slug: "nav_rail", name: "NavRail", group: "Mobile",
    summary: "A Material navigation rail for medium widths, with a menu, a floating action and badges, turning into a bottom bar on a phone.",
    tags: ["mobile", "tablet", "interactive", "navigation", "rail", "bar"],
    demo: NavRailDemo })
