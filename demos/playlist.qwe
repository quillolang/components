let playlist_demo_tracks = [
    { title: "Opening", artist: "Lyra", duration: 214 },
    { title: "The Quiet Part", artist: "Lyra", duration: 187 },
    { title: "Northbound", artist: "Lyra & Odd Hours", duration: 262 },
    { title: "Salt", artist: "Lyra", duration: 198 },
    { title: "Closing Time (Live)", artist: "Lyra", duration: 341 },
]

component PlaylistDemoLive() {
    state picked = null
    <div.demo-stack>
        <Playlist title="Late Night Tapes" tracks={playlist_demo_tracks} playing={1} on_pick={(i) => { picked = i }}/>
        <p.demo-note id="playlist-demo-note">{picked == null ? "Click a track." : `Picked track ${picked + 1}: ${playlist_demo_tracks[picked].title}.`}</p>
    </div>
}

view PlaylistDemo() =
    <div.demo-stack.demo-narrow style="max-width: 480px">
        <PlaylistDemoLive/>
        <Playlist title="With sounds" tracks={[
            { title: "Roar", artist: "MDN sample sounds", duration: 2, src: "https://mdn.github.io/shared-assets/audio/t-rex-roar.mp3" },
            { title: "Roar again", artist: "MDN sample sounds", duration: 2, src: "https://mdn.github.io/shared-assets/audio/t-rex-roar.mp3" },
        ]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "playlist", name: "Playlist", group: "Media",
    summary: "Numbered tracks with the one playing marked, each one's length and the total; with sources it plays them in turn.",
    tags: ["media", "audio", "list", "interactive"], demo: PlaylistDemo })
