component ChatInputDemoLive() {
    state sent = []
    state typed = 0
    <div.demo-stack>
        <ChatInput id="chat-input-demo-live" on_send={(t) => { sent = sent | push(t) }} on_typing={() => { typed += 1 }}
                   before={<button type="button" class="ui-chat-composer-send" aria-label="Attach" style="background: var(--ui-subtle); color: var(--ui-muted)">
                       <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.4 11.1l-9.2 9.2a6 6 0 0 1-8.5-8.5l9.2-9.2a4 4 0 0 1 5.7 5.7l-9.2 9.2a2 2 0 0 1-2.8-2.8l8.5-8.5"/></svg>
                   </button>}/>
        <p.demo-note>{len(sent) == 0 ? "Nothing sent yet." : `Sent: ${join(sent | map((s) => `"${s}"`), ", ")}.`}{typed > 0 ? ` Typing told ${typed} ${typed == 1 ? "time" : "times"}.` : ""}</p>
    </div>
}

view ChatInputDemo() =
    <div.demo-stack>
        <ChatInputDemoLive/>
        <p.demo-note>Enter sends, Shift+Enter starts a new line. Below, one that posts a form:</p>
        <ChatInput id="chat-input-demo-form" method="get" action="#chat_input" placeholder="Message support…" send_label="Send to support">
            <input type="hidden" name="ticket" value="77"/>
        </ChatInput>
    </div>

ui_gallery = ui_gallery | push({ slug: "chat_input", name: "ChatInput", group: "Social",
    summary: "A chat message box that grows as you type, sends on Enter and breaks the line on Shift+Enter; a plain form in a page.",
    tags: ["social", "chat", "forms", "input", "interactive"], demo: ChatInputDemo })
