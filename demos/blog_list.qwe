let blog_list_demo_pic = (a: str) =>
    `data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 320 180'%3E%3Crect width='320' height='180' fill='${a}'/%3E%3Ccircle cx='250' cy='60' r='28' fill='white' fill-opacity='.5'/%3E%3Cpath d='M0 180 L110 90 L180 140 L240 100 L320 160 V180z' fill='white' fill-opacity='.35'/%3E%3C/svg%3E`

let blog_list_demo_posts = [
    { title: "Quillo 2.0: live queries, typed records and a debugger", href: "#blog_list",
      excerpt: "The biggest release yet. A page can now follow a query as rows change, records are checked at the door, and you can step through a route.",
      date: "2026-10-14", tags: ["Release"], image: blog_list_demo_pic("%235b4bdb"), author: "Ada Lovelace", read_time: "4 min read" },
    { title: "How a page is resumed, not rebuilt", href: "#blog_list",
      excerpt: "The browser takes the server's elements as its own. Here is what that means for forms, scrolling and images.",
      date: "2026-09-02", tags: ["Engineering", "Deep dive"], image: blog_list_demo_pic("%2318794e"), author: "Grace Hopper", read_time: "9 min read" },
    { title: "One file to deploy", href: "#blog_list", excerpt: "A binary and a program, copied to a server. What we learned running it for a year.",
      date: "2026-07-21", tags: ["Ops"], image: blog_list_demo_pic("%23a35200"), author: "Margaret Hamilton" },
]

view BlogListDemo() =
    <div.demo-stack>
        <BlogList id="blog-list-demo" posts={blog_list_demo_posts} tag_href="#blog_list-tag-"/>
        <BlogList layout="rows" posts={take(blog_list_demo_posts, 2)}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "blog_list", name: "BlogList", group: "Marketing",
    summary: "Posts as cards in a grid or rows down the page: picture, tags, title, excerpt, author and date.",
    tags: ["marketing", "list", "card", "page", "no-js"],
    needs: ["avatar"],
    demo: BlogListDemo })
