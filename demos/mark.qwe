view MarkDemo() =
    <div.demo-stack>
        <p.demo-note style="color: var(--ui-fg); font-size: 15px">
            The search found <Mark id="mark-demo-default">three results</Mark> in the notes, two of them
            <Mark tone="accent">starred</Mark>.
        </p>
        <div.demo-row>
            <Mark tone="success" id="mark-demo-success">added</Mark>
            <Mark tone="warning">changed</Mark>
            <Mark tone="danger">removed</Mark>
            <Mark tone="info">note</Mark>
            <Mark tone="neutral">context</Mark>
        </div>
        <p.demo-note style="color: var(--ui-fg); font-size: 15px">
            Underlined instead: <Mark variant="underline" id="mark-demo-underline">a key term</Mark>, and
            <Mark variant="underline" tone="danger">a risk</Mark>.
        </p>
    </div>

ui_gallery = ui_gallery | push({ slug: "mark", name: "Mark", group: "Typography",
    summary: "Highlighted text in tones, as a real <mark>, filled or underlined.",
    tags: ["typography", "text", "search", "no-js"],
    demo: MarkDemo })
