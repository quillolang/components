let readability_meter_demo_text = "Good writing is clear. Short sentences help the reader. Long words slow them down. Dr. Lee tested this in 2019 with 3.5 million pages of plain text, e.g. leaflets and forms, and found that most readers lost the thread when one sentence ran on past thirty words. Keep it simple."

component ReadabilityMeterDemoLive() {
    state ease = null
    <div.demo-stack>
        <ReadabilityMeter id="readability-meter-demo-live" label="Your draft" name="draft" value="Write one idea in each sentence." rows={3} hardest={0}
                          on_change={(s) => { ease = s.ease }}/>
        <p.demo-note>{ease == null ? "Change the draft to see on_change." : `on_change: the reading ease is ${round(ease)}.`}</p>
    </div>
}

view ReadabilityMeterDemo() =
    <div.demo-stack>
        <ReadabilityMeter id="readability-meter-demo" value={readability_meter_demo_text} name="body" wpm={240} hardest={2}/>
        <ReadabilityMeterDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "readability_meter", name: "ReadabilityMeter", group: "Blogging",
    summary: "Live Flesch reading ease and grade, counts, reading time and the hardest sentences, and it says so when a text cannot be scored.",
    tags: ["smart", "interactive", "readability", "writing", "flesch", "text"], demo: ReadabilityMeterDemo })
