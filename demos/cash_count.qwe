component CashCountDemoLive() {
    state note = "Change something to see on_change."
    <div.demo-stack>
        <CashCount id="cash-count-demo-live" name="till" title="A short set of coins" denominations={["0.40", "0.30", "0.10"]} counts={[1, 3, 0]} expected="1.30" change="0.60"
                   on_change={(c) => { note = `on_change: ${c.total} is ${c.status ?? "unchecked"}, ${c.pieces == null ? "no change" : `${len(c.pieces)} kinds of piece`}.` }}/>
        <p.demo-note>{note}</p>
    </div>
}

view CashCountDemo() =
    <div.demo-stack>
        <CashCount id="cash-count-demo" counts={[0, 1, 3, 5, 4, 20, 12, 10, 8, 30]} expected="205.00" change="0.30"/>
        <CashCountDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "cash_count", name: "CashCount", group: "Finance",
    summary: "Counts a drawer by notes and coins to a total and an over or short variance, and makes change in the fewest pieces from what is in it.",
    tags: ["smart", "interactive", "finance", "cash", "till", "change"], demo: CashCountDemo })
