component DataListDemoLive() {
    state invoices = [
        { id: "inv-1041", title: "Invoice #1041", icon_text: "PDF", meta: ["Northwind Traders", "$1,240.50", "Due Nov 4"], badge: "Overdue", badge_tone: "danger",
          actions: [{ label: "Remind", key: "remind" }, { label: "Void", key: "void", tone: "danger" }] },
        { id: "inv-1042", title: "Invoice #1042", icon_text: "PDF", meta: ["Acme Corp", "$310.00", "Due Nov 18"], badge: "Open", badge_tone: "info",
          actions: [{ label: "Remind", key: "remind" }, { label: "Void", key: "void", tone: "danger" }] },
    ]
    state last = "nothing yet"
    <div.demo-stack>
        <DataList id="data-list-demo-invoices" label="Invoices" items={invoices} empty="No invoices left."
                  on_action={(rid, key) => {
                      last = `${key} ${rid}`
                      if key == "void" { invoices = invoices | filter((x) => x.id != rid) }
                  }}/>
        <p.demo-note>on_action: {last}.</p>
    </div>
}

view DataListDemo() =
    <div.demo-stack>
        <DataList id="data-list-demo-projects" label="Projects" items={[
            { id: "p1", title: "Website redesign", href: "#p1", meta: ["Design", "Due Nov 4", "6 tasks"], badge: "On track", badge_tone: "success",
              description: "New home page, pricing and docs layout.", actions: [{ label: "Open", href: "#p1" }] },
            { id: "p2", title: "Billing migration", href: "#p2", meta: ["Engineering", "Due Dec 1", "14 tasks"], badge: "At risk", badge_tone: "warning",
              actions: [{ label: "Open", href: "#p2" }] },
            { id: "p3", title: "Hiring: support lead", meta: ["People", "No due date"] },
        ]}/>
        <DataListDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "data_list", name: "DataList", group: "Data",
    summary: "Records as rows with a title, a line of facts, a status badge and actions as links or buttons.",
    tags: ["data", "list", "record"], demo: DataListDemo })
