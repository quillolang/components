let risk_matrix_demo_risks = [
    { id: "breach", title: "Customer data breach", owner: "Ana", likelihood: 3, impact: 5, mitigated_likelihood: 2, mitigated_impact: 4 },
    { id: "outage", title: "Cloud region outage", owner: "Ben", likelihood: 4, impact: 4, mitigated_likelihood: 3, mitigated_impact: 3 },
    { id: "vendor", title: "Key vendor fails", owner: "Chi", likelihood: 2, impact: 4 },
    { id: "churn", title: "Lead engineer leaves", owner: "Dee", likelihood: 3, impact: 3, mitigated_likelihood: 4, mitigated_impact: 3 },
    { id: "fx", title: "Exchange rate swing", owner: "Eli", likelihood: 5, impact: 1, mitigated_likelihood: 5, mitigated_impact: 1 },
    { id: "flood", title: "Office flood", owner: "Ana", likelihood: 9, impact: 2 },
]

component RiskMatrixDemoLive() {
    state seen = "Move a risk to see on_change."
    <div.demo-stack>
        <RiskMatrix id="risk-matrix-demo-live" title="Launch risks" name="launch" bands={[{ name: "Accept", upto: 8 }, { name: "Act", upto: 25 }]}
                    risks={[{ id: "late", title: "Launch slips", likelihood: 2, impact: 2 }]}
                    on_change={(rows) => { seen = `on_change: ${rows[0].title} scores ${rows[0].score}, ${rows[0].band}.` }}/>
        <p.demo-note>{seen}</p>
    </div>
}

view RiskMatrixDemo() =
    <div.demo-stack>
        <RiskMatrix id="risk-matrix-demo" title="Operational risks" risks={risk_matrix_demo_risks}/>
        <RiskMatrixDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "risk_matrix", name: "RiskMatrix", group: "Dashboard",
    summary: "Risks on a 5 by 5 heat grid with keyboard placement: score, band, the mitigated position beside the inherent one, a sorted register, and a filter by cell.",
    tags: ["smart", "interactive", "risk", "heatmap", "register", "keyboard"], demo: RiskMatrixDemo })
