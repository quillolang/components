view ShortcutsDialogDemo() =
    <div.demo-stack>
        <div.demo-row>
            <ShortcutsDialog groups={[
                { title: "General", shortcuts: [
                    { keys: "Ctrl K", label: "Open the command palette" }, { keys: "?", label: "Show these shortcuts" },
                    { keys: "Ctrl Shift P", label: "Switch project" }, { keys: "Esc", label: "Close a dialog" },
                ] },
                { title: "Inbox", shortcuts: [
                    { keys: "J", label: "Next message" }, { keys: "K", label: "Previous message" },
                    { keys: "E", label: "Archive" }, { keys: "G then I", label: "Go to the inbox" },
                ] },
                { title: "Editing", shortcuts: [
                    { keys: "Ctrl B", label: "Bold" }, { keys: "Ctrl I", label: "Italic" }, { keys: "Ctrl Z", label: "Undo" },
                ] },
            ]}/>
        </div>
        <p.demo-note>Press ? anywhere on the page (outside a text box) to open it.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "shortcuts_dialog", name: "ShortcutsDialog", group: "Overlays",
    summary: "A dialog listing the page's keyboard shortcuts in groups, opened with ?, with a box to filter them.",
    tags: ["dialog", "keyboard", "accessibility", "interactive"],
    demo: ShortcutsDialogDemo })
