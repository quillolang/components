let swipe_kanban_demo_columns = [{ id: "todo", title: "To do" }, { id: "doing", title: "Doing" }, { id: "review", title: "Review" }, { id: "done", title: "Done" }]
let swipe_kanban_demo_cards = [
    { id: 1, column: "todo", title: "Write the brief", note: "For Friday", tone: "danger" },
    { id: 2, column: "todo", title: "Book the room" },
    { id: 3, column: "todo", title: "Order lunch", tone: "info" },
    { id: 4, column: "doing", title: "Fix the login page", tone: "warning" },
    { id: 5, column: "doing", title: "Draft the newsletter" },
    { id: 6, column: "done", title: "Renew the domain", tone: "success" },
]

component SwipeKanbanDemoLive() {
    state log = ""
    state refuse = false
    <div.demo-stack>
        <div.demo-phone id="swipe-kanban-screen">
            <SwipeKanban columns={swipe_kanban_demo_columns} cards={swipe_kanban_demo_cards} label="Team board" edge_ms={300}
                         on_move={(id, col, at) => { log = `move ${id} ${col} ${at}`; !refuse }} on_open={(c) => { log = `open ${c.id}` }}/>
        </div>
        <p.demo-note id="swipe-kanban-log">{log}</p>
        <button id="swipe-kanban-refuse" type="button" hidden="true" @click={() => { refuse = !refuse }}>Refuse</button>
        <div id="swipe-kanban-bad" hidden="true"><SwipeKanban columns={[null, { id: "a" }, { id: "a", title: "Twice" }]} cards={[null, { id: 1 }, { id: 2, title: "Lost", column: "nowhere" }, { id: 2, title: "Again" }]}/><SwipeKanban columns="none" cards="none"/></div>
    </div>
}

view SwipeKanbanDemo() = <div.demo-stack><SwipeKanbanDemoLive/></div>

ui_gallery = ui_gallery | push({ slug: "swipe_kanban", name: "SwipeKanban", group: "Mobile",
    summary: "Columns swiped by page, cards moved to a neighbour by drag near the edge, or from a menu.",
    tags: ["mobile", "interactive", "gesture", "kanban", "drag", "tablet"],
    demo: SwipeKanbanDemo })
