let trip_budget_demo_items = [
    { label: "Flights", amount: 420, basis: "person", category: "Transport" },
    { label: "Hotel", amount: 135, currency: "EUR", basis: "night", category: "Stay" },
    { label: "Food", amount: 30, currency: "EUR", basis: "person_day", category: "Food" },
    { label: "Rail pass", amount: 15000, currency: "JPY", basis: "person", category: "Transport" },
    { label: "Museum", amount: "18.50", currency: "GBP", basis: "person", category: "Activities" },
]

component TripBudgetDemoLive() {
    state seen = null
    <div.demo-stack>
        <TripBudget id="trip-budget-demo-weekend" title="A weekend, with a cost in no known currency" name="weekend" home="EUR" rates={{ USD: "0.92", XYZ: 2, GBP: -1 }} people={1} nights={2}
                    budget={100} items={[{ label: "Room", amount: 50, basis: "night", category: "Stay" }, { label: "Tuk-tuk", amount: 300, currency: "THB", category: "Transport" }]}
                    on_change={(f) => { seen = f }}/>
        <p.demo-note>{seen == null ? "Change it to see on_change." : `on_change: the total is ${str(seen.total.amount)}.`}</p>
    </div>
}

view TripBudgetDemo() =
    <div.demo-stack>
        <TripBudget id="trip-budget-demo" title="Five days, three people" home="USD" rates={{ EUR: 1.08, JPY: "0.0067", GBP: 1.27 }} rates_note="As given on 1 November." people={3} nights={4} budget={3000}
                    items={trip_budget_demo_items} limits={{ Transport: 1500, Food: 600 }} locale="en-US"/>
        <TripBudgetDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "trip_budget", name: "TripBudget", group: "Travel",
    summary: "Adds up costs per person, night and day in several currencies from rates given as data: a total at home, a split to the cent, what is over budget, and a daily allowance.",
    tags: ["smart", "interactive", "travel", "budget", "currency", "calculator"], demo: TripBudgetDemo })
