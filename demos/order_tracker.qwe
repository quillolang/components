view OrderTrackerDemo() =
    <div.demo-stack style="gap: 32px">
        <OrderTracker current={2} eta="2026-11-05" carrier="DHL" tracking="JD014600003828" tracking_href="#order_tracker"
                      steps={[{ label: "Ordered", at: "2026-11-02T09:12:00Z" }, { label: "Shipped", at: "2026-11-03T16:40:00Z", hint: "Left the warehouse in Leeds" },
                              { label: "Out for delivery", at: "2026-11-05T07:30:00Z" }, { label: "Delivered" }]}/>
        <div.demo-row style="gap: 48px; align-items: flex-start">
            <OrderTracker vertical={true} current={4} locale="en-US"
                          steps={[{ label: "Ordered", at: "2026-10-20" }, { label: "Shipped", at: "2026-10-21" }, { label: "Out for delivery", at: "2026-10-23" },
                                  { label: "Delivered", at: "2026-10-23T14:05:00Z", hint: "Signed for by R. Cole" }]}/>
            <OrderTracker vertical={true} current={1} cancelled={true} carrier="Royal Mail"
                          steps={[{ label: "Ordered", at: "2026-10-25" }, { label: "Shipped" }, { label: "Delivered" }]}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "order_tracker", name: "OrderTracker", group: "Commerce",
    summary: "Ordered → shipped → out for delivery → delivered, with when each happened, the expected date and the tracking link.",
    tags: ["commerce", "status", "progress", "time", "no-js"], demo: OrderTrackerDemo })
