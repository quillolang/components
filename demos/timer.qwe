component TimerDemoLive() {
    state ended = 0
    state log = []
    <div.demo-stack>
        <Timer id="timer-demo-short" seconds={2} label="Tea" presets={[]} done="Tea is ready"
               on_end={() => { ended += 1 }} on_start={() => { log = log | push("start") }} on_pause={() => { log = log | push("pause") }}/>
        <p.demo-note>{ended == 0 ? "Not ended yet." : `on_end called ${ended} ${ended == 1 ? "time" : "times"}.`} {join(log, " · ")}</p>
    </div>
}

view TimerDemo() =
    <div.demo-row style="align-items: flex-start">
        <div style="flex: 1 1 260px"><TimerDemoLive/></div>
        <div style="flex: 1 1 300px" id="timer-demo-focus"><Timer id="timer-demo-pomodoro" minutes={25} label="Focus"/></div>
    </div>

ui_gallery = ui_gallery | push({ slug: "timer", name: "Timer", group: "Scheduling",
    summary: "A countdown set in minutes with Start, Pause and Reset, a ring that empties, presets, and a silent alert at zero.",
    tags: ["schedule", "time", "clock", "progress", "interactive"], demo: TimerDemo })
