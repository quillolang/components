component GalleryPickerDemoLive() {
    state got = []
    state shown = true
    <div.demo-stack>
        {shown && <form.demo-stack method="post" action="/" enctype="multipart/form-data">
            <GalleryPicker name="photos" limit={4} max_size={200000} on_change={(list) => { got = list }}/>
        </form>}
        <p.demo-note id="gallery-picker-demo-note" style="overflow-wrap: anywhere">{len(got) == 0 ? "None picked." : `In this order: ${join(got | map((p) => p.name), ", ")}`}</p>
        <Button size="lg" variant="ghost" tone="neutral" on_click={() => { shown = !shown }}>{shown ? "Leave the page" : "Come back"}</Button>
    </div>
}

view GalleryPickerDemo() =
    <div.demo-stack>
        <GalleryPickerDemoLive/>
        <p.demo-note>Four photos of up to 195 KB in this example. Drag a photo by its grip, or use the arrows under it.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "gallery_picker", name: "GalleryPicker", group: "Mobile",
    summary: "Picks several photos through the system's picker, with thumbnails, an order, caps by count and size, HEIC refused with a reason, and previews freed after.",
    tags: ["mobile", "interactive", "photo", "gallery", "upload", "forms"], demo: GalleryPickerDemo })
