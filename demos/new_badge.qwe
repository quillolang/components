view NewBadgeDemo() =
    <div.demo-stack>
        <div.demo-row style="gap: 20px">
            <span>Reports <NewBadge id="new-badge-demo-plain" label="Reports"/></span>
            <span>Workflows <NewBadge id="new-badge-demo-beta" text="Beta" tone="info" variant="soft"/></span>
            <span>Exports <NewBadge text="Updated" tone="success" variant="outline" size="sm"/></span>
            <span>Billing <NewBadge tone="neutral" text="Soon"/></span>
        </div>
        <div.demo-row style="gap: 20px">
            <span id="new-badge-demo-future">Launching next year <NewBadge until="2099-01-01"/></span>
            <span id="new-badge-demo-past">Was new in 2024 <NewBadge until="2024-12-31"/></span>
            <span id="new-badge-demo-later">Not until 2099 <NewBadge from="2099-01-01"/></span>
        </div>
        <p.demo-note>The last two render nothing: one is past its date, one is before its date.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "new_badge", name: "NewBadge", group: "Feedback",
    summary: "A small New, Beta or Updated label beside an item, in tones and variants, that stops showing after a date.",
    tags: ["feedback", "status", "marketing", "no-js"],
    demo: NewBadgeDemo })
