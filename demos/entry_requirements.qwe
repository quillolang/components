view EntryRequirementsDemo() =
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 12px; align-items: start">
        <EntryRequirements id="entry-requirements-demo-jp" destination="Japan" flag="🇯🇵" nationality="United Kingdom" visa="free"
                           stay="Up to 90 days" passport="Valid for the whole stay"
                           documents={[{ label: "Visit Japan Web QR codes", note: "Fill in before you land: immigration and customs" },
                                       { label: "Return or onward ticket", required: true }]}
                           health={[{ label: "Travel insurance", note: "Japanese hospitals may ask for payment up front" }]}
                           source={{ label: "Ministry of Foreign Affairs of Japan", href: "#mofa" }} checked="28 Oct 2026"/>
        <EntryRequirements id="entry-requirements-demo-us" destination="United States" flag="🇺🇸" nationality="Portugal" visa="eta"
                           visa_name="ESTA" visa_note="Apply at least 72 hours before you fly; it lasts two years." visa_href="#esta" fee="$21"
                           stay="Up to 90 days" passport="An e-passport, valid for the whole stay"
                           documents={[{ label: "Approved ESTA", required: true, href: "#esta" }, { label: "Return ticket", required: true }]}
                           warnings={["Overstaying once means a visa for every later visit."]}/>
        <EntryRequirements id="entry-requirements-demo-in" destination="India" nationality="Canada" purpose="Business" visa="required"
                           visa_name="Business visa" fee="CA$ 125" passport="6 months beyond arrival, 2 blank pages"
                           health={[{ label: "Yellow fever certificate", required: true, note: "Only when arriving from a country with yellow fever" }]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "entry_requirements", name: "EntryRequirements", group: "Travel",
    summary: "Visa and entry rules for a passport: visa-free, travel authorisation, eVisa or visa required, the stay allowed, passport validity, documents and health rules.",
    tags: ["travel", "documents", "status", "list", "no-js"], demo: EntryRequirementsDemo })
