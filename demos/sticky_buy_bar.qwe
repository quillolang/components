component StickyBuyBarDemoLive() {
    state bought = 0
    <div.demo-tablet>
        <div id="sticky-demo-page" style="height: 100%; overflow: auto; padding: 16px; box-sizing: border-box; overscroll-behavior: contain">
            <h3 style="margin: 0 0 4px">Trail boots</h3>
            <p.demo-note>Waterproof leather with a grippy sole, made to last. Bought {bought} so far.</p>
            <p style="margin: 12px 0"><Button id="sticky-demo-buy" size="lg" on_click={() => { bought += 1 }}>Buy now</Button></p>
            <div style="height: 760px; display: grid; align-content: space-between; color: var(--ui-muted)">
                <p>Scroll down: when the button above is gone, the bar rises.</p>
                <p>Details, sizing and reviews go here.</p>
            </div>
            <label for="sticky-demo-note" style="display: grid; gap: 4px">Gift note
                <input id="sticky-demo-note" style="height: 46px; font-size: 16px; box-sizing: border-box" placeholder="Touch to type"/>
            </label>
            <div style="height: 320px"></div>
        </div>
        <StickyBuyBar watch="sticky-demo-buy" name="Trail boots, waterproof leather" price={dec("129.00")} old={dec("149.00")} on_buy={() => { bought += 1 }}/>
    </div>
}

view StickyBuyBarDemo() = <StickyBuyBarDemoLive/>

ui_gallery = ui_gallery | push({ slug: "sticky_buy_bar", name: "StickyBuyBar", group: "Mobile",
    summary: "Price and Buy stuck above the safe area once the page's button scrolls away, hiding near the on-screen keyboard.",
    tags: ["mobile", "interactive", "commerce", "sticky", "buy"],
    needs: ["price"],
    demo: StickyBuyBarDemo })
