// Sixty-one points that rise by one, so every reading below can be worked out by hand.
let touch_chart_demo_exact = for i in range(0, 61) => { label: `D${i}`, value: 100 + i }

let touch_chart_demo_year = for i in range(0, 180) => {
    label: date.format(date.add_days("2026-05-01", i), "D MMM"),
    value: round(120 + i * 0.4 + 18 * math.sin(i / 9) + 6 * math.sin(i * 1.7), 1),
}

let touch_chart_demo_long = for i in range(0, 5000) => i == 2345 ? 100 : i % 2

component TouchChartDemoLive() {
    state said = "Nothing chosen."
    state range_said = "All."
    state stir = 0
    <div.demo-stack>
        <div id="touch-chart-exact"><TouchChart title="Worked by hand" points={touch_chart_demo_exact | map((p) => { ...p, stir })} prefix="$" digits={2}
            ranges={[{ label: "Last 10", count: 10 }, { label: "All", count: 0 }]}
            on_select={(i) => { said = i == null ? "Cleared." : `${i.index} ${i.label} ${i.value}` }} on_range={(a, b) => { range_said = `${a} to ${b}` }}/></div>
        <p.demo-note id="touch-chart-said">{said}</p>
        <p.demo-note id="touch-chart-range">{range_said}</p>
        <div.demo-row><Button id="touch-chart-stir" size="lg" variant="soft" on_click={() => { stir += 1 }}>New data arrives</Button></div>
    </div>
}

view TouchChartDemo() =
    <div.demo-stack>
        <TouchChartDemoLive/>
        <div id="touch-chart-season"><TouchChart title="Daily active people" unit="k" points={touch_chart_demo_year}
            ranges={[{ label: "30 days", count: 30 }, { label: "90 days", count: 90 }, { label: "All", count: 0 }]}/></div>
        <div id="touch-chart-holes"><TouchChart title="With holes" points={[5, 6, "broken", null, 7, null, 8, 9]} least={2}/></div>
        <div id="touch-chart-long"><TouchChart title="Five thousand points and a spike" points={touch_chart_demo_long}/></div>
        <div id="touch-chart-none"><TouchChart title="Nothing" points="none"/></div>
    </div>

ui_gallery = ui_gallery | push({ slug: "touch_chart", name: "TouchChart", group: "Mobile",
    summary: "A line chart read by finger with a crosshair and value, pinched to a range, with buttons, keys and a table to the same places.",
    tags: ["mobile", "interactive", "chart", "gesture", "pinch", "tablet"],
    demo: TouchChartDemo })
