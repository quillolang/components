// A book that moves: each tick of a seeded random walk (Park–Miller) changes a few
// levels' sizes and now and then moves the mid by a cent, the same on every run.
fn order_book_demo_book(seed: int, mid: num) -> map {
    let s = seed
    let rnd = () => {
        s = s * 16807 % 2147483647
        s / 2147483647
    }
    let level = (k) => round((40 + rnd() * 400) * (1 + k * 0.08))
    {
        bids: for k in range(40) => { price: round((mid - 0.01 - k * 0.01) * 100) / 100, size: level(k) },
        asks: for k in range(40) => { price: round((mid + 0.01 + k * 0.01) * 100) / 100, size: level(k) },
    }
}

fn order_book_demo_tick(book: map, n: int) -> map {
    let s = (n * n * 7919 + n * 104729 + 7) % 2147483647
    let rnd = () => {
        s = s * 16807 % 2147483647
        s / 2147483647
    }
    let picks = for _ in range(4) => floor(rnd() * 6)
    let change = (side: list) => for [k, l] in enumerate(side) =>
        index_of(picks, k) != null ? { price: l.price, size: round(l.size * (0.6 + rnd() * 0.8)) + 1 } : l
    { bids: change(book.bids), asks: change(book.asks) }
}

component OrderBookDemoLive() {
    state book = order_book_demo_book(9, 182.4)
    state n = 0
    state live = true
    state step = 0.01
    if live {
        every(900, () => {
            n += 1
            book = order_book_demo_tick(book, n)
        })
    }
    <div.demo-stack id="order_book-demo-live">
        <OrderBook label="ACME" bids={book.bids} asks={book.asks} groups={[0.01, 0.05, 0.1]} depth={8} prefix="$"
                   on_group={(g) => { step = g }}/>
        <p.demo-note>Grouped by ${step}; a few levels change every 0.9 s ({n} so far) and flash.</p>
        <div.demo-row>
            <Button size="sm" variant="outline" id="order_book-demo-toggle" on_click={() => { live = !live }}>{live ? "Stop the feed" : "Start the feed"}</Button>
        </div>
    </div>
}

view OrderBookDemo() =
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px">
        <OrderBookDemoLive/>
        <div id="order_book-demo-still">
            <OrderBook label="BTC-USD" groups={[0.5, 1, 10]} depth={5} unit=" BTC" decimals={1}
                       bids={[{ price: 61249.5, size: 0.42 }, { price: 61249, size: 1.1 }, { price: 61248.5, size: 0.25 },
                              { price: 61241, size: 3.5 }, { price: 61238, size: 0.9 }, { price: 61230, size: 2 }]}
                       asks={[{ price: 61250.5, size: 0.3 }, { price: 61251, size: 0.75 }, { price: 61252.5, size: 1.6 },
                              { price: 61259, size: 4.2 }, { price: 61263, size: 0.5 }, { price: 61270, size: 1 }]}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "order_book", name: "OrderBook", group: "Charts",
    summary: "An order book's bid and ask ladders with size bars, the spread and mid price, grouping into coarser steps, and levels that flash as they change.",
    tags: ["data", "trading", "table", "interactive"],
    demo: OrderBookDemo })
