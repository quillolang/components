let meter_reading_demo_meters = [
    { id: "w1", name: "Water main", location: "Basement, behind the pump", unit: "m³", last: "1234.5", last_on: "2026-10-03", daily: "2.5", decimals: 1, digits: 6 },
    { id: "e1", name: "Power, floor 2", location: "Riser cupboard", unit: "kWh", last: "999980", last_on: "2026-10-03", daily: "4", digits: 6 },
    { id: "g1", name: "Gas", location: "Yard", unit: "m³", last: "560", last_on: "2026-10-03", daily: "1", decimals: 0 },
    { id: "p1", name: "Boiler pressure", location: "Plant room", unit: "bar", kind: "gauge", last: "1.4", low: "0.8", high: "2.5", jump: "0.5" },
]

component MeterReadingDemoLive() {
    state said = "Nothing yet."
    state last = ""
    <div.demo-stack>
        <MeterReading title="Riverside Flats round" today="2026-11-02" meters={meter_reading_demo_meters} job="Riverside Flats"
                      on_reading={(r) => { last = `${r.meter} ${r.value} ${r.status} ${r.code} used ${r.used}` }}
                      on_finish={(rs) => { said = `Finished: ${len(rs)} readings` }}/>
        <p.demo-note id="mread-demo-last">{last}</p>
        <p.demo-note id="mread-demo-said">{said}</p>
    </div>
}

view MeterReadingDemo() = <MeterReadingDemoLive/>

ui_gallery = ui_gallery | push({ slug: "meter_reading", name: "MeterReading", group: "Mobile",
    summary: "A round of meter readings on a big keypad, each checked against the last value and a sane range, with a photo on anything odd.",
    tags: ["mobile", "interactive", "field", "keypad", "gloves", "tablet"],
    needs: ["photo_evidence"],
    demo: MeterReadingDemo })
