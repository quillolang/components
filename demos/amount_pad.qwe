component AmountPadDemoLive() {
    state amount = ""
    state paid = ""
    <div.demo-stack>
        <div id="amount-pad-demo-usd">
            <AmountPad label="Send" currency="USD" least="1" most="5000" name="send" done_label="Send money"
                       on_change={(a) => { amount = a }} on_done={(a) => { paid = a }}/>
        </div>
        <p.demo-note id="amount-pad-demo-out">Amount: {amount == "" ? "none" : amount}{paid != "" && `; sent ${paid}`}</p>
    </div>
}

view AmountPadDemo() =
    <div.demo-stack>
        <AmountPadDemoLive/>
        <div id="amount-pad-demo-jpy">
            <p.demo-note>Yen have no decimals, so there is no 00 key:</p>
            <AmountPad label="Tip" currency="JPY" locale="ja-JP" value="1200" most="50000"/>
        </div>
        <div id="amount-pad-demo-kwd">
            <p.demo-note>Kuwaiti dinars have three decimals:</p>
            <AmountPad label="Fee" currency="KWD" value="1.5"/>
        </div>
        <div id="amount-pad-demo-odd">
            <p.demo-note>A currency Quillo does not know, and a value that is not an amount:</p>
            <AmountPad label="Points" currency="XQQ" value="twelve"/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "amount_pad", name: "AmountPad", group: "Mobile",
    summary: "Big amount entry for money: digits fill from the right, currency rules for decimals, limits, a shake on a refused key.",
    tags: ["mobile", "interactive", "money", "keypad", "amount", "finance"], needs: ["number_pad"],
    demo: AmountPadDemo })
