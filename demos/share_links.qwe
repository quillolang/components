view ShareLinksDemo() =
    <div.demo-stack>
        <ShareLinks id="share-links-demo" url="https://blog.example.com/islands-resumed" title="Islands, resumed: how a page wakes up"
                    via="quillolang"/>
        <ShareLinks id="share-links-demo-labels" url="https://blog.example.com/islands-resumed" title="Islands, resumed"
                    text="Worth a read, on resuming pages:" networks={["mastodon", "bluesky", "hackernews", "whatsapp", "telegram", "email"]}
                    mastodon="hachyderm.io" show_labels={true} variant="soft" size="sm" label="Share"/>
        <ShareLinks id="share-links-demo-side" url="https://blog.example.com/islands-resumed" title="Islands, resumed" label=""
                    variant="ghost" layout="column" networks={["x", "linkedin", "email"]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "share_links", name: "ShareLinks", group: "Blogging",
    summary: "Links that share a post on X, Bluesky, Mastodon, LinkedIn, Reddit, Hacker News and more, or by email: plain links, nothing loaded from the networks.",
    tags: ["blogging", "social", "share", "links", "no-js"], demo: ShareLinksDemo })
