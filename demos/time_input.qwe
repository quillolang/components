component TimeInputDemoLive() {
    state picked = "18:30"
    <div.demo-stack>
        <TimeInput name="ti-demo-pickup" label="Pick-up time" value="18:30" hour12={true} step={15}
                   min="08:00" max="20:00" hint="Between 8 AM and 8 PM, every 15 minutes."
                   on_change={(t) => { picked = t ?? "" }}/>
        <p.demo-note>{picked != "" ? `The form sends ${picked}.` : "Not complete yet."}</p>
    </div>
}

view TimeInputDemo() =
    <div.demo-stack>
        <div.demo-row>
            <TimeInput name="ti-demo-start" label="Starts at" value="09:30" required={true}/>
            <TimeInput name="ti-demo-end" label="Ends at"/>
        </div>
        <TimeInputDemoLive/>
        <TimeInput name="ti-demo-alarm" label="Alarm" value="07:00" size="sm" error="That is before the first train."/>
    </div>

ui_gallery = ui_gallery | push({ slug: "time_input", name: "TimeInput", group: "Forms",
    summary: "A time in parts (hours, minutes, AM/PM) changed with the arrow keys or by typing.",
    demo: TimeInputDemo })
