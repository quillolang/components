fn photo_grid_select_demo_pic(fill: str, n: int) =
    "data:image/svg+xml," + url_encode(`<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' fill='${fill}'/><text x='50' y='60' font-size='28' text-anchor='middle' fill='#fff' font-family='sans-serif'>${n}</text></svg>`)

let photo_grid_select_demo_fills = ["#3d5a80", "#ee6c4d", "#6d8f71", "#7a5195", "#98c1d9", "#293241", "#bc5090", "#ef5675"]

fn photo_grid_select_demo_month(key: str, from_n: int, count: int) -> list =
    range(count) | map((i) => { id: from_n + i, src: photo_grid_select_demo_pic(photo_grid_select_demo_fills[(from_n + i) % 8], from_n + i), alt: `Photo ${from_n + i}`, at: `${key}-${i < 9 ? "0" : ""}${i + 1}` })

let photo_grid_select_demo_photos = flatten([
    photo_grid_select_demo_month("2026-08", 1, 14),
    photo_grid_select_demo_month("2026-10", 100, 18),
    photo_grid_select_demo_month("2026-09", 200, 40),
    [{ id: "x", src: photo_grid_select_demo_pic("#111111", 0), alt: "An old scan", at: "someday" }, { id: "nosrc", at: "2026-10-01" }, 7],
])

component PhotoGridSelectDemoLive() {
    state picked = []
    state opened = "none"
    state back = null
    state given = []
    <div.demo-stack>
        <div.demo-phone style="--ui-pgsel-height: 100%">
            <PhotoGridSelect photos={photo_grid_select_demo_photos} selected={given} reveal={back}
                             on_change={(ids) => { picked = ids }} on_open={(p, i) => { opened = `${p.id} at ${i}` }}/>
        </div>
        <p.demo-note id="pgsel-demo-note">Picked {join(picked | map((x) => `${x}`), " ")}; opened {opened}</p>
        <div.demo-row>
            <Button id="pgsel-demo-give" size="lg" variant="ghost" on_click={() => { given = [100, 101] }}>Pick two from the page</Button>
            <Button id="pgsel-demo-reveal" size="lg" variant="ghost" on_click={() => { back = 230 }}>Come back to 230</Button>
        </div>
    </div>
}

view PhotoGridSelectDemo() = <PhotoGridSelectDemoLive/>

ui_gallery = ui_gallery | push({ slug: "photo_grid_select", name: "PhotoGridSelect", group: "Mobile",
    summary: "A tight square grid of photos with a run of the finger to pick many, a count, and month headers.",
    tags: ["mobile", "interactive", "photos", "grid", "selection", "tablet"],
    demo: PhotoGridSelectDemo })
