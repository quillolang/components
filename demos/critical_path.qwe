component CriticalPathDemoLive() {
    state done = null
    <div.demo-stack>
        <CriticalPath id="critical-path-demo-live" title="Fit-out, editing the list" name="fitout" start="2026-11-27" weekends={true}
                      tasks={[{ id: "1", name: "Strip out", days: 2 }, { id: "2", name: "Wiring", days: 3, deps: ["1"] }, { id: "3", name: "Paint", days: 1, deps: ["2"] }]}
                      on_change={(p) => { done = p.finish }}/>
        <p.demo-note>{done == null ? "Change a figure to see on_change." : `on_change: it finishes on ${done}.`}</p>
    </div>
}

view CriticalPathDemo() =
    <div.demo-stack>
        <CriticalPath id="critical-path-demo" start="2026-11-02" holidays={["2026-11-11"]}
                      tasks={[{ id: "A", name: "Design", days: 3 }, { id: "B", name: "Build", days: 5, deps: ["A"] },
                              { id: "C", name: "Docs", days: 2, deps: ["A"] }, { id: "D", name: "Test", days: 4, deps: ["B"] },
                              { id: "E", name: "Launch", days: 1, deps: ["C", "D"] }]}/>
        <CriticalPathDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "critical_path", name: "CriticalPath", group: "Scheduling",
    summary: "Runs the forward and backward passes over tasks and dependencies: slack, the critical path and real dates with weekends off, naming cycles and missing tasks.",
    tags: ["smart", "interactive", "planning", "projects", "dependencies", "dates"], demo: CriticalPathDemo })
