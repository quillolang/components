let notification_list_demo_items = [
    { id: 1, title: "Grace Hopper commented on Q3 report", text: "“Looks good, one question on page 4.”", time: "2026-10-28T09:12:00Z",
      actor: { name: "Grace Hopper", src: "https://i.pravatar.cc/64?img=47" }, href: "#notification_list",
      actions: [{ label: "Reply", href: "#notification_list" }, { label: "Open report", href: "#notification_list" }] },
    { id: 2, title: "@ada mentioned you in #design", kind: "mention", time: "2026-10-28T08:05:00Z" },
    { id: 3, title: "Your export is ready", text: "orders-2026-10.csv, 2.4 MB", kind: "success", time: "2026-10-27T18:40:00Z", read: true },
    { id: 4, title: "Card ending 4242 expires next month", kind: "warning", time: "2026-10-27T07:00:00Z" },
    { id: 5, title: "Sign-in from a new device", text: "Chrome on Windows, Lisbon", kind: "danger", time: "2026-10-20T22:31:00Z", read: true },
]

component NotificationListDemoLive() {
    state items = notification_list_demo_items
    state last = "Nothing done yet."
    <div.demo-stack>
        <NotificationList id="nl-live" today="2026-10-28" items={items}
                          on_read={(nid) => { items = items | map((n) => n.id == nid ? set(n, "read", true) : n); last = `Read ${nid}.` }}
                          on_dismiss={(nid) => { items = items | filter((n) => n.id != nid); last = `Dismissed ${nid}.` }}
                          on_read_all={() => { items = items | map((n) => set(n, "read", true)); last = "All read." }}/>
        <p.demo-note>{last}</p>
    </div>
}

view NotificationListDemo() =
    <div.demo-stack>
        <NotificationListDemoLive/>
        <form method="post" action="/notifications" style="max-width: 520px">
            <NotificationList id="nl-form" title="Alerts" items={take(notification_list_demo_items, 2)}/>
        </form>
        <NotificationList id="nl-empty" title="Mentions" items={[]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "notification_list", name: "NotificationList", group: "Data",
    summary: "Notifications grouped by day (Today, Yesterday, then dates), read or unread, with links, mark-read and dismiss buttons and Mark all as read.",
    tags: ["notification", "list", "status", "no-js"],
    needs: ["avatar"],
    demo: NotificationListDemo })
