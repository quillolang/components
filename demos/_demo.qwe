// What every demo shares: the list they add themselves to, and the layout
// classes they use. (scripts/build.sh puts this first in demos.qwe.)

let ui_gallery = []

let demo_css = css`
.demo-row { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
.demo-stack { display: grid; gap: 14px; }
.demo-wide { width: 100%; }
.demo-narrow { max-width: 360px; }
.demo-note { margin: 0; color: var(--ui-muted); font: 13px/1.5 var(--ui-font); }
/* A screen for what fills one: position: fixed inside these is held to the frame, as transform makes a new containing block. */
.demo-phone, .demo-tablet { position: relative; width: 100%; margin: 0 auto; overflow: hidden; transform: translateZ(0); border: 1px solid var(--ui-border); border-radius: 20px; background: var(--ui-bg); }
.demo-phone { max-width: 390px; height: 640px; }
.demo-tablet { max-width: 820px; height: 600px; }
`
