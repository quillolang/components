component PricingCardDemoLive() {
    state chosen = null
    <div.demo-stack style="width: 260px">
        <PricingCard name="Team" price={49} period="month" description="For up to 5 people." note="billed monthly"
                     features={["Everything in Pro", "5 seats", "Shared workspaces", { label: "SSO", hint: "SAML and OIDC" }]}
                     footnote="Cancel any time." on_select={() => { chosen = "Team" }}/>
        <p.demo-note>{chosen == null ? "Not chosen (on_select)." : `Chose ${chosen}.`}</p>
    </div>
}

view PricingCardDemo() =
    <div.demo-row style="align-items: stretch; gap: 20px; padding-top: 12px">
        <div style="width: 260px">
            <PricingCard name="Hobby" price={0} period="month" description="For trying things out." button="Start free" href="#pricing_card" current={true}
                         features={["3 projects", "1 GB storage", { label: "Custom domain", included: false }, { label: "Priority support", included: false }]}/>
        </div>
        <div style="width: 260px">
            <PricingCard name="Pro" price={12} old={15} period="month" description="For people who ship." note="billed yearly"
                         highlighted={true} badge="Most popular" action="/signup"
                         features={["Unlimited projects", "50 GB storage", "Custom domain", { label: "Dedicated manager", included: false }]}/>
        </div>
        <PricingCardDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "pricing_card", name: "PricingCard", group: "Commerce",
    summary: "One plan: name, price and period, what it includes, and a button; highlighted with a badge when it is the one to pick.",
    tags: ["commerce", "price", "card", "marketing", "no-js"],
    needs: ["price", "price_tag"], demo: PricingCardDemo })
