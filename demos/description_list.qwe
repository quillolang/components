view DescriptionListDemo() =
    <div.demo-stack>
        <DescriptionList layout="columns" items={[
            { term: "Customer", detail: "Northwind Traders" },
            { term: "Plan", detail: "Business, billed yearly" },
            { term: "Billing email", detail: "accounts@northwind.example" },
            { term: "Address", detail: "1 Harbour Street, Portsmouth PO1 3AH, United Kingdom" },
        ]}/>
        <div.demo-row style="align-items: flex-start; gap: 40px">
            <div.demo-narrow.demo-wide>
                <DescriptionList>
                    <DescriptionItem term="Status"><Badge tone="success" dot={true}>Paid</Badge></DescriptionItem>
                    <DescriptionItem term="Amount" detail="$1,204.50"/>
                    <DescriptionItem term="Invoice"><a href="#description_list">INV-1042</a></DescriptionItem>
                </DescriptionList>
            </div>
            <div.demo-narrow.demo-wide>
                <DescriptionList dividers={false} items={[
                    { term: "Created", detail: "March 3, 2026" },
                    { term: "Owner", detail: "Ada Lovelace" },
                ]}/>
            </div>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "description_list", name: "DescriptionList", group: "Data",
    summary: "Terms and their details, stacked or in two columns that stack on phones, on a real <dl>.",
    tags: ["data", "record", "list", "no-js"],
    demo: DescriptionListDemo })
