let size_class_view_demo_css = css`
.demo-size-class { display: flex; flex-direction: column; height: 100%; }
.demo-size-class-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; padding: 8px 12px; border-bottom: 1px solid var(--ui-border); background: var(--ui-subtle); font: 14px/1.4 var(--ui-font); }
.demo-size-class-bar output { margin-left: auto; font-weight: 600; }
.demo-size-class-room { flex: 1; min-height: 0; background: var(--ui-subtle); }
.demo-size-class-box { height: 100%; margin: 0 auto; background: var(--ui-bg); border-inline: 1px solid var(--ui-border); }
.demo-size-class-cols { display: grid; gap: 16px; height: 100%; padding: 16px; }
.demo-size-class-col { display: flex; flex-direction: column; gap: 10px; min-width: 0; min-height: 0; }
.demo-size-class-col h4 { margin: 0; font: 600 15px/1.3 var(--ui-font); }
.demo-size-class-scroll { flex: 1 1 200px; min-height: 120px; overflow: auto; border: 1px solid var(--ui-border); border-radius: var(--ui-radius); }
.demo-size-class-scroll p { margin: 0; padding: 10px 12px; border-bottom: 1px solid var(--ui-border); font: 14px/1.4 var(--ui-font); }
.demo-size-class-col textarea { box-sizing: border-box; width: 100%; min-height: 72px; padding: 8px 10px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius-sm); background: var(--ui-surface); color: var(--ui-fg); font: 16px/1.4 var(--ui-font); }
`

let size_class_view_demo_rooms = [
    { id: "full", label: "Whole screen", css: "width: 100%" },
    { id: "two", label: "Two thirds", css: "width: 66.6%" },
    { id: "half", label: "Half", css: "width: 50%" },
    { id: "over", label: "Slide Over", css: "width: 320px" },
]

let size_class_view_demo_rows = range(1, 41) | map((n) => `Delivery ${n}`)

component SizeClassViewDemoCount(name: str) {
    state n = 0
    <Button id={`size-demo-count-${name}`} size="lg" variant="soft" on_click={() => { n += 1 }}>Packed {n}</Button>
}

view SizeClassViewDemoList(name: str) =
    <div.demo-size-class-scroll id={`size-demo-list-${name}`} data-keep="deliveries" tabindex="0" aria-label="Deliveries">
        {for r in size_class_view_demo_rows => <p>{r}</p>}
    </div>

view SizeClassViewDemoNote(name: str) =
    <textarea id={`size-demo-note-${name}`} data-keep="note" aria-label="Note for the driver" placeholder="Note for the driver"></textarea>

component SizeClassViewDemoLive() {
    style global size_class_view_demo_css
    state room = "full"
    state size = "unknown"
    let shown = size_class_view_demo_rooms | filter((r) => r.id == room)
    <div.demo-tablet>
        <div.demo-size-class>
            <div.demo-size-class-bar>
                {for r in size_class_view_demo_rooms =>
                    <Button key={r.id} id={`size-demo-room-${r.id}`} size="lg" variant={r.id == room ? "solid" : "outline"}
                            on_click={() => { room = r.id }}>{r.label}</Button>}
                <output id="size-demo-now">{size}</output>
            </div>
            <div.demo-size-class-room>
                <div.demo-size-class-box id="size-demo-box" style={shown[0].css}>
                    <SizeClassView fill={true} on_change={(c) => { size = c }}>
                        <SizeClassSlot when="compact">
                            <div.demo-size-class-cols>
                                <div.demo-size-class-col>
                                    <h4>Today</h4>
                                    <SizeClassViewDemoCount name="compact"/>
                                    <SizeClassViewDemoNote name="compact"/>
                                    <SizeClassViewDemoList name="compact"/>
                                </div>
                            </div>
                        </SizeClassSlot>
                        <SizeClassSlot when="medium">
                            <div.demo-size-class-cols style="grid-template-columns: 1fr 1fr">
                                <div.demo-size-class-col><h4>Today</h4><SizeClassViewDemoList name="medium"/></div>
                                <div.demo-size-class-col>
                                    <h4>Van</h4>
                                    <SizeClassViewDemoCount name="medium"/>
                                    <SizeClassViewDemoNote name="medium"/>
                                </div>
                            </div>
                        </SizeClassSlot>
                        <SizeClassSlot when="expanded">
                            <div.demo-size-class-cols style="grid-template-columns: 1fr 1fr 1fr">
                                <div.demo-size-class-col><h4>Today</h4><SizeClassViewDemoList name="expanded"/></div>
                                <div.demo-size-class-col><h4>Van</h4><SizeClassViewDemoCount name="expanded"/></div>
                                <div.demo-size-class-col><h4>Driver</h4><SizeClassViewDemoNote name="expanded"/></div>
                            </div>
                        </SizeClassSlot>
                    </SizeClassView>
                </div>
            </div>
        </div>
    </div>
}

view SizeClassViewDemo() = <SizeClassViewDemoLive/>

ui_gallery = ui_gallery | push({ slug: "size_class_view", name: "SizeClassView", group: "Mobile",
    summary: "Tells compact, medium and expanded widths by its own box, so Split View, Slide Over and a turn are one case, and swaps slots without losing what is in them.",
    tags: ["mobile", "tablet", "interactive", "layout", "responsive", "panes"],
    demo: SizeClassViewDemo })
