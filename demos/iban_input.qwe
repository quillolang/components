component IbanInputDemoLive() {
    state got = null
    <div.demo-stack>
        <IbanInput id="iban-demo-live" name="payee" label="Pay to" countries={["DE", "FR", "NL", "BE"]} on_change={(r) => { got = r }}/>
        <p.demo-note>{got == null ? "Type an IBAN to see on_change." : `on_change: ${got.valid ? "valid" : "not valid"} ${got.country ?? "?"} ${got.iban}`}</p>
    </div>
}

view IbanInputDemo() =
    <div class="demo-stack demo-narrow">
        <form>
            <IbanInput id="iban-demo" name="iban" label="Account (IBAN)" value="de89370400440532013000" required={true}/>
        </form>
        <IbanInputDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "iban_input", name: "IbanInput", group: "Forms",
    summary: "Groups an IBAN in fours as typed, knows each country's length, validates mod-97 with big-number arithmetic, points to a likely typing slip, and sends it without spaces.",
    tags: ["smart", "interactive", "iban", "bank", "validation", "forms"], demo: IbanInputDemo })
