let side_nav_demo_items = [
    { label: "Home", href: "#home", icon: "M3 11 12 3l9 8M5 9.5V21h14V9.5" },
    { label: "Inbox", href: "#side_nav", icon: "M4 4h16v16H4zM4 13h5l1.5 2h3L15 13h5", badge: 12 },
    { label: "Projects", icon: "M3 6h7l2 2h9v11H3z", items: [
        { label: "Website", href: "#website", badge: "new" },
        { label: "Mobile app", items: [
            { label: "iOS", href: "#ios" },
            { label: "Android", href: "#android" }
        ] },
        { label: "Archive", href: "#archive" }
    ] },
    { label: "Calendar", href: "#calendar", icon: "M4 5h16v15H4zM4 10h16M9 3v4M15 3v4" },
    { section: "Workspace" },
    { label: "Members", href: "#members", icon: "M16 19v-1a4 4 0 0 0-8 0v1M12 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6", badge: 8 },
    { label: "Settings", icon: "M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM4 12h2M18 12h2M12 4v2M12 18v2", items: [
        { label: "General", href: "#general" },
        { label: "Billing", href: "#billing" }
    ] },
    { label: "Help", href: "#help" }
]

component SideNavDemoLive() {
    state slim = false
    <div.demo-stack>
        <div style="display: flex; height: 380px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius); overflow: hidden">
            <SideNav id="side-nav-demo" items={side_nav_demo_items} current="#side_nav" on_toggle={(c) => { slim = c }}/>
            <div style="flex: 1; min-width: 0; padding: 16px 20px; overflow: hidden">
                <h4 style="margin: 0 0 6px">Inbox</h4>
                <p.demo-note>{slim ? "The sidebar shows its icons only." : "The page, beside the sidebar."}</p>
            </div>
        </div>
    </div>
}

view SideNavDemo() =
    <div.demo-stack>
        <SideNavDemoLive/>
        <div style="height: 360px; display: flex; border: 1px solid var(--ui-border); border-radius: var(--ui-radius); overflow: hidden">
            <SideNav id="side-nav-demo-slim" items={side_nav_demo_items} current="#ios" collapsed={true} label="Folded"/>
            <p.demo-note style="padding: 16px">Started folded: the icons only, each named by its tooltip.</p>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "side_nav", name: "SideNav", group: "Navigation",
    summary: "An app's navigation down the side: sections, groups that open, icons, counts; it folds to its icons.",
    tags: ["navigation", "menu", "no-js"],
    demo: SideNavDemo })
