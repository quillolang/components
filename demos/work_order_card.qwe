component WorkOrderCardDemoLive() {
    state said = "No change yet."
    state status_said = ""
    <div.demo-stack>
        <WorkOrderCard offset={-240}
                       order={{ id: "WO-2231", title: "Boiler will not fire", priority: "urgent", status: "open", site: "Riverside Flats, plant room", address: "4 Quay St, Montreal",
                                phone: "+1 514 555 0100", due: "today by 16:00", description: "Tenant reports no heating since last night. Key with the caretaker.",
                                steps: [{ id: "isolate", text: "Isolate the supply", required: true }, { id: "test", text: "Test the gas valve", required: true }, { id: "photo", text: "Clean the sensor" }],
                                parts: [{ id: "valve", name: "Gas valve", planned: 1 }, { id: "seal", name: "Flue seal", planned: 2, used: 1 }] }}
                       on_change={(o) => { said = `${o.status}: ${o.steps | filter((s) => s.done) | len()} steps, ${o.parts | map((p) => p.used) | sum()} parts, note "${o.note}"` }}
                       on_status={(s, _o) => { status_said = s }}/>
        <p.demo-note id="jobcard-demo-said">{said}</p>
        <p.demo-note id="jobcard-demo-status">{status_said}</p>
    </div>
}

view WorkOrderCardDemo() = <WorkOrderCardDemoLive/>

ui_gallery = ui_gallery | push({ slug: "work_order_card", name: "WorkOrderCard", group: "Mobile",
    summary: "A job with status, priority, parts and steps, moved along with big buttons for gloves, that cannot be finished with required steps left.",
    tags: ["mobile", "interactive", "field", "job", "gloves", "tablet"],
    demo: WorkOrderCardDemo })
