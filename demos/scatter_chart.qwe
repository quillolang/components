// Made-up measurements: steady sequences around a straight line, so the trend has something to find.
let scatter_chart_demo_women = for i in range(18) => ({ x: 152 + i * 37 % 26, y: round(-40 + (152 + i * 37 % 26) * 0.62 + (i * 13 % 11) - 5, 1) })
let scatter_chart_demo_men = for i in range(18) => ({ x: 164 + i * 29 % 28, y: round(-58 + (164 + i * 29 % 28) * 0.8 + (i * 17 % 13) - 6, 1) })

view ScatterChartDemo() =
    <div.demo-stack>
        <ScatterChart label="Ad spend and sales by month" show_label={true} x_label="Ad spend" y_label="Sales" x_prefix="$" prefix="$"
                      trend={true} height={220} points={[
            { x: 1200, y: 8400, label: "Jan" }, { x: 1800, y: 11200, label: "Feb" }, { x: 2600, y: 15100, label: "Mar" },
            { x: 2200, y: 12900, label: "Apr" }, { x: 3400, y: 17800, label: "May" }, { x: 4100, y: 22600, label: "Jun" },
            { x: 3800, y: 19400, label: "Jul" }, { x: 900, y: 7600, label: "Aug" }, { x: 4600, y: 23900, label: "Sep" }]}/>
        <ScatterChart label="Height and weight" show_label={true} x_label="Height" x_suffix=" cm" y_label="Weight" suffix=" kg"
                      trend={true} height={220}
                      groups={[{ name: "Women", points: scatter_chart_demo_women }, { name: "Men", points: scatter_chart_demo_men }]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "scatter_chart", name: "ScatterChart", group: "Charts",
    summary: "Points placed by two numbers, in coloured groups, with a least-squares trend line for each and every point's numbers on hover.",
    tags: ["chart", "data", "no-js"],
    demo: ScatterChartDemo })
