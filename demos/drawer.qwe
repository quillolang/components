component DrawerDemoLive() {
    state showing = false
    <div.demo-row>
        <Button variant="soft" on_click={() => { showing = true }}>Details (from state)</Button>
        <Drawer title="Order #1042" open={showing} side="left" size="sm" on_close={() => { showing = false }}>
            <p>Opened from the component's own state, on the left; closing it sets the state back.</p>
        </Drawer>
    </div>
}

view DrawerDemo() =
    <div.demo-row>
        <Drawer title="Filters" trigger="Filters">
            <p>Narrow the list down. Press Escape or click beside the panel to close it.</p>
            <div.demo-stack>
                <Switch label="In stock only" checked={true}/>
                <Switch label="Free shipping"/>
            </div>
        </Drawer>
        <Drawer title="Cart" trigger="From the bottom" side="bottom">
            <p>A bottom sheet, as tall as it needs to be, at most 70% of the screen.</p>
        </Drawer>
        <DrawerDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "drawer", name: "Drawer", group: "Overlays",
    summary: "A panel that slides in from an edge over the page, on the browser's own <dialog>.",
    tags: ["overlay", "navigation", "interactive"],
    demo: DrawerDemo })
