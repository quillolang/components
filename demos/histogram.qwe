// Made-up data: sums of three steady sequences, which pile up in the middle as real timings do.
let histogram_demo_times = for i in range(240) => 80 + i * 37 % 61 + i * 53 % 67 + i * 11 % 29
let histogram_demo_totals = for i in range(160) => 12 + i * 71 % 97 + (i * 13 % 89) * (i % 3 == 0 ? 1.5 : 0.5)
let histogram_demo_grid = "display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 32px 40px"

view HistogramDemo() =
    <div.demo-stack>
        <Histogram label="Response times" show_label={true} values={histogram_demo_times} bins={12} suffix=" ms"
                   count_label="Requests" show_mean={true}/>
        <div style={histogram_demo_grid}>
            <Histogram label="Order totals" show_label={true} values={histogram_demo_totals} width={25} prefix="$" height={160}/>
            <Histogram label="Ages of members" show_label={true} values={[23, 25, 31, 34, 35, 38, 41, 42, 44, 47, 52, 58, 61]}
                       bins={4} count_label="Members" height={160}/>
        </div>
        <p.demo-note>Twelve bins between the fastest and the slowest request; orders in bins $25 wide.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "histogram", name: "Histogram", group: "Charts",
    summary: "Values counted into bins, by number or width, as touching bars with each bin's range, count and share on hover, and the mean marked.",
    tags: ["chart", "data", "no-js"],
    demo: HistogramDemo })
