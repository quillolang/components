component JwtInspectorDemoLive() {
    state seen = null
    <div.demo-stack>
        <JwtInspector id="jwt-inspector-demo-live" title="A token to refuse, with on_change" name="suspect" now="2026-11-01T12:00:00Z"
                      token="eyJhbGciOiJub25lIn0.eyJzdWIiOiJndWVzdCIsInBhc3N3b3JkIjoiaHVudGVyMiJ9." on_change={(r) => { seen = r }}/>
        <p.demo-note>{seen == null ? "Change the token to see on_change." : `on_change: ok ${seen.ok}, alg ${seen.alg}, ${seen.warnings} warnings.`}</p>
    </div>
}

view JwtInspectorDemo() =
    <div.demo-stack>
        <JwtInspector id="jwt-inspector-demo" now="2026-11-01T12:00:00Z"
                      token="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJ1c2VyLTg4NDEiLCJuYW1lIjoiWm_DqyDwn5iAIiwiaXNzIjoiaHR0cHM6Ly9hdXRoLmV4YW1wbGUuY29tIiwiYXVkIjpbImFwaSIsIndlYiJdLCJpYXQiOjE3OTM1MzA4MDAsIm5iZiI6MTc5MzUzMDgwMCwiZXhwIjoxNzkzNTM4MDAwLCJyb2xlIjoiYWRtaW4iLCJpZCI6OTAwNzE5OTI1NDc0MDk5M30.c2lnbmF0dXJlLWJ5dGVz"/>
        <JwtInspectorDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "jwt_inspector", name: "JwtInspector", group: "Utilities",
    summary: "Decodes a JSON Web Token locally, reads its dates relative to now, warns on alg none and a missing exp, and says the signature was not verified.",
    tags: ["smart", "interactive", "jwt", "security", "developer", "decode"], needs: ["json_formatter"], demo: JwtInspectorDemo })
