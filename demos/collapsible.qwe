component CollapsibleDemoLive() {
    state seen = false
    <div.demo-stack>
        <Collapsible id="collapsible-demo-live" title="Details" variant="button" on_toggle={(o) => { seen = o }}>
            <p style="margin: 0">Opened with the trigger, or by find-in-page.</p>
        </Collapsible>
        <p.demo-note>The details are {seen ? "open" : "closed"}.</p>
    </div>
}

view CollapsibleDemo() =
    <div.demo-stack>
        <Collapsible id="collapsible-demo-options" title="Advanced options" hint="3 settings">
            <div.demo-stack style="gap: 8px">
                <Switch label="Send a copy to me"/>
                <Switch label="Keep the thread open"/>
                <Switch label="Mark as internal" checked={true}/>
            </div>
        </Collapsible>
        <Collapsible id="collapsible-demo-log" title="Show the full log" open={true} variant="box" hint="4 lines">
            <pre style="margin: 0; font: 13px/1.6 var(--ui-mono)">{"$ quillo check app.qwe\napp.qwe: ok (12 routes, 48 functions)\n$ quillo run app.qwe\nquillo: 12 routes listening on http://127.0.0.1:8080"}</pre>
        </Collapsible>
        <CollapsibleDemoLive/>
        <p.demo-note>Two in one group: opening one closes the other.</p>
        <Collapsible id="collapsible-demo-a" group="collapsible-demo-group" title="Shipping"><p style="margin: 0">Free over €50; two to four working days.</p></Collapsible>
        <Collapsible id="collapsible-demo-b" group="collapsible-demo-group" title="Returns"><p style="margin: 0">Within 30 days, in the original packaging.</p></Collapsible>
    </div>

ui_gallery = ui_gallery | push({ slug: "collapsible", name: "Collapsible", group: "Layout",
    summary: "A block shown and hidden under a line you click, on the browser's own <details>; open by default or not.",
    tags: ["layout", "navigation", "accessibility", "no-js"], demo: CollapsibleDemo })
