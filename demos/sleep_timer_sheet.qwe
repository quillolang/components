// Fourteen silent seconds, small enough to sit in the page.
let sleep_timer_sheet_demo_src = "data:audio/mp4;base64,"

component SleepTimerSheetDemoLive() {
    state stops = 0
    state level = 1
    state turn = 0
    <div.demo-stack>
        <audio id="sleep-demo-audio" src={sleep_timer_sheet_demo_src} preload="auto" loop></audio>
        <div.demo-row>
            <Button id="sleep-demo-play" size="lg" on_click={() => { js("document.getElementById", "sleep-demo-audio").play() }}>Play</Button>
            <SleepTimerSheet key={turn} media="sleep-demo-audio" extend_by={10} on_stop={() => { stops += 1 }} on_volume={(l) => { level = l }}/>
        </div>
        <p.demo-note id="sleep-demo-note">Stopped {stops} times, level {round(level, 3)}</p>
        <div id="sleep-demo-bad"><SleepTimerSheet trigger="Odd props" choices={["x", 0, 5, 5, 1000]} fade="none" start_minutes="soon"/></div>
        <Button id="sleep-demo-again" variant="ghost" size="lg" on_click={() => { turn += 1 }}>Make it again</Button>
    </div>
}

view SleepTimerSheetDemo() = <SleepTimerSheetDemoLive/>

ui_gallery = ui_gallery | push({ slug: "sleep_timer_sheet", name: "SleepTimerSheet", group: "Mobile",
    summary: "Stops playing after a set time, with a fade at the end and an extend while it runs.",
    tags: ["mobile", "interactive", "media", "timer", "sheet", "audio"],
    demo: SleepTimerSheetDemo })
