component SortableListDemoLive() {
    state order = ["write", "review", "ship"]
    <div.demo-stack>
        <SortableList id="sortable-list-demo-live" label="Release steps" numbered={false} on_change={(vs) => { order = vs }}
                      items={[{ label: "Write the changelog", value: "write", hint: "What changed and why" },
                              { label: "Review the diff", value: "review" }, { label: "Ship it", value: "ship" }]}/>
        <p.demo-note>Order: {join(order, " → ")}</p>
    </div>
}

view SortableListDemo() =
    <div.demo-stack.demo-narrow>
        <SortableList id="sortable-list-demo-plain" name="priorities" label="Rank what matters most"
                      items={["Price", "Speed", "Support", "Design"]}
                      hint="Drag, or focus an item and press Space, then the arrow keys."/>
        <SortableListDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "sortable_list", name: "SortableList", group: "Forms",
    summary: "A list put in order by dragging or with the keyboard, each move announced, the order sent with a form.",
    tags: ["forms", "list", "drag", "sort", "keyboard", "interactive"], demo: SortableListDemo })
