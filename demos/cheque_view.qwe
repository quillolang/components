view ChequeViewDemo() =
    <div.demo-stack>
        <ChequeView id="cheque-view-demo" number="1042" dated="2026-10-29" payee="Ana Okafor" amount={1234.56m} memo="Kitchen tiles"
                    drawer={{ name: "Dana Whitfield", lines: ["12 Orchard Row", "Port Ellis, ME 04101"] }}
                    bank={{ name: "Fernway Credit Union", lines: ["40 Quay Street, Port Ellis"] }}
                    routing="011000015" account="40031204" signature="Dana Whitfield"/>
        <ChequeView id="cheque-view-demo-void" number="1043" dated="2026-11-02" payee="Harbour Fitness" amount={85} memo="November"
                    drawer={{ name: "Dana Whitfield" }} bank={{ name: "Fernway Credit Union" }} routing="011000015" account="40031204"
                    void={true}/>
        <ChequeView id="cheque-view-demo-yen" number="000318" dated="2026-12-01" payee="Kinoshita Builders" amount={1250000} currency="JPY"
                    bank={{ name: "Sakuragi Shinkin" }} signature="T. Mori"/>
    </div>

ui_gallery = ui_gallery | push({ slug: "cheque_view", name: "ChequeView", group: "Finance",
    summary: "A cheque drawn as printed: payee, the amount in figures and in words, date, memo, signature and the MICR line.",
    tags: ["finance", "banking", "document", "payments", "no-js"], demo: ChequeViewDemo })
