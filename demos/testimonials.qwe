let testimonials_demo_items = [
    { quote: "We replaced three services and a build pipeline with one file. The team shipped the next week.",
      name: "Ada Lovelace", title: "CTO", company: "Analytical", href: "#testimonials", rating: 5 },
    { quote: "The first web framework my team did not fight. Views are functions; that is the whole trick.",
      name: "Grace Hopper", title: "Engineering lead", company: "Compiler Co.", rating: 5 },
    { quote: "Live queries did in an afternoon what our socket layer took a quarter to get wrong.",
      name: "Linus Benedict", title: "Founder", rating: 4 },
    { quote: "Small enough to read, fast enough not to think about.", name: "Margaret Hamilton", company: "Apollo Labs" },
]

view TestimonialsDemo() =
    <div.demo-stack>
        <Testimonials id="testimonials-demo-row" items={take(testimonials_demo_items, 3)}/>
        <Testimonials title="Loved by small teams" layout="grid" variant="plain" items={testimonials_demo_items}/>
        <p.demo-note>A row scrolls sideways when it runs out of room; a grid wraps.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "testimonials", name: "Testimonials", group: "Marketing",
    summary: "Quotes from people with their picture, role and company, in a row that scrolls or a grid that wraps.",
    tags: ["marketing", "section", "card", "social", "no-js"],
    needs: ["avatar"],
    demo: TestimonialsDemo })
