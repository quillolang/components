// A wordmark drawn in SVG, so the demo needs no image files.
fn logo_cloud_demo_mark(text: str, color: str) -> str {
    let w = 36 + len(text) * 15
    let svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${w} 44" width="${w}" height="44">`
        + `<circle cx="18" cy="22" r="12" fill="${color}"/>`
        + `<text x="36" y="30" font-family="Inter, system-ui, sans-serif" font-size="22" font-weight="700" fill="${color}">${text}</text></svg>`
    `data:image/svg+xml,${url_encode(svg)}`
}

let logo_cloud_demo_logos = [
    { name: "Acme", src: logo_cloud_demo_mark("Acme", "#c62a2f"), href: "https://example.com/acme" },
    { name: "Globex", src: logo_cloud_demo_mark("Globex", "#0b6bcb") },
    { name: "Initech", src: logo_cloud_demo_mark("Initech", "#18794e") },
    { name: "Umbrella", src: logo_cloud_demo_mark("Umbrella", "#7c3aed") },
    { name: "Hooli", src: logo_cloud_demo_mark("Hooli", "#d9480f") },
]

view LogoCloudDemo() =
    <div.demo-stack style="gap: 32px">
        <LogoCloud logos={logo_cloud_demo_logos} label="Trusted by teams at"/>
        <LogoCloud logos={logo_cloud_demo_logos | take(4)} label={null} size="sm" color={true} align="left"/>
        <p.demo-note>Logos are grey until the pointer rests on one; the second row keeps its colours.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "logo_cloud", name: "LogoCloud", group: "Media",
    summary: "A row of logos, grey until hovered, with a line saying what they are; each can be a link.",
    tags: ["marketing", "media", "image", "no-js"], demo: LogoCloudDemo })
