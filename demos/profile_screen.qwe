let profile_screen_demo_posts = for i in range(30) => `Post ${i + 1}: the north side, week ${i + 1}`
let profile_screen_demo_likes = for i in range(24) => `Liked ${i + 1}`

let profile_screen_demo_cover = "data:image/svg+xml," + url_encode(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 390 180"><rect width="390" height="180" fill="#2f6f9f"/><path d="M0 150 C100 80 290 80 390 150 V180 H0z" fill="#23506f"/></svg>`)

component ProfileScreenDemoLive() {
    state note = "Nothing yet."
    state tall = false
    <div.demo-stack>
        <div.demo-phone id="profile-screen-demo" style="height: 620px">
            <ProfileScreen name="Ana Silva" handle="@ana" cover={profile_screen_demo_cover} cover_height={tall ? 200 : 180} class={tall ? "demo-tall" : "demo-short"} bio="Site engineer on the Mill Road bridge. Photographs mostly concrete." action="Follow"
                           stats={[{ label: "Posts", value: 214 }, { label: "Followers", value: 15300 }, { label: "Following", value: 1999 }, { label: "Joined", value: "2019" }]}
                           tabs={[{ id: "posts", label: "Posts", count: 214 }, { id: "likes", label: "Likes", count: 1200 }, { id: "about", label: "About" }]}
                           on_action={(on) => { note = `Following: ${on}` }} on_tab={(t) => { note = `Tab: ${t}` }} on_back={() => { note = "Back" }}>
                <div data-tab="posts">{for p in profile_screen_demo_posts => <p key={p}>{p}</p>}</div>
                <div data-tab="likes">{for p in profile_screen_demo_likes => <p key={p}>{p}</p>}</div>
                <div data-tab="about"><p>Short, so that the tabs must hold their place by themselves.</p></div>
            </ProfileScreen>
        </div>
        <Button size="lg" variant="outline" id="profile-screen-tall" on_click={() => { tall = !tall }}>Change the cover's height</Button>
        <p.demo-note id="profile-screen-note">{note}</p>
    </div>
}

view ProfileScreenDemo() = <ProfileScreenDemoLive/>

ui_gallery = ui_gallery | push({ slug: "profile_screen", name: "ProfileScreen", group: "Mobile",
    summary: "A cover collapsing as you scroll, with stats and sticky tabs over one shared scroller. Two columns on a tablet.",
    tags: ["mobile", "interactive", "profile", "tabs", "scroll", "tablet"], demo: ProfileScreenDemo })
