component RangeSliderDemoLive() {
    state ages = [25, 40]
    <div.demo-stack>
        <RangeSlider name="rs-demo-age" label="Age" min={18} max={99} low={25} high={40} gap={1}
                     on_change={(lo, hi) => { ages = [lo, hi] }}/>
        <p.demo-note>Showing people aged {ages[0]} to {ages[1]}.</p>
    </div>
}

view RangeSliderDemo() =
    <div.demo-stack.demo-narrow>
        <RangeSlider name="rs-demo-price" label="Price" min={0} max={500} step={10} low={40} high={250} prefix="$"
                     hint="Drag either end, or Tab to it and use the arrow keys."/>
        <RangeSliderDemoLive/>
        <RangeSlider name="rs-demo-km" label="Distance" min={0} max={50} step={0.5} low={2} high={10.5} format=" km"/>
        <RangeSlider name="rs-demo-off" label="Locked" low={20} high={80} format="%" disabled={true}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "range_slider", name: "RangeSlider", group: "Forms",
    summary: "Two thumbs on one track for a range (a price from–to), each with the keyboard; they cannot cross.",
    demo: RangeSliderDemo })
