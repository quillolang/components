component TimeSlotsDemoLive() {
    state chosen = null
    <div.demo-stack>
        <TimeSlots name="ts-demo-sail" label="Sunset sail" value={chosen} on_pick={(id) => { chosen = id }}
                   slots={[{ id: 31, time: "Fri 6 Nov 18:00", left: 7, detail: "10% rain" },
                           { id: 32, time: "Sat 7 Nov 18:00", left: 0 },
                           { id: 33, time: "Sun 8 Nov 18:00", left: 2, detail: "80% rain: may be wet", tone: "warning" },
                           { id: 34, time: "Mon 9 Nov 18:00", left: 9 }]}/>
        <p.demo-note>{chosen == null ? "No time chosen." : `Time ${chosen} chosen.`}</p>
    </div>
}

view TimeSlotsDemo() =
    <div.demo-stack>
        <TimeSlotsDemoLive/>
        <form.demo-stack method="get" action="#time_slots">
            <TimeSlots name="ts-demo-class" label="Pastel de nata class" value="b"
                       slots={[{ id: "a", time: "11:00" }, { id: "b", time: "17:00" }, { id: "c", time: "19:30", disabled: true, detail: "Not on Sundays" }]}/>
        </form>
        <TimeSlots name="ts-demo-none" label="Tea ceremony" empty="No times on these days."/>
    </div>

ui_gallery = ui_gallery | push({ slug: "time_slots", name: "TimeSlots", group: "Forms",
    summary: "Times to choose one from, with the places left at each; full ones cannot be chosen.",
    demo: TimeSlotsDemo })
