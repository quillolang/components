component SpendingRingDemoLive() {
    state log = "All"
    <div.demo-stack>
        <SpendingRing today="2026-03-31" last_so_far={1120.00m} last_total={2480.55m} on_pick={(n) => { log = n ?? "All" }} categories={[
            { name: "Rent", spent: 950m, last: 950m },
            { name: "Food", spent: 212.40m, last: 180.10m, color: "#c2410c" },
            { name: "Travel", spent: "96.15" },
            { name: "Fun", spent: 41.20m, last: 60m },
            { name: "Coffee", spent: 3.25m, last: 3.25m },
            { name: "Refunds", spent: -20m },
            { name: "Broken", spent: "abc" }]}/>
        <p.demo-note id="spendring-log">{log}</p>
    </div>
}

view SpendingRingDemo() =
    <div.demo-stack>
        <SpendingRingDemoLive/>
        <div id="spendring-none"><SpendingRing/></div>
        <div id="spendring-three"><SpendingRing categories={[{ name: "A", spent: 1 }, { name: "B", spent: 1 }, { name: "C", spent: 1 }]}/></div>
    </div>

ui_gallery = ui_gallery | push({ slug: "spending_ring", name: "SpendingRing", group: "Mobile",
    summary: "Spending by category as a ring with a tap for each, and the month so far against last month.",
    tags: ["mobile", "interactive", "banking", "chart", "budget", "tablet"],
    needs: ["price"],
    demo: SpendingRingDemo })
