let user_menu_demo_items = [
    { label: "Profile", href: "#user_menu", icon: "M16 19v-1a4 4 0 0 0-8 0v1M12 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6" },
    { label: "Settings", href: "#settings", icon: "M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM4 12h2M18 12h2M12 4v2M12 18v2", shortcut: "⌘," },
    { divider: true },
    { label: "Upgrade to Pro", href: "#billing", icon: "✨", badge: "New" }
]

component UserMenuDemoLive() {
    state did = "nothing yet"
    <div.demo-row>
        <UserMenu id="user-menu-demo-live" name="Grace Hopper" email="grace@example.com" show_name={true} size="sm"
                  items={[{ label: "Switch team" }, { label: "Keyboard shortcuts", shortcut: "?" }, { label: "Delete account", tone: "danger" }]}
                  on_select={(it) => { did = it.label }} on_sign_out={() => { did = "Sign out" }}/>
        <span.demo-note>Picked: {did}</span>
    </div>
}

view UserMenuDemo() =
    <div.demo-stack>
        <div.demo-row style="gap: 20px">
            <UserMenu id="user-menu-demo" name="Ada Lovelace" email="ada@example.com" items={user_menu_demo_items} sign_out_href="#signout"/>
            <UserMenu id="user-menu-demo-pic" name="Linus Torvalds" email="linus@example.com" size="lg" items={user_menu_demo_items}
                      sign_out_href="#signout" src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48'%3E%3Crect width='48' height='48' fill='%235b4bdb'/%3E%3Ccircle cx='24' cy='18' r='9' fill='%23fff'/%3E%3Cpath d='M6 48a18 14 0 0 1 36 0z' fill='%23fff'/%3E%3C/svg%3E"/>
            <span.demo-note>Initials on a colour of their own, or a picture.</span>
        </div>
        <UserMenuDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "user_menu", name: "UserMenu", group: "Navigation",
    summary: "An avatar button that opens the account menu: name and email, links, and sign out; the arrow keys move through it.",
    tags: ["navigation", "menu", "user", "popover", "interactive"], demo: UserMenuDemo })
