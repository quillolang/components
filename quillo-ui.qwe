        "check-circle" => "M22 11.08V12a10 10 0 1 1-5.93-9.14M22 4 12 14.01l-3-3"
        "alert-circle" => "M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20ZM12 8v4M12 16h.01"
        "skip-back" => "M19 20 9 12l10-8v16ZM5 19V5"
        "skip-forward" => "m5 4 10 8-10 8V4ZM19 5v14"
        "arrow-up" => "M12 19V5M5 12l7-7 7 7"
        "arrow-down" => "M12 5v14M19 12l-7 7-7-7"
        "arrow-left" => "M19 12H5M12 19l-7-7 7-7"
        "arrow-right" => "M5 12h14M12 5l7 7-7 7"
        "chevron-up" => "m18 15-6-6-6 6"
        "chevron-down" => "m6 9 6 6 6-6"
        "chevron-left" => "m15 18-6-6 6-6"
        "chevron-right" => "m9 18 6-6-6-6"
        _ => null
    }

view Icon(name: str, size: str = "md", px: int? = null, label: str? = null, stroke: num = 2, class: str? = null) {
    style global icon_css
    let d = icon_path(name)
    <svg class={ui_cls(["ui-icon", px == null && size != "md" && `ui-icon-${size}`, class])}
         style={px != null ? `width: ${px}px; height: ${px}px` : null} viewBox="0 0 24 24" stroke-width={stroke}
         data-icon={name} data-missing={d == null ? "true" : null}
         role={label != null ? "img" : null} aria-label={label} aria-hidden={label == null ? "true" : null}>
        <path d={d ?? icon_path("help")}/>
    </svg>
}

// ---- ui/icon_button.qwe ----------------------------------------------------------------

// IconButton: a square button that shows an icon instead of words. Its label is
// what screen readers say and what shows when the pointer rests on it.
//
//   <IconButton icon="trash" label="Delete" tone="danger"/>
//   <IconButton icon="settings" label="Settings" href="/settings" variant="outline"/>
//   <IconButton label="Star"><svg viewBox="0 0 24 24">...</svg></IconButton>
//
// icon: one of "plus", "x", "check", "edit", "trash", "search", "copy", "more",
// "menu", "settings", "chevron-down"; or leave it out and give your own <svg> as
// children (it is sized to 18px and drawn in the text colour).
// label (required): its aria-label and title.
// variant: "ghost" (default), "soft", "outline" or "solid".
// tone: "neutral" (default), "accent" or "danger". size: "sm", "md" (default) or "lg".
// round: a circle. pressed: true or false makes it a toggle (aria-pressed).
// href makes it an <a>; otherwise type, disabled and on_click() go to the <button>.


let icon_button_css = css`
.ui-icon-btn {
  display: inline-grid; place-items: center; flex: none; width: 38px; height: 38px; padding: 0;
  border: 1px solid transparent; border-radius: var(--ui-radius-sm); text-decoration: none; cursor: pointer;
  transition: background .15s, border-color .15s, color .15s, box-shadow .15s;
  --b: var(--ui-fg); --bf: var(--ui-bg); --bs: var(--ui-subtle);
}
.ui-icon-btn svg { width: 18px; height: 18px; }
.ui-icon-btn:focus-visible { outline: none; box-shadow: var(--ui-focus); }
.ui-icon-btn[disabled], .ui-icon-btn[aria-disabled="true"] { opacity: .55; cursor: not-allowed; pointer-events: none; }
.ui-icon-btn-accent { --b: var(--ui-accent); --bf: var(--ui-accent-fg); --bs: var(--ui-accent-soft); }
.ui-icon-btn-danger { --b: var(--ui-danger); --bf: #fff; --bs: var(--ui-danger-soft); }
.ui-icon-btn-ghost { background: transparent; color: var(--b); }
.ui-icon-btn-ghost.ui-icon-btn-neutral { color: var(--ui-muted); }
.ui-icon-btn-ghost:hover { background: var(--bs); color: var(--b); }
.ui-icon-btn-soft { background: var(--bs); color: var(--b); }
.ui-icon-btn-soft:hover { background: color-mix(in srgb, var(--bs) 80%, var(--b)); }
.ui-icon-btn-outline { background: transparent; color: var(--b); border-color: var(--ui-border); }
.ui-icon-btn-outline:hover { border-color: var(--b); background: var(--bs); }
.ui-icon-btn-solid { background: var(--b); color: var(--bf); }
.ui-icon-btn-solid:hover { background: color-mix(in srgb, var(--b) 88%, var(--ui-fg)); }
.ui-icon-btn[aria-pressed="true"] { background: var(--ui-accent-soft); color: var(--ui-accent); border-color: transparent; }
.ui-icon-btn-sm { width: 30px; height: 30px; }
.ui-icon-btn-sm svg { width: 16px; height: 16px; }
.ui-icon-btn-lg { width: 46px; height: 46px; }
.ui-icon-btn-lg svg { width: 22px; height: 22px; }
.ui-icon-btn-round { border-radius: 50%; }
@media (prefers-reduced-motion: reduce) { .ui-icon-btn { transition: none; } }
`

// The path of a built-in icon (24 by 24, drawn with a 2px line), or "" for a name it does not know.
fn icon_button_path(name: str) =
    match name {
        "plus" => "M12 5v14M5 12h14"
        "x" => "M18 6 6 18M6 6l12 12"
        "check" => "M20 6 9 17l-5-5"
        "edit" => "M12 20h9M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"
        "trash" => "M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M10 11v6M14 11v6"
        "search" => "M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16ZM21 21l-4.3-4.3"
        "copy" => "M10 8h10a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H10a2 2 0 0 1-2-2V10a2 2 0 0 1 2-2ZM4 16a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2"
        "more" => "M12 13a1 1 0 1 0 0-2 1 1 0 0 0 0 2ZM19 13a1 1 0 1 0 0-2 1 1 0 0 0 0 2ZM5 13a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z"
        "menu" => "M4 6h16M4 12h16M4 18h16"
        "settings" => "M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z"
        "chevron-down" => "m6 9 6 6 6-6"
        _ => ""
    }

view IconButton(label: str, icon: str? = null, variant: str = "ghost", tone: str = "neutral", size: str = "md",
                href: str? = null, type: str = "button", disabled: bool = false, round: bool = false,
                pressed: bool? = null, on_click = null, class: str? = null, children) {
    style global icon_button_css
    let cls = ui_cls(["ui-icon-btn", `ui-icon-btn-${variant}`, `ui-icon-btn-${tone}`,
                      size != "md" && `ui-icon-btn-${size}`, round && "ui-icon-btn-round", class])
    let body = icon != null
        ? <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
               stroke-linejoin="round" aria-hidden="true"><path d={icon_button_path(icon)}/></svg>
        : children
    href != null
        ? <a class={cls} href={href} aria-label={label} title={label} aria-disabled={disabled ? "true" : null}>{body}</a>
        : <button class={cls} type={type} disabled={disabled} aria-label={label} title={label}
                  aria-pressed={pressed == null ? null : pressed ? "true" : "false"}
                  @click={() => { on_click && on_click() }}>{body}</button>
}

// ---- ui/icon_grid.qwe ----------------------------------------------------------------

// IconGrid: every icon of the kit with its name, as a grid that a search box
// narrows as one types; a click on one gives its name, to copy into code.
//
//   <IconGrid/>
//   <IconGrid size="lg" on_pick={(name) => { chosen = name }}/>
//
// It needs icon.qwe (Icon and icon_names).
// size: the icons' size, "md" (default), "lg" or "xl". columns: the tiles' least
// width in pixels (96). label: the search box's label ("Search icons").
// id: the search box's id ("ui-icon-grid"); give each grid on a page its own.
// on_pick(name): inside one of your components, called with the icon's name when
// one is clicked. The tile clicked last is marked, and the count of matches is
// said to screen readers.


let icon_grid_css = css`
.ui-icon-grid { display: grid; gap: 12px; font: 14px/1.4 var(--ui-font); color: var(--ui-fg); }
.ui-icon-grid-head { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
.ui-icon-grid-head label { font-size: 13px; font-weight: 500; }
.ui-icon-grid-search {
  flex: 1 1 200px; height: 36px; padding: 0 12px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius-sm);
  background: var(--ui-surface); color: var(--ui-fg); font: 14px var(--ui-font);
}
.ui-icon-grid-search:focus { outline: none; border-color: var(--ui-accent); box-shadow: var(--ui-focus); }
.ui-icon-grid-count { color: var(--ui-muted); font-size: 13px; font-variant-numeric: tabular-nums; }
.ui-icon-grid-tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(var(--w, 96px), 1fr)); gap: 6px; margin: 0; padding: 0; list-style: none; }
.ui-icon-grid-tile {
  display: grid; justify-items: center; gap: 8px; width: 100%; padding: 14px 6px 10px; border: 1px solid var(--ui-border);
  border-radius: var(--ui-radius-sm); background: var(--ui-surface); color: var(--ui-fg); font: 12px/1.2 var(--ui-font);
  cursor: pointer; transition: border-color .15s, background .15s;
}
.ui-icon-grid-tile:hover { border-color: var(--ui-strong); background: var(--ui-subtle); }
.ui-icon-grid-tile:focus-visible { outline: none; box-shadow: var(--ui-focus); }
.ui-icon-grid-tile[aria-pressed="true"] { border-color: var(--ui-accent); background: var(--ui-accent-soft); color: var(--ui-accent); }
.ui-icon-grid-name { max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--ui-muted); }
.ui-icon-grid-tile[aria-pressed="true"] .ui-icon-grid-name { color: inherit; }
.ui-icon-grid-empty { padding: 20px; text-align: center; color: var(--ui-muted); }
@media (prefers-reduced-motion: reduce) { .ui-icon-grid-tile { transition: none; } }
`

component IconGrid(size: str = "md", columns: int = 96, label: str = "Search icons", id: str = "ui-icon-grid",
                   on_pick = null, class: str? = null) {
    style global icon_grid_css
    state query = ""
    state picked = null
    let needle = lower(trim(query))
    let shown = needle == "" ? icon_names : icon_names | filter((n) => contains(n, needle))
    <div class={ui_cls(["ui-icon-grid", class])}>
        <div.ui-icon-grid-head>
            <label for={id}>{label}</label>
            <input.ui-icon-grid-search type="search" id={id} value={query} placeholder="arrow, chevron, user…"
                   autocomplete="off" @input={(e) => { query = e.value }}/>
            <span.ui-icon-grid-count role="status">{len(shown)} of {len(icon_names)}</span>
        </div>
        {len(shown) > 0
            ? <ul.ui-icon-grid-tiles style={`--w: ${columns}px`}>
                {for n in shown => <li key={n}>
                    <button.ui-icon-grid-tile type="button" aria-pressed={n == picked ? "true" : "false"} title={n}
                            @click={() => {
                                picked = n
                                on_pick && on_pick(n)
                            }}>
                        <Icon name={n} size={size}/>
                        <span.ui-icon-grid-name>{n}</span>
                    </button>
                </li>}
            </ul>
            : <p.ui-icon-grid-empty>No icon matches “{query}”.</p>}
    </div>
}

// ---- ui/icon_picker.qwe ----------------------------------------------------------------

// IconPicker: pick an icon from a grid, with a search box that narrows it as one
// types (by name and by other words: "trash" also finds "delete"). The icons are
// radio buttons, so the arrow keys move between them; the name of the one picked
// goes in a hidden input named `name`, so a plain <form> sends it.
//
//   <IconPicker id="cat-icon" name="icon" label="Category icon" value="star"/>
//   <IconPicker id="app-icon" label="App icon" only={["home", "star", "heart", "bell"]} search={false}
//               on_change={(n) => { icon = n }}/>
//
// id: a prefix for its ids, unique on the page. value: the icon picked to start
// with. only: the names to offer, in place of the 51 built in
// (`icon_picker_icons`: { name: [svg path, extra words] }; `icon_picker_svg(name)`
// draws one anywhere). search (true): the search box. columns (8): icons per row
// where there is room. empty: what the grid says when nothing matches
// ("No icons match"). label, hint, error, required and size ("sm" or "md") as for
// every field.
// on_change(name): inside one of your components, given the icon's name.


let icon_picker_css = css`
.ui-icon-picker { display: grid; gap: 8px; min-width: 0; margin: 0; padding: 0; border: 0; font: 14px/1.4 var(--ui-font); color: var(--ui-fg); }
.ui-icon-picker-legend { padding: 0; font-size: 13px; font-weight: 500; }
.ui-icon-picker-req { margin-left: 2px; color: var(--ui-danger); }
.ui-icon-picker-panel { display: grid; gap: 8px; padding: 10px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius); background: var(--ui-surface); }
.ui-icon-picker-search {
  box-sizing: border-box; width: 100%; height: 34px; margin: 0; padding: 0 10px; border: 1px solid var(--ui-border);
  border-radius: var(--ui-radius-sm); background: var(--ui-surface); color: var(--ui-fg); font: 13px var(--ui-font);
}
.ui-icon-picker-search::placeholder { color: var(--ui-muted); opacity: 1; }
.ui-icon-picker-search:focus { outline: none; border-color: var(--ui-accent); box-shadow: var(--ui-focus); }
.ui-icon-picker-grid {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(40px, 1fr)); gap: 4px; max-height: 220px; overflow: auto;
  max-width: calc(var(--cols) * 44px); padding: 2px;
}
.ui-icon-picker-opt { position: relative; display: grid; place-items: center; height: 40px; border-radius: var(--ui-radius-sm); color: var(--ui-fg); cursor: pointer; }
.ui-icon-picker-opt input { position: absolute; opacity: 0; width: 1px; height: 1px; margin: 0; }
.ui-icon-picker-opt svg { width: 20px; height: 20px; }
.ui-icon-picker-opt:hover { background: var(--ui-subtle); }
.ui-icon-picker-opt:has(input:checked) { background: var(--ui-accent); color: var(--ui-accent-fg); }
.ui-icon-picker-opt:has(input:focus-visible) { box-shadow: var(--ui-focus); }
.ui-icon-picker-empty { padding: 14px 4px; color: var(--ui-muted); font-size: 13px; text-align: center; }
.ui-icon-picker-status { display: flex; justify-content: space-between; gap: 8px; font-size: 12px; color: var(--ui-muted); }
.ui-icon-picker-status b { color: var(--ui-fg); font-weight: 500; }
.ui-icon-picker-sm .ui-icon-picker-opt { height: 32px; }
.ui-icon-picker-sm .ui-icon-picker-opt svg { width: 16px; height: 16px; }
.ui-icon-picker-sm .ui-icon-picker-grid { grid-template-columns: repeat(auto-fill, minmax(32px, 1fr)); max-width: calc(var(--cols) * 36px); }
.ui-icon-picker-invalid .ui-icon-picker-panel { border-color: var(--ui-danger); }
.ui-icon-picker-hint, .ui-icon-picker-error { margin: 0; font-size: 13px; color: var(--ui-muted); }
.ui-icon-picker-error { color: var(--ui-danger); }
`

// Each icon: its path (24 by 24, drawn with a 2px stroke) and the other words it is found by.
