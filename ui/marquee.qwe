// Marquee: content that scrolls sideways without end: logos, headlines, a line
// of tags. Pure CSS: the content is drawn twice and slid by its own width, so
// the loop has no seam. It pauses while the pointer or the focus is on it, and
// for people who ask their system for less motion it does not move at all (it
// can be scrolled by hand instead).
//
//   <Marquee speed={25}>
//       {for l in logos => <img src={l.src} alt={l.name} height="32"/>}
//   </Marquee>
//   <Marquee direction="right" gap={64} label="Partners">...</Marquee>
//
// children: what scrolls (any elements; they are laid in a row).
// speed: seconds for one full loop (20); less is faster. direction: "left"
// (default) or "right". gap: the space between items, and between the end and
// the start again, in pixels (48). pause: stops while hovered or focused (true).
// label: what screen readers call it ("Scrolling content"); they read the
// content once, as the copy is hidden from them.

import ui/theme.qwe use ui_cls

let marquee_css = css`
.ui-marquee {
  position: relative; overflow: hidden; width: 100%; font: 14px/1.4 var(--ui-font); color: var(--ui-fg);
  mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
  -webkit-mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent);
}
.ui-marquee-track { display: flex; width: max-content; animation: ui-marquee var(--t, 20s) linear infinite; }
.ui-marquee-right .ui-marquee-track { animation-direction: reverse; }
.ui-marquee-pause:hover .ui-marquee-track, .ui-marquee-pause:focus-within .ui-marquee-track { animation-play-state: paused; }
.ui-marquee-group { display: flex; flex: none; align-items: center; gap: var(--g, 48px); padding-right: var(--g, 48px); }
.ui-marquee-group > * { flex: none; }
@keyframes ui-marquee { to { transform: translateX(-50%); } }
@media (prefers-reduced-motion: reduce) {
  .ui-marquee { overflow-x: auto; mask-image: none; -webkit-mask-image: none; }
  .ui-marquee-track { animation: none; }
  .ui-marquee-group[aria-hidden] { display: none; }
}
`

view Marquee(speed: num = 20, direction: str = "left", gap: int = 48, pause: bool = true, label: str = "Scrolling content",
             class: str? = null, children) {
    style global marquee_css
    <div class={ui_cls(["ui-marquee", direction == "right" && "ui-marquee-right", pause && "ui-marquee-pause", class])}
         role="marquee" aria-label={label} style={`--t: ${speed}s; --g: ${gap}px`}>
        <div.ui-marquee-track>
            <div.ui-marquee-group>{children}</div>
            <div.ui-marquee-group aria-hidden="true">{children}</div>
        </div>
    </div>
}
