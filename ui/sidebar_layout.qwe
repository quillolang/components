// SidebarLayout: the page's content beside a sidebar (a filter panel, a table of
// contents, an ad column) that goes under the content where there is no room. It
// measures its own width, not the window's, so it works inside a card too.
//
//   <SidebarLayout sidebar={<Filters/>}> <ProductGrid .../> </SidebarLayout>
//   <SidebarLayout side="right" width="220px" sticky={true} sidebar={<TableOfContents .../>}>
//       <article>...</article>
//   </SidebarLayout>
//
// sidebar: the sidebar's HTML. children: the content. side: "left" (default) or "right".
// width: the sidebar's width, as CSS ("260px"). gap: pixels (24, the default) or
// "none", "xs" (4), "sm" (8), "md" (16), "lg" (24), "xl" (32).
// stack: when the sidebar goes under the content: narrower than "sm" (480px), "md"
// (640px, the default), "lg" (900px), or "none" (never). Stacked, the sidebar
// comes after the content whichever side it was on, unless first={true}.
// sticky: the sidebar stays in view as the content scrolls past it (top: var(--ui-sidebar-top, 16px)).

import ui/theme.qwe use ui_cls

let sidebar_layout_css = css`
.ui-sidebar-layout { container-type: inline-size; min-width: 0; }
.ui-sidebar-layout-in {
  display: grid; grid-template-columns: var(--ui-sidebar-w, 260px) minmax(0, 1fr); gap: var(--ui-sidebar-gap, 24px);
  align-items: start; min-width: 0;
}
.ui-sidebar-layout-right > .ui-sidebar-layout-in { grid-template-columns: minmax(0, 1fr) var(--ui-sidebar-w, 260px); }
.ui-sidebar-layout-right > .ui-sidebar-layout-in > .ui-sidebar-layout-aside { order: 1; }
.ui-sidebar-layout-aside, .ui-sidebar-layout-main { min-width: 0; }
.ui-sidebar-layout-main { align-self: stretch; }
.ui-sidebar-layout-sticky > .ui-sidebar-layout-in > .ui-sidebar-layout-aside { position: sticky; top: var(--ui-sidebar-top, 16px); }
@container (max-width: 479px) {
  .ui-sidebar-layout-sm > .ui-sidebar-layout-in { grid-template-columns: minmax(0, 1fr); }
  .ui-sidebar-layout-sm > .ui-sidebar-layout-in > .ui-sidebar-layout-aside { order: 1; position: static; }
  .ui-sidebar-layout-sm.ui-sidebar-layout-first > .ui-sidebar-layout-in > .ui-sidebar-layout-aside { order: 0; }
}
@container (max-width: 639px) {
  .ui-sidebar-layout-md > .ui-sidebar-layout-in { grid-template-columns: minmax(0, 1fr); }
  .ui-sidebar-layout-md > .ui-sidebar-layout-in > .ui-sidebar-layout-aside { order: 1; position: static; }
  .ui-sidebar-layout-md.ui-sidebar-layout-first > .ui-sidebar-layout-in > .ui-sidebar-layout-aside { order: 0; }
}
@container (max-width: 899px) {
  .ui-sidebar-layout-lg > .ui-sidebar-layout-in { grid-template-columns: minmax(0, 1fr); }
  .ui-sidebar-layout-lg > .ui-sidebar-layout-in > .ui-sidebar-layout-aside { order: 1; position: static; }
  .ui-sidebar-layout-lg.ui-sidebar-layout-first > .ui-sidebar-layout-in > .ui-sidebar-layout-aside { order: 0; }
}
`

fn sidebar_layout_gap(gap) -> str =
    match gap {
        int as n => `${n}px`
        float as n => `${n}px`
        "none" => "0"
        "xs" => "4px"
        "sm" => "8px"
        "md" => "16px"
        "xl" => "32px"
        _ => "24px"
    }

view SidebarLayout(sidebar = null, side: str = "left", width: str = "260px", gap = 24, stack: str = "md",
                   first: bool = false, sticky: bool = false, class: str? = null, children) {
    style global sidebar_layout_css
    <div class={ui_cls(["ui-sidebar-layout", side == "right" && "ui-sidebar-layout-right", stack != "none" && `ui-sidebar-layout-${stack}`,
                        first && "ui-sidebar-layout-first", sticky && "ui-sidebar-layout-sticky", class])}
         style={`--ui-sidebar-w: ${width}; --ui-sidebar-gap: ${sidebar_layout_gap(gap)}`}>
        <div.ui-sidebar-layout-in>
            <aside.ui-sidebar-layout-aside>{sidebar}</aside>
            <div.ui-sidebar-layout-main>{children}</div>
        </div>
    </div>
}
