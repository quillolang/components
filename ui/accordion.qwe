// Accordion: sections that open and close under their titles, on the browser's own
// <details>, so they work without JavaScript, with the keyboard, and with find-in-page.
//
//   <Accordion>
//       <AccordionItem title="What does it cost?" open={true}><p>Nothing to start.</p></AccordionItem>
//       <AccordionItem title="Can I cancel?"><p>Any time, from Settings.</p></AccordionItem>
//   </Accordion>
//
// AccordionItem: title (the line you click), open (open to start with), children.
// group: items with the same group are exclusive, as radio buttons are: opening
// one closes the others (<details name>). Give every item of the accordion the
// same group, unique on the page. hint: a quieter line under the title.
// Accordion: flush={true} drops the box around the items, for a list in a card.

let accordion_css = css`
.ui-accordion { border: 1px solid var(--ui-border); border-radius: var(--ui-radius); background: var(--ui-surface);
  font: 15px/1.5 var(--ui-font); color: var(--ui-fg); interpolate-size: allow-keywords; }
.ui-accordion-flush { border-width: 1px 0 0; border-radius: 0; background: transparent; }
.ui-accordion-item + .ui-accordion-item, .ui-accordion-flush .ui-accordion-item { border-top: 1px solid var(--ui-border); }
.ui-accordion-flush .ui-accordion-item:first-child { border-top: 0; }
.ui-accordion-flush { border-bottom: 1px solid var(--ui-border); }
.ui-accordion-item > summary {
  display: flex; align-items: center; gap: 12px; padding: 14px 16px; cursor: pointer; list-style: none;
  font-weight: 500; border-radius: var(--ui-radius);
}
.ui-accordion-flush .ui-accordion-item > summary { padding-left: 2px; padding-right: 2px; }
.ui-accordion-item > summary::-webkit-details-marker { display: none; }
.ui-accordion-item > summary:hover { color: var(--ui-accent); }
.ui-accordion-item > summary:focus-visible { outline: none; box-shadow: inset 0 0 0 2px var(--ui-accent); }
.ui-accordion-title { flex: 1; display: grid; gap: 1px; }
.ui-accordion-hint { color: var(--ui-muted); font-size: 13px; font-weight: 400; }
.ui-accordion-chev {
  flex: none; width: 8px; height: 8px; margin: -4px 4px 0; border: solid var(--ui-muted); border-width: 0 1.5px 1.5px 0;
  transform: rotate(45deg); transition: transform .2s;
}
.ui-accordion-item[open] > summary .ui-accordion-chev { transform: translateY(3px) rotate(-135deg); }
.ui-accordion-body { padding: 0 16px 16px; color: var(--ui-muted); }
.ui-accordion-flush .ui-accordion-body { padding-left: 2px; padding-right: 2px; }
.ui-accordion-body > :first-child { margin-top: 0; }
.ui-accordion-body > :last-child { margin-bottom: 0; }
.ui-accordion-item::details-content { block-size: 0; overflow: hidden; transition: block-size .2s, content-visibility .2s allow-discrete; }
.ui-accordion-item[open]::details-content { block-size: auto; }
@media (prefers-reduced-motion: reduce) {
  .ui-accordion-chev, .ui-accordion-item::details-content { transition: none; }
}
`

view Accordion(flush: bool = false, class: str? = null, children) {
    style global accordion_css
    <div class={ui_cls(["ui-accordion", flush && "ui-accordion-flush", class])}>{children}</div>
}

view AccordionItem(title: str, hint: str? = null, open: bool = false, group: str? = null, class: str? = null, children) {
    style global accordion_css
    <details class={ui_cls(["ui-accordion-item", class])} name={group} open={open}>
        <summary>
            <span.ui-accordion-title>{title}{hint != null && <span.ui-accordion-hint>{hint}</span>}</span>
            <span.ui-accordion-chev aria-hidden="true"></span>
        </summary>
        <div.ui-accordion-body>{children}</div>
    </details>
}
