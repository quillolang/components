// Caption: small muted text under a figure, a table or a field: where a picture is
// from, what a chart shows, a note under an input.
//
//   <figure><img src="/chart.png" alt="Sales by month"/><Caption>Sales, January to June.</Caption></figure>
//   <table><Caption tag="caption">Orders this week</Caption>...</table>
//   <Caption tag="p" align="start">Shown to no one but you.</Caption>
//
// children: the text. tag: "figcaption" (default), "caption" (a table's, shown under
// it), "p", "div" or "span". align: "start" (default), "center" or "end".
// tone: "muted" (default) or "fg". size: "sm" (default, 13px) or "xs" (12px).
// id: the element's id (an aria-describedby can point to it).

import ui/theme.qwe use ui_cls

let caption_css = css`
.ui-caption { display: block; margin: 6px 0 0; font: 13px/1.5 var(--ui-font); color: var(--ui-muted); overflow-wrap: anywhere; }
caption.ui-caption { display: table-caption; caption-side: bottom; padding: 6px 0 0; }
span.ui-caption { display: inline; margin: 0; }
.ui-caption-center { text-align: center; }
.ui-caption-end { text-align: end; }
.ui-caption-fg { color: var(--ui-fg); }
.ui-caption-xs { font-size: 12px; }
.ui-caption a { color: inherit; text-decoration: underline; text-underline-offset: 2px; }
`

view Caption(tag: str = "figcaption", align: str = "start", tone: str = "muted", size: str = "sm", id: str? = null,
             class: str? = null, children) {
    style global caption_css
    let cls = ui_cls(["ui-caption", align != "start" && `ui-caption-${align}`, tone != "muted" && `ui-caption-${tone}`,
                      size != "sm" && `ui-caption-${size}`, class])
    match tag {
        "caption" => <caption class={cls} id={id}>{children}</caption>
        "p" => <p class={cls} id={id}>{children}</p>
        "div" => <div class={cls} id={id}>{children}</div>
        "span" => <span class={cls} id={id}>{children}</span>
        _ => <figcaption class={cls} id={id}>{children}</figcaption>
    }
}
