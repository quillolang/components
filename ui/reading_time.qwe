// ReadingTime: "4 min read", worked out from a text (or a word count), for the
// top of an article.
//
//   <ReadingTime text={post.body}/>
//   <ReadingTime words={1850} wpm={250} icon={false}/>
//   <ReadingTime text={post.body} format="{n} minutes" less="Under a minute"/>
//
// text: the article (Markdown or plain; tags and marks count as words, close
// enough). words: the count, when known, instead of text. wpm: words read a
// minute (200). format: what it says, with {n} for the minutes ("{n} min read").
// less: what it says under a minute ("1 min read"). icon: a small clock before
// it (true). size: "sm" or "md" (default). reading_time_minutes(text, wpm) and
// reading_time_words(text) give the numbers for your own markup.

let reading_time_css = css`
.ui-readtime { display: inline-flex; align-items: center; gap: 5px; vertical-align: middle; font: 13px/1.4 var(--ui-font); color: var(--ui-muted);
  white-space: nowrap; }
.ui-readtime svg { flex: none; width: 14px; height: 14px; }
.ui-readtime-sm { font-size: 12px; }
.ui-readtime-sm svg { width: 12px; height: 12px; }
`

// How many words a text has: runs of characters that are not spaces.
fn reading_time_words(text: str) -> int = len(re.find_all(text, "\\S+"))

// Whole minutes to read `words` words at `wpm`, at least 1.
fn reading_time_minutes(words: int, wpm: int = 200) -> int = max([1, round(words / (wpm < 1 ? 200 : wpm))])

view ReadingTime(text: str? = null, words: int? = null, wpm: int = 200, format: str = "{n} min read", less: str? = null,
                 icon: bool = true, size: str = "md", id: str? = null, class: str? = null) {
    style global reading_time_css
    let count = words ?? reading_time_words(text ?? "")
    let mins = reading_time_minutes(count, wpm)
    let under = count < wpm && less != null
    let said = under ? less : replace(format, "{n}", str(mins))
    <span class={ui_cls(["ui-readtime", size != "md" && `ui-readtime-${size}`, class])} id={id}
          title={`${count} words`}>
        {icon && <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
                      stroke-linejoin="round" aria-hidden="true"><circle cx="8" cy="8" r="6"/><path d="M8 4.8V8l2.2 1.5"/></svg>}
        <span>{said}</span>
    </span>
}
