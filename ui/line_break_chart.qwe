// LineBreakChart: a three-line break chart, worked out from closing prices: a new
// line (a box from the last line's end to the close) each time the close goes past
// the last line's end, and a line the other way only when it goes past the far end
// of the last three lines, so small turns are left out and time drops out. Green
// lines rise, red ones fall. CSS only: hovering a line shows its range and when it
// formed, and screen readers get the lines as a table.
//
//   <LineBreakChart label="ACME, three-line break" candles={bars} prefix="$"/>
//   <LineBreakChart label="ACME, two-line break" candles={bars} lines={2}/>
//   <LineBreakChart label="Index" closes={[4012.5, 4020.1, 4031.8, 4018.2]}/>
//
// candles: a list of { time, close } (OHLC candles do), oldest first; or closes: the
// numbers alone, without times. lines: how many lines a turn must break (3).
// height: the plot's height in pixels (280). last_line: a dashed line at the last
// close, with its price on the axis (true). prefix and suffix: around every price shown
// ("$"); decimals: digits after the point of prices (2). label: what the chart shows;
// it names it for screen readers and captions their table. show_label also writes it
// above the chart.

let line_break_chart_css = css`
.ui-lbc { --ui-lbc-up: var(--ui-success); --ui-lbc-down: var(--ui-danger);
  display: grid; gap: 10px; min-width: 0; margin: 0; font: 12px/1.3 var(--ui-font); color: var(--ui-fg); }
.ui-lbc-title { margin: 0; font-size: 14px; font-weight: 600; }
.ui-lbc-meta { margin: 0; color: var(--ui-muted); font-size: 13px; }
.ui-lbc-up { --k: var(--ui-lbc-up); } .ui-lbc-down { --k: var(--ui-lbc-down); }
.ui-lbc-frame { display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: 8px; padding-top: 8px; }
.ui-lbc-plot { position: relative; height: var(--h); }
.ui-lbc-grid { position: absolute; left: 0; right: 0; height: 1px; background: color-mix(in srgb, var(--ui-border) 70%, transparent); }
.ui-lbc-last { position: absolute; z-index: 1; left: 0; right: 0; border-top: 1px dashed var(--k); opacity: .75; pointer-events: none; }
.ui-lbc-cols { position: absolute; inset: 0; display: flex; }
.ui-lbc-col { position: relative; flex: 1; min-width: 0; }
.ui-lbc-col:hover { background: color-mix(in srgb, var(--ui-subtle) 70%, transparent); }
.ui-lbc-box { position: absolute; left: 8%; right: 8%; min-height: 2px; border: 1px solid var(--k); border-radius: 2px;
  background: color-mix(in srgb, var(--k) 70%, transparent); }
.ui-lbc-down .ui-lbc-box { background: color-mix(in srgb, var(--k) 18%, transparent); }
.ui-lbc-col:hover .ui-lbc-box { background: var(--k); }
.ui-lbc-tip { position: absolute; z-index: 20; top: 0; left: calc(50% + 12px); display: none; min-width: 150px; padding: 7px 10px;
  border: 1px solid var(--ui-border); border-radius: var(--ui-radius-sm); background: var(--ui-surface);
  box-shadow: var(--ui-shadow); color: var(--ui-fg); font-size: 12px; pointer-events: none; }
.ui-lbc-flip .ui-lbc-tip { left: auto; right: calc(50% + 12px); }
.ui-lbc-col:hover .ui-lbc-tip { display: block; }
.ui-lbc-tip strong { display: block; margin-bottom: 3px; font-weight: 600; white-space: nowrap; color: var(--k); }
.ui-lbc-tip p { display: flex; align-items: center; gap: 6px; margin: 2px 0 0; color: var(--ui-muted); white-space: nowrap; }
.ui-lbc-tip b { margin-left: auto; padding-left: 12px; color: var(--ui-fg); font-weight: 600; font-variant-numeric: tabular-nums; }
.ui-lbc-y { position: relative; height: var(--h); }
.ui-lbc-y span { position: absolute; left: 0; transform: translateY(-50%); color: var(--ui-muted); font-variant-numeric: tabular-nums; white-space: nowrap; }
.ui-lbc-y .ui-lbc-tag { z-index: 1; left: -4px; padding: 1px 4px; border-radius: 3px; background: var(--k); color: var(--ui-bg); font-weight: 600; }
.ui-lbc-x { position: relative; height: 16px; margin-top: 6px; }
.ui-lbc-x span { position: absolute; top: 0; transform: translateX(-50%); color: var(--ui-muted); white-space: nowrap; }
.ui-lbc-x .ui-lbc-first { transform: none; }
.ui-lbc-x .ui-lbc-end { transform: translateX(-100%); }
.ui-lbc-empty { display: grid; place-items: center; height: var(--h); border: 1px dashed var(--ui-border); border-radius: var(--ui-radius-sm); color: var(--ui-muted); }
`

// n (a whole number, 0 or more) with at least `width` digits.
fn line_break_chart_pad(n: int, width: int) -> str {
    let s = str(n)
    len(s) < width ? repeat("0", width - len(s)) + s : s
}

// A whole number with commas: 1234567 is "1,234,567".
fn line_break_chart_group(n: int) -> str =
    n < 1000 ? str(n) : line_break_chart_group(floor(n / 1000)) + "," + line_break_chart_pad(n % 1000, 3)

// A value as it reads, with commas and `places` digits after the point (up to two as
// needed when that is null): 48210.5 is "48,210.50" with 2. Worked out in whole
// numbers, so the server and the browser write the same text.
fn line_break_chart_num(v: num, places: int? = null) -> str {
    let digits = places == null ? 2 : (places < 0 ? 0 : (places > 6 ? 6 : places))
    let scale = [1, 10, 100, 1000, 10000, 100000, 1000000][digits]
    let units = round(abs(v) * scale)
    let frac = units % scale
    let tail = digits == 0 || (places == null && frac == 0) ? ""
        : (places == null && frac % 10 == 0 ? `.${floor(frac / 10)}` : `.${line_break_chart_pad(frac, digits)}`)
    `${v < 0 && units > 0 ? "-" : ""}${line_break_chart_group(floor(units / scale))}${tail}`
}

// A large number, short: 1500 is "1.5k", 2000000 is "2M", 0.25 is "0.25".
fn line_break_chart_short(v: num) -> str {
    let a = abs(v)
    let unit = a >= 1000000000 ? 1000000000 : (a >= 1000000 ? 1000000 : (a >= 1000 ? 1000 : 1))
    let tenths = round(a * 10 / unit)
    let mark = unit == 1000000000 ? "B" : (unit == 1000000 ? "M" : "k")
    unit == 1 ? line_break_chart_num(v)
        : `${v < 0 ? "-" : ""}${line_break_chart_group(floor(tenths / 10))}${tenths % 10 != 0 ? `.${tenths % 10}` : ""}${mark}`
}

// A change in percent, signed, to two decimals: "+1.25%", "-0.40%".
fn line_break_chart_signed(p: num) -> str = `${p > 0 ? "+" : (p < 0 && round(abs(p) * 100) > 0 ? "-" : "")}${line_break_chart_num(abs(p), 2)}%`

// A coordinate out of 100 (or a length), to two decimals.
fn line_break_chart_pct(n: num) -> str {
    let r = round(n * 100) / 100
    r == floor(r) ? str(floor(r)) : str(r)
}

// The axis from lo to hi, widened to round ticks: about `steps` steps of 1, 2, 2.5 or 5 x 10^n.
fn line_break_chart_scale(lo: num, hi: num, steps: int = 5) -> map {
    let span = hi - lo == 0 ? (lo == 0 ? 1 : abs(lo) / 10) : hi - lo
    let raw = span / steps
    let mag = 1
    while mag * 10 <= raw { mag = mag * 10 }
    while mag > raw { mag = mag / 10 }
    let r = raw / mag
    let step = (r <= 1 ? 1 : (r <= 2 ? 2 : (r <= 2.5 ? 2.5 : (r <= 5 ? 5 : 10)))) * mag
    let a = floor(lo / step + 0.000001)
    let b0 = ceil(hi / step - 0.000001)
    let b = b0 == a ? a + 1 : b0
    { lo: a * step, hi: b * step, ticks: for i in range(b - a + 1) => (a + i) * step }
}

// A candle's time as it reads: "Mar 2, 2026" for a date, "Mar 2, 14:30" for a date-time.
fn line_break_chart_when(t) -> str =
    type_of(t) != "str" || !date.valid(t) ? str(t) : (len(t) > 10 ? date.format(t, "MMM D, HH:mm") : date.format(t, "MMM D, YYYY"))

// Where the time axis is labelled: about `limit` of { i, text }, at the starts of years,
// months or days when the times cross them ("2026", "Mar", "Mar 2"), else every few
// candles ("14:30", "Mar 2").
fn line_break_chart_ticks(times: list, limit: int) -> list {
    let n = len(times)
    let thin = (idx: list) => {
        let step = ceil(len(idx) / limit)
        range(len(idx)) | filter((k) => k % step == 0) | map((k) => idx[k])
    }
    let spaced = (fmt_at) => {
        let step = ceil(n / limit)
        range(n) | filter((i) => i % step == floor(step / 2)) | map((i) => { i, text: fmt_at(i) })
    }
    if n == 0 { return [] }
    if !all(times, (t) => type_of(t) == "str" && date.valid(t)) { return spaced((i) => str(times[i])) }
    let days = times | map((t) => slice(t, 0, 10))
    let changes = (keys: list) => range(1, n) | filter((i) => keys[i] != keys[i - 1])
    let day_starts = changes(days)
    let month_starts = changes(days | map((d) => slice(d, 0, 7)))
    let year_starts = changes(days | map((d) => slice(d, 0, 4)))
    let picked = if any(times, (t) => len(t) > 10) {
        len(day_starts) >= 3
            ? thin(day_starts) | map((i) => { i, text: date.format(days[i], "MMM D") })
            : spaced((i) => index_of(day_starts, i) != null ? date.format(days[i], "MMM D") : date.format(times[i], "HH:mm"))
    } else if len(year_starts) >= 3 && len(month_starts) > limit * 2 {
        thin(year_starts) | map((i) => { i, text: slice(days[i], 0, 4) })
    } else if len(month_starts) >= 2 {
        thin(month_starts) | map((i) => { i, text: index_of(year_starts, i) != null ? slice(days[i], 0, 4) : date.format(days[i], "MMM") })
    } else {
        spaced((i) => date.format(days[i], "MMM D"))
    }
    // Starts that fall close together (a short month) keep the first.
    let gap = n / (limit * 1.5)
    reduce(picked, [], (kept, t) => len(kept) == 0 || t.i - kept[-1].i >= gap ? kept + [t] : kept)
}

// The lines: a list of { up, lo, hi, time, close }, the time and close of the candle that
// made each. The same way on: from the last line's end to a close past it. A turn: from
// the last line's start, when the close goes past the far end of the last `count` lines.
fn line_break_chart_lines(points: list, count: int) -> list {
    let out = []
    if len(points) == 0 { return out }
    let start = points[0].close
    for p in drop(points, 1) {
        let c = p.close
        if len(out) == 0 {
            if c != start { out = out | push({ up: c > start, lo: min([c, start]), hi: max([c, start]), time: p.time, close: c }) }
        } else {
            let last = out[-1]
            let recent = take(reverse(out), count < 1 ? 1 : count)
            if last.up && c > last.hi {
                out = out | push({ up: true, lo: last.hi, hi: c, time: p.time, close: c })
            } else if last.up && c < min(recent | map((l) => l.lo)) {
                out = out | push({ up: false, lo: c, hi: last.lo, time: p.time, close: c })
            } else if !last.up && c < last.lo {
                out = out | push({ up: false, lo: c, hi: last.lo, time: p.time, close: c })
            } else if !last.up && c > max(recent | map((l) => l.hi)) {
                out = out | push({ up: true, lo: last.hi, hi: c, time: p.time, close: c })
            }
        }
    }
    out
}

view LineBreakChart(candles: list = [], closes: list? = null, lines: int = 3, height: int = 280, last_line: bool = true,
                prefix: str = "", suffix: str = "", decimals: int = 2, label: str = "Line break chart",
                show_label: bool = false, class: str? = null) {
    style global line_break_chart_css
    let points = closes != null ? (closes | map((c) => { time: null, close: c })) : (candles | map((c) => { time: c.time, close: c.close }))
    let vals = points | map((p) => p.close)
    let steps = line_break_chart_lines(points, lines)
    let n = len(steps)
    let last = len(vals) > 0 ? vals[-1] : null
    let known = flatten(steps | map((b) => [b.lo, b.hi])) + (last != null ? [last] : [])
    let sc = line_break_chart_scale(len(known) == 0 ? 0 : min(known), len(known) == 0 ? 1 : max(known), 5)
    let y = (v) => (sc.hi - v) * 100 / (sc.hi - sc.lo)
    let x = (i) => (i + 0.5) * 100 / n
    let pct = (v) => line_break_chart_pct(v)
    let price = (v) => `${v < 0 ? "-" : ""}${prefix}${line_break_chart_num(abs(v), decimals)}${suffix}`
    let tick = (t) => `${t < 0 ? "-" : ""}${prefix}${line_break_chart_num(abs(t))}`
    let side = (up) => up ? "ui-lbc-up" : "ui-lbc-down"
    let last_up = n == 0 || steps[-1].up
    let timed = n > 0 && all(steps, (b) => b.time != null)
    let axis_width = max([4] + (sc.ticks | map((t) => len(tick(t)))) + [last != null ? len(price(last)) + 1 : 0])
    <figure class={ui_cls(["ui-lbc", class])} aria-label={label} style={`--h: ${height}px`}>
        {show_label && <figcaption.ui-lbc-title>{label}</figcaption>}
        <p.ui-lbc-meta>{lines}-line break · {n} {n == 1 ? "line" : "lines"}</p>
        {n == 0 ? <div.ui-lbc-empty>The price has not moved.</div>
            : <div.ui-lbc-frame aria-hidden="true">
            <div.ui-lbc-plot>
                {for t in sc.ticks => <span.ui-lbc-grid style={`top: ${pct(y(t))}%`}></span>}
                {last_line && last != null && <span class={`ui-lbc-last ${side(last_up)}`} style={`top: ${pct(y(last))}%`}></span>}
                <div.ui-lbc-cols>
                    {for [i, b] in enumerate(steps) => <div class={ui_cls(["ui-lbc-col", side(b.up), n > 1 && i >= n / 2 && "ui-lbc-flip"])}>
                        <span.ui-lbc-box style={`top: ${pct(y(b.hi))}%; height: ${pct(y(b.lo) - y(b.hi))}%`}></span>
                        <span.ui-lbc-tip>
                            <strong>{b.up ? "Up" : "Down"} line {i + 1}</strong>
                            <p>From<b>{price(b.up ? b.lo : b.hi)}</b></p>
                            <p>To<b>{price(b.up ? b.hi : b.lo)}</b></p>
                            {b.time != null && <p>Formed<b>{line_break_chart_when(b.time)}</b></p>}
                            <p>Close then<b>{price(b.close)}</b></p>
                        </span>
                    </div>}
                </div>
            </div>
            <div.ui-lbc-y style={`width: ${axis_width}ch`}>
                {for t in sc.ticks => !(last_line && last != null && abs(y(t) - y(last)) * height < 1400) &&
                    <span style={`top: ${pct(y(t))}%`}>{tick(t)}</span>}
                {last_line && last != null && <span class={`ui-lbc-tag ${side(last_up)}`} style={`top: ${pct(y(last))}%`}>{price(last)}</span>}
            </div>
            <div.ui-lbc-x>
                {timed && (for t in line_break_chart_ticks(steps | map((b) => b.time), 7) => <span
                    class={ui_cls([x(t.i) < 4 && "ui-lbc-first", x(t.i) > 96 && "ui-lbc-end"])} style={`left: ${pct(x(t.i))}%`}>{t.text}</span>)}
            </div>
            <span></span>
        </div>}
        <table.ui-sr>
            <caption>{label}: {lines}-line break</caption>
            <thead><tr><th scope="col">Line</th><th scope="col">Direction</th><th scope="col">From</th><th scope="col">To</th>
                {timed && <th scope="col">Formed</th>}</tr></thead>
            <tbody>
                {for [i, b] in enumerate(steps) => <tr>
                    <th scope="row">{i + 1}</th><td>{b.up ? "Up" : "Down"}</td>
                    <td>{price(b.up ? b.lo : b.hi)}</td><td>{price(b.up ? b.hi : b.lo)}</td>
                    {timed && <td>{line_break_chart_when(b.time)}</td>}
                </tr>}
            </tbody>
        </table>
    </figure>
}
