// SitemapList: a site's pages as a nested list of links, each section's pages under
// it, as deep as the site goes: for a site map page, or the "All pages" part of a
// footer. Sections can run across columns on a wide screen.
//
//   <SitemapList columns={3} pages={[
//       { label: "Docs", href: "/docs", children: [
//           { label: "Install", href: "/docs/install" },
//           { label: "Language", href: "/docs/language", children: [{ label: "Values", href: "/docs/language/values" }] }
//       ] },
//       { label: "Blog", href: "/blog" }
//   ]}/>
//
// pages: { label, href?, children?: [...] }; a page without an href is a heading
// only. current: the href of this page, marked aria-current="page". columns: how
// many columns the top-level sections may flow into on a wide screen (1); they
// become one on narrow screens. label: what screen readers call it ("Site map").

let sitemap_list_css = css`
.ui-sitemap { font: 14px/1.6 var(--ui-font); color: var(--ui-fg); }
.ui-sitemap-cols { columns: var(--ui-sitemap-cols, 1); column-gap: 32px; }
.ui-sitemap ul { margin: 0; padding: 0; list-style: none; }
.ui-sitemap ul ul { margin: 2px 0 6px 10px; padding-left: 12px; border-left: 1px solid var(--ui-border); }
.ui-sitemap-cols > ul > li { break-inside: avoid; margin-bottom: 14px; }
.ui-sitemap-cols > ul > li > .ui-sitemap-link, .ui-sitemap-cols > ul > li > .ui-sitemap-text { font-weight: 650; font-size: 15px; }
.ui-sitemap-link, .ui-sitemap-text { display: inline-block; padding: 1px 4px; margin-left: -4px; border-radius: 4px; color: var(--ui-fg); text-decoration: none; }
.ui-sitemap-link { color: var(--ui-muted); }
.ui-sitemap-cols > ul > li > .ui-sitemap-link { color: var(--ui-fg); }
.ui-sitemap-link:hover { color: var(--ui-accent); text-decoration: underline; text-underline-offset: 3px; }
.ui-sitemap-link:focus-visible { outline: none; box-shadow: var(--ui-focus); }
.ui-sitemap-link[aria-current="page"] { color: var(--ui-accent); font-weight: 600; }
@media (max-width: 640px) { .ui-sitemap-cols { columns: 1; } }
`

fn sitemap_list_node(p, current: str?) =
    <li>
        {get(p, "href") != null
            ? <a.ui-sitemap-link href={p.href} aria-current={current != null && p.href == current ? "page" : null}>{p.label}</a>
            : <span.ui-sitemap-text>{p.label}</span>}
        {len(get(p, "children") ?? []) > 0 && <ul>{for c in p.children => sitemap_list_node(c, current)}</ul>}
    </li>

view SitemapList(pages: list = [], current: str? = null, columns: int = 1, label: str = "Site map", id: str? = null,
                 class: str? = null) {
    style global sitemap_list_css
    <nav class={ui_cls(["ui-sitemap", class])} id={id} aria-label={label}>
        <div.ui-sitemap-cols style={`--ui-sitemap-cols: ${max([columns, 1])}`}>
            <ul>{for p in pages => sitemap_list_node(p, current)}</ul>
        </div>
    </nav>
}
