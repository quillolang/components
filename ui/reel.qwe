// Reel: a strip of things that scrolls sideways: cards, photos, chips, a row of
// days. It snaps to each item, scrolls with a swipe, a wheel or the keyboard (it
// takes focus), and shows a slim scrollbar, or none. No script runs.
//
//   <Reel label="Recently viewed" item_width="220px"> {for p in products => <ProductCard .../>} </Reel>
//   <Reel gap="sm" snap="center" bar={false}> {for d in days => <DayChip .../>} </Reel>
//
// item_width: every item's width, as CSS ("220px"; left out, each is as wide as it is).
// gap: pixels (12, the default) or "none", "xs" (4), "sm" (8), "md" (12), "lg" (20), "xl" (32).
// snap: where scrolling stops, each item's "start" (default) or "center", or "none".
// bar: the scrollbar shows (true). pad: room inside, in pixels (0), kept by the snapping.
// label: its name for screen readers; it then takes focus, so the arrow keys scroll it.
// height: the strip's height, as CSS; then an <img> in it is that tall and as wide
// as its shape says.

let reel_css = css`
.ui-reel {
  display: flex; gap: var(--ui-reel-gap, 12px); min-width: 0; padding: var(--ui-reel-pad, 0); overflow: auto hidden;
  overscroll-behavior-x: contain; scroll-snap-type: x proximity; scroll-padding-inline: var(--ui-reel-pad, 0);
  scrollbar-width: thin; scrollbar-color: var(--ui-strong) transparent; outline: none; border-radius: var(--ui-radius-sm);
}
.ui-reel > *, .ui-reel > quillo-raw > * { flex: none; width: var(--ui-reel-item, auto); min-width: 0; scroll-snap-align: start; }
.ui-reel-center > *, .ui-reel-center > quillo-raw > * { scroll-snap-align: center; }
.ui-reel-nosnap { scroll-snap-type: none; }
.ui-reel-tall > img, .ui-reel-tall > quillo-raw > img { width: auto; height: var(--ui-reel-h); }
.ui-reel-nobar { scrollbar-width: none; }
.ui-reel-nobar::-webkit-scrollbar { display: none; }
.ui-reel:focus-visible { box-shadow: var(--ui-focus); }
@media (prefers-reduced-motion: no-preference) { .ui-reel { scroll-behavior: smooth; } }
`

fn reel_gap(gap) -> str =
    match gap {
        int as n => `${n}px`
        float as n => `${n}px`
        "none" => "0"
        "xs" => "4px"
        "sm" => "8px"
        "lg" => "20px"
        "xl" => "32px"
        _ => "12px"
    }

view Reel(item_width: str? = null, gap = 12, snap: str = "start", bar: bool = true, pad: int = 0, label: str? = null,
          height: str? = null, id: str? = null, class: str? = null, children) {
    style global reel_css
    <div class={ui_cls(["ui-reel", snap == "center" && "ui-reel-center", snap == "none" && "ui-reel-nosnap",
                        !bar && "ui-reel-nobar", height != null && "ui-reel-tall", class])}
         id={id} tabindex={label != null ? "0" : null} role={label != null ? "region" : null} aria-label={label}
         style={`--ui-reel-gap: ${reel_gap(gap)}; --ui-reel-item: ${item_width ?? "auto"}; --ui-reel-pad: ${pad}px${height != null ? `; --ui-reel-h: ${height}` : ""}`}>
        {children}
    </div>
}
