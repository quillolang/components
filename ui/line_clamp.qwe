// LineClamp: text cut after a number of lines, with an ellipsis on the last: a
// description in a card, a comment in a list.
//
//   <LineClamp lines={2} text={product.description}/>
//   <LineClamp lines={3}><p>Any HTML, cut after three lines.</p></LineClamp>
//
// lines: how many to show (3); 0 shows it all. text: the text; its whole is then the
// element's title, shown on hover. children: HTML instead of text. tag: "div"
// (default), "p" or "span". id: the element's id. For a Read more button, see ReadMore.

import ui/theme.qwe use ui_cls

let line_clamp_css = css`
.ui-clamp { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: var(--ui-clamp, 3); overflow: hidden;
  overflow-wrap: anywhere; }
.ui-clamp > :first-child { margin-top: 0; }
.ui-clamp > :last-child { margin-bottom: 0; }
p.ui-clamp { margin: 0; }
`

view LineClamp(lines: int = 3, text: str? = null, tag: str = "div", id: str? = null, class: str? = null, children) {
    style global line_clamp_css
    let cls = ui_cls([lines > 0 && "ui-clamp", class])
    let style = lines > 0 ? `--ui-clamp: ${lines}` : null
    let body = text ?? children
    match tag {
        "p" => <p class={cls} id={id} title={text} style={style}>{body}</p>
        "span" => <span class={cls} id={id} title={text} style={style}>{body}</span>
        _ => <div class={cls} id={id} title={text} style={style}>{body}</div>
    }
}
