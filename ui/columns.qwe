// Columns: its children side by side, each as wide as the others or as the weights
// say, and one under another where there is no room. It measures its own width,
// not the window's, so it works inside a card or a sidebar too.
//
//   <Columns> <Card>...</Card> <Card>...</Card> <Card>...</Card> </Columns>
//   <Columns widths={[2, 1]} gap="lg" stack="lg"> <article>...</article> <aside>...</aside> </Columns>
//   <Columns widths={[1, 2]} reverse={true}> <img .../> <div>...</div> </Columns>
//
// widths: the columns' shares of the width, in order ([2, 1]: the first twice as wide;
// [1, 1, 2] for three); left out, they share it equally, however many there are.
// gap: pixels (16, the default) or "none", "xs" (4), "sm" (8), "md" (16), "lg" (24), "xl" (32).
// align: "stretch" (default), "start", "center" or "end", down the row.
// stack: when they go one under another: narrower than "sm" (480px), "md" (640px, the
// default), "lg" (900px), or "none" (never). reverse: stacked, the last column comes
// first (an image written last, shown first on a phone).

let columns_css = css`
.ui-columns { container-type: inline-size; min-width: 0; }
.ui-columns-in {
  display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); grid-template-columns: var(--ui-columns-tpl, none);
  gap: var(--ui-columns-gap, 16px); align-items: var(--ui-columns-align, stretch); min-width: 0;
}
.ui-columns-in > *, .ui-columns-in > quillo-raw > * { min-width: 0; }
@container (max-width: 479px) {
  .ui-columns-sm > .ui-columns-in { display: flex; flex-direction: column; }
  .ui-columns-sm.ui-columns-reverse > .ui-columns-in { flex-direction: column-reverse; }
  .ui-columns-sm > .ui-columns-in > *, .ui-columns-sm > .ui-columns-in > quillo-raw > * { flex: none; }
}
@container (max-width: 639px) {
  .ui-columns-md > .ui-columns-in { display: flex; flex-direction: column; }
  .ui-columns-md.ui-columns-reverse > .ui-columns-in { flex-direction: column-reverse; }
  .ui-columns-md > .ui-columns-in > *, .ui-columns-md > .ui-columns-in > quillo-raw > * { flex: none; }
}
@container (max-width: 899px) {
  .ui-columns-lg > .ui-columns-in { display: flex; flex-direction: column; }
  .ui-columns-lg.ui-columns-reverse > .ui-columns-in { flex-direction: column-reverse; }
  .ui-columns-lg > .ui-columns-in > *, .ui-columns-lg > .ui-columns-in > quillo-raw > * { flex: none; }
}
`

fn columns_gap(gap) -> str =
    match gap {
        int as n => `${n}px`
        float as n => `${n}px`
        "none" => "0"
        "xs" => "4px"
        "sm" => "8px"
        "lg" => "24px"
        "xl" => "32px"
        _ => "16px"
    }

fn columns_flex(v: str) -> str =
    match v {
        "start" => "flex-start"
        "end" => "flex-end"
        _ => v
    }

view Columns(widths: list? = null, gap = 16, align: str = "stretch", stack: str = "md", reverse: bool = false,
             class: str? = null, children) {
    style global columns_css
    let tpl = widths == null ? "none" : widths | map((w) => `minmax(0, ${w}fr)`) | join(" ")
    <div class={ui_cls(["ui-columns", stack != "none" && `ui-columns-${stack}`, reverse && "ui-columns-reverse", class])}
         style={`--ui-columns-gap: ${columns_gap(gap)}; --ui-columns-align: ${columns_flex(align)}; --ui-columns-tpl: ${tpl}`}>
        <div.ui-columns-in>{children}</div>
    </div>
}
