// VerticalTabs: tabs down the left side, each with an icon and a line of detail if
// it has one, and the selected tab's panel at the right: settings pages, a long form
// in sections, an account's areas. Real ARIA tabs driven by your component's state;
// the up and down arrow keys move between them. Under 640px the tabs go above the
// panel, in a row that scrolls.
//
//   <VerticalTabs id="settings" selected={tab} on_change={(i) => { tab = i }} tabs={[
//       { label: "Profile", hint: "Name, photo, bio", icon: "👤" },
//       { label: "Security", hint: "Password, 2FA", icon: "🔒" }
//   ]}>
//       {tab == 0 ? <ProfileForm/> : <SecurityForm/>}
//   </VerticalTabs>
//
// id (required): a prefix for the tabs' ids, unique on the page. tabs: strings, or
// { label, hint?, icon?, badge?, disabled? }. icon: a character or an emoji, or an SVG
// path (24x24, stroked) when it starts with "M". selected: the index showing first.
// children: the panel of the selected tab. width: the tabs column's width in pixels
// (220). label: what screen readers call the tabs. on_change(index): called with the
// tab picked.

import ui/theme.qwe use ui_cls

let vertical_tabs_css = css`
.ui-vtabs { display: grid; grid-template-columns: var(--ui-vtabs-w, 220px) minmax(0, 1fr); gap: 28px; font: 14px/1.4 var(--ui-font); color: var(--ui-fg); }
.ui-vtabs-list { display: flex; flex-direction: column; gap: 2px; margin: 0; padding: 0; border-right: 1px solid var(--ui-border); }
.ui-vtabs-tab {
  display: flex; align-items: center; gap: 10px; margin-right: -1px; padding: 9px 12px; border: 0; border-right: 2px solid transparent;
  border-radius: var(--ui-radius-sm) 0 0 var(--ui-radius-sm); background: transparent; color: var(--ui-muted); font: inherit;
  text-align: left; cursor: pointer; transition: color .12s, background .12s, border-color .12s;
}
.ui-vtabs-tab:hover { color: var(--ui-fg); background: var(--ui-subtle); }
.ui-vtabs-tab:focus-visible { outline: none; box-shadow: var(--ui-focus); }
.ui-vtabs-tab[aria-selected="true"] { color: var(--ui-accent); background: var(--ui-accent-soft); border-right-color: var(--ui-accent); }
.ui-vtabs-tab:disabled { opacity: .5; cursor: not-allowed; }
.ui-vtabs-icon { display: inline-grid; place-items: center; flex: none; width: 22px; height: 22px; font-size: 18px; line-height: 1; }
.ui-vtabs-icon svg { width: 20px; height: 20px; }
.ui-vtabs-text { flex: 1; min-width: 0; display: grid; gap: 1px; }
.ui-vtabs-label { font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ui-vtabs-hint { color: var(--ui-muted); font-size: 12px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ui-vtabs-badge {
  flex: none; min-width: 20px; padding: 1px 6px; border-radius: 999px; background: var(--ui-subtle); border: 1px solid var(--ui-border);
  color: var(--ui-muted); font-size: 12px; font-weight: 600; text-align: center;
}
.ui-vtabs-tab[aria-selected="true"] .ui-vtabs-badge { border-color: transparent; background: var(--ui-accent); color: var(--ui-accent-fg); }
.ui-vtabs-panel { min-width: 0; }
.ui-vtabs-panel > :first-child { margin-top: 0; }
.ui-vtabs-panel > :last-child { margin-bottom: 0; }
@media (max-width: 640px) {
  .ui-vtabs { grid-template-columns: 1fr; gap: 16px; }
  .ui-vtabs-list { flex-direction: row; overflow-x: auto; border-right: 0; border-bottom: 1px solid var(--ui-border); scrollbar-width: none; }
  .ui-vtabs-list::-webkit-scrollbar { display: none; }
  .ui-vtabs-tab { flex: none; margin: 0 0 -1px; border-right: 0; border-bottom: 2px solid transparent; border-radius: var(--ui-radius-sm) var(--ui-radius-sm) 0 0; }
  .ui-vtabs-tab[aria-selected="true"] { border-bottom-color: var(--ui-accent); }
  .ui-vtabs-hint { display: none; }
}
@media (prefers-reduced-motion: reduce) { .ui-vtabs-tab { transition: none; } }
`

component VerticalTabs(id: str, tabs: list = [], selected: int = 0, width: int = 220, label: str? = null, on_change = null,
                       class: str? = null, children) {
    style global vertical_tabs_css
    state at = selected
    let items = tabs | map((t) => type_of(t) == "str" ? { label: t } : t)
    let live = range(0, len(items)) | filter((i) => get(items[i], "disabled") != true)
    let pick = (i: int) => {
        at = i
        on_change && on_change(i)
    }
    <div class={ui_cls(["ui-vtabs", class])} style={`--ui-vtabs-w: ${width}px`}>
        <div.ui-vtabs-list role="tablist" aria-label={label} aria-orientation="vertical" @keydown={(e) => {
            let n = len(live)
            let k = index_of(live, at) ?? 0
            let to = match e.key {
                "ArrowDown" => live[(k + 1) % n]
                "ArrowUp" => live[(k + n - 1) % n]
                "Home" => live[0]
                "End" => live[n - 1]
                _ => null
            }
            if to != null && n > 0 {
                e.preventDefault()
                pick(to)
                e.currentTarget.querySelector(`[data-i="${to}"]`).focus()
            }
        }}>
            {for [i, t] in enumerate(items) => <button.ui-vtabs-tab type="button" role="tab" id={`${id}-tab-${i}`} data-i={i}
                    aria-selected={i == at ? "true" : "false"} aria-controls={`${id}-panel`} tabindex={i == at ? "0" : "-1"}
                    disabled={get(t, "disabled") == true} @click={() => { pick(i) }}>
                {get(t, "icon") != null && <span.ui-vtabs-icon aria-hidden="true">{starts_with(t.icon, "M") && len(t.icon) > 2
                    ? <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={t.icon}/></svg>
                    : t.icon}</span>}
                <span.ui-vtabs-text>
                    <span.ui-vtabs-label>{t.label}</span>
                    {get(t, "hint") != null && <span.ui-vtabs-hint>{t.hint}</span>}
                </span>
                {get(t, "badge") != null && <span.ui-vtabs-badge>{t.badge}</span>}
            </button>}
        </div>
        <div.ui-vtabs-panel id={`${id}-panel`} role="tabpanel" aria-labelledby={`${id}-tab-${at}`} tabindex="0">{children}</div>
    </div>
}
