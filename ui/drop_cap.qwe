// DropCap: a paragraph whose first letter is set large, dropped into the first few
// lines, as at the start of a chapter.
//
//   <DropCap>Once upon a time, in a server far away, a page rendered at once.</DropCap>
//   <DropCap lines={2} tone="accent" serif={true} text={chapter.opening}/>
//
// children: the text; or text, the text as a string. lines: how many lines the
// letter drops into, 2, 3 (default) or 4. tone: "fg" (default) or "accent".
// serif: the letter in a serif face. id: the paragraph's id.

let drop_cap_css = css`
.ui-drop-cap { margin: 0; font: 16px/1.6 var(--ui-font); color: var(--ui-fg); overflow-wrap: anywhere; }
.ui-drop-cap::first-letter { float: left; margin: .08em .12em 0 0; font-size: 3.1em; line-height: .78; font-weight: 700;
  color: var(--ui-dc, var(--ui-fg)); }
.ui-drop-cap-2::first-letter { font-size: 2.1em; line-height: .8; margin-top: .1em; }
.ui-drop-cap-4::first-letter { font-size: 4.1em; line-height: .78; margin-top: .06em; }
.ui-drop-cap-accent { --ui-dc: var(--ui-accent); }
.ui-drop-cap-serif::first-letter { font-family: Georgia, "Times New Roman", serif; font-weight: 600; }
`

view DropCap(lines: int = 3, tone: str = "fg", serif: bool = false, text: str? = null, id: str? = null,
             class: str? = null, children) {
    style global drop_cap_css
    <p class={ui_cls(["ui-drop-cap", lines != 3 && `ui-drop-cap-${lines}`, tone != "fg" && `ui-drop-cap-${tone}`,
                      serif && "ui-drop-cap-serif", class])} id={id}>{text ?? children}</p>
}
