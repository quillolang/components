// Sticky: keeps what it holds in view as the page (or the box it is in) scrolls
// past: a toolbar, a table's header row, a section's title, a buy button. It
// sticks to the top at an offset, or to the bottom.
//
//   <Sticky top={60}> <Toolbar .../> </Sticky>
//   <Sticky bottom={0}> <Button full={true}>Add to cart</Button> </Sticky>
//
// top: how far from the top of the scrolling box it stops, in pixels (0; make room
// for a sticky header with top={60}). bottom: given instead, it sticks to the bottom
// at that distance. z: its stacking order over what scrolls under it (5).
// It sticks inside its parent only: a Sticky in a short box leaves with the box.
// Give the parent a height (the page, a scrolling box) for it to stick within.

import ui/theme.qwe use ui_cls

let sticky_css = css`
.ui-sticky { position: sticky; top: var(--ui-sticky-top, 0); z-index: var(--ui-sticky-z, 5); min-width: 0; }
.ui-sticky-bottom { top: auto; bottom: var(--ui-sticky-bottom, 0); }
`

view Sticky(top: int = 0, bottom: int? = null, z: int = 5, class: str? = null, children) {
    style global sticky_css
    <div class={ui_cls(["ui-sticky", bottom != null && "ui-sticky-bottom", class])}
         style={bottom != null ? `--ui-sticky-bottom: ${bottom}px; --ui-sticky-z: ${z}` : `--ui-sticky-top: ${top}px; --ui-sticky-z: ${z}`}>
        {children}
    </div>
}
