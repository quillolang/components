// Figure: an image with a caption under it, and a credit for whose it is, as a
// <figure> with its <figcaption>, so the caption belongs to the image.
//
//   <Figure src="/img/bridge.jpg" alt="The bridge at dusk" caption="The 25 de Abril bridge, seen from Alcântara."/>
//   <Figure src="/img/lab.jpg" alt="..." caption="The lab in 1962" credit="Photo: NASA" credit_href="https://images.nasa.gov"/>
//   <Figure caption="Monthly sales"><BarChart .../></Figure>
//
// src, alt: the image; without src the children are the figure's content (a chart,
// a table, a code block). caption: the text under it; credit: who made it, smaller,
// after the caption; credit_href makes the credit a link.
// size: "sm" (up to 320px wide), "md" (560px, default), "lg" (as wide as it can be).
// align: "left" (default), "center" or "right": where it sits and how the caption
// is aligned. width, height: the image's own pixels, so the page does not jump as
// it loads. lazy (true): loaded when scrolled near.

let figure_css = css`
.ui-figure { display: grid; gap: 8px; max-width: 560px; margin: 0; font: 14px/1.4 var(--ui-font); color: var(--ui-fg); }
.ui-figure-sm { max-width: 320px; }
.ui-figure-lg { max-width: none; }
.ui-figure-center { margin-left: auto; margin-right: auto; text-align: center; }
.ui-figure-right { margin-left: auto; text-align: right; }
.ui-figure img { display: block; width: 100%; height: auto; border-radius: var(--ui-radius); background: var(--ui-subtle); }
.ui-figure-body > :first-child { margin-top: 0; }
.ui-figure-body > :last-child { margin-bottom: 0; }
.ui-figure figcaption { font-size: 13px; color: var(--ui-muted); }
.ui-figure-credit { display: inline-block; margin-left: 6px; font-size: 12px; color: var(--ui-muted); opacity: .85; }
.ui-figure-credit a { color: inherit; }
`

view Figure(src: str? = null, alt: str = "", caption: str? = null, credit: str? = null, credit_href: str? = null,
            size: str = "md", align: str = "left", width: int? = null, height: int? = null, lazy: bool = true,
            class: str? = null, children) {
    style global figure_css
    <figure class={ui_cls(["ui-figure", size != "md" && `ui-figure-${size}`, align != "left" && `ui-figure-${align}`, class])}>
        {src != null
            ? <img src={src} alt={alt} width={width} height={height} loading={lazy ? "lazy" : null}/>
            : <div.ui-figure-body>{children}</div>}
        {(caption != null || credit != null) && <figcaption>
            {caption}
            {credit != null && <span.ui-figure-credit>
                {credit_href != null ? <a href={credit_href} rel="noopener">{credit}</a> : credit}
            </span>}
        </figcaption>}
    </figure>
}
