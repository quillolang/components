// AspectRatio: keeps what it holds at a shape: an image, a video, a map or an
// <iframe> fills a box as wide as its container and as tall as the ratio says, so
// the page does not jump as it loads.
//
//   <AspectRatio ratio="16/9"><img src="/cover.jpg" alt="The team on stage"/></AspectRatio>
//   <AspectRatio ratio="1" round={true}><img src={p.photo} alt={p.name}/></AspectRatio>
//   <AspectRatio ratio="4/3"><iframe src={map_url} title="Where we are"></iframe></AspectRatio>
//
// ratio: "16/9" (the default), "4/3", "3/2", "21/9", "1", or a number (1.5 is 3/2).
// fit: how an image or video fills the box, "cover" (the default, cut to fit) or
// "contain" (whole, with room around it). round: the kit's corner radius, and
// what is inside cut to it. children: one element; it fills the box.

import ui/theme.qwe use ui_cls

let aspect_ratio_css = css`
.ui-ratio { position: relative; width: 100%; min-width: 0; aspect-ratio: var(--ui-ratio, 16 / 9); overflow: hidden; }
.ui-ratio > *, .ui-ratio > quillo-raw > * { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; }
.ui-ratio > :is(img, video), .ui-ratio > quillo-raw > :is(img, video) { display: block; object-fit: var(--ui-ratio-fit, cover); }
.ui-ratio > iframe, .ui-ratio > quillo-raw > iframe { border: 0; }
.ui-ratio-round { border-radius: var(--ui-radius); }
`

// The ratio as CSS: "16/9" and 1.5 are fine as they are; anything else is 16/9.
fn aspect_ratio_css_value(ratio) -> str =
    match ratio {
        int as n => str(n)
        float as n => str(n)
        str as s if re.test(trim(s), "^\\d+(\\.\\d+)?\\s*(/\\s*\\d+(\\.\\d+)?)?$") => replace(trim(s), " ", "")
        _ => "16/9"
    }

view AspectRatio(ratio = "16/9", fit: str = "cover", round: bool = false, class: str? = null, children) {
    style global aspect_ratio_css
    <div class={ui_cls(["ui-ratio", round && "ui-ratio-round", class])}
         style={`--ui-ratio: ${aspect_ratio_css_value(ratio)}; --ui-ratio-fit: ${fit == "contain" ? "contain" : "cover"}`}>
        {children}
    </div>
}
