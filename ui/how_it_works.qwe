// HowItWorks: the few steps from nothing to done, numbered, in a row (or a
// column), each with an icon, a title and a sentence.
//
//   <HowItWorks title="Three steps" steps={[
//       { title: "Install", text: "One binary, on any machine.", icon: "⬇️" },
//       { title: "Write", text: "A route that returns HTML." },
//       { title: "Run", text: "quillo run app.qwe, and it is live." },
//   ]}/>
//   <HowItWorks direction="column" steps={steps}/>
//
// steps: a list of { title, text?, icon? }, in order; icon is HTML or a short
// text, drawn in the step's circle instead of its number (the number is still
// said to screen readers). title and text: a heading and a line above.
// direction: "row" (default: side by side, with a line joining the circles,
// stacking on a phone) or "column" (one under another, the line down the side).
// It is an <ol>, so screen readers count the steps.

import ui/theme.qwe use ui_cls

let how_it_works_css = css`
.ui-hiw { display: grid; gap: 28px; font: 15px/1.5 var(--ui-font); color: var(--ui-fg); }
.ui-hiw-head { display: grid; gap: 8px; max-width: 640px; margin: 0 auto 4px; text-align: center; }
.ui-hiw-title { margin: 0; font-size: clamp(24px, 3.4vw, 32px); font-weight: 700; line-height: 1.2; letter-spacing: -.015em; }
.ui-hiw-text { margin: 0; color: var(--ui-muted); font-size: 17px; }
.ui-hiw-steps { display: grid; gap: 24px; margin: 0; padding: 0; list-style: none; }
.ui-hiw-row .ui-hiw-steps { grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); }
.ui-hiw-step { position: relative; display: grid; gap: 6px; min-width: 0; }
.ui-hiw-row .ui-hiw-step { justify-items: center; text-align: center; }
.ui-hiw-mark { position: relative; z-index: 1; display: grid; place-items: center; width: 48px; height: 48px; margin-bottom: 6px;
  border-radius: 50%; background: var(--ui-accent); color: var(--ui-accent-fg); font-size: 18px; font-weight: 700; line-height: 1;
  box-shadow: 0 0 0 4px var(--ui-bg); }
.ui-hiw-mark svg { width: 22px; height: 22px; }
.ui-hiw-icon { background: var(--ui-accent-soft); color: var(--ui-accent); }
.ui-hiw-row .ui-hiw-step:not(:last-child)::before { content: ""; position: absolute; top: 24px; left: 50%; width: 100%; height: 2px; background: var(--ui-border); }
.ui-hiw-column .ui-hiw-step { grid-template-columns: 48px 1fr; column-gap: 16px; align-items: start; }
.ui-hiw-column .ui-hiw-step > :not(.ui-hiw-mark) { grid-column: 2; }
.ui-hiw-column .ui-hiw-mark { grid-row: 1 / span 3; margin: 0; }
.ui-hiw-column .ui-hiw-step:not(:last-child)::before { content: ""; position: absolute; top: 48px; bottom: -24px; left: 23px; width: 2px; background: var(--ui-border); }
.ui-hiw-step-title { margin: 0; font-size: 17px; font-weight: 600; line-height: 1.3; }
.ui-hiw-column .ui-hiw-step-title { margin-top: 12px; }
.ui-hiw-step-text { margin: 0; color: var(--ui-muted); }
@media (max-width: 760px) {
  .ui-hiw-row .ui-hiw-steps { grid-auto-flow: row; grid-auto-columns: auto; }
  .ui-hiw-row .ui-hiw-step { grid-template-columns: 48px 1fr; column-gap: 16px; justify-items: start; text-align: left; align-items: start; }
  .ui-hiw-row .ui-hiw-step > :not(.ui-hiw-mark) { grid-column: 2; }
  .ui-hiw-row .ui-hiw-mark { grid-row: 1 / span 3; margin: 0; }
  .ui-hiw-row .ui-hiw-step-title { margin-top: 12px; }
  .ui-hiw-row .ui-hiw-step:not(:last-child)::before { top: 48px; bottom: -24px; left: 23px; width: 2px; height: auto; }
}
`

view HowItWorks(steps: list, title: str? = null, text: str? = null, direction: str = "row", id: str? = null, class: str? = null) {
    style global how_it_works_css
    <section id={id} class={ui_cls(["ui-hiw", `ui-hiw-${direction}`, class])}>
        {(title != null || text != null) && <div.ui-hiw-head>
            {title != null && <h2.ui-hiw-title>{title}</h2>}
            {text != null && <p.ui-hiw-text>{text}</p>}
        </div>}
        <ol.ui-hiw-steps>
            {for [i, s] in enumerate(steps) => <li.ui-hiw-step>
                <span class={ui_cls(["ui-hiw-mark", s.icon != null && "ui-hiw-icon"])} aria-hidden="true">{s.icon ?? i + 1}</span>
                <h3.ui-hiw-step-title><span.ui-sr>Step {i + 1}: </span>{s.title}</h3>
                {s.text != null && <p.ui-hiw-step-text>{s.text}</p>}
            </li>}
        </ol>
    </section>
}
