// DiscountBadge: how much is off, as a small label on a product or a plan:
// "−20%", "Save $10", "2 for 1".
//
//   <DiscountBadge percent={20}/>
//   <DiscountBadge amount={10}/>                        Save $10
//   <DiscountBadge amount="€5" tone="success"/>          Save €5
//   <DiscountBadge label="2 for 1" tone="accent" variant="outline"/>
//
// percent: the percentage off, shown as "−20%". amount: the money off, a number
// (written for currency and locale, as Price does, a whole one without ".00";
// this file needs price.qwe) or text, shown as "Save $10". label: any other
// text, shown as it is. One of the
// three. tone: "danger" (default, as shops do), "accent", "success", "warning" or
// "neutral". variant: "solid" (default), "soft" or "outline". size: "sm" or "md"
// (default). corner: "top-left", "top-right", "bottom-left" or "bottom-right"
// pins it to that corner of a parent with position: relative (an image).

let discount_badge_css = css`
.ui-discount {
  display: inline-flex; align-items: center; height: 24px; padding: 0 9px; border: 1px solid transparent;
  border-radius: var(--ui-radius-sm); font: 700 12px/1 var(--ui-font); letter-spacing: .01em; white-space: nowrap;
  font-variant-numeric: tabular-nums; --t: var(--ui-danger); --ts: var(--ui-danger-soft);
}
.ui-discount-accent { --t: var(--ui-accent); --ts: var(--ui-accent-soft); }
.ui-discount-success { --t: var(--ui-success); --ts: var(--ui-success-soft); }
.ui-discount-warning { --t: var(--ui-warning); --ts: var(--ui-warning-soft); }
.ui-discount-neutral { --t: var(--ui-fg); --ts: var(--ui-subtle); }
.ui-discount-solid { background: var(--t); color: var(--ui-bg); }
.ui-discount-soft { background: var(--ts); color: var(--t); }
.ui-discount-outline { border-color: var(--t); color: var(--t); background: var(--ui-surface); }
.ui-discount-sm { height: 20px; padding: 0 7px; font-size: 11px; }
.ui-discount-corner { position: absolute; z-index: 1; }
.ui-discount-top-left { top: 8px; left: 8px; }
.ui-discount-top-right { top: 8px; right: 8px; }
.ui-discount-bottom-left { bottom: 8px; left: 8px; }
.ui-discount-bottom-right { bottom: 8px; right: 8px; }
`

view DiscountBadge(percent: num? = null, amount = null, label: str? = null, currency: str = "USD",
                   locale: str? = null, tone: str = "danger", variant: str = "solid", size: str = "md",
                   corner: str? = null, class: str? = null) {
    style global discount_badge_css
    let text = label ?? (percent != null ? `−${percent}%` : amount != null ? `Save ${price_text(amount, currency, locale, false)}` : "")
    let spoken = label ?? (percent != null ? `${percent}% off` : amount != null ? `Save ${price_text(amount, currency, locale, false)}` : "")
    <span class={ui_cls(["ui-discount", `ui-discount-${tone}`, `ui-discount-${variant}`, size == "sm" && "ui-discount-sm",
                         corner != null && "ui-discount-corner", corner != null && `ui-discount-${corner}`, class])}
          aria-label={spoken != text ? spoken : null}>{text}</span>
}
