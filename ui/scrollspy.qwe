// Scrollspy: links to the sections of a page (or of a scrolling box) that mark the
// one in view as it scrolls (aria-current="location"), down the side or in a row
// across the top. A click scrolls there smoothly (at once for people who ask their
// system for less motion), moves the focus to the section and puts its #id in the
// address bar. Without JavaScript the links still go to the sections.
//
//   <Scrollspy items={[{ id: "intro", label: "Introduction" }, { id: "setup", label: "Setup" }]}/>
//   <Scrollspy horizontal={true} sticky={true} scroller="article" offset={60} items={sections}/>
//
// items: { id (the section's id), label }, in the page's order. horizontal: a row
// across instead of a list down. sticky: it stays in view as the page scrolls (top:
// var(--ui-scrollspy-top, 0)). offset: how many pixels at the top are covered (a
// fixed header): a section counts as reached, and a click stops, that far down (0).
// scroller: the id of a scrolling element the sections are in, to follow instead of
// the window. label: what screen readers call it ("Sections").
// on_change(id): inside one of your components, called when the section in view changes.

import ui/theme.qwe use ui_cls

let scrollspy_css = css`
.ui-scrollspy { min-width: 0; background: var(--ui-bg); font: 14px/1.4 var(--ui-font); color: var(--ui-fg); }
.ui-scrollspy-sticky { position: sticky; top: var(--ui-scrollspy-top, 0); z-index: 5; }
.ui-scrollspy ul { display: grid; gap: 2px; margin: 0; padding: 0; list-style: none; border-left: 2px solid var(--ui-border); }
.ui-scrollspy-link {
  display: block; margin-left: -2px; padding: 5px 12px; border-left: 2px solid transparent; color: var(--ui-muted);
  text-decoration: none; transition: color .15s, border-color .15s; border-radius: 0 var(--ui-radius-sm) var(--ui-radius-sm) 0;
}
.ui-scrollspy-link:hover { color: var(--ui-fg); }
.ui-scrollspy-link:focus-visible { outline: none; box-shadow: var(--ui-focus); }
.ui-scrollspy-link[aria-current] { border-left-color: var(--ui-accent); color: var(--ui-accent); font-weight: 500; }
.ui-scrollspy-horizontal ul { display: flex; gap: 4px; border-left: 0; border-bottom: 1px solid var(--ui-border); overflow-x: auto; scrollbar-width: none; }
.ui-scrollspy-horizontal ul::-webkit-scrollbar { display: none; }
.ui-scrollspy-horizontal .ui-scrollspy-link {
  margin: 0 0 -1px; padding: 10px 12px; border-left: 0; border-bottom: 2px solid transparent; border-radius: 0; white-space: nowrap;
}
.ui-scrollspy-horizontal .ui-scrollspy-link[aria-current] { border-bottom-color: var(--ui-accent); }
@media (prefers-reduced-motion: reduce) { .ui-scrollspy-link { transition: none; } }
`

component Scrollspy(items: list = [], horizontal: bool = false, sticky: bool = false, offset: int = 0, scroller: str? = null,
                    label: str = "Sections", id: str? = null, on_change = null, class: str? = null) {
    style global scrollspy_css
    state active = len(items) > 0 ? items[0].id : null
    state box = null
    state going = false
    let mark = (to: str?) => {
        if to != active {
            active = to
            on_change && on_change(to)
        }
    }
    // The last section whose top has passed `offset`, or the last of all at the very bottom.
    let spy = (_e = null) => {
        if !going && len(items) > 0 {
            let top = box != null ? box.getBoundingClientRect().top : 0
            let bottom = box != null ? box.scrollTop + box.clientHeight >= box.scrollHeight - 2
                : js("scrollY") + js("innerHeight") >= js("document.documentElement.scrollHeight") - 2
            let passed = items | filter((it) => {
                let h = js("document.getElementById", it.id)
                h != null && h.getBoundingClientRect().top - top <= offset + 8
            })
            mark(bottom ? items[-1].id : len(passed) > 0 ? passed[-1].id : items[0].id)
        }
    }
    let done = (_e = null) => {
        going = false
        spy()
    }
    let jump = (e, to: str) => {
        let h = js("document.getElementById", to)
        if h != null {
            e.preventDefault()
            let still = js("matchMedia", "(prefers-reduced-motion: reduce)").matches
            let top = box != null ? box.getBoundingClientRect().top : 0
            let by = h.getBoundingClientRect().top - top - offset
            let at = box != null ? box.scrollTop : js("scrollY")
            mark(to)
            going = by > 1 || by < -1
            (box ?? js("window")).scrollTo({ top: at + by, behavior: still ? "instant" : "smooth" })
            if !h.hasAttribute("tabindex") && h.tabIndex < 0 { h.tabIndex = -1 }
            h.focus({ preventScroll: true })
            js("history.replaceState", js("history.state"), "", `#${to}`)
            e.target.closest("a").scrollIntoView({ block: "nearest", inline: "nearest" })
        }
    }
    <nav class={ui_cls(["ui-scrollspy", horizontal && "ui-scrollspy-horizontal", sticky && "ui-scrollspy-sticky", class])} id={id}
         aria-label={label}
         @mount={(el) => {
             box = scroller != null ? js("document.getElementById", scroller) : null
             let from = box ?? js("window")
             spy()
             from.addEventListener("scroll", spy, { passive: true })
             from.addEventListener("scrollend", done)
             () => {
                 from.removeEventListener("scroll", spy)
                 from.removeEventListener("scrollend", done)
             }
         }}>
        <ul>
            {for it in items => <li key={it.id}>
                <a.ui-scrollspy-link href={`#${it.id}`} aria-current={it.id == active ? "location" : null}
                   @click={(e) => { jump(e, it.id) }}>{it.label}</a>
            </li>}
        </ul>
    </nav>
}
