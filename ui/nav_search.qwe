// NavSearch: a search box for a navbar: a magnifier and a short field that grows
// wider when it is focused, and shrinks back when it is left empty. Pressing "/"
// anywhere on the page (outside another field) focuses it; Escape clears it, then
// leaves it. It is a real <input type="search"> in a <form method="get">, so Enter
// sends `name` ("q") to `action` without any script.
//
//   <NavSearch action="/search" placeholder="Search docs"/>
//   <NavSearch on_submit={(text) => { results = find(text) }} on_input={(text) => { query = text }}/>
//
// action: where the form goes ("/search"). name: the field's name ("q"). value: the
// text to start with. placeholder ("Search"). width, wide: its width at rest and when
// focused, in pixels (160, 280). shortcut: focus it with "/" (true); the key shows in
// the box as a hint. label: its name for screen readers ("Search").
// on_input(text): inside one of your components, called as the text changes.
// on_submit(text): called on Enter; with it, the form is not sent.

let nav_search_css = css`
.ui-navsearch { position: relative; display: inline-flex; align-items: center; margin: 0; font: 14px/1 var(--ui-font); color: var(--ui-fg); }
.ui-navsearch-icon { position: absolute; left: 10px; width: 16px; height: 16px; color: var(--ui-muted); pointer-events: none; }
.ui-navsearch-input {
  box-sizing: border-box; width: var(--ui-navsearch-w, 160px); height: 36px; margin: 0; padding: 0 34px 0 32px; border: 1px solid var(--ui-border);
  border-radius: 999px; background: var(--ui-subtle); color: var(--ui-fg); font: inherit; appearance: none; transition: width .2s ease-out, background .15s, border-color .15s, box-shadow .15s;
}
.ui-navsearch-input::placeholder { color: var(--ui-muted); opacity: 1; }
.ui-navsearch-input::-webkit-search-cancel-button, .ui-navsearch-input::-webkit-search-decoration { -webkit-appearance: none; appearance: none; }
.ui-navsearch-input:hover { border-color: var(--ui-strong); }
.ui-navsearch-input:focus, .ui-navsearch-open .ui-navsearch-input {
  outline: none; width: var(--ui-navsearch-wide, 280px); background: var(--ui-surface); border-color: var(--ui-accent); box-shadow: var(--ui-focus);
}
.ui-navsearch-key {
  position: absolute; right: 8px; display: inline-grid; place-items: center; min-width: 20px; height: 20px; padding: 0 5px; border: 1px solid var(--ui-border);
  border-radius: 4px; background: var(--ui-surface); color: var(--ui-muted); font: 500 11px/1 var(--ui-mono); pointer-events: none;
}
.ui-navsearch-input:focus ~ .ui-navsearch-key, .ui-navsearch-open .ui-navsearch-key { display: none; }
.ui-navsearch-clear {
  position: absolute; right: 5px; display: none; align-items: center; justify-content: center; width: 26px; height: 26px; padding: 0; border: 0;
  border-radius: 50%; background: transparent; color: var(--ui-muted); cursor: pointer;
}
.ui-navsearch-clear svg { width: 14px; height: 14px; }
.ui-navsearch-clear:hover { background: var(--ui-subtle); color: var(--ui-fg); }
.ui-navsearch-clear:focus-visible { outline: none; box-shadow: var(--ui-focus); }
.ui-navsearch-open .ui-navsearch-clear { display: inline-flex; }
@media (prefers-reduced-motion: reduce) { .ui-navsearch-input { transition: none; } }
`

component NavSearch(action: str = "/search", name: str = "q", value: str = "", placeholder: str = "Search", width: int = 160,
                    wide: int = 280, shortcut: bool = true, label: str = "Search", id: str? = null, on_input = null, on_submit = null,
                    class: str? = null) {
    style global nav_search_css
    state text = value
    state box = null
    let fid = id ?? `ui-navsearch-${name}`
    let set = (t: str) => {
        text = t
        on_input && on_input(t)
    }
    <form class={ui_cls(["ui-navsearch", text != "" && "ui-navsearch-open", class])} role="search" action={action} method="get"
          style={`--ui-navsearch-w: ${width}px; --ui-navsearch-wide: ${wide}px`}
          @mount={(el) => {
              box = el.querySelector("input")
              let onkey = (e) => {
                  let t = e.target
                  let typing = t.tagName == "INPUT" || t.tagName == "TEXTAREA" || t.tagName == "SELECT" || t.isContentEditable
                  if e.key == "/" && !typing && !e.defaultPrevented && !e.ctrlKey && !e.metaKey && !e.altKey {
                      e.preventDefault()
                      box.focus()
                      box.select()
                  }
              }
              if shortcut { js("document.addEventListener", "keydown", onkey) }
              () => { if shortcut { js("document.removeEventListener", "keydown", onkey) } }
          }}
          @submit={(e) => {
              if on_submit != null {
                  e.preventDefault()
                  on_submit(text)
              } else {
                  js("location.assign", `${action}?${url_encode(set({}, name, text))}`)
              }
          }}>
        <svg.ui-navsearch-icon viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
             aria-hidden="true"><circle cx="7" cy="7" r="4.75"/><path d="M10.5 10.5L14 14"/></svg>
        <input.ui-navsearch-input type="search" id={fid} name={name} value={text} placeholder={placeholder} aria-label={label}
               aria-keyshortcuts={shortcut ? "/" : null} autocomplete="off"
               @input={(e) => { set(e.value) }}
               @keydown={(e) => {
                   if e.key == "Escape" {
                       e.preventDefault()
                       if text != "" { set("") } else { e.target.blur() }
                   }
               }}/>
        {shortcut && <kbd.ui-navsearch-key aria-hidden="true">/</kbd>}
        <button.ui-navsearch-clear type="button" aria-label="Clear search" tabindex={text != "" ? null : "-1"}
                @click={() => { set(""); box.focus() }}>
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8"/></svg>
        </button>
    </form>
}
