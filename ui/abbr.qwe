// Abbr: an abbreviation with what it stands for, shown in a bubble while it is
// hovered or focused, and read out by screen readers. A real <abbr>.
//
//   The <Abbr title="HyperText Markup Language">HTML</Abbr> is sent first.
//   <Abbr title="as soon as possible" tooltip="native">ASAP</Abbr>
//
// children: the short form. title: what it stands for. tooltip: "bubble" (default:
// shown at once, above the word, on hover and keyboard focus) or "native" (the
// browser's own, from the title attribute, after a moment). Either way screen readers
// get the expansion after the short form. id: the element's id.

let abbr_css = css`
.ui-abbr { position: relative; text-decoration: underline dotted; text-decoration-color: var(--ui-muted); text-underline-offset: 2px;
  cursor: help; border-radius: 3px; }
.ui-abbr:focus-visible { outline: none; box-shadow: var(--ui-focus); }
.ui-abbr-bubble::after { content: attr(data-ui-abbr); position: absolute; z-index: 50; left: 50%; bottom: calc(100% + 6px);
  transform: translateX(-50%); display: none; width: max-content; max-width: min(240px, 70vw); padding: 5px 9px;
  border-radius: var(--ui-radius-sm); background: var(--ui-fg); color: var(--ui-bg); box-shadow: var(--ui-shadow);
  font: 500 12px/1.4 var(--ui-font); text-align: center; white-space: normal; text-decoration: none; }
.ui-abbr-bubble:hover::after, .ui-abbr-bubble:focus::after { display: block; }
@media (hover: none) { .ui-abbr-bubble:hover:not(:focus)::after { display: none; } }
`

view Abbr(title: str, tooltip: str = "bubble", id: str? = null, class: str? = null, children) {
    style global abbr_css
    let bubble = tooltip != "native"
    <abbr class={ui_cls(["ui-abbr", bubble && "ui-abbr-bubble", class])} id={id}
          title={bubble ? null : title} data-ui-abbr={bubble ? title : null} tabindex={bubble ? "0" : null}>
        {children}<span.ui-sr> ({title})</span>
    </abbr>
}
