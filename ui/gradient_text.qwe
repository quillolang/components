// GradientText: text filled with a gradient, for a word or a line that should shine
// on a landing page.
//
//   <GradientText>Ship faster</GradientText>
//   <Heading level={1}>Build <GradientText preset="sunset">beautiful</GradientText> apps</Heading>
//   <GradientText from="#0ea5e9" to="#8b5cf6" angle={135} tag="p">Any two colours, at any angle.</GradientText>
//
// children: the text. preset: "accent" (default: the theme's accent to its info
// colour, so it follows the theme), "sunset", "ocean" or "forest". from and to: two
// CSS colours instead of a preset. angle: the gradient's direction in degrees (90,
// left to right). tag: "span" (default), "strong", "p" or "div". id: the element's id.
// In forced-colours mode (high contrast) it is plain text.

import ui/theme.qwe use ui_cls

let gradient_text_css = css`
.ui-gradient { display: inline-block; background: linear-gradient(var(--ui-gradient-angle, 90deg), var(--ui-gradient-from), var(--ui-gradient-to));
  -webkit-background-clip: text; background-clip: text; color: transparent; -webkit-text-fill-color: transparent;
  --ui-gradient-from: var(--ui-accent); --ui-gradient-to: var(--ui-info); }
p.ui-gradient, div.ui-gradient { display: block; width: fit-content; margin: 0; }
.ui-gradient-sunset { --ui-gradient-from: #f97316; --ui-gradient-to: #ec4899; }
.ui-gradient-ocean { --ui-gradient-from: #0ea5e9; --ui-gradient-to: #6366f1; }
.ui-gradient-forest { --ui-gradient-from: #16a34a; --ui-gradient-to: #0d9488; }
@media (forced-colors: active) { .ui-gradient { background: none; color: CanvasText; -webkit-text-fill-color: CanvasText; } }
`

// A colour as it may go into a style: letters, digits, # ( ) , . % and spaces.
fn gradient_text_color(c: str) -> str = re.replace(c, "[^a-zA-Z0-9#(),.% -]", "")

view GradientText(preset: str = "accent", from: str? = null, to: str? = null, angle: int = 90, tag: str = "span",
                  id: str? = null, class: str? = null, children) {
    style global gradient_text_css
    let vars = [angle != 90 && `--ui-gradient-angle: ${angle}deg`,
                from != null && `--ui-gradient-from: ${gradient_text_color(from)}`,
                to != null && `--ui-gradient-to: ${gradient_text_color(to)}`] | filter((v) => v != false) | join("; ")
    let cls = ui_cls(["ui-gradient", preset != "accent" && `ui-gradient-${preset}`, class])
    let style = vars != "" ? vars : null
    match tag {
        "strong" => <strong class={cls} id={id} style={style}>{children}</strong>
        "p" => <p class={cls} id={id} style={style}>{children}</p>
        "div" => <div class={cls} id={id} style={style}>{children}</div>
        _ => <span class={cls} id={id} style={style}>{children}</span>
    }
}
