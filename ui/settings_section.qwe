// SettingsSection: one block of a settings page: a title, a line about it, and
// rows each with a label and a hint on the left and its control on the right.
// SettingsRow is one row.
//
//   <SettingsSection title="Notifications" description="What we email you about.">
//       <SettingsRow label="Replies" hint="When someone answers you." field="n-replies">
//           <Switch name="replies" checked={true}/>
//       </SettingsRow>
//       <SettingsRow label="Digest" hint="A summary of the week." field="n-digest">
//           <Select name="digest" field="n-digest" options={["Never", "Weekly"]}/>
//       </SettingsRow>
//   </SettingsSection>
//
// SettingsSection: title (an <h2>; level sets the heading level), description,
// children (SettingsRows), footer (HTML along the bottom: a Save button), id.
// SettingsRow: label, hint (a quieter line under it), children (the control),
// field: the control's id, so the label is a <label for> it (otherwise the label
// is plain text and the control should carry its own aria-label), wide: the
// control takes the whole row, under the label (a textarea, a table). On a phone
// every row stacks.

import ui/theme.qwe use ui_cls

let settings_section_css = css`
.ui-settings { border: 1px solid var(--ui-border); border-radius: var(--ui-radius); background: var(--ui-surface); font: 14px/1.5 var(--ui-font); color: var(--ui-fg); }
.ui-settings-head { padding: 18px 20px 14px; border-bottom: 1px solid var(--ui-border); }
.ui-settings-title { margin: 0; font-size: 16px; font-weight: 600; line-height: 1.3; }
.ui-settings-desc { margin: 3px 0 0; color: var(--ui-muted); }
.ui-settings-rows { margin: 0; padding: 0; list-style: none; }
.ui-settings-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 4px 24px; align-items: center; padding: 14px 20px; }
.ui-settings-row + .ui-settings-row { border-top: 1px solid var(--ui-border); }
.ui-settings-row-wide { grid-template-columns: minmax(0, 1fr); }
.ui-settings-label { font-weight: 500; }
.ui-settings-hint { display: block; color: var(--ui-muted); font-size: 13px; font-weight: 400; }
.ui-settings-control { display: flex; justify-content: flex-end; align-items: center; min-width: 0; }
.ui-settings-row-wide .ui-settings-control { justify-content: stretch; margin-top: 6px; }
.ui-settings-row-wide .ui-settings-control > * { flex: 1; }
.ui-settings-foot { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 8px; padding: 12px 20px; border-top: 1px solid var(--ui-border); background: var(--ui-subtle);
  border-radius: 0 0 var(--ui-radius) var(--ui-radius); }
@media (max-width: 560px) {
  .ui-settings-row { grid-template-columns: minmax(0, 1fr); }
  .ui-settings-control { justify-content: flex-start; margin-top: 6px; }
}
`

view SettingsSection(title: str, description: str? = null, footer = null, level: int = 2, id: str? = null, class: str? = null, children) {
    style global settings_section_css
    let tid = id != null ? `${id}-title` : null
    let heading = match level {
        3 => <h3.ui-settings-title id={tid}>{title}</h3>
        4 => <h4.ui-settings-title id={tid}>{title}</h4>
        _ => <h2.ui-settings-title id={tid}>{title}</h2>
    }
    <section id={id} class={ui_cls(["ui-settings", class])} aria-labelledby={tid} aria-label={tid == null ? title : null}>
        <div.ui-settings-head>
            {heading}
            {description != null && <p.ui-settings-desc>{description}</p>}
        </div>
        <ul.ui-settings-rows>{children}</ul>
        {footer != null && <div.ui-settings-foot>{footer}</div>}
    </section>
}

view SettingsRow(label: str, hint: str? = null, field: str? = null, wide: bool = false, class: str? = null, children) {
    style global settings_section_css
    let text = [label, hint != null && <span.ui-settings-hint>{hint}</span>]
    <li class={ui_cls(["ui-settings-row", wide && "ui-settings-row-wide", class])}>
        {field != null ? <label.ui-settings-label for={field}>{text}</label> : <span.ui-settings-label>{text}</span>}
        <div.ui-settings-control>{children}</div>
    </li>
}
