// Text: a paragraph or a span of text in the kit's sizes, weights, tones and alignments,
// so a page's prose matches its components without CSS of its own.
//
//   <Text>Your changes are saved as you type.</Text>
//   <Text size="sm" tone="muted">Last edited 2 hours ago.</Text>
//   <Text tag="span" weight="semibold" tone="danger">3 failed</Text>
//   <Text align="center" size="lg">Nothing here yet.</Text>
//
// tag: "p" (default), "span", "div" or "small", the element written.
// size: "xs", "sm", "md" (default), "lg" or "xl".
// weight: "normal", "medium", "semibold" or "bold"; the element's own when not given.
// tone: "muted", "accent", "success", "warning", "danger" or "info"; the text colour
// when not given. align: "start", "center", "end" or "justify".
// italic and mono: in italics, or in the monospace font. id: the element's id.

let text_css = css`
.ui-text { margin: 0; font: 15px/1.5 var(--ui-font); color: var(--ui-fg); overflow-wrap: anywhere; }
:where(span, small).ui-text { font-size: inherit; line-height: inherit; }
.ui-text + .ui-text { margin-top: .6em; }
.ui-text-xs { font-size: 12px; }
.ui-text-sm { font-size: 13px; }
.ui-text-lg { font-size: 17px; }
.ui-text-xl { font-size: 20px; line-height: 1.4; }
.ui-text-normal { font-weight: 400; }
.ui-text-medium { font-weight: 500; }
.ui-text-semibold { font-weight: 600; }
.ui-text-bold { font-weight: 700; }
.ui-text-muted { color: var(--ui-muted); }
.ui-text-accent { color: var(--ui-accent); }
.ui-text-success { color: var(--ui-success); }
.ui-text-warning { color: var(--ui-warning); }
.ui-text-danger { color: var(--ui-danger); }
.ui-text-info { color: var(--ui-info); }
.ui-text-start { text-align: start; }
.ui-text-center { text-align: center; }
.ui-text-end { text-align: end; }
.ui-text-justify { text-align: justify; }
.ui-text-italic { font-style: italic; }
.ui-text-mono { font-family: var(--ui-mono); font-size: .93em; }
`

view Text(tag: str = "p", size: str = "md", weight: str? = null, tone: str? = null, align: str? = null,
          italic: bool = false, mono: bool = false, id: str? = null, class: str? = null, children) {
    style global text_css
    let cls = ui_cls(["ui-text", size != "md" && `ui-text-${size}`, weight != null && `ui-text-${weight}`,
                      tone != null && `ui-text-${tone}`, align != null && `ui-text-${align}`,
                      italic && "ui-text-italic", mono && "ui-text-mono", class])
    match tag {
        "span" => <span class={cls} id={id}>{children}</span>
        "div" => <div class={cls} id={id}>{children}</div>
        "small" => <small class={cls} id={id}>{children}</small>
        _ => <p class={cls} id={id}>{children}</p>
    }
}
