// IconTabs: a row of tabs with an icon above each label, for the main areas of an
// app or a phone-like switcher; the selected one is marked, and the arrow keys move
// between them. Real ARIA tabs driven by your component's state, with one panel:
// the children.
//
//   <IconTabs id="areas" selected={tab} on_change={(i) => { tab = i }} tabs={[
//       { label: "Photos", icon: "M4 5h16v14H4zM4 15l5-5 4 4 3-3 4 4" },
//       { label: "Albums", icon: "📚", badge: 3 },
//       { label: "Shared", icon: "👥" }
//   ]}>
//       {tab == 0 ? <Photos/> : tab == 1 ? <Albums/> : <Shared/>}
//   </IconTabs>
//
// id (required): a prefix for the tabs' ids, unique on the page. tabs: { label, icon,
// badge?, disabled? }. icon: a character or an emoji, or an SVG path (24x24, stroked)
// when it starts with "M". badge: a count on the icon's corner. selected: the index
// showing first. children: the panel of the selected tab. full: the tabs share the
// width. size: "sm" or "md" (default). label: what screen readers call the row.
// on_change(index): called with the tab picked.

import ui/theme.qwe use ui_cls

let icon_tabs_css = css`
.ui-icontabs { font: 14px/1.4 var(--ui-font); color: var(--ui-fg); }
.ui-icontabs-list { display: flex; gap: 4px; margin: 0; padding: 0; border-bottom: 1px solid var(--ui-border); }
.ui-icontabs-full .ui-icontabs-list .ui-icontabs-tab { flex: 1 1 0; }
.ui-icontabs-tab {
  display: inline-flex; flex-direction: column; align-items: center; justify-content: center; gap: 5px; min-width: 72px; padding: 10px 12px 9px;
  margin-bottom: -1px; border: 0; border-bottom: 2px solid transparent; border-radius: var(--ui-radius-sm) var(--ui-radius-sm) 0 0;
  background: transparent; color: var(--ui-muted); font: 500 13px/1 var(--ui-font); cursor: pointer; transition: color .12s, background .12s, border-color .12s;
}
.ui-icontabs-tab:hover { color: var(--ui-fg); background: var(--ui-subtle); }
.ui-icontabs-tab:focus-visible { outline: none; box-shadow: var(--ui-focus); }
.ui-icontabs-tab[aria-selected="true"] { color: var(--ui-accent); border-bottom-color: var(--ui-accent); }
.ui-icontabs-tab:disabled { opacity: .5; cursor: not-allowed; }
.ui-icontabs-icon { position: relative; display: inline-grid; place-items: center; width: 28px; height: 28px; font-size: 22px; line-height: 1; }
.ui-icontabs-icon svg { width: 24px; height: 24px; }
.ui-icontabs-badge {
  position: absolute; top: -5px; left: 100%; margin-left: -10px; min-width: 16px; padding: 0 4px; border-radius: 999px;
  background: var(--ui-danger); color: #fff; font-size: 10px; font-weight: 700; line-height: 16px; text-align: center;
}
.ui-icontabs-sm .ui-icontabs-tab { min-width: 56px; padding: 7px 8px 6px; font-size: 12px; }
.ui-icontabs-sm .ui-icontabs-icon { width: 22px; height: 22px; font-size: 18px; }
.ui-icontabs-sm .ui-icontabs-icon svg { width: 20px; height: 20px; }
.ui-icontabs-panel { padding-top: 16px; }
.ui-icontabs-panel > :first-child { margin-top: 0; }
.ui-icontabs-panel > :last-child { margin-bottom: 0; }
@media (prefers-reduced-motion: reduce) { .ui-icontabs-tab { transition: none; } }
`

component IconTabs(id: str, tabs: list = [], selected: int = 0, full: bool = false, size: str = "md", label: str? = null,
                   on_change = null, class: str? = null, children) {
    style global icon_tabs_css
    state at = selected
    let live = range(0, len(tabs)) | filter((i) => get(tabs[i], "disabled") != true)
    let pick = (i: int) => {
        at = i
        on_change && on_change(i)
    }
    <div class={ui_cls(["ui-icontabs", full && "ui-icontabs-full", size == "sm" && "ui-icontabs-sm", class])}>
        <div.ui-icontabs-list role="tablist" aria-label={label} @keydown={(e) => {
            let n = len(live)
            let k = index_of(live, at) ?? 0
            let to = match e.key {
                "ArrowRight" => live[(k + 1) % n]
                "ArrowLeft" => live[(k + n - 1) % n]
                "Home" => live[0]
                "End" => live[n - 1]
                _ => null
            }
            if to != null && n > 0 {
                e.preventDefault()
                pick(to)
                e.currentTarget.querySelector(`[data-i="${to}"]`).focus()
            }
        }}>
            {for [i, t] in enumerate(tabs) => <button.ui-icontabs-tab type="button" role="tab" id={`${id}-tab-${i}`} data-i={i}
                    aria-selected={i == at ? "true" : "false"} aria-controls={`${id}-panel`} tabindex={i == at ? "0" : "-1"}
                    disabled={get(t, "disabled") == true} @click={() => { pick(i) }}>
                <span.ui-icontabs-icon aria-hidden="true">
                    {starts_with(t.icon, "M") && len(t.icon) > 2
                        ? <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={t.icon}/></svg>
                        : t.icon}
                    {get(t, "badge") != null && <span.ui-icontabs-badge>{t.badge}</span>}
                </span>
                <span>{t.label}{get(t, "badge") != null && <span.ui-sr>, {t.badge} new</span>}</span>
            </button>}
        </div>
        <div.ui-icontabs-panel id={`${id}-panel`} role="tabpanel" aria-labelledby={`${id}-tab-${at}`} tabindex="0">{children}</div>
    </div>
}
