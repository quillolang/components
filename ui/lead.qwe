// Lead: the opening paragraph of an article or a page, set larger and lighter than
// the text that follows, so it reads as the summary.
//
//   <Lead>Quillo is a language for web applications: pages, components and data in one file.</Lead>
//   <Lead size="lg" align="center">Everything you need, nothing you don't.</Lead>
//
// children: the text. size: "md" (default, 18px) or "lg" (21px). tone: "muted"
// (default, a little lighter than the text) or "fg". align: "start" (default),
// "center" or "end". id: the paragraph's id.

import ui/theme.qwe use ui_cls

let lead_css = css`
.ui-lead { margin: 0; max-width: 60ch; font: 400 18px/1.6 var(--ui-font); color: color-mix(in srgb, var(--ui-fg) 78%, var(--ui-muted));
  letter-spacing: -.005em; overflow-wrap: anywhere; }
.ui-lead-lg { font-size: 21px; line-height: 1.5; }
.ui-lead-fg { color: var(--ui-fg); }
.ui-lead-center { margin-left: auto; margin-right: auto; text-align: center; }
.ui-lead-end { margin-left: auto; text-align: end; }
`

view Lead(size: str = "md", tone: str = "muted", align: str = "start", id: str? = null, class: str? = null, children) {
    style global lead_css
    <p class={ui_cls(["ui-lead", size != "md" && `ui-lead-${size}`, tone != "muted" && `ui-lead-${tone}`,
                      align != "start" && `ui-lead-${align}`, class])} id={id}>{children}</p>
}
