// LoadingOverlay: covers what it wraps with a spinner and a message while
// something is busy, so the content stays in place (and keeps its size) but
// cannot be used until it is back.
//
//   <LoadingOverlay busy={saving} label="Saving your changes">
//       <form>...</form>
//   </LoadingOverlay>
//   <LoadingOverlay busy={true} show_label={false} min_height="200px"/>
//
// busy: covers the content while true (true by default, for a box that is loading
// from the start). label: what is happening ("Loading"), shown under the spinner
// and read by screen readers (role="status"); show_label: false keeps it for
// screen readers only. blur: softens the content underneath (true). min_height:
// a CSS length, for a box with nothing in it yet. While busy the content is inert
// (no clicks, no Tab stops) and the box says aria-busy. The spinner pulses instead
// of turning with reduced motion.

let loading_overlay_css = css`
.ui-lo { position: relative; min-width: 0; }
.ui-lo-content { transition: filter .2s, opacity .2s; }
.ui-lo-busy > .ui-lo-content { opacity: .6; }
.ui-lo-busy.ui-lo-blur > .ui-lo-content { filter: blur(2px); }
.ui-lo-cover {
  position: absolute; inset: 0; z-index: 5; display: grid; place-content: center; justify-items: center; gap: 10px;
  padding: 16px; border-radius: inherit; background: color-mix(in srgb, var(--ui-bg) 55%, transparent);
  font: 500 14px/1.4 var(--ui-font); color: var(--ui-fg); text-align: center;
}
.ui-lo-spin {
  width: 28px; height: 28px; border-radius: 50%; border: 3px solid color-mix(in srgb, var(--ui-accent) 20%, transparent);
  border-top-color: var(--ui-accent); animation: ui-lo-turn .75s linear infinite;
}
@keyframes ui-lo-turn { to { transform: rotate(360deg); } }
@keyframes ui-lo-pulse { 50% { opacity: .35; } }
@media (prefers-reduced-motion: reduce) {
  .ui-lo-spin { animation: ui-lo-pulse 2s ease-in-out infinite; border-color: var(--ui-accent); }
  .ui-lo-content { transition: none; }
}
`

view LoadingOverlay(busy: bool = true, label: str = "Loading", show_label: bool = true, blur: bool = true,
                    min_height: str? = null, id: str? = null, class: str? = null, children) {
    style global loading_overlay_css
    <div class={ui_cls(["ui-lo", busy && "ui-lo-busy", blur && "ui-lo-blur", class])} id={id}
         aria-busy={busy ? "true" : null} style={min_height != null ? `min-height: ${min_height}` : null}>
        <div.ui-lo-content inert={busy}>{children}</div>
        {busy && <div.ui-lo-cover role="status">
            <span.ui-lo-spin aria-hidden="true"></span>
            <span class={show_label ? "ui-lo-label" : "ui-sr"}>{label}</span>
        </div>}
    </div>
}
