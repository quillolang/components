// LazyLoad: puts its content on the page only once it is scrolled near, for a
// heavy part low on a page: a map, a chart, an embedded video, a grid of
// pictures. Until then it is a placeholder of the height you give, so the page
// does not jump. The content comes from the server as data and is made in the
// browser when its time comes; what it holds (images, iframes) loads then.
//
//   <LazyLoad height="320px"><iframe src="https://www.youtube.com/embed/..." ...></iframe></LazyLoad>
//   <LazyLoad height="200px" margin="0px" placeholder="Loading the picture…"><img src="/big.jpg" alt="..."/></LazyLoad>
//
// children: the content. height: the placeholder's height, a CSS length
// ("200px"). margin: how far ahead it loads, a CSS length ("300px"); "0px" is
// only when in view. placeholder: text shown in the grey box until then
// (inside one of your components, markup too: a Skeleton). scroller: the id of the scrolling box it is in, when not the
// window. label: what the placeholder is called for screen readers
// ("Content loading"). on_show(): inside one of your components, called with
// nothing when the content is put on the page.

import ui/theme.qwe use ui_cls

let lazy_load_css = css`
.ui-lazy { display: block; min-width: 0; }
.ui-lazy-wait { display: grid; place-items: center; min-height: var(--h, 200px); border-radius: var(--ui-radius); background: var(--ui-subtle);
  color: var(--ui-muted); font: 13px/1.4 var(--ui-font); }
.ui-lazy-shown { animation: ui-lazy-in .25s ease-out; }
@keyframes ui-lazy-in { from { opacity: 0; } }
@media (prefers-reduced-motion: reduce) { .ui-lazy-shown { animation: none; } }
`

component LazyLoad(height: str = "200px", margin: str = "300px", placeholder = null, scroller: str? = null,
                   label: str = "Content loading", on_show = null, class: str? = null, children) {
    style global lazy_load_css
    state seen = false
    <div class={ui_cls(["ui-lazy", seen && "ui-lazy-shown", class])}
         @mount={(el) => {
             let root = scroller != null ? js("document.getElementById", scroller) : null
             let w = js_new("IntersectionObserver", (entries, obs) => {
                 if !seen && any(entries, (en) => en.isIntersecting) {
                     seen = true
                     obs.disconnect()
                     on_show && on_show()
                 }
             }, { root, rootMargin: margin })
             w.observe(el)
             () => w.disconnect()
         }}>
        {seen
            ? children
            : <div.ui-lazy-wait style={`--h: ${height}`} role="status" aria-label={label}>{placeholder}</div>}
    </div>
}
