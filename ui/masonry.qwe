// Masonry: cards of different heights packed into columns, each column filled
// from the top (a photo wall, a board of notes), on the browser's own CSS columns,
// so it needs no script. Items read down each column, then the next.
//
//   <Masonry> {for n in notes => <Card title={n.title}>{n.text}</Card>} </Masonry>
//   <Masonry columns={4} width={180} gap="sm"> {for p in photos => <img src={p.src} alt={p.alt}/>} </Masonry>
//
// columns: at most this many columns (3). width: the narrowest a column may be, in
// pixels (220): fewer columns fit when it is narrow, and one on a phone.
// gap: pixels (16, the default) or "none", "xs" (4), "sm" (8), "md" (16), "lg" (24), "xl" (32),
// between the columns and between the cards in one. id: the grid's id.

import ui/theme.qwe use ui_cls

let masonry_css = css`
.ui-masonry { columns: var(--ui-masonry-min, 220px) var(--ui-masonry-cols, 3); column-gap: var(--ui-masonry-gap, 16px); min-width: 0; }
.ui-masonry > *, .ui-masonry > quillo-raw > * { display: block; break-inside: avoid; margin: 0 0 var(--ui-masonry-gap, 16px); width: 100%; }
.ui-masonry > img, .ui-masonry > quillo-raw > img { height: auto; }
`

fn masonry_gap(gap) -> str =
    match gap {
        int as n => `${n}px`
        float as n => `${n}px`
        "none" => "0"
        "xs" => "4px"
        "sm" => "8px"
        "lg" => "24px"
        "xl" => "32px"
        _ => "16px"
    }

view Masonry(columns: int = 3, width: int = 220, gap = 16, id: str? = null, class: str? = null, children) {
    style global masonry_css
    <div class={ui_cls(["ui-masonry", class])} id={id}
         style={`--ui-masonry-cols: ${columns}; --ui-masonry-min: ${width}px; --ui-masonry-gap: ${masonry_gap(gap)}`}>
        {children}
    </div>
}
