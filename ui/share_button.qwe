// ShareButton: shares a link through the system's share sheet (navigator.share: to
// Messages, Mail, AirDrop, apps on a phone) and, where the browser has none, copies
// the link to the clipboard and says "Link copied" for a moment (to screen readers
// too). Closing the share sheet without sharing says nothing.
//
//   <ShareButton url="https://example.com/posts/7" title="A post worth reading"/>
//   <ShareButton label="Share this page" text="Have a look at this." variant="soft" size="sm"/>
//
// url: the link (this page's address by default). title and text: sent along with
// it where the share sheet takes them. label ("Share"): the button's text.
// shared ("Shared"), copied ("Link copied") and failed ("Could not share"): what it
// says for a moment after. variant: "outline" (default), "soft", "ghost" or "solid";
// size: "sm", "md" or "lg". It is styled as a Button when button_css is on the page.
// on_share(how): inside one of your components, called with "shared" or "copied".

import ui/theme.qwe use ui_cls

let share_button_css = css`
.ui-share-button svg { flex: none; width: 16px; height: 16px; }
.ui-share-button-labels { display: inline-grid; }
.ui-share-button-labels > span { grid-area: 1 / 1; text-align: center; }
.ui-share-button:not(.ui-share-button-ok) .ui-share-button-done, .ui-share-button:not(.ui-share-button-copied) .ui-share-button-copy,
.ui-share-button:not(.ui-share-button-bad) .ui-share-button-fail, .ui-share-button-ok .ui-share-button-label, .ui-share-button-copied .ui-share-button-label,
.ui-share-button-bad .ui-share-button-label { visibility: hidden; }
.ui-share-button-ok svg, .ui-share-button-copied svg { color: var(--ui-success); }
`

component ShareButton(url: str? = null, title: str? = null, text: str? = null, label: str = "Share", shared: str = "Shared",
                      copied: str = "Link copied", failed: str = "Could not share", variant: str = "outline",
                      size: str = "md", on_share = null, class: str? = null) {
    style global share_button_css
    state result = ""    // "", "ok", "copied" or "bad"
    if result != "" { every(1800, () => { result = "" }) }
    let said = match result {
        "ok" => shared
        "copied" => copied
        "bad" => failed
        _ => ""
    }
    let copy = (link: str) => {
        if js("isSecureContext") != true { result = "bad" } else {
            js("navigator.clipboard.writeText", link).then((_ = null) => {
                result = "copied"
                on_share && on_share("copied")
            }, (_ = null) => { result = "bad" })
        }
    }
    <span>
        <button type="button"
                class={ui_cls(["ui-btn", `ui-btn-${variant}`, size != "md" && `ui-btn-${size}`, "ui-share-button",
                               result != "" && `ui-share-button-${result}`, class])}
                @click={() => {
                    let link = url ?? js("location.href")
                    let data = { url: link, title: title ?? js("document.title"), text }
                    let nav = js("navigator")
                    if nav.share != null && (nav.canShare == null || nav.canShare(data) == true) {
                        nav.share(data).then((_ = null) => {
                            result = "ok"
                            on_share && on_share("shared")
                        }, (e = null) => {
                            // Closing the sheet is an AbortError: nothing to say. Anything else: copy instead.
                            if e == null || str(e.name) != "AbortError" { copy(link) }
                        })
                    } else {
                        copy(link)
                    }
                }}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                 stroke-linejoin="round" aria-hidden="true">
                {result == "ok" || result == "copied"
                    ? <path d="M20 6 9 17l-5-5"/>
                    : <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8M16 6l-4-4-4 4M12 2v13"/>}
            </svg>
            <span.ui-share-button-labels>
                <span.ui-share-button-label>{label}</span>
                <span.ui-share-button-done aria-hidden="true">{shared}</span>
                <span.ui-share-button-copy aria-hidden="true">{copied}</span>
                <span.ui-share-button-fail aria-hidden="true">{failed}</span>
            </span>
        </button>
        <span.ui-sr role="status">{said}</span>
    </span>
}
