// RelativeTime: how long ago (or how soon) a moment is, "3 minutes ago", "in 2 hours",
// "yesterday", kept up to date in the browser: every few seconds while it is under a
// minute, every half minute under an hour, less often after. It is a <time> with the
// moment for machines and the full date in its title, shown on hover.
//
//   <RelativeTime time="2026-10-28T09:12:00Z"/>                  3 hours ago
//   <RelativeTime time={post.created} style="short"/>           3h
//   <RelativeTime time="2026-12-24T18:00:00Z" at="2026-12-24T16:00:00Z"/>    in 2 hours
//
// time: the moment, an ISO date-time with its offset ("2026-10-28T09:12:00Z") or a date
// ("2026-10-28", its midnight in UTC). at: a fixed moment to count from instead of the
// clock, which then does not tick (for tests, or a page made for a given time).
// style: "long" (default, "3 minutes ago") or "short" ("3m", "2h", "5d", "now").
// Under 10 seconds is "just now"; past a week it counts weeks, then months, then years.
// title: false leaves out the full date on hover.

let relative_time_css = css`
.ui-relative-time { color: inherit; font-variant-numeric: tabular-nums; white-space: nowrap; }
.ui-relative-time[title] { text-decoration: underline dotted color-mix(in srgb, currentColor 35%, transparent); text-underline-offset: 3px; cursor: help; }
`

// How far apart two moments are, in words: ms is now minus the moment (above 0 is past).
fn relative_time_text(ms: num, style: str) -> str {
    let past = ms >= 0
    let s = floor(abs(ms) / 1000)
    let short = style == "short"
    let say = (n: int, word: str, letter: str) => {
        let text = short ? `${n}${letter}` : `${n} ${word}${n == 1 ? "" : "s"}`
        short ? text : (past ? `${text} ago` : `in ${text}`)
    }
    if s < 10 { return short ? "now" : "just now" }
    if s < 60 { return say(s, "second", "s") }
    let m = floor(s / 60)
    if m < 60 { return say(m, "minute", "m") }
    let h = floor(m / 60)
    if h < 24 { return say(h, "hour", "h") }
    let d = floor(h / 24)
    if d == 1 && !short { return past ? "yesterday" : "tomorrow" }
    if d < 7 { return say(d, "day", "d") }
    if d < 30 { return say(floor(d / 7), "week", "w") }
    if d < 365 { return say(floor(d / 30), "month", "mo") }
    say(floor(d / 365), "year", "y")
}

component RelativeTime(time: str, at: str? = null, style: str = "long", title: bool = true, class: str? = null) {
    style global relative_time_css
    state tick = now()
    let moment = date.ms(time)
    let fixed = at != null ? date.ms(at) : null
    let gap = (fixed ?? tick) - moment
    let wait_ms = abs(gap) < 60000 ? 5000 : (abs(gap) < 3600000 ? 30000 : 300000)
    // A new time is counted from the clock as it is now, not as it was at the last tick.
    // The first one keeps the server's clock, so the browser takes up the server's text.
    state counted = moment
    if fixed == null && moment != counted {
        counted = moment
        tick = now()
    }
    if fixed == null {
        every(wait_ms, () => { tick = now() })
    }
    let full = len(time) > 10 ? date.format(time, "dddd D MMMM YYYY, HH:mm") : date.format(time, "dddd D MMMM YYYY")
    <time class={ui_cls(["ui-relative-time", class])} datetime={time} title={title ? full : null}
          aria-label={title ? `${relative_time_text(gap, "long")} (${full})` : null}>{relative_time_text(gap, style)}</time>
}
