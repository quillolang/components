// SkipLink: "Skip to content", the first thing the keyboard reaches on a page. It is
// out of sight until it is focused (Tab from the address bar), then shows at the top
// left; following it moves the focus past the navigation to the page's content.
// Put it first in <body>, and give the content an id.
//
//   <body><SkipLink target="main"/> <Navbar .../> <main id="main" tabindex="-1">...</main></body>
//   <SkipLink target="results" text="Skip to results"/>
//
// target: the id of the element to go to ("main"). The element should take focus
// (a <main>, or anything with tabindex="-1"), so the keyboard carries on from there.
// text: the link's text ("Skip to content"). shown: keep it in view (to see it in a
// page's docs; it still moves the focus).

import ui/theme.qwe use ui_cls

let skip_link_css = css`
.ui-skip {
  position: fixed; top: 8px; left: 8px; z-index: 100; padding: 10px 16px; border-radius: var(--ui-radius-sm);
  background: var(--ui-accent); color: var(--ui-accent-fg); font: 500 14px/1 var(--ui-font); text-decoration: none;
  box-shadow: var(--ui-shadow-lg); transform: translateY(calc(-100% - 16px)); opacity: 0;
  transition: transform .15s, opacity .15s;
}
.ui-skip:focus, .ui-skip-shown { outline: none; transform: none; opacity: 1; }
.ui-skip:focus { box-shadow: var(--ui-shadow-lg), 0 0 0 3px var(--ui-accent-fg); }
.ui-skip-shown { position: static; display: inline-block; box-shadow: var(--ui-shadow); }
@media (prefers-reduced-motion: reduce) { .ui-skip { transition: none; } }
`

view SkipLink(target: str = "main", text: str = "Skip to content", shown: bool = false, id: str? = null, class: str? = null) {
    style global skip_link_css
    <a class={ui_cls(["ui-skip", shown && "ui-skip-shown", class])} id={id} href={`#${target}`}>{text}</a>
}
