// ScrollArea: a box with scrollbars of its own, no taller (or wider) than it is
// told, whose content fades out at an edge where there is more to see. The fades
// follow the scrolling in CSS alone (scroll-driven animations); browsers without
// them show no fade. The box takes focus, so the keyboard scrolls it, and screen
// readers hear it as a region with its name.
//
//   <ScrollArea height="280px" label="Release notes"> {for r in releases => <p>...</p>} </ScrollArea>
//   <ScrollArea axis="x" label="Steps"> <div style="display: flex; gap: 12px"> ... </div> </ScrollArea>
//
// height: how tall it may be, as CSS ("280px"); width: how wide (none).
// axis: "y" (down, the default), "x" (across) or "both".
// label: its name for screen readers; without one it is a plain box.
// fade: the fades at the edges (true). pad: room inside, in pixels (0).
// thin: a slim scrollbar (true).

import ui/theme.qwe use ui_cls

let scroll_area_css = css`
.ui-scroll {
  position: relative; max-height: var(--ui-scroll-h, none); max-width: var(--ui-scroll-w, none); min-width: 0;
  overflow: hidden auto; overscroll-behavior: contain; padding: var(--ui-scroll-pad, 0); outline: none;
  border-radius: var(--ui-radius-sm); color: var(--ui-fg); font: 15px/1.5 var(--ui-font);
}
.ui-scroll-x { overflow: auto hidden; }
.ui-scroll-both { overflow: auto; }
.ui-scroll-thin { scrollbar-width: thin; scrollbar-color: var(--ui-strong) transparent; }
.ui-scroll:focus-visible { box-shadow: var(--ui-focus); }
.ui-scroll-fade { position: sticky; z-index: 1; display: block; pointer-events: none; opacity: 0; }
.ui-scroll-top, .ui-scroll-bottom { left: 0; right: 0; height: 0; }
.ui-scroll-top { top: 0; }
.ui-scroll-bottom { bottom: 0; }
.ui-scroll-top::before, .ui-scroll-bottom::before { content: ""; position: absolute; left: 0; right: 0; height: 28px; }
.ui-scroll-top::before { top: 0; background: linear-gradient(var(--ui-scroll-bg, var(--ui-bg)), transparent); }
.ui-scroll-bottom::before { bottom: 0; background: linear-gradient(transparent, var(--ui-scroll-bg, var(--ui-bg))); }
.ui-scroll-start, .ui-scroll-end { top: 0; bottom: 0; width: 0; height: 0; float: left; }
.ui-scroll-start { left: 0; }
.ui-scroll-end { right: 0; float: right; }
.ui-scroll-start::before, .ui-scroll-end::before { content: ""; position: absolute; top: 0; bottom: 0; width: 28px; }
.ui-scroll-start::before { left: 0; background: linear-gradient(to right, var(--ui-scroll-bg, var(--ui-bg)), transparent); }
.ui-scroll-end::before { right: 0; background: linear-gradient(to left, var(--ui-scroll-bg, var(--ui-bg)), transparent); }
@supports (animation-timeline: scroll()) {
  .ui-scroll-top { animation: ui-scroll-show linear both; animation-timeline: scroll(nearest block); animation-range: 0 40px; }
  .ui-scroll-bottom { animation: ui-scroll-hide linear both; animation-timeline: scroll(nearest block); animation-range: calc(100% - 40px) 100%; }
  .ui-scroll-start { animation: ui-scroll-show linear both; animation-timeline: scroll(nearest inline); animation-range: 0 40px; }
  .ui-scroll-end { animation: ui-scroll-hide linear both; animation-timeline: scroll(nearest inline); animation-range: calc(100% - 40px) 100%; }
}
@keyframes ui-scroll-show { from { opacity: 0; } to { opacity: 1; } }
@keyframes ui-scroll-hide { from { opacity: 1; } to { opacity: 0; } }
`

view ScrollArea(height: str? = "280px", width: str? = null, axis: str = "y", label: str? = null, fade: bool = true,
                pad: int = 0, thin: bool = true, id: str? = null, class: str? = null, children) {
    style global scroll_area_css
    let across = axis == "x" || axis == "both"
    let down = axis == "y" || axis == "both"
    <div class={ui_cls(["ui-scroll", axis == "x" && "ui-scroll-x", axis == "both" && "ui-scroll-both", thin && "ui-scroll-thin", class])}
         id={id} tabindex={label != null ? "0" : null} role={label != null ? "region" : null} aria-label={label}
         style={`--ui-scroll-h: ${height ?? "none"}; --ui-scroll-w: ${width ?? "none"}; --ui-scroll-pad: ${pad}px`}>
        {fade && down && <span.ui-scroll-fade.ui-scroll-top aria-hidden="true"></span>}
        {fade && across && <span.ui-scroll-fade.ui-scroll-start aria-hidden="true"></span>}
        {children}
        {fade && across && <span.ui-scroll-fade.ui-scroll-end aria-hidden="true"></span>}
        {fade && down && <span.ui-scroll-fade.ui-scroll-bottom aria-hidden="true"></span>}
    </div>
}
