// ButtonGroup: puts buttons side by side, joined edge to edge into one control
// (or spaced, with attached={false}). It is a role="group", named by its label.
//
//   <ButtonGroup label="Text alignment">
//       <Button variant="outline">Left</Button>
//       <Button variant="outline">Centre</Button>
//       <Button variant="outline">Right</Button>
//   </ButtonGroup>
//
// children: Buttons, IconButtons, or any elements with a border and a radius.
// attached: false spaces them 8px apart instead. vertical: one above another.
// full: as wide as its container, the buttons sharing the width.

let button_group_css = css`
.ui-button-group { display: inline-flex; align-items: stretch; vertical-align: middle; }
.ui-button-group-spaced { flex-wrap: wrap; gap: 8px; }
.ui-button-group-vertical { flex-direction: column; }
.ui-button-group-full { display: flex; width: 100%; }
.ui-button-group-full > * { flex: 1; }
.ui-button-group-attached > * { position: relative; }
.ui-button-group-attached > :hover, .ui-button-group-attached > :focus-visible { z-index: 1; }
.ui-button-group-attached:not(.ui-button-group-vertical) > * + * { margin-left: -1px; }
.ui-button-group-attached:not(.ui-button-group-vertical) > :not(:first-child) { border-top-left-radius: 0; border-bottom-left-radius: 0; }
.ui-button-group-attached:not(.ui-button-group-vertical) > :not(:last-child) { border-top-right-radius: 0; border-bottom-right-radius: 0; }
.ui-button-group-attached.ui-button-group-vertical > * + * { margin-top: -1px; }
.ui-button-group-attached.ui-button-group-vertical > :not(:first-child) { border-top-left-radius: 0; border-top-right-radius: 0; }
.ui-button-group-attached.ui-button-group-vertical > :not(:last-child) { border-bottom-left-radius: 0; border-bottom-right-radius: 0; }
.ui-button-group-attached:not(.ui-button-group-vertical) > :is(.ui-btn-solid, .ui-icon-btn-solid) + :is(.ui-btn-solid, .ui-icon-btn-solid) {
  margin-left: 0; border-left: 1px solid color-mix(in srgb, var(--ui-bg) 30%, transparent);
}
.ui-button-group-attached.ui-button-group-vertical > :is(.ui-btn-solid, .ui-icon-btn-solid) + :is(.ui-btn-solid, .ui-icon-btn-solid) {
  margin-top: 0; border-top: 1px solid color-mix(in srgb, var(--ui-bg) 30%, transparent);
}
`

view ButtonGroup(label: str? = null, attached: bool = true, vertical: bool = false, full: bool = false,
                 class: str? = null, children) {
    style global button_group_css
    <div class={ui_cls(["ui-button-group", attached ? "ui-button-group-attached" : "ui-button-group-spaced",
                        vertical && "ui-button-group-vertical", full && "ui-button-group-full", class])}
         role="group" aria-label={label}>
        {children}
    </div>
}
