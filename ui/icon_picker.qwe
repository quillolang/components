// IconPicker: pick an icon from a grid, with a search box that narrows it as one
// types (by name and by other words: "trash" also finds "delete"). The icons are
// radio buttons, so the arrow keys move between them; the name of the one picked
// goes in a hidden input named `name`, so a plain <form> sends it.
//
//   <IconPicker id="cat-icon" name="icon" label="Category icon" value="star"/>
//   <IconPicker id="app-icon" label="App icon" only={["home", "star", "heart", "bell"]} search={false}
//               on_change={(n) => { icon = n }}/>
//
// id: a prefix for its ids, unique on the page. value: the icon picked to start
// with. only: the names to offer, in place of the 51 built in
// (`icon_picker_icons`: { name: [svg path, extra words] }; `icon_picker_svg(name)`
// draws one anywhere). search (true): the search box. columns (8): icons per row
// where there is room. empty: what the grid says when nothing matches
// ("No icons match"). label, hint, error, required and size ("sm" or "md") as for
// every field.
// on_change(name): inside one of your components, given the icon's name.

let icon_picker_css = css`
.ui-icon-picker { display: grid; gap: 8px; min-width: 0; margin: 0; padding: 0; border: 0; font: 14px/1.4 var(--ui-font); color: var(--ui-fg); }
.ui-icon-picker-legend { padding: 0; font-size: 13px; font-weight: 500; }
.ui-icon-picker-req { margin-left: 2px; color: var(--ui-danger); }
.ui-icon-picker-panel { display: grid; gap: 8px; padding: 10px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius); background: var(--ui-surface); }
.ui-icon-picker-search {
  box-sizing: border-box; width: 100%; height: 34px; margin: 0; padding: 0 10px; border: 1px solid var(--ui-border);
  border-radius: var(--ui-radius-sm); background: var(--ui-surface); color: var(--ui-fg); font: 13px var(--ui-font);
}
.ui-icon-picker-search::placeholder { color: var(--ui-muted); opacity: 1; }
.ui-icon-picker-search:focus { outline: none; border-color: var(--ui-accent); box-shadow: var(--ui-focus); }
.ui-icon-picker-grid {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(40px, 1fr)); gap: 4px; max-height: 220px; overflow: auto;
  max-width: calc(var(--cols) * 44px); padding: 2px;
}
.ui-icon-picker-opt { position: relative; display: grid; place-items: center; height: 40px; border-radius: var(--ui-radius-sm); color: var(--ui-fg); cursor: pointer; }
.ui-icon-picker-opt input { position: absolute; opacity: 0; width: 1px; height: 1px; margin: 0; }
.ui-icon-picker-opt svg { width: 20px; height: 20px; }
.ui-icon-picker-opt:hover { background: var(--ui-subtle); }
.ui-icon-picker-opt:has(input:checked) { background: var(--ui-accent); color: var(--ui-accent-fg); }
.ui-icon-picker-opt:has(input:focus-visible) { box-shadow: var(--ui-focus); }
.ui-icon-picker-empty { padding: 14px 4px; color: var(--ui-muted); font-size: 13px; text-align: center; }
.ui-icon-picker-status { display: flex; justify-content: space-between; gap: 8px; font-size: 12px; color: var(--ui-muted); }
.ui-icon-picker-status b { color: var(--ui-fg); font-weight: 500; }
.ui-icon-picker-sm .ui-icon-picker-opt { height: 32px; }
.ui-icon-picker-sm .ui-icon-picker-opt svg { width: 16px; height: 16px; }
.ui-icon-picker-sm .ui-icon-picker-grid { grid-template-columns: repeat(auto-fill, minmax(32px, 1fr)); max-width: calc(var(--cols) * 36px); }
.ui-icon-picker-invalid .ui-icon-picker-panel { border-color: var(--ui-danger); }
.ui-icon-picker-hint, .ui-icon-picker-error { margin: 0; font-size: 13px; color: var(--ui-muted); }
.ui-icon-picker-error { color: var(--ui-danger); }
`

// Each icon: its path (24 by 24, drawn with a 2px stroke) and the other words it is found by.
