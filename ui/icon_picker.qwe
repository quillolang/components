// An icon drawn as inline SVG, 1em square unless styled.
fn icon_picker_svg(name: str) {
    let it = icon_picker_icons[name]
    it == null ? null : <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                             stroke-linejoin="round" aria-hidden="true" width="1em" height="1em"><path d={it[0]}/></svg>
}

// "map-pin" as "map pin": an icon's name for people.
fn icon_picker_said(name: str) -> str = replace(name, "-", " ")

component IconPicker(id: str, name: str? = null, label: str? = null, value: str? = null, only: list? = null,
                     search: bool = true, columns: int = 8, empty: str = "No icons match", hint: str? = null,
                     error: str? = null, required: bool = false, size: str = "md", on_change = null, class: str? = null) {
    style global icon_picker_css
    state chosen = value
    state query = ""
    let names = only ?? (keys(icon_picker_icons) | sort_by((n) => n))
    let needle = lower(trim(query))
    let shown = needle == "" ? names
        : names | filter((n) => contains(n, needle) || contains(icon_picker_icons[n] != null ? icon_picker_icons[n][1] : "", needle))
    let described = ui_cls([hint != null && `${id}-hint`, error != null && `${id}-error`])
    <fieldset class={ui_cls(["ui-icon-picker", size == "sm" && "ui-icon-picker-sm", error != null && "ui-icon-picker-invalid", class])}
              id={id} aria-describedby={described != "" ? described : null}>
        {label != null && <legend.ui-icon-picker-legend>
            {label}{required && <span.ui-icon-picker-req aria-hidden="true">*</span>}
        </legend>}
        <div.ui-icon-picker-panel>
            {search && <input.ui-icon-picker-search type="search" id={`${id}-search`} placeholder="Search icons" value={query}
                              autocomplete="off" spellcheck="false" aria-label="Search icons" aria-controls={`${id}-grid`}
                              form="ui-icon-picker-none" @input={(e) => { query = e.value }}/>}
            <div.ui-icon-picker-grid id={`${id}-grid`} role="radiogroup" aria-label={label ?? "Icons"} style={`--cols: ${columns}`}>
                {for n in shown => <label.ui-icon-picker-opt key={n} title={icon_picker_said(n)}>
                    <input type="radio" name={`${id}-radio`} value={n} checked={n == chosen} form="ui-icon-picker-none"
                           aria-label={icon_picker_said(n)}
                           @change={() => {
                               chosen = n
                               on_change && on_change(n)
                           }}/>
                    {icon_picker_svg(n)}
                </label>}
                {len(shown) == 0 && <p.ui-icon-picker-empty role="status">{empty}</p>}
            </div>
            <div.ui-icon-picker-status aria-live="polite">
                <span>{chosen != null ? ["Picked: ", <b>{icon_picker_said(chosen)}</b>] : "None picked"}</span>
                <span>{len(shown)} of {len(names)}</span>
            </div>
        </div>
        {name != null && <input type="hidden" name={name} value={chosen ?? ""} required={required}/>}
        {hint != null && <p.ui-icon-picker-hint id={`${id}-hint`}>{hint}</p>}
        {error != null && <p.ui-icon-picker-error id={`${id}-error`} role="alert">{error}</p>}
    </fieldset>
}
