        "terminal" => "m4 17 6-6-6-6M12 19h8"
        "x-circle" => "M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20ZM15 9l-6 6M9 9l6 6"
        "check-circle" => "M22 11.08V12a10 10 0 1 1-5.93-9.14M22 4 12 14.01l-3-3"
