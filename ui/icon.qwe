// Icon: one of the kit's icons by name, drawn inline as SVG in the text's colour,
// so it sits in a button, a link or a line of text and follows the theme.
//
//   <Icon name="search"/>
//   <Icon name="warning" size="lg" label="Warning"/>
//   <button><Icon name="trash"/> Delete</button>
//
// name: one of icon_names (below): search, close, check, plus, minus, menu, more,
// user, users, settings, trash, edit, copy, link, external, info, warning, help,
// star, heart, mail, phone, calendar, clock, download, upload, share, refresh,
// filter, sort, home, bell, lock, unlock, eye, eye-off, image, file, folder, globe,
// bookmark, tag, grid, list, map-pin, camera, video, mic, sun, moon, play, pause,
// volume, volume-off, maximize, minimize, zoom-in, zoom-out, printer, cart,
// credit-card, send, log-out, code, terminal, x-circle, check-circle, alert-circle,
// skip-back, skip-forward, arrow-up, arrow-down, arrow-left, arrow-right,
// chevron-up, chevron-down, chevron-left, chevron-right. A name it does not know
// draws the "help" icon and carries data-missing="true".
// size: "xs" (12px), "sm" (16px), "md" (20px, default), "lg" (24px) or "xl" (32px);
// px: a size in pixels instead.
// label: what screen readers say (role "img"); without one the icon is decoration,
// hidden from them, and the text beside it is what they read.
// stroke: the line's width (2); 1.5 reads lighter at large sizes.
// icon_path(name) gives a name's path data, for drawing one in your own SVG.

let icon_css = css`
.ui-icon {
  display: inline-block; flex: none; width: 20px; height: 20px; vertical-align: -.22em;
  fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round;
}
.ui-icon-xs { width: 12px; height: 12px; }
.ui-icon-sm { width: 16px; height: 16px; }
.ui-icon-lg { width: 24px; height: 24px; }
.ui-icon-xl { width: 32px; height: 32px; }
`

let icon_names = [
    "search", "close", "check", "plus", "minus", "menu", "more", "user", "users", "settings", "trash", "edit",
    "copy", "link", "external", "info", "warning", "help", "star", "heart", "mail", "phone", "calendar", "clock",
    "download", "upload", "share", "refresh", "filter", "sort", "home", "bell", "lock", "unlock", "eye", "eye-off",
    "image", "file", "folder", "globe", "bookmark", "tag", "grid", "list", "map-pin", "camera", "video", "mic",
    "sun", "moon", "play", "pause", "volume", "volume-off", "maximize", "minimize", "zoom-in", "zoom-out",
    "printer", "cart", "credit-card", "send", "log-out", "code", "terminal", "x-circle", "check-circle",
    "alert-circle", "skip-back", "skip-forward", "arrow-up", "arrow-down", "arrow-left", "arrow-right",
    "chevron-up", "chevron-down", "chevron-left", "chevron-right",
]

// The path data of an icon (24 by 24, a 2px line), or null for a name it does not know.
fn icon_path(name: str) -> str? =
    match name {
        "search" => "M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16ZM21 21l-4.3-4.3"
        "close" => "M18 6 6 18M6 6l12 12"
        "check" => "M20 6 9 17l-5-5"
        "plus" => "M12 5v14M5 12h14"
        "minus" => "M5 12h14"
        "menu" => "M4 6h16M4 12h16M4 18h16"
