        "arrow-left" => "M19 12H5M12 19l-7-7 7-7"
        "arrow-right" => "M5 12h14M12 5l7 7-7 7"
        "chevron-up" => "m18 15-6-6-6 6"
        "chevron-down" => "m6 9 6 6 6-6"
        "chevron-left" => "m15 18-6-6 6-6"
        "chevron-right" => "m9 18 6-6-6-6"
        _ => null
    }

view Icon(name: str, size: str = "md", px: int? = null, label: str? = null, stroke: num = 2, class: str? = null) {
    style global icon_css
    let d = icon_path(name)
    <svg class={ui_cls(["ui-icon", px == null && size != "md" && `ui-icon-${size}`, class])}
         style={px != null ? `width: ${px}px; height: ${px}px` : null} viewBox="0 0 24 24" stroke-width={stroke}
         data-icon={name} data-missing={d == null ? "true" : null}
         role={label != null ? "img" : null} aria-label={label} aria-hidden={label == null ? "true" : null}>
        <path d={d ?? icon_path("help")}/>
    </svg>
}
