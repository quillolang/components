// MatchHighlight: a text with the parts that match a search marked, as <mark>, in
// any case and wherever they are; each word of the query is looked for on its own.
// A view: it needs no script, and components (SearchList) use it as they filter.
//
//   <MatchHighlight text="Deploying a Quillo app to Fly.io" query="quillo deploy"/>
//   <p>{for r in results => <MatchHighlight text={r.title} query={q}/>}</p>
//
// text: what to show. query: what was searched; split into words at spaces, and
// each found in every place (so "to" marks both of "Toronto"). An empty query
// marks nothing. class: added to the wrapping <span>.
// match_highlight_parts(text, query) gives the pieces as [{ text, hit }], to mark
// them some other way.

let match_highlight_css = css`
.ui-mh-mark {
  padding: 0 1px; border-radius: 3px; background: color-mix(in srgb, var(--ui-warning) 26%, transparent); color: inherit;
}
@media (forced-colors: active) { .ui-mh-mark { background: Mark; color: MarkText; } }
`

// The words of a query in lower case, without repeats: "Rust  web" is ["rust", "web"].
fn match_highlight_words(query: str) -> list =
    re.split(lower(trim(query)), "\\s+") | filter((w) => w != "") | unique

// The text in pieces: [{ text, hit }], hit where a word of the query is.
fn match_highlight_parts(text: str, query: str) -> list {
    let words = match_highlight_words(query) | map((w) => split(w, ""))
    let cs = split(text, "")
    let low = split(lower(text), "")
    let n = len(cs)
    if len(words) == 0 || n == 0 || len(low) != n { return [{ text, hit: false }] }
    let parts = []
    let run = ""
    let run_hit = false
    let reach = 0
    let i = 0
    while i < n {
        let k = 0
        while k < len(words) {
            let w = words[k]
            let lw = len(w)
            if i + lw > reach && i + lw <= n {
                let j = 0
                while j < lw && low[i + j] == w[j] { j += 1 }
                if j == lw { reach = i + lw }
            }
            k += 1
        }
        let hit = i < reach
        if hit != run_hit && run != "" {
            parts = parts | push({ text: run, hit: run_hit })
            run = ""
        }
        run_hit = hit
        run = run + cs[i]
        i += 1
    }
    parts | push({ text: run, hit: run_hit })
}

view MatchHighlight(text: str, query: str = "", class: str? = null) =
    <span class={class}>{for p in match_highlight_parts(text, query) => p.hit ? <mark.ui-mh-mark>{p.text}</mark> : p.text}</span>
