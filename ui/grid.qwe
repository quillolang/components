// Grid: lays its children out in columns that fit the screen.
//
//   <Grid min={240}> {for p in products => <Card title={p.name}>...</Card>} </Grid>
//   <Grid columns={3} gap="lg"> ... </Grid>
//
// min: the narrowest a column may be, in pixels (220, the default): as many
// columns as fit, and one on a phone. columns: a fixed number instead; three or
// more become two under 900px, and every grid is one column under 560px.
// gap: pixels (16, the default) or "none", "xs" (4), "sm" (8), "md" (16), "lg" (24), "xl" (32).

let grid_css = css`
.ui-grid {
  display: grid; gap: var(--ui-grid-gap, 16px);
  grid-template-columns: repeat(auto-fill, minmax(min(var(--ui-grid-min, 220px), 100%), 1fr));
}
.ui-grid > * { min-width: 0; }
.ui-grid-cols { grid-template-columns: repeat(var(--ui-grid-cols), minmax(0, 1fr)); }
@media (max-width: 899px) { .ui-grid-many { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (max-width: 559px) { .ui-grid-cols { grid-template-columns: minmax(0, 1fr); } }
`

fn grid_gap(gap) =
    match gap {
        int as n => `${n}px`
        float as n => `${n}px`
        "none" => "0"
        "xs" => "4px"
        "sm" => "8px"
        "lg" => "24px"
        "xl" => "32px"
        _ => "16px"
    }

view Grid(columns: int? = null, min: int = 220, gap = 16, class: str? = null, children) =
    <div class={ui_cls(["ui-grid", columns != null && "ui-grid-cols", columns != null && columns > 2 && "ui-grid-many", class])}
         style={columns != null
             ? `--ui-grid-cols: ${columns}; --ui-grid-gap: ${grid_gap(gap)}`
             : `--ui-grid-min: ${min}px; --ui-grid-gap: ${grid_gap(gap)}`}>
        {children}
    </div>
