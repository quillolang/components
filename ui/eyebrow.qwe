// Eyebrow: a small uppercase label above a heading: the section, the category,
// the kind of thing on the page.
//
//   <Eyebrow>New in 0.9</Eyebrow>
//   <Heading level={1}>Live queries</Heading>
//   <Eyebrow tone="accent" dot={true}>Beta</Eyebrow>
//
// children: the text. tone: "muted" (default), "accent", "success", "warning",
// "danger" or "info". dot: a coloured dot before the text. tag: "p" (default),
// "span" or "div". align: "start" (default), "center" or "end". id: the element's id.

let eyebrow_css = css`
.ui-eyebrow { display: block; margin: 0 0 6px; font: 600 12px/1.4 var(--ui-font); letter-spacing: .08em; text-transform: uppercase;
  color: var(--ui-muted); --e: var(--ui-muted); }
span.ui-eyebrow { display: inline-flex; margin: 0; }
.ui-eyebrow-accent { color: var(--ui-accent); --e: var(--ui-accent); }
.ui-eyebrow-success { color: var(--ui-success); --e: var(--ui-success); }
.ui-eyebrow-warning { color: var(--ui-warning); --e: var(--ui-warning); }
.ui-eyebrow-danger { color: var(--ui-danger); --e: var(--ui-danger); }
.ui-eyebrow-info { color: var(--ui-info); --e: var(--ui-info); }
.ui-eyebrow-dot::before { content: ""; display: inline-block; width: 7px; height: 7px; margin: 0 8px 1px 0; border-radius: 50%;
  background: var(--e); vertical-align: middle; }
.ui-eyebrow-center { text-align: center; }
.ui-eyebrow-end { text-align: end; }
`

view Eyebrow(tone: str = "muted", dot: bool = false, tag: str = "p", align: str = "start", id: str? = null,
             class: str? = null, children) {
    style global eyebrow_css
    let cls = ui_cls(["ui-eyebrow", tone != "muted" && `ui-eyebrow-${tone}`, dot && "ui-eyebrow-dot",
                      align != "start" && `ui-eyebrow-${align}`, class])
    match tag {
        "span" => <span class={cls} id={id}>{children}</span>
        "div" => <div class={cls} id={id}>{children}</div>
        _ => <p class={cls} id={id}>{children}</p>
    }
}
