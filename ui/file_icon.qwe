// FileIcon: a file's icon by its extension, with the extension written on it and
// a colour for its kind, so a list of files reads at a glance.
//
//   <FileIcon ext="pdf"/>
//   <FileIcon name="Q3 report.xlsx" size="lg"/>
//   <li><FileIcon name={f.name} size="sm"/> {f.name}</li>
//
// ext: the extension ("pdf", "XLSX", with or without the dot); or name, a file
// name it is taken from ("notes.final.md" gives "md"). Neither, or no extension:
// a plain file. size: "sm" (24px tall), "md" (36px, default), "lg" (52px) or
// "xl" (72px). label: what screen readers say ("PDF file" by default); hidden
// from them when label is "".
// Kinds, each its own colour: document (doc, docx, odt, rtf, pages), sheet (xls,
// xlsx, csv, ods, numbers), slides (ppt, pptx, key, odp), pdf, image (png, jpg,
// jpeg, gif, svg, webp, heic, bmp, tiff), video (mp4, mov, webm, mkv, avi), audio
// (mp3, wav, flac, aac, ogg, m4a), archive (zip, tar, gz, rar, 7z, dmg), code (js,
// ts, py, rs, go, rb, java, c, h, cpp, cs, php, swift, kt, qwe, html, css, json,
// yaml, yml, toml, xml, sh, sql), text (txt, md, log) and other.
// file_icon_kind(ext) gives the kind's name, to colour something else by it.

let file_icon_css = css`
.ui-file-icon { display: inline-block; flex: none; width: auto; height: 36px; vertical-align: middle; --c: var(--ui-muted); }
.ui-file-icon-sm { height: 24px; }
.ui-file-icon-lg { height: 52px; }
.ui-file-icon-xl { height: 72px; }
.ui-file-icon-sheet { --c: #18794e; } .ui-file-icon-document { --c: #0b6bcb; } .ui-file-icon-slides { --c: #d9480f; }
.ui-file-icon-pdf { --c: #c62a2f; } .ui-file-icon-image { --c: #7c3aed; } .ui-file-icon-video { --c: #be185d; }
.ui-file-icon-audio { --c: #0e7490; } .ui-file-icon-archive { --c: #8a6d1a; } .ui-file-icon-code { --c: #2f6b3a; }
.ui-file-icon-text { --c: #5e5c6e; }
.ui-file-icon-page { fill: var(--ui-surface); stroke: var(--ui-strong); stroke-width: 1.5; }
.ui-file-icon-fold { fill: var(--ui-subtle); stroke: var(--ui-strong); stroke-width: 1.5; stroke-linejoin: round; }
.ui-file-icon-tag { fill: var(--c); }
.ui-file-icon-ext { fill: #fff; font: 700 9px/1 var(--ui-font); letter-spacing: .03em; text-anchor: middle; }
.ui-file-icon-long .ui-file-icon-ext { font-size: 7.5px; }
`

// The extension of a file name, lower-case, or "" when it has none.
fn file_icon_ext(name: str) -> str {
    let base = last(split(name, "/")) ?? ""
    let parts = split(base, ".")
    len(parts) < 2 || parts[-1] == "" ? "" : lower(parts[-1])
}

// The kind of file an extension names: "document", "sheet", "slides", "pdf", "image",
// "video", "audio", "archive", "code", "text" or "other".
fn file_icon_kind(ext: str) -> str =
    match lower(ext) {
        "doc" | "docx" | "odt" | "rtf" | "pages" => "document"
        "xls" | "xlsx" | "csv" | "ods" | "numbers" => "sheet"
        "ppt" | "pptx" | "key" | "odp" => "slides"
        "pdf" => "pdf"
        "png" | "jpg" | "jpeg" | "gif" | "svg" | "webp" | "heic" | "bmp" | "tiff" => "image"
        "mp4" | "mov" | "webm" | "mkv" | "avi" => "video"
        "mp3" | "wav" | "flac" | "aac" | "ogg" | "m4a" => "audio"
        "zip" | "tar" | "gz" | "rar" | "7z" | "dmg" => "archive"
        "js" | "ts" | "py" | "rs" | "go" | "rb" | "java" | "c" | "h" | "cpp" | "cs" | "php" | "swift" | "kt" | "qwe"
            | "html" | "css" | "json" | "yaml" | "yml" | "toml" | "xml" | "sh" | "sql" => "code"
        "txt" | "md" | "log" => "text"
        _ => "other"
    }

view FileIcon(ext: str? = null, name: str? = null, size: str = "md", label: str? = null, class: str? = null) {
    style global file_icon_css
    let e = lower(replace(ext ?? (name != null ? file_icon_ext(name) : ""), ".", ""))
    let kind = e == "" ? "other" : file_icon_kind(e)
    let shown = upper(len(e) > 5 ? slice(e, 0, 5) : e)
    let said = label ?? (e == "" ? "File" : `${shown} file`)
    <svg class={ui_cls(["ui-file-icon", size != "md" && `ui-file-icon-${size}`, kind != "other" && `ui-file-icon-${kind}`,
                        len(shown) > 3 && "ui-file-icon-long", class])}
         viewBox="0 0 32 40" data-ext={e} data-kind={kind}
         role={said != "" ? "img" : null} aria-label={said != "" ? said : null} aria-hidden={said == "" ? "true" : null}>
        <path.ui-file-icon-page d="M5 1h15l8 8v29a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1Z"/>
        <path.ui-file-icon-fold d="M20 1v8h8"/>
        {shown != "" && [
            <rect.ui-file-icon-tag x="1" y="22" width="26" height="12" rx="2"/>,
            <text.ui-file-icon-ext x="14" y="31">{shown}</text>,
        ]}
    </svg>
}
