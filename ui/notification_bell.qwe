// NotificationBell: a bell with the number of unread notifications on its corner, for
// a navbar. It opens nothing itself: it is a link to the notifications page, or a
// button that opens any panel (a popover by its id, or your own component's state).
//
//   <NotificationBell count={3} href="/notifications"/>
//   <NotificationBell count={12} target="alerts-panel"/>   opens <div id="alerts-panel" popover>…</div>
//   <NotificationBell count={n} on_click={() => { open = !open }}/>
//
// count: how many are unread; 0 shows no badge. limit: past it the badge says "99+"
// (99). dot: a dot instead of the number, for when the count is unknown. href: makes it
// a link. target: the id of a popover it opens (popovertarget). label: its name
// ("Notifications"); screen readers hear "Notifications, 3 unread". size: "sm", "md"
// (default) or "lg". ring: the bell swings once when the count goes up (CSS, on the
// badge appearing; still for people who ask for less motion). on_click(): inside one
// of your components, what a click does.

let notification_bell_css = css`
.ui-bell {
  position: relative; display: inline-flex; align-items: center; justify-content: center; width: 38px; height: 38px; padding: 0;
  border: 0; border-radius: var(--ui-radius-sm); background: transparent; color: var(--ui-fg); cursor: pointer;
  text-decoration: none; transition: background .12s;
}
.ui-bell:hover { background: var(--ui-subtle); }
.ui-bell:focus-visible { outline: none; box-shadow: var(--ui-focus); }
.ui-bell svg { width: 22px; height: 22px; transform-origin: 50% 4px; }
.ui-bell-ring:has(.ui-bell-count) svg { animation: ui-bell-swing .8s ease-in-out 1; }
@keyframes ui-bell-swing { 20% { transform: rotate(14deg); } 40% { transform: rotate(-12deg); } 60% { transform: rotate(8deg); } 80% { transform: rotate(-5deg); } }
.ui-bell-count {
  position: absolute; top: 4px; left: 50%; margin-left: 2px; min-width: 17px; height: 17px; padding: 0 4px; border-radius: 999px;
  border: 2px solid var(--ui-bg); background: var(--ui-danger); color: #fff; font: 700 10px/13px var(--ui-font); text-align: center;
  font-variant-numeric: tabular-nums;
}
.ui-bell-dot { min-width: 10px; height: 10px; padding: 0; margin-left: 4px; top: 6px; }
.ui-bell-sm { width: 30px; height: 30px; }
.ui-bell-sm svg { width: 18px; height: 18px; }
.ui-bell-sm .ui-bell-count { top: 1px; margin-left: 0; }
.ui-bell-lg { width: 46px; height: 46px; }
.ui-bell-lg svg { width: 26px; height: 26px; }
.ui-bell-lg .ui-bell-count { top: 6px; margin-left: 4px; }
@media (prefers-reduced-motion: reduce) { .ui-bell { transition: none; } .ui-bell-ring:has(.ui-bell-count) svg { animation: none; } }
`

view NotificationBell(count: int = 0, limit: int = 99, dot: bool = false, href: str? = null, target: str? = null,
                      label: str = "Notifications", size: str = "md", ring: bool = true, id: str? = null, on_click = null,
                      class: str? = null) {
    style global notification_bell_css
    let cls = ui_cls(["ui-bell", size != "md" && `ui-bell-${size}`, ring && "ui-bell-ring", class])
    let said = count > 0 ? `${label}, ${count} unread` : label
    let body = [
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
             aria-hidden="true"><path d="M6 16V11a6 6 0 0 1 12 0v5l2 2H4zM10 21h4"/></svg>,
        count > 0 && <span class={ui_cls(["ui-bell-count", dot && "ui-bell-dot"])} aria-hidden="true">{dot ? "" : count > limit ? `${limit}+` : count}</span>,
    ]
    href != null
        ? <a class={cls} id={id} href={href} aria-label={said} title={label}>{body}</a>
        : <button class={cls} id={id} type="button" aria-label={said} title={label} popovertarget={target}
                  @click={() => { on_click && on_click() }}>{body}</button>
}
