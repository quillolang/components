// OrderedList: a numbered list whose numbers are drawn by the kit: plain, in
// circles, as letters or as roman numerals, from any start. A real <ol>.
//
//   <OrderedList items={["Install Quillo", "Run the gallery", "Copy a component"]}/>
//   <OrderedList variant="circles" tone="accent" items={steps}/>
//   <OrderedList variant="letters" start={3}><li>c</li><li>d</li></OrderedList>
//
// items: strings (or HTML) for the items; children: <li>s written by hand (both may
// be given; items come first). variant: "numbers" (default, "1."), "circles" (a
// number in a round badge), "letters" ("a."), "roman" ("i.") or "plain" (the browser's
// own). start: the first number (1). tone: "muted" (default), "accent" or "fg", the
// numbers' colour. spacing: "tight", "normal" (default) or "loose". size: "sm", "md"
// (default) or "lg". id: the list's id.

import ui/theme.qwe use ui_cls

let ordered_list_css = css`
.ui-ol { margin: 0; padding: 0; list-style: none; counter-reset: ui-ol; font: 15px/1.5 var(--ui-font); color: var(--ui-fg);
  --ui-ol-color: var(--ui-muted); }
.ui-ol > li { position: relative; padding-left: 2em; margin: .35em 0; overflow-wrap: anywhere; counter-increment: ui-ol; }
.ui-ol > li::before { content: counter(ui-ol) "."; position: absolute; left: 0; top: 0; width: 1.6em; text-align: right;
  color: var(--ui-ol-color); font-weight: 600; font-variant-numeric: tabular-nums; }
.ui-ol-letters > li::before { content: counter(ui-ol, lower-alpha) "."; }
.ui-ol-roman > li::before { content: counter(ui-ol, lower-roman) "."; }
.ui-ol-circles > li { padding-left: 2.3em; }
.ui-ol-circles > li::before { content: counter(ui-ol); top: .1em; width: 1.5em; height: 1.5em; border-radius: 50%;
  display: inline-grid; place-items: center; background: var(--ui-ol-color); color: var(--ui-bg); font-size: .8em; line-height: 1; }
.ui-ol-plain { list-style: decimal; padding-left: 1.6em; }
.ui-ol-plain > li { padding-left: .3em; counter-increment: none; }
.ui-ol-plain > li::before { content: none; }
.ui-ol-plain > li::marker { color: var(--ui-ol-color); font-weight: 600; }
.ui-ol-accent { --ui-ol-color: var(--ui-accent); }
.ui-ol-circles.ui-ol-accent > li::before { color: var(--ui-accent-fg); }
.ui-ol-fg { --ui-ol-color: var(--ui-fg); }
.ui-ol-tight > li { margin: .1em 0; }
.ui-ol-loose > li { margin: .75em 0; }
.ui-ol-sm { font-size: 13px; }
.ui-ol-lg { font-size: 17px; }
.ui-ol li > .ui-ol { margin-top: .35em; }
`

view OrderedList(items: list = [], variant: str = "numbers", start: int = 1, tone: str = "muted", spacing: str = "normal",
                 size: str = "md", id: str? = null, class: str? = null, children) {
    style global ordered_list_css
    <ol class={ui_cls(["ui-ol", variant != "numbers" && `ui-ol-${variant}`, tone != "muted" && `ui-ol-${tone}`,
                       spacing != "normal" && `ui-ol-${spacing}`, size != "md" && `ui-ol-${size}`, class])}
        id={id} start={start != 1 ? start : null} style={start != 1 ? `counter-reset: ui-ol ${start - 1}` : null}>
        {for it in items => <li>{it}</li>}
        {children}
    </ol>
}
