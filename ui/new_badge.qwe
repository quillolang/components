// NewBadge: a small "New" (or "Beta", "Updated") label beside a menu item, a
// setting or a feature, that stops showing after a date, so nobody has to come
// back and take it out.
//
//   <a href="/reports">Reports <NewBadge until="2026-12-31"/></a>
//   <NewBadge text="Beta" tone="info"/>
//   <NewBadge text="Updated" until="2026-11-15" variant="outline" size="sm"/>
//
// text: what it says ("New"). until: a date ("2026-12-31"); after it, nothing
// is rendered. from: a date before which nothing is rendered either, for
// something launching. tone: "accent" (default), "success", "info", "warning",
// "danger" or "neutral". variant: "solid" (default), "soft" or "outline".
// size: "sm" or "md" (default). label: for screen readers, what is new
// ("Reports"), read as "New: Reports"; without one it is read as it is.
// Today is in UTC; a day either way is fine for a badge.

let new_badge_css = css`
.ui-newb { display: inline-flex; align-items: center; height: 18px; padding: 0 6px; border: 1px solid transparent; border-radius: 4px;
  vertical-align: middle; font: 700 10.5px/1 var(--ui-font); letter-spacing: .06em; text-transform: uppercase; white-space: nowrap;
  --t: var(--ui-accent); --tf: var(--ui-accent-fg); --ts: var(--ui-accent-soft); }
.ui-newb-success { --t: var(--ui-success); --tf: #fff; --ts: var(--ui-success-soft); }
.ui-newb-info { --t: var(--ui-info); --tf: #fff; --ts: var(--ui-info-soft); }
.ui-newb-warning { --t: var(--ui-warning); --tf: #fff; --ts: var(--ui-warning-soft); }
.ui-newb-danger { --t: var(--ui-danger); --tf: #fff; --ts: var(--ui-danger-soft); }
.ui-newb-neutral { --t: var(--ui-muted); --tf: var(--ui-bg); --ts: var(--ui-subtle); }
.ui-newb-solid { background: var(--t); color: var(--tf); }
.ui-newb-soft { background: var(--ts); color: var(--t); }
.ui-newb-outline { border-color: color-mix(in srgb, var(--t) 55%, var(--ui-border)); color: var(--t); }
.ui-newb-sm { height: 15px; padding: 0 4px; font-size: 9px; }
`

view NewBadge(text: str = "New", until: str? = null, from: str? = null, tone: str = "accent", variant: str = "solid",
              size: str = "md", label: str? = null, id: str? = null, class: str? = null) {
    style global new_badge_css
    let today = date.today()
    let live = (until == null || today <= until) && (from == null || today >= from)
    live && <span class={ui_cls(["ui-newb", `ui-newb-${tone}`, `ui-newb-${variant}`, size != "md" && `ui-newb-${size}`, class])} id={id}>
        {label != null ? [<span aria-hidden="true">{text}</span>, <span.ui-sr>{text}: {label}</span>] : text}
    </span>
}
