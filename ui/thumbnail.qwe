// Thumbnail: a small image in a fixed size and shape, for lists, grids and
// pickers: a product's picture beside its name, a row of files, the people
// in a thread. It can carry a line of text over its bottom, a "+N" veil for
// the ones not shown, and be a link.
//
//   <Thumbnail src="/img/shoe-sm.jpg" alt="Red running shoe" size="sm"/>
//   <Thumbnail src="/img/cover.jpg" alt="" shape="circle" size="lg" href="/albums/7" label="Open the album"/>
//   <Thumbnail src="/img/4.jpg" alt="" more={3}/>              the fourth of seven, veiled "+3"
//
// src, alt: the image (alt "" when the text beside it says what it is).
// size: "xs" (32px), "sm" (48px), "md" (64px, default), "lg" (96px) or "xl" (128px);
// px: a size in pixels instead. shape: "rounded" (default), "square" or "circle".
// fit: "cover" (default) or "contain". overlay: a short line over its bottom.
// more: a number N shown as "+N" over the image, for the ones not shown.
// href makes it a link; label is then what screen readers call the link.
// on_click(): inside one of your components, makes it a button that does that.

let thumbnail_css = css`
.ui-thumbnail {
  position: relative; display: inline-grid; flex: none; overflow: hidden; width: var(--s, 64px); height: var(--s, 64px); padding: 0;
  border: 1px solid var(--ui-border); border-radius: var(--ui-radius-sm); background: var(--ui-subtle); color: #fff;
  font: 500 12px/1.2 var(--ui-font); text-decoration: none; vertical-align: middle;
}
.ui-thumbnail-xs { --s: 32px; border-radius: 4px; }
.ui-thumbnail-sm { --s: 48px; }
.ui-thumbnail-lg { --s: 96px; }
.ui-thumbnail-xl { --s: 128px; }
.ui-thumbnail-square { border-radius: 0; }
.ui-thumbnail-circle { border-radius: 50%; }
.ui-thumbnail img { display: block; width: 100%; height: 100%; object-fit: cover; }
.ui-thumbnail-contain img { object-fit: contain; }
.ui-thumbnail-text {
  position: absolute; inset: auto 0 0 0; padding: 14px 6px 5px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  background: linear-gradient(to top, rgba(0, 0, 0, .65), transparent); text-align: center; text-shadow: 0 1px 2px rgba(0, 0, 0, .5);
}
.ui-thumbnail-more { position: absolute; inset: 0; display: grid; place-items: center; background: rgba(0, 0, 0, .5); font-size: calc(var(--s, 64px) * .26); font-weight: 600; }
a.ui-thumbnail, button.ui-thumbnail { cursor: pointer; transition: box-shadow .15s, border-color .15s; }
a.ui-thumbnail:hover, button.ui-thumbnail:hover { border-color: var(--ui-strong); box-shadow: var(--ui-shadow); }
.ui-thumbnail:focus-visible { outline: none; box-shadow: var(--ui-focus); }
@media (prefers-reduced-motion: reduce) { a.ui-thumbnail, button.ui-thumbnail { transition: none; } }
`

view Thumbnail(src: str, alt: str = "", size: str = "md", px: int? = null, shape: str = "rounded", fit: str = "cover",
               overlay: str? = null, more: int? = null, href: str? = null, label: str? = null, on_click = null,
               class: str? = null) {
    style global thumbnail_css
    let cls = ui_cls(["ui-thumbnail", px == null && size != "md" && `ui-thumbnail-${size}`, shape != "rounded" && `ui-thumbnail-${shape}`,
                      fit == "contain" && "ui-thumbnail-contain", class])
    let sty = px != null ? `--s: ${px}px` : null
    let body = [
        <img src={src} alt={alt} loading="lazy"/>,
        overlay != null && <span.ui-thumbnail-text>{overlay}</span>,
        more != null && more > 0 && <span.ui-thumbnail-more aria-label={`and ${more} more`}>+{more}</span>,
    ]
    href != null
        ? <a class={cls} style={sty} href={href} aria-label={label}>{body}</a>
        : on_click != null
            ? <button class={cls} style={sty} type="button" aria-label={label} @click={() => { on_click() }}>{body}</button>
            : <span class={cls} style={sty}>{body}</span>
}
