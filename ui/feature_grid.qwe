// FeatureGrid: what a product does, as a grid of short items, each with an icon,
// a title and a sentence or two. Feature is one item, for a grid written by hand.
//
//   <FeatureGrid title="Everything in one file" features={[
//       { icon: "⚡", title: "No build step", text: "Save the file and the page is there." },
//       { icon: "🔒", title: "Safe by default", text: "Escaped HTML, parameterised SQL, checked records." },
//       { icon: "📡", title: "Live data", text: "A query the page follows as rows change.", href: "/docs/live" },
//   ]}/>
//   <FeatureGrid columns={2}>
//       <Feature icon={<svg>...</svg>} title="Fast">Pages in under a millisecond.</Feature>
//   </FeatureGrid>
//
// FeatureGrid: features, a list of { icon?, title, text, href? }, or Feature
// children. title and text: a heading and a line above the grid, centred.
// columns: a fixed number (three or more become two under 900px, one under 560px);
// without it, as many as fit at min pixels wide (260). variant: "plain" (default)
// or "cards", each item in a bordered box. align: "start" (default) or "center",
// the items' text.
// Feature: icon (HTML, or a short text such as an emoji; none for no icon), title,
// text or children, href (the title becomes a link, with an arrow).

let feature_grid_css = css`
.ui-feature-grid { display: grid; gap: 28px; font: 15px/1.55 var(--ui-font); color: var(--ui-fg); }
.ui-feature-grid-head { display: grid; gap: 8px; max-width: 640px; margin: 0 auto 8px; text-align: center; }
.ui-feature-grid-title { margin: 0; font-size: clamp(24px, 3.4vw, 32px); font-weight: 700; line-height: 1.2; letter-spacing: -.015em; }
.ui-feature-grid-text { margin: 0; color: var(--ui-muted); font-size: 17px; }
.ui-feature-grid-items { display: grid; gap: 28px 24px; grid-template-columns: repeat(auto-fill, minmax(min(var(--ui-feature-min, 260px), 100%), 1fr)); }
.ui-feature-grid-cols .ui-feature-grid-items { grid-template-columns: repeat(var(--ui-feature-cols), minmax(0, 1fr)); }
.ui-feature { display: grid; gap: 8px; align-content: start; min-width: 0; }
.ui-feature-grid-center .ui-feature { justify-items: center; text-align: center; }
.ui-feature-grid-cards .ui-feature { padding: 22px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius); background: var(--ui-surface); }
.ui-feature-icon { display: grid; place-items: center; width: 44px; height: 44px; margin-bottom: 4px; border-radius: var(--ui-radius-sm);
  background: var(--ui-accent-soft); color: var(--ui-accent); font-size: 22px; line-height: 1; }
.ui-feature-icon svg { width: 22px; height: 22px; }
.ui-feature-title { margin: 0; font-size: 17px; font-weight: 600; line-height: 1.3; }
.ui-feature-title a { color: inherit; text-decoration: none; border-radius: 3px; }
.ui-feature-title a:hover { color: var(--ui-accent); }
.ui-feature-title a:focus-visible { outline: none; box-shadow: var(--ui-focus); }
.ui-feature-title a::after { content: " →"; color: var(--ui-accent); }
.ui-feature-text { margin: 0; color: var(--ui-muted); }
.ui-feature-text > :first-child { margin-top: 0; }
.ui-feature-text > :last-child { margin-bottom: 0; }
@media (max-width: 899px) { .ui-feature-grid-many .ui-feature-grid-items { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (max-width: 559px) { .ui-feature-grid-cols .ui-feature-grid-items { grid-template-columns: minmax(0, 1fr); } }
`

view Feature(title: str, icon = null, text: str? = null, href: str? = null, class: str? = null, children) {
    style global feature_grid_css
    <div class={ui_cls(["ui-feature", class])}>
        {icon != null && <div.ui-feature-icon aria-hidden="true">{icon}</div>}
        <h3.ui-feature-title>{href != null ? <a href={href}>{title}</a> : title}</h3>
        {(text != null || children != null) && <div.ui-feature-text>{text}{children}</div>}
    </div>
}

view FeatureGrid(features: list = [], title: str? = null, text: str? = null, columns: int? = null, min: int = 260,
                 variant: str = "plain", align: str = "start", id: str? = null, class: str? = null, children) {
    style global feature_grid_css
    <section id={id} class={ui_cls(["ui-feature-grid", columns != null && "ui-feature-grid-cols", columns != null && columns > 2 && "ui-feature-grid-many",
                                    variant == "cards" && "ui-feature-grid-cards", align == "center" && "ui-feature-grid-center", class])}
             style={columns != null ? `--ui-feature-cols: ${columns}` : `--ui-feature-min: ${min}px`}>
        {(title != null || text != null) && <div.ui-feature-grid-head>
            {title != null && <h2.ui-feature-grid-title>{title}</h2>}
            {text != null && <p.ui-feature-grid-text>{text}</p>}
        </div>}
        <div.ui-feature-grid-items>
            {for f in features => <Feature icon={f.icon} title={f.title} text={f.text} href={f.href}/>}
            {children}
        </div>
    </section>
}
