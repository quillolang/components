// Container: keeps a page's content at a readable width, centred, with room at
// the sides on small screens.
//
//   <Container><h1>Settings</h1> ... </Container>
//   <Container size="sm"> ... a sign-in form ... </Container>
//
// size: "sm" (640px), "md" (860px), "lg" (1140px, default) or "full" (no limit).
// pad: false leaves out the side padding (16px, 24px on wider screens).

let container_css = css`
.ui-container { width: 100%; max-width: 1140px; margin-inline: auto; padding-inline: 16px; }
.ui-container-sm { max-width: 640px; }
.ui-container-md { max-width: 860px; }
.ui-container-full { max-width: none; }
.ui-container-flush { padding-inline: 0; }
@media (min-width: 640px) { .ui-container:not(.ui-container-flush) { padding-inline: 24px; } }
`

view Container(size: str = "lg", pad: bool = true, class: str? = null, children) =
    <div class={ui_cls(["ui-container", size != "lg" && `ui-container-${size}`, !pad && "ui-container-flush", class])}>
        {children}
    </div>
