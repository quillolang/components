// Fieldset: a group of fields under one name, with a line about them, laid out in
// a column, a row or a grid. It is the browser's own <fieldset> with a <legend>,
// so screen readers say the group's name with each field, and disabled={true}
// disables every field in it at once.
//
//   <Fieldset legend="Shipping address" description="Where the order goes.">
//       <TextField name="street" label="Street"/>
//       <TextField name="city" label="City"/>
//   </Fieldset>
//   <Fieldset legend="Name" layout="grid" columns={2}> <TextField name="first" .../> <TextField name="last" .../> </Fieldset>
//   <Fieldset legend="Notify me by" layout="inline"> <Checkbox .../> <Checkbox .../> </Fieldset>
//
// legend: the group's name. description: a line under it, which screen readers read
// with the group. children: the fields.
// layout: "stacked" (one under another, the default), "inline" (side by side, wrapping)
// or "grid" (columns, 2 by default; one on a phone). gap: pixels between the fields (14).
// disabled: every field in it is disabled. bordered: a box around it (false).
// required: a mark after the legend. id: the <fieldset>'s id.

import ui/theme.qwe use ui_cls

let fieldset_css = css`
.ui-fieldset { min-width: 0; margin: 0; padding: 0; border: 0; color: var(--ui-fg); font: 14px/1.4 var(--ui-font); }
.ui-fieldset-box { padding: 16px 18px 18px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius); }
.ui-fieldset-legend { float: left; width: 100%; margin: 0; padding: 0; font-size: 15px; font-weight: 600; line-height: 1.35; }
.ui-fieldset-box > .ui-fieldset-legend { float: none; width: auto; padding: 0 6px; margin-left: -6px; }
.ui-fieldset-req { margin-left: 2px; color: var(--ui-danger); }
.ui-fieldset-desc { clear: both; margin: 4px 0 0; color: var(--ui-muted); font-size: 13px; }
.ui-fieldset-fields { clear: both; display: grid; gap: var(--ui-fieldset-gap, 14px); padding-top: 14px; }
.ui-fieldset-box > .ui-fieldset-fields { padding-top: 10px; }
.ui-fieldset-box > .ui-fieldset-desc + .ui-fieldset-fields { padding-top: 14px; }
.ui-fieldset-inline .ui-fieldset-fields { display: flex; flex-wrap: wrap; align-items: flex-start; }
.ui-fieldset-grid { container-type: inline-size; }
.ui-fieldset-grid .ui-fieldset-fields { grid-template-columns: repeat(var(--ui-fieldset-cols, 2), minmax(0, 1fr)); }
@container (max-width: 480px) { .ui-fieldset-grid .ui-fieldset-fields { grid-template-columns: minmax(0, 1fr); } }
.ui-fieldset:disabled { color: var(--ui-muted); }
`

view Fieldset(legend: str, description: str? = null, layout: str = "stacked", columns: int = 2, gap: int = 14,
              disabled: bool = false, bordered: bool = false, required: bool = false, id: str? = null,
              class: str? = null, children) {
    style global fieldset_css
    let did = description != null && id != null ? `${id}-desc` : null
    <fieldset class={ui_cls(["ui-fieldset", bordered && "ui-fieldset-box", layout != "stacked" && `ui-fieldset-${layout}`, class])}
              id={id} disabled={disabled} aria-describedby={did}
              style={`--ui-fieldset-gap: ${gap}px; --ui-fieldset-cols: ${columns}`}>
        <legend.ui-fieldset-legend>
            {legend}{required && <span.ui-fieldset-req aria-hidden="true">*</span>}
        </legend>
        {description != null && <p.ui-fieldset-desc id={did}>{description}</p>}
        <div.ui-fieldset-fields>{children}</div>
    </fieldset>
}
