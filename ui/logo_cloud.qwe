// LogoCloud: a row of customers' or partners' logos, grey until the pointer
// rests on one, with a line above saying what they are.
//
//   <LogoCloud label="Trusted by" logos={[
//       { name: "Acme", src: "/logos/acme.svg", href: "https://acme.example" },
//       { name: "Globex", src: "/logos/globex.svg" },
//   ]}/>
//
// logos: a list of { name, src, href? }: name is the logo's alt text (and the
// link's name), href makes it a link. label: the line above ("Trusted by");
// null for none. size: the logos' height, "sm" (24px), "md" (32px, default) or
// "lg" (44px). color: true keeps them in colour all the time. align: "center"
// (default), "left" or "between" (spread across the row).

let logo_cloud_css = css`
.ui-logo-cloud { display: grid; gap: 18px; font: 13px/1.4 var(--ui-font); color: var(--ui-muted); }
.ui-logo-cloud-title { margin: 0; text-align: center; text-transform: uppercase; letter-spacing: .08em; font-size: 12px; font-weight: 600; }
.ui-logo-cloud-list { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 24px 44px; margin: 0; padding: 0; list-style: none; }
.ui-logo-cloud-left .ui-logo-cloud-title { text-align: left; }
.ui-logo-cloud-left .ui-logo-cloud-list { justify-content: flex-start; }
.ui-logo-cloud-between .ui-logo-cloud-list { justify-content: space-between; }
.ui-logo-cloud-item { display: inline-flex; border-radius: var(--ui-radius-sm); }
.ui-logo-cloud-item img {
  display: block; width: auto; height: var(--h, 32px); filter: grayscale(1); opacity: .55;
  transition: filter .2s, opacity .2s;
}
.ui-logo-cloud-item:hover img, .ui-logo-cloud-item:focus-visible img, .ui-logo-cloud-color .ui-logo-cloud-item img { filter: none; opacity: 1; }
a.ui-logo-cloud-item:focus-visible { outline: none; box-shadow: var(--ui-focus); }
.ui-logo-cloud-sm .ui-logo-cloud-item img { --h: 24px; }
.ui-logo-cloud-lg .ui-logo-cloud-item img { --h: 44px; }
@media (prefers-reduced-motion: reduce) { .ui-logo-cloud-item img { transition: none; } }
`

view LogoCloud(logos: list = [], label: str? = "Trusted by", size: str = "md", color: bool = false,
               align: str = "center", class: str? = null) {
    style global logo_cloud_css
    <section class={ui_cls(["ui-logo-cloud", size != "md" && `ui-logo-cloud-${size}`, color && "ui-logo-cloud-color",
                            align != "center" && `ui-logo-cloud-${align}`, class])}
             aria-label={label ?? "Logos"}>
        {label != null && <p.ui-logo-cloud-title aria-hidden="true">{label}</p>}
        <ul.ui-logo-cloud-list>
            {for l in logos => <li key={l.name}>
                {get(l, "href") != null
                    ? <a.ui-logo-cloud-item href={get(l, "href")} aria-label={l.name} rel="noopener"><img src={l.src} alt="" loading="lazy"/></a>
                    : <span.ui-logo-cloud-item><img src={l.src} alt={l.name} loading="lazy"/></span>}
            </li>}
        </ul>
    </section>
}
