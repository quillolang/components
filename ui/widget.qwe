// Widget: one panel of a dashboard: a title row with room for a menu or a
// button, the body, and a line along the bottom. For a plain surface, use Card;
// a Widget is a named region a screen reader can jump to.
//
//   <Widget title="Revenue" subtitle="This month"><BarChart .../></Widget>
//   <Widget title="Recent orders" menu={<DropdownMenu id="orders-menu" items={...}/>}
//           href="/orders" link="All orders"><DataTable .../></Widget>
//   <Widget title="Sync" loading={true} footer="Updated 2 minutes ago">...</Widget>
//
// title: the panel's name (an <h3>); subtitle: a quieter line beside it. menu:
// HTML at the right end of the title row (a DropdownMenu, an IconButton, a
// Badge). children: the body. footer: text, or HTML, along the bottom; href and
// link: a link there instead, or as well ("See all" by default). loading: a thin
// moving stripe under the title row, and aria-busy, while the body is stale.
// padding: "md" (default) or "none" (for a table or a chart that fills it).
// id: the panel's id. Inside a DashboardGrid, span says how wide it is.

import ui/theme.qwe use ui_cls

let widget_css = css`
.ui-widget { display: flex; flex-direction: column; min-width: 0; min-height: 100%; border: 1px solid var(--ui-border);
  border-radius: var(--ui-radius); background: var(--ui-surface); color: var(--ui-fg); font: 14px/1.5 var(--ui-font); }
.ui-widget-head { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 14px 18px 12px; }
.ui-widget-titles { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 10px; min-width: 0; }
.ui-widget-title { margin: 0; font-size: 15px; font-weight: 600; line-height: 1.3; }
.ui-widget-sub { margin: 0; color: var(--ui-muted); font-size: 13px; }
.ui-widget-menu { display: flex; flex: none; align-items: center; gap: 6px; margin: -6px -8px -6px 0; }
.ui-widget-stripe { position: absolute; left: 0; right: 0; bottom: 0; height: 2px; overflow: hidden; }
.ui-widget-stripe::after { content: ""; position: absolute; width: 40%; height: 100%; background: var(--ui-accent); animation: ui-widget-slide 1.3s ease-in-out infinite; }
@keyframes ui-widget-slide { from { left: -40%; } to { left: 100%; } }
.ui-widget-body { flex: 1; padding: 4px 18px 18px; }
.ui-widget-head + .ui-widget-body:empty { display: none; }
.ui-widget-body > :first-child { margin-top: 0; }
.ui-widget-body > :last-child { margin-bottom: 0; }
.ui-widget-bare .ui-widget-body { padding: 0; }
.ui-widget-foot { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 10px 18px;
  border-top: 1px solid var(--ui-border); color: var(--ui-muted); font-size: 13px; }
.ui-widget-foot > * { margin: 0; }
.ui-widget-link { margin-left: auto; color: var(--ui-accent); font-weight: 500; text-decoration: none; white-space: nowrap; border-radius: 3px; }
.ui-widget-link:hover { text-decoration: underline; }
.ui-widget-link:focus-visible { outline: none; box-shadow: var(--ui-focus); }
@media (prefers-reduced-motion: reduce) { .ui-widget-stripe::after { left: 0; width: 100%; opacity: .45; animation: none; } }
`

view Widget(title: str, subtitle: str? = null, menu = null, footer = null, href: str? = null, link: str = "See all",
            loading: bool = false, padding: str = "md", id: str? = null, class: str? = null, children) {
    style global widget_css
    let tid = id != null ? `${id}-title` : null
    <section id={id} class={ui_cls(["ui-widget", padding == "none" && "ui-widget-bare", loading && "ui-widget-loading", class])}
             aria-labelledby={tid} aria-label={tid == null ? title : null} aria-busy={loading ? "true" : null}>
        <div.ui-widget-head>
            <div.ui-widget-titles>
                <h3.ui-widget-title id={tid}>{title}</h3>
                {subtitle != null && <p.ui-widget-sub>{subtitle}</p>}
            </div>
            {menu != null && <div.ui-widget-menu>{menu}</div>}
            {loading && <div.ui-widget-stripe aria-hidden="true"></div>}
        </div>
        <div.ui-widget-body>{children}</div>
        {(footer != null || href != null) && <div.ui-widget-foot>
            {footer != null && (type_of(footer) == "str" ? <p>{footer}</p> : footer)}
            {href != null && <a.ui-widget-link href={href}>{link} →</a>}
        </div>}
    </section>
}
