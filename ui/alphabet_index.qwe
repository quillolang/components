// AlphabetIndex: the letters A to Z (and # for the rest) as links into a long list
// sorted by name: a glossary, a directory, a list of artists. Letters that have
// nothing under them are shown but cannot be followed, so the row keeps its shape.
//
//   <AlphabetIndex present={["A", "B", "D", "M"]} href="#letter-{letter}"/>
//   <AlphabetIndex present={letters} current="D" on_select={(l) => { at = l }}/>
//
// present: the letters that have entries (any case); the others are disabled.
// Leave it out to make every letter a link. href: each link's address, with
// "{letter}" standing for the letter ("#{letter}"); "#" becomes "other" in it.
// current: the letter marked (aria-current="true"). hash: show "#" at the end for
// names that start with a digit or a symbol (true). letters: another alphabet, as a
// string ("ABCDEFGHIJKLMNOPQRSTUVWXYZ"). label: what screen readers call it
// ("Index"). id: the nav's id. on_select(letter): inside one of your components, called with the
// letter clicked instead of following its link.

let alphabet_index_css = css`
.ui-alpha ul { display: flex; flex-wrap: wrap; gap: 2px; margin: 0; padding: 0; list-style: none; font: 13px/1 var(--ui-font); }
.ui-alpha-letter {
  display: inline-flex; align-items: center; justify-content: center; min-width: 28px; height: 28px; padding: 0 4px;
  border-radius: var(--ui-radius-sm); color: var(--ui-fg); font-weight: 600; text-decoration: none; transition: background .12s, color .12s;
}
a.ui-alpha-letter:hover { background: var(--ui-subtle); color: var(--ui-accent); }
.ui-alpha-letter:focus-visible { outline: none; box-shadow: var(--ui-focus); }
.ui-alpha-letter[aria-current] { background: var(--ui-accent); color: var(--ui-accent-fg); }
.ui-alpha-off { color: var(--ui-strong); cursor: default; }
@media (prefers-reduced-motion: reduce) { .ui-alpha-letter { transition: none; } }
`

view AlphabetIndex(present: list? = null, href: str = "#{letter}", current: str? = null, hash: bool = true,
                   letters: str = "ABCDEFGHIJKLMNOPQRSTUVWXYZ", label: str = "Index", id: str? = null, on_select = null, class: str? = null) {
    style global alphabet_index_css
    let have = present != null ? present | map((l) => upper(str(l))) : null
    let all = (for i in range(0, len(letters)) => slice(letters, i, i + 1)) + (hash ? ["#"] : [])
    <nav class={ui_cls(["ui-alpha", class])} id={id} aria-label={label}>
        <ul>
            {for l in all => {
                let there = have == null || contains(have, l)
                let at = current != null && upper(current) == l
                <li>{there
                    ? <a.ui-alpha-letter href={replace(href, "{letter}", l == "#" ? "other" : l)}
                         aria-current={at ? "true" : null} aria-label={l == "#" ? "Other" : null}
                         @click={(e) => { if on_select != null { e.preventDefault(); on_select(l) } }}>{l}</a>
                    : <span.ui-alpha-letter.ui-alpha-off aria-disabled="true" aria-label={l == "#" ? "Other, nothing" : `${l}, nothing`}>{l}</span>}
                </li>
            }}
        </ul>
    </nav>
}
