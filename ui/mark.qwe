// Mark: text highlighted, as with a marker pen, in a tone: a match, a change, a term
// to notice. A real <mark>, so screen readers can say so.
//
//   <p>Search found <Mark>three</Mark> results.</p>
//   <Mark tone="success">added</Mark> <Mark tone="danger">removed</Mark>
//
// children: the text. tone: "default" (yellow), "accent", "success", "warning",
// "danger", "info" or "neutral". variant: "fill" (default) or "underline" (a thick
// line under the text instead of a background). id: the element's id.

let mark_css = css`
.ui-mark { padding: 0 .2em; border-radius: 3px; background: color-mix(in srgb, var(--m) 30%, transparent); color: inherit;
  --m: #f5c518; box-decoration-break: clone; -webkit-box-decoration-break: clone; }
.ui-mark-accent { --m: var(--ui-accent); }
.ui-mark-success { --m: var(--ui-success); }
.ui-mark-warning { --m: var(--ui-warning); }
.ui-mark-danger { --m: var(--ui-danger); }
.ui-mark-info { --m: var(--ui-info); }
.ui-mark-neutral { --m: var(--ui-strong); }
.ui-mark-underline { padding: 0; border-radius: 0; background: none;
  text-decoration: underline; text-decoration-color: var(--m); text-decoration-thickness: .3em; text-underline-offset: -.1em;
  text-decoration-skip-ink: none; }
@media (forced-colors: active) { .ui-mark { background: Mark; color: MarkText; } }
`

view Mark(tone: str = "default", variant: str = "fill", id: str? = null, class: str? = null, children) {
    style global mark_css
    <mark class={ui_cls(["ui-mark", tone != "default" && `ui-mark-${tone}`, variant != "fill" && `ui-mark-${variant}`, class])}
          id={id}>{children}</mark>
}
