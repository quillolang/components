// InlineMessage: a small one-line message with an icon for its tone, in the line
// of a form or beside a control: a hint that something went well or needs a look.
//
//   <InlineMessage tone="success">Username is available</InlineMessage>
//   <InlineMessage tone="error">That email is already in use</InlineMessage>
//   <InlineMessage tone="warning" size="sm">Expires in 2 days</InlineMessage>
//
// tone: "info" (default), "success", "warning", "error" (or "danger") or
// "neutral". Warnings and errors are announced at once (role="alert"), the rest
// politely (role="status"). size: "sm" or "md" (default). icon: false leaves the
// icon out. id: the element's id, for aria-describedby on a field.

let inline_message_css = css`
.ui-imsg { display: inline-flex; align-items: center; gap: 6px; max-width: 100%; font: 13px/1.4 var(--ui-font);
  color: var(--t); --t: var(--ui-info); }
.ui-imsg-neutral { --t: var(--ui-muted); }
.ui-imsg-success { --t: var(--ui-success); }
.ui-imsg-warning { --t: var(--ui-warning); }
.ui-imsg-error { --t: var(--ui-danger); }
.ui-imsg-sm { font-size: 12px; gap: 5px; }
.ui-imsg-icon { flex: none; width: 16px; height: 16px; }
.ui-imsg-sm .ui-imsg-icon { width: 14px; height: 14px; }
.ui-imsg-text { min-width: 0; }
.ui-imsg a { color: inherit; font-weight: 500; text-underline-offset: 2px; }
`

// The icon for each tone, drawn in currentColor.
fn inline_message_icon(tone: str) {
    let mark = match tone {
        "success" => <path d="M5.5 8.5l2 2 3.5-4"/>
        "warning" => <path d="M8 5.5v3.5M8 11.5h.01"/>
        "error" => <path d="M6 6l4 4M10 6l-4 4"/>
        _ => <path d="M8 7.5v4M8 5h.01"/>
    }
    let shape = tone == "warning"
        ? <path d="M6.9 2.6L1.9 11.4a1.3 1.3 0 0 0 1.1 1.9h10a1.3 1.3 0 0 0 1.1-1.9L9.1 2.6a1.3 1.3 0 0 0-2.2 0z"/>
        : <circle cx="8" cy="8" r="6"/>
    <svg class="ui-imsg-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"
         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{shape}{mark}</svg>
}

view InlineMessage(tone: str = "info", size: str = "md", icon: bool = true, id: str? = null, class: str? = null, children) {
    style global inline_message_css
    let t = tone == "danger" ? "error" : tone
    <span class={ui_cls(["ui-imsg", `ui-imsg-${t}`, size != "md" && `ui-imsg-${size}`, class])} id={id}
          role={t == "error" || t == "warning" ? "alert" : "status"}>
        {icon && inline_message_icon(t)}
        <span.ui-imsg-text>{children}</span>
    </span>
}
