// ReadMore: text cut after a few lines, with a button that shows the rest and
// folds it again. The button is left out when the text fits as it is.
// A component; it needs line_clamp.qwe (it clamps with LineClamp).
//
//   <ReadMore lines={3}><p>{post.body}</p></ReadMore>
//   <ReadMore lines={2} more="See all" less="See fewer" open={true}>{long_text}</ReadMore>
//
// children: the text or HTML. lines: how many show when folded (3). more ("Read more")
// and less ("Show less"): the button's labels. open: starts unfolded.
// id: the text's id, which the button's aria-controls names ("ui-read-more").
// on_toggle(open): inside one of your components, called when it is folded or unfolded.

import ui/line_clamp.qwe use LineClamp
import ui/theme.qwe use ui_cls

let read_more_css = css`
.ui-read-more { display: grid; gap: 6px; justify-items: start; font: 15px/1.5 var(--ui-font); color: var(--ui-fg); }
.ui-read-more-btn { display: inline-flex; align-items: center; gap: 4px; margin: 0; padding: 0; border: 0; background: none;
  border-radius: 3px; color: var(--ui-accent); font: 500 14px/1.4 var(--ui-font); cursor: pointer; }
.ui-read-more-btn:hover { text-decoration: underline; text-underline-offset: 2px; }
.ui-read-more-btn:focus-visible { outline: none; box-shadow: var(--ui-focus); }
.ui-read-more-btn svg { width: 12px; height: 12px; transition: transform .15s; }
.ui-read-more-open .ui-read-more-btn svg { transform: rotate(180deg); }
@media (prefers-reduced-motion: reduce) { .ui-read-more-btn svg { transition: none; } }
`

component ReadMore(lines: int = 3, more: str = "Read more", less: str = "Show less", open: bool = false,
                   id: str = "ui-read-more", on_toggle = null, class: str? = null, children) {
    style global read_more_css
    state shown = open
    state needed = true    // false once the browser finds the text fits in its lines
    <div class={ui_cls(["ui-read-more", shown && "ui-read-more-open", class])}
         @mount={(el) => {
             let t = el.querySelector(".ui-read-more-text")
             if !shown && t != null && t.scrollHeight <= t.clientHeight + 1 { needed = false }
         }}>
        <LineClamp lines={shown ? 0 : lines} id={id} class="ui-read-more-text">{children}</LineClamp>
        {needed && <button.ui-read-more-btn type="button" aria-expanded={shown ? "true" : "false"} aria-controls={id}
                          @click={() => {
                              shown = !shown
                              on_toggle && on_toggle(shown)
                          }}>
            {shown ? less : more}
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                 stroke-linejoin="round" aria-hidden="true"><path d="M3.5 6l4.5 4.5L12.5 6"/></svg>
        </button>}
    </div>
}
