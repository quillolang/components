// AdSlot: a place for an advertisement in a news page, kept at its size before the
// ad comes, so the story does not jump when it does: the standard sizes by name
// (a 728 by 90 leaderboard, a 300 by 250 rectangle, ...), another size where the
// screen is narrow, "Advertisement" over it so readers can tell it from the news,
// and a quiet placeholder while it is empty. It can stay in view in a side column.
//
//   <AdSlot size="leaderboard" mobile="mobile_banner" slot="home-top"/>
//   <AdSlot size="rectangle" sticky={true} slot="article-rail"><iframe src="..." title="Advertisement"></iframe></AdSlot>
//
// size: "leaderboard" (728×90, default), "billboard" (970×250), "rectangle"
// (300×250), "halfpage" (300×600), "skyscraper" (160×600), "mobile_banner"
// (320×50) or "mobile_large" (320×100); width and height (pixels) give another.
// mobile: the size to use under 760px wide (a name as above), when the first is too
// wide there. slot: the ad server's name for the place, put in data-slot (and the
// element's id is `id`). The ad itself is its children (an <iframe>, an <ins>, an
// <img> in a link); without it, the slot shows a faint placeholder with its size,
// or nothing if placeholder={false}, keeping the space either way. label: the word
// over it ("Advertisement"; "" for none, screen readers still hear it). sticky: it
// stays in view as the page scrolls, in a column taller than itself (top: 16px).
// align: "center" (default) or "start".

let ad_slot_css = css`
.ui-adslot { display: grid; justify-items: center; gap: 4px; min-width: 0; margin: 0; color: var(--ui-muted); font: 11px/1.3 var(--ui-font); }
.ui-adslot-start { justify-items: start; }
.ui-adslot-sticky { position: sticky; top: 16px; align-self: start; }
.ui-adslot-label { letter-spacing: .1em; text-transform: uppercase; }
.ui-adslot-box { position: relative; display: grid; place-items: center; width: min(var(--w), 100%); height: var(--h); overflow: hidden;
  background: var(--ui-subtle); }
.ui-adslot-box > :is(iframe, img, ins, a, div) { display: block; width: 100%; height: 100%; border: 0; }
.ui-adslot-box > a > img { display: block; width: 100%; height: 100%; object-fit: cover; }
.ui-adslot-empty { border: 1px dashed var(--ui-border); background: repeating-linear-gradient(-45deg, transparent 0 8px,
  color-mix(in srgb, var(--ui-border) 45%, transparent) 8px 9px), var(--ui-subtle); }
.ui-adslot-blank { border: 0; background: transparent; }
.ui-adslot-size { padding: 2px 8px; border-radius: 999px; background: var(--ui-surface); color: var(--ui-muted); font-size: 12px;
  font-variant-numeric: tabular-nums; }
@media (max-width: 760px) {
  .ui-adslot-mobile .ui-adslot-box { width: min(var(--mw), 100%); height: var(--mh); }
  .ui-adslot-mobile .ui-adslot-wide { display: none; }
}
@media (min-width: 761px) { .ui-adslot-narrow { display: none; } }
`

// A size's width and height: "rectangle" is [300, 250].
fn ad_slot_size(name: str?) -> list = match name {
    "billboard" => [970, 250]
    "rectangle" => [300, 250]
    "halfpage" => [300, 600]
    "skyscraper" => [160, 600]
    "mobile_banner" => [320, 50]
    "mobile_large" => [320, 100]
    _ => [728, 90]
}

view AdSlot(size: str = "leaderboard", width: int? = null, height: int? = null, mobile: str? = null, slot: str? = null,
            label: str = "Advertisement", placeholder: bool = true, sticky: bool = false, align: str = "center", id: str? = null,
            class: str? = null, children = null) {
    style global ad_slot_css
    let named = ad_slot_size(size)
    let w = width ?? named[0]
    let h = height ?? named[1]
    let m = mobile != null ? ad_slot_size(mobile) : null
    let empty = str(children) == ""
    <aside class={ui_cls(["ui-adslot", m != null && "ui-adslot-mobile", sticky && "ui-adslot-sticky", align == "start" && "ui-adslot-start", class])}
           id={id} aria-label={label != "" ? label : "Advertisement"} data-slot={slot} data-size={`${w}x${h}`}
           style={`--w: ${w}px; --h: ${h}px${m != null ? `; --mw: ${m[0]}px; --mh: ${m[1]}px` : ""}`}>
        {label != "" && <span.ui-adslot-label aria-hidden="true">{label}</span>}
        <div class={ui_cls(["ui-adslot-box", empty && (placeholder ? "ui-adslot-empty" : "ui-adslot-blank")])}>
            {empty
                ? placeholder && [
                    <span class="ui-adslot-size ui-adslot-wide" aria-hidden="true">{w} × {h}</span>,
                    m != null && <span class="ui-adslot-size ui-adslot-narrow" aria-hidden="true">{m[0]} × {m[1]}</span>,
                  ]
                : children}
        </div>
    </aside>
}
