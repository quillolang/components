// Switcher: its children side by side, sharing the width, until the row would be
// narrower than a threshold; then every one goes on a line of its own. No in-
// between: never two on one line and one below. It measures its own width, not
// the window's, in CSS alone.
//
//   <Switcher threshold="720px"> <Card>...</Card> <Card>...</Card> <Card>...</Card> </Switcher>
//   <Switcher limit={2} gap="lg"> <img .../> <div>...</div> </Switcher>
//
// threshold: the width, as CSS, under which they stack ("640px").
// limit: at most this many side by side (4, up to 6); more than that stack whatever
// the width, so a long list does not make a row of slivers.
// gap: pixels (16, the default) or "none", "xs" (4), "sm" (8), "md" (16), "lg" (24), "xl" (32).

let switcher_css = css`
.ui-switcher { display: flex; flex-wrap: wrap; gap: var(--ui-switcher-gap, 16px); min-width: 0; }
.ui-switcher > *, .ui-switcher > quillo-raw > * { flex-grow: 1; flex-basis: calc((var(--ui-switcher-at, 640px) - 100%) * 999); min-width: 0; }
.ui-switcher-2 > :nth-last-child(n + 3), .ui-switcher-2 > :nth-last-child(n + 3) ~ *,
.ui-switcher-2 > quillo-raw > :nth-last-child(n + 3), .ui-switcher-2 > quillo-raw > :nth-last-child(n + 3) ~ * { flex-basis: 100%; }
.ui-switcher-3 > :nth-last-child(n + 4), .ui-switcher-3 > :nth-last-child(n + 4) ~ *,
.ui-switcher-3 > quillo-raw > :nth-last-child(n + 4), .ui-switcher-3 > quillo-raw > :nth-last-child(n + 4) ~ * { flex-basis: 100%; }
.ui-switcher-4 > :nth-last-child(n + 5), .ui-switcher-4 > :nth-last-child(n + 5) ~ *,
.ui-switcher-4 > quillo-raw > :nth-last-child(n + 5), .ui-switcher-4 > quillo-raw > :nth-last-child(n + 5) ~ * { flex-basis: 100%; }
.ui-switcher-5 > :nth-last-child(n + 6), .ui-switcher-5 > :nth-last-child(n + 6) ~ *,
.ui-switcher-5 > quillo-raw > :nth-last-child(n + 6), .ui-switcher-5 > quillo-raw > :nth-last-child(n + 6) ~ * { flex-basis: 100%; }
.ui-switcher-6 > :nth-last-child(n + 7), .ui-switcher-6 > :nth-last-child(n + 7) ~ *,
.ui-switcher-6 > quillo-raw > :nth-last-child(n + 7), .ui-switcher-6 > quillo-raw > :nth-last-child(n + 7) ~ * { flex-basis: 100%; }
`

fn switcher_gap(gap) -> str =
    match gap {
        int as n => `${n}px`
        float as n => `${n}px`
        "none" => "0"
        "xs" => "4px"
        "sm" => "8px"
        "lg" => "24px"
        "xl" => "32px"
        _ => "16px"
    }

view Switcher(threshold: str = "640px", limit: int = 4, gap = 16, id: str? = null, class: str? = null, children) {
    style global switcher_css
    let cap = limit < 2 ? 2 : limit > 6 ? 6 : limit
    <div class={ui_cls(["ui-switcher", `ui-switcher-${cap}`, class])} id={id}
         style={`--ui-switcher-at: ${threshold}; --ui-switcher-gap: ${switcher_gap(gap)}`}>
        {children}
    </div>
}
