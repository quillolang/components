// Breadcrumbs: where this page sits, as a trail of links to the pages above it.
//
//   <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Docs", href: "/docs" },
//                        { label: "Components" }]}/>
//
// items: maps of { label, href? }, from the top down. The last one is this page
// (aria-current="page"); a link only if it has an href. The others without an href
// show as plain text. On narrow screens the middle ones are cut short, with their
// whole label as a tooltip. label: what screen readers call it ("Breadcrumb").

let breadcrumbs_css = css`
.ui-breadcrumbs ol { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 0; margin: 0; padding: 0; list-style: none;
  font: 14px/1.4 var(--ui-font); color: var(--ui-muted); }
.ui-breadcrumbs li { display: inline-flex; align-items: center; min-width: 0; }
.ui-breadcrumbs li + li::before {
  content: ""; flex: none; width: 6px; height: 6px; margin: 0 10px 0 7px;
  border: solid var(--ui-strong); border-width: 1.5px 1.5px 0 0; transform: rotate(45deg);
}
.ui-breadcrumbs a, .ui-breadcrumbs-text {
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 28ch;
  border-radius: 4px; color: var(--ui-muted); text-decoration: none;
}
.ui-breadcrumbs a:hover { color: var(--ui-fg); text-decoration: underline; text-underline-offset: 3px; }
.ui-breadcrumbs a:focus-visible { outline: none; box-shadow: var(--ui-focus); }
.ui-breadcrumbs [aria-current="page"] { color: var(--ui-fg); font-weight: 500; }
@media (max-width: 600px) {
  .ui-breadcrumbs li:not(:first-child):not(:last-child) a,
  .ui-breadcrumbs li:not(:first-child):not(:last-child) .ui-breadcrumbs-text { max-width: 9ch; }
  .ui-breadcrumbs li:last-child > * { max-width: 20ch; }
}
`

view Breadcrumbs(items: list = [], label: str = "Breadcrumb", class: str? = null) =
    <nav class={ui_cls(["ui-breadcrumbs", class])} aria-label={label}>
        <ol>
            {for [i, it] in enumerate(items) => {
                let here = i == len(items) - 1
                <li>
                    {it.href != null
                        ? <a href={it.href} title={it.label} aria-current={here ? "page" : null}>{it.label}</a>
                        : <span.ui-breadcrumbs-text title={it.label} aria-current={here ? "page" : null}>{it.label}</span>}
                </li>
            }}
        </ol>
    </nav>
