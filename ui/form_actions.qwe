// FormActions: the row of buttons that ends a form (Save and Cancel, Back and
// Next), lined up at the end, the start, the centre, or spread to both sides.
//
//   <FormActions>
//       <Button variant="ghost" tone="neutral" href="/">Cancel</Button>
//       <Button type="submit">Save changes</Button>
//   </FormActions>
//   <FormActions align="between"> <Button variant="outline">Back</Button> <Button type="submit">Next</Button> </FormActions>
//   <FormActions sticky={true} divider={true}> ... </FormActions>
//
// align: "end" (default), "start", "center" or "between" (the first child at the
// left, the rest at the right). divider: a line above the row. sticky: the row
// stays at the bottom of the window while the form scrolls. gap: pixels between
// the buttons (10). note: short text at the row's other side ("Saved 2 min ago").
// On a phone the buttons fill the width, one under another, the last first.

import ui/theme.qwe use ui_cls

let form_actions_css = css`
.ui-form-actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-end; gap: var(--ui-form-actions-gap, 10px); min-width: 0; font: 14px/1.4 var(--ui-font); color: var(--ui-fg); }
.ui-form-actions-start { justify-content: flex-start; }
.ui-form-actions-center { justify-content: center; }
.ui-form-actions-between { justify-content: space-between; }
.ui-form-actions-between > :first-child { margin-right: auto; }
.ui-form-actions-divider { padding-top: 16px; border-top: 1px solid var(--ui-border); }
.ui-form-actions-sticky { position: sticky; bottom: 0; z-index: 5; padding-bottom: 12px; background: var(--ui-bg); }
.ui-form-actions-sticky.ui-form-actions-divider { padding-top: 12px; }
.ui-form-actions-note { margin-right: auto; color: var(--ui-muted); font-size: 13px; }
.ui-form-actions-start .ui-form-actions-note { margin: 0 0 0 auto; }
.ui-form-actions-center .ui-form-actions-note, .ui-form-actions-between .ui-form-actions-note { margin: 0 auto; }
@media (max-width: 479px) {
  .ui-form-actions { flex-direction: column-reverse; align-items: stretch; }
  .ui-form-actions-between > :first-child { margin-right: 0; }
  .ui-form-actions > .ui-btn { display: flex; width: 100%; }
  .ui-form-actions-note { margin: 0; text-align: center; }
}
`

view FormActions(align: str = "end", divider: bool = false, sticky: bool = false, gap: int = 10, note: str? = null,
                 class: str? = null, children) {
    style global form_actions_css
    <div class={ui_cls(["ui-form-actions", align != "end" && `ui-form-actions-${align}`, divider && "ui-form-actions-divider",
                        sticky && "ui-form-actions-sticky", class])}
         style={gap != 10 ? `--ui-form-actions-gap: ${gap}px` : null}>
        {note != null && align != "start" && <span.ui-form-actions-note>{note}</span>}
        {children}
        {note != null && align == "start" && <span.ui-form-actions-note>{note}</span>}
    </div>
}
