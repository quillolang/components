// ImagePicker: one of several pictures (an avatar, a theme, a cover, a layout),
// chosen by clicking its thumbnail. Each is a real radio under the picture, so a
// plain <form> sends the chosen `value` as `name`, the arrow keys move the choice,
// and screen readers hear each picture's label.
//
//   <ImagePicker name="avatar" label="Avatar" value="fox"
//                options={[{ value: "fox", src: "/img/fox.png", label: "Fox" }, { value: "owl", src: "/img/owl.png", label: "Owl" }]}/>
//   <ImagePicker name="theme" label="Theme" shape="wide" size={160} options={themes} on_change={(v) => { theme = v }}/>
//
// options: a list of { value, src, label, disabled? }: src the picture, label what
// it is called (shown under it unless captions={false}; always read to screen readers).
// value: the one chosen to start with. size: each picture's width in pixels (96).
// shape: "square" (default), "circle" or "wide" (16:9). captions: the labels
// under the pictures (true). columns: a fixed number across (as many as fit by default).
// label (the legend), hint, error, required, disabled and field (the ids' start,
// "image-picker-" + name by default) as for every field.
// on_change(value): inside one of your components, given the value chosen.

let image_picker_css = css`
.ui-image-picker { min-width: 0; margin: 0; padding: 0; border: 0; font: 14px/1.4 var(--ui-font); color: var(--ui-fg); }
.ui-image-picker-legend { padding: 0; margin-bottom: 8px; font-size: 13px; font-weight: 500; }
.ui-image-picker-req { margin-left: 2px; color: var(--ui-danger); }
.ui-image-picker-list { display: flex; flex-wrap: wrap; gap: 12px; }
.ui-image-picker-cols { display: grid; grid-template-columns: repeat(var(--ui-image-picker-cols), minmax(0, 1fr)); }
.ui-image-picker-opt { position: relative; display: grid; gap: 6px; width: var(--ui-image-picker-size, 96px); max-width: 100%; cursor: pointer; text-align: center; }
.ui-image-picker-cols .ui-image-picker-opt { width: auto; }
.ui-image-picker-opt input { position: absolute; opacity: 0; width: 1px; height: 1px; margin: 0; }
.ui-image-picker-frame {
  position: relative; display: block; width: 100%; aspect-ratio: 1; overflow: hidden; border-radius: var(--ui-radius-sm);
  background: var(--ui-subtle); box-shadow: 0 0 0 1px var(--ui-border); transition: box-shadow .15s, transform .15s;
}
.ui-image-picker-frame img { display: block; width: 100%; height: 100%; object-fit: cover; }
.ui-image-picker-circle .ui-image-picker-frame { border-radius: 50%; }
.ui-image-picker-wide .ui-image-picker-frame { aspect-ratio: 16 / 9; }
.ui-image-picker-opt:hover .ui-image-picker-frame { box-shadow: 0 0 0 1px var(--ui-strong); }
.ui-image-picker-opt input:checked ~ .ui-image-picker-frame { box-shadow: 0 0 0 2px var(--ui-accent), 0 0 0 4px var(--ui-accent-soft); }
.ui-image-picker-opt input:focus-visible ~ .ui-image-picker-frame { box-shadow: 0 0 0 1px var(--ui-border), var(--ui-focus); }
.ui-image-picker-opt input:checked:focus-visible ~ .ui-image-picker-frame { box-shadow: 0 0 0 2px var(--ui-accent), var(--ui-focus); }
.ui-image-picker-check {
  position: absolute; right: 6px; top: 6px; display: grid; place-items: center; width: 22px; height: 22px; border-radius: 50%;
  background: var(--ui-accent); color: var(--ui-accent-fg); box-shadow: 0 1px 3px rgba(0, 0, 0, .3); opacity: 0; transform: scale(.6);
  transition: opacity .12s, transform .12s;
}
.ui-image-picker-check svg { width: 12px; height: 12px; }
.ui-image-picker-circle .ui-image-picker-check { right: 2px; top: 2px; }
.ui-image-picker-opt input:checked ~ .ui-image-picker-frame .ui-image-picker-check { opacity: 1; transform: scale(1); }
.ui-image-picker-caption { font-size: 13px; color: var(--ui-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ui-image-picker-opt input:checked ~ .ui-image-picker-caption { color: var(--ui-fg); font-weight: 500; }
.ui-image-picker-opt:has(input:disabled) { opacity: .5; cursor: not-allowed; }
.ui-image-picker-opt:has(input:disabled):hover .ui-image-picker-frame { box-shadow: 0 0 0 1px var(--ui-border); }
.ui-image-picker-invalid .ui-image-picker-frame { box-shadow: 0 0 0 1px var(--ui-danger); }
.ui-image-picker-hint, .ui-image-picker-error { margin: 8px 0 0; font-size: 13px; color: var(--ui-muted); }
.ui-image-picker-error { color: var(--ui-danger); }
@media (prefers-reduced-motion: reduce) { .ui-image-picker-frame, .ui-image-picker-check { transition: none; } }
`

view ImagePicker(name: str, label: str? = null, options: list = [], value: str | num | null = null, size: int = 96,
                 shape: str = "square", captions: bool = true, columns: int? = null, hint: str? = null, error: str? = null,
                 required: bool = false, disabled: bool = false, field: str? = null, on_change = null, class: str? = null) {
    style global image_picker_css
    let id = field ?? `image-picker-${name}`
    let described = ui_cls([hint != null && `${id}-hint`, error != null && `${id}-error`])
    let chosen = value != null ? str(value) : null
    <fieldset class={ui_cls(["ui-image-picker", shape != "square" && `ui-image-picker-${shape}`, error != null && "ui-image-picker-invalid", class])}
              id={id} disabled={disabled} role="radiogroup" aria-required={required ? "true" : null}
              aria-invalid={error != null ? "true" : null} aria-describedby={described != "" ? described : null}>
        {label != null && <legend.ui-image-picker-legend>
            {label}{required && <span.ui-image-picker-req aria-hidden="true">*</span>}
        </legend>}
        <div class={ui_cls(["ui-image-picker-list", columns != null && "ui-image-picker-cols"])}
             style={`--ui-image-picker-size: ${size}px${columns != null ? `; --ui-image-picker-cols: ${columns}` : ""}`}>
            {for [i, o] in enumerate(options) => {
                let v = str(o.value ?? o.label)
                let oid = `${id}-${i}`
                <label.ui-image-picker-opt for={oid} title={o.label}>
                    <input type="radio" id={oid} name={name} value={v} checked={v == chosen} required={required}
                           disabled={o.disabled ?? false} aria-label={o.label}
                           @change={(e) => { on_change && on_change(e.value) }}/>
                    <span.ui-image-picker-frame>
                        <img src={o.src} alt="" loading="lazy"/>
                        <span.ui-image-picker-check aria-hidden="true">
                            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"
                                 stroke-linejoin="round"><path d="M3.5 8.5l3 3 6-7"/></svg>
                        </span>
                    </span>
                    {captions && <span.ui-image-picker-caption aria-hidden="true">{o.label}</span>}
                </label>
            }}
        </div>
        {hint != null && <p.ui-image-picker-hint id={`${id}-hint`}>{hint}</p>}
        {error != null && <p.ui-image-picker-error id={`${id}-error`} role="alert">{error}</p>}
    </fieldset>
}
