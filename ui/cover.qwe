// Cover: a block as tall as the screen (or as told) with one thing in the middle
// of it, and something at its top and its bottom if given: a landing page's first
// screen, a sign-in page, a "thanks" page.
//
//   <Cover top={<Navbar .../>} bottom={<p>Scroll for more ↓</p>}>
//       <h1>Ship on Friday.</h1>
//   </Cover>
//   <Cover height="100dvh" text={true}> <SignInForm/> </Cover>
//
// children: what sits in the middle, with as much room above it as below.
// top, bottom: HTML at the top and bottom edges (a nav, a footer line).
// height: how tall it is at least, as CSS ("100vh"). pad: room inside, in pixels (24).
// text: the middle's text is centred. tone: "plain" (default) or "subtle" (tinted).

let cover_css = css`
.ui-cover {
  display: flex; flex-direction: column; min-height: var(--ui-cover-h, 100vh); min-width: 0;
  padding: var(--ui-cover-pad, 24px); color: var(--ui-fg); font: 15px/1.5 var(--ui-font);
}
.ui-cover-subtle { background: var(--ui-subtle); border-radius: var(--ui-radius); }
.ui-cover-top, .ui-cover-bottom { flex: none; }
.ui-cover-main { margin-block: auto; padding-block: var(--ui-cover-pad, 24px); }
.ui-cover-main > :first-child { margin-top: 0; }
.ui-cover-main > :last-child { margin-bottom: 0; }
.ui-cover-text .ui-cover-main { text-align: center; }
`

view Cover(top = null, bottom = null, height: str = "100vh", pad: int = 24, text: bool = false, tone: str = "plain",
           id: str? = null, class: str? = null, children) {
    style global cover_css
    <div class={ui_cls(["ui-cover", text && "ui-cover-text", tone == "subtle" && "ui-cover-subtle", class])} id={id}
         style={`--ui-cover-h: ${height}; --ui-cover-pad: ${pad}px`}>
        {top != null && <div.ui-cover-top>{top}</div>}
        <div.ui-cover-main>{children}</div>
        {bottom != null && <div.ui-cover-bottom>{bottom}</div>}
    </div>
}
