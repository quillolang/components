// Truncate: text kept to one line, cut with an ellipsis where there is no room, with
// the whole text in its title (shown on hover) and still there for screen readers.
//
//   <Truncate text={file.name}/>
//   <Truncate text="quarterly-report-final-v3.xlsx" keep={5} width="180px"/>
//
// text: the text. keep: how many characters at the end to keep in view (an extension,
// a number), the cut then being in the middle. width: a CSS max-width; without one
// it fills its container, which must have a width (a flex child needs min-width: 0).
// tag: "span" (default) or "div". id: the element's id.

let truncate_css = css`
.ui-truncate { display: block; max-width: 100%; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
span.ui-truncate { display: inline-block; vertical-align: bottom; }
.ui-truncate-mid { display: flex; }
span.ui-truncate-mid { display: inline-flex; }
.ui-truncate-head { flex: 0 1 auto; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.ui-truncate-tail { flex: none; white-space: nowrap; }
`

view Truncate(text: str, keep: int = 0, width: str? = null, tag: str = "span", id: str? = null, class: str? = null) {
    style global truncate_css
    let n = len(text)
    let mid = keep > 0 && keep < n
    let cls = ui_cls(["ui-truncate", mid && "ui-truncate-mid", class])
    let style = width != null ? `max-width: ${width}` : null
    let body = mid
        ? [<span.ui-truncate-head aria-hidden="true">{slice(text, 0, n - keep)}</span>,
           <span.ui-truncate-tail aria-hidden="true">{slice(text, n - keep, n)}</span>,
           <span.ui-sr>{text}</span>]
        : text
    tag == "div"
        ? <div class={cls} id={id} title={text} style={style}>{body}</div>
        : <span class={cls} id={id} title={text} style={style}>{body}</span>
}
