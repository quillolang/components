// BollingerChart: prices with Bollinger bands: the moving average of the close over a
// period (20) and bands a number of standard deviations (2) above and below it, the
// space between them shaded; closes outside the bands are marked. The close is a line,
// or candles. CSS only: hovering shows the close, the bands, %B (where the close sits
// between the bands, 0 to 1) and the bands' width, and screen readers get the numbers
// as a table.
//
//   <BollingerChart label="ACME, Bollinger 20, 2" candles={bars} prefix="$"/>
//   <BollingerChart label="ACME" candles={bars} period={10} deviations={1.5} bars={true}/>
//
// candles: a list of { time, close } (with open, high and low for bars), oldest first,
// time a date or a date-time; or closes: the numbers alone, with labels for the axis.
// period: the moving average's (20); deviations: how many standard deviations (of the
// same closes) the bands are from it (2); the bands start at the period-th close.
// bars: draws each candle instead of a line of closes (false). height: the plot's
// height in pixels (300). prefix and suffix: around every price shown ("$"); decimals:
// digits after the point of prices (2). label: what the chart shows; it names it for
// screen readers and captions their table. show_label also writes it above the chart.

import ui/theme.qwe use ui_cls

let bollinger_chart_css = css`
.ui-bb { --ui-bb-price: light-dark(#2a78d6, #3987e5); --ui-bb-band: light-dark(#6250d6, #9085e9);
  display: grid; gap: 10px; min-width: 0; margin: 0; font: 12px/1.3 var(--ui-font); color: var(--ui-fg); }
.ui-bb-title { margin: 0; font-size: 14px; font-weight: 600; }
.ui-bb-legend { display: flex; flex-wrap: wrap; gap: 4px 16px; margin: 0; padding: 0; list-style: none; color: var(--ui-muted); font-size: 13px; }
.ui-bb-legend li { display: inline-flex; align-items: center; gap: 6px; }
.ui-bb-key { width: 14px; height: 3px; border-radius: 2px; background: var(--c); }
.ui-bb-kb { height: 10px; width: 14px; border: 1px solid var(--ui-bb-band); background: color-mix(in srgb, var(--ui-bb-band) 14%, transparent); }
.ui-bb-cp { --c: var(--ui-bb-price); } .ui-bb-cb { --c: var(--ui-bb-band); }
.ui-bb-up { --k: var(--ui-success); } .ui-bb-down { --k: var(--ui-danger); }
.ui-bb-frame { display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: 8px; padding-top: 8px; }
.ui-bb-plot, .ui-bb-y { position: relative; height: var(--h); }
.ui-bb-grid { position: absolute; left: 0; right: 0; height: 1px; background: color-mix(in srgb, var(--ui-border) 70%, transparent); }
.ui-bb-svg { position: absolute; z-index: 1; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
.ui-bb-svg path { fill: none; stroke-linejoin: round; stroke-linecap: round; }
.ui-bb-fill { fill: var(--ui-bb-band) !important; opacity: .1; }
.ui-bb-edge { stroke: var(--ui-bb-band); stroke-width: 1.25; }
.ui-bb-mid { stroke: var(--ui-bb-band); stroke-width: 1.25; stroke-dasharray: 4 3; }
.ui-bb-close { stroke: var(--ui-bb-price); stroke-width: 1.75; }
.ui-bb-cols { position: absolute; inset: 0; display: flex; }
.ui-bb-col { position: relative; flex: 1; min-width: 0; }
.ui-bb-col::before { content: ""; position: absolute; top: 0; bottom: 0; left: 50%; width: 1px; background: var(--ui-strong); opacity: 0; }
.ui-bb-col:hover::before { opacity: .9; }
.ui-bb-wick { position: absolute; z-index: 2; left: 50%; width: 1px; margin-left: -.5px; background: var(--k); }
.ui-bb-body { position: absolute; z-index: 2; left: 18%; right: 18%; min-height: 1px; border-radius: 1px; background: var(--k); }
.ui-bb-out { position: absolute; z-index: 3; left: 50%; width: 9px; height: 9px; margin: -4.5px 0 0 -4.5px; border: 2px solid var(--k);
  border-radius: 50%; background: var(--ui-bg); }
.ui-bb-dot { position: absolute; z-index: 3; left: 50%; display: none; width: 7px; height: 7px; margin: -3.5px 0 0 -3.5px; border-radius: 50%;
  background: var(--ui-bb-price); box-shadow: 0 0 0 2px var(--ui-bg); }
.ui-bb-col:hover .ui-bb-dot { display: block; }
.ui-bb-tip { position: absolute; z-index: 20; top: 0; left: calc(50% + 10px); display: none; min-width: 150px; padding: 7px 10px;
  border: 1px solid var(--ui-border); border-radius: var(--ui-radius-sm); background: var(--ui-surface);
  box-shadow: var(--ui-shadow); color: var(--ui-fg); font-size: 12px; pointer-events: none; }
.ui-bb-flip .ui-bb-tip { left: auto; right: calc(50% + 10px); }
.ui-bb-col:hover .ui-bb-tip { display: block; }
.ui-bb-tip strong { display: block; margin-bottom: 3px; font-weight: 600; white-space: nowrap; }
.ui-bb-tip p { display: flex; align-items: center; gap: 6px; margin: 2px 0 0; color: var(--ui-muted); white-space: nowrap; }
.ui-bb-tip b { margin-left: auto; padding-left: 12px; color: var(--ui-fg); font-weight: 600; font-variant-numeric: tabular-nums; }
.ui-bb-tip em { color: var(--k); font-style: normal; font-weight: 600; }
.ui-bb-y span { position: absolute; left: 0; transform: translateY(-50%); color: var(--ui-muted); font-variant-numeric: tabular-nums; white-space: nowrap; }
.ui-bb-y .ui-bb-tag { z-index: 1; left: -4px; padding: 1px 4px; border-radius: 3px; background: var(--ui-bb-price); color: var(--ui-bg); font-weight: 600; }
.ui-bb-x { position: relative; height: 16px; margin-top: 6px; }
.ui-bb-x span { position: absolute; top: 0; transform: translateX(-50%); color: var(--ui-muted); white-space: nowrap; }
.ui-bb-x .ui-bb-first { transform: none; }
.ui-bb-x .ui-bb-end { transform: translateX(-100%); }
`

// n (a whole number, 0 or more) with at least `width` digits.
fn bollinger_chart_pad(n: int, width: int) -> str {
    let s = str(n)
    len(s) < width ? repeat("0", width - len(s)) + s : s
}

// A whole number with commas: 1234567 is "1,234,567".
fn bollinger_chart_group(n: int) -> str =
    n < 1000 ? str(n) : bollinger_chart_group(floor(n / 1000)) + "," + bollinger_chart_pad(n % 1000, 3)

// A value as it reads, with commas and `places` digits after the point (up to two as
// needed when that is null): 48210.5 is "48,210.50" with 2. Worked out in whole
// numbers, so the server and the browser write the same text.
fn bollinger_chart_num(v: num, places: int? = null) -> str {
    let digits = places == null ? 2 : (places < 0 ? 0 : (places > 6 ? 6 : places))
    let scale = [1, 10, 100, 1000, 10000, 100000, 1000000][digits]
    let units = round(abs(v) * scale)
    let frac = units % scale
    let tail = digits == 0 || (places == null && frac == 0) ? ""
        : (places == null && frac % 10 == 0 ? `.${floor(frac / 10)}` : `.${bollinger_chart_pad(frac, digits)}`)
    `${v < 0 && units > 0 ? "-" : ""}${bollinger_chart_group(floor(units / scale))}${tail}`
}

// A large number, short: 1500 is "1.5k", 2000000 is "2M", 0.25 is "0.25".
fn bollinger_chart_short(v: num) -> str {
    let a = abs(v)
    let unit = a >= 1000000000 ? 1000000000 : (a >= 1000000 ? 1000000 : (a >= 1000 ? 1000 : 1))
    let tenths = round(a * 10 / unit)
    let mark = unit == 1000000000 ? "B" : (unit == 1000000 ? "M" : "k")
    unit == 1 ? bollinger_chart_num(v)
        : `${v < 0 ? "-" : ""}${bollinger_chart_group(floor(tenths / 10))}${tenths % 10 != 0 ? `.${tenths % 10}` : ""}${mark}`
}

// A change in percent, signed, to two decimals: "+1.25%", "-0.40%".
fn bollinger_chart_signed(p: num) -> str = `${p > 0 ? "+" : (p < 0 && round(abs(p) * 100) > 0 ? "-" : "")}${bollinger_chart_num(abs(p), 2)}%`

// A coordinate out of 100 (or a length), to two decimals.
fn bollinger_chart_pct(n: num) -> str {
    let r = round(n * 100) / 100
    r == floor(r) ? str(floor(r)) : str(r)
}

// The axis from lo to hi, widened to round ticks: about `steps` steps of 1, 2, 2.5 or 5 x 10^n.
fn bollinger_chart_scale(lo: num, hi: num, steps: int = 5) -> map {
    let span = hi - lo == 0 ? (lo == 0 ? 1 : abs(lo) / 10) : hi - lo
    let raw = span / steps
    let mag = 1
    while mag * 10 <= raw { mag = mag * 10 }
    while mag > raw { mag = mag / 10 }
    let r = raw / mag
    let step = (r <= 1 ? 1 : (r <= 2 ? 2 : (r <= 2.5 ? 2.5 : (r <= 5 ? 5 : 10)))) * mag
    let a = floor(lo / step + 0.000001)
    let b0 = ceil(hi / step - 0.000001)
    let b = b0 == a ? a + 1 : b0
    { lo: a * step, hi: b * step, ticks: for i in range(b - a + 1) => (a + i) * step }
}

// A candle's time as it reads: "Mar 2, 2026" for a date, "Mar 2, 14:30" for a date-time.
fn bollinger_chart_when(t) -> str =
    type_of(t) != "str" || !date.valid(t) ? str(t) : (len(t) > 10 ? date.format(t, "MMM D, HH:mm") : date.format(t, "MMM D, YYYY"))

// Where the time axis is labelled: about `limit` of { i, text }, at the starts of years,
// months or days when the times cross them ("2026", "Mar", "Mar 2"), else every few
// candles ("14:30", "Mar 2").
fn bollinger_chart_ticks(times: list, limit: int) -> list {
    let n = len(times)
    let thin = (idx: list) => {
        let step = ceil(len(idx) / limit)
        range(len(idx)) | filter((k) => k % step == 0) | map((k) => idx[k])
    }
    let spaced = (fmt_at) => {
        let step = ceil(n / limit)
        range(n) | filter((i) => i % step == floor(step / 2)) | map((i) => { i, text: fmt_at(i) })
    }
    if n == 0 { return [] }
    if !all(times, (t) => type_of(t) == "str" && date.valid(t)) { return spaced((i) => str(times[i])) }
    let days = times | map((t) => slice(t, 0, 10))
    let changes = (keys: list) => range(1, n) | filter((i) => keys[i] != keys[i - 1])
    let day_starts = changes(days)
    let month_starts = changes(days | map((d) => slice(d, 0, 7)))
    let year_starts = changes(days | map((d) => slice(d, 0, 4)))
    let picked = if any(times, (t) => len(t) > 10) {
        len(day_starts) >= 3
            ? thin(day_starts) | map((i) => { i, text: date.format(days[i], "MMM D") })
            : spaced((i) => index_of(day_starts, i) != null ? date.format(days[i], "MMM D") : date.format(times[i], "HH:mm"))
    } else if len(year_starts) >= 3 && len(month_starts) > limit * 2 {
        thin(year_starts) | map((i) => { i, text: slice(days[i], 0, 4) })
    } else if len(month_starts) >= 2 {
        thin(month_starts) | map((i) => { i, text: index_of(year_starts, i) != null ? slice(days[i], 0, 4) : date.format(days[i], "MMM") })
    } else {
        spaced((i) => date.format(days[i], "MMM D"))
    }
    // Starts that fall close together (a short month) keep the first.
    let gap = n / (limit * 1.5)
    reduce(picked, [], (kept, t) => len(kept) == 0 || t.i - kept[-1].i >= gap ? kept + [t] : kept)
}

// The simple moving average of `period` values, null until there are that many.
fn bollinger_chart_sma(xs: list, period: int) -> list {
    let out = []
    let total = 0
    for i in range(len(xs)) {
        total += xs[i]
        if i >= period { total -= xs[i - period] }
        out = out | push(i + 1 >= period ? total / period : null)
    }
    out
}

// The exponential moving average of `period` values (k = 2 / (period + 1)), started
// from the simple average of the first `period`; null before that.
fn bollinger_chart_ema(xs: list, period: int) -> list {
    let k = 2 / (period + 1)
    let out = []
    let prev = null
    for i in range(len(xs)) {
        if i + 1 == period {
            prev = sum(take(xs, period)) / period
        } else if i + 1 > period {
            prev = xs[i] * k + prev * (1 - k)
        }
        out = out | push(prev)
    }
    out
}

// The bands: { mid, upper, lower }, lists null for the first period - 1 closes; the
// deviation is the population standard deviation of the same `period` closes.
fn bollinger_chart_bands(xs: list, period: int, k: num) -> map {
    let mid = bollinger_chart_sma(xs, period)
    let dev = for i in range(len(xs)) => mid[i] == null ? null
        : sqrt(sum(slice(xs, i + 1 - period, i + 1) | map((v) => (v - mid[i]) * (v - mid[i]))) / period)
    {
        mid,
        upper: for i in range(len(xs)) => mid[i] == null ? null : mid[i] + k * dev[i],
        lower: for i in range(len(xs)) => mid[i] == null ? null : mid[i] - k * dev[i],
    }
}

view BollingerChart(candles: list = [], closes: list? = null, labels: list? = null, period: int = 20, deviations: num = 2,
                    bars: bool = false, height: int = 300, prefix: str = "", suffix: str = "", decimals: int = 2,
                    label: str = "Bollinger bands", show_label: bool = false, class: str? = null) {
    style global bollinger_chart_css
    let vals = closes ?? (candles | map((c) => c.close))
    let times = closes != null ? (labels ?? []) : (candles | map((c) => c.time))
    let candle_bars = bars && closes == null
    let n = len(vals)
    let bb = bollinger_chart_bands(vals, period < 1 ? 1 : period, deviations)
    let known = vals + (bb.upper | filter((v) => v != null)) + (bb.lower | filter((v) => v != null))
        + (candle_bars ? flatten(candles | map((c) => [c.low ?? c.close, c.high ?? c.close])) : [])
    let sc = bollinger_chart_scale(n == 0 ? 0 : min(known), n == 0 ? 1 : max(known), 5)
    let y = (v) => (sc.hi - v) * 100 / (sc.hi - sc.lo)
    let x = (i) => (i + 0.5) * 100 / n
    let pct = (v) => bollinger_chart_pct(v)
    let money = (v) => v == null ? "—" : `${v < 0 ? "-" : ""}${prefix}${bollinger_chart_num(abs(v), decimals)}${suffix}`
    let tick = (t) => `${t < 0 ? "-" : ""}${prefix}${bollinger_chart_num(abs(t))}`
    let pts = (list_vals: list, idx: list) => join(idx | map((i) => `${pct(x(i))},${pct(y(list_vals[i]))}`), " L")
    let banded = range(n) | filter((i) => bb.mid[i] != null)
    let path = (list_vals: list) => len(banded) == 0 ? "" : "M" + pts(list_vals, banded)
    let band = len(banded) == 0 ? "" : `M${pts(bb.upper, banded)} L${pts(bb.lower, reverse(banded))} Z`
    let pb = (i) => bb.mid[i] == null || bb.upper[i] == bb.lower[i] ? null : (vals[i] - bb.lower[i]) / (bb.upper[i] - bb.lower[i])
    let outside = (i) => bb.mid[i] != null && (vals[i] > bb.upper[i] || vals[i] < bb.lower[i])
    let when = (i) => i < len(times) ? bollinger_chart_when(times[i]) : `${i + 1}`
    let axis_width = max([4] + (sc.ticks | map((t) => len(tick(t)))) + [n > 0 ? len(money(vals[-1])) + 1 : 0])
    <figure class={ui_cls(["ui-bb", class])} aria-label={label} style={`--h: ${height}px`}>
        {show_label && <figcaption.ui-bb-title>{label}</figcaption>}
        <ul.ui-bb-legend aria-hidden="true">
            {!candle_bars && <li><span.ui-bb-key.ui-bb-cp></span>Close</li>}
            <li><span.ui-bb-key.ui-bb-cb></span>SMA {period}</li>
            <li><span.ui-bb-kb></span>Bands ±{bollinger_chart_num(deviations)}σ</li>
        </ul>
        <div.ui-bb-frame aria-hidden="true">
            <div.ui-bb-plot>
                {for t in sc.ticks => <span.ui-bb-grid style={`top: ${pct(y(t))}%`}></span>}
                <svg.ui-bb-svg viewBox="0 0 100 100" preserveAspectRatio="none">
                    <path.ui-bb-fill d={band}/>
                    <path.ui-bb-edge d={path(bb.upper)} vector-effect="non-scaling-stroke"/>
                    <path.ui-bb-edge d={path(bb.lower)} vector-effect="non-scaling-stroke"/>
                    <path.ui-bb-mid d={path(bb.mid)} vector-effect="non-scaling-stroke"/>
                    {!candle_bars && n > 0 && <path.ui-bb-close d={"M" + pts(vals, range(n))} vector-effect="non-scaling-stroke"/>}
                </svg>
                <div.ui-bb-cols>
                    {for i in range(n) => <div class={ui_cls(["ui-bb-col", n > 1 && i >= n / 2 && "ui-bb-flip",
                                                              candle_bars && (vals[i] >= (candles[i].open ?? vals[i]) ? "ui-bb-up" : "ui-bb-down")])}>
                        {candle_bars && [
                            <span.ui-bb-wick style={`top: ${pct(y(candles[i].high ?? vals[i]))}%; height: ${pct(y(candles[i].low ?? vals[i]) - y(candles[i].high ?? vals[i]))}%`}></span>,
                            <span.ui-bb-body style={`top: ${pct(y(max([candles[i].open ?? vals[i], vals[i]])))}%; height: ${pct(abs(y(candles[i].open ?? vals[i]) - y(vals[i])))}%`}></span>
                        ]}
                        {outside(i) && <span class={`ui-bb-out ${vals[i] > bb.upper[i] ? "ui-bb-down" : "ui-bb-up"}`} style={`top: ${pct(y(vals[i]))}%`}></span>}
                        {!candle_bars && <span.ui-bb-dot style={`top: ${pct(y(vals[i]))}%`}></span>}
                        <span.ui-bb-tip>
                            <strong>{when(i)}</strong>
                            <p>Close<b>{money(vals[i])}</b></p>
                            <p>Upper<b>{money(bb.upper[i])}</b></p>
                            <p>SMA {period}<b>{money(bb.mid[i])}</b></p>
                            <p>Lower<b>{money(bb.lower[i])}</b></p>
                            <p>%B<b>{pb(i) == null ? "—" : bollinger_chart_num(pb(i), 2)}</b></p>
                            <p>Width<b>{bb.mid[i] == null || bb.mid[i] == 0 ? "—" : `${bollinger_chart_num((bb.upper[i] - bb.lower[i]) * 100 / bb.mid[i], 1)}%`}</b></p>
                            {outside(i) && <p class={vals[i] > bb.upper[i] ? "ui-bb-down" : "ui-bb-up"}><em>{vals[i] > bb.upper[i] ? "Above the upper band" : "Below the lower band"}</em></p>}
                        </span>
                    </div>}
                </div>
            </div>
            <div.ui-bb-y style={`width: ${axis_width}ch`}>
                {for t in sc.ticks => !(n > 0 && abs(y(t) - y(vals[-1])) * height < 1400) && <span style={`top: ${pct(y(t))}%`}>{tick(t)}</span>}
                {n > 0 && <span.ui-bb-tag style={`top: ${pct(y(vals[-1]))}%`}>{money(vals[-1])}</span>}
            </div>
            <div.ui-bb-x>
                {len(times) == n && (for t in bollinger_chart_ticks(times, 7) => <span
                    class={ui_cls([x(t.i) < 4 && "ui-bb-first", x(t.i) > 96 && "ui-bb-end"])} style={`left: ${pct(x(t.i))}%`}>{t.text}</span>)}
            </div>
            <span></span>
        </div>
        <table.ui-sr>
            <caption>{label}: close and Bollinger bands ({period}, {bollinger_chart_num(deviations)})</caption>
            <thead><tr><th scope="col">Time</th><th scope="col">Close</th><th scope="col">Upper</th><th scope="col">Middle</th><th scope="col">Lower</th></tr></thead>
            <tbody>
                {for i in range(n) => <tr>
                    <th scope="row">{when(i)}</th><td>{money(vals[i])}</td><td>{money(bb.upper[i])}</td><td>{money(bb.mid[i])}</td><td>{money(bb.lower[i])}</td>
                </tr>}
            </tbody>
        </table>
    </figure>
}
