// CoverImage: a wide picture with a title over it, on a gradient so the words
// read whatever the picture is: the top of an article, a profile, a listing.
//
//   <CoverImage src="/img/ridge.jpg" alt="The north ridge at dawn" title="The long way round"
//               subtitle="Six days across the Picos" eyebrow="Travel"/>
//   <CoverImage src={trip.cover} alt="" title={trip.name} size="lg" align="center">
//       <Button>Book now</Button>
//   </CoverImage>
//
// src, alt: the picture. title: the heading over it (an h2); subtitle: a line
// under it; eyebrow: a small line above it. children: anything under the text
// (buttons, tags). size: the height, "sm" (220px), "md" (320px, default) or
// "lg" (440px). position: which part of the picture stays in view when it is
// cropped: "center" (default), "top" or "bottom". align: the text's place, "left"
// (default) or "center". shade: how dark the gradient is, 0 to 1 (.7).

import ui/theme.qwe use ui_cls

let cover_image_css = css`
.ui-cover-image {
  position: relative; display: grid; align-items: end; overflow: hidden; width: 100%; height: var(--h, 320px);
  border-radius: var(--ui-radius); background: var(--ui-subtle); color: #fff; font: 15px/1.5 var(--ui-font);
}
.ui-cover-image-sm { --h: 220px; }
.ui-cover-image-lg { --h: 440px; }
.ui-cover-image img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; }
.ui-cover-image-top img { object-position: top; }
.ui-cover-image-bottom img { object-position: bottom; }
.ui-cover-image-shade { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0, 0, 0, var(--shade, .7)) 0%, rgba(0, 0, 0, calc(var(--shade, .7) * .4)) 45%, transparent 80%); }
.ui-cover-image-text { position: relative; display: grid; gap: 6px; padding: 28px; text-shadow: 0 1px 3px rgba(0, 0, 0, .4); }
.ui-cover-image-center .ui-cover-image-text { justify-items: center; text-align: center; }
.ui-cover-image-eyebrow { margin: 0; font-size: 12px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; opacity: .9; }
.ui-cover-image-title { margin: 0; font-size: clamp(22px, 4vw, 34px); font-weight: 700; line-height: 1.15; letter-spacing: -.01em; }
.ui-cover-image-subtitle { margin: 0; font-size: 16px; opacity: .92; }
.ui-cover-image-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 10px; }
.ui-cover-image-sm .ui-cover-image-text { padding: 20px; }
.ui-cover-image-sm .ui-cover-image-title { font-size: 22px; }
`

view CoverImage(src: str, alt: str = "", title: str, subtitle: str? = null, eyebrow: str? = null, size: str = "md",
                position: str = "center", align: str = "left", shade: num = 0.7, class: str? = null, children) {
    style global cover_image_css
    <section class={ui_cls(["ui-cover-image", size != "md" && `ui-cover-image-${size}`, position != "center" && `ui-cover-image-${position}`,
                            align == "center" && "ui-cover-image-center", class])}
             style={`--shade: ${shade}`} aria-label={title}>
        <img src={src} alt={alt}/>
        <div.ui-cover-image-shade aria-hidden="true"></div>
        <div.ui-cover-image-text>
            {eyebrow != null && <p.ui-cover-image-eyebrow>{eyebrow}</p>}
            <h2.ui-cover-image-title>{title}</h2>
            {subtitle != null && <p.ui-cover-image-subtitle>{subtitle}</p>}
            {len(children) > 0 && <div.ui-cover-image-actions>{children}</div>}
        </div>
    </section>
}
