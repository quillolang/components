// YouTubeEmbed: a YouTube video that costs the page nothing until it is
// wanted: the poster shows with a play button, and YouTube's player loads only
// when that is clicked, then starts at once. The poster is YouTube's own
// thumbnail for the video; the player comes from youtube-nocookie.com.
//
//   <YouTubeEmbed video="aqz-KE-bpKQ" title="Big Buck Bunny"/>
//   <YouTubeEmbed video="aqz-KE-bpKQ" title="Big Buck Bunny" start={90} poster="max"/>
//
// video: the video's id (the v= of its address). title (required): its name,
// on the play button and the player. start: seconds in to start at. ratio: the
// shape ("16/9"). poster: "hq" (default, 480px wide) or "max" (the largest
// YouTube has; not every video has one). on_play(): inside one of your
// components, called when the player is loaded.

import ui/theme.qwe use ui_cls

let youtube_embed_css = css`
.ui-youtube-embed { position: relative; overflow: hidden; width: 100%; aspect-ratio: var(--r, 16/9); border-radius: var(--ui-radius); background: #000; }
.ui-youtube-embed-poster { position: absolute; inset: 0; display: block; width: 100%; height: 100%; padding: 0; border: 0; background: #000; cursor: pointer; }
.ui-youtube-embed-poster img { display: block; width: 100%; height: 100%; object-fit: cover; opacity: .9; transition: opacity .2s; }
.ui-youtube-embed-poster:hover img { opacity: 1; }
.ui-youtube-embed-poster:focus-visible { outline: none; box-shadow: var(--ui-focus); }
.ui-youtube-embed-play {
  position: absolute; top: 50%; left: 50%; width: 68px; height: 48px; transform: translate(-50%, -50%); border-radius: 12px;
  background: rgba(20, 20, 20, .8); color: #fff; transition: background .15s;
}
.ui-youtube-embed-poster:hover .ui-youtube-embed-play { background: #f00; }
.ui-youtube-embed-play svg { position: absolute; inset: 0; margin: auto; width: 24px; height: 24px; }
.ui-youtube-embed-title { position: absolute; inset: 0 0 auto 0; padding: 12px 16px; background: linear-gradient(to bottom, rgba(0, 0, 0, .6), transparent); color: #fff; font: 500 15px/1.3 var(--ui-font); text-align: left; text-shadow: 0 1px 2px rgba(0, 0, 0, .5); }
.ui-youtube-embed iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
@media (prefers-reduced-motion: reduce) { .ui-youtube-embed-poster img, .ui-youtube-embed-play { transition: none; } }
`

component YouTubeEmbed(video: str, title: str, start: int = 0, ratio: str = "16/9", poster: str = "hq", on_play = null,
                       class: str? = null) {
    style global youtube_embed_css
    state on = false
    let thumb = `https://i.ytimg.com/vi/${url_encode(video)}/${poster == "max" ? "maxresdefault" : "hqdefault"}.jpg`
    let player = `https://www.youtube-nocookie.com/embed/${url_encode(video)}?autoplay=1&rel=0${start > 0 ? `&start=${start}` : ""}`
    <div class={ui_cls(["ui-youtube-embed", class])} style={`--r: ${ratio}`} data-video={video}>
        {on
            ? <iframe src={player} title={title} allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen={true}
                      referrerpolicy="strict-origin-when-cross-origin"></iframe>
            : <button.ui-youtube-embed-poster type="button" aria-label={`Play video: ${title}`}
                      @click={() => {
                          on = true
                          on_play && on_play()
                      }}>
                <img src={thumb} alt="" loading="lazy"/>
                <span.ui-youtube-embed-title aria-hidden="true">{title}</span>
                <span.ui-youtube-embed-play aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                </span>
            </button>}
    </div>
}
