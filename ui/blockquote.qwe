// Blockquote: a quotation with the person who said it and where, as a <figure>
// with a <blockquote> and a <figcaption>, so screen readers know what it is.
//
//   <Blockquote author="Ada Lovelace">The Analytical Engine weaves algebraic patterns.</Blockquote>
//   <Blockquote author="Grace Hopper" source="Interview, 1986" href="https://example.com/hopper">
//       <p>The most dangerous phrase in the language is, we've always done it this way.</p>
//   </Blockquote>
//
// children: the quote; text, or paragraphs. author: who said it. source: where
// (a book, a talk, a page); it is a <cite>, and a link when href is given, which
// is also the blockquote's cite attribute.
// variant: "bar" (default: a bar at the left), "marks" (a large opening quote mark)
// or "plain". size: "md" (default) or "lg". id: the figure's id.

let blockquote_css = css`
.ui-bq { margin: 0; font: 16px/1.6 var(--ui-font); color: var(--ui-fg); }
.ui-bq blockquote { margin: 0; overflow-wrap: anywhere; }
.ui-bq blockquote > :first-child { margin-top: 0; }
.ui-bq blockquote > :last-child { margin-bottom: 0; }
.ui-bq-bar blockquote { padding: 2px 0 2px 16px; border-left: 3px solid var(--ui-accent); }
.ui-bq-bar .ui-bq-by { padding-left: 19px; }
.ui-bq-marks { position: relative; padding-left: 36px; }
.ui-bq-marks::before { content: "“"; position: absolute; top: -.1em; left: 0; font-size: 3.2em; line-height: 1;
  font-family: Georgia, "Times New Roman", serif; color: var(--ui-accent); opacity: .7; }
.ui-bq-plain blockquote { font-style: italic; }
.ui-bq-lg { font-size: 19px; line-height: 1.5; }
.ui-bq-by { margin: 8px 0 0; font-size: 14px; color: var(--ui-muted); }
.ui-bq-by::before { content: "— "; }
.ui-bq-by cite { font-style: normal; }
.ui-bq-by a { color: inherit; text-decoration: underline; text-underline-offset: 2px; }
.ui-bq-by a:hover { color: var(--ui-accent); }
.ui-bq-by a:focus-visible { outline: none; border-radius: 3px; box-shadow: var(--ui-focus); }
`

view Blockquote(author: str? = null, source: str? = null, href: str? = null, variant: str = "bar", size: str = "md",
                id: str? = null, class: str? = null, children) {
    style global blockquote_css
    <figure class={ui_cls(["ui-bq", `ui-bq-${variant}`, size != "md" && `ui-bq-${size}`, class])} id={id}>
        <blockquote cite={href}>{children}</blockquote>
        {(author != null || source != null) && <figcaption.ui-bq-by>
            {author}
            {author != null && source != null && ", "}
            {source != null && <cite>{href != null ? <a href={href}>{source}</a> : source}</cite>}
        </figcaption>}
    </figure>
}
