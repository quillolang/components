// The gallery: every component, with its examples, on one page.
//
//   scripts/build.sh && quillo run gallery.qwe --watch    then open http://localhost:8080
//
// /?only=button shows one component; ?theme=dark or ?theme=light fixes the theme.

use "quillo-ui.qwe"
use "demos.qwe"

let GROUPS = ["Layout", "Actions", "Forms", "Feedback", "Overlays", "Navigation", "Data"]

let gallery_css = css`
.g-side { position: fixed; inset: 0 auto 0 0; width: 220px; padding: 24px 18px; overflow: auto;
  border-right: 1px solid var(--ui-border); background: var(--ui-subtle); font-size: 14px; }
.g-side h1 { margin: 0 0 18px; font-size: 17px; }
.g-side h2 { margin: 18px 0 6px; font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: var(--ui-muted); }
.g-side a { display: block; padding: 3px 0; color: var(--ui-fg); text-decoration: none; }
.g-side a:hover { color: var(--ui-accent); }
.g-main { margin-left: 220px; padding: 32px 40px 80px; max-width: 1000px; }
.g-item { padding: 28px 0; border-bottom: 1px solid var(--ui-border); scroll-margin-top: 16px; }
.g-item h3 { margin: 0 0 4px; font-size: 20px; }
.g-item > p { margin: 0 0 18px; color: var(--ui-muted); }
.g-stage { padding: 24px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius); background: var(--ui-bg); }
@media (max-width: 760px) { .g-side { position: static; width: auto; } .g-main { margin: 0; padding: 20px 16px; } }
`

fn in_group(g: str) = ui_gallery | filter((c) => c.group == g) | sort_by((c) => c.name)

route GET / { query: { only: str = "", theme: str = "" } } {
    <html lang="en">
        <head>
            <meta charset="utf-8"/>
            <meta name="viewport" content="width=device-width, initial-scale=1"/>
            <title>Quillo UI</title>
            <link rel="icon" href="data:,"/>
            <style>{ui_css + demo_css + gallery_css}</style>
        </head>
        <body class={ui_cls(["ui-root", theme != "" && `ui-${theme}`])}>
            <nav.g-side>
                <h1>Quillo UI · {len(ui_gallery)}</h1>
                {for g in GROUPS => len(in_group(g)) > 0 && <div>
                    <h2>{g}</h2>
                    {for c in in_group(g) => <a href={`#${c.slug}`}>{c.name}</a>}
                </div>}
            </nav>
            <main.g-main>
                {for g in GROUPS => for c in in_group(g) | filter((c) => only == "" || c.slug == only) =>
                    <section.g-item id={c.slug} data-slug={c.slug}>
                        <h3>{c.name}</h3>
                        <p>{c.summary}</p>
                        <div.g-stage>{c.demo()}</div>
                    </section>}
            </main>
        </body>
    </html>
}
