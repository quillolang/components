                { target: "tour-demo-new", title: "New order", text: "Start one here; drafts are kept for a week." },
                { target: "tour-demo-nowhere", title: "That's it", text: "Ask us anything from the help menu." },
            ]} on_finish={() => { said = "Finished." }} on_close={(i) => { said = `Ended at step ${i + 1}.` }}/>
