// ---- demos/prose.qwe ----------------------------------------------------------------

view ProseDemo() =
    <div.demo-stack>
        <Prose id="prose-demo-article">
            <h1>Writing a component</h1>
            <p>Each component is <strong>one file</strong> you copy into your program. It brings its
               own styles, follows the system's <em>light or dark</em> theme, and works with the
               keyboard. See <a href="#prose">the gallery</a> for every one.</p>
            <h2>What goes in</h2>
            <p>Three things, in this order:</p>
            <ol>
                <li>A comment saying what it is, with an example.</li>
                <li>Its CSS, as <code>let name_css = css`...`</code>.</li>
                <li>The <code>view</code> or <code>component</code>.</li>
            </ol>
            <blockquote><p>Views first: a component with nothing to remember is a view, built on what the browser already does.</p></blockquote>
            <h3>Checking it</h3>
            <pre><code>scripts/build.sh
QUILLO=target/release/quillo scripts/test.sh button</code></pre>
            <table>
                <thead><tr><th>Kind</th><th>Runs</th><th>Script</th></tr></thead>
                <tbody>
                    <tr><td>view</td><td>on the server</td><td>none</td></tr>
                    <tr><td>component</td><td>server, then browser</td><td>its bundle</td></tr>
                </tbody>
            </table>
            <ul>
                <li>Colours only through the theme's variables
                    <ul><li>so dark mode works by itself</li></ul></li>
                <li>Press <kbd>Tab</kbd> to reach everything</li>
            </ul>
            <hr/>
            <p>Last edited <mark>today</mark>, <del>yesterday</del>.</p>
        </Prose>
        <div.demo-row>
            <Prose size="sm" width="30ch" id="prose-demo-small"><h2>Small, narrow</h2><p>For a sidebar note, at 14px and 30 characters wide.</p></Prose>
            <Prose size="lg" width="30ch" id="prose-demo-large"><h2>Large</h2><p>For a lede or a landing page, at 18px.</p></Prose>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "prose", name: "Prose", group: "Typography",
    summary: "Styles for a block of article HTML (from markdown() or by hand): headings, lists, links, quotes, code, tables.",
    tags: ["typography", "text", "document", "no-js"],
    demo: ProseDemo })

// ---- demos/pullquote.qwe ----------------------------------------------------------------

let pullquote_demo_para = "Quillo renders a page on the server, then resumes its components in the browser from the state the server sent, so a page shows at once and reacts as soon as it is touched. What someone typed and clicked before the script came is kept and done then. A component that runs by itself loads as soon as the page is idle; the rest wait until they are reached, so a page with a hundred of them costs no more than one."

view PullquoteDemo() =
    <div.demo-stack>
        <div id="pullquote-demo-article" style="font: 15px/1.6 var(--ui-font)">
            <Pullquote side="right" repeated={true} id="pullquote-demo-right">A page shows at once and reacts as soon as it is touched.</Pullquote>
            <p style="margin: 0 0 1em">{pullquote_demo_para}</p>
            <p style="margin: 0 0 1em">{pullquote_demo_para}</p>
            <Pullquote side="left" author="Ada Lovelace" id="pullquote-demo-left">The Engine weaves algebraic patterns just as the loom weaves flowers.</Pullquote>
            <p style="margin: 0 0 1em">{pullquote_demo_para}</p>
            <p style="margin: 0">{pullquote_demo_para}</p>
            <Pullquote side="full" author="Someone on the team" id="pullquote-demo-full">Ship the smallest thing that teaches you something.</Pullquote>
            <p style="margin: 0">{pullquote_demo_para}</p>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "pullquote", name: "Pullquote", group: "Typography",
    summary: "A line lifted from an article, set large beside the column with the text flowing around it, or across it.",
    tags: ["typography", "text", "document", "no-js"],
    demo: PullquoteDemo })

