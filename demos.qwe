let search_list_demo_docs = [
    { title: "Routes", text: "A route answers requests by method and path, with typed path parameters and query patterns that convert text to numbers.", href: "#breadcrumbs", tags: ["Server"] },
    { title: "Components", text: "A component is a view with state that also runs in the browser, resumed from what the server rendered.", href: "#combobox", tags: ["Browser"] },
    { title: "Server functions", text: "Call the server from a component as if it were a local function; arguments are checked as records.", href: "#copy_button", tags: ["Server", "Browser"] },
    { title: "Database", text: "SQLite by default, Postgres and MySQL when asked: db.query, db.one, db.exec and transactions with retries.", href: "#data_table", tags: ["Server", "Data"] },
    { title: "Uploads", text: "A multipart form sends files; each one is in request.files under its field's name, saved with save_upload.", href: "#file_drop", tags: ["Server", "Forms"] },
    { title: "Records", text: "type names a shape that is checked when a function is called and made from what a client sends.", href: "#description_list", tags: ["Data"] },
    { title: "Forms without JavaScript", text: "Every field is a real input with a name, so a plain form posts it to a route and the server answers.", href: "#text_field", tags: ["Forms"] },
    { title: "Live data", text: "live(load) makes component state follow the server: it loads again whenever something it read changes.", href: "#sparkline", tags: ["Browser", "Data"] },
]

