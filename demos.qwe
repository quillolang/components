// The gallery's examples, in one file. Made by scripts/build.sh from demos/.

// ---- demos/_demo.qwe ----------------------------------------------------------------

// What every demo shares: the list they add themselves to, and the layout
// classes they use. (scripts/build.sh puts this first in demos.qwe.)

let ui_gallery = []

let demo_css = css`
.demo-row { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
.demo-stack { display: grid; gap: 14px; }
.demo-wide { width: 100%; }
.demo-narrow { max-width: 360px; }
.demo-note { margin: 0; color: var(--ui-muted); font: 13px/1.5 var(--ui-font); }
`

// ---- demos/accordion.qwe ----------------------------------------------------------------

view AccordionDemo() =
    <div.demo-stack>
        <Accordion>
            <AccordionItem group="faq" title="What does it cost?" open={true}>
                <p>Nothing for one project and up to three people. Teams pay per seat, monthly or yearly.</p>
            </AccordionItem>
            <AccordionItem group="faq" title="Can I cancel at any time?">
                <p>Yes, from Settings, Billing. You keep access until the end of the period you paid for.</p>
            </AccordionItem>
            <AccordionItem group="faq" title="Where is my data kept?" hint="Servers, backups and exports">
                <p>In the EU, on servers in Frankfurt, with nightly backups kept for 30 days.</p>
            </AccordionItem>
        </Accordion>
        <p.demo-note>The same group: opening one closes the others. Below, flush and independent.</p>
        <Accordion flush={true}>
            <AccordionItem title="Shipping"><p>Free over €50; two to four working days.</p></AccordionItem>
            <AccordionItem title="Returns"><p>Within 30 days, in the original packaging.</p></AccordionItem>
        </Accordion>
    </div>

ui_gallery = ui_gallery | push({ slug: "accordion", name: "Accordion", group: "Navigation",
    summary: "Sections that open under their titles, on the browser's own <details>: exclusive with a group.",
    demo: AccordionDemo })

// ---- demos/alert.qwe ----------------------------------------------------------------

component AlertDemoLive() {
    state shown = true
    <div.demo-stack>
        {shown
            ? <Alert tone="warning" title="Your trial ends in 3 days" dismissable={true}
                     on_dismiss={() => { shown = false }}>Add a card to keep your projects.</Alert>
            : <p.demo-note>Dismissed. <button type="button" @click={() => { shown = true }}>Show it again</button></p>}
    </div>
}

view AlertDemo() =
    <div.demo-stack>
        <Alert title="A new version is out">Quillo 0.9 adds live queries. <a href="#alert">Read the notes</a>.</Alert>
        <Alert tone="success" title="Invoice sent">Northwind Traders got invoice INV-1042.</Alert>
        <Alert tone="danger" title="Payment failed">The card ending in 4242 was declined.</Alert>
        <Alert tone="neutral" icon={false}>Maintenance on Sunday, 02:00 to 03:00 UTC.</Alert>
        <div.demo-row>
            <Alert tone="accent" variant="outline">Outline, accent.</Alert>
            <Alert tone="success" variant="solid">Solid, success.</Alert>
            <Alert tone="danger" variant="solid">Solid, danger.</Alert>
        </div>
        <AlertDemoLive/>
        <DismissibleAlert tone="info" title="Placed straight in a page">DismissibleAlert hides itself when closed.</DismissibleAlert>
    </div>

ui_gallery = ui_gallery | push({ slug: "alert", name: "Alert", group: "Feedback",
    summary: "A message in the page in six tones and three variants, with an icon, announced to screen readers, and dismissable.",
    demo: AlertDemo })

// ---- demos/app_shell.qwe ----------------------------------------------------------------

let app_shell_demo_nav = [{ label: "Overview", href: "/", icon: "◎" }, { label: "Projects", href: "#app_shell", icon: "▤" },
                          { label: "Team", href: "#team", icon: "☺" }, { label: "Billing", href: "#billing", icon: "▭" }]

view AppShellDemoPage() =
    <div>
        <h2 style="margin: 0 0 6px; font-size: 20px">Overview</h2>
        <p style="margin: 0; color: var(--ui-muted)">The page goes here. The sidebar stays put as it scrolls.</p>
        {for i in range(1, 6) => <p>Paragraph {i} of the page, to give it some length.</p>}
    </div>

view AppShellDemo() =
    <div.demo-stack>
        <div style="--ui-shell-height: 340px; height: 340px; overflow: auto; border: 1px solid var(--ui-border); border-radius: var(--ui-radius); transform: translateZ(0)">
            <AppShell id="app-shell-demo" brand="Acme" nav={app_shell_demo_nav} current="/"
                      header={[<b>Overview</b>, <Button size="sm" variant="outline">Invite</Button>]}>
                <AppShellDemoPage/>
            </AppShell>
        </div>
        <p.demo-note>When it is narrow, the sidebar becomes a drawer, opened by the menu button:</p>
        <div style="--ui-shell-height: 340px; width: min(380px, 100%); height: 340px; overflow: auto; border: 1px solid var(--ui-border); border-radius: var(--ui-radius); transform: translateZ(0)">
            <AppShell id="app-shell-demo-narrow" brand="Acme" nav={app_shell_demo_nav} current="/"
                      header={[<b>Overview</b>, <Button size="sm" variant="outline">Invite</Button>]}>
                <AppShellDemoPage/>
            </AppShell>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "app_shell", name: "AppShell", group: "Layout",
    summary: "An app's frame: a sidebar of links, a top bar and the page; the sidebar is a drawer on phones.",
    demo: AppShellDemo })

// ---- demos/avatar.qwe ----------------------------------------------------------------

let avatar_demo_team = [
    { name: "Ada Lovelace", status: "online" },
    { name: "Grace Hopper", src: "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'%3E%3Crect width='40' height='40' fill='%23c9b8f5'/%3E%3Ccircle cx='20' cy='16' r='7' fill='%236e56cf'/%3E%3Cpath d='M6 40c2-9 8-13 14-13s12 4 14 13z' fill='%236e56cf'/%3E%3C/svg%3E" },
    { name: "Alan Turing" },
    { name: "Katherine Johnson" },
    { name: "Linus Torvalds" },
    { name: "Margaret Hamilton" },
    { name: "Dennis Ritchie" },
]

view AvatarDemo() =
    <div.demo-stack>
        <div.demo-row>
            <Avatar name="Ada Lovelace" size="xs"/>
            <Avatar name="Grace Hopper" size="sm"/>
            <Avatar name="Alan Turing"/>
            <Avatar name="Katherine Johnson" size="lg"/>
            <Avatar name="Plato" size="xl"/>
            <Avatar name="Margaret Hamilton" shape="square" size="lg"/>
        </div>
        <div.demo-row>
            <Avatar name="Ada Lovelace" status="online"/>
            <Avatar name="Linus Torvalds" status="away"/>
            <Avatar name="Dennis Ritchie" status="busy"/>
            <Avatar name="Barbara Liskov" status="offline"/>
            <Avatar name="Grace Hopper" src={avatar_demo_team[1].src} size="lg" status="online"/>
            <Avatar name="Broken Picture" src="data:image/png;base64,bm90IGEgcGljdHVyZQ==" size="lg"/>
        </div>
        <div.demo-row>
            <AvatarGroup people={avatar_demo_team} max={4} label="Project members"/>
            <AvatarGroup people={take(avatar_demo_team, 3)} size="sm"/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "avatar", name: "Avatar", group: "Data",
    summary: "A picture, or initials on a colour of the person's own, with a status dot; and overlapping groups with +N.",
    demo: AvatarDemo })

// ---- demos/badge.qwe ----------------------------------------------------------------

view BadgeDemo() =
    <div.demo-stack>
        <div.demo-row>
            <Badge>Draft</Badge>
            <Badge tone="accent">New</Badge>
            <Badge tone="success">Paid</Badge>
            <Badge tone="warning">Overdue</Badge>
            <Badge tone="danger">Failed</Badge>
            <Badge tone="info">Beta</Badge>
        </div>
        <div.demo-row>
            <Badge tone="success" dot={true}>Online</Badge>
            <Badge tone="warning" dot={true} variant="outline">Degraded</Badge>
            <Badge tone="danger" dot={true} variant="solid">Down</Badge>
            <Badge variant="outline">Outline</Badge>
            <Badge tone="accent" variant="solid">Solid</Badge>
            <Badge size="sm" tone="info">Small</Badge>
        </div>
        <div.demo-row>
            <span>Inbox <Badge tone="danger" variant="solid" count={3} label="unread messages"/></span>
            <span>Mentions <Badge tone="accent" count={42}/></span>
            <span>Notifications <Badge tone="danger" variant="solid" count={128} label="notifications"/></span>
            <span>Tasks <Badge size="sm" count={7}/></span>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "badge", name: "Badge", group: "Feedback",
    summary: "A small pill for a status or a count: six tones, soft, solid or outline, a status dot, and 99+.",
    demo: BadgeDemo })

// ---- demos/breadcrumbs.qwe ----------------------------------------------------------------

view BreadcrumbsDemo() =
    <div.demo-stack>
        <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Docs", href: "/docs/" },
                             { label: "Components", href: "/components/" }, { label: "Breadcrumbs" }]}/>
        <Breadcrumbs items={[{ label: "Acme Inc.", href: "/" }, { label: "Projects", href: "/projects" },
                             { label: "Quarterly marketing campaign for the spring launch", href: "/projects/41" },
                             { label: "Settings" }]}/>
        <p.demo-note>On a phone, the middle items are cut short; their whole label is a tooltip.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "breadcrumbs", name: "Breadcrumbs", group: "Navigation",
    summary: "Where this page sits: a trail of links up to the home page, the last one marked as this page.",
    demo: BreadcrumbsDemo })

// ---- demos/button.qwe ----------------------------------------------------------------

view ButtonDemo() =
    <div.demo-stack>
        <div.demo-row>
            <Button>Save changes</Button>
            <Button variant="soft">Soft</Button>
            <Button variant="outline">Outline</Button>
            <Button variant="ghost">Ghost</Button>
        </div>
        <div.demo-row>
            <Button tone="neutral">Neutral</Button>
            <Button tone="danger">Delete</Button>
            <Button tone="danger" variant="soft">Discard</Button>
            <Button variant="outline" href="https://quillolang.org/docs/">A link</Button>
        </div>
        <div.demo-row>
            <Button size="sm">Small</Button>
            <Button size="lg">Large</Button>
            <Button loading={true}>Saving</Button>
            <Button disabled={true}>Disabled</Button>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "button", name: "Button", group: "Actions",
    summary: "A button, or a link that looks like one: four variants, three tones, three sizes, loading.",
    demo: ButtonDemo })

// ---- demos/button_group.qwe ----------------------------------------------------------------

view ButtonGroupDemo() =
    <div.demo-stack>
        <div.demo-row>
            <ButtonGroup label="Text alignment">
                <Button variant="outline">Left</Button>
                <Button variant="outline">Centre</Button>
                <Button variant="outline">Right</Button>
            </ButtonGroup>
            <ButtonGroup label="Save">
                <Button>Save</Button>
                <IconButton icon="chevron-down" label="More ways to save" variant="solid" tone="accent"/>
            </ButtonGroup>
            <ButtonGroup label="Zoom">
                <IconButton icon="plus" label="Zoom in" variant="outline"/>
                <IconButton icon="search" label="Fit" variant="outline"/>
                <IconButton icon="x" label="Reset" variant="outline"/>
            </ButtonGroup>
        </div>
        <div.demo-row>
            <ButtonGroup label="Actions" attached={false}>
                <Button variant="soft">Archive</Button>
                <Button variant="soft">Move</Button>
                <Button variant="soft" tone="danger">Delete</Button>
            </ButtonGroup>
            <ButtonGroup label="Order" vertical={true}>
                <Button variant="outline" size="sm">First</Button>
                <Button variant="outline" size="sm">Second</Button>
            </ButtonGroup>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "button_group", name: "ButtonGroup", group: "Actions",
    summary: "Buttons joined edge to edge into one control, or spaced in a row; across or upright.",
    demo: ButtonGroupDemo })

// ---- demos/card.qwe ----------------------------------------------------------------

view CardDemo() =
    <Grid min={250}>
        <Card title="Storage" subtitle="12 of 50 GB used">
            <p>Photos take the most room. Old backups are removed after 30 days.</p>
        </Card>
        <Card title="Quillo docs" subtitle="quillolang.org/docs" href="https://quillolang.org/docs/" variant="elevated">
            Guides and the language reference. The whole card is a link.
        </Card>
        <Card title="Team" header={<span style="font-size: 12px; color: var(--ui-muted)">3 seats</span>}
              footer={[<Button variant="ghost" size="sm">Manage</Button>, <Button size="sm">Invite</Button>]}>
            <p>Ada, Grace and Linus can edit this project.</p>
        </Card>
        <Card variant="subtle" padding="sm"><p>A subtle card, small padding, no title.</p></Card>
    </Grid>

ui_gallery = ui_gallery | push({ slug: "card", name: "Card", group: "Layout",
    summary: "A surface for one thing, with a title, a header and a footer, or a link as a whole.",
    demo: CardDemo })

// ---- demos/checkbox.qwe ----------------------------------------------------------------

let checkbox_demo_topics = [{ label: "Releases", value: "releases", hint: "A note when a version ships." },
                            { label: "Events", value: "events" }, { label: "Jobs", value: "jobs" }]

component CheckboxDemoLive() {
    state picked = ["releases"]
    let all = len(picked) == len(checkbox_demo_topics)
    <div.demo-stack>
        <Checkbox label="All topics" checked={all} indeterminate={!all && len(picked) > 0}
                  on_change={(on) => { picked = on ? checkbox_demo_topics | map((t) => t.value) : [] }}/>
        <CheckboxGroup name="topics" label="Email me about" options={checkbox_demo_topics} values={picked}
                       on_change={(v, on) => { picked = on ? picked | push(v) : picked | filter((p) => p != v) }}/>
        <p.demo-note>Subscribed to {len(picked)} of {len(checkbox_demo_topics)}.</p>
    </div>
}

view CheckboxDemo() =
    <div.demo-stack>
        <Checkbox name="remember" label="Remember me" checked={true} hint="For 30 days on this device."/>
        <div.demo-row>
            <Checkbox name="mixed" label="Some files" indeterminate={true}/>
            <Checkbox name="off" label="Disabled" disabled={true}/>
        </div>
        <Checkbox name="terms" label="I accept the terms of service" required={true}
                  error="You need to accept them to go on."/>
        <CheckboxGroup name="days" label="Days" direction="row" values={["Mon", "Wed"]}
                       options={["Mon", "Tue", "Wed", "Thu", "Fri"]} hint="When we may call you."/>
        <CheckboxDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "checkbox", name: "Checkbox", group: "Forms",
    summary: "A checkbox drawn by CSS on a real input, with an indeterminate state, and a group of them in a fieldset.",
    demo: CheckboxDemo })

// ---- demos/combobox.qwe ----------------------------------------------------------------

let combobox_demo_countries = [
    { label: "Argentina", value: "AR" }, { label: "Australia", value: "AU" }, { label: "Austria", value: "AT" },
    { label: "Belgium", value: "BE" }, { label: "Brazil", value: "BR" }, { label: "Canada", value: "CA" },
    { label: "Chile", value: "CL" }, { label: "Denmark", value: "DK" }, { label: "Finland", value: "FI" },
    { label: "France", value: "FR" }, { label: "Germany", value: "DE" }, { label: "Greece", value: "GR" },
    { label: "Iceland", value: "IS" }, { label: "India", value: "IN" }, { label: "Ireland", value: "IE" },
    { label: "Italy", value: "IT" }, { label: "Japan", value: "JP" }, { label: "Mexico", value: "MX" },
    { label: "Netherlands", value: "NL" }, { label: "New Zealand", value: "NZ" }, { label: "Norway", value: "NO" },
    { label: "Portugal", value: "PT" }, { label: "South Korea", value: "KR" }, { label: "Spain", value: "ES" },
    { label: "Sweden", value: "SE" }, { label: "Switzerland", value: "CH" }, { label: "United Kingdom", value: "GB" },
    { label: "United States", value: "US" },
]

component ComboboxDemoLive() {
    state lang = null
    <div.demo-stack>
        <Combobox id="cb-lang" name="lang" label="Favourite language" placeholder="Start typing"
                  options={["C", "Elixir", "Go", "Haskell", "JavaScript", "Python", "Quillo", "Ruby", "Rust", "Zig"]}
                  on_change={(v) => { lang = v }}/>
        <p.demo-note>{lang == null ? "None picked." : `Picked ${lang}.`}</p>
    </div>
}

view ComboboxDemo() =
    <div.demo-stack.demo-narrow>
        <Combobox id="cb-country" name="country" label="Country" value="PT" options={combobox_demo_countries}
                  hint="Type to filter; the arrow keys and Enter pick." required={true}/>
        <ComboboxDemoLive/>
        <Combobox id="cb-small" label="Small" size="sm" placeholder="Disabled" disabled={true}
                  options={["One", "Two"]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "combobox", name: "Combobox", group: "Forms",
    summary: "A text box that filters a list of options as you type, with the arrow keys, Enter and Escape.",
    demo: ComboboxDemo })

// ---- demos/confirm_button.qwe ----------------------------------------------------------------

component ConfirmButtonDemoLive() {
    state archived = false
    <div.demo-row>
        <ConfirmButton message="Archive this project? You can bring it back later." tone="accent" variant="soft"
                       ok="Archive" on_confirm={() => { archived = true }}>Archive</ConfirmButton>
        <span.demo-note>{archived ? "Archived." : "Not archived."}</span>
    </div>
}

view ConfirmButtonDemo() =
    <div.demo-stack>
        <form.demo-row method="get" action="#confirm_button">
            <ConfirmButton title="Delete project?" message="This deletes the project and all its files. It cannot be undone."
                           ok="Delete" name="deleted" value="yes">Delete project</ConfirmButton>
            <span.demo-note>Submits its form on yes (here, reloading this page).</span>
        </form>
        <div.demo-row>
            <ConfirmButton href="#confirm_button" message="Leave this page?" tone="neutral" variant="outline" ok="Leave">
                A link
            </ConfirmButton>
        </div>
        <ConfirmButtonDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "confirm_button", name: "ConfirmButton", group: "Overlays",
    summary: "A button that asks first, in a dialog on the page, then submits its form, follows its link or calls back.",
    demo: ConfirmButtonDemo })

// ---- demos/container.qwe ----------------------------------------------------------------

view ContainerDemo() =
    <div.demo-stack>
        {for s in ["sm", "md", "lg"] =>
            <div style="background: var(--ui-subtle); border-radius: var(--ui-radius-sm)">
                <Container size={s}>
                    <div style="padding: 10px 0; border-inline: 1px dashed var(--ui-strong); text-align: center; font-size: 13px; color: var(--ui-muted)">
                        size="{s}"
                    </div>
                </Container>
            </div>}
        <p.demo-note>Each is centred at its width, at most; the dashed lines are the container's padding edge.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "container", name: "Container", group: "Layout",
    summary: "Keeps content at a readable width, centred, with room at the sides on small screens.",
    demo: ContainerDemo })

// ---- demos/copy_button.qwe ----------------------------------------------------------------

view CopyButtonDemo() =
    <div.demo-stack>
        <div.demo-row>
            <code style="padding: 8px 12px; border-radius: var(--ui-radius-sm); background: var(--ui-subtle); font: 13px var(--ui-mono)">quillo run app.qwe</code>
            <CopyButton text="quillo run app.qwe"/>
        </div>
        <div.demo-row>
            <CopyButton text="https://quillolang.org/components/" label="Copy link" variant="soft" size="sm"/>
            <CopyButton text="demo-key-not-a-secret" label="Copy key" done="Key copied" variant="ghost"/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "copy_button", name: "CopyButton", group: "Actions",
    summary: "Copies text to the clipboard and says so for a moment, to the eye and to screen readers.",
    demo: CopyButtonDemo })

