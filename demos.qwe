component FxQuoteTicketDemoLive() {
    state ticks = 0
    state note = "No deal yet."
    <div.demo-stack>
        <FxQuoteTicket name="desk" pair="EUR/USD" bid={1.08421m} ask={1.08429m} amount={250000} seconds={6}
                       on_requote={(side) => {
                           ticks += 1
                           let move = dec((ticks % 3) - 1) * 0.00007m
                           { bid: 1.08421m + move, ask: 1.08429m + move }
                       }}
                       on_confirm={(d) => { note = `${d.side} ${d.amount} ${d.base} at ${d.rate} = ${round(d.counter, 2)} ${d.quote}` }}/>
        <p.demo-note id="fx-quote-ticket-demo-note">{note}</p>
    </div>
}

