              image: feature_list_demo_shot("%23e3f5ec", "%234cc38a"), image_alt: "A list sketched as green blocks",
              points: ["Live queries", "Streams and channels"] },
            { eyebrow: "Ship", title: "One binary, one file", text: "Copy them to a server and run. It serves, watches, reloads and logs.",
