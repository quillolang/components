// The gallery's examples, in one file. Made by scripts/build.sh from demos/.

// ---- demos/_demo.qwe ----------------------------------------------------------------

// What every demo shares: the list they add themselves to, and the layout
// classes they use. (scripts/build.sh puts this first in demos.qwe.)

let ui_gallery = []

let demo_css = css`
.demo-row { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
.demo-stack { display: grid; gap: 14px; }
.demo-wide { width: 100%; }
.demo-narrow { max-width: 360px; }
.demo-note { margin: 0; color: var(--ui-muted); font: 13px/1.5 var(--ui-font); }
/* A screen for what fills one: position: fixed inside these is held to the frame, as transform makes a new containing block. */
.demo-phone, .demo-tablet { position: relative; width: 100%; margin: 0 auto; overflow: hidden; transform: translateZ(0); border: 1px solid var(--ui-border); border-radius: 20px; background: var(--ui-bg); }
.demo-phone { max-width: 390px; height: 640px; }
.demo-tablet { max-width: 820px; height: 600px; }
`

// ---- demos/ab_test_calc.qwe ----------------------------------------------------------------

component AbTestCalcDemoLive() {
    state seen = "Change a figure to see on_change."
    <div.demo-stack>
        <AbTestCalc id="ab-test-calc-demo-live" title="New pricing page" names={["Old page", "New page"]} name="pricing" visitors_a={1000} conversions_a={100}
                    visitors_b={1000} conversions_b={110} confidence={90}
                    on_change={(f) => { seen = f == null ? "on_change: not a complete test." : `on_change: winner ${f.winner ?? "none"}, significant ${f.significant}.` }}/>
        <p.demo-note>{seen}</p>
    </div>
}

view AbTestCalcDemo() =
    <div.demo-stack>
        <AbTestCalc id="ab-test-calc-demo" title="Checkout button test" visitors_a={10000} conversions_a={500} visitors_b={10000} conversions_b={580}/>
        <AbTestCalcDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "ab_test_calc", name: "AbTestCalc", group: "Marketing",
    summary: "Reads an A/B test from visitors and conversions: lift, z-test, p-value, interval and a plain verdict, refusing to call too small a sample.",
    tags: ["smart", "interactive", "statistics", "experiment", "calculator", "marketing"], demo: AbTestCalcDemo })

// ---- demos/abbr.qwe ----------------------------------------------------------------

view AbbrDemo() =
    <div.demo-stack>
        <p.demo-note style="color: var(--ui-fg); font-size: 15px">
            The <Abbr title="HyperText Markup Language" id="abbr-demo-html">HTML</Abbr> is sent first, the
            <Abbr title="Cascading Style Sheets">CSS</Abbr> with it, and the script only when a component is reached.
            Reply <Abbr title="as soon as possible" tooltip="native" id="abbr-demo-native">ASAP</Abbr>. Hover or Tab to one.
        </p>
    </div>

ui_gallery = ui_gallery | push({ slug: "abbr", name: "Abbr", group: "Typography",
    summary: "An abbreviation whose expansion shows in a bubble on hover or focus and is read out by screen readers.",
    tags: ["typography", "text", "accessibility", "no-js"],
    demo: AbbrDemo })

// ---- demos/access_checker.qwe ----------------------------------------------------------------

let access_checker_demo_roles = { viewer: [], editor: ["viewer"], finance: ["viewer"], admin: ["editor", "finance"] }
let access_checker_demo_users = { ada: ["admin"], ben: ["editor"], cleo: ["finance"], dev: [] }
let access_checker_demo_rules = [
    { effect: "allow", role: "viewer", action: "read", resource: "docs/*" },
    { effect: "allow", role: "editor", action: "write", resource: "docs/*" },
    { effect: "allow", role: "finance", action: "read", resource: "billing/*" },
    { effect: "allow", role: "admin", action: "*", resource: "*" },
    { effect: "deny", role: "editor", action: "write", resource: "docs/published", note: "frozen after review" },
    { effect: "deny", user: "cleo", action: "read", resource: "billing/payroll" },
]

component AccessCheckerDemoLive() {
    state last = null
    <div.demo-stack>
        <AccessChecker id="access-checker-demo-live" title="With on_decide" editable={false} roles={{ reader: [] }} users={{ sam: ["reader"] }}
                       rules={[{ effect: "allow", role: "reader", action: "read", resource: "*" }]} actions={["read", "write"]}
                       resources={["wiki"]} on_decide={(d) => { last = d }}/>
        <p.demo-note>{last == null ? "Pick a cell to see on_decide." : `on_decide: ${last.who} ${last.action} ${last.resource} is ${last.allowed ? "allowed" : "denied"} by rule ${last.rule}.`}</p>
    </div>
}

view AccessCheckerDemo() =
    <div.demo-stack>
        <AccessChecker id="access-checker-demo" roles={access_checker_demo_roles} users={access_checker_demo_users} rules={access_checker_demo_rules}
                       resources={["docs/plan", "docs/published", "billing/payroll", "billing/invoices"]} actions={["read", "write"]}
                       who="user:ben" action="write" resource="docs/published"/>
        <AccessCheckerDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "access_checker", name: "AccessChecker", group: "Dashboard",
    summary: "Works out allow or deny from roles, grants and denies given as data, names the rule that decided, and shows a matrix of everything.",
    tags: ["smart", "interactive", "security", "permissions", "roles", "policy"], demo: AccessCheckerDemo })

// ---- demos/accordion.qwe ----------------------------------------------------------------

view AccordionDemo() =
    <div.demo-stack>
        <Accordion>
            <AccordionItem group="faq" title="What does it cost?" open={true}>
                <p>Nothing for one project and up to three people. Teams pay per seat, monthly or yearly.</p>
            </AccordionItem>
            <AccordionItem group="faq" title="Can I cancel at any time?">
                <p>Yes, from Settings, Billing. You keep access until the end of the period you paid for.</p>
            </AccordionItem>
            <AccordionItem group="faq" title="Where is my data kept?" hint="Servers, backups and exports">
                <p>In the EU, on servers in Frankfurt, with nightly backups kept for 30 days.</p>
            </AccordionItem>
        </Accordion>
        <p.demo-note>The same group: opening one closes the others. Below, flush and independent.</p>
        <Accordion flush={true}>
            <AccordionItem title="Shipping"><p>Free over €50; two to four working days.</p></AccordionItem>
            <AccordionItem title="Returns"><p>Within 30 days, in the original packaging.</p></AccordionItem>
        </Accordion>
    </div>

ui_gallery = ui_gallery | push({ slug: "accordion", name: "Accordion", group: "Navigation",
    summary: "Sections that open under their titles, on the browser's own <details>: exclusive with a group.",
    tags: ["navigation", "list", "no-js"],
    demo: AccordionDemo })

