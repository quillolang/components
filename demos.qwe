// ---- demos/macd_chart.qwe ----------------------------------------------------------------

// Prices from a seeded random walk (Park–Miller), the same on every render: `count`
// candles from the day `from` on, skipping weekends, daily or hourly (10:00 to 16:00),
// rounded to `places` decimals.
fn macd_chart_demo_walk(seed: int, count: int, start: num, from: str, hourly: bool = false, places: int = 2) -> list {
    let s = seed
    let rnd = () => {
        s = s * 16807 % 2147483647
        s / 2147483647
    }
    let scale = pow(10, places)
    let cut = (v) => round(v * scale) / scale
    let p = start
    let day = from
    let hour = 10
    let out = []
    while len(out) < count {
        if date.weekday(day) <= 5 {
            let open = cut(p * (1 + (rnd() - 0.5) * 0.006))
            let close = cut(open * (1 + (rnd() - 0.485) * (hourly ? 0.012 : 0.035)))
            let high = cut(max([open, close]) * (1 + rnd() * 0.01))
            let low = cut(min([open, close]) * (1 - rnd() * 0.01))
            let volume = round((hourly ? 90000 : 900000) * (1 + rnd() * 1.5 + abs(close - open) * 30 / open))
            out = out | push({ time: hourly ? `${day}T${hour < 10 ? "0" : ""}${hour}:00:00Z` : day, open, high, low, close, volume })
            p = close
        }
        if hourly && hour < 16 && date.weekday(day) <= 5 {
            hour += 1
        } else {
            hour = 10
            day = date.add_days(day, 1)
        }
    }
    out
}

let macd_chart_demo_daily = macd_chart_demo_walk(47, 130, 312.6, "2026-03-16")

view MacdChartDemo() =
    <div.demo-stack>
        <div id="macd_chart-demo-price">
            <MacdChart label="Wayne Enterprises, MACD 12 26 9" show_label={true} candles={macd_chart_demo_daily} prefix="$"/>
        </div>
        <div id="macd_chart-demo-alone">
            <MacdChart label="MACD 5 35 5, on its own" show_label={true} candles={macd_chart_demo_daily}
                       fast={5} slow={35} signal={5} price={false} macd_height={110}/>
        </div>
        <p.demo-note>Histogram bars are paler while they shrink; hover for the MACD, signal and histogram.</p>
    </div>

