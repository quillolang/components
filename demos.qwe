        <p.demo-note>{opened == null ? "Press an event." : `Opened event ${opened}.`}</p>
    </div>
}

view WeekViewDemo() =
    <div.demo-stack>
        <WeekViewDemoLive/>
        <div id="week-view-demo-short">
            <WeekView start="2026-11-04" days={3} from_hour={9} to_hour={13} hour_height={40} label="Three days"
                      events={week_view_demo_events | filter((e) => e.id == 4 || e.id == 7 || e.id == 8)}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "week_view", name: "WeekView", group: "Scheduling",
    summary: "A week of hour columns with events drawn at their times, side by side when they overlap, and all-day events across the top.",
    tags: ["schedule", "calendar", "time", "data", "no-js"], demo: WeekViewDemo })

