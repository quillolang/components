component ChatInputDemoLive() {
    state sent = []
    state typed = 0
    <div.demo-stack>
        <ChatInput id="chat-input-demo-live" on_send={(t) => { sent = sent | push(t) }} on_typing={() => { typed += 1 }}
                   before={<button type="button" class="ui-chat-composer-send" aria-label="Attach" style="background: var(--ui-subtle); color: var(--ui-muted)">
                       <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.4 11.1l-9.2 9.2a6 6 0 0 1-8.5-8.5l9.2-9.2a4 4 0 0 1 5.7 5.7l-9.2 9.2a2 2 0 0 1-2.8-2.8l8.5-8.5"/></svg>
                   </button>}/>
        <p.demo-note>{len(sent) == 0 ? "Nothing sent yet." : `Sent: ${join(sent | map((s) => `"${s}"`), ", ")}.`}{typed > 0 ? ` Typing told ${typed} ${typed == 1 ? "time" : "times"}.` : ""}</p>
    </div>
}

