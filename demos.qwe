component MenuBarDemoLive() {
    state did = "nothing yet"
    state sidebar = true
    <div.demo-stack>
        <MenuBar id="menubar-demo" menus={[
            { label: "File", items: [
                { label: "New", shortcut: "Ctrl N" }, { label: "Open…", shortcut: "Ctrl O" }, { label: "Save", shortcut: "Ctrl S" },
                { divider: true }, { label: "Export as PDF", href: "#menu_bar" }, { divider: true }, { label: "Delete project", tone: "danger" },
            ] },
            { label: "Edit", items: [
                { label: "Undo", shortcut: "Ctrl Z", disabled: true }, { label: "Redo", shortcut: "Ctrl Y", disabled: true },
                { divider: true }, { label: "Cut", shortcut: "Ctrl X" }, { label: "Copy", shortcut: "Ctrl C" }, { label: "Paste", shortcut: "Ctrl V" },
            ] },
            { label: "View", items: [
                { label: "Sidebar", checked: sidebar }, { label: "Status bar", checked: false }, { divider: true }, { label: "Full screen", shortcut: "F11" },
            ] },
            { label: "Help", items: [{ label: "Documentation", href: "https://quillolang.org/docs/" }, { label: "About" }] },
        ]} on_select={(it) => {
            did = it.label
            if it.label == "Sidebar" { sidebar = !sidebar }
        }}/>
        <p.demo-note>Did: {did}</p>
    </div>
}

