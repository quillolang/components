component EditableTableDemoLive() {
    state log = []
    state total = 0
    <div.demo-stack>
        <EditableTable id="et-budget" label="Budget" can_add={true}
                       new_row={{ item: "", owner: "Ada", amount: 0, approved: false }}
                       rows={[
                           { item: "Laptops", owner: "Grace", amount: 7200, approved: true },
                           { item: "Conference", owner: "Ada", amount: 1850.5, approved: false },
                       ]}
                       columns={[
                           { key: "item", label: "Item", required: true },
                           { key: "owner", label: "Owner", type: "select", options: ["Ada", "Grace", "Linus"], required: true },
                           { key: "amount", label: "Amount", type: "number", min: 0 },
                           { key: "approved", label: "Approved", type: "checkbox" },
                           { key: "code", label: "Code", readonly: true },
                       ]}
                       on_cell={(i, k, v) => { log = take(push(log, `row ${i + 1}: ${k} = ${v}`) | reverse, 3) | reverse }}
                       on_change={(rows) => { total = sum(rows | map((r) => r.amount ?? 0)) }}/>
        <p.demo-note>{len(log) == 0 ? "Edit a cell." : join(log, " · ")} {total > 0 ? `Total: ${total}` : ""}</p>
    </div>
}

