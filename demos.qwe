let code_block_demo_source = `use "quillo-ui.qwe"

route GET / =
    <html>
        <head><style>{ui_css}</style></head>
        <body class="ui-root">
            <Button href="/start">Get started</Button>
        </body>
    </html>
`

let code_block_demo_config = `[server]
port = 8080
workers = 4    # one per core is plenty for most sites; the event loop does the rest, so raise it only when profiling says so

[database]
url = "sqlite://app.db"
`

view CodeBlockDemo() =
    <div.demo-stack>
        <CodeBlock filename="main.qwe" language="quillo" line_numbers={true} highlight="1,7" code={code_block_demo_source}/>
        <CodeBlock code="curl -O https://quillolang.org/components/quillo-ui.qwe"/>
        <CodeBlock filename="quillo.toml" wrap={true} line_numbers={true} start={10} highlight={[12]}
                   code={code_block_demo_config}/>
        <CodeBlock language="sql" copy={false} code={"SELECT id, title\n  FROM posts\n WHERE published\n ORDER BY created DESC;"}/>
    </div>

