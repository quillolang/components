                              { field: "rounded", label: "Rounded", type: "bool", value: true },
                              { field: "text", label: "Text", value: "Save" },
                          ] },
                          { label: "Meta", open: false, items: [
                              { field: "id", label: "Id", value: "btn-7", readonly: true },
                              { field: "created", label: "Created", type: "date", value: "2026-10-28" },
                          ] },
                      ]}/>
        <p.demo-note>on_change: {last}. on_values: width is {width}.</p>
