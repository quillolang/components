        {for f in splitter_demo_folders => <div style="padding: 6px 8px; border-radius: var(--ui-radius-sm)">{f}</div>}
    </nav>

view SplitterDemoMessage() =
    <article style="padding: 16px 20px">
        <h4 style="margin: 0 0 4px">Quarterly numbers</h4>
        <p style="margin: 0 0 12px; color: var(--ui-muted); font-size: 13px">From Ana Silva · 09:41</p>
        <p style="margin: 0">Hi all, the report is attached. Revenue is up 12% on last quarter, mostly from the new plans.</p>
    </article>

view SplitterDemoQuery() =
    <pre style="margin: 0; padding: 14px 16px; font: 13px/1.6 var(--ui-mono)">{"select name, total\nfrom orders\nwhere placed_at > now() - interval '7 days'\norder by total desc"}</pre>

view SplitterDemoResults() =
    <div style="padding: 12px 16px; font-size: 13px">
        {for [n, t] in [["Ana", "€1,240"], ["Bruno", "€980"], ["Chen", "€815"], ["Dara", "€640"], ["Eli", "€512"]] =>
            <div style="display: flex; justify-content: space-between; padding: 6px 0; border-bottom: 1px solid var(--ui-border)">
                <span>{n}</span><span>{t}</span>
            </div>}
    </div>

component SplitterDemoLive() {
    state pct = 35
    <div.demo-stack>
        <Splitter id="splitter-demo-live" label="Resize the preview" size={35} min={20} max={80} collapsible={true}
                  on_change={(p) => { pct = p }}
                  first={<div style="padding: 14px">Outline</div>}
                  second={<div style="padding: 14px">Preview</div>}/>
        <p.demo-note>The outline takes {pct == 0 ? "no room: it is folded away" : `${pct}% of the width`}.</p>
    </div>
}

view SplitterDemo() =
    <div.demo-stack>
        <Splitter id="splitter-demo-mail" label="Resize the folder list" size={30} min={20} max={60} collapsible={true}
                  first={<SplitterDemoFolders/>} second={<SplitterDemoMessage/>}/>
        <Splitter id="splitter-demo-sql" label="Resize the query editor" vertical={true} height="300px" size={40}
                  min={20} max={80} first={<SplitterDemoQuery/>} second={<SplitterDemoResults/>}/>
        <SplitterDemoLive/>
        <p.demo-note>Drag a divider, or focus it and use the arrow keys, Home and End; Enter or a double click folds a collapsible one.</p>
    </div>

