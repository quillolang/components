        <SegmentedControl name="sc-plan" label="Billing period" value={plan} on_change={(v) => { plan = v }}
                          options={[{ label: "Monthly", value: "m" }, { label: "Yearly", value: "y" }]}/>
        <p.demo-note>{plan == "y" ? "€96 a year: two months free." : "€10 a month."}</p>
    </div>
}

