// ---- demos/audit_log.qwe ----------------------------------------------------------------

let audit_log_demo_people = ["ada@example.com", "grace@example.com", "alan@example.com"]
let audit_log_demo_actions = ["user.login", "user.invite", "project.update", "api_key.create", "api_key.delete", "billing.change", "user.remove"]

// 30 entries, an hour and a quarter apart, made the same way on both sides.
let audit_log_demo_entries = for i in range(0, 30) => {
    who: audit_log_demo_people[(i * 2) % 3],
    action: audit_log_demo_actions[(i * 3) % 7],
    target: i % 5 == 0 ? null : ["Moon shot", "ci-deploy", "grace@example.com", "Team plan"][i % 4],
    at: date.from_ms(date.ms("2026-10-28T12:00:00Z") - i * 4500000),
    ip: i % 4 == 0 ? null : `81.2.69.${100 + i}`,
    detail: i % 7 == 3 ? "From the mobile app" : null,
}

component AuditLogDemoLive() {
    state matching = len(audit_log_demo_entries)
    <div.demo-stack>
        <AuditLog id="audit-log-demo" label="Audit log" zone="Europe/Lisbon" page_size={10} entries={audit_log_demo_entries}
                  on_filter={(n) => { matching = n }}/>
        <p.demo-note>on_filter: {matching} matching. Times are shown in Europe/Lisbon.</p>
    </div>
}

view AuditLogDemo() = <AuditLogDemoLive/>

ui_gallery = ui_gallery | push({ slug: "audit_log", name: "AuditLog", group: "Data",
    summary: "Who did what to what and when, newest first, filtered by person and action, searched, and paged.",
    tags: ["data", "table", "filter", "security", "admin", "interactive"], demo: AuditLogDemo })

