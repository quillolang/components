// ---- demos/virtual_list.qwe ----------------------------------------------------------------

let virtual_list_demo_first = ["Ada", "Grace", "Alan", "Katherine", "Linus", "Margaret", "Dennis", "Barbara", "Ken", "Frances", "Edsger", "Radia"]
let virtual_list_demo_last = ["Lovelace", "Hopper", "Turing", "Johnson", "Torvalds", "Hamilton", "Ritchie", "Liskov", "Thompson", "Allen", "Dijkstra", "Perlman", "Knuth"]
let virtual_list_demo_teams = ["Design", "Platform", "Growth", "Support", "Research", "Billing"]

// 10,000 people, made the same way on the server and in the browser.
fn virtual_list_demo_people(n: int) -> list =
    for i in range(0, n) => {
        let a = virtual_list_demo_first[i % 12]
        let b = virtual_list_demo_last[(i * 7) % 13]
        { title: `${a} ${b}`, subtitle: `${lower(a)}.${lower(b)}${i}@example.com`, meta: virtual_list_demo_teams[(i * 5) % 6],
          value: `u${i + 1}` }
    }

component VirtualListDemoLive() {
    state picked = null
    let people = virtual_list_demo_people(10000)
    <div.demo-stack>
        <VirtualList id="vl-people" label="People" items={people} height={340} name="person"
                     on_select={(v) => { picked = v }}/>
        <p.demo-note>10,000 people; {picked == null ? "none picked" : `picked ${picked}`}.</p>
    </div>
}

