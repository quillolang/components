    summary: "Widgets on a twelve-column grid, each spanning columns and rows (DashboardCell), stacking on a phone.",
    tags: ["dashboard", "layout", "grid", "no-js"],
    demo: DashboardGridDemo })

// ---- demos/data_grid.qwe ----------------------------------------------------------------

let data_grid_demo_customers = ["Northwind Traders", "Acme Corp", "Globex", "Initech", "Umbrella Health", "Wonka Foods"]
let data_grid_demo_statuses = ["Paid", "Open", "Overdue", "Draft"]

// 32 orders, made the same way on the server and in the browser.
let data_grid_demo_orders = for i in range(0, 32) => {
    id: 2000 + i,
    number: `#${2000 + i}`,
    customer: data_grid_demo_customers[(i * 5) % 6],
    status: data_grid_demo_statuses[(i * 7) % 4],
    placed: date.add_days("2026-01-05", (i * 11) % 270),
    total: ((i * 7919) % 90000) / 100 + 20,
}

component DataGridDemoLive() {
    state picked = []
    <div.demo-stack>
        <DataGrid id="data-grid-demo-orders" label="Orders" rows={data_grid_demo_orders} search={true} page_size={10} selectable={true}
                  name="order" order_by="placed" descending={true}
                  columns={[
                      { key: "number", label: "Order", sortable: true },
                      { key: "customer", label: "Customer", sortable: true, filter: true },
                      { key: "status", label: "Status", filter: true },
                      { key: "placed", label: "Placed", format: "date", sortable: true },
                      { key: "total", label: "Total", format: "money", sortable: true },
                  ]}
                  on_select={(ids) => { picked = ids }}/>
        <p.demo-note>on_select: {len(picked) == 0 ? "nothing" : join(picked, ", ")}</p>
    </div>
}

view DataGridDemo() =
    <div.demo-stack>
        <DataGridDemoLive/>
        <DataGrid id="data-grid-demo-small" label="Open invoices" zebra={true} empty="No open invoice."
                  rows={data_grid_demo_orders | filter((o) => o.status == "Open")}
                  columns={[{ key: "number", label: "Order" }, { key: "customer", label: "Customer", sortable: true }, { key: "total", label: "Total", format: "money", sortable: true }]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "data_grid", name: "DataGrid", group: "Data",
    summary: "Sort, search, filter by a column's values, pick rows and page through them, in one table.",
    tags: ["data", "table", "sort", "filter", "search", "interactive"], demo: DataGridDemo })

