// ---- demos/ohlc_chart.qwe ----------------------------------------------------------------

// Prices from a seeded random walk (Park–Miller), the same on every render: `count`
// candles from the day `from` on, skipping weekends, daily or hourly (10:00 to 16:00),
// rounded to `places` decimals.
fn ohlc_chart_demo_walk(seed: int, count: int, start: num, from: str, hourly: bool = false, places: int = 2) -> list {
    let s = seed
    let rnd = () => {
        s = s * 16807 % 2147483647
        s / 2147483647
    }
    let scale = pow(10, places)
    let cut = (v) => round(v * scale) / scale
    let p = start
    let day = from
    let hour = 10
    let out = []
    while len(out) < count {
        if date.weekday(day) <= 5 {
            let open = cut(p * (1 + (rnd() - 0.5) * 0.006))
            let close = cut(open * (1 + (rnd() - 0.485) * (hourly ? 0.012 : 0.035)))
            let high = cut(max([open, close]) * (1 + rnd() * 0.01))
            let low = cut(min([open, close]) * (1 - rnd() * 0.01))
            let volume = round((hourly ? 90000 : 900000) * (1 + rnd() * 1.5 + abs(close - open) * 30 / open))
            out = out | push({ time: hourly ? `${day}T${hour < 10 ? "0" : ""}${hour}:00:00Z` : day, open, high, low, close, volume })
            p = close
        }
        if hourly && hour < 16 && date.weekday(day) <= 5 {
            hour += 1
        } else {
            hour = 10
            day = date.add_days(day, 1)
        }
    }
    out
}

let ohlc_chart_demo_daily = ohlc_chart_demo_walk(11, 90, 74.2, "2026-05-01")
let ohlc_chart_demo_fx = ohlc_chart_demo_walk(5, 42, 1.0842, "2026-10-12", true, 4) | map((c) => { ...c, volume: null })

view OhlcChartDemo() =
    <div.demo-stack>
        <div id="ohlc_chart-demo-daily">
            <OhlcChart label="Northwind, daily" show_label={true} candles={ohlc_chart_demo_daily} sma={[10]} prefix="$"/>
        </div>
        <div id="ohlc_chart-demo-fx">
            <OhlcChart label="EUR/USD, hourly" show_label={true} candles={ohlc_chart_demo_fx} volume={false}
                       decimals={4} height={200}/>
        </div>
        <p.demo-note>Hover a bar for its open (the tick on the left), high, low and close (the tick on the right).</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "ohlc_chart", name: "OhlcChart", group: "Charts",
