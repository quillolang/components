view FootnoteDemo() =
    <div.demo-stack id="footnote-demo">
        <p style="margin: 0; font: 15px/1.6 var(--ui-font)">
            Pages render on the server<Footnote n={1}/> and their components resume in the browser<Footnote n={2}/>, so a
            page shows at once. Forms work without any script<Footnote n={3}/>.
        </p>
        <FootnoteList notes={[
            "Every route, on every request; cached views aside.",
            <span>Only once a component is <em>reached</em>: hovered, touched or focused.</span>,
            "Every field is a real input with a name, so a plain form posts it.",
        ]}/>
    </div>

