component ComboboxDemoLive() {
    state lang = null
    <div.demo-stack>
        <Combobox id="cb-lang" name="lang" label="Favourite language" placeholder="Start typing"
                  options={["C", "Elixir", "Go", "Haskell", "JavaScript", "Python", "Quillo", "Ruby", "Rust", "Zig"]}
                  on_change={(v) => { lang = v }}/>
        <p.demo-note>{lang == null ? "None picked." : `Picked ${lang}.`}</p>
    </div>
}

let combobox_demo_cities = ["Amsterdam", "Athens", "Barcelona", "Berlin", "Dublin", "Kyoto", "Lisbon", "Lyon",
                            "Madrid", "Porto", "Prague", "Rome", "Vienna"]

// A search on the server, slowed a little so that "Searching…" shows.
server fn combobox_demo_search(text: str) -> list with time {
    sleep(300)
    combobox_demo_cities | filter((c) => starts_with(lower(c), lower(trim(text))))
}

// Options found as one types: each search is numbered, and an answer to an older
// one, come late, is dropped.
component ComboboxDemoRemote() {
    state found = []
    state busy = false
    state asked = 0
    state city = null
    <div.demo-stack>
        <Combobox id="cb-city" name="city" label="City" placeholder="Two letters or more" remote={true} min_chars={2}
                  loading={busy} options={found}
                  on_input={(t) => {
                      asked += 1
                      let mine = asked
                      busy = true
                      let r = combobox_demo_search(t)
                      if mine == asked {
                          found = r
                          busy = false
                      }
                  }}
                  on_change={(v) => { city = v }}/>
        <p.demo-note>{city == null ? "No city yet." : `Going to ${city}.`}</p>
    </div>
}

view ComboboxDemo() =
    <div.demo-stack.demo-narrow>
        <Combobox id="cb-country" name="country" label="Country" value="PT" options={combobox_demo_countries}
                  hint="Type to filter; the arrow keys and Enter pick." required={true}/>
        <ComboboxDemoLive/>
        <ComboboxDemoRemote/>
        <Combobox id="cb-small" label="Small" size="sm" placeholder="Disabled" disabled={true}
                  options={["One", "Two"]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "combobox", name: "Combobox", group: "Forms",
    summary: "A text box that filters a list of options as you type, or asks for them (a server, a map service), with the arrow keys, Enter and Escape.",
    tags: ["forms", "input", "select", "search", "interactive"],
    demo: ComboboxDemo })

