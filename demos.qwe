// ---- demos/quick_view.qwe ----------------------------------------------------------------

let quick_view_demo_items = [
    { name: "Linen shirt", price: "€49", text: "Loose fit, washed linen, mother-of-pearl buttons.", hue: "accent" },
    { name: "Wool scarf", price: "€35", text: "Merino, knitted in Porto, long enough to wrap twice.", hue: "success" },
    { name: "Canvas tote", price: "€22", text: "Heavy cotton canvas with a leather strap.", hue: "warning" },
]

// A placeholder picture: a tinted square with the item's initial, as an SVG data URL.
fn quick_view_demo_img(name: str) =
    `data:image/svg+xml,${url_encode(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400"><rect width="400" height="400" fill="#e8e6f7"/><text x="200" y="240" font-size="140" text-anchor="middle" fill="#5b4bdb" font-family="sans-serif">${slice(name, 0, 1)}</text></svg>`)}`

component QuickViewDemoLive() {
    state cart = []
    <div.demo-stack>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 14px">
            {for it in quick_view_demo_items => <QuickView key={it.name} title={it.name} image={quick_view_demo_img(it.name)}
                    alt={`${it.name}, a placeholder picture`} meta={it.price} text={it.text} href="#quick_view"
                    action="Add to cart" on_action={() => { cart = cart | push(it.name) }}>
                <div style="overflow: hidden; border: 1px solid var(--ui-border); border-radius: var(--ui-radius); background: var(--ui-surface)">
                    <img src={quick_view_demo_img(it.name)} alt="" style="display: block; width: 100%; aspect-ratio: 1"/>
                    <div style="padding: 10px 12px"><strong>{it.name}</strong><div style="color: var(--ui-muted)">{it.price}</div></div>
                </div>
            </QuickView>}
        </div>
        <p.demo-note>{len(cart) == 0 ? "The cart is empty." : `In the cart: ${join(cart, ", ")}.`}</p>
    </div>
}

view QuickViewDemo() = <QuickViewDemoLive/>

ui_gallery = ui_gallery | push({ slug: "quick_view", name: "QuickView", group: "Overlays",
    summary: "A Quick view button on a card that opens a preview of the item, its picture, price, text and actions, in a dialog.",
