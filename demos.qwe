    tags: ["chat", "social", "list", "no-js"],
    demo: ChatThreadDemo })

// ---- demos/chat_widget.qwe ----------------------------------------------------------------

// The other side of the chat: a server that answers after a moment.
server fn chat_widget_demo_reply(text: str) -> str with time {
    sleep(400)
    contains(lower(text), "price") ? "Plans start at €9 a month; the first two weeks are free." : `Thanks! You said: “${text}”. Someone will be with you shortly.`
}

component ChatWidgetDemoLive() {
    <div.demo-stack>
        <div style="position: relative; height: 560px; border: 1px dashed var(--ui-border); border-radius: var(--ui-radius)">
            <ChatWidget title="Support" status="We reply in a few minutes" inline={true}
                        messages={[{ text: "Hi! How can we help?", from: "Mia" }]}
                        on_send={(text) => chat_widget_demo_reply(text)}/>
        </div>
        <p.demo-note>Inline here, in the corner of the box; without inline it sits in the window's corner.</p>
    </div>
}

view ChatWidgetDemo() = <ChatWidgetDemoLive/>

ui_gallery = ui_gallery | push({ slug: "chat_widget", name: "ChatWidget", group: "Overlays",
