// ---- demos/realtime_chart.qwe ----------------------------------------------------------------

// The next value of a random walk between 0 and 100, from a seeded generator (the
// same numbers on every run, and in the browser, whose numbers are exact under 2^53):
// { seed, value }.
fn realtime_chart_demo_step(seed: int, value: num) -> map {
    let s = (seed * 48271) % 2147483647
    let moved = round((value + (s / 2147483647 - 0.5) * 12) * 10) / 10
    { seed: s, value: moved < 5 ? 5 : (moved > 95 ? 95 : moved) }
}

// The first n values of the walk from `seed`.
fn realtime_chart_demo_start(seed: int, n: int) -> map {
    let at = { seed: seed, value: 40 }
    let out = []
    while len(out) < n {
        at = realtime_chart_demo_step(at.seed, at.value)
        out = push(out, at.value)
    }
    { seed: at.seed, values: out }
}

component RealtimeChartDemoLive() {
    state walk = realtime_chart_demo_start(7, 40)
    state ticks = 40
    state paused = false
    every(1000, () => {
        let next = realtime_chart_demo_step(walk.seed, walk.values[-1])
        walk = { seed: next.seed, values: drop(walk.values, len(walk.values) >= 120 ? 1 : 0) + [next.value] }
        ticks += 1
    })
    <div.demo-stack>
        <RealtimeChart label="CPU load" values={walk.values} window={60} suffix="%" low={0} high={100} decimals={1}
                       on_pause={(p) => { paused = p }}/>
        <p.demo-note>{ticks} values received{paused ? ", the chart is paused" : ""}.</p>
    </div>
}

view RealtimeChartDemo() = <RealtimeChartDemoLive/>

ui_gallery = ui_gallery | push({ slug: "realtime_chart", name: "RealtimeChart", group: "Charts",
    summary: "A live line that scrolls as values come, a window of the last N, with the latest value, its change and a pause.",
    tags: ["chart", "data", "dashboard", "interactive"],
    demo: RealtimeChartDemo })

