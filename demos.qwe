view ClusterDemo() =
    <div.demo-stack>
        <Cluster gap="sm" class="cluster-demo-tags">
            {for t in ["Quillo", "layout", "flex", "wrapping", "tags", "chips", "keywords", "and", "more", "of", "them",
                       "until", "the", "row", "runs", "out", "of", "room", "and", "goes", "on"] => <Tag>{t}</Tag>}
        </Cluster>
        <Cluster justify="end" class="cluster-demo-actions">
            <Button variant="ghost">Cancel</Button>
            <Button>Save</Button>
        </Cluster>
