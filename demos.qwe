component NoticesDemoLive() {
    state answer = "Nothing asked yet."
    <div.demo-stack>
        <div.demo-row>
            <Button variant="soft" tone="neutral" on_click={() => notify("Draft saved.")}>Neutral</Button>
            <Button variant="soft" on_click={() => notify("Your invite is on its way.", { title: "Sent", tone: "success" })}>Success</Button>
            <Button variant="soft" on_click={() => notify("Your card expires this month.", { title: "Heads up", tone: "warning", seconds: 6 })}>Warning</Button>
            <Button variant="soft" tone="danger" on_click={() => notify("We could not reach the server.", { title: "Offline", tone: "danger" })}>Danger</Button>
            <Button variant="soft" on_click={() => notify("A new version is out.", { tone: "info" })}>Info</Button>
        </div>
        <div.demo-row>
            <Button variant="outline" on_click={() => {
                answer = ask("Publish these changes to the site?", { title: "Publish", ok: "Publish" }) ? "You said publish." : "You said not now."
            }}>Ask</Button>
            <Button variant="outline" tone="danger" on_click={() => {
                let yes = ask("This removes the project and its 214 files. It cannot be undone.",
                              { title: "Delete project?", ok: "Delete", cancel: "Keep it", tone: "danger" })
                answer = yes ? "Deleted (not really)." : "Kept."
            }}>Ask (danger)</Button>
            <span.demo-note>{answer}</span>
        </div>
    </div>
}

