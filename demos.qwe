view TableOfContentsDemo() =
    <div style="display: flex; flex-wrap: wrap; gap: 24px; align-items: flex-start">
        <div style="flex: 1 1 180px; max-width: 240px">
            <TableOfContents id="toc-demo-title" items={table_of_contents_demo_items} scroller="toc-demo-article"/>
        </div>
        <article id="toc-demo-article" tabindex="0" aria-label="Getting started"
                 style="flex: 3 1 300px; height: 320px; overflow: auto; padding: 0 18px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius)">
            {for it in table_of_contents_demo_items => [
                it.level == 2 ? <h2 id={it.id} style="font-size: 18px; margin: 20px 0 8px">{it.text}</h2>
                              : <h3 id={it.id} style="font-size: 15px; margin: 16px 0 6px">{it.text}</h3>,
                <p style="margin: 0 0 12px">{it.text}: a few paragraphs of the guide go here, long enough that the
                    article scrolls and the list beside it follows where you are.</p>,
                <p style="margin: 0 0 12px; color: var(--ui-muted)">More about {lower(it.text)}, with examples and notes.</p>
            ]}
            <div style="height: 120px"></div>
        </article>
    </div>

