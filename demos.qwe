// ---- demos/month_calendar.qwe ----------------------------------------------------------------

// A host's December: prices under each day (Friday and Saturday dearer), two
// nights booked, Christmas closed, and actions on the days picked.
fn month_calendar_demo_prices(closed: list, price: map) -> map {
    let from = month_calendar_days(2026, 12, 1)
    range(31) | reduce({}, (m, i) => {
        let iso = month_calendar_iso(from + i)
        set(m, iso, contains(closed, iso) ? "closed" : get(price, iso) ?? (month_calendar_weekday(from + i) >= 5 ? "€140" : "€95"))
    })
}

component MonthCalendarDemoLive() {
    state picked = []
    state closed = ["2026-12-24", "2026-12-25"]
    state price = {}
    state month = "2026-12"
    let days = [{ day: "2026-12-18", state: "booked", note: "Ana" }, { day: "2026-12-19", state: "booked", note: "Ana" },
                { day: "2026-12-11", state: "held", note: "Lee" }]
        + (closed | map((d) => { day: d, state: "closed" }))
    <div.demo-stack>
        <MonthCalendar month={month} today="2026-12-03" days={days} labels={month_calendar_demo_prices(closed, price)}
                       selected={picked} label="Nights at the river flat"
                       on_select={(d) => { picked = d }} on_month={(m) => { month = m }}/>
        <div.demo-row>
            <button type="button" class="month-calendar-demo-close" disabled={len(picked) == 0}
                    @click={() => { closed = unique(closed + picked); picked = [] }}>Close</button>
            <button type="button" class="month-calendar-demo-open" disabled={len(picked) == 0}
                    @click={() => { closed = closed | filter((d) => !contains(picked, d)); picked = [] }}>Open</button>
            <button type="button" class="month-calendar-demo-price" disabled={len(picked) == 0}
                    @click={() => { price = picked | reduce(price, (m, d) => set(m, d, "€200")); picked = [] }}>€200 a night</button>
            <p.demo-note>Shown: {month}.</p>
        </div>
    </div>
}

view MonthCalendarDemo() =
    <div.demo-stack>
        <MonthCalendarDemoLive/>
        <p.demo-note>Click a day, shift-click another for every day between; the arrow keys move, PageUp and PageDown turn.</p>
    </div>

