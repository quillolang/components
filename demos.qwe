// ---- demos/card_input.qwe ----------------------------------------------------------------

component CardInputDemoLive() {
    state card = null
    <div.demo-stack>
        <CardInput name="ci-demo" label="Pay with a card" today="2026-11-20"
                   hint="A demo: 4242 4242 4242 4242 is a good number, 4242 4242 4242 4241 has a typo."
                   on_change={(c) => { card = c }}/>
        <p.demo-note>{card == null ? "Nothing typed." : card.complete ? `Ready: ${card.brand ?? "card"} ending ${slice(card.number, len(card.number) - 4, len(card.number))}, ${card.expiry}.` : "Not complete yet."}</p>
    </div>
}

view CardInputDemo() =
    <div.demo-stack>
        <CardInputDemoLive/>
        <CardInput name="ci-demo-off" label="Disabled" disabled={true}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "card_input", name: "CardInput", group: "Forms",
    summary: "A payment card as it is typed: the number grouped, the brand, MM/YY and the code, with typos said.",
    demo: CardInputDemo })

// ---- demos/carousel.qwe ----------------------------------------------------------------

let carousel_demo_stories = [
    { title: "Spring sale", text: "Up to 40% off outdoor gear, this week only.", tone: "accent" },
    { title: "New arrivals", text: "Lightweight jackets for the shoulder season.", tone: "info" },
    { title: "Free returns", text: "Changed your mind? Send it back within 60 days.", tone: "success" },
    { title: "Gift cards", text: "Let them pick: from €10, delivered by email.", tone: "warning" }
]

view CarouselDemoCard(title: str, text: str, tone: str) =
    <div style={`display: grid; align-content: center; min-height: 200px; padding: 28px 64px; background: linear-gradient(135deg, var(--ui-${tone}-soft), var(--ui-subtle)); border: 1px solid var(--ui-border); border-radius: var(--ui-radius)`}>
        <h4 style="margin: 0 0 6px; font-size: 22px">{title}</h4>
        <p style="margin: 0; color: var(--ui-muted)">{text}</p>
    </div>

view CarouselDemo() =
    <div.demo-stack style="gap: 28px">
        <Carousel label="Featured" id="carousel-demo-featured">
            {for s in carousel_demo_stories => <CarouselSlide label={s.title}>
                <CarouselDemoCard title={s.title} text={s.text} tone={s.tone}/>
            </CarouselSlide>}
        </Carousel>
        <Carousel label="Testimonials" id="carousel-demo-quotes" autoplay={3} loop={true}>
            {for [q, who] in [["Setup took five minutes.", "Ana, Lisbon"], ["The support team answered on a Sunday.", "Ben, Leeds"],
                              ["Our checkout is twice as fast.", "Chen, Taipei"]] =>
                <CarouselSlide label={who}>
                    <figure style="margin: 0; padding: 24px 64px; text-align: center; background: var(--ui-subtle); border-radius: var(--ui-radius)">
                        <blockquote style="margin: 0 0 8px; font-size: 18px">“{q}”</blockquote>
                        <figcaption style="color: var(--ui-muted)">{who}</figcaption>
                    </figure>
                </CarouselSlide>}
        </Carousel>
        <p.demo-note>The second moves by itself every 3 seconds; it stops while the pointer or the focus is on it.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "carousel", name: "Carousel", group: "Layout",
    summary: "Slides one at a time: buttons, dots, swiping, the keyboard, and optional autoplay that knows when to stop.",
    demo: CarouselDemo })

// ---- demos/chat_thread.qwe ----------------------------------------------------------------

let chat_thread_demo_start = [
    { id: 1, from: "Ana Silva", text: "Hi! Did the new build go out?", time: "Yesterday 17:02", day: "Yesterday" },
    { id: 2, from: "Me", mine: true, text: "Not yet: one test is still failing on Windows.", time: "Yesterday 17:05", day: "Yesterday" },
    { id: 3, from: "Ana Silva", text: "Ok, no rush.", time: "Yesterday 17:06", day: "Yesterday" },
    { id: 4, from: "Ana Silva", text: "Morning! Any luck with that test?", time: "09:12", day: "Today" },
    { id: 5, from: "Ana Silva", text: "I can pair on it after lunch\nif that helps.", time: "09:13", day: "Today" },
    { id: 6, from: "Me", mine: true, text: "Fixed it: a path with a space in it.", time: "09:30", day: "Today" },
    { id: 7, from: "Me", mine: true, text: "Shipping now 🚀", time: "09:30", day: "Today" },
    { id: 8, from: "Ben Okafor", text: "Nice one. I'll tell the customers.", time: "09:41", day: "Today" }
]

component ChatThreadDemoLive() {
    state messages = chat_thread_demo_start
    state waiting = false
    if waiting {
        every(1500, () => {
            messages = messages | push({ id: len(messages) + 1, from: "Ana Silva", text: "Got it, thanks!", time: "now", day: "Today" })
            waiting = false
        })
    }
    <ChatThread id="chat-demo-live" messages={messages} typing={waiting ? "Ana Silva" : null} height="340px"
                on_send={(text) => {
                    messages = messages | push({ id: len(messages) + 1, from: "Me", mine: true, text, time: "now", day: "Today" })
                    waiting = true
                }}/>
}

view ChatThreadDemo() =
    <div.demo-stack>
        <ChatThreadDemoLive/>
        <p.demo-note>Enter sends, Shift+Enter starts a new line; Ana answers. Below, a thread whose box posts a form:</p>
        <ChatThread id="chat-demo-form" height="180px" method="get" action="#chat_thread" label="Support ticket"
                    messages={[{ from: "Support", text: "Thanks for writing in. Could you send us your order number?", time: "Mon 14:20", day: "Monday" },
                               { from: "You", mine: true, text: "It's #1042.", time: "Mon 14:31", day: "Monday" }]}>
            <input type="hidden" name="ticket" value="77"/>
        </ChatThread>
    </div>

ui_gallery = ui_gallery | push({ slug: "chat_thread", name: "ChatThread", group: "Data",
    summary: "A conversation: grouped messages with avatars, days, a typing indicator, and a box where Enter sends.",
    demo: ChatThreadDemo })

