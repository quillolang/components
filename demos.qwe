let match_highlight_demo_text = "Quillo renders components on the server, then resumes them in the browser from the state the server sent, so a page shows at once and reacts as soon as it is touched."

component MatchHighlightDemoLive() {
    state q = "server state"
    <div.demo-stack>
        <SearchInput name="mh-q" label="Find in the text" value={q} on_input={(t) => { q = t }}/>
        <p.demo-note.mh-demo-out><MatchHighlight text={match_highlight_demo_text} query={q}/></p>
    </div>
}

view MatchHighlightDemo() =
    <div.demo-stack>
        <ul.demo-stack.mh-demo-list style="margin: 0; padding-left: 18px">
            <li><MatchHighlight text="Deploying a Quillo app to Fly.io" query="quillo deploy"/></li>
            <li><MatchHighlight text="Toronto, Ontario" query="to"/></li>
            <li><MatchHighlight text="No match here" query="zebra"/></li>
        </ul>
        <MatchHighlightDemoLive/>
    </div>

