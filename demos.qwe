// ---- demos/media_card.qwe ----------------------------------------------------------------

// A room drawn in SVG, so the demo needs no image files.
fn media_card_demo_pic(wall: str, floor: str) -> str {
    let svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 360" width="640" height="360">`
        + `<rect width="640" height="360" fill="${wall}"/><rect y="250" width="640" height="110" fill="${floor}"/>`
        + `<rect x="80" y="70" width="160" height="120" rx="6" fill="#fff" opacity=".85"/>`
        + `<rect x="330" y="150" width="230" height="100" rx="10" fill="#fff" opacity=".6"/></svg>`
    `data:image/svg+xml,${url_encode(svg)}`
}

view MediaCardDemo() =
    <div.demo-stack>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px" id="media-card-demo-grid">
            <MediaCard src={media_card_demo_pic("#e8dcc8", "#8a6d4b")} alt="" meta="Lisbon · €95 a night" title="A kitchen for four"
                       text="Light, quiet, two minutes from the metro." href="https://example.com/stays/12"/>
            <MediaCard src={media_card_demo_pic("#d6e6f5", "#4b6a8a")} alt="" meta="Porto · €70 a night" title="Studio by the river"
                       text="A desk, a view, and the best coffee on the street." ratio="4/3">
                <button type="button" class="ui-btn ui-btn-solid ui-btn-sm">Book</button>
                <button type="button" class="ui-btn ui-btn-ghost ui-btn-sm">Save</button>
            </MediaCard>
        </div>
        <MediaCard layout="side" src={media_card_demo_pic("#f3e0e8", "#8a4b6a")} alt="" meta="Talk · 32 min" title="Why views come first"
                   text="A talk from QuilloConf on building interfaces the browser already knows how to run." width="220px">
            <button type="button" class="ui-btn ui-btn-outline ui-btn-sm">Watch</button>
        </MediaCard>
        <MediaCard layout="side-right" title="Sales this quarter" text="The media slot takes any HTML: here, a chart drawn in SVG." width="180px"
                   media={<svg viewBox="0 0 180 120" style="display: block; width: 100%; height: 100%" aria-label="Sales by month">
                       <rect x="12" y="60" width="28" height="50" fill="var(--ui-accent)"/><rect x="52" y="35" width="28" height="75" fill="var(--ui-accent)"/>
                       <rect x="92" y="50" width="28" height="60" fill="var(--ui-accent)"/><rect x="132" y="15" width="28" height="95" fill="var(--ui-accent)"/>
                   </svg>}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "media_card", name: "MediaCard", group: "Media",
    summary: "A card with a picture (or any media) on top or at the side, then a meta line, title, text and actions.",
    tags: ["card", "media", "image", "layout", "no-js"], demo: MediaCardDemo })

