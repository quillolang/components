// ---- demos/virtual_table.qwe ----------------------------------------------------------------

let virtual_table_demo_customers = ["Acme Corp", "Globex", "Initech", "Northwind Traders", "Pied Piper", "Soylent",
    "Stark Industries", "Tyrell Corp", "Umbrella Health", "Vandelay Imports", "Wayne Enterprises", "Wonka Foods", "Cyberdyne"]
let virtual_table_demo_cities = ["Berlin", "Lisbon", "London", "Madrid", "New York", "Oslo", "Paris", "São Paulo", "Tokyo", "Toronto"]
let virtual_table_demo_status = ["Paid", "Open", "Overdue", "Draft", "Refunded"]

// 10,000 orders, made the same way on the server and in the browser.
fn virtual_table_demo_orders(n: int) -> list =
    for i in range(0, n) => {
        let day = (i * 37) % 365
        let month = floor(day / 31) + 1
        {
            number: `ORD-${10001 + i}`,
            customer: virtual_table_demo_customers[(i * 7) % 13],
            city: virtual_table_demo_cities[(i * 3) % 10],
            placed: `2026-${month < 10 ? "0" : ""}${month}-${day % 28 + 1 < 10 ? "0" : ""}${day % 28 + 1}`,
            status: virtual_table_demo_status[(i * 11) % 5],
            total: ((i * 7919) % 250000) / 100 + 5,
        }
    }

component VirtualTableDemoLive() {
    state last = null
    let orders = virtual_table_demo_orders(10000)
    <div.demo-stack>
        <VirtualTable id="vt-orders" label="Orders" search={true} rows={orders} height={380}
                      on_select={(r) => { last = r.number }}
                      columns={[
                          { key: "number", label: "Order", sortable: true, width: "120px" },
                          { key: "customer", label: "Customer", sortable: true },
                          { key: "city", label: "City", sortable: true, width: "120px" },
                          { key: "placed", label: "Placed", sortable: true, width: "120px" },
                          { key: "status", label: "Status", sortable: true, width: "116px" },
                          { key: "total", label: "Total", format: "number", sortable: true, width: "110px" },
                      ]}/>
        <p.demo-note>{last == null ? "Click a row, or press Enter on one." : `Opened ${last}.`}</p>
    </div>
}

view VirtualTableDemo() = <VirtualTableDemoLive/>

ui_gallery = ui_gallery | push({ slug: "virtual_table", name: "VirtualTable", group: "Data",
    summary: "A table of thousands of rows that draws only those in view, sorted and searched across all of them.",
    demo: VirtualTableDemo })
