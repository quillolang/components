let log_viewer_demo_text = [
    "09:00:01 INFO  Server started on :8080",
    "09:00:01 DEBUG Loaded 42 routes in 3 ms",
    "09:00:04 INFO  GET /health 200 0.4ms",
    "09:00:09 WARN  Slow query: select * from orders where status = 'open' (812 ms)",
    "09:00:12 INFO  POST /api/orders 201 18ms",
    "09:00:13 ERROR Payment provider timed out after 10 s (order 1041)",
    "09:00:13 INFO  Retrying payment for order 1041 in 2 s",
    "09:00:15 INFO  Payment for order 1041 accepted",
    "    at charge (billing.qwe:88)",
    "09:00:20 DEBUG Cache hit ratio 0.93",
    "09:00:31 WARN  Disk 81% full on /var/data",
    "09:00:40 INFO  GET /api/orders?page=2 200 9ms",
]

component LogViewerDemoLive() {
    state extra = []
    state n = 0
    let lines = log_viewer_demo_text + extra
    <div.demo-stack>
        <LogViewer id="log-viewer-demo" label="API log" lines={lines} height="260px"/>
        <div.demo-row>
            <Button id="log-viewer-demo-add" variant="soft" size="sm" on_click={() => {
                n += 1
                extra = push(extra, { time: `09:01:${n < 10 ? "0" : ""}${n}`, level: n % 3 == 0 ? "error" : "info", message: `Tick ${n}: worker ${n % 4} is alive`, source: "cron" })
            }}>Add a line</Button>
            <p.demo-note>Lines added at the end are followed while the box is scrolled to the bottom.</p>
        </div>
    </div>
