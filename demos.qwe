// ---- demos/filter_tabs.qwe ----------------------------------------------------------------

let filter_tabs_demo_issues = [
    { title: "Login fails on Safari", status: "open", kind: "bug" }, { title: "Dark mode for charts", status: "open", kind: "feature" },
    { title: "Typo in the install guide", status: "closed", kind: "bug" }, { title: "Export to CSV", status: "closed", kind: "feature" },
    { title: "Slow search on large lists", status: "open", kind: "bug" }, { title: "Keyboard shortcuts page", status: "closed", kind: "feature" }
]

component FilterTabsDemoLive() {
    state status = "all"
    let shown = filter_tabs_demo_issues | filter((i) => status == "all" || i.status == status)
    let n = (s: str) => count(filter_tabs_demo_issues, (i) => s == "all" || i.status == s)
    <div.demo-stack>
        <FilterTabs name="status" controls="filter-tabs-demo-list" selected={status} on_change={(k) => { status = k }} tabs={[
            { key: "all", label: "All", count: n("all") }, { key: "open", label: "Open", count: n("open") },
            { key: "closed", label: "Closed", count: n("closed") }, { key: "archived", label: "Archived", count: 0, disabled: true }
        ]}/>
        <ul id="filter-tabs-demo-list" style="margin: 0; padding-left: 20px">
            {for i in shown => <li key={i.title}>{i.title} <span.demo-note style="display: inline">({i.status})</span></li>}
        </ul>
        <p.demo-note>Showing {len(shown)} of {len(filter_tabs_demo_issues)}; the hidden input says "{status}".</p>
    </div>
}

component FilterTabsDemoLine() {
    state kind = "bug"
    <div.demo-stack>
        <FilterTabs variant="line" size="sm" label="Kind" selected={kind} on_change={(k) => { kind = k }} tabs={[
            { key: "bug", label: "Bugs", count: 3 }, { key: "feature", label: "Features", count: 3 }, { key: "question", label: "Questions" }
        ]}/>
        <p.demo-note>Kind: {kind}</p>
    </div>
}

view FilterTabsDemo() =
    <div.demo-stack style="gap: 28px">
        <FilterTabsDemoLive/>
        <FilterTabsDemoLine/>
    </div>

