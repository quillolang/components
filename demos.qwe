// A load from the server, slowed a little so that the spinner shows.
server fn load_more_button_demo_wait() with time = sleep(400)

component LoadMoreButtonDemoLive() {
    state shown = 5
    state busy = false
    let total = 17
    <div.demo-stack>
        <ul style="margin: 0; padding-left: 20px; columns: 2">
            {for i in range(1, shown + 1) => <li key={i}>Item {i}</li>}
        </ul>
        <LoadMoreButton id="load-more-demo-live" remaining={total - shown} batch={6} loading={busy}
                        on_click={() => {
                            busy = true
                            load_more_button_demo_wait()
                            shown = min([total, shown + 6])
                            busy = false
                        }}/>
    </div>
}

view LoadMoreButtonDemo() =
    <div.demo-stack>
        <LoadMoreButtonDemoLive/>
