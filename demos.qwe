// ---- demos/stream_graph.qwe ----------------------------------------------------------------

let stream_graph_demo_weeks = for i in range(20) => `W${i + 1}`
// A genre's weekly plays: a level, a swell that peaks at week `peak`, and a small ripple.
fn stream_graph_demo_plays(level: num, swell: num, peak: num, width: num) -> list =
    for i in range(20) => round(level + swell * math.exp(-(i - peak) * (i - peak) / (2 * width * width)) + 6 * math.sin(i * 1.3 + level))

view StreamGraphDemo() =
    <div.demo-stack>
        <StreamGraph label="Plays by genre, thousands" show_label={true} labels={stream_graph_demo_weeks} suffix="k"
                     series={[{ name: "Pop", values: stream_graph_demo_plays(60, 50, 6, 3) },
                              { name: "Rock", values: stream_graph_demo_plays(45, 20, 14, 4) },
                              { name: "Hip-hop", values: stream_graph_demo_plays(40, 70, 11, 2.5) },
                              { name: "Jazz", values: stream_graph_demo_plays(15, 10, 3, 3) },
                              { name: "Electronic", values: stream_graph_demo_plays(25, 45, 17, 2) }]}/>
        <StreamGraph label="Visits by source" show_label={true} offset="wiggle" height={180}
                     labels={["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]}
                     series={[{ name: "Search", values: [4200, 4500, 4400, 4700, 4100, 2600, 2400] },
                              { name: "Direct", values: [2100, 2300, 2200, 2500, 2000, 1500, 1400] },
                              { name: "Social", values: [900, 1100, 1500, 2600, 3100, 3600, 2800] },
                              { name: "Email", values: [1800, 300, 250, 1700, 200, 100, 120] }]}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "stream_graph", name: "StreamGraph", group: "Charts",
    summary: "Series stacked as flowing layers around a centre line, or wiggled flat, with every layer's value at a moment on hover.",
    tags: ["chart", "data", "no-js"],
    demo: StreamGraphDemo })

