let combobox_demo_countries = [
    { label: "Argentina", value: "AR" }, { label: "Australia", value: "AU" }, { label: "Austria", value: "AT" },
    { label: "Belgium", value: "BE" }, { label: "Brazil", value: "BR" }, { label: "Canada", value: "CA" },
    { label: "Chile", value: "CL" }, { label: "Denmark", value: "DK" }, { label: "Finland", value: "FI" },
    { label: "France", value: "FR" }, { label: "Germany", value: "DE" }, { label: "Greece", value: "GR" },
    { label: "Iceland", value: "IS" }, { label: "India", value: "IN" }, { label: "Ireland", value: "IE" },
    { label: "Italy", value: "IT" }, { label: "Japan", value: "JP" }, { label: "Mexico", value: "MX" },
    { label: "Netherlands", value: "NL" }, { label: "New Zealand", value: "NZ" }, { label: "Norway", value: "NO" },
    { label: "Portugal", value: "PT" }, { label: "South Korea", value: "KR" }, { label: "Spain", value: "ES" },
