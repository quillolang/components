component PostCardDemoLive() {
    state liked = false
    state likes = 1199
    state events = []
    <div.demo-stack>
        <PostCard id="post-card-demo-live" name="Ben Okafor" handle="@ben" time="4 h" datetime="2026-10-28T07:00:00Z"
                  text="Anyone up for a run along the river on Saturday?" likes={likes} comments={3} liked={liked}
                  on_like={(on) => { liked = on; likes = on ? likes + 1 : likes - 1 }}
                  on_comment={() => { events = events | push("comment") }}
                  on_share={() => { events = events | push("share") }}/>
        <p.demo-note>{liked ? "Liked." : "Not liked."} {len(events) == 0 ? "" : `Pressed: ${join(events, ", ")}.`}</p>
    </div>
}

view PostCardDemo() =
    <div.demo-stack.demo-narrow style="max-width: 520px">
