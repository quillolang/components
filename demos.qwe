component TagDemoLive() {
    state tags = ["design", "frontend", "accessibility", "v2"]
    state only_open = true
    <div.demo-stack>
        <div.demo-row>
            {for t in tags => <Tag key={t} tone="accent" removable={true} label={t}
                                   on_remove={() => { tags = tags | filter((x) => x != t) }}>{t}</Tag>}
            {len(tags) == 0 && <span.demo-note>No tags left.</span>}
        </div>
        <div.demo-row>
            <Tag selected={only_open} on_click={() => { only_open = !only_open }}>Open issues only</Tag>
            <span.demo-note>{len(tags)} tags; {only_open ? "showing open issues" : "showing all issues"}.</span>
        </div>
    </div>
}

view TagDemo() =
    <div.demo-stack>
        <div.demo-row>
            <Tag>design</Tag>
            <Tag tone="accent">frontend</Tag>
            <Tag tone="success" dot={true}>shipped</Tag>
            <Tag tone="warning" dot={true}>needs review</Tag>
            <Tag tone="danger">bug</Tag>
            <Tag tone="info" href="#tag">docs</Tag>
            <Tag size="sm">small</Tag>
        </div>
        <TagDemoLive/>
    </div>

