let read_more_demo_text = "Quillo renders a page on the server, then resumes its components in the browser from the state the server sent, so a page shows at once and reacts as soon as it is touched. What someone typed and clicked before the script came is kept and done then. A component that runs by itself loads as soon as the page is idle; the rest wait until they are reached, so a page with a hundred of them costs no more than one. Pages with the same components share one bundle, whichever of them each showed."

component ReadMoreDemoLive() {
    state open = false
    <div.demo-stack>
        <ReadMore lines={2} id="read-more-demo-live" more="See all" less="See fewer" on_toggle={(o) => { open = o }}>
