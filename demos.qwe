    <div.demo-stack>
        <MultiSelect id="ms-demo-reviewers" name="reviewers" label="Reviewers (up to 2)" max={2} values={["Grace"]}
                     options={["Ada", "Alan", "Barbara", "Edsger", "Grace", "Ken", "Linus", "Margaret"]}
                     on_change={(vs) => { who = vs }}/>
        <p.demo-note>{len(who) == 0 ? "No reviewers." : `Review by ${join(who, " and ")}.`}</p>
    </div>
}

view MultiSelectDemo() =
    <div.demo-stack.demo-narrow>
        <MultiSelect id="ms-demo-langs" name="langs" label="Languages spoken" values={["en", "pt"]}
                     options={multi_select_demo_langs} placeholder="Search languages"
                     hint="Type to filter; the arrow keys and Enter tick."/>
        <MultiSelectDemoLive/>
        <MultiSelect id="ms-demo-days" name="days" label="Days" size="sm" select_all={false}
                     options={["Mon", "Tue", "Wed", "Thu", "Fri"]} error="Choose at least one day."/>
    </div>

