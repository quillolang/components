component SheetDemoLive() {
    state showing = false
    state stop = "Central Station"
    <div.demo-row>
        <Button variant="soft" on_click={() => { showing = true }}>Pick a stop (from state)</Button>
        <span.demo-note>Stop: {stop}</span>
        <Sheet title="Pick a stop" open={showing} snap="full" on_close={() => { showing = false }}>
            <div.demo-stack>
                {for s in ["Central Station", "Harbour Gate", "Museum Quarter", "University", "Old Town"] =>
                    <Button variant={s == stop ? "solid" : "outline"} full={true}
                            on_click={() => { stop = s; showing = false }}>{s}</Button>}
            </div>
        </Sheet>
    </div>
}

