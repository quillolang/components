// ---- demos/stack.qwe ----------------------------------------------------------------

view StackDemoBox(label: str) =
    <div style="padding: 10px 14px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius-sm); background: var(--ui-subtle); font-size: 13px">{label}</div>

view StackDemo() =
    <div.demo-stack>
        <Stack direction="row" gap="xl" wrap={true}>
            <div style="width: 180px">
                <Stack gap="xs"><StackDemoBox label="column"/><StackDemoBox label="gap xs"/><StackDemoBox label="stretch"/></Stack>
            </div>
            <div style="width: 180px">
                <Stack gap={16} align="start"><StackDemoBox label="gap 16"/><StackDemoBox label="align start"/><StackDemoBox label="three"/></Stack>
            </div>
            <div style="width: 180px">
                <Stack align="center"><StackDemoBox label="align"/><StackDemoBox label="center"/><StackDemoBox label="in the middle"/></Stack>
            </div>
        </Stack>
        <Stack direction="row" justify="between" align="center">
            <StackDemoBox label="row"/><StackDemoBox label="justify between"/><StackDemoBox label="end"/>
        </Stack>
        <Stack direction="row" gap="sm" wrap={true} collapse={true}>
            <StackDemoBox label="wrap"/><StackDemoBox label="and collapse"/><StackDemoBox label="into a column"/>
            <StackDemoBox label="on phones"/>
        </Stack>
    </div>

ui_gallery = ui_gallery | push({ slug: "stack", name: "Stack", group: "Layout",
    summary: "A column or a row of things, evenly spaced, aligned and wrapped as you choose.",
    demo: StackDemo })

// ---- demos/stat.qwe ----------------------------------------------------------------

view StatDemo() =
    <div.demo-stack>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 12px">
            <Stat label="Revenue" value="$48,210" delta={12.5} delta_suffix="%" hint="vs last month"
                  trend={[31, 34, 33, 38, 41, 40, 45, 48]}/>
            <Stat label="Active users" value="1,284" delta={-3.2} delta_suffix="%" hint="vs last week"
                  trend={[1390, 1360, 1372, 1330, 1310, 1295, 1284]}/>
            <Stat label="Churn" value="2.1%" delta={-0.4} delta_suffix=" pts" good="down" hint="lower is better"/>
            <Stat label="Open tickets" value="37" delta={0} hint="same as yesterday"/>
        </div>
        <div.demo-row>
            <Stat label="Uptime, 30 days" value="99.98%" card={false} trend={[99.9, 99.95, 100, 99.99, 99.98]}/>
            <Stat label="Avg. response" value="212 ms" card={false} delta={18} delta_suffix=" ms" good="down"/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "stat", name: "Stat", group: "Data",
    summary: "A KPI tile: a label, a value, how it changed (coloured by whether that is good), and a tiny trend line.",
    demo: StatDemo })

