let line_clamp_demo_text = "Quillo renders a page on the server, then resumes its components in the browser from the state the server sent, so a page shows at once and reacts as soon as it is touched. What someone typed and clicked before the script came is kept and done then. A component that runs by itself loads as soon as the page is idle; the rest wait until they are reached, so a page with a hundred of them costs no more than one."

view LineClampDemo() =
    <div.demo-stack.demo-narrow>
        <LineClamp lines={2} text={line_clamp_demo_text} id="line-clamp-demo-two"/>
        <LineClamp lines={3} id="line-clamp-demo-three">
            <p>{line_clamp_demo_text}</p>
            <p>A second paragraph that is cut away with the rest.</p>
        </LineClamp>
        <LineClamp lines={0} text="Nothing is cut with lines={0}, however long the text is, which is handy when the limit comes from a setting." id="line-clamp-demo-none"/>
    </div>

