// ---- demos/zoom_image.qwe ----------------------------------------------------------------

// A woven pattern drawn in SVG, fine enough to be worth zooming, so the demo needs no image files.
fn zoom_image_demo_weave(a: str, b: str) -> str {
    let cells = join(for i in range(0, 20) => join(for j in range(0, 15) =>
        `<rect x="${i * 40}" y="${j * 40}" width="40" height="40" fill="${(i + j) % 2 == 0 ? a : b}"/><circle cx="${i * 40 + 20}" cy="${j * 40 + 20}" r="4" fill="#fff" opacity=".6"/>`, ""), "")
    let svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600" width="800" height="600">${cells}`
        + `<text x="400" y="320" font-family="Georgia, serif" font-size="14" text-anchor="middle" fill="#fff">Made in Porto · 100% linen</text></svg>`
    `data:image/svg+xml,${url_encode(svg)}`
}

view ZoomImageDemo() =
    <div.demo-row style="align-items: flex-start">
        <div style="width: 360px; max-width: 100%">
            <ZoomImage src={zoom_image_demo_weave("#5b4bdb", "#3f8f8a")} alt="Linen fabric with a small label"/>
        </div>
        <div style="width: 240px; max-width: 100%">
            <ZoomImage src={zoom_image_demo_weave("#c62a2f", "#a35200")} alt="Red fabric, square" zoom={4} ratio="1"
                       large="https://picsum.photos/seed/weave/1200/1200" hint="Zoom ×4"/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "zoom_image", name: "ZoomImage", group: "Media",
    summary: "A picture that zooms in where the pointer is; a click holds it, and the keyboard zooms and moves around too.",
    tags: ["media", "image", "commerce", "interactive"], demo: ZoomImageDemo })
