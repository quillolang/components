    <div.demo-stack>
        <WatchlistDemoLive/>
        <div id="watchlist-demo-sorted" class="demo-narrow" style="max-width: 520px">
            <Watchlist label="Sorted by % change" sort="percent" desc={true} items={watchlist_demo_start}/>
        </div>
    </div>

