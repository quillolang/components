// ---- demos/sleep_chart.qwe ----------------------------------------------------------------

// The night the clocks go back in Los Angeles: 23:10 to 06:40 by the clock is 8 h 30 min in truth,
// and 15 minutes went unrecorded from 01:50 on summer time to 01:05 on winter time.
let sleep_chart_demo_night = [
    { stage: "awake", start: "2026-10-31T23:10:00-07:00", end: "2026-10-31T23:25:00-07:00" },
    { stage: "light", start: "2026-10-31T23:25:00-07:00", end: "2026-11-01T00:10:00-07:00" },
    { stage: "deep", start: "2026-11-01T00:10:00-07:00", end: "2026-11-01T01:15:00-07:00" },
    { stage: "rem", start: "2026-11-01T01:15:00-07:00", end: "2026-11-01T01:40:00-07:00" },
    { stage: "awake", start: "2026-11-01T01:40:00-07:00", end: "2026-11-01T01:50:00-07:00" },
    { stage: "light", start: "2026-11-01T01:05:00-08:00", end: "2026-11-01T03:00:00-08:00" },
    { stage: "deep", start: "2026-11-01T03:00:00-08:00", end: "2026-11-01T03:40:00-08:00" },
    { stage: "rem", start: "2026-11-01T03:40:00-08:00", end: "2026-11-01T04:30:00-08:00" },
    { stage: "Core", start: "2026-11-01T04:30:00-08:00", end: "2026-11-01T06:20:00-08:00" },
    { stage: "awake", start: "2026-11-01T06:20:00-08:00", end: "2026-11-01T06:40:00-08:00" },
]

let sleep_chart_demo_clock = [
    { stage: "light", start: "22:30", end: "23:50" }, { stage: "deep", start: "23:50", end: "00:40" }, { stage: "rem", start: "00:40" },
    { stage: "light", start: "01:15", end: "05:30" }, { stage: "awake", start: "05:30", end: "06:00" },
]

component SleepChartDemoLive() {
    state said = "Nothing chosen."
    state stir = 0
    <div.demo-stack>
        <div id="sleep-chart-main"><SleepChart title="Saturday night, the clocks go back" segments={sleep_chart_demo_night | map((s) => { ...s, stir })}
            on_select={(i) => { said = i == null ? "Cleared." : `${i.clock} ${i.stage} ${i.minutes}` }}/></div>
        <p.demo-note id="sleep-chart-said">{said}</p>
        <div.demo-row><Button id="sleep-chart-stir" size="lg" variant="soft" on_click={() => { stir += 1 }}>New data arrives</Button></div>
    </div>
}

view SleepChartDemo() =
    <div.demo-stack>
        <SleepChartDemoLive/>
        <div id="sleep-chart-clock"><SleepChart title="By clock times" segments={sleep_chart_demo_clock}/></div>
        <div id="sleep-chart-empty"><SleepChart title="Bad data" segments={[null, { stage: "dreaming", start: "22:00", end: "23:00" }, { stage: "deep", start: "soon", end: "late" }]}/></div>
    </div>

ui_gallery = ui_gallery | push({ slug: "sleep_chart", name: "SleepChart", group: "Mobile",
    summary: "Stages through a night as a chart read by finger, with totals, right across midnight and a change of the clocks.",
    tags: ["mobile", "interactive", "health", "chart", "gesture", "tablet"],
    demo: SleepChartDemo })

// ---- demos/sleep_timer_sheet.qwe ----------------------------------------------------------------

// Fourteen silent seconds, small enough to sit in the page.
let sleep_timer_sheet_demo_src = "data:audio/mp4;base64,"

component SleepTimerSheetDemoLive() {
    state stops = 0
    state level = 1
    state turn = 0
    <div.demo-stack>
        <audio id="sleep-demo-audio" src={sleep_timer_sheet_demo_src} preload="auto" loop></audio>
        <div.demo-row>
            <Button id="sleep-demo-play" size="lg" on_click={() => { js("document.getElementById", "sleep-demo-audio").play() }}>Play</Button>
            <SleepTimerSheet key={turn} media="sleep-demo-audio" extend_by={10} on_stop={() => { stops += 1 }} on_volume={(l) => { level = l }}/>
        </div>
        <p.demo-note id="sleep-demo-note">Stopped {stops} times, level {round(level, 3)}</p>
        <div id="sleep-demo-bad"><SleepTimerSheet trigger="Odd props" choices={["x", 0, 5, 5, 1000]} fade="none" start_minutes="soon"/></div>
        <Button id="sleep-demo-again" variant="ghost" size="lg" on_click={() => { turn += 1 }}>Make it again</Button>
    </div>
}

view SleepTimerSheetDemo() = <SleepTimerSheetDemoLive/>

ui_gallery = ui_gallery | push({ slug: "sleep_timer_sheet", name: "SleepTimerSheet", group: "Mobile",
    summary: "Stops playing after a set time, with a fade at the end and an extend while it runs.",
    tags: ["mobile", "interactive", "media", "timer", "sheet", "audio"],
    demo: SleepTimerSheetDemo })

// ---- demos/slide_over.qwe ----------------------------------------------------------------

let slide_over_demo_css = css`
.demo-over { display: grid; gap: 12px; align-content: start; height: 100%; box-sizing: border-box; padding: 18px 20px; font: 15px/1.6 var(--ui-font); }
.demo-over h4 { margin: 0; font-size: 20px; }
.demo-over input { box-sizing: border-box; width: min(320px, 100%); height: 46px; padding: 0 10px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius-sm); background: var(--ui-surface); color: var(--ui-fg); font: 16px/1.2 var(--ui-font); }
.demo-over-note { margin: 0 0 10px; }
`

component SlideOverDemoLive() {
    style global slide_over_demo_css
    state tally = 0
    state where = "right"
    state said = "open"
    state wide = false
    <div.demo-tablet>
        <div.demo-over>
            <h4>Stock count</h4>
            <p>The page behind works while the panel floats over it.</p>
            <div.demo-row>
                <Button id="over-demo-count" size="lg" variant="outline" on_click={() => { tally += 1 }}>Counted {tally}</Button>
                <SlideOver title="Delivery notes" trigger="Notes" width={wide ? 340 : 320} on_edge={(e) => { where = e }}
                           on_close={() => { said = "put away" }} on_open={() => { said = "brought back" }}>
                    {for n in range(1, 61) => <p.demo-over-note>Crate {n}: checked in at the side door.</p>}
                    <label for="over-demo-note">A note</label>
                    <input id="over-demo-note" type="text"/>
                </SlideOver>
                <Button id="over-demo-wider" size="lg" variant="outline" on_click={() => { wide = !wide }}>Change its width</Button>
            </div>
            <label for="over-demo-field">Bin number</label>
            <input id="over-demo-field" type="text"/>
            <p id="over-demo-said">Panel on the {where}, {said}</p>
        </div>
    </div>
}

view SlideOverDemo() = <SlideOverDemoLive/>

ui_gallery = ui_gallery | push({ slug: "slide_over", name: "SlideOver", group: "Mobile",
