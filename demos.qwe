component CountdownDemoLive() {
    state run = 0
    state done = 0
    <div.demo-row>
        {run > 0
            ? <Countdown key={run} seconds={3} variant="inline" label="Launching in" ended="Launched"
                         on_end={() => { done += 1 }}/>
            : <span.demo-note>A three-second countdown, inside a component.</span>}
        <button type="button" @click={() => { run += 1 }}>{run > 0 ? "Again" : "Start"}</button>
        {done > 0 && <span.demo-note>on_end called {done} {done == 1 ? "time" : "times"}</span>}
    </div>
}

