    <div.demo-stack>
        <CurrencyConverter name="trip" label="Trip budget" rates={currency_converter_demo_rates} amount="2500" from="USD" to="JPY"
                           currencies={["USD", "EUR", "JPY", "PHP"]} updated="Mid-market rates at 14:05 UTC"
                           on_change={(r) => { note = `${r.amount} ${r.from} is ${round(r.converted, 2)} ${r.to}.` }}/>
