view WidgetDemo() =
    <div.demo-stack>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; align-items: stretch">
            <Widget id="widget-demo-revenue" title="Revenue" subtitle="This month" footer="Updated 2 minutes ago"
                    menu={<DropdownMenu id="widget-demo-menu" label="Period" size="sm" variant="ghost" items={[{ label: "This month" }, { label: "Last month" }, { label: "This year" }]}/>}>
                <Stat label="Gross" value="$48,210" delta={12.5} delta_suffix="%" card={false} trend={[31, 34, 33, 38, 41, 40, 45, 48]}/>
            </Widget>
            <Widget title="Recent orders" href="#widget" link="All orders" padding="none">
                <DataTable columns={[{ key: "id", label: "Order" }, { key: "who", label: "Customer" }, { key: "total", label: "Total", align: "right" }]}
                           rows={[{ id: "#1041", who: "Ada L.", total: "$120.00" }, { id: "#1040", who: "Grace H.", total: "$64.50" }, { id: "#1039", who: "Linus B.", total: "$980.00" }]}/>
            </Widget>
            <Widget title="Sync" subtitle="Stripe" loading={true} footer={<span>Started <time datetime="2026-10-28T09:12:00Z">09:12</time></span>}>
                <Progress value={62} label="Importing customers" show_value={true}/>
            </Widget>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "widget", name: "Widget", group: "Dashboard",
    summary: "A dashboard panel: a title row with a menu slot, the body, and a footer line or link, as a named region.",
    tags: ["dashboard", "card", "layout", "section", "no-js"],
    demo: WidgetDemo })

