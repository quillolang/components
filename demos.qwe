let watchlist_demo_start = [
    { symbol: "ACME", name: "Acme Corp.", price: 182.4, prev: 180.15 }, { symbol: "GLBX", name: "Globex", price: 48.61, prev: 49.02 },
    { symbol: "INIT", name: "Initech", price: 114.74, prev: 114.39 }, { symbol: "UMBR", name: "Umbrella", price: 57.72, prev: 59.14 },
    { symbol: "STRK", name: "Stark Industries", price: 123.52, prev: 119.85 }, { symbol: "HOOL", name: "Hooli", price: 88.1, prev: 88.1 },
]

// Each tick of a seeded random walk (Park–Miller) moves two of the prices by a little.
fn watchlist_demo_tick(items: list, n: int) -> list {
    let s = (n * n * 7919 + n * 104729 + 3) % 2147483647
    let rnd = () => {
        s = s * 16807 % 2147483647
        s / 2147483647
    }
    let a = floor(rnd() * len(items))
    let b = floor(rnd() * len(items))
    for [k, it] in enumerate(items) => {
        let moved = k == a || k == b ? round(it.price * (1 + (rnd() - 0.5) * 0.01) * 100) / 100 : it.price
        { ...it, price: moved, values: take(reverse([moved] + reverse(get(it, "values") ?? [it.prev, it.price])), 30) }
    }
}

component WatchlistDemoLive() {
    state items = watchlist_demo_tick(watchlist_demo_start, 0)
    state n = 0
    state live = true
    state picked = "ACME"
    if live {
        every(1100, () => {
            n += 1
            items = watchlist_demo_tick(items, n)
        })
    }
    <div.demo-stack id="watchlist-demo-live">
        <Watchlist items={items} prefix="$" selected="ACME" label="My watchlist" on_select={(s) => { picked = s }}/>
        <p.demo-note>Picked {picked}. Prices move every 1.1 s ({n} so far); click a heading to sort.</p>
        <div.demo-row>
            <Button size="sm" variant="outline" id="watchlist-demo-toggle" on_click={() => { live = !live }}>{live ? "Stop the feed" : "Start the feed"}</Button>
        </div>
    </div>
}

