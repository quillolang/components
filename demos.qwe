// The gallery's examples, in one file. Made by scripts/build.sh from demos/.

// ---- demos/_demo.qwe ----------------------------------------------------------------

// What every demo shares: the list they add themselves to, and the layout
// classes they use. (scripts/build.sh puts this first in demos.qwe.)

let ui_gallery = []

let demo_css = css`
.demo-row { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
.demo-stack { display: grid; gap: 14px; }
.demo-wide { width: 100%; }
.demo-narrow { max-width: 360px; }
.demo-note { margin: 0; color: var(--ui-muted); font: 13px/1.5 var(--ui-font); }
`

// ---- demos/abbr.qwe ----------------------------------------------------------------

view AbbrDemo() =
    <div.demo-stack>
        <p.demo-note style="color: var(--ui-fg); font-size: 15px">
            The <Abbr title="HyperText Markup Language" id="abbr-demo-html">HTML</Abbr> is sent first, the
            <Abbr title="Cascading Style Sheets">CSS</Abbr> with it, and the script only when a component is reached.
            Reply <Abbr title="as soon as possible" tooltip="native" id="abbr-demo-native">ASAP</Abbr>. Hover or Tab to one.
        </p>
    </div>

ui_gallery = ui_gallery | push({ slug: "abbr", name: "Abbr", group: "Typography",
    summary: "An abbreviation whose expansion shows in a bubble on hover or focus and is read out by screen readers.",
    tags: ["typography", "text", "accessibility", "no-js"],
    demo: AbbrDemo })

// ---- demos/accordion.qwe ----------------------------------------------------------------

view AccordionDemo() =
    <div.demo-stack>
        <Accordion>
            <AccordionItem group="faq" title="What does it cost?" open={true}>
                <p>Nothing for one project and up to three people. Teams pay per seat, monthly or yearly.</p>
            </AccordionItem>
            <AccordionItem group="faq" title="Can I cancel at any time?">
                <p>Yes, from Settings, Billing. You keep access until the end of the period you paid for.</p>
            </AccordionItem>
            <AccordionItem group="faq" title="Where is my data kept?" hint="Servers, backups and exports">
                <p>In the EU, on servers in Frankfurt, with nightly backups kept for 30 days.</p>
            </AccordionItem>
        </Accordion>
        <p.demo-note>The same group: opening one closes the others. Below, flush and independent.</p>
        <Accordion flush={true}>
            <AccordionItem title="Shipping"><p>Free over €50; two to four working days.</p></AccordionItem>
            <AccordionItem title="Returns"><p>Within 30 days, in the original packaging.</p></AccordionItem>
        </Accordion>
    </div>

ui_gallery = ui_gallery | push({ slug: "accordion", name: "Accordion", group: "Navigation",
    summary: "Sections that open under their titles, on the browser's own <details>: exclusive with a group.",
    tags: ["navigation", "list", "no-js"],
    demo: AccordionDemo })

// ---- demos/account_card.qwe ----------------------------------------------------------------

view AccountCardDemo() =
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 12px">
        <AccountCard id="account-card-demo-everyday" kind="Checking" name="Everyday" number="0012 0048 21" balance={2450.18m}
                     available={2310.18m} href="#everyday" transfer_href="#transfer" pay_href="#pay" statements_href="#statements"
                     note="Updated 2 min ago"/>
        <AccountCard id="account-card-demo-savings" kind="Savings" name="Rainy day" number="DE44 5001 0517 5407 3249 31"
                     balance={12500} currency="EUR" locale="de-DE" tone="success" transfer_href="#transfer" statements_href="#statements"/>
        <AccountCard id="account-card-demo-joint" kind="Joint checking" name="House" number="7730091266" balance={-84.5m}
                     available={415.5m} currency="GBP" locale="en-GB" tone="warning" pay_href="#pay"
                     note="Overdraft limit £500.00"/>
    </div>

ui_gallery = ui_gallery | push({ slug: "account_card", name: "AccountCard", group: "Finance",
    summary: "A bank account at a glance: type, nickname, masked number, current and available balance, what is on hold, and quick actions.",
    tags: ["finance", "banking", "card", "dashboard", "no-js"], demo: AccountCardDemo })

// ---- demos/account_details.qwe ----------------------------------------------------------------

view AccountDetailsDemo() =
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 14px">
        <AccountDetails id="account-details-demo" name="Dana Whitfield" bank="Fernway Credit Union" bank_address="40 Quay Street, Port Ellis"
                        number="40031204" sort_code="601422" iban="GB98FERN60142240031204" bic="fernGB2p" currency="GBP"/>
        <AccountDetails id="account-details-demo-us" title="Get paid by direct deposit" name="Northwind Ltd" bank="Harbor Bank"
                        number="4400 1234 5678" routing="011000015" reference="INV-0042"/>
        <AccountDetails id="account-details-demo-typo" title="Check before sharing" name="Tomás Reyes" iban="GB99 FERN 6014 2240 0312 04"
                        bic="FERNGB2P" copy_all={false}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "account_details", name: "AccountDetails", group: "Finance",
    summary: "The details to share to get paid: account name and number, IBAN in groups of four (checked), BIC, sort code or routing number, each with a copy button.",
    tags: ["finance", "banking", "card", "copy", "interactive"], demo: AccountDetailsDemo })

// ---- demos/account_picker.qwe ----------------------------------------------------------------

let account_picker_demo_accounts = [
    { id: "chk", name: "Everyday", kind: "Checking", number: "0012 0048 21", available: 2310.18m },
    { id: "sav", name: "Rainy day", kind: "Savings", number: "0012 0077 10", available: 420m },
    { id: "bills", name: "Bills pot", kind: "Checking", number: "0012 0093 57", available: 64.9m },
]

component AccountPickerDemoLive() {
    state amount = 500m
    state from = "chk"
    <div.demo-stack>
        <label style="display: grid; gap: 6px; width: 200px; font: 500 13px var(--ui-font)">Amount to pay ($)
            <input id="account-picker-demo-amount" type="text" inputmode="decimal" value="500.00"
                   style="height: 34px; padding: 0 10px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius-sm); background: var(--ui-surface); color: var(--ui-fg); font: 14px var(--ui-font)"
                   @input={(e) => { let d = dec(e.value); amount = is_err(d) ? null : d }}/>
        </label>
        <AccountPicker name="ap-demo-from" accounts={account_picker_demo_accounts} amount={amount} value={from}
                       on_change={(id) => { from = id }} hint="Only accounts that cover the amount can be chosen."/>
        <p.demo-note>Paying from {from}.</p>
    </div>
}

view AccountPickerDemo() =
    <div.demo-stack style="max-width: 460px">
        <AccountPickerDemoLive/>
        <AccountPicker name="ap-demo-marked" label="Fund the transfer from" amount={1000} value="sav" block_short={false}
                       accounts={account_picker_demo_accounts}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "account_picker", name: "AccountPicker", group: "Finance",
    summary: "Choose the account to pay from as radio cards with each one's masked number and available balance, those short of the amount marked.",
    tags: ["finance", "banking", "forms", "input", "no-js"], demo: AccountPickerDemo })

