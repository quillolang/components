      plan: "free", score: 12.5, tags: [], address: { city: "New York" }, orders: [{ sku: "B-2", qty: 1, note: "gift" }, { sku: "C-3", qty: 4 }] },
    { id: "e4d3c2b1-1234-4abc-9def-0123456789ab", email: "alan@example.com", joined: "2025-12-31", seen: "2025-12-31T23:59:59Z", site: "http://turing.example",
