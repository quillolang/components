// ---- demos/alert.qwe ----------------------------------------------------------------

component AlertDemoLive() {
    state shown = true
    <div.demo-stack>
        {shown
            ? <Alert tone="warning" title="Your trial ends in 3 days" dismissable={true}
                     on_dismiss={() => { shown = false }}>Add a card to keep your projects.</Alert>
            : <p.demo-note>Dismissed. <button type="button" @click={() => { shown = true }}>Show it again</button></p>}
    </div>
}

view AlertDemo() =
    <div.demo-stack>
        <Alert title="A new version is out">Quillo 0.9 adds live queries. <a href="#alert">Read the notes</a>.</Alert>
        <Alert tone="success" title="Invoice sent" id="alert-demo-sent">Northwind Traders got invoice INV-1042.</Alert>
        <Alert tone="danger" title="Payment failed">The card ending in 4242 was declined.</Alert>
        <Alert tone="neutral" icon={false}>Maintenance on Sunday, 02:00 to 03:00 UTC.</Alert>
        <div.demo-row>
            <Alert tone="accent" variant="outline">Outline, accent.</Alert>
            <Alert tone="success" variant="solid">Solid, success.</Alert>
            <Alert tone="danger" variant="solid">Solid, danger.</Alert>
        </div>
        <AlertDemoLive/>
        <DismissibleAlert tone="info" title="Placed straight in a page">DismissibleAlert hides itself when closed.</DismissibleAlert>
    </div>

ui_gallery = ui_gallery | push({ slug: "alert", name: "Alert", group: "Feedback",
    summary: "A message in the page in six tones and three variants, with an icon, announced to screen readers, and dismissable.",
    tags: ["feedback", "status", "no-js"],
    demo: AlertDemo })

// ---- demos/alert_dialog.qwe ----------------------------------------------------------------

component AlertDialogDemoLive() {
    state closed = 0
    <div.demo-row>
        <AlertDialog id="alert-demo-live" title="Session ended" tone="warning" ok="Sign in again" trigger="Session ended"
                     on_close={() => { closed += 1 }}>
            <p>You were signed out after an hour without activity.</p>
        </AlertDialog>
        <span.demo-note>{closed == 0 ? "Not closed yet." : `Closed ${closed} ${closed == 1 ? "time" : "times"}.`}</span>
    </div>
}

view AlertDialogDemo() =
    <div.demo-stack>
        <div.demo-row>
            <AlertDialog id="alert-demo-done" title="Export done" tone="success" trigger="Export done">
                <p>Your file is on its way to you by email. It can take a few minutes.</p>
            </AlertDialog>
            <AlertDialog id="alert-demo-info" title="About" trigger="About">
                <p>Quillo UI 1.0. Every component in one file, and each on its own.</p>
            </AlertDialog>
            <AlertDialog id="alert-demo-failed" title="Payment failed" tone="danger" ok="Try again" trigger="Payment failed">
                <p>Your card was declined. Nothing was charged.</p>
            </AlertDialog>
        </div>
        <AlertDialogDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "alert_dialog", name: "AlertDialog", group: "Overlays",
    summary: "A modal that only informs, with one OK button, on the browser's own <dialog> and no JavaScript.",
    tags: ["dialog", "overlay", "feedback", "no-js"],
    demo: AlertDialogDemo })

