component TypingIndicatorDemoLive() {
    state who = ["Ana Silva"]
    let all = ["Ana Silva", "Ben Okafor", "Lee Chen", "Mia Rossi"]
    <div.demo-stack>
        <div id="typing-indicator-demo-live"><TypingIndicator names={who} first_names={true}/></div>
        <div.demo-row>
            {for p in all => <label key={p} style="display: inline-flex; gap: 6px; align-items: center; font-size: 13px">
                <input type="checkbox" checked={contains(who, p)} value={p}
                       @change={(e) => { who = e.checked ? all | filter((x) => x == p || contains(who, x)) : who | filter((x) => x != p) }}/>
                {p}
            </label>}
        </div>
    </div>
}

