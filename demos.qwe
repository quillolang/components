// ---- demos/calendar_heatmap.qwe ----------------------------------------------------------------

// A year of made-up commits: quieter at weekends, a few busy streaks.
let calendar_heatmap_demo_values = reduce(range(365), {}, (m, i) => {
    let n = calendar_heatmap_parse("2026-10-28") - i
    let h = (n * 7919 + 104729) % 1009
    let weekend = (n + 4) % 7 == 0 || (n + 4) % 7 == 6
    let v = weekend ? (h % 4 == 0 ? h % 3 : 0) : (h % 6 == 0 ? 0 : h % 9 + (i > 40 && i < 70 ? 6 : 0))
    v > 0 ? set(m, calendar_heatmap_iso(n), v) : m
})

let calendar_heatmap_demo_runs = reduce(range(120), {}, (m, i) => {
    let n = calendar_heatmap_parse("2026-10-28") - i
    let km = (n * 31) % 17
    km < 9 ? set(m, calendar_heatmap_iso(n), km + 3) : m
})

view CalendarHeatmapDemo() =
    <div.demo-stack>
        <CalendarHeatmap values={calendar_heatmap_demo_values} end="2026-10-28" unit="commits" label="Commits"/>
        <CalendarHeatmap values={calendar_heatmap_demo_runs} start="2026-07-01" end="2026-10-28" unit="km run"
                         tone="success" week_start="monday" label="Running"/>
    </div>

ui_gallery = ui_gallery | push({ slug: "calendar_heatmap", name: "CalendarHeatmap", group: "Charts",
