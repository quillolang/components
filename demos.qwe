        <Panel id="panel-demo-members" title="Members" subtitle="3 of 5 seats used"
               header={[<SearchInput name="q" field="panel-demo-q" placeholder="Find a person" size="sm"/>, <Button size="sm" id="panel-demo-invite">Invite</Button>]}
               footer={[<Button variant="ghost" size="sm">Cancel</Button>, <Button size="sm">Save</Button>]}>
            {for [n, r] in panel_demo_people => <div style="display: flex; justify-content: space-between; padding: 6px 0"><span>{n}</span><span style="color: var(--ui-muted)">{r}</span></div>}
        </Panel>
        <Grid columns={2}>
            <Panel id="panel-demo-danger" title="Danger zone" tone="danger" padding="none"
                   footer={<span style="font-size: 13px; color: var(--ui-muted)">These cannot be undone.</span>} footer_align="start">
                <div style="padding: 14px 16px; border-bottom: 1px solid var(--ui-border); display: flex; justify-content: space-between; align-items: center">
                    <span>Delete this project</span><Button tone="danger" variant="outline" size="sm">Delete</Button>
                </div>
                <div style="padding: 14px 16px; display: flex; justify-content: space-between; align-items: center">
                    <span>Transfer ownership</span><Button variant="outline" size="sm">Transfer</Button>
                </div>
            </Panel>
            <Panel id="panel-demo-subtle" title="Activity" tone="subtle" header={<Badge>Live</Badge>}>
                <p>A tinted header, no footer.</p>
            </Panel>
        </Grid>
    </div>

