        { label: "Bug", value: "bug", count: 61 }, { label: "Feature", value: "feature", count: 38 },
        { label: "Docs", value: "docs", count: 17 }, { label: "Good first issue", value: "first", count: 9 }] },
    { name: "sort", label: "Sort", multiple: false, options: ["Newest", "Oldest", "Most comments"] },
    { name: "priority", label: "Priority", display: "chips", options: [
        { label: "High", value: "high", count: 7 }, { label: "Low", value: "low", count: 40 }] },
]

let filter_bar_demo_products = [
    { name: "Trail runner", kind: "Shoes", price: 120 }, { name: "Rain shell", kind: "Jackets", price: 180 },
    { name: "Wool beanie", kind: "Hats", price: 25 }, { name: "Down parka", kind: "Jackets", price: 320 },
    { name: "Road racer", kind: "Shoes", price: 160 }, { name: "Sun cap", kind: "Hats", price: 30 },
    { name: "Fleece vest", kind: "Jackets", price: 90 }, { name: "Approach shoe", kind: "Shoes", price: 140 },
]

fn filter_bar_demo_keep(p: map, query: str, values: map) -> bool {
    let kinds = get(values, "kind") ?? []
    let price = first(get(values, "price") ?? [])
    contains(lower(p.name), lower(trim(query)))
        && (len(kinds) == 0 || contains(kinds, p.kind))
        && (price == null || (price == "under-100" ? p.price < 100 : p.price >= 100))
}

component FilterBarDemoLive() {
    state shown = filter_bar_demo_products
    <div.demo-stack>
        <FilterBar id="fb-shop" label="Product filters" placeholder="Search products"
                   facets={[
                       { name: "kind", label: "Kind", display: "chips", options: ["Shoes", "Jackets", "Hats"] },
                       { name: "price", label: "Price", multiple: false,
                         options: [{ label: "Under $100", value: "under-100" }, { label: "$100 and up", value: "100-up" }] },
                   ]}
                   on_change={(f) => { shown = filter_bar_demo_products | filter((p) => filter_bar_demo_keep(p, f.query, f.values)) }}/>
        <p.demo-note>{len(shown)} of {len(filter_bar_demo_products)}: {join(shown | map((p) => p.name), ", ")}</p>
    </div>
}

view FilterBarDemo() =
    <div.demo-stack>
