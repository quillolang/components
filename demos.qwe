view AuthFormDemo() =
    <div.demo-stack>
        <p.demo-note>Four forms, one per mode; the links in each switch it in place. They post to /login, /signup, /forgot and /reset.</p>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 20px; align-items: start">
            <AuthForm id="auth-demo-signin" mode="signin" error="Wrong email or password."
                      values={{ email: "ada@example.com" }}
                      providers={[{ label: "Continue with GitHub", href: "#auth-github" },
                                  { label: "Continue with Google", href: "#auth-google" }]}/>
            <AuthForm id="auth-demo-signup" mode="signup" terms_href="#terms" min_password={10}/>
            <AuthForm id="auth-demo-forgot" mode="forgot"
                      notice="If that address has an account, a link to reset its password is on its way: check your inbox."/>
            <AuthForm id="auth-demo-reset" mode="reset" token="demo-7f3a9c" values={{ email: "ada@example.com" }}
                      errors={{ password: "That is the password you had: choose another." }}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "auth_form", name: "AuthForm", group: "Forms",
    summary: "Sign in, sign up, forgot and reset password in one form that switches in place, each posting to its own route.",
    tags: ["forms", "user", "security", "page", "interactive"],
    demo: AuthFormDemo })

