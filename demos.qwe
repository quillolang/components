// ---- demos/renko_chart.qwe ----------------------------------------------------------------

// Prices from a seeded random walk (Park–Miller), the same on every render: `count`
// candles from the day `from` on, skipping weekends, daily or hourly (10:00 to 16:00),
// rounded to `places` decimals.
fn renko_chart_demo_walk(seed: int, count: int, start: num, from: str, hourly: bool = false, places: int = 2) -> list {
    let s = seed
    let rnd = () => {
        s = s * 16807 % 2147483647
        s / 2147483647
    }
    let scale = pow(10, places)
    let cut = (v) => round(v * scale) / scale
    let p = start
    let day = from
    let hour = 10
    let out = []
    while len(out) < count {
        if date.weekday(day) <= 5 {
            let open = cut(p * (1 + (rnd() - 0.5) * 0.006))
            let close = cut(open * (1 + (rnd() - 0.485) * (hourly ? 0.012 : 0.035)))
            let high = cut(max([open, close]) * (1 + rnd() * 0.01))
            let low = cut(min([open, close]) * (1 - rnd() * 0.01))
            let volume = round((hourly ? 90000 : 900000) * (1 + rnd() * 1.5 + abs(close - open) * 30 / open))
            out = out | push({ time: hourly ? `${day}T${hour < 10 ? "0" : ""}${hour}:00:00Z` : day, open, high, low, close, volume })
            p = close
        }
        if hourly && hour < 16 && date.weekday(day) <= 5 {
            hour += 1
        } else {
            hour = 10
            day = date.add_days(day, 1)
        }
    }
    out
}

let renko_chart_demo_daily = renko_chart_demo_walk(3, 160, 120.5, "2026-03-02")

view RenkoChartDemo() =
    <div.demo-stack>
        <div id="renko_chart-demo-box">
            <RenkoChart label="Initech, $2 bricks" show_label={true} candles={renko_chart_demo_daily} box={2} prefix="$"/>
        </div>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 32px 40px">
            <div id="renko_chart-demo-auto">
                <RenkoChart label="Initech, box chosen" show_label={true} candles={renko_chart_demo_daily} prefix="$" height={200}/>
            </div>
            <div id="renko_chart-demo-closes">
                <RenkoChart label="Closes alone" show_label={true} closes={[100, 101.2, 103.4, 104.9, 103.1, 101.8, 99.6, 98.7, 100.4, 102.2]}
                            box={1} height={200}/>
            </div>
        </div>
    </div>

