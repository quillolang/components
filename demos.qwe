let carousel_demo_stories = [
    { title: "Spring sale", text: "Up to 40% off outdoor gear, this week only.", tone: "accent" },
    { title: "New arrivals", text: "Lightweight jackets for the shoulder season.", tone: "info" },
    { title: "Free returns", text: "Changed your mind? Send it back within 60 days.", tone: "success" },
    { title: "Gift cards", text: "Let them pick: from €10, delivered by email.", tone: "warning" }
]

view CarouselDemoCard(title: str, text: str, tone: str) =
    <div style={`display: grid; align-content: center; min-height: 200px; padding: 28px 64px; background: linear-gradient(135deg, var(--ui-${tone}-soft), var(--ui-subtle)); border: 1px solid var(--ui-border); border-radius: var(--ui-radius)`}>
        <h4 style="margin: 0 0 6px; font-size: 22px">{title}</h4>
        <p style="margin: 0; color: var(--ui-muted)">{text}</p>
    </div>

view CarouselDemo() =
    <div.demo-stack style="gap: 28px">
        <Carousel label="Featured" id="carousel-demo-featured">
            {for s in carousel_demo_stories => <CarouselSlide label={s.title}>
                <CarouselDemoCard title={s.title} text={s.text} tone={s.tone}/>
            </CarouselSlide>}
        </Carousel>
        <Carousel label="Testimonials" id="carousel-demo-quotes" autoplay={3} loop={true}>
            {for [q, who] in [["Setup took five minutes.", "Ana, Lisbon"], ["The support team answered on a Sunday.", "Ben, Leeds"],
                              ["Our checkout is twice as fast.", "Chen, Taipei"]] =>
                <CarouselSlide label={who}>
                    <figure style="margin: 0; padding: 24px 64px; text-align: center; background: var(--ui-subtle); border-radius: var(--ui-radius)">
                        <blockquote style="margin: 0 0 8px; font-size: 18px">“{q}”</blockquote>
                        <figcaption style="color: var(--ui-muted)">{who}</figcaption>
                    </figure>
                </CarouselSlide>}
        </Carousel>
        <p.demo-note>The second moves by itself every 3 seconds; it stops while the pointer or the focus is on it.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "carousel", name: "Carousel", group: "Layout",
    summary: "Slides one at a time: buttons, dots, swiping, the keyboard, and optional autoplay that knows when to stop.",
    tags: ["media", "image", "interactive"],
    demo: CarouselDemo })

