// ---- demos/infinite_scroll.qwe ----------------------------------------------------------------

component InfiniteScrollDemoLive() {
    state items = range(1, 11)
    state asked = 0
    let limit = 40
    <div.demo-stack>
        <div id="infinite-scroll-demo-box" tabindex="0" aria-label="Entries"
             style="height: 240px; overflow: auto; border: 1px solid var(--ui-border); border-radius: var(--ui-radius)">
            <InfiniteScroll scroller="infinite-scroll-demo-box" margin="40px" done={len(items) >= limit}
                            on_more={() => {
                                asked += 1
                                items = items + range(len(items) + 1, min([limit, len(items) + 10]) + 1)
                            }}>
                <ul style="margin: 0; padding: 0; list-style: none">
                    {for i in items => <li key={i} style="padding: 10px 16px; border-bottom: 1px solid var(--ui-border)">Entry {i}</li>}
                </ul>
            </InfiniteScroll>
        </div>
        <p.demo-note>{len(items)} of {limit} entries, asked for more {asked} {asked == 1 ? "time" : "times"}.</p>
    </div>
}

view InfiniteScrollDemo() =
    <div.demo-stack>
        <InfiniteScrollDemoLive/>
        <p.demo-note>Scroll the box to its end: ten more come each time, until forty. The Load more button does the same.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "infinite_scroll", name: "InfiniteScroll", group: "Utilities",
    summary: "Calls on_more() when the end of its list scrolls into view, with Loading more… and That's all states and a Load more button.",
    tags: ["utility", "list", "loading", "data", "interactive"],
    demo: InfiniteScrollDemo })

