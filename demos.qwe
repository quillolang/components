// ---- demos/cover_image.qwe ----------------------------------------------------------------

// A landscape drawn in SVG, so the demo needs no image files.
fn cover_image_demo_scene(sky: str, hill: str) -> str {
    let svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1600 900" width="1600" height="900">`
        + `<defs><linearGradient id="g" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="${sky}"/><stop offset="1" stop-color="#fff3e0"/></linearGradient></defs>`
        + `<rect width="1600" height="900" fill="url(#g)"/><circle cx="1150" cy="300" r="90" fill="#ffd36b"/>`
        + `<path d="M0 620 Q 400 420 800 600 T 1600 540 V 900 H 0 Z" fill="${hill}"/>`
        + `<path d="M0 760 Q 500 600 900 780 T 1600 720 V 900 H 0 Z" fill="#1f3d2a"/></svg>`
    `data:image/svg+xml,${url_encode(svg)}`
}

view CoverImageDemo() =
    <div.demo-stack>
        <CoverImage src={cover_image_demo_scene("#7cb7f0", "#2f6b3a")} alt="Green hills under a morning sky" eyebrow="Travel"
                    title="The long way round" subtitle="Six days on foot across the Picos de Europa, with a tent and too many maps.">
            <a class="ui-btn ui-btn-solid" href="https://example.com/read" style="background: #fff; color: #17161f">Read the story</a>
        </CoverImage>
        <CoverImage src={cover_image_demo_scene("#f3a46b", "#5b3a5e")} alt="" title="Autumn in the valley" size="sm" align="center"
                    position="top" shade={0.5}/>
        <p.demo-note>The gradient keeps the title readable; children go under the text.</p>
    </div>

