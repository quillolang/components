            <SlopeChart label="Median rent by city" show_label={true} start_label="2020" end_label="2025" prefix="$"
                        by_change={false} change={false}
                        items={[{ label: "Lisbon", start: 1150, end: 1690 }, { label: "Porto", start: 820, end: 1240 },
                                { label: "Madrid", start: 1280, end: 1610 }, { label: "Berlin", start: 1240, end: 1650 },
                                { label: "Vienna", start: 1010, end: 1150 }]}/>
        </div>
        <p.demo-note>In the second, Berlin, Madrid and Lisbon end close together: their labels move apart.</p>
    </div>

