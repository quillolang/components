// ---- demos/chat_thread.qwe ----------------------------------------------------------------

let chat_thread_demo_start = [
    { id: 1, from: "Ana Silva", text: "Hi! Did the new build go out?", time: "Yesterday 17:02", day: "Yesterday" },
    { id: 2, from: "Me", mine: true, text: "Not yet: one test is still failing on Windows.", time: "Yesterday 17:05", day: "Yesterday" },
    { id: 3, from: "Ana Silva", text: "Ok, no rush.", time: "Yesterday 17:06", day: "Yesterday" },
    { id: 4, from: "Ana Silva", text: "Morning! Any luck with that test?", time: "09:12", day: "Today" },
    { id: 5, from: "Ana Silva", text: "I can pair on it after lunch\nif that helps.", time: "09:13", day: "Today" },
    { id: 6, from: "Me", mine: true, text: "Fixed it: a path with a space in it.", time: "09:30", day: "Today" },
    { id: 7, from: "Me", mine: true, text: "Shipping now 🚀", time: "09:30", day: "Today" },
    { id: 8, from: "Ben Okafor", text: "Nice one. I'll tell the customers.", time: "09:41", day: "Today" }
]

component ChatThreadDemoLive() {
    state messages = chat_thread_demo_start
    state waiting = false
    if waiting {
        every(1500, () => {
            messages = messages | push({ id: len(messages) + 1, from: "Ana Silva", text: "Got it, thanks!", time: "now", day: "Today" })
            waiting = false
        })
    }
    <ChatThread id="chat-demo-live" messages={messages} typing={waiting ? "Ana Silva" : null} height="340px"
                on_send={(text) => {
                    messages = messages | push({ id: len(messages) + 1, from: "Me", mine: true, text, time: "now", day: "Today" })
                    waiting = true
                }}/>
}

view ChatThreadDemo() =
    <div.demo-stack>
        <ChatThreadDemoLive/>
        <p.demo-note>Enter sends, Shift+Enter starts a new line; Ana answers. Below, a thread whose box posts a form:</p>
        <ChatThread id="chat-demo-form" height="180px" method="get" action="#chat_thread" label="Support ticket"
                    messages={[{ from: "Support", text: "Thanks for writing in. Could you send us your order number?", time: "Mon 14:20", day: "Monday" },
                               { from: "You", mine: true, text: "It's #1042.", time: "Mon 14:31", day: "Monday" }]}>
            <input type="hidden" name="ticket" value="77"/>
        </ChatThread>
    </div>

