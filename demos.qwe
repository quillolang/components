// ---- demos/live_candles.qwe ----------------------------------------------------------------

// Tick `n` of a seeded random walk (Park–Miller) from `price`: the same on the server
// and in the browser. Ticks come a simulated second apart from 14:30:00.
fn live_candles_demo_tick(n: int, price: num) -> map {
    let s = (n * n * 7919 + n * 104729 + 11) % 2147483647
    let rnd = () => {
        s = s * 16807 % 2147483647
        s / 2147483647
    }
    rnd()
    { time: 1793197800000 + n * 1000, price: round(price * (1 + (rnd() - 0.5) * 0.004) * 100) / 100,
      size: round(rnd() * 900 + 100) }
}

fn live_candles_demo_run(count: int) -> list {
    let out = []
    let p = 182.4
    for n in range(count) {
        let t = live_candles_demo_tick(n, p)
        p = t.price
        out = out | push(t)
    }
    out
}

component LiveCandlesDemoLive() {
    state ticks = live_candles_demo_run(150)
    state live = true
    if live {
        every(250, () => {
            let t = live_candles_demo_tick(ticks[-1].time / 1000 - 1793197800 + 1, ticks[-1].price)
            ticks = drop(ticks, len(ticks) >= 400 ? 1 : 0) + [t]
        })
    }
    <div.demo-stack id="live_candles-demo-live">
        <LiveCandles ticks={ticks} interval={5} limit={36} prefix="$" label="ACME, 5-second candles"/>
        <p.demo-note>A tick every 0.25 s, a simulated second each, so a 5-second candle closes every 1.25 s.</p>
        <div.demo-row>
            <Button size="sm" variant="outline" id="live_candles-demo-toggle" on_click={() => { live = !live }}>{live ? "Stop the ticks" : "Start the ticks"}</Button>
        </div>
    </div>
}

view LiveCandlesDemo() = <LiveCandlesDemoLive/>

ui_gallery = ui_gallery | push({ slug: "live_candles", name: "LiveCandles", group: "Charts",
    summary: "Candles built from ticks as they come: the open candle grows, a new one starts each interval, with the last price and the time left.",
    tags: ["chart", "data", "trading", "interactive"],
    demo: LiveCandlesDemo })

