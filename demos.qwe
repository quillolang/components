// ---- demos/back_to_top.qwe ----------------------------------------------------------------

view BackToTopDemo() =
    <div.demo-stack>
        <div id="btt-demo-log" tabindex="0" aria-label="Release notes"
             style="height: 260px; overflow: auto; border: 1px solid var(--ui-border); border-radius: var(--ui-radius); padding: 4px 18px">
            {for v in range(1, 25) => <p>Version 0.{25 - v}: fixes and small improvements, item {v} of a long list.</p>}
            <BackToTop scroller="btt-demo-log" after={200} label="Back to the newest" target="btt-demo-log"/>
        </div>
        <p.demo-note>Scroll the list above: the button shows in its corner. This page has one too, at the bottom right
            of the window, once it is scrolled far down.</p>
        <BackToTop after={1600} show_label={true}/>
    </div>

ui_gallery = ui_gallery | push({ slug: "back_to_top", name: "BackToTop", group: "Navigation",
    summary: "A button in the corner that shows once the page is scrolled down and takes it back to the top.",
    demo: BackToTopDemo })

