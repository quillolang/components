        <Card title="Team" header={<span style="font-size: 12px; color: var(--ui-muted)">3 seats</span>}
              footer={[<Button variant="ghost" size="sm">Manage</Button>, <Button size="sm">Invite</Button>]}>
            <p>Ada, Grace and Linus can edit this project.</p>
