                   style="height: 36px; padding: 0 10px; border: 1px solid var(--ui-border); border-radius: var(--ui-radius-sm); background: var(--ui-surface); color: var(--ui-fg)"/>
            <Button id="tour-demo-new">New order</Button>
        </div>
    </div>
}

