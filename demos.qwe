let in_app_banner_demo_msgs = [
    { app: "Messages", title: "Ana Ruiz", body: "Are we still on for lunch at one?", time: "now" },
    { app: "Calendar", title: "Team review", body: "Starts in 15 minutes in room 4", time: "now" },
    { app: "Deliveries", title: "Parcel arriving", body: "Your parcel is 3 stops away", time: "2 min ago" },
    { app: "Bank", title: "Card payment", body: "Paid 12.40 at Harbour Coffee", time: "now" }]

component InAppBannerDemoLive() {
    state notes = []
    state next = 0
    state opened = "none"
    state dismissed = 0
    let send = (count: int) => {
        let more = range(count) | map((i) => {
            let m = in_app_banner_demo_msgs[(next + i) % len(in_app_banner_demo_msgs)]
            set(m, "id", `note-${next + i}`)
        })
        next = next + count
        notes = notes + more
    }
    <div.demo-stack>
        <div.demo-phone>
            <InAppBanner notes={notes} seconds={3} on_open={(n) => { opened = n.title }} on_dismiss={(_n) => { dismissed += 1 }}/>
            <div class="in-app-banner-demo-page">
                <div.demo-stack>
                    <Button size="lg" on_click={() => { send(1) }}>One banner</Button>
                    <Button size="lg" variant="outline" on_click={() => { send(3) }}>Three at once</Button>
                    <p.demo-note>Opened: <span class="in-app-banner-demo-opened">{opened}</span>. Dismissed: <span class="in-app-banner-demo-dismissed">{dismissed}</span>.</p>
                </div>
            </div>
        </div>
    </div>
}

let in_app_banner_demo_css = css`
.in-app-banner-demo-page { display: flex; align-items: flex-end; box-sizing: border-box; height: 100%; padding: 20px; }
.in-app-banner-demo-page .demo-stack { width: 100%; }
`

view InAppBannerDemo() =
    <div>
        <style>{in_app_banner_demo_css}</style>
        <InAppBannerDemoLive/>
    </div>

ui_gallery = ui_gallery | push({ slug: "in_app_banner", name: "InAppBanner", group: "Mobile",
    summary: "A notification-style banner sliding from the top: tap to open, swipe up to dismiss, a queue for several, held while touched.",
    tags: ["mobile", "interactive", "notification", "banner", "gesture"],
    needs: ["bottom_sheet"], demo: InAppBannerDemo })

// ---- demos/infinite_feed.qwe ----------------------------------------------------------------

let infinite_feed_demo_words = ["The harbour wall was finished before the storm came in.", "A short note.", "Three people asked about the old bridge on the same day, and nobody knew who had built it or why it stopped halfway across the river.", "Tickets go on sale on Friday.", "The bakery on Quay Street has started opening at six, and the queue goes round the corner by half past.", "Rain later."]

// A page of the story list. A page's text varies in length, so rows vary in height.
fn infinite_feed_demo_page(page: int, size: int) -> list =
    range((page - 1) * size, page * size) | map((i) => { id: i + 1, title: `Story ${i + 1}`, text: infinite_feed_demo_words[i % 6], meta: `${(i % 9) + 1} min read` })

// A pause, as there is no sleep in the browser: a timer the page's own AbortSignal has.
fn infinite_feed_demo_after(ms: int, value) = js("Promise.resolve", js_new("Promise", (res, rej) => {
    js("AbortSignal.timeout", ms).addEventListener("abort", () => { res(value) })
}))

component InfiniteFeedDemoLive() {
    state reading = null
    state calls = []
    state failed_yet = false
    state tries = 0
    let shown_calls = join(calls, ",")
    <div.demo-stack>
        <div.demo-phone style="height: 560px" data-frame>
            {reading == null
                ? <InfiniteFeed id="infeed-demo" height="100%" first={infinite_feed_demo_page(1, 12)} page_size={12} label="Stories" over={4}
                                load={(page) => {
                                    calls = calls + [page]
                                    if page == 3 && !failed_yet {
                                        failed_yet = true
                                        return infinite_feed_demo_after(120, err("no signal"))
                                    }
                                    infinite_feed_demo_after(120, page < 9 ? infinite_feed_demo_page(page, 12) : take(infinite_feed_demo_page(page, 12), 5))
                                }}
                                on_open={(it) => { reading = it }}/>
                : <div style="padding: 16px">
                    <h3 data-reading>{reading.title}</h3>
                    <p>{reading.text}</p>
                    <Button size="lg" id="infeed-back" on_click={() => { reading = null }}>Back to the feed</Button>
                  </div>}
        </div>
        <p.demo-note>Pages asked for: <b data-calls>{shown_calls}</b></p>
        <div.demo-tablet style="height: 300px" data-wide>
            <InfiniteFeed id="infeed-wide" keep={0} height="100%" first={infinite_feed_demo_page(1, 12)} page_size={12} over={4}
                          load={(page) => { page < 4 ? infinite_feed_demo_page(page, 12) : [] }}/>
        </div>
        <InfiniteFeed id="infeed-broken" keep={0} height="240px" first={[{ id: 1, title: "One" }, null, { id: 1, title: "One twice" }]} failed_text="Broken"
                      load={(page) => {
                          tries = tries + 1
                          if tries == 1 { return "nonsense" }
                          if tries == 2 { return unwrap(err("thrown")) }
                          if tries == 3 { return { items: "not a list" } }
                          { items: [{ id: 1, title: "One again" }, { id: 2, title: "Two" }, null, { id: 2, title: "Two again" }, { id: 2, title: "Two" }, { title: "No id" }], more: false }
                      }}/>
        <InfiniteFeed id="infeed-own" keep={0} height="160px" first={[{ id: 1, title: "Mine" }]} row={(it) => <p data-own>{it.title}, drawn by you</p>}/>
        <InfiniteFeed id="infeed-none" keep={0} height="120px" empty="No stories yet" load={(page) => []}/>
        <InfiniteFeed id="infeed-still" keep={0} height="240px" first={["Plain text", { id: 2, title: "A map", meta: "Static" }]} end_text="Only these"/>
    </div>
}

view InfiniteFeedDemo() = <InfiniteFeedDemoLive/>

ui_gallery = ui_gallery | push({ slug: "infinite_feed", name: "InfiniteFeed", group: "Mobile",
    summary: "A long feed that loads pages as you near the end: loading, retry on failure, end of list, keeps its place on return, and stays light by windowing.",
    tags: ["mobile", "interactive", "tablet", "feed", "list", "virtual"],
    demo: InfiniteFeedDemo })

// ---- demos/infinite_scroll.qwe ----------------------------------------------------------------

component InfiniteScrollDemoLive() {
    state items = range(1, 11)
    state asked = 0
    let limit = 40
    <div.demo-stack>
        <div id="infinite-scroll-demo-box" tabindex="0" aria-label="Entries"
             style="height: 240px; overflow: auto; border: 1px solid var(--ui-border); border-radius: var(--ui-radius)">
            <InfiniteScroll scroller="infinite-scroll-demo-box" margin="40px" done={len(items) >= limit}
                            on_more={() => {
                                asked += 1
                                items = items + range(len(items) + 1, min([limit, len(items) + 10]) + 1)
                            }}>
                <ul style="margin: 0; padding: 0; list-style: none">
                    {for i in items => <li key={i} style="padding: 10px 16px; border-bottom: 1px solid var(--ui-border)">Entry {i}</li>}
                </ul>
            </InfiniteScroll>
        </div>
        <p.demo-note>{len(items)} of {limit} entries, asked for more {asked} {asked == 1 ? "time" : "times"}.</p>
    </div>
}

view InfiniteScrollDemo() =
    <div.demo-stack>
        <InfiniteScrollDemoLive/>
        <p.demo-note>Scroll the box to its end: ten more come each time, until forty. The Load more button does the same.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "infinite_scroll", name: "InfiniteScroll", group: "Utilities",
