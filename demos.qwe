view ServerStatusDemo() =
    <div.demo-stack>
        <ServerStatus id="server-status-demo" updated="2 minutes ago" services={[
            { name: "API", status: "up", uptime: 99.98, href: "#server_status", history: ["up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up", "up"] },
            { name: "Dashboard", status: "degraded", uptime: 99.5, note: "Slow page loads for some visitors in the EU.", history: ["up", "up", "up", "degraded", "up", "up", "up", "up", "up", "up", "up", "up", "up", "degraded"] },
            { name: "Email", status: "down", uptime: 98.1, note: "Provider outage since 09:12; messages are queued.", history: ["up", "up", "up", "up", "up", "down", "up", "up", "up", "up", "up", "up", "up", "down"] },
            { name: "Search", status: "maintenance", uptime: 99.9, note: "Reindexing until 11:00." },
        ]}/>
        <ServerStatus services={[{ name: "API", status: "up", uptime: 100 }, { name: "Website", status: "up", uptime: 100 }]}/>
    </div>

