component CommentDemoLive() {
    state liked = false
    state likes = 3
    state replies = 0
    <div.demo-stack>
        <Comment id="comment-demo-live" name="Ben Okafor" role="Author" time="1 h" datetime="2026-10-28T10:30:00Z"
                 text="Yes, and Postgres: the same query runs on both." likes={likes} liked={liked}
                 on_like={(on) => { liked = on; likes = on ? likes + 1 : likes - 1 }}
                 on_reply={() => { replies += 1 }}/>
        <p.demo-note>{liked ? "You liked it." : "Not liked."} Reply pressed {replies} {replies == 1 ? "time" : "times"}.</p>
    </div>
}

