// A price under each day: €140 on Friday and Saturday nights, €95 the others.
fn date_range_picker_demo_prices() -> map {
    let from = date_range_picker_days(2026, 11, 20)
    range(72) | reduce({}, (m, i) => set(m, date_range_picker_iso(from + i), date_range_picker_weekday(from + i) >= 5 ? "€140" : "€95"))
}

view DateRangePickerDemo() =
    <div.demo-stack>
        <DateRangePicker name="drp-demo-stay" label="Your stay" start="2026-12-20" end="2026-12-27"
                         min="2026-11-01" max="2027-03-31" presets={[]}
                         hint="Pick the day you arrive, then the day you leave."/>
        <DateRangePickerDemoLive/>
        <DateRangePicker name="drp-demo-nights" label="A stay, in nights" today="2026-11-20" min="2026-11-20"
                         presets={[]} min_nights={2} disabled_dates={["2026-12-04", "2026-12-05", "2026-12-12"]}
                         day_labels={date_range_picker_demo_prices()}
                         hint="Two nights or more. Crossed out: booked; a stay can end on one."/>
        <DateRangePicker name="drp-demo-q" names={["period[start]", "period[end]"]} label="Quarter" size="sm"
                         week_start={0} error="Choose a whole quarter."
                         presets={[{ label: "Q3 2026", start: "2026-07-01", end: "2026-09-30" },
                                   { label: "Q4 2026", start: "2026-10-01", end: "2026-12-31" }]}/>
    </div>

