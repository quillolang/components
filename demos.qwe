let hover_card_demo_css = css`
.hc-demo-who { display: flex !important; align-items: center; gap: 10px; }
.hc-demo-who img { width: 40px; height: 40px; border-radius: 50%; }
.hc-demo-who b { display: block; }
.hc-demo-muted { color: var(--ui-muted); font-size: 13px; }
`

view HoverCardDemo() =
    <div.demo-stack>
        <style>{hover_card_demo_css}</style>
        <p style="margin: 0">
            Reviewed by{" "}
            <HoverCard id="hc-ada" trigger="@ada" href="#hover_card">
                <span.hc-demo-who>
                    <img src={`data:image/svg+xml,${url_encode("<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 40 40'><rect width='40' height='40' fill='#5b4bdb'/><text x='20' y='26' font-family='sans-serif' font-size='16' fill='#fff' text-anchor='middle'>AL</text></svg>")}`} alt=""/>
                    <span><b>Ada Lovelace</b><span.hc-demo-muted>Engineering · London</span></span>
                </span>
                <span>Wrote the parser and the type checker. 214 reviews this year.</span>
                <span><a href="#avatar">See her profile</a></span>
            </HoverCard>
            {" "}and merged on Oct 27 into{" "}
            <HoverCard id="hc-repo" trigger="quillolang/components" align="center" width={280}>
                <b>quillolang/components</b>
                <span.hc-demo-muted>Fifty UI components for Quillo, one file each. MIT.</span>
                <span>★ 1.2k · 48 forks · updated today</span>
            </HoverCard>.
        </p>
        <p style="margin: 0">
            <HoverCard id="hc-plan" trigger="What is in Pro?" placement="top" delay={200}>
                <b>Pro plan</b>
                <span>Unlimited projects, custom domains and daily backups, for $12 a month.</span>
            </HoverCard>
        </p>
        <p.demo-note>Rest the pointer on a name, or Tab to it; Escape hides the card.</p>
    </div>

