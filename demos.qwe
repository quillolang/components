// ---- demos/candlestick_chart.qwe ----------------------------------------------------------------

// Prices from a seeded random walk (Park–Miller), the same on every render.
fn candlestick_chart_demo_walk(seed: int, count: int, start: num, from: str, hourly: bool = false) -> list {
    let s = seed
    let rnd = () => {
        s = s * 16807 % 2147483647
        s / 2147483647
    }
    let p = start
    let day = from
    let hour = 10
    let out = []
    while len(out) < count {
        if date.weekday(day) <= 5 {
            let open = round((p * (1 + (rnd() - 0.5) * 0.006)) * 100) / 100
            let close = round((open * (1 + (rnd() - 0.485) * (hourly ? 0.012 : 0.035))) * 100) / 100
            let high = round((max([open, close]) * (1 + rnd() * 0.01)) * 100) / 100
            let low = round((min([open, close]) * (1 - rnd() * 0.01)) * 100) / 100
            let volume = round((hourly ? 90000 : 900000) * (1 + rnd() * 1.5 + abs(close - open) * 30 / open))
            out = out | push({ time: hourly ? `${day}T${hour < 10 ? "0" : ""}${hour}:00:00Z` : day, open, high, low, close, volume })
            p = close
        }
        if hourly && hour < 16 && date.weekday(day) <= 5 {
            hour += 1
        } else {
            hour = 10
            day = date.add_days(day, 1)
        }
    }
    out
}

let candlestick_chart_demo_daily = candlestick_chart_demo_walk(7, 120, 182.4, "2026-04-01")
let candlestick_chart_demo_hourly = candlestick_chart_demo_walk(42, 35, 61250, "2026-10-19", true)

view CandlestickChartDemo() =
    <div.demo-stack>
        <div id="candlestick_chart-demo-daily">
            <CandlestickChart label="ACME, daily" show_label={true} candles={candlestick_chart_demo_daily}
                              sma={[20]} ema={[50]} prefix="$"/>
        </div>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 32px 40px">
            <div id="candlestick_chart-demo-hourly">
                <CandlestickChart label="BTC-USD, hourly" show_label={true} candles={candlestick_chart_demo_hourly}
                                  volume={false} decimals={0} height={220}/>
            </div>
            <div id="candlestick_chart-demo-small">
                <CandlestickChart label="ACME, last 30 days" show_label={true} candles={drop(candlestick_chart_demo_daily, 90)}
                                  prefix="$" height={180} volume_height={44} last_line={false}/>
            </div>
        </div>
        <p.demo-note>Hover a candle for its open, high, low, close, change and volume.</p>
    </div>

