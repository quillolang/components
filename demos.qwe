// ---- demos/heikin_ashi_chart.qwe ----------------------------------------------------------------

// Prices from a seeded random walk (Park–Miller), the same on every render: `count`
// candles from the day `from` on, skipping weekends, daily or hourly (10:00 to 16:00),
// rounded to `places` decimals.
fn heikin_ashi_chart_demo_walk(seed: int, count: int, start: num, from: str, hourly: bool = false, places: int = 2) -> list {
    let s = seed
    let rnd = () => {
        s = s * 16807 % 2147483647
        s / 2147483647
    }
    let scale = pow(10, places)
    let cut = (v) => round(v * scale) / scale
    let p = start
    let day = from
    let hour = 10
    let out = []
    while len(out) < count {
        if date.weekday(day) <= 5 {
            let open = cut(p * (1 + (rnd() - 0.5) * 0.006))
            let close = cut(open * (1 + (rnd() - 0.485) * (hourly ? 0.012 : 0.035)))
            let high = cut(max([open, close]) * (1 + rnd() * 0.01))
            let low = cut(min([open, close]) * (1 - rnd() * 0.01))
            let volume = round((hourly ? 90000 : 900000) * (1 + rnd() * 1.5 + abs(close - open) * 30 / open))
            out = out | push({ time: hourly ? `${day}T${hour < 10 ? "0" : ""}${hour}:00:00Z` : day, open, high, low, close, volume })
            p = close
        }
        if hourly && hour < 16 && date.weekday(day) <= 5 {
            hour += 1
        } else {
            hour = 10
            day = date.add_days(day, 1)
        }
    }
    out
}

let heikin_ashi_chart_demo_daily = heikin_ashi_chart_demo_walk(23, 100, 48.6, "2026-04-15")

view HeikinAshiChartDemo() =
    <div.demo-stack>
        <div id="heikin_ashi_chart-demo-daily">
            <HeikinAshiChart label="Globex, Heikin-Ashi" show_label={true} candles={heikin_ashi_chart_demo_daily} prefix="$"/>
        </div>
        <div id="heikin_ashi_chart-demo-small">
            <HeikinAshiChart label="Globex, last 40 days, with EMA 10" show_label={true} candles={drop(heikin_ashi_chart_demo_daily, 60)}
                             prefix="$" ema={[10]} volume={false} height={200}/>
        </div>
        <p.demo-note>Runs of one colour are trends; hover a candle for its Heikin-Ashi values and the real close.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "heikin_ashi_chart", name: "HeikinAshiChart", group: "Charts",
    summary: "Heikin-Ashi candles worked out from OHLC, which smooth the noise so trends show as runs of one colour, with the real close on hover.",
    tags: ["chart", "data", "trading", "no-js"],
    demo: HeikinAshiChartDemo })

