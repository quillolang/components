// ---- demos/coupon_input.qwe ----------------------------------------------------------------

// Codes the demo knows: SAVE10 and FREESHIP take, EXPIRED says so, anything else is unknown.
fn coupon_input_demo_check(code: str) -> map = match code {
    "SAVE10" => { ok: true, message: "10% off applied" }
    "FREESHIP" => { ok: true, message: "Free shipping applied" }
    "EXPIRED" => { ok: false, message: "That code has expired" }
    _ => { ok: false, message: `"${code}" is not a code we know` }
}

component CouponInputDemoLive() {
    state code = null
    <div.demo-stack.demo-narrow>
        <CouponInput name="coupon-demo" on_apply={(c) => {
                         let r = coupon_input_demo_check(c)
                         if r.ok { code = c }
                         r
                     }}
                     on_remove={() => { code = null }}/>
        <p.demo-note>{code == null ? "No code applied. Try SAVE10, FREESHIP or EXPIRED." : `Code ${code} is applied (on_apply).`}</p>
    </div>
}

view CouponInputDemo() =
    <div.demo-stack>
        <CouponInputDemoLive/>
        <div.demo-narrow>
            <CouponInput name="coupon-demo-applied" applied="WELCOME" message="Welcome gift: 15% off your first order" size="sm"/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "coupon_input", name: "CouponInput", group: "Commerce",
    summary: "A promo code box with Apply: on_apply(code) says whether it took, and an applied code shows with Remove.",
    tags: ["commerce", "checkout", "forms", "input", "interactive"], demo: CouponInputDemo })

