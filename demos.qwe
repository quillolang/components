// The gallery's examples, in one file. Made by scripts/build.sh from demos/.

// ---- demos/_demo.qwe ----------------------------------------------------------------

// What every demo shares: the list they add themselves to, and the layout
// classes they use. (scripts/build.sh puts this first in demos.qwe.)

let ui_gallery = []

let demo_css = css`
.demo-row { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
.demo-stack { display: grid; gap: 14px; }
.demo-wide { width: 100%; }
.demo-narrow { max-width: 360px; }
.demo-note { margin: 0; color: var(--ui-muted); font: 13px/1.5 var(--ui-font); }
`

// ---- demos/accordion.qwe ----------------------------------------------------------------

view AccordionDemo() =
    <div.demo-stack>
        <Accordion>
            <AccordionItem group="faq" title="What does it cost?" open={true}>
                <p>Nothing for one project and up to three people. Teams pay per seat, monthly or yearly.</p>
            </AccordionItem>
            <AccordionItem group="faq" title="Can I cancel at any time?">
                <p>Yes, from Settings, Billing. You keep access until the end of the period you paid for.</p>
            </AccordionItem>
            <AccordionItem group="faq" title="Where is my data kept?" hint="Servers, backups and exports">
                <p>In the EU, on servers in Frankfurt, with nightly backups kept for 30 days.</p>
            </AccordionItem>
        </Accordion>
        <p.demo-note>The same group: opening one closes the others. Below, flush and independent.</p>
        <Accordion flush={true}>
            <AccordionItem title="Shipping"><p>Free over €50; two to four working days.</p></AccordionItem>
            <AccordionItem title="Returns"><p>Within 30 days, in the original packaging.</p></AccordionItem>
        </Accordion>
    </div>

ui_gallery = ui_gallery | push({ slug: "accordion", name: "Accordion", group: "Navigation",
    summary: "Sections that open under their titles, on the browser's own <details>: exclusive with a group.",
    demo: AccordionDemo })

// ---- demos/action_bar.qwe ----------------------------------------------------------------

view ActionBarDemo() =
    <div.demo-stack>
        <ActionBar text="€95 a night" detail="5 – 9 Nov · 2 guests · €552.80 in all">
            <Button>Reserve</Button>
        </ActionBar>
        <p.demo-note>On a phone it is fixed to the bottom of the screen, with room left for it at the end of the page.</p>
    </div>

ui_gallery = ui_gallery | push({ slug: "action_bar", name: "ActionBar", group: "Layout",
    summary: "A page's main action and a line about it, fixed to the bottom of the screen on a phone.",
    demo: ActionBarDemo })

// ---- demos/alert.qwe ----------------------------------------------------------------

component AlertDemoLive() {
    state shown = true
    <div.demo-stack>
        {shown
            ? <Alert tone="warning" title="Your trial ends in 3 days" dismissable={true}
                     on_dismiss={() => { shown = false }}>Add a card to keep your projects.</Alert>
            : <p.demo-note>Dismissed. <button type="button" @click={() => { shown = true }}>Show it again</button></p>}
    </div>
}

view AlertDemo() =
    <div.demo-stack>
        <Alert title="A new version is out">Quillo 0.9 adds live queries. <a href="#alert">Read the notes</a>.</Alert>
        <Alert tone="success" title="Invoice sent" id="alert-demo-sent">Northwind Traders got invoice INV-1042.</Alert>
        <Alert tone="danger" title="Payment failed">The card ending in 4242 was declined.</Alert>
        <Alert tone="neutral" icon={false}>Maintenance on Sunday, 02:00 to 03:00 UTC.</Alert>
        <div.demo-row>
            <Alert tone="accent" variant="outline">Outline, accent.</Alert>
            <Alert tone="success" variant="solid">Solid, success.</Alert>
            <Alert tone="danger" variant="solid">Solid, danger.</Alert>
        </div>
        <AlertDemoLive/>
        <DismissibleAlert tone="info" title="Placed straight in a page">DismissibleAlert hides itself when closed.</DismissibleAlert>
    </div>

ui_gallery = ui_gallery | push({ slug: "alert", name: "Alert", group: "Feedback",
    summary: "A message in the page in six tones and three variants, with an icon, announced to screen readers, and dismissable.",
    demo: AlertDemo })

// ---- demos/app_shell.qwe ----------------------------------------------------------------

let app_shell_demo_nav = [{ label: "Overview", href: "/", icon: "◎" }, { label: "Projects", href: "#app_shell", icon: "▤" },
                          { label: "Team", href: "#team", icon: "☺" }, { label: "Billing", href: "#billing", icon: "▭" }]

view AppShellDemoPage() =
    <div>
        <h2 style="margin: 0 0 6px; font-size: 20px">Overview</h2>
        <p style="margin: 0; color: var(--ui-muted)">The page goes here. The sidebar stays put as it scrolls.</p>
        {for i in range(1, 6) => <p>Paragraph {i} of the page, to give it some length.</p>}
    </div>

view AppShellDemo() =
    <div.demo-stack>
        <div style="--ui-shell-height: 340px; height: 340px; overflow: auto; border: 1px solid var(--ui-border); border-radius: var(--ui-radius); transform: translateZ(0)">
            <AppShell id="app-shell-demo" brand="Acme" nav={app_shell_demo_nav} current="/"
                      header={[<b>Overview</b>, <Button size="sm" variant="outline">Invite</Button>]}>
                <AppShellDemoPage/>
            </AppShell>
        </div>
        <p.demo-note>When it is narrow, the sidebar becomes a drawer, opened by the menu button:</p>
        <div style="--ui-shell-height: 340px; width: min(380px, 100%); height: 340px; overflow: auto; border: 1px solid var(--ui-border); border-radius: var(--ui-radius); transform: translateZ(0)">
            <AppShell id="app-shell-demo-narrow" brand="Acme" nav={app_shell_demo_nav} current="/"
                      header={[<b>Overview</b>, <Button size="sm" variant="outline">Invite</Button>]}>
                <AppShellDemoPage/>
            </AppShell>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "app_shell", name: "AppShell", group: "Layout",
    summary: "An app's frame: a sidebar of links, a top bar and the page; the sidebar is a drawer on phones.",
    demo: AppShellDemo })

// ---- demos/auth_form.qwe ----------------------------------------------------------------

view AuthFormDemo() =
    <div.demo-stack>
        <p.demo-note>Four forms, one per mode; the links in each switch it in place. They post to /login, /signup, /forgot and /reset.</p>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 20px; align-items: start">
            <AuthForm id="auth-demo-signin" mode="signin" error="Wrong email or password."
                      values={{ email: "ada@example.com" }}
                      providers={[{ label: "Continue with GitHub", href: "#auth-github" },
                                  { label: "Continue with Google", href: "#auth-google" }]}/>
            <AuthForm id="auth-demo-signup" mode="signup" terms_href="#terms" min_password={10}/>
            <AuthForm id="auth-demo-forgot" mode="forgot"
                      notice="If that address has an account, a link to reset its password is on its way: check your inbox."/>
            <AuthForm id="auth-demo-reset" mode="reset" token="demo-7f3a9c" values={{ email: "ada@example.com" }}
                      errors={{ password: "That is the password you had: choose another." }}/>
        </div>
    </div>

ui_gallery = ui_gallery | push({ slug: "auth_form", name: "AuthForm", group: "Forms",
    summary: "Sign in, sign up, forgot and reset password in one form that switches in place, each posting to its own route.",
    demo: AuthFormDemo })

