// A wordmark drawn in SVG, so the demo needs no image files.
fn logo_cloud_demo_mark(text: str, color: str) -> str {
    let w = 36 + len(text) * 15
    let svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${w} 44" width="${w}" height="44">`
        + `<circle cx="18" cy="22" r="12" fill="${color}"/>`
        + `<text x="36" y="30" font-family="Inter, system-ui, sans-serif" font-size="22" font-weight="700" fill="${color}">${text}</text></svg>`
    `data:image/svg+xml,${url_encode(svg)}`
}

