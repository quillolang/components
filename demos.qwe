                         items={["Africa/Cairo", "Africa/Lagos", "America/Chicago", "America/Los_Angeles", "America/New_York",
                                 "America/Sao_Paulo", "Asia/Dubai", "Asia/Kolkata", "Asia/Shanghai", "Asia/Singapore",
                                 "Asia/Tokyo", "Australia/Sydney", "Europe/Berlin", "Europe/Lisbon", "Europe/London",
                                 "Europe/Madrid", "Europe/Paris", "Pacific/Auckland", "UTC"]}/>
        </div>
    </div>

