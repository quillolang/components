// ---- demos/thumbnail.qwe ----------------------------------------------------------------

// A product shot drawn in SVG, so the demo needs no image files.
fn thumbnail_demo_pic(bg: str, fg: str) -> str {
    let svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="200" height="200">`
        + `<rect width="200" height="200" fill="${bg}"/><circle cx="100" cy="90" r="46" fill="${fg}"/>`
        + `<rect x="40" y="140" width="120" height="26" rx="13" fill="${fg}" opacity=".7"/></svg>`
    `data:image/svg+xml,${url_encode(svg)}`
}

let thumbnail_demo_pics = [thumbnail_demo_pic("#fde2e4", "#c62a2f"), thumbnail_demo_pic("#e3f5ec", "#18794e"),
                           thumbnail_demo_pic("#e5f1fc", "#0b6bcb"), thumbnail_demo_pic("#fdf0dc", "#a35200")]

component ThumbnailDemoLive() {
    state picked = "none"
    <div.demo-row>
        {for [i, p] in enumerate(thumbnail_demo_pics) => <Thumbnail src={p} alt="" label={`Pick colour ${i + 1}`} size="sm"
                                                                     on_click={() => { picked = str(i + 1) }}/>}
        <p.demo-note id="thumbnail-demo-picked">Picked: {picked}</p>
    </div>
}

view ThumbnailDemo() =
    <div.demo-stack>
        <div.demo-row id="thumbnail-demo-sizes">
            <Thumbnail src={thumbnail_demo_pics[0]} alt="Red" size="xs"/>
            <Thumbnail src={thumbnail_demo_pics[1]} alt="Green" size="sm"/>
            <Thumbnail src={thumbnail_demo_pics[2]} alt="Blue"/>
            <Thumbnail src={thumbnail_demo_pics[3]} alt="Orange" size="lg"/>
            <Thumbnail src={thumbnail_demo_pics[0]} alt="Red" size="xl"/>
            <Thumbnail src={thumbnail_demo_pics[1]} alt="Green" px={40}/>
        </div>
        <div.demo-row id="thumbnail-demo-shapes">
            <Thumbnail src={thumbnail_demo_pics[2]} alt="" shape="square" size="lg"/>
            <Thumbnail src={thumbnail_demo_pics[3]} alt="" shape="circle" size="lg"/>
            <Thumbnail src={thumbnail_demo_pics[0]} alt="" size="lg" overlay="IMG_0412.jpg"/>
            <Thumbnail src={thumbnail_demo_pics[1]} alt="" size="lg" more={3}/>
            <Thumbnail src={thumbnail_demo_pics[2]} alt="" size="lg" fit="contain" href="https://quillolang.org" label="Open the album"/>
        </div>
        <ThumbnailDemoLive/>
    </div>

