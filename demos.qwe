// ---- demos/lightbox.qwe ----------------------------------------------------------------

// A landscape drawn in SVG, so the demo needs no image files: sky, sun and hills in
// the colours given, w by h.
fn lightbox_demo_scene(sky: str, sun: str, near: str, far: str, w: int = 1200, h: int = 800) -> str {
    let svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${w} ${h}" width="${w}" height="${h}">`
        + `<defs><linearGradient id="g" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="${sky}"/><stop offset="1" stop-color="#fff8ee"/></linearGradient></defs>`
        + `<rect width="${w}" height="${h}" fill="url(#g)"/>`
        + `<circle cx="${w * 0.7}" cy="${h * 0.32}" r="${h * 0.11}" fill="${sun}"/>`
        + `<path d="M0 ${h * 0.62} Q ${w * 0.25} ${h * 0.42} ${w * 0.5} ${h * 0.6} T ${w} ${h * 0.55} V ${h} H 0 Z" fill="${far}"/>`
        + `<path d="M0 ${h * 0.78} Q ${w * 0.3} ${h * 0.62} ${w * 0.6} ${h * 0.8} T ${w} ${h * 0.74} V ${h} H 0 Z" fill="${near}"/></svg>`
    `data:image/svg+xml,${url_encode(svg)}`
}

let lightbox_demo_trip = [
    { src: lightbox_demo_scene("#7cb7f0", "#ffd36b", "#2f6b3a", "#5c9a5f"), alt: "Green hills under a blue sky", caption: "Day 1: the valley at noon" },
    { src: lightbox_demo_scene("#f3a46b", "#ff6b4a", "#5b3a5e", "#8a5a7a"), alt: "Purple hills at sunset", caption: "Day 1: sunset from the ridge" },
    { src: lightbox_demo_scene("#1d2b53", "#f5f0d0", "#0f1a33", "#24345f"), alt: "Dark hills under a full moon", caption: "Day 2: the moon over camp" },
    { src: lightbox_demo_scene("#bfe3f5", "#ffffff", "#e8eef3", "#c8d6e0"), alt: "Snowy hills on a pale morning", caption: "Day 3: snow overnight" },
    { src: lightbox_demo_scene("#9fd8c8", "#ffe9a0", "#1f6f68", "#3f9c8f"), alt: "Teal hills by the coast", caption: "Day 4: down to the coast" },
    { src: lightbox_demo_scene("#e7c6f5", "#ffb3c7", "#7a4b8c", "#a676b8"), alt: "Lilac hills at dawn", caption: "Day 5: the last morning" },
]

